	{
		objForm.action = "PM_MSP_History.aspx?Mode=<%=m_strMode%>&cmdUpload=GET&OriginalFileName=" + strOriginalFileName; 
		objForm.submit();
	}*/
	
	//Added by PrajaktaR for IssueID 11919 of Jopasna on 17th Feb 2005
	function subDisplayFile(strMSPHistoryID)
	{
		objForm.action = "PM_MSP_History.aspx?Mode=<%=m_strMode%>&cmdUpload=GET&MSPHistoryID=" + strMSPHistoryID; 
		objForm.submit();
	}
	//End of Addition by PrajaktaR for IssueID 11919 of Jopasna on 17th Feb 2005
	//End Modification	
	
	function Delete_OnClick()
	{
		objForm.action = "PM_MSP_History.aspx?cmdDelete=DELETE&MODE=<%=m_strMode%>"; 
		objForm.submit();
	}
	
	var objdivlist = GetObjectReference('frmHistory','divList');
	function window_onload()
	{

		var intDivHeight ;
		var mode= "<%=m_strMode%>";
		intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 40;
		 //Modified by JyotiG on Date 11 July,2006 for WhizibleSEM Issue ID.4168

		if (intDivHeight < 100){	intDivHeight = 100; }
		/*if(navigator.appName == 'Netscape')
		{
			if( mode == "HISTORY")
			{	
				intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 130;
			}
		}*/
		//'Modified by ShraddhaM on Date 12 July,2006 for WhizibleSEM Issue ID.4168

			if(navigator.appName == 'Netscape')
		    {		  
				intDivHeight =window.innerHeight  - objdivlist.offsetTop - 40 ;
		    }
		    else
		    {
				intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 40;
		    }
				// Let the minimum height of the div tag be 100
		objdivlist.style.height = intDivHeight + 'px';		
	}

	function window_onresize()		
	{
	    var intDivHeight;
		//intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 40;
		//'Modified by ShraddhaM on Date 12 July,2006 for WhizibleSEM Issue ID.4168

			if(navigator.appName == 'Netscape')
		    {		  
				intDivHeight =window.innerHeight  - objdivlist.offsetTop - 40 ;
		    }
		    else
		    {
				intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 40;
		    }
		if (intDivHeight < 100 )
			 intDivHeight = 100;	// Let the minimum height of the div tag be 100
		
		objdivlist.style.height = intDivHeight + 'px';		
	}

		</script>


<%@ Page Language="vb" AutoEventWireup="false" Codebehind="RTM_Attachment.aspx.vb" Inherits="PbNIT.RTM_Attachment"%>

<!--Added and commented by Nilesh gundecha on 18/9/2015 for Responsive Common list Page-->
<%--<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN">--%>
<!DOCTYPE HTML>
<!--Ended by Nilesh gundecha on 18/9/2015 for Responsive Common list Page-->
<HTML>
	<%CommonFunctions.General.PlotPageHeadTag("Attachment")%>
	<body MS_POSITIONING="GridLayout" class="clsBody" onresize="window_onresize()" onload="window_onload()">
		
					<form id='frmRTM_Attachment' method='post' runat='server' enctype='multipart/form-data'>
						
									<%WritePage()%>
						
					</form>
				
					<script language="javascript">
		
			var objForm;
			var objdivlist;
		
			objForm = GetFormReference('frmRTM_Attachment');
			objdivlist = GetObjectReference('frmRTM_Attachment','divList');
		
		<%' Added By SonalD on 13th Jan 2009 %>
        <%If CommonFunctions.General.GetApplicationKeySetting("Environment") = "P" Then %>
            disableRightClick();
        <%End If%>
        <%' Added By SonalD on 13th Jan 2009 %>
		
		function window_onload()
		{var objcboTemplate = GetObjectReference('frmRTM_Attachment','cboDocumentType');
		//objcboTemplate.focus();
			var intDivHeight ;
			var intDivHeightRisk;
			intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 50;
			if (intDivHeight < 100)	intDivHeight = 100;
			objdivlist.style.height = intDivHeight;	
		}
		
		function window_onresize()		
		{
			var intDivHeight;
			var intDivHeightRisk;
			intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 50;
			if (intDivHeight < 100)	intDivHeight = 100;
			objdivlist.style.height = intDivHeight;		
		}
		
			
		
		function Attach_OnClick(strID, strFromWhere,intProjectID )
		{
			var strQueryString;
		
		
			var objFileName = GetObjectReference('frmRTM_Attachment','txtFileName');
			var objtxtComments = GetObjectReference('frmRTM_Attachment','txtComments');
			var objcboTemplate = GetObjectReference('frmRTM_Attachment','cboDocumentType');
			
			if (disallowBlank(objcboTemplate,"Please select the Document Type",1)	) {return;}
			if (disallowBlank(objFileName,"Please select a file",1)	) {return;}
			if (disallowSpecialCharacters(objFileName,'Special character # is not allowed',true,'#')) { return; }
			if (disallowMaxlengthViolation(objtxtComments,<%=m_lngMaxLength%>,"Length should not exceed <%=m_lngMaxLength%> characters",true)) {return;}
			
			// Check if extn. is xls
			var str=objFileName.value;	
			str=str.toLowerCase()
			//var pos=str.indexOf(".xls") 
			//if (pos==-1)
			//{
			//	alert("Please select only Excel Files.");
			//	return;				
			//}
				
			var objtblFileAttachment = GetObjectReference('frmRTM_Attachment','tblFileAttachment');
			var objtblFileUploadStatus = GetObjectReference('frmRTM_Attachment','tblFileUploadStatus');
			
			objtblFileAttachment.style.display = "none";
			document.body.style.cursor = "wait";
			objtblFileUploadStatus.style.display = "block";
			
			
			strQueryString = "RTM_Attachment.aspx?Action=ATTACH&FromWhere=<%=m_strFromWhere%>&ID=" + strID + "&ProjectRequirementID=<%=m_strProjectRequirementID%>&ProjectID=" + intProjectID + "&Page=<%=m_strPage%>&Mode=<%=m_strMode%>&QueryString=<%=Server.URLEncode(m_strQueryString)%>";
			objForm.action = strQueryString;
			objForm.submit();
			
		}	
		
		function txtFileName_onkeydown() 
		{
			event.returnValue = false;	
		}

		function txtFileName_onbeforepaste() 
		{
			event.returnValue = false;	
		}

		function txtFileName_onpaste() 
		{
			event.returnValue = false;	
		}


		</script>
	</body>
</HTML>

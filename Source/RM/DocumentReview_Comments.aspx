<%@ Page Language="vb" AutoEventWireup="false" Codebehind="DocumentReview_Comments.aspx.vb" Inherits="PbNIT.DocumentReview_Comments"%>

<!--Added and commented by Nilesh gundecha on 18/9/2015 for Responsive Common list Page-->
<%--<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN">--%>
<!DOCTYPE HTML>
<!--Ended by Nilesh gundecha on 18/9/2015 for Responsive Common list Page-->
<HTML>
	<%CommonFunctions.General.PlotPageHeadTag(m_strWindowTitle)%>
	<body MS_POSITIONING="GridLayout" class='clsBody' onresize="window_onresize()" onload="window_onload()">
		
					<form id="frmDocumentReview" name="frmDocumentReview" method="post" runat="server" enctype='multipart/form-data'>
															<%PageInit()%>
							
					</form>
				
					<script language="javascript">
			var objdivlist;
			var objform;
							
			objform = GetFormReference('frmDocumentReview');
			objdivlist = GetObjectReference('frmDocumentReview','DivList');
									
			<%' Added By SonalD on 13th Jan 2009 %>
            <%If CommonFunctions.General.GetApplicationKeySetting("Environment") = "P" Then %>
                disableRightClick();
            <%End If%>
            <%' Added By SonalD on 13th Jan 2009 %>
			
		function window_onload()		
			{
				var intDivHeight ;
				var intDivHeightRisk;
				
				intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 40;
				if (intDivHeight < 100)
				intDivHeight = 100;
				if(navigator.appName == 'Netscape')
				{
					intDivHeight = window.innerHeight  - objdivlist.offsetTop -40;
				}

				objdivlist.style.height = intDivHeight	;	
				
				var objtxtComments = GetObjectReference('frmDocumentReview','txtComments');		
				if(objtxtComments!=null || objtxtComments!='')
					objtxtComments.focus();
					
					//shraddhaM
					var dt=new Date(); 
			var hr=dt.getHours();
			var min=dt.getMinutes();
	
			//Commented By ShraddhaM On 18 Aug 2006 to remove Timespan Code..
			/*if (hr<10)
				hr='0'+hr;
			if(min<10)
				min='0'+min;
		//Added by AmitJ for PSPL ISSue 22880		
		RenderedTime = hr+':'+min;
		RenderedMin = min;
		RenderedHr = hr;*/
			}
			function window_onresize()		
			{
				var intDivHeight ;
				var intDivHeightRisk;
					intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 40;
				if (intDivHeight < 100)
					intDivHeight = 100;
				objdivlist.style.height = intDivHeight	;	
				var objTxt;
				objTxt = GetObjectReference('frmDocumentReview','txtComments');
				if(objTxt!=null)
					objTxt.focus();
			}
		
			function Close_OnClick()
			{	
				window.close ();
			}
			
		function ReviewSave_OnClick()
			{
				var objTxt;
				var flag;
				
				objTxt = GetObjectReference('frmDocumentReview','txtComments');	
				flag = disallowBlank(objTxt,'Comments field is mandatory',true);
				if(flag==true)
					return;
					
				flag = disallowMaxlengthViolation(objTxt,500,'Max Length of this field is 500 characters',true);
				if(flag==true)
					return;	
				
					
					objform.action="DocumentReview_Comments.aspx?ParentToken=<%=m_strParentToken%>&Mode=<%=m_strMode%>&Action=<%=CONST_ACTION_SAVE%>&MasterTagID=3721&FromWhere=RM&ProjectDocumentRefTypeID=<%=m_intProjectDocumentRefTypeID%>&UniqueID=<%=m_intProjectDocumentRefTypeID%>";
		//End of modification by MonikaI
				objform.submit();
			}
			
					</script>
				</TD>
			</TR>
		</TABLE>
	</body>
</HTML>

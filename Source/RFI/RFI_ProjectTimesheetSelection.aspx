<%@ Page Language="vb" AutoEventWireup="false" Codebehind="RFI_ProjectTimesheetSelection.aspx.vb" Inherits="PbNIT.RFI_ProjectTimesheetSelection" %>
<!--Added and commented by Nilesh gundecha on 18/9/2015 for Responsive Common list Page-->
<%--<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN">--%>
<!DOCTYPE HTML>
<!--Ended by Nilesh gundecha on 18/9/2015 for Responsive Common list Page--><HTML>
	<%CommonFunctions.General.PlotPageHeadTag("RFI Project Timesheets")%>
	<body class="clsBody" onresize="window_onresize()" onload="window_onload()" MS_POSITIONING="GridLayout">
		
					<form id="frmRFI_ProjectTimesheetSelection" method="post" runat="server">
				
									<%PageInit%>
				
					</form>
				
					<SCRIPT language="javascript">
		var objform=GetFormReference('frmRFI_ProjectTimesheetSelection');
		var objdivlist=GetObjectReference('frmRFI_ProjectTimesheetSelection','PageDiv');
		
		<%' Added By SonalD on 20th Jan 2009 %>
        <%If CommonFunctions.General.GetApplicationKeySetting("Environment") = "P" Then %>
            disableRightClick();
        <%End If%>
        <%' Added By SonalD on 20th Jan 2009 %>
		
		//The div tag has id as PageDiv 
		function window_onload()
		{
			var intDivHeight ;
			var intDivHeightRisk;
			if (objdivlist !=null) {
			intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 40;
			if (intDivHeight < 100)	intDivHeight = 100;
			objdivlist.style.height = intDivHeight;	}			
		}
		
		function window_onresize()		
		{
			var intDivHeight;
			var intDivHeightRisk;
			if (objdivlist !=null) {
			intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 40;
			if (intDivHeight < 100)	intDivHeight = 100;
			objdivlist.style.height = intDivHeight;	}
		}	
		
		function Status_OnClick(strToken,val)
		{
			
			var objtxtHidIsRateDefined=GetObjectReference('frmRFI_ProjectTimesheetSelection','txtHidIsRateDefined'+ val);
			
			
			if (objtxtHidIsRateDefined.value=="RATE_NOT_DEFINED")
			{
				alert("Resource Or Role Rate not defined !");
				return;	
			}	
						
			else if (objtxtHidIsRateDefined.value=="NO_IRCOMPANY_BASE_CONVERSRIONRATE")
			{
				alert("Currently, no Site Currency to IR company base currency conversion  rate is defined. Please define it !");
				return;	
			}
			else if (objtxtHidIsRateDefined.value=="NO_CORPORATE_BASE_CONVERSRIONRATE")
			{
				alert("Currently, no Site Currency to corporate base currency conversion rate is defined. Please define it ! ");
				return;		
			}
			
			if (confirm("Do you want to create invoice line items for selected project timesheet ?"))
				window.location.href="RFI_ProjectTimesheetSelection.aspx?UserType=<%=strUserType%>&Mode=true&RFIID=<%=intRFIID%>&PKToken=" + strToken + "&TimesheetID=" + val
			
				//window.location.href="RFI_ProjectTimesheetSelection.aspx?UserType=<%=strUserType%>&RFIID=<%=intRFIID%>&PKToken=" + strToken + "&Cancel=1&TimesheetID=" + val
		
		}
		//Added by PrashantSJ on 09 June-2006 For Project Timesheet with Project site changes
		function Back_OnClick(strToken)
		{
				window.location.href="RFI_ProjectTimesheetSelection.aspx?RFIID=<%=intRFIID%>&PKToken=" + strToken + "&UserType=<%=strUserType%>";
		}
		function CreateInvoiceItem_OnClick(strToken,val)
		//CreateInvoiceItem_OnClick(val,RFIID,UserType)
		{
		  	var objHidRate= document.getElementsByName("chkHidRate");
		  	var i;
		  	
		  	for(i=0; i<objHidRate.length; i++)
			{
				if (objHidRate[i].value=="NO_COR_RATE_DEF")
				{
					alert("Currently,no Site Currency to Corporate Base currency rate is defined !");
					return;
				}
				else if (objHidRate[i].value=="NO_COB_RATE_DEF")
				{
					alert("Currently,no Site Currency to IR Company Base currency rate is defined !");
					return;
				}
			}	
				
				 
		  				
			if (confirm("Do you want to create invoice line items for selected project timesheet ?"))
				window.location.href="RFI_ProjectTimesheetSelection.aspx?UserType=<%=strUserType%>&Mode=true&RFIID=<%=intRFIID%>&PKToken=" + strToken + "&TimesheetID=" + val+"&MultipleSiteFlag=1";
			else 
				return;
		 
		}
		function Close_OnClick()
		{
		window.close(); 
		}
		function Help_OnClick()
		{
		}
		//End of addition by  PrashantSJ on 09 June-2006 For Project Timesheet with Project site changes
				
					</SCRIPT>
		
	</body>
</HTML>

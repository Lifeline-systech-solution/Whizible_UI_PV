<body>
    <mobile:Form id="frmPTApprovalEdit" runat="server" >
    <mobile:Link ID="Link1"  Runat="server"  NavigateUrl="Mobile_PTApprovalList.aspx"  BreakAfter="False"  >Back</mobile:Link> |
    <mobile:Link ID="Link2"  Runat="server"  NavigateUrl="Mobile_PTApproval.aspx?Mode=LogOut"  >Logout</mobile:Link>
    <br />
    <mobile:TextView ID="TxtTimesheetNo" Runat="server" ></mobile:TextView>
    <mobile:TextView ID="TxtDate" Runat="server" ></mobile:TextView> 
    <mobile:TextView ID="TxtProjectName" Runat="server" ></mobile:TextView> 
    <mobile:TextView ID="TxtFromDate" Runat="server" ></mobile:TextView> 
    <mobile:TextView ID="TxtToDate" Runat="server" ></mobile:TextView>
    <br /> 
    <mobile:TextView ID="TxtTimesheetDetails" Runat="server" ></mobile:TextView> 
    <br />
    <mobile:TextView ID="TxtSummary" Runat="server" ></mobile:TextView> 
    <mobile:Label Runat="Server" Font-Bold="True"  ID="lblComment" >Comment: </mobile:Label>     
    <mobile:TextBox Runat="server" ID="txtComment" Size="50" MaxLength="200" ></mobile:TextBox>  
    <mobile:RequiredFieldValidator Runat="server"   ID="ValidateComment" ErrorMessage="Please, Enter Comment"
 ControlToValidate="txtComment" ></mobile:RequiredFieldValidator>   
    <mobile:Command runat="server" ID="CmdApprove" OnClick="Approve_OnClick"  BreakAfter="False"  >Approve</mobile:Command> 
    <mobile:Command runat="server" ID="CmdReject" OnClick="Reject_OnClick" >Reject</mobile:Command> <br />    
    <mobile:Link ID="LnkBack"  Runat="server"  NavigateUrl="Mobile_PTApprovalList.aspx"  BreakAfter="False"  >Back</mobile:Link> |
    <mobile:Link ID="LnkLogOut"  Runat="server"  NavigateUrl="Mobile_PTApproval.aspx?Mode=LogOut"   BreakAfter="False" >Logout</mobile:Link>
    </mobile:Form>
      
</body>
</html>

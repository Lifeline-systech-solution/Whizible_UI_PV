.divDraggable {
    min-height: 15PX;
}

.navbar {
    border-radius: 0px !important;
}

.main {
    padding: 18px 0 18px;
}

#table {
    /*height: 2000px !important;*/
    width: 100%;
    margin-top: 20px;
    overflow-x: auto;
    overflow-y: auto;
    white-space: nowrap;
    margin-left: 8px;
}

.fixe {
    /*position: fixed;
    top: 64px;
    width: 100%;
    max-width: 360px;
    margin: 0;
    border-top: 1px solid #DDD;
    background: #f9f9f9;
    margin-top: 0px !important;
    padding-top: 25px;
    opacity: 1;
    z-index: 1035;*/
    position: absolute;
   display:grid;
    width: 93%;
    /* max-width: min-content; */
    /* margin: 0; */
    /* border-top: 1px solid #DDD; */
    /* background: #f9f9f9; */
    margin-top: 0px !important;
    padding-top: 10px;
    opacity: 1;
    z-index: 999;
    border-bottom: 1px solid #eee;
    border-bottom: 1px solid #eee;
}

.clsDivHeader {
    color: #292828 !important;
    font-weight: 500;
    font-size: 16px !important;
    margin-top: 15px !important;
    margin-left: 15px !important;
}

.fixed-top {
    position: fixed !important;
    right: 0;
    left: 0;
    z-index: 1030;
    background: #e5e5e5;
    padding: 10px;
    margin-top: -10px;
}
/*UI chnages done by Yasmin on 2nd May*/
#divMain {
    /*margin-top: 45px;*/
    overflow-x: hidden;
    overflow-y: auto;
}


.inner {
    width: 32%;
    margin-left: 11px;
    margin-top: 2px;
    margin-bottom: 2px;
    display: inline-block;
    vertical-align: top;
    white-space: nowrap;
}

.inner-template {
    display: none;
}

.note {
    color: red;
    margin-top: 5px;
    float: right;
    margin-right: 14px;
    text-align: right;
    font-size: 11.5px;
    margin-top: 75px;
    margin-right: 30px;
}

.add-dynamic-div {
    background: #34495e;
    padding: 8px 10px;
    margin: 3px;
    color: #fff;
    border-radius: 5px;
    cursor: pointer;
}

    .add-dynamic-div:hover {
        color: #fff !important;
        cursor: pointer;
    }

.arrow-to-display {
    background: #34495e;
    padding: 8px 10px;
    margin: 3px;
    color: #fff;
    border-radius: 5px;
    /*cursor: not-allowed;*/
    transition: padding 0.2s;
}

    .arrow-to-display:hover {
        color: #fff !important;
    }

.col {
    display: inline-block !important;
}

.scrum-grid {
    box-shadow: 0 4px 8px 0 rgba(0,0,0,0.07), 0 6px 20px 0 rgba(0,0,0,0.19);
    border-radius: 5px;
    margin-bottom: 25px;
    padding-bottom: 4px;
    background: #fff !important;
}

.scrum-title {
    min-height: 176px;
    background: #ffffff;
    text-align: center;
    position: relative;
}

    .scrum-title .icon {
        margin-right: 0px;
        height: 100px;
        text-align: center;
        line-height: 105px;
        font-size: 3.5em;
    }

    .scrum-title .fa-list-ol {
        color: #00C6D7;
    }

    .scrum-title .fa-spinner {
        color: #FFCA28;
    }

    .scrum-title .fa-check-square-o {
        color: #8BC34A;
    }

    .scrum-title .fa-eye {
        color: #F00;
    }
.scrum-content {
    /*overflow: hidden;*/
    border-top: 1px solid #DDD;
    background: #f9f9f9;
    margin-top: 45px;
}

#connectedSS {
    /*padding-bottom:10px;*/
}

.scrum-content h5 {
    margin: 10px 0;
    color: #575757;
    font-size: 2.2em;
    text-align: center;
    padding: 14px;
}

.input-box {
    position: relative;
    background: #fff;
    width: 100%;
    height: auto;
}

.input-box-p {
    padding: 8px;
    display: inline-block;
    width: 50%;
    height: auto;
    color: #555;
    line-height: 1.42857143;
    background: #fff;
    box-shadow: 0 4px 6px 0 rgba(0,0,0,0.2);
}

    .input-box-p:focus {
        border: 1px solid blue;
    }

.scrum-header {
    width: auto;
    transform: translateX(-50%) translateY(-50%);
    color: #fff;
    display: inline-block;
    margin: 0 auto;
    position: absolute;
    left: 50%;
    padding: 10px;
    margin-bottom: 20px;
    overflow: hidden;
    border-radius: 4px;
}

.active {
}

.task-progress {
    background: #FFCA28 !important;
}

.task-completed {
    background: #8BC34A;
}

.task-review {
    background: #F00;
}

.scrum-header p {
    color: #fff;
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    text-transform: uppercase;
}

.drag-text {
    color: #575757;
    opacity: 0.8;
}

.drag-handler {
    font-size: 16px !important;
    margin-right: 3px;
}

.scrum-stories {
    background: #f9f9f9;
    margin: 9px;
    box-shadow: 0 4px 8px 0 rgba(0,0,0,0.07), 0 6px 20px 0 rgba(0,0,0,0.19);
}

.scrum-stories-list {
    padding: 30px 8px;
    color: #575757;
    border-left: 2px solid #bdb7b7;
}

.bottom-line {
    border-bottom: 1px solid #dddddd;
    margin-bottom: 8px;
}

#todolist, #progresslist, #completedlist {
    padding: 10px;
}

.to-do-list {
    border-left: 3px solid #00c6d7;
    cursor: all-scroll;
}

.progress-list {
    border-left: 3px solid #ffca28 !important;
    cursor: all-scroll;
}

.review-list {
    border-left: 3px solid #F00;
    cursor: all-scroll;
}

.completed-list {
    border-left: 3px solid #8bc34a;
}

.highlight {
    border: 2px solid red;
}

.task-high-priority {
    float: right;
    /*commented By Ankush T on 06/06/2018 for scrum boadr flag  */
    /*background: #FF0000;*/
    color: #fff;
    padding: 3px 7px;
    border-radius: 5px;
    font-weight: 500;
    cursor: pointer;
    margin-top: -4px;
}

.task-medium-priority {
    background: #FF4500 !important;
    cursor: pointer;
    margin-top: -4px;
}

.task-low-priority {
    background: #ffca28 !important;
    cursor: pointer;
    margin-top: -4px;
}


.task-resolved {
    background: #8bc34a;
    cursor: pointer;
}

.sortable.grid {
    overflow: hidden;
}

.sortable-placeholder {
    border: 2px dashed #CCC;
    padding: 40px;
    background: none;
}

li {
    list-style-type: none;
    cursor: pointer;
}

/*Add Stages*/
.add-stages {
    background: #34495E;
    padding: 8px 13px;
    border-radius: 6px;
    color: #fff !important;
}

.stage-info {
    background: #34495e !important;
    color: #fff !important;
    border: 1px solid #34495e !important;
}

.stage-divide {
    margin-bottom: 15px;
}

a:focus {
    outline: none !important;
}
/*Modal Popup*/
.align-center {
    text-align: center;
}

.close {
    float: right;
    font-size: 21px;
    font-weight: 700;
    line-height: 1;
    color: #275482 !important;
    opacity: 1 !important;
}

    .close:hover {
        color: #275482 !important;
        opacity: 1 !important;
    }

.modal-header {
    min-height: 16.43px;
    padding: 15px;
    color: #275482 !important;
    border-bottom: 1px solid #275482 !important;
}

.submit-btn {
    color: #fff !important;
    background: #275482 !important;
    font-weight: 600 !important;
    padding: 9px 22px !important;
    transition: padding 0.3s;
}

    .submit-btn:hover {
        padding: 9px 28px;
        color: #275482 !important;
        background: transparent !important;
        border: 1px solid #385c81 !important;
    }


.clsCustomStage {
    display: none;
    font-size: 16px;
    padding: 10PX;
}

.pencil {
    font-size: 20px;
    cursor: pointer;
    margin-left: 4px;
}

.close-stage {
    padding: 10px 0 0 35px;
    color: red;
    text-align: center;
    width: 70px;
    /*height: 71px;*/
    position: absolute;
    right: 0;
    top: 0px;
    font-size: 20px;
}

.scrum-grid:hover .close-stage {
    display: inline-block !important;
    /*font-size:16px;*/
}

.scrum-grid:hover .pencil {
    display: inline-block !important;
    /*font-size:16px;*/
}

#filter-dropdown {
    top: auto !important;
    max-height: 420px !important;
    width: 310px;
    padding: 0px;
    right: 0px !important;
    left: auto !important;
}

#tblAdvHeader {
    text-align: left;
    /*border-bottom: 1px solid #ccc;*/
    padding-top: 1%;
    color: black !important;
}

    #tblAdvHeader p {
        margin: 8px 0 10px !important;
        font-size: 14px;
        margin-left: 8px;
    }

    #tblAdvHeader .fa {
        margin: 8px 0 10px !important;
        cursor: pointer;
    }

#btnClear, #btnApply {
    width: 100px;
    float: right;
    margin: 0px;
    margin-right: 5px;
    color: white;
    background-color: #275482;
}

.dropdown-menu table {
    width: 100%;
    color: black;
}


#dropdown-content {
    padding: 8px !important;
}

.grey-text {
    color: #888888e0;
    font-weight: normal;
}

#hr_line {
    margin-top: 1px;
}

.custom-stage-box {
    width: auto;
    transform: translateX(-50%) translateY(-50%);
    color: #fff;
    display: inline-block;
    margin: 0 auto;
    position: absolute;
    left: 50%;
}

#txtactivityicon {
    display: none;
    margin-top: 10px;
}


#filterClear {
    font-size: 20px !important;
    color: red;
    visibility: hidden;
    margin-top: -4px;
    margin-left: -18px;
    cursor: pointer;
}

.bootbox-confirm .btn-danger {
    float: right;
    margin-left: 5px;
}

.scrollbar {
    width: 101%;
    overflow-y: scroll;
}



#scroll::-webkit-scrollbar-track {
    -webkit-box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
    background-color: #F5F5F5;
}

#scroll::-webkit-scrollbar {
    width: 0px;
    background-color: #F5F5F5;
}

#scroll::-webkit-scrollbar-thumb {
    background-color: #fff;
    border: 2px solid #555555;
}

body {
    scrollbar-base-color: white;
    scrollbar-3dlight-color: white;
    scrollbar-highlight-color: white;
    scrollbar-track-color: white;
    scrollbar-arrow-color: white;
    scrollbar-shadow-color: white;
    scrollbar-dark-shadow-color: white;
}

/*Drag drop popup*/
.drag-drop-popup {
    cursor: pointer;
}

.user-story-options {
    color: #34444c;
    font-weight: 500;
    font-size: 14px;
    transiton: font-size 0.2s;
}

    .user-story-options:hover {
        font-size: 16px;
    }
/*Scrollbar*/
/* width */
::-webkit-scrollbar {
    height: 0px;
    width: 0px;
}

/* Track */
::-webkit-scrollbar-track {
    box-shadow: inset 0 0 5px #fff;
    border-radius: 5px;
}

/* Handle */
::-webkit-scrollbar-thumb:horizontal {
    background: #34495E;
    border-radius: 5px;
}

::-webkit-scrollbar-thumb:vertical {
    overflow-y: auto;
    background: #34495E;
    border-radius: 5px;
}
/*Placeholder Color*/
::-webkit-input-placeholder { /* Chrome/Opera/Safari */
    color: #575757 !important;
}

::-moz-placeholder { /* Firefox 19+ */
    color: #575757 !important;
}

:-ms-input-placeholder { /* IE 10+ */
    color: #575757 !important;
}

#ScrumReleases::-webkit-select-placeholder { /* Chrome/Opera/Safari */
    color: #575757 !important;
}

#ScrumReleases::-moz-placeholder { /* Firefox 19+ */
    color: #575757 !important;
}

#ScrumReleases:-ms-input-placeholder { /* IE 10+ */
    color: #575757 !important;
}
/*input field*/
input:focus {
    outline: none;
}

select {
    font-family: FontAwesome, sans-serif;
}

#myStories::-webkit-input-placeholder {
    color: #575757 !important;
}

input[type="search"] {
    width: 150px;
    box-sizing: border-box;
    border: 2px solid #ccc;
    color: #575757;
    border-radius: 20px;
    font-size: 16px;
    background-color: white;
    background-image: url('arrow-to-displayimages/searchicon.png');
    background-position: 10px 10px;
    background-repeat: no-repeat;
    padding: 9px 20px 9px 40px;
    -webkit-transition: width 0.4s ease-in-out;
    transition: width 0.4s ease-in-out;
}

    input[type="search"]:focus {
        width: 100%;
    }

.input-control {
    background: transparent !important;
    border: 1px solid #fff !important;
    color: #fff !important;
}

    .input-control option {
        background: #275482 !important;
    }

.open > .dropdown-menu {
    display: block;
    margin-top: 8px !important;
    background: #fff !important;
    opacity: 1 !important;
}

.popup {
    margin: 3px;
}

.dropdown-icon {
    background: #34495e !important;
    color: #fff !important;
    border: 1px solid #34495e !important;
}

.dropdown-popup {
    opacity: 0.8;
    margin: 6px;
}

.filter-search {
    color: gray;
    margin-top: 5px;
}

.align-center {
    text-align: center;
    margin-bottom: 10px;
}

select::-webkit-input-placeholder {
    color: #34495e !important;
}

select:-moz-placeholder {
    color: #34495e !important;
}

select::-moz-placeholder {
    color: #34495e !important;
}

select:-ms-input-placeholder {
    color: #34495e !important;
}
.clearfix {
    clear: both;
}
/*Responsive media query*/
@media(min-width: 767px) {
}

@media(max-width:991px) {
    .cennterd_div {
        transform: translate(-50%, 10%);
    }

    .setting {
        text-align: right;
    }

    .inner {
        width: 100% !important;
        display: block;
        margin-left: 0px !important;
    }

    .highlighted {
        border: 2px solid red;
    }



    .note {
        font-size: 11px;
    }
}

@media(max-width:767px) {
    .cennterd_div {
        transform: translate(0%,0%);
    }



    .setting {
        text-align: center;
    }
}

@media(max-width:500px) {
    .scrum-header {
        left: 39%;
    }
}

@media(max-width:400px) {
    .scrum-header {
        left: 31%;
    }
}

#CustomStageAdd-btn {
    cursor: not-allowed;
}

#UserStoryName {
    word-break: break-all;
    white-space: pre-line;
}

.input-group .form-control {
    z-index:auto!important;
}
.fa-remove {
    background: red !important;
    color: #fff !important;
    border-radius: 15px;
    padding: 1.5px 2.5px;
    font-size: 9px !important;
    
}
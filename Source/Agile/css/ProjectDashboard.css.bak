.dropdown-menu {
    min-width: 130px !important;
}
.dropdown-menu > li {
    padding: 3px 10px;
    cursor: pointer;
}
    .dropdown-menu > li:focus, .dropdown-menu > li:hover {
        color: #fff !important;

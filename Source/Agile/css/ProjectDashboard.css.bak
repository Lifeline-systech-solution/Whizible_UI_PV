/*Added By Yasmin on 12-3-19*/
body {
    overflow-x: hidden;
}

.widget {
    /*box-shadow: 0 4px 8px 0 rgba(0,0,0,0.07), 0 6px 20px 0 rgba(0,0,0,0.19);*/
    -moz-border-radius: 3px;
    -webkit-border-radius: 3px;
    border-radius: 3px;
    border-width: 1px;
    border-style: solid;
    margin-bottom: 20px;
    background-color: #fff;
    border-color: #d0d0d0;
    /*margin-left: 11px;*/
}

    .widget .widget-header {
        padding: 0 10px;
        border-bottom: 1px solid #fff;
        background-color: #e7edf0; /*modified by pradip on 6-10-2020*/
    }

.no-padding {
    padding: 0 !important;
}

.widget .widget-header h3 {
    display: inline-block;
    vertical-align: middle;
    margin-bottom: 0;
    line-height: 40px;
    float: left;
}

.widget .widget-header h3, .widget.widget-no-header h3 {
    margin-top: 0;
    font-size: 14px;
    color: #6a6a6a;
}

.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
}

.nav-justified {
    width: 100%;
}

.nav {
    padding-left: 0;
    margin-bottom: 0;
    list-style: none;
}

#widget_impe, #widget_activ {
    height: 538px !important;
}

.widget .widget-content {
    padding: 20px;
}

.tab-content {
    padding: 30px 15px 15px 15px;
    background-color: #fff;
}

.box {
    width: 256px;
    height: 250px;
    padding: 6px;
    border: 1px solid #8888885c;
}
.fixed-top {
    position: fixed !important;
    right: 0;
    left: 0;
    z-index: 1030;
    background: #e7edf0; /*modified by pradip on 6-10-2020*/
    padding: 12px;
    margin-top: -32px;
}

.widget-header_current {
    background: #e7edf0;
}



/*::-webkit-scrollbar {
    background: transparent; 
    width: 5px!important;
}*/

.text-grey {
    text-overflow: ellipsis;
    overflow: hidden;
    color: grey;
    /*background-color: #f5f5f5;*/
    border-color: #ddd;
    font-weight: 600;
}

@import "bourbon";

.lg-item-heading {
    /*color: #000;*/
    font-weight: 600;
}

img.lg-item-img {
    width: 51px;
    height: 51px;
    border-radius: 50%;
}

.list-group .list-group-item {
    padding: 18px 12px;
    background-color: #80808012;
}

.list-group-item:first-child {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

.activity-row {
    margin-bottom: 1em;
    padding-bottom: 1em;
}

.activity-row {
    margin-bottom: 1.5em;
    padding-bottom: 1.5em;
    border-bottom: 1px solid #EEE;
}

.activity-row, .activity-row1 {
    text-align: left;
    background-color: #fff;
    box-shadow: 0 6px 8px 0 rgba(0,0,0,0.07), 0 6px 18px 0 rgba(0,0,0,0.19);
    margin: 9px;
}

.activity-desc h5 {
    color: #00BCD4;
    font-size: 1em;
    font-weight: 400;
    margin-bottom: 5px;
}

.activity-desc h5 {
    font-size: 0.85em;
}

    .activity-desc h5 a {
        color: #00BCD4;
    }

.activity-desc p {
    font-size: 12px;
}

.activity-desc p {
    color: #999;
    font-size: 0.85em;
    line-height: 1.5em;
}

.activity-desc1 h6 {
    color: #000000ab;
    font-size: 13px;
    margin: 1em 0 0 0;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden !important;
    text-overflow: ellipsis;
}

#time_status {
    background-color: #00C6D7;
    height: 16px;
    color: white;
    padding-left: 10px;
    padding-top: 2px;
    border-radius: 8px;
    font-size: 11px;
}

.scrollbar {
    height: 380px;
    background: #fff;
    overflow-y: scroll;
}

.list-group {
    /*height: 399px;*/
    padding-left: 7px;
    margin-bottom: 21px;
    padding-right: 7px;
    padding-top: 5px;
}

.widget .widget-header h3 i {
    width: 18px;
    padding: 10px 0;
    font-size: 16px;
    color: #6A6A6A;
}

.gutter.row {
    margin-right: -7px;
    margin-left: -7px;
}

ul.email-quotes li {
    /*width: 12%;*/
    padding: 15px 10px;
    float: left;
    box-sizing: border-box;
    text-align: center;
    /*border-right: 1px solid #dbdbdb;
border-left: 1px solid #fff;*/
}

    ul.email-quotes li h3 {
        font-weight: 600;
        margin: 0;
        padding: 0;
    }

.text-info {
    color: #2698e2;
}

.panel {
    margin-bottom: 14px;
    border: 1px solid #dbdbdb;
    -webkit-border-radius: 3px;
    -moz-border-radius: 3px;
    border-radius: 3px;
    -webkit-box-shadow: none;
    padding: 0;
}

.panel-default > .panel-heading {
    /*box-shadow: 0 4px 8px 0 rgba(0,0,0,0.07), 0 6px 20px 0 rgba(0,0,0,0.19);*/
    color: #428bca;
    background-color: #f5f5f5;
    border-color: #ddd;
    font-weight: 600;
    border-left: 1px solid #ddd;
}

.panel-heading {
    position: relative;
    padding: 12px 15px;
    border: 0;
    background-color: #fcfcfc;
    background-image: -webkit-gradient(linear,0 0,0 100%,from(#fff),color-stop(85%,#fff),to(#f2f2f2));
    background-image: -webkit-linear-gradient(#fff,#fff 85%,#f2f2f2);
    background-image: -moz-linear-gradient(top,#fff,#fff 85%,#f2f2f2);
    background-image: -o-linear-gradient(#fff,#fff 85%,#f2f2f2);
    background-image: linear-gradient(#fff,#fff 85%,#f2f2f2);
    background-repeat: no-repeat;
    -webkit-border-radius: 2px 2px 0 0;
    -moz-border-radius: 2px 2px 0 0;
    border-radius: 2px 2px 0 0;
    border-bottom: 1px solid #dbdbdb;
}

    .panel-heading h4 span {
        font-size: 13px;
        color: grey;
        font-style: italic;
    }

ul.email-quotes {
    /* background-color: #f2f2f2; */
    background-image: -webkit-gradient(linear,left top,left bottom,from(#fff),to(#f2f2f2));
    background-image: -webkit-linear-gradient(top,#fff,#f2f2f2);
    background-image: -moz-linear-gradient(top,#fff,#f2f2f2);
    background-image: -ms-linear-gradient(top,#fff,#f2f2f2);
    background-image: -o-linear-gradient(top,#fff,#f2f2f2);
    background-image: linear-gradient(top,#fff,#f2f2f2);
    -webkit-border-radius: 2px;
    -moz-border-radius: 2px;
    border-radius: 2px;
    border: 1px solid #dbdbdb;
}

ul {
    list-style-type: none;
}

#panel-details {
    /*box-shadow: 0 4px 8px 0 rgba(0,0,0,0.07), 0 6px 20px 0 rgba(0,0,0,0.19);*/
    padding: 12px;
}

.progress {
    position: relative;
    margin: 4px;
    float: left;
    text-align: center;
}

.barOverflow { /* Wraps the rotating .bar */
    position: relative;
    overflow: hidden; /* Comment this line to understand the trick */
    width: 90px;
    height: 45px; /* Half circle (overflow) */
    margin-bottom: -14px; /* bring the numbers up */
}

.bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 90px;
    height: 90px; /* full circle! */
    border-radius: 50%;
    box-sizing: border-box;
    border: 5px solid #eee; /* half gray, */
    border-bottom-color: #0bf; /* half azure */
    border-right-color: #0bf;
}

#container_p {
    width: 210px;
    height: 100px;
    margin-top: -19px !important;
}

svg {
    /*margin-top: -17px;*/
    height: 120px;
    width: 166px;
    fill: none;
    stroke: #42c8f4;
    stroke-width: 10;
    /*stroke-linecap: round;*/
    -webkit-filter: drop-shadow( -3px -2px 5px gray);
    filter: drop-shadow( 0px 0px 1px grey );
}

.nav > li > a:hover {
    text-decoration: underline;
    background-color: transparent;
    text-decoration-color: #FF0000 !important;
    cursor: pointer;
}
/*.box.box-danger {
border-top-color: #dd4b39;
}*/
.box {
    position: relative;
    border-radius: 3px;
    background: #ffffff;
    /*border-top: 3px solid #d2d6de;*/
    margin-bottom: 20px;
    width: 100%;
    box-shadow: 0 1px 1px rgba(0,0,0,0.1);
}

.box-header.with-border {
    border-bottom: 1px solid #f4f4f4;
}

.box-header {
    color: #444;
    display: block;
    padding: 10px;
    position: relative;
}

    .box-header .box-title {
        display: inline-block;
        font-size: 18px;
        margin: 0;
        line-height: 1;
    }

    .box-header > .box-tools {
        position: absolute;
        right: 10px;
        top: 5px;
    }

.label-danger {
    background-color: #dd4b39 !important;
}

.no-padding {
    padding: 0 !important;
}

.box-body {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    padding: 10px;
}

.users-list {
    list-style: none;
    margin: 0;
    padding: 0;
}

    .users-list > li {
        width: 25%;
        float: left;
        padding: 10px;
        text-align: center;
    }

        .users-list > li img {
            border-radius: 50%;
            width: 50px;
            height: 50px;
        }

.users-list-name {
    font-weight: 600;
    color: #444;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.users-list-name {
    display: block;
}

.users-list-date {
    color: #999;
    font-size: 12px;
}

.box-footer {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-top: 1px solid #f4f4f4;
    padding: 10px;
    background-color: #fff;
}

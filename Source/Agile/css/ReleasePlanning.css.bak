.input-box {
    position: relative;
    background: #fff;
    width: 100%;
    height: auto;
}

.input-box-p {
    padding: 8px;
    display: inline-block;
    width: 50%;
    height: auto;
    color: #555;
    line-height: 1.42857143;
    background: #fff;
    box-shadow: 0 4px 6px 0 rgba(0,0,0,0.2);
}

/*#btnRelease {
    margin-left: 42%;

}*/
.card .card-header-primary:not(.card-header-icon):not(.card-header-text) {
    background: lightslategray !important;
}

.fixed-top {
    position: fixed !important;
    right: 0;
    left: 0;
    z-index: 1030;
    background: #e5e5e5;
    padding: 2px;
    margin-top: -10px;
    line-height: 2;
}

.title {
    color: #292828;
    font-weight: 500;
    font-size: 16px !important;
    margin-top: 15px !important;
    margin-left: 40px;
}
.upload {
    background: #01579b;
    padding: 8px;
    color: #fff;
    border-radius: 4px;
}

.header_border {
    border-bottom: 2px solid rgb(60, 141, 188) !important;
}

.fa-align-justify span {
    position: absolute;
    background: #ff1744;
    color: #fff;
    left: 24px;
    top: -12px !important;
    font-size: 9px !important;
    padding: 0px 4px !important;
}

.alertify-notifier ul {
    /*text-align:left;*/
    margin-left: -10px !important;
}

.badge {
    font-size: .25em;
    display: block;
    position: absolute;
    top: -.75em;
    right: -.75em;
    width: 2em;
    height: 2em;
    line-height: 2em;
    border-radius: 20%;
    text-align: center;
    color: #fff;
    background: #dc3545;
}


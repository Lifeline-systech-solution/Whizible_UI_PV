        padding: 0px 4px !important;
        background: #ffc107 !important;
        margin-left: 18px;
    }

#FreeTextBox_editor {
    height: 145px !important;
}

/*/Chart/*/

/* Style the tab */
.tab {
    float: left;
    border: 1px solid #ccc;
    /* background-color: #f1f1f1; */
    width: 14%;
    height: 191px;
    border-radius: 10px;
    margin-top: 2%;
}

.chartjs-size-monitor {
    top: auto !important;
}

/* Style the buttons inside the tab */
.tab button {
    display: block;
    background-color: inherit;
    color: black;
    padding: 6px 16px;
    width: 100%;
    border: none;
    outline: none;
    text-align: left;
    cursor: pointer;
    transition: 0.3s;
    font-size: 17px;
    margin-left: -5%;
    margin-top: 2%;
    font-size: 12px !important;
}

    /* Change background color of buttons on hover */
    .tab button:hover {
        /*border-right: 5px solid #3c7dcf!important;*/
        /*margin-left: -5%;*/
        margin-top: 2%;
        color: black;
    }

/* Create an active/current "tab button" class */
button.active {
    background-color: #3c7dcf;
    /*border-right: 5px solid #3c7dcf!important;*/
    /*margin-left: -5%;*/
    margin-left: 0%;
    margin-top: 2%;
    color: white;
}

.tab button.active:hover {
    /*background-color: #3c7dcf;*/
    border-right: 5px solid #3c7dcf !important;
}
/*#defaultOpen {
     border-right: 3px solid #3c7dcf!important;
}*/
/* Style the tab content */

/*/End of Chart/*/
.sprint_backLabel {
    padding-top: 5px;
    position: absolute !important;
    top: -8px !important;
    /*  right: 19px!important;*/
    /* text-align: center; */
    font-size: 9px !important;
    /* padding: 2px 3px; */
    /* line-height: .9; */
}

#DivCancelSprint .dataTables_length {
    display: none;
}

#DivCompleteSprint .dataTables_length {
    display: none;
}

#DivCompleteSprint .dataTables_info {
    display: none;
}

#DivCancelSprint .dataTables_info {
    display: none;
}

#DivCompleteSprint .dataTables_filter {
    display: none;
}

#DivCancelSprint .dataTables_filter {
    display: none;
}

#DivCancelSprint .clsTRColumnHeader {
    display: none;
}

#DivCompleteSprint .clsTRColumnHeader {
    display: none;
}

#DivCancelSprint .dataTables_info {
    display: none;
}

#DivCancelSprint .dataTables_scrollBody {
    height: 220px !important;
}

#DivCompleteSprint .dataTables_scrollBody {
    height: 220px !important;
}

.discussionbox {
    padding: 10px;
}

#ulTabs {
    background-color: #0288D1 !important;
    width: auto;
    padding-right: 9px;
    padding-bottom: 16px;
    padding-top: 16px;
    margin-left: 25PX;
    margin-right: 23PX;
    text-align: center;
}

    #ulTabs a {
        color: #fff;
    }

#DivCancelSprint {
    overflow: auto;
    margin-left: -2%;
    /* width: 105%; */
    margin-right: -3%;
}

    #DivCancelSprint .table > tbody > tr > td {
        border-top: 1px solid #DDD !important;
        border-bottom: 1px solid #DDD !important;
        height: 40px;
        padding-top: 10px;
        /*border: none!important;*/
    }


#DivCompleteSprint .table > tbody > tr > td {
    border-top: 1px solid #DDD !important;
    border-bottom: 1px solid #DDD !important;
    height: 40px;
    padding-top: 10px;
}

#DivCompleteSprint {
    overflow: auto;
    margin-left: -2%;
    /* width: 105%; */
    margin-right: -3%;
}

    #DivCompleteSprint .table-bordered {
        border: none !important;
    }

.divLineGraph {
    padding: 5px;
    border-top: 2px solid #3c8dbc !important;
    border-right: none;
    border-left: none;
    border-bottom: none;
    height: 100%;
    width: 100% !important;
}

.tblMain {
    width: 100%;
    margin-left: 2%;
}

    .tblMain tr td {
        width: 50%;
    }

/*.ui-state-highlight{
    border: 5px dashed;
    border-color: darkgrey;
    margin: 2px 20px 2px 50px;
    height: 140px;
}*/

#Clsbox {
    border: none !Important;
    border-top: 3px solid #d2d6de;
}

.box.box-primary {
    border-top-color: #3c8dbc;
}

.ClsHeaderGraph {
    margin-top: 0%;
    margin-left: 2%;
}


.box {
    position: relative;
    border-radius: 3px;
    background: #ffffff !Important;
    border-top: 3px solid #d2d6de !Important;
    margin-bottom: 20px;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.1);
}

.chart-container {
    width: 80%;
    height: 480px;
    margin: 0 auto;
}
/*New Design*/
.sprint_card {
    background: #fff !important;
    margin: 14px;
    padding: 12px 3px;
    box-shadow: 0 5px 5px rgba(0,0,0,.1),0 6px 10px 0 rgba(0,0,0,0.19);
    -webkit-box-shadow: 0 5px 5px rgba(0,0,0,.1),0 6px 10px 0 rgba(0,0,0,0.19);
}

    .sprint_card:hover {
        -webkit-transform: translateY(-3px);
        transform: translateY(-3px);
        box-shadow: 0 4px 6px 0 rgba(0,0,0,0.07), 0 6px 10px 0 rgba(0,0,0,0.19);
        -webkit-box-shadow: 0 4px 6px 0 rgba(0,0,0,0.07), 0 6px 10px 0 rgba(0,0,0,0.19);
    }

.lblname {
    color: #948e8e !important;
    font-size: 13px !important;
    font-weight: 600;
}

.card-text {
    font-size: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: #948e8e !important;
}

    .card-text .fa {
        font-size: 16px !important;
    }

#Showmore:hover {
    color: #428bca !important;
}

.more {
    font-size: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: #1484e4 !important;
}

.arrow {
    margin: 6% -10px;
    position: fixed;
    bottom: 6%;
    float: right;
}

.bounce {
    -moz-animation: bounce 2s infinite;
    -webkit-animation: bounce 2s infinite;
    animation: bounce 2s infinite;
}

.filter-menu {
    top: auto !important;
    max-height: 420px !important;
    width: 160px;
    padding: 0px;
    right: 0px !important;
    left: auto !important;
}

.category {
    top: auto !important;
    max-height: 420px !important;
    width: 360px;
    padding: 0px;
    right: 0px !important;
    left: auto !important;
}

@keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
        transform: translateY(0);
    }

    40% {
        transform: translateY(-30px);
    }

    60% {
        transform: translateY(-15px);
    }
}

.label {
    display: inline;
    padding: .4em .6em .4em;
    font-size: 75%;
    font-weight: 700;
    line-height: 1;
    color: #fff;
    white-space: nowrap;
    vertical-align: baseline;
    border-radius: .25em;
    border-radius: 10px !important;
    padding: 2px 4px !important;
}

.Activity {
    overflow-x: hidden !important;
    height: 650px;
}

.btn, .btn.btn-default {
    text-transform: capitalize !important;
}

.card [class*=card-header-]:not(.card-header-icon):not(.card-header-text):not(.card-header-image) {
    border-radius: 3px;
    margin-top: -20px;
    padding: 8px !important;
}

.clsmappendSprint {
    /*border-left: 3px solid #ffa5008f !important;*/
    margin-top: 0%;
    width: 492px;
    /*border: 1px solid lightgray !important;*/
    /*box-shadow: lightgrey 2px 5px !important;*/
    /* margin-left: 8%; */
}

.Task_Completion_Percentage {
    float: right;
    margin-top: -38px;
    margin-right: 3px;
}

.attachment_table {
    border: 1px solid #ddd;
    padding: 8px;
    word-wrap: break-word;
}

.dropdown-success {
    padding: 7px !important;
}

.tooltip.bottom {
    padding: 5px 0;
    margin-top: 3px;
    margin-left: 39px !important;
}

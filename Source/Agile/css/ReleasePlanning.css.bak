}

#div_details, .scrollspy-example, #divSprints, #div1, #Teams, #div2, #div9, #ImpedimentsLogs, #Risks, #History, #div6, #div3, #Sprints {
    overflow-y: hidden !important;
}

    #div_details:hover, .scrollspy-example:hover, #divSprints:hover, #div1:hover, #Teams:hover, #div2:hover, #div9:hover, #ImpedimentsLogs:hover, #Risks:hover, #History:hover, #div6:hover, #div3:hover, #Sprints:hover {
        overflow-y: auto !important;
    }

#Export {

.dataTables_filter {
    display: none !important;
}

.dataTables_length {
    display: none !important;
}

#Divlist {
    width: 95% !important;
    margin-top: 2%;
}

    #Divlist .dataTables_sizing {
        height: 30px !important;
        color: #867c7c !important;
        font-weight: 600;
        /* text-align: center!important; */
        margin-top: 10px;
        vertical-align: middle;
    }

    #Divlist .dataTables_scrollHeadInner {
        display: none;
    }


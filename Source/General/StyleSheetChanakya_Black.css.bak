    SCROLLBAR-3DLIGHT-COLOR: #F2F3F3;
    SCROLLBAR-ARROW-COLOR: #545454;
    SCROLLBAR-TRACK-COLOR: #F2F3F3;
    SCROLLBAR-DARKSHADOW-COLOR: #F2F3F3;
    SCROLLBAR-BASE-COLOR: #e0e7ef;
    scroll: auto
}

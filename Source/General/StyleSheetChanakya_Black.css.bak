#tree
{
    FONT-SIZE: 7pt;
    FONT-FAMILY: Verdana, Arial
}
#tree A
{
    FONT-WEIGHT: lighter;
    FONT-SIZE: 7pt;
    COLOR: black;
    FONT-FAMILY: Verdana, Arial;
    TEXT-DECORATION: none
}
#tree A:hover:unknown
{
    FONT-WEIGHT: lighter;
    FONT-SIZE: 7pt;
    COLOR: red;
    FONT-FAMILY: Verdana, Arial;
    TEXT-DECORATION: none
}
#tree IMG
{
    BORDER-RIGHT: 0px;
    BORDER-TOP: 0px;
    BORDER-LEFT: 0px;
    WIDTH: 19px;
    BORDER-BOTTOM: 0px;
    HEIGHT: 16px
}
#inactive
{
    FONT-WEIGHT: normal;
    FONT-SIZE: 9px;
    BACKGROUND-IMAGE: none;
    MARGIN: 2pt 2pt 2pt 1px;
    COLOR: gray;
    FONT-FAMILY: Verdana, Arial
}
BODY.clsBody
{
    BORDER-RIGHT: #000000 6px solid;
    PADDING-LEFT: 2px;
    SCROLLBAR-FACE-COLOR: #AFAFAE;
    FONT-SIZE: 7pt;
    MARGIN: 2px 0px;
    SCROLLBAR-HIGHLIGHT-COLOR: #F2F3F3;
    BORDER-LEFT: #000000 0px solid;
    SCROLLBAR-SHADOW-COLOR: #F2F3F3;
    SCROLLBAR-3DLIGHT-COLOR: #F2F3F3;
    LINE-HEIGHT: 1;
    SCROLLBAR-ARROW-COLOR: #545454;
    PADDING-TOP: 0px;
    SCROLLBAR-TRACK-COLOR: #F2F3F3;
    BORDER-BOTTOM: #000000 6px solid;
    BACKGROUND-REPEAT: repeat;
    FONT-FAMILY: Verdana, Arial;
    SCROLLBAR-DARKSHADOW-COLOR: #F2F3F3;
    SCROLLBAR-BASE-COLOR: #e0e7ef
}
BODY.clsPageBody
{
    BORDER-RIGHT: #000000 6px solid;

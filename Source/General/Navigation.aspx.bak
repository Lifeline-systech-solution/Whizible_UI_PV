                             //}
                             //else {//Need to change
                             strHTML += '<li  data-toggle="tooltip" data-placement="bottom" title="' + DisplayTagName + '" class="treeview search" id="mainmenu_' + flag + '" >' + "<input type='hidden' id='header_" + TagID + "' value='" + DisplayTagName + "'>" + '<a onclick=ChangeTabs(this,"' + encodeURI(DisplayPageName) + '",' + TagID + ',"' + TemplateID + '","' + ResponsivePageName + '")><i class="fa"><img src="../../Whizible2.0/dist/img/' + Image + '"  alt="" width="44px"></i> <span class="searchText" originalName="' + DisplayTagName + '" >' + DisplayTagName + '</span></a>'
                             // }

                         } else {

                             if (ParentTagId == 305) {
                                 strHTML += '<li data-toggle="tooltip" data-placement="bottom" title="' + DisplayTagName + '" class="treeview search" id="mainmenu_' + flag + '" >' + "<input type='hidden' id='header_" + TagID + "' value='" + DisplayHeader + "'>" + '<a onclick=ChangeTabs(this,"' + encodeURI(DisplayPageName) + '",' + TagID + ',"' + TemplateID + '","' + ResponsivePageName + '")><span class="pull-left-container"><i class="fas fa-caret-right"></i></span><i class="fa"><img src="../../Whizible2.0/dist/img/' + Image + '"  alt="" width="44px"></i> <span class="searchText"  originalName="' + DisplayTagName + '" >' + DisplayTagName + '</span></a>'
                             }
                             else {
                                 strHTML += '<li data-toggle="tooltip" data-placement="bottom" title="' + DisplayTagName + '" class="treeview search" id="mainmenu_' + flag + '" >' + "<input type='hidden' id='header_" + TagID + "' value='" + DisplayHeader + "'>" + '<a onclick=ChangeTabs(this,"' + encodeURI(DisplayPageName) + '",' + TagID + ',"' + TemplateID + '","' + ResponsivePageName + '")><span class="pull-left-container"><i class="fas fa-caret-right"></i></span><i class="fa"><img src="../../Whizible2.0/dist/img/' + Image + '"  alt="" width="44px"></i> <span class="searchText"  originalName="' + DisplayTagName + '" >' + DisplayTagName + '</span></a>'
                             }

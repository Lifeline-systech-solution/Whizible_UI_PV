                             //if (childParentTagId == 1085) { IsHelpdeskDashbordLandingPage = 0; }
                             // if (childParentTagId == 914) { IsHelpdeskConfigurationLandingPage = 0; }
                             //End of Added by Chetan M on 7th May 2020 for Helpdesk support landing page.

                             strHTML += "<li class='search makesmaller' data-toggle='tooltip' ><input type='hidden' id='header_" + TagID + "' value='" + DisplayHeader + "'><a href=# onclick=ChangeTabs(this,'" + encodeURI(DisplayPageName) + "'," + TagID + ",'" + TemplateID + "','" + ResponsivePageName + "')><span class='searchText' originalName='" + DisplayTagName + "'>" + DisplayTagName + "</span></a></li>"
                         }

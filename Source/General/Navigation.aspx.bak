                     //}
                     strResponsiveHTML += '<li class="Mmenulogo"><a href="#"><i class="fa">&nbsp;</i> <span><img src="../../Whizible2.0/dist/img/mobmenu/Whisible.svg" alt="" width="60px"></span></a></li>';

                     $("#responsiveMenu").html(strResponsiveHTML);

                     //strHTML += "<li class='' id='mainmenu_" + flag + "' onclick=ChangeTabs('../NewAPI/Dashboard/Dashboard.aspx',10,10,'')><a><input type='hidden' id='header_10' value=''><i class='fa'><img src='../../Whizible2.0/dist/img/" + Image + "'  alt='' width='44px'></i> <span>Dashboard</span></a></li>"

                     //$("#treeMenu").html(strHTML);


                     //For submenu scroll Pradip
                     //$('.submenu_slim_scroll').slimScroll({
                     //    //your options
                     //    opacity: 0
                     //}).mouseover(function () {
                     //    $(this).next('.slimScrollBar').css('opacity', 0.4);
                     //});

                     //For submenu scroll Pradip
                     //Script Added by pradip on 10-06-2020 for offset menu
                     function determineDropDirection() {
                         $(".sidebar-menu .dropdown-menu").each(function () {
                             // Invisibly expand the dropdown menu so its true height can be calculated
                             $(this).css({
                                 visibility: "hidden",
                                 display: "block"
                             });

                             // Necessary to remove class each time so we don't unwantedly use dropup's offset top
                             $(this).parent().removeClass("dropup");

                             // Determine whether bottom of menu will be below window at current scroll position
                             if ($(this).offset().top + $(this).outerHeight() > $(window).innerHeight() + $(window).scrollTop()) {
                                 $(this).parent().addClass("dropup");
                             }

                             // Return dropdown menu to fully hidden state
                             $(this).removeAttr("style");
                         });
                     }

                     determineDropDirection();
                     $(window).scroll(determineDropDirection);
                     //End Script Added by pradip on 10-06-2020

                     if ("<%= Request.QueryString("FromOld")%>" == "10") {
                         if (IsTimesheetLandingPage == 0) {
                             ChangeTabs('../NewAPI/Timesheet/TimesheetEntry.aspx', 2124, 10);
                         }
                         else {
                             ChangeTabs('../NewAPI/Timesheet/TMS_LandingPage.aspx?TagID=10', 2124, 10);
                         }

                         plotChildSubMenu(10);
                         //Added By Usha Pandit On 19.07.2019 For showing correct header name of the page currently getting shown
                         if (IsTimesheetLandingPage == 0) {
                             document.getElementById("mainHeadingTop").innerHTML = document.getElementById("header_" + 2124).value;
                         }
                         //End Of Added By Usha Pandit On 19.07.2019 For showing correct header name of the page currently getting shown
                     }
                     //Added by Chetan M on 7th May 2020 for Helpdesk support landing page.
                     else if ("<%= Request.QueryString("FromOld")%>" == "405") {
                         if (IsHelpdeskSupportLandingPage == 0) {
                             ChangeTabs('../HelpdeskEnhancement/Settings/HelpdeskTab.aspx', 405, 405);
                         }
                         else {
                             ChangeTabs('../HelpdeskEnhancement/Settings/CRM_LandingPage.aspx?TagID=405', 405, 405);
                         }

                         plotChildSubMenu(405);
                         if (IsHelpdeskSupportLandingPage == 0) {
                             document.getElementById("mainHeadingTop").innerHTML = document.getElementById("header_" + 405).value;
                         }
                     }
                     else if ("<%= Request.QueryString("FromOld")%>" == "32") {
                         plotChildSubMenu(32);
                     }
                     else if ("<%= Request.QueryString("FromOld")%>" == "21000") {
                         ChangeTabs('../NewAPI/Dashboard/Dashboard.aspx', 21000, 21000, '../NewAPI/Dashboard/Dashboard.aspx');
                         plotChildSubMenu(9999);
                     }
                     else if ("<%= Request.QueryString("FromOld")%>" == "21006") {
                         ChangeTabs('../NewAPI/PM/ProjectDashBoard.aspx', 21006, 21006, '../NewAPI/PM/ProjectDashBoard.aspx');
                         plotChildSubMenu(9999);
                     }
                     else if ("<%= Request.QueryString("FromOld")%>" == "405") {
                         ChangeTabs('../HelpdeskEnhancement/Settings/HelpdeskTab.aspx', 405, 405);

                     }
                     else if ("<%= Request.QueryString("FromOld")%>" == "5") {
                         ChangeTabs('../NewAPI/Issues/IssueList.aspx', 5, 5);

                     }
                     else {
                         if (IsTimesheetPresent == 1) {
                             if (IsTimesheetLandingPage == 0) {
                                 ChangeTabs('../NewAPI/Timesheet/TimesheetEntry.aspx', 2124, 10, '../NewAPI/TimesheetMobile/TimesheetEntry_Mobile.aspx');
                             }
                             else {
                                 ChangeTabs('../NewAPI/Timesheet/TMS_LandingPage.aspx?TagID=10', 2124, 10, '../NewAPI/TimesheetMobile/TimesheetEntry_Mobile.aspx');
                             }

                             //ChangeTabs('../NewAPI/Dashboard/Dashboard.aspx', 21000, 21000,'../NewAPI/Dashboard/Dashboard.aspx');

                             plotChildSubMenu(10);

                             //Added By Usha Pandit On 19.07.2019 For showing correct header name of the page currently getting shown
                             if (IsTimesheetLandingPage == 0) {
                                 document.getElementById("mainHeadingTop").innerHTML = document.getElementById("header_" + 2124).value;
                             }
                             //End Of Added By Usha Pandit On 19.07.2019 For showing correct header name of the page currently getting shown
                         }
                         //Added by Chetan M on 7th May 2020 for Helpdesk support landing page.
                         else if (IsHelpdeskSupportPresent == 1) {
                             if (IsHelpdeskSupportLandingPage == 0) {
                                 ChangeTabs('../HelpdeskEnhancement/Settings/HelpdeskTab.aspx', 405, 405, '../HelpdeskEnhancement/Settings/HelpdeskTab.aspx');
                             }
                             else {
                                 ChangeTabs('../HelpdeskEnhancement/Settings/CRM_LandingPage.aspx?TagID=405', 405, 405, '../HelpdeskEnhancement/Settings/HelpdeskTab.aspx');
                             }

                             plotChildSubMenu(405);
                             if (IsHelpdeskSupportLandingPage == 0) {
                                 document.getElementById("mainHeadingTop").innerHTML = document.getElementById("header_" + 405).value;
                             }
                         }

                         else if (IsProjectPresent == 1) {
                             plotChildSubMenu(32);
                         }
                         else {
                             if ('<%=Session("intLoginID")%>' == 'E') {
                                 ChangeTabs('../General/Navigation.aspx?FromWhere=DB', 305, 305, '');
                             }
                             else if ('<%=Session("LoginType")%>' == 'C') {
                                 if (TagID == 405) {
                                     ChangeTabs('../HelpdeskEnhancement/Settings/HelpdeskTab.aspx', 405, 405);
                                 }
                             }
                         }
                     }

                 },
                 error: function (err) {
                     // console.log(err);
                     //alert(err.statusText);
                     // alert(err);
                     window.location.href = "../../Default.aspx?Message=SessionExpired";
                 }
             })
         }


         function SearchTags(e) {
             var searchTags = $("#searchTags").val();
             $(".search").each(function (id, val) {
                 $(this).find(" > a").find(" > .searchText").html($(this).find(" > a").find(" > .searchText").attr("originalName"));
             });
             if (searchTags == "") {
                 $(".search").css("display", "");
                 $(".treeview").removeClass("active");
                 return;
             }
             //if (e.keyCode == 13) {
             $(".search").each(function (id, val) {
                 $(".treeview").addClass("active");

                 if ($(this).find(" > a").find(" > .searchText").attr("originalName").toLowerCase().indexOf(searchTags.toLowerCase()) > -1) {
                     var startIndex = $(this).find(" > a").find(" > .searchText").attr("originalName").toLowerCase().indexOf(searchTags.toLowerCase());
                     var endIndex = startIndex + searchTags.length;
                     var strToReplace = $(this).find(" > a").find(" > .searchText").attr("originalName").substring(startIndex, endIndex);
                     var strGenerated = $(this).find(" > a").find(" > .searchText").attr("originalName").replace(strToReplace, "<mark>" + strToReplace + "</mark>");
                     $(this).css("display", "");
                     $(this).parents().css("display", "");
                     $(this).find(" > a").find(" > .searchText:first-child").html(strGenerated);
                 }
                 else {
                     $(this).css("display", "none");
                 }
             })
             //}
         }

         function getChildTags(parentTagId) {

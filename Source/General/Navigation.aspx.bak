                legend: {
                    show: true,
                    //placement: 'outside',
                    rendereroptions: {
                        numberrows: 1
                    },
                    location: 's',
                }
            }
            var plot = $.jqplot('leaveGraph1', [dataSlices], options);

            dataSlices = [];
            dataLabels = "";
        };


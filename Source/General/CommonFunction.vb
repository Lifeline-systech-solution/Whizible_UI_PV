                ' Revisions				:   
                '=====================================================================	                
                Dim blnSendEmail As Boolean
                Dim blnShowPopup As Boolean
                ' Get the flag status for the messaage. (i.e. 1. Whether the mail has to be sent? 2. Should a popup page must be displayed?)
                Dim drEmailMessage As IDataReader = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_EmailMessages " + strMessageID, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                If drEmailMessage.Read Then
                    blnSendEmail = CType(CommonFunction.Data.CheckIsDBNull(drEmailMessage("SendMail")), Boolean)
                    blnShowPopup = CType(CommonFunction.Data.CheckIsDBNull(drEmailMessage("ShowPopup")), Boolean)
                End If
                CommonFunction.Data.DisposeDataReader(drEmailMessage)

                ' If the mail must be sent, then...
                If blnSendEmail = True Then

                    ' If the mail must be sent silently, then...
                    If blnShowPopup = False Then
                        Dim strFromEmailID As String
                        Dim strToEmailID As String
                        Dim strCCToEmailID As String
                        Dim strSubject As String
                        Dim strEmailMessage As String
                        ' Get the mail content and send the mail.
                        Select Case CType(strMessageID, Long)
                            Case 483
                                Call GetEmailMessage_483(strFromEmailID, strToEmailID, strCCToEmailID, strSubject, strEmailMessage, strUniqueID)
                            Case 484
                                Call GetEmailMessage_484(strFromEmailID, strToEmailID, strCCToEmailID, strSubject, strEmailMessage, strUniqueID)
                            Case 485
                                Call GetEmailMessage_485(strFromEmailID, strToEmailID, strCCToEmailID, strSubject, strEmailMessage, strUniqueID)
                            Case 486
                                Call GetEmailMessage_486(strFromEmailID, strToEmailID, strCCToEmailID, strSubject, strEmailMessage, strUniqueID)
                            Case 487
                                Call GetEmailMessage_487(strFromEmailID, strToEmailID, strCCToEmailID, strSubject, strEmailMessage, strUniqueID)
                            Case 488
                                Call GetEmailMessage_488(strFromEmailID, strToEmailID, strCCToEmailID, strSubject, strEmailMessage, strUniqueID)

                        End Select
                        Call CommonFunction.Emails.AppSendEmailWithCC(strToEmailID, strCCToEmailID, strFromEmailID, strSubject, strEmailMessage)

                        ' Else, if the mail must be displayed in the popup window, then...
                    Else
                        ' Display the mail content in the popup window.
                        CommonFunction.General.WriteHTML("<script language = javascript>" + vbCrLf)
                        CommonFunction.General.WriteHTML("window.open (" + Chr(34) + "../General/SendEmail.aspx?MessageID=" + strMessageID + "&UniqueID=" + strUniqueID + Chr(34) + ",""Planned"",""resizable=yes,scrollbars=no,left="" + (window.screen.width - 600) / 2 + "",top="" + (window.screen.height - 500) / 2 + "",width=600,height=500"");" + vbCrLf)
                        CommonFunction.General.WriteHTML("</script>" + vbCrLf)
                    End If
                End If
            End Sub
            Public Shared Sub GetEmailMessage_470(ByRef strFromEmailID As String, ByRef strToEmailID As String,
                                                ByRef strCCToEmailID As String, ByRef strSubject As String,
                                                ByRef strEmailMessage As String)
                '=====================================================================
                ' Procedure Name		:	GetEmailMessage_470 (PROJECT Reopen)
                ' Parameters Passed     :	strToEmailID		:- The EmailID of the person to whom the message will be returned.
                '							strSubject		:- The Subject of the Email Message.
                '							strEmailMessage	:- The body of the Email Message.	
                ' Returns               :	
                ' Parameters Affected   :	strToEmailID, strSubject, strEmailMessage :- These values are returned by the subroutine by reference.
                ' Description           :	Generate the email message as defined in the System Email Messages table in the database.
                ' Purpose               :	Generate the email message as defined in the System Email Messages table in the database.
                ' Assumptions           :	The message ID exists in the database.
                '							The message does not contain any other parameters besides the following :
                '								1.	<NAME>
                '								2.	<SENDER_NAME>
                '								3.	<PROJECT_NAME> 
                '								4.	<DESIGNATION>
                '								5.	<EXPERIENCE>	
                ' Dependencies          :	None.
                ' Author                :	Jayavant
                ' Created               :	12-Mar-2004
                ' Revisions             :
                '=====================================================================	

                Dim strUserName As String = ""
                Dim strProjectName As String = ""
                Dim drTempWork As IDataReader
                Dim strQuery As String = ""
                Dim intEmployeeYears As Integer = 0
                Dim intEmployeeMonths As Integer = 0
                Dim strDescription As String = ""
                Dim strEmailId As String = ""

                Dim intCtr As Integer = 0

                Dim strEmployeeExperience As String = ""
                Dim strEmployeeName As String = ""
                Dim strListOfEmployeeIDs As String = ""
                Dim strListOfEmployeeNames As String = ""
                Dim strListOfEmailIDs As String = ""
                Dim strTempArray() As String
                Dim intMessageID As Integer = 0
                Dim strReopenComment As String
                'Addition By SnehalV for WhizibleSEM SP8 integration on 2nd Nov 2006
                '1. Code for String Builder Changes - IssueID - 6052 
                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder
                'end of addition by SnehalV

                intMessageID = 470

                ' Get the message body, and subject.
                strQuery = "usp_Sel_tbl_PM_EmailMessages " & intMessageID.ToString()
                drTempWork = CommonFunctions.Data.GetDataReader(strQuery, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                If CommonFunctions.General.CheckIsNothing(drTempWork) <> "" Then
                    If drTempWork.Read() Then
                        strEmailMessage = drTempWork.Item("Body").ToString().Trim()
                        strEmailMessage = CommonFunctions.General.UnBuildQueryString(strEmailMessage)
                        strSubject = drTempWork.Item("Subject").ToString().Trim()
                        strSubject = CommonFunctions.General.UnBuildQueryString(strSubject)
                        strListOfEmployeeIDs = drTempWork.Item("ListOfEmployees").ToString().Trim()
                        strListOfEmployeeIDs = CommonFunctions.General.UnBuildQueryString(strListOfEmployeeIDs)
                    End If
                End If
                CommonFunctions.Data.DisposeDataReader(drTempWork)

                'Addition By SnehalV for WhizibleSEM SP8 integration on 2nd Nov 2006
                '2. Code for String Builder Changes - IssueID - 6052 
                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)
                'end of addition by SnehalV

                ' Retrieve information about the Project.
                Call GetProjectInfo(CType(HttpContext.Current.Session("intProjectID"), Long), strProjectName, intMessageID, strCCToEmailID)
                'Addition By SnehalV for WhizibleSEM SP8 integration on 2nd Nov 2006
                '3. Code for String Builder Changes - IssueID - 6052 
                'strEmailMessage = Replace(strEmailMessage, "<PROJECT_NAME>", strProjectName)
                'strSubject = Replace(strSubject, "<PROJECT_NAME>", strProjectName)
                strMessage.Replace("<PROJECT_NAME>", strProjectName)
                strEmailSubject.Replace("<PROJECT_NAME>", strProjectName)
                'end of addition by SnehalV

                ' Modified By RajaniR on 27th February 2002.
                Call GetSenderInfo(strUserName, strFromEmailID)
                'Addition By SnehalV for WhizibleSEM SP8 integration on 2nd Nov 2006
                '3. Code for String Builder Changes - IssueID - 6052 
                'strEmailMessage = Replace(strEmailMessage, "<SENDER_NAME>", strUserName)
                strMessage.Replace("<SENDER_NAME>", strUserName)
                'end of addition by SnehalV

                strQuery = "usp_Sel_tbl_PM_Role " & HttpContext.Current.Session("intPostID").ToString()
                drTempWork = CommonFunctions.Data.GetDataReader(strQuery, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                If CommonFunctions.General.CheckIsNothing(drTempWork) <> "" Then
                    If drTempWork.Read() Then
                        'Addition By SnehalV for WhizibleSEM SP8 integration on 2nd Nov 2006
                        '3. Code for String Builder Changes - IssueID - 6052 
                        'strEmailMessage = Replace(strEmailMessage, "<DESIGNATION>", CommonFunctions.General.UnBuildQueryString(drTempWork.Item("RoleDescription").ToString().Trim()))
                        strMessage.Replace("<DESIGNATION>", CommonFunctions.General.UnBuildQueryString(drTempWork.Item("RoleDescription").ToString().Trim()))
                        'end of addition by SnehalV
                    End If
                End If
                CommonFunctions.Data.DisposeDataReader(drTempWork)

                ' Retrieve information about the experience gained by the employees in the various tools used in the project.
                strQuery = "Exec usp_Sel_tbl_PM_EmployeeSkillMatrix_Detail " & HttpContext.Current.Session("intProjectID").ToString()
                drTempWork = CommonFunctions.Data.GetDataReader(strQuery, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                If CommonFunctions.General.CheckIsNothing(drTempWork) <> "" Then
                    While drTempWork.Read()
                        intEmployeeYears = CType("0" & CommonFunctions.Data.CheckIsDBNull(drTempWork.Item("YearsOfExperience")).ToString(), Integer)
                        intEmployeeMonths = CType("0" & CommonFunctions.Data.CheckIsDBNull(drTempWork.Item("MonthsOfExperience")).ToString(), Integer)
                        strUserName = drTempWork.Item("UserName").ToString().Trim()
                        strUserName = CommonFunctions.General.UnBuildQueryString(strUserName)
                        strDescription = drTempWork.Item("Description").ToString().Trim()
                        strDescription = CommonFunctions.General.UnBuildQueryString(strDescription)

                        ' Display the employee name.
                        If strEmployeeName <> strUserName Then
                            strEmployeeExperience = strEmployeeExperience & strUserName & vbCrLf
                            strEmployeeName = strUserName
                        End If
                    End While
                End If
                CommonFunctions.Data.DisposeDataReader(drTempWork)

                ' Insert the formatted experience in the mail body.

                'Addition By SnehalV for WhizibleSEM SP8 integration on 2nd Nov 2006
                '3. Code for String Builder Changes - IssueID - 6052 
                'strEmailMessage = Replace(strEmailMessage, "<EXPERIENCE>", strEmployeeExperience)
                strMessage.Replace("<EXPERIENCE>", strEmployeeExperience)
                'end of addition by SnehalV


                ' Get the list of employees to whom the mail must be sent.
                strTempArray = Split(strListOfEmployeeIDs, ",")

                For intCtr = LBound(strTempArray) To UBound(strTempArray)
                    If Trim(strTempArray(intCtr) & "") <> "" Then
                        strQuery = "usp_tbl_Sel_EmployeeInfo " & strTempArray(intCtr)
                        drTempWork = CommonFunctions.Data.GetDataReader(strQuery, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                        If CommonFunctions.General.CheckIsNothing(drTempWork) <> "" Then
                            If drTempWork.Read() Then
                                strEmailId = CommonFunctions.General.UnBuildQueryString(drTempWork.Item("EmailID").ToString().Trim())
                                strListOfEmployeeNames &= CommonFunctions.General.UnBuildQueryString(drTempWork.Item("UserName").ToString().Trim()) & ", "
                                If strEmailId <> "" Then
                                    strListOfEmailIDs &= strEmailId & "; "
                                End If
                            End If
                        End If
                        CommonFunctions.Data.DisposeDataReader(drTempWork)
                    End If
                Next

                'Commented by TruptiK on 6-Oct-2007

                'If Right(strListOfEmployeeNames, 2) = ", " Then

                ' strListOfEmployeeNames = Left(strListOfEmployeeNames, Len(strListOfEmployeeNames) - 2)

                'End If

                'If Trim(strListOfEmployeeNames) = "" Then

                strListOfEmployeeNames = "All"

                'End If

                'End of commented by TruptiK


                strToEmailID = strListOfEmailIDs
                'Added by TruptiK on 9-Sep-2007
                'Purpose:-To add IDS of Resources configure in configuration.
                'strToEmailID = CommonFunction.General.CheckIsNothing(CType(CommonFunctions.Data.GetDataScalar("EXEC usp_Sel_PM_ToMailList_ProjectClosure " + HttpContext.Current.Session("intProjectID").ToString(), True), String), "")
                strToEmailID = CommonFunction.General.CheckIsNothing(CType(CommonFunctions.Data.GetDataScalar("EXEC usp_Sel_PM_ToMailList_ProjectClosure " + HttpContext.Current.Session("intProjectID").ToString() + ", 470", True), String), "")
                strCCToEmailID = CommonFunction.General.CheckIsNothing(CType(CommonFunctions.Data.GetDataScalar("EXEC usp_Sel_PM_CCMailList_ProjectClosure " + HttpContext.Current.Session("intProjectID").ToString(), True), String), "")
                strReopenComment = CommonFunction.General.CheckIsNothing(CType(CommonFunctions.Data.GetDataScalar("EXEC usp_Sel_tbl_PM_ProjectClosureComments " + HttpContext.Current.Session("intProjectID").ToString(), True), String), "")

                'Addition By SnehalV for WhizibleSEM SP8 integration on 2nd Nov 2006
                '3. Code for String Builder Changes - IssueID - 6052 
                'strEmailMessage = Replace(strEmailMessage, "<REOPEN_COMMENT>", strReopenComment)
                'strEmailMessage = Replace(strEmailMessage, "<NAME>", strListOfEmployeeNames)
                strMessage.Replace("<REOPEN_COMMENT>", strReopenComment)
                strMessage.Replace("<NAME>", strListOfEmployeeNames)
                'end of addition by SnehalV

                'Addition By SnehalV for WhizibleSEM SP8 integration on 2nd Nov 2006
                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
                'end of addition by SnehalV
            End Sub

            Public Shared Sub GetEmailMessage_20(ByRef strFromEmailID As String, ByRef strToEmailID As String,
                    ByRef strCCToEmailID As String, ByRef strSubject As String,
                    ByRef strEmailMessage As String, ByVal strTaskIDs As String, Optional ByVal strProjectID As String = "")
                '=====================================================================
                ' Procedure Name		:	GetEmailMessage_20 (NEW TASK ASSIGNMENT)
                ' Parameters Passed     :	strToEmailID		:- The EmailID of the person to whom the message will be returned.
                '							strSubject		:- The Subject of the Email Message.
                '							strEmailMessage	:- The body of the Email Message.
                '							lngTaskID		:- The ID of the new task assigned to the employee.
                ' Returns               :	
                ' Parameters Affected   :	strToEmailID, strSubject, strEmailMessage :- These values are returned by the subroutine by reference.
                ' Description           :	Generate the email message as defined in the System Email Messages table in the database.
                ' Purpose               :	Generate the email message as defined in the System Email Messages table in the database.
                ' Assumptions           :	The message ID exists in the database.
                '							The message does not contain any other parameters besides the following :
                '								1.	<NAME>
                '								2.	<SENDER_NAME>
                '								3.	<PROJECT_NAME> 
                '								4.	<TASK_NAME>
                ' Dependencies          :	None.
                ' Author                :	RajaniR
                ' Created               :	6th September 2001
                ' Revisions             :
                '=====================================================================	

                Dim strEmailID, strUserName, strProjectName As String
                Dim strTaskIDList, strEmailAddress, strUserNames, strTaskName As String
                Dim strTaskIDArray() As String
                Dim intCtr As Integer
                Dim lngMessageID As Long
                Dim lngEmpId As Long

                Dim drTask As IDataReader

                '1. Code for String Builder Changes - IssueID - 6052 

                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                lngMessageID = 20

                ' Get the message body, and subject.
                strEmailMessage = funcGetEmailMessageForProject(CType(HttpContext.Current.Session("intProjectID"), Long), lngMessageID, strSubject)

                '2. Code for String Builder Changes - IssueID - 6052 

                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                ' Retrieve information about the Project.
                'modified By VivekP on 3 jun 2005
                If strProjectID = "" Then
                    Call GetProjectInfo(CType(HttpContext.Current.Session("intProjectID"), Long), strProjectName, lngMessageID, strCCToEmailID)
                Else
                    Call GetProjectInfo(CType(strProjectID, Long), strProjectName, lngMessageID, strCCToEmailID)
                End If
                'End Of modification On 3 Jun 2005
                strMessage.Replace("<PROJECT_NAME>", strProjectName)
                strEmailSubject.Replace("<PROJECT_NAME>", strProjectName)

                ' Retrieve information about the Sender.
                Call GetSenderInfo(strUserName, strFromEmailID)
                strMessage.Replace("<SENDER_NAME>", strUserName)

                ' If the Task ID is not specified, then exit the subroutine.
                If Trim(strTaskIDs) = "" Then
                    Exit Sub
                End If

                strTaskIDList = strTaskIDs

                strTaskIDArray = Split(strTaskIDList, ",")

                ' For Each Task in the TaskID list, ...
                For intCtr = LBound(strTaskIDArray) To UBound(strTaskIDArray)

                    If Trim(strTaskIDArray(intCtr)) <> "" Then

                        ' Retrieve the task details.
                        drTask = CommonFunctions.Data.GetDataReader("usp_Sel_tbl_PM_ProjectTasks " & CType(HttpContext.Current.Session("intProjectID"), Long) & "," & strTaskIDArray(intCtr), CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                        If CommonFunctions.General.CheckIsNothing(drTask) <> "" Then
                            If drTask.Read() Then
                                ' Retrieve the Task Name.					
                                strTaskName = drTask.Item("TaskName").ToString().Trim()

                                ' Retrieve information about the employee to whom the task has been assigned.
                                lngEmpId = CType(CommonFunctions.Data.CheckIsDBNull(drTask.Item("EmployeeID"), "0"), Long)
                                Call GetEmployeeInfo(lngEmpId, strUserName, strEmailID)

                                '' ***************************************************************************/
                                '' Integrated On 10-Feb-2006 By ParagD for Whiz 2    

                                '' Commented & modified By ParagD On 11-Jan-2006
                                '' Purpose : DSS - 289 => 
                                '' When multiple tasks is assigned to the same resource ,
                                '' his(emailid And username gets repeated in mail contents.    

                                ''If Trim(strEmailID) <> "" Then
                                ''    strEmailAddress = strEmailAddress & strEmailID & "; "
                                ''End If
                                ''strUserNames = strUserNames & strUserName & ", "

                                If Trim(strEmailID) <> "" Then
                                    If InStr("," + strEmailAddress + ",", "," + strEmailID + ",") = 0 Then
                                        strEmailAddress &= strEmailID & ","
                                    End If
                                End If
                                If InStr("," + strUserNames + ",", "," + strUserName + ",") = 0 Then
                                    strUserNames &= strUserName & ","
                                End If
                                '' END : Added By ParagD On 11-Jan-2006  

                                '' Integrated On 10-Feb-2006 By ParagD for Whiz 2
                                '' ***************************************************************************/


                            End If
                        End If
                        CommonFunctions.Data.DisposeDataReader(drTask)
                    End If

                Next

                ' Added By RajaniR on 26th March 2002.
                ' Remove the last comma in the message.
                If Trim(strUserNames) <> "" Then
                    strUserNames = Left(strUserNames, InStrRev(strUserNames, ",") - 1)
                End If

                ' Remove the last comma in the message.
                If Trim(strEmailAddress) <> "" Then

                    '' ***************************************************************************/
                    '' Integrated On 10-Feb-2006 By ParagD for Whiz 2   

                    '' Commented & modified By ParagD On 11-Jan-2006
                    '' strEmailAddress = Left(strEmailAddress, InStrRev(strEmailAddress, ";") - 1)
                    '' Purpose : DSS - 289
                    '' replaces ";" with ","
                    strEmailAddress = Left(strEmailAddress, InStrRev(strEmailAddress, ",") - 1)
                    '' END : Added By ParagD On 11-Jan-2006

                    '' Integrated On 10-Feb-2006 By ParagD for Whiz 2
                    '' ***************************************************************************/
                End If
                ' End Addition.

                strToEmailID = strEmailAddress
                strMessage.Replace("<NAME>", strUserNames)
                strMessage.Replace("<TASK_NAME>", strTaskName)


                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
            End Sub


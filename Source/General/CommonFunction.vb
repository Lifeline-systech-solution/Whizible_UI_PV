                dr = CommonFunctions.Data.GetDataReader("usp_sel_tbl_PM_EmailMessages 1002", True)
                If dr.Read Then
                    strSubject = dr("Subject").ToString
                    strEmailMessage = dr("Body").ToString & ""
                End If

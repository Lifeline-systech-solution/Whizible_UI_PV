                ' Parameters Affected   :	strFromEmailID, strToEmailID, strCCToEmailID, strSubject, strEmailMessage :- These values are returned by the subroutine by reference.
                ' Description           :	Generate the email message as defined in the System Email Messages table in the database.
                ' Purpose               :	Generate the email message as defined in the System Email Messages table in the database.
                ' Assumptions           :	The message ID exists in the database.
                '							The message does not contain any other parameters besides the following :
                '								1.	<NAME>
                '								2.	<SENDER_NAME>
                '								3.	<TITLE> 
                '								7.	<PROJECT_NAME>
                ' Dependencies          :	None.
                ' Author                :	SachinR
                ' Created               :	24 Aug 2004
                ' Revisions             :
                '=====================================================================						

                Dim intMessageID As Integer = 471
                Dim strScheduleID As String = Str(intScheduleID)
                Dim strRequestedBy, strProjectName As String, strResponsiblePerson As String
                Dim strResponsiblePersonName As String
                Dim intProjectID As Integer
                Dim drDeliverable As IDataReader
                Dim strStartDate As String = "", strEarliestCompletionDate As String
                Dim strTitle As String
                Dim strEstimatedEfforts As String
                Dim strRequestedByEmailID As String

                ' If the Issue ID is not specified, then exit the subroutine.
                If intScheduleID = 0 Then
                    Exit Sub
                End If
                intProjectID = CType(HttpContext.Current.Session("intProjectID"), Integer)

                ' Get Issue Type details assigned for this Deliverable
                drDeliverable = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_PM_ProjectDeliverables " + intProjectID.ToString + ", " + strScheduleID, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                If drDeliverable.Read Then
                    strTitle = drDeliverable("Title").ToString.Trim
                    strRequestedBy = drDeliverable("RequestedBy").ToString.Trim
                    strRequestedByEmailID = drDeliverable("RequestedByEmailID").ToString.Trim
                    strResponsiblePerson = drDeliverable("ResponsiblePerson").ToString.Trim
                    strStartDate = drDeliverable("StartDate").ToString.Trim
                    strEarliestCompletionDate = drDeliverable("EarliestStartDate").ToString.Trim
                    strEstimatedEfforts = drDeliverable("EstimatedEffortsInDays").ToString.Trim
                    strResponsiblePersonName = drDeliverable("ResponsiblePersonName").ToString.Trim
                End If
                CommonFunction.Data.DisposeDataReader(drDeliverable)

                If intProjectID = 0 Then
                    Exit Sub
                End If
                ' Get the message body, and subject.
                strEmailMessage = funcGetEmailMessageForProject(intProjectID, intMessageID, strSubject)

                ' Retrieve information about the Sender.
                Call GetSenderInfo(strRequestedBy, strFromEmailID)
                strEmailMessage = Replace(strEmailMessage, "<SENDER_NAME>", strRequestedBy)

                ' Retrieve information about the Project.
                Call GetProjectInfo(intProjectID, strProjectName, intMessageID, strCCToEmailID)

                If (strCCToEmailID <> "") And (strRequestedByEmailID <> "") Then
                    strCCToEmailID = strCCToEmailID + ";" + strRequestedByEmailID + ";"
                ElseIf (strCCToEmailID = "") And (strRequestedByEmailID <> "") Then
                    strCCToEmailID = strCCToEmailID + strRequestedByEmailID + ";"
                End If

                strEmailMessage = Replace(strEmailMessage, "<PROJECT_NAME>", strProjectName)

                strSubject = Replace(strSubject, "<PROJECT_NAME>", strProjectName)

                ' Insert the deliverable title.
                strEmailMessage = Replace(strEmailMessage, "<TITLE>", strTitle.Trim)
                strEmailMessage = Replace(strEmailMessage, "<START_DATE>", strStartDate)
                strEmailMessage = Replace(strEmailMessage, "<END_DATE>", strEarliestCompletionDate)
                strEmailMessage = Replace(strEmailMessage, "<EFFORTS>", strEstimatedEfforts)
                strEmailMessage = Replace(strEmailMessage, "<RESPONSIBLE_PERSON>", strResponsiblePersonName)

                strSubject = Replace(strSubject, "<TITLE>", strTitle.Trim)

                'Comment and modification by SuchitraP on 8-Jan-2009 for issueID:26403
                'Purpose:In the Mail , if the Responsible person is not set , only a semicolon is seen in To list
                'strToEmailID = strToEmailID + strResponsiblePerson + ";"
                If strResponsiblePerson <> "" Then
                    strToEmailID = strToEmailID + strResponsiblePerson + ";"
                Else
                    strToEmailID = strToEmailID + strResponsiblePerson
                End If
                'End of Comment and modification by SuchitraP on 8-Jan-2009

            End Sub

                        strEmailMessage = strEmailMessage.Replace("<TITLE>", drPlaceHolders("Title").ToString)
                        strEmailMessage = strEmailMessage.Replace("<COMMENTS>", strCRMComments)
                        strSubject = strSubject.Replace("<CRM REQUEST NAME>", drPlaceHolders("Subject").ToString)
                    End If
                End If
                'End by SuchitraP

                strMessage.Append(funcReplacePlaceHolders(intMessageID, intPKvalue, strEmailMessage))
                strEmailSubject.Append(funcReplacePlaceHolders(intMessageID, intPKvalue, strSubject))

                drApprover = CommonFunction.Data.GetDataReader("usp_Sel_EntityWorkFlowTOCCEmailList " + WorkFlowPrimaryKey, blnUseSQL)

                'Added by DarshanK on 24-Jul-2008
                Dim strS As String = "usp_Sel_tbl_IM_WorkflowInstance_ProjectID " + WorkFlowPrimaryKey
                Dim strValue As String = CommonFunction.General.CheckIsNothing(CommonFunction.Data.CheckIsDBNull(CommonFunction.Data.GetDataScalar(strS, CType(CommonFunctions.General.GetApplicationKeySetting("UseSQL"), Boolean)), ""), "")
                'End of Addition done by DarshanK

                While drApprover.Read
                    strToEmailID = strToEmailID + CommonFunction.General.CheckIsNothing(CommonFunction.Data.CheckIsDBNull(drApprover("ToEmailIDList"), ""), "").ToString + ";"
                    strCCToEmailID = strCCToEmailID + CommonFunction.General.CheckIsNothing(CommonFunction.Data.CheckIsDBNull(drApprover("CcEmailIDList"), ""), "").ToString + ";"

                    'Added by DarshanK on 24-Jul-2008
                    Dim arrToIDs() As String

                    If strToEmailID.Contains(",") Then
                        arrToIDs = strToEmailID.TrimEnd(",").TrimEnd(";").Split(",")
                    ElseIf strToEmailID.Contains(";") Then
                        arrToIDs = strToEmailID.TrimEnd(",").TrimEnd(";").Split(";")
                    End If

                    Dim intCount As Integer = 0
                    For intCount = 0 To arrToIDs.Length - 1
                        If arrToIDs(intCount) <> "" Then
                            'send the mail
                            If intMessageID = 1 Then
                                If arrToIDs(intCount).Contains(";") Then
                                    Dim arrTOIDsplitted() As String = arrToIDs(intCount).TrimEnd(",").TrimEnd(";").Split(";")
                                    For j As Integer = 0 To arrTOIDsplitted.Length
                                        m_strGUIDList.Append(CommonFunction.EmailMessages.EmailApprover.funGenerateGUID(arrTOIDsplitted(j), CInt(strValue), "Project") + ",")
                                    Next
                                Else
                                    m_strGUIDList.Append(CommonFunction.EmailMessages.EmailApprover.funGenerateGUID(arrToIDs(intCount), CInt(strValue), "Project") + ",")
                                End If
                            End If
                        End If
                    Next
                    'End of Addition done by DarshanK
                End While
                If strCCToEmailID = ";" Then
                    strCCToEmailID = strCCToEmailID.Replace(";", "")
                End If


                drApprover.Close()

                CommonFunction.Data.DisposeDataReader(drApprover)

                'strMessage.Replace("<NAME>", strMailToNames)

                '' GetProjectInfo(intProjectID, strProjectName, 51, strCCToEmailID)
                GetSenderInfo(strEmployeeNames, strFromEmailID)

                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString

                'Added by DArshanK on 11-Aug-2008
                strEmailMessage = strEmailMessage '+ " GUIDList -" + m_strGUIDList.ToString
                m_strGUIDList = Nothing
                'End of Addition by DarshanK on 11 Aug 2008

                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing

            End Sub

        End Class


        Public Shared Function GetRefreshParentParentScript(ByVal parentFormName As String, ByVal parentPage As String, ByVal submitToPage As String, Optional ByVal closeChildWindow As Boolean = False, Optional ByVal IsScriptTagRequired As Boolean = True) As String
            '=====================================================================
            ' Procedure Name        : GetRefreshParentScript

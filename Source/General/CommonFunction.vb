        Public Overloads Shared Function GetDataSet(ByVal SQL As String, ByVal TableName As String, ByRef TotalRows As Integer, Optional ByVal CurrentIndex As Integer = 0, Optional ByVal PageSize As Integer = 0, Optional ByVal UseSQL As Boolean = True, Optional ByVal ConnectionString As String = "") As DataSet
            '=====================================================================
            ' Function Name	    	:	GetSQLDataSet
            ' Parameters Passed		:	SQL - SQL Query
            '                       :   TableName - Dataset Identifier
            '                           TotalRows - Total No. of rows in datset (ByRef)
            '                       :   CurrentIndex - Dataset Currnent Index
            '                       :   PageSize - Dataset PageSize
            ' Returns				:	A dataset object
            ' Parameters Affected	:	None
            ' Purpose				:	To get the dataset object for paging
            ' Description			:	
            ' Assumptions			:	None
            ' Dependencies			:	None
            ' Author				:	Amol Changle
            ' Created				:   14 Apr 2009
            ' Revisions				:	
            '=====================================================================
            Dim dtFunctionStartTime As Date = Now()
            Dim strTraceDetails As New StringBuilder
            Dim dtSQLStartTime As Date
            Dim tsSQL As System.TimeSpan
            Dim tsFunction As System.TimeSpan
            Dim strAppTracing As String
            Dim strTraceFileName As String = CommonFunctions.FileDirectory.GetLogFileName("CommonFunctions_Data")
            strAppTracing = Trim(CommonFunctions.General.GetApplicationKeySetting("AppTracing")).ToUpper

            Dim strConnectionString As String = ConnectionString
            If strConnectionString = "" Then strConnectionString = CommonFunctions.General.GetConnectionString.ToString

            'Data set object
            Dim dsResult As DataSet = New DataSet

            If UseSQL Then

                'Data adapter object
                Dim conDB As New SqlClient.SqlConnection
                conDB = Connection.GetSQLConnection(strConnectionString)
                Dim cmdSQL As New SqlClient.SqlCommand
                cmdSQL.CommandText = SQL
                cmdSQL.CommandTimeout = 20000
                cmdSQL.Connection = conDB
                'Data adapter object
                Dim daResult As SqlDataAdapter = New SqlDataAdapter(cmdSQL)

                Try
                    If strAppTracing = "ON" Then dtSQLStartTime = Now()

                    daResult.Fill(dsResult, TableName)

                    TotalRows = dsResult.Tables(0).Rows.Count

                    dsResult.Clear()

                    'if paging is not equal to zero then only apply the paging 
                    If PageSize <> 0 Then
                        daResult.Fill(dsResult, CurrentIndex, IIf(TotalRows - CurrentIndex < PageSize, TotalRows - CurrentIndex, PageSize), TableName) '-1
                    Else
                        daResult.Fill(dsResult, TableName)
                    End If

                    'Return the dataset object
                    GetDataSet = dsResult

                    If strAppTracing = "ON" Then
                        tsSQL = Now.Subtract(dtSQLStartTime)
                        strTraceDetails.Append("INFO" & vbTab & Now.ToString & vbTab & "Time(ms) taken for SQL Query execution :" & tsSQL.TotalMilliseconds.ToString & vbNewLine)
                    End If

                    'Dispose the objects
                    dsResult.Dispose()
                    daResult.Dispose()
                    cmdSQL.Dispose()
                    conDB.Close()
                    conDB.Dispose()
                Catch ex As Exception
                    If Not dsResult Is Nothing Then dsResult.Dispose()
                    If Not daResult Is Nothing Then daResult.Dispose()
                    If strAppTracing = "ON" Then strTraceDetails.Append("ERR" & vbTab & Now.ToString & vbTab & "Err.Number :" & Err.Number.ToString & vbTab & "CommonFunctions->Data->GetDataSet" & vbTab & ex.Message & vbNewLine)
                    Err.Raise(Err.Number, "CommonFunctions->Data->GetDataSet", ex.Message)
                Finally
                    If strAppTracing = "ON" Then
                        tsFunction = Now.Subtract(dtFunctionStartTime)
                        strTraceDetails.Append("INFO" & vbTab & Now.ToString & vbTab & "Time(ms) taken for function execution :" & tsFunction.TotalMilliseconds.ToString & vbNewLine)
                        strTraceDetails.Append("------------------------------------------------------------")
                        Call Tracer.WriteTrace(strTraceFileName, "CommonFunction", strTraceDetails.ToString)
                    End If
                End Try
            Else
                'Data adapter object
                Dim conOLEdb As New OleDb.OleDbConnection
                conOLEdb = Connection.GetOleDBConnection(strConnectionString)
                Dim cmdOleDB As New OleDb.OleDbCommand
                cmdOleDB.CommandText = SQL
                cmdOleDB.CommandTimeout = 20000
                cmdOleDB.Connection = conOLEdb

                'Data adapter object
                Dim daResult As OleDbDataAdapter = New OleDbDataAdapter(cmdOleDB)


                Try
                    If strAppTracing = "ON" Then dtSQLStartTime = Now()

                    daResult.Fill(dsResult, TableName)
                    TotalRows = dsResult.Tables(0).Rows.Count
                    dsResult.Clear()

                    'if paging is not equal to zero then only apply the paging 
                    If PageSize <> 0 Then
                        daResult.Fill(dsResult, CurrentIndex, IIf(TotalRows - CurrentIndex - 1 < PageSize, TotalRows - CurrentIndex - 1, PageSize), TableName)
                    Else
                        daResult.Fill(dsResult, TableName)
                    End If

                    If strAppTracing = "ON" Then
                        tsSQL = Now.Subtract(dtSQLStartTime)
                        strTraceDetails.Append("INFO" & vbTab & Now.ToString & vbTab & "Time(ms) taken for SQL Query execution :" & tsSQL.TotalMilliseconds.ToString & vbNewLine)
                    End If

                    'Return the dataset object
                    GetDataSet = (dsResult)
                    'Dispose the objects
                    dsResult.Dispose()
                    daResult.Dispose()
                    cmdOleDB.Dispose()
                    conOLEdb.Close()
                    conOLEdb.Dispose()

                Catch ex As Exception
                    If Not dsResult Is Nothing Then dsResult.Dispose()
                    If Not daResult Is Nothing Then daResult.Dispose()
                    If strAppTracing = "ON" Then strTraceDetails.Append("ERR" & vbTab & Now.ToString & vbTab & "Err.Number :" & Err.Number.ToString & vbTab & "CommonFunctions->Data->GetDataSet" & vbTab & ex.Message & vbNewLine)
                    Err.Raise(Err.Number, "CommonFunctions->Data->GetDataSet", ex.Message)
                Finally
                    If strAppTracing = "ON" Then
                        tsFunction = Now.Subtract(dtFunctionStartTime)
                        strTraceDetails.Append("INFO" & vbTab & Now.ToString & vbTab & "Time(ms) taken for function execution :" & tsFunction.TotalMilliseconds.ToString & vbNewLine)
                        strTraceDetails.Append("------------------------------------------------------------")
                        Call Tracer.WriteTrace(strTraceFileName, "CommonFunction", strTraceDetails.ToString)
                    End If
                End Try
            End If
            strTraceDetails = Nothing
        End Function

    End Class


                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                drInvoice = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_RFIInvoices " + intInvoiceID.ToString, blnUseSQL)
                If drInvoice.Read Then
                    intRFIID = CType(Trim(CommonFunction.Data.CheckIsDBNull(drInvoice("RFIID"), "0").ToString & ""), Integer)
                    intProjectID = CType(CommonFunction.Data.CheckIsDBNull(drInvoice("ProjectID"), "0"), Integer)
                    strConfirmEmailID = CType(CommonFunction.Data.CheckIsDBNull(drInvoice("ConfirmEmailID"), ""), String)
                    intCustomerID = CType(CommonFunction.Data.CheckIsDBNull(drInvoice("CustomerID"), "0"), Integer)
                    strInvoiceNumber = CommonFunction.Data.CheckIsDBNull(drInvoice("InvoiceNumber"), "").ToString
                    'Added by ShraddhaM to display Contact Person Name in email message.
                    strContactPerson = CType(CommonFunction.Data.CheckIsDBNull(drInvoice("ContactPerson"), ""), String)
                    'Ended by ShraddhaM
                End If
                drInvoice.Close()
                CommonFunction.Data.DisposeDataReader(drInvoice)

                'Get the RFI Raised By Field
                Dim drRFI As IDataReader
                drRFI = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_RFIs " + intRFIID.ToString, blnUseSQL)
                If drRFI.Read Then
                    strRFIRaisedBy = CommonFunction.Data.CheckIsDBNull(drRFI("RFIRaisedBy"), "").ToString
                End If
                drRFI.Close()
                CommonFunction.Data.DisposeDataReader(drRFI)


                ' If the "Email Confirm" is specified, the mail must be sent to that person as well.
                If strConfirmEmailID <> "" Then
                    strToEmailID = strConfirmEmailID & ";"
                End If

                strMessage.Replace("<INVOICE_NUMBER>", strInvoiceNumber)

                drProject = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_Project " + intProjectID.ToString, blnUseSQL)
                If drProject.Read Then
                    strEmailSubject.Replace("<PROJECT_NAME>", CommonFunction.Data.CheckIsDBNull(drProject("ProjectName"), "").ToString)
                    strMessage.Replace("<PROJECT_NAME>", CommonFunction.Data.CheckIsDBNull(drProject("ProjectName"), "").ToString)
                    intCompanyID = CType(CommonFunction.Data.CheckIsDBNull(drProject("CompanyID"), "0"), Integer)
                End If
                drProject.Close()
                CommonFunction.Data.DisposeDataReader(drProject)

                strMessage.Replace("<SENDER_NAME>", HttpContext.Current.Session("strUserName").ToString)

                strEmailSubject.Replace("<RFI_ID>", intRFIID.ToString)
                strEmailSubject.Replace("<INVOICE_ID>", intInvoiceID.ToString)

                strMessage.Replace("<RFI_ID>", intRFIID.ToString)
                strMessage.Replace("<INVOICE_ID>", intInvoiceID.ToString)


                If strRFIRaisedBy <> "" Then

                    ' Commented and modified By MahendraV On 11:49 AM 9/7/2007 For WhizibleSEM 7.1
                    ' To get only Active employee emailID
                    ' Start_MV_9/7/2007
                    ' drRaisedBy = CommonFunction.Data.GetDataReader("SELECT * FROM tbl_PM_Employee WHERE UserName = '" + strRFIRaisedBy + "'", blnUseSQL)
                    'Added by SonalD on 25th March 2009
                    strRFIRaisedBy = Replace(strRFIRaisedBy, "'", "''")
                    'End of addition by SonalD 
                    drRaisedBy = CommonFunction.Data.GetDataReader("SELECT * FROM tbl_PM_Employee WITH (NOLOCK) WHERE UserName = '" + strRFIRaisedBy + "' AND ISNULL(Status,0) = 0 ", blnUseSQL)
                    ' End_MV_9/7/2007

                    If drRaisedBy.Read Then
                        If InStr(1, strCCToEmailID, Trim(CType(CommonFunction.Data.CheckIsDBNull(drRaisedBy("EmailID"), ""), String) & ""), CompareMethod.Text) = 0 Then
                            strCCToEmailID = Trim(CType(CommonFunction.Data.CheckIsDBNull(drRaisedBy("EmailID"), ""), String) & "")
                        End If
                    End If
                    drRaisedBy.Close()
                    CommonFunction.Data.DisposeDataReader(drRaisedBy)
                End If

                ' Get the email id of the Invoice Repository of the Legal Entity (Company).
                Dim drCompany As IDataReader
                drCompany = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_PM_CompanyMaster_RFI " & intCompanyID, blnUseSQL)
                If drCompany.Read Then
                    If strCCToEmailID <> "" Then
                        strCCToEmailID = strCCToEmailID & ";"
                    End If
                    If CType(CommonFunction.Data.CheckIsDBNull(drCompany("InvoiceRepositoryEmailID"), ""), String) <> "" Then
                        strCCToEmailID = strCCToEmailID & Trim(CType(CommonFunction.Data.CheckIsDBNull(drCompany("InvoiceRepositoryEmailID"), ""), String) & "") & "; "
                    End If

                End If
                CommonFunction.Data.DisposeDataReader(drCompany)

                ' Get the customer name and Customer Email ID.
                Dim drCustomer As IDataReader
                drCustomer = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_Customer " & intCustomerID & ",NULL,'C'", blnUseSQL)
                If drCustomer.Read Then
                    strMessage.Replace("<NAME>", Trim(CType(CommonFunction.Data.CheckIsDBNull(drCustomer("CustomerID"), ""), String) & "," & strContactPerson & ""))
                    strToEmailID = strToEmailID & Trim(CType(CommonFunction.Data.CheckIsDBNull(drCustomer("EmailID"), ""), String) & "")
                End If
                CommonFunction.Data.DisposeDataReader(drCustomer)

                ' Get the comments entered by the Accounts person. 
                Dim drComments As IDataReader
                Dim strComments As String
                drComments = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_PM_RFI_StatusHistory " & intRFIID, blnUseSQL)
                If drComments.Read Then
                    strComments = Trim(CType(CommonFunction.Data.CheckIsDBNull(drComments("Comments"), ""), String) & "")
                    strMessage.Replace("<COMMENTS>", strComments)
                End If
                CommonFunction.Data.DisposeDataReader(drComments)

                GetProjectInfo(intProjectID, strProjectName, 56, strCCToEmailID)
                GetSenderInfo(strEmployeeNames, strFromEmailID)
                'Added By nIkitaD on 12-Jan-2015
                If strCCToEmailID.Chars(strCCToEmailID.Trim.Length - 1) = ";" Or strCCToEmailID.Chars(strCCToEmailID.Trim.Length - 1) = "," Then
                    strCCToEmailID = strCCToEmailID.Substring(strCCToEmailID.Length - 1)

                End If
                'end Added By nIkitaD on 12-Jan-2015
                strInvNum = strInvoiceNumber

                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
            End Sub

            Public Shared Sub GetEmailMessage_57(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal strInvoiceIDs As String, ByVal lngCustomerID As Long, ByVal lngCompanyID As Long, ByRef strInvNum() As String)
                '=====================================================================
                ' Procedure Name		:	GetEmailMessage_57 (INVOICE GENERATED)
                ' Parameters Passed     :	strFromEmailID	:- The EmailID of the person sending the mail.
                '							strToEmailID	:- The EmailID of the person to whom the message will be sent.
                '							strCCToEmailID	:- The EmailID of the person to whom the CC of the message will be sent.
                '							strSubject		:- The Subject of the Email Message.
                '							strEmailMessage	:- The Body of the Email Message.
                '							intCustomerID	:- The Customer ID.
                '							strInvoiceIDList:- The comma separated list of Invoice IDs.
                ' Returns               :	No return values.
                ' Parameters Affected   :	strFromEmailID, strToEmailID, strCCToEmailID, strSubject, strEmailMessage,strInvoiceNumbers :- These values are returned by the subroutine by reference.
                ' Description           :	Generate the email message as defined in the System Email Messages table in the database.
                ' Purpose               :	Generate the email message as defined in the System Email Messages table in the database.
                ' Assumptions           :	The message ID exists in the database.
                '							The message does not contain any other parameters besides the following :
                '								1.	<NAME>
                '								2.	<SENDER_NAME>
                '								3.	<DETAILS> 	
                ' Dependencies          :	None.
                ' Author                :	DipaliS
                ' Created               :	August 25,2004
                ' Revisions             :
                '=====================================================================		
                Dim blnUseSQL As Boolean = CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean)
                Dim intMessageID As Integer = 0
                Dim drEmailMessage As IDataReader
                Dim drInvoice As IDataReader

                Dim strEmployeeNames As String
                Dim strInvoiceNumber As String

                '1. Code for String Builder Changes - IssueID - 6052 
                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                intMessageID = 57

                ' Get the message body, and subject.
                drEmailMessage = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_EmailMessages " + intMessageID.ToString, blnUseSQL)
                If drEmailMessage.Read Then
                    strEmailMessage = CommonFunction.Data.CheckIsDBNull(drEmailMessage("Body")).ToString
                    strSubject = CommonFunction.Data.CheckIsDBNull(drEmailMessage("Subject")).ToString
                End If
                drEmailMessage.Close()
                CommonFunction.Data.DisposeDataReader(drEmailMessage)

                '2. Code for String Builder Changes - IssueID - 6052 
                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                GetSenderInfo(strEmployeeNames, strFromEmailID)

                strCCToEmailID = strFromEmailID
                strMessage.Replace("<SENDER_NAME>", strEmployeeNames)

                ' Get the customer name and Customer Email ID.
                Dim drCustomer As IDataReader
                drCustomer = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_Customer " & lngCustomerID, blnUseSQL)
                If drCustomer.Read Then
                    strMessage.Replace("<NAME>", Trim(CType(CommonFunction.Data.CheckIsDBNull(drCustomer("CustomerID")), String) & ""))
                    strToEmailID = strToEmailID & Trim(CType(CommonFunction.Data.CheckIsDBNull(drCustomer("EmailID")), String) & "")
                End If
                CommonFunction.Data.DisposeDataReader(drCustomer)

                ' Get the email id of the Invoice Repository of the Legal Entity (Company).
                Dim drCompany As IDataReader
                drCompany = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_PM_CompanyMaster_RFI " & lngCompanyID, blnUseSQL)
                If drCompany.Read Then
                    If strCCToEmailID <> "" Then
                        strCCToEmailID = strCCToEmailID & ";"
                    End If
                    If CType(CommonFunction.Data.CheckIsDBNull(drCompany("InvoiceRepositoryEmailID"), ""), String) <> "" Then
                        strCCToEmailID = strCCToEmailID & Trim(CType(CommonFunction.Data.CheckIsDBNull(drCompany("InvoiceRepositoryEmailID"), ""), String) & "") & ";"
                    End If

                End If
                CommonFunction.Data.DisposeDataReader(drCompany)

                Dim arrInvoiceIDs() As String
                Dim m_strSeperator As String = ","
                Dim m_charSep() As Char = m_strSeperator.ToCharArray
                Dim strDetails As String = ""

                If strInvoiceIDs <> "" Then
                    arrInvoiceIDs = strInvoiceIDs.Split(m_charSep)
                End If

                ReDim strInvNum(UBound(arrInvoiceIDs))

                If Not IsNothing(arrInvoiceIDs) Then
                    Dim intCtr As Integer
                    Dim strInvoiceID As String
                    For intCtr = 0 To arrInvoiceIDs.Length - 1
                        strInvoiceID = arrInvoiceIDs(intCtr)
                        drInvoice = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_RFIInvoices " + strInvoiceID, blnUseSQL)
                        If drInvoice.Read Then
                            strDetails = strDetails & vbTab & Trim(CType(CommonFunction.Data.CheckIsDBNull(drInvoice("InvoiceNumber")), String) & "") & vbTab & "[Invoice ID : " & Trim(CType(drInvoice("InvoiceID"), String) & "") & "]" & vbCrLf
                            strInvoiceNumber = CommonFunction.Data.CheckIsDBNull(drInvoice("InvoiceNumber"), "").ToString
                            strInvNum(intCtr) = strInvoiceNumber
                        End If
                        drInvoice.Close()
                        CommonFunction.Data.DisposeDataReader(drInvoice)
                    Next
                End If

                strMessage.Replace("<DETAILS>", strDetails)

                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
            End Sub


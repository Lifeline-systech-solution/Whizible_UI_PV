            Public Shared Sub GetEmailMessage_15(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal intEmployeeID As Long, ByVal intRoleID As Long)
                '=====================================================================

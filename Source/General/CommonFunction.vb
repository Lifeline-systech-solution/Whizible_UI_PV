            'Code Added By ManishK - Whiz6.0 - issueID - 2303 - FORGOT PASSWORD
            ''integration By Manishk on 4th Jan 06
            ''''''''''''''''Added By NageshM For Tavant sielent email message
            Public Shared Sub GetEmailMessage_443(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal strLoginName As String, ByVal strbuildpassword As String)

                '=====================================================================
                'Purpose        : To generate the silent mail for forgot password  issue 
                'Description    : same as above
                'author         : NageshM
                'Created on     : 13 th jul 2005
                'Modified By    : 
                '=====================================================================	

                Dim strReceiverMailID As String
                Dim strReceiverNames As String
                Dim strQuery As String
                Dim dr As IDataReader

                '1. Code for String Builder Changes - IssueID - 6052 
                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                '  Dim strPasswordQuery As String
                Try
                    'Set the FromEmailID to company mail id
                    strFromEmailID = CommonFunction.General.CheckIsNothing(CommonFunction.EmailMessages.funcGetCompanyMailID)
                    ' Get the message body, and subject.
                    strEmailMessage = funcGetEmailMessageForProject(0, 443, strSubject)

                    '2. Code for String Builder Changes - IssueID - 6052 
                    strMessage = New System.Text.StringBuilder("")
                    strEmailSubject = New System.Text.StringBuilder("")
                    strMessage.Append(strEmailMessage)
                    strEmailSubject.Append(strSubject)

                    ' Retrieve information about the SENDER.
                    strQuery = " EXEC usp_Sel_GetLoginUserEmailInfo '" + strLoginName + "'"
                    dr = CommonFunctions.Data.GetDataReader(strQuery, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                    While dr.Read
                        strReceiverMailID = CommonFunctions.Data.CheckIsDBNull(dr.Item("EmailID"), "").ToString

                    End While
                    CommonFunctions.Data.DisposeDataReader(dr)
                    'strReceiverMailID = CommonFunction.General.CheckIsNothing(CommonFunction.Data.CheckIsDBNull(CommonFunction.Data.GetDataScalar(strQuery, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean)), ""), "").ToString()
                    If Trim(strReceiverMailID) = "" Then
                        strToEmailID = funcGetCompanyMailID()
                    Else
                        strToEmailID = strReceiverMailID
                    End If
                    'code added by SajiU on 13 Dec 2006
                    Dim strMsg As String = ""
                    Dim I As Integer = HttpContext.Current.Request.Url.ToString.IndexOf("Source")

                    ''Commented And Added By Vaijat K On 23/10/2015
                    ''strMsg = HttpContext.Current.Request.Url.ToString.Substring(0, I - 1) + "/Default.aspx"
                    Dim ActionType As String = CommonFunction.Data.CheckIsDBNull(CommonFunction.Data.GetDataScalar("Select S.ActionType From tbl_PM_CompanyInformation C Left Join tbl_CNF_SiteDetailsActionMaster S ON C.ActionType=S.ID WHERE C.CompanyInfoID=1", True), "")
                    If ActionType = "Default" Then
                        strMsg = HttpContext.Current.Request.Url.ToString.Substring(0, I - 1) + "/Default.aspx"
                    ElseIf ActionType = "Dynamic" Then
                        strMsg = CommonFunction.Data.CheckIsDBNull(CommonFunction.Data.GetDataScalar("Select SiteEmailID From tbl_PM_CompanyInformation WHERE CompanyInfoID=1", True), "")
                    ElseIf ActionType = "None" Then
                        strMsg = ""
                    End If

                    strMessage.Replace("<NAME>", strLoginName)
                    strMessage.Replace("<NEW_PASSWORD>", strbuildpassword)
                    strMessage.Replace("<SENDER_NAME>", strFromEmailID)
                    strMessage.Replace("<SITE_URL>", strMsg)
                    'End of Addition by SajiU on 13 Dec 2006
                Catch ex As Exception

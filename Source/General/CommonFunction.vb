                ' Retrieve the name of the team members, and their posts, and format them.									
                drTeamMember = CommonFunction.Data.GetDataReader("Exec usp_Sel_EmployeeEmailAddresses " + HttpContext.Current.Session("intProjectID").ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))

                While drTeamMember.Read
                    If CommonFunction.Data.CheckIsDBNull(drTeamMember("EmployeeName")).ToString.Trim.Length > 20 Then

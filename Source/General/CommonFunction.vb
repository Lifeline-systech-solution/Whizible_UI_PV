            Public Shared Sub GetEmailMessage_73(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal intReviewStatisticsID As Long)
                '=====================================================================
                ' Procedure Name        :   GetEmailMessage_73 (Review closed)
                ' Parameters Passed     :   strFromEmailID  :- The Mail ID of the sender.
                '                           strToEmailID    :- The EmailID of the person to whom the message will be returned.
                '                           strCCToEmailID  :- The EmailID's of the people to whom the CC must be sent.
                '                           strSubject      :- The Subject of the Email Message.
                '                           strEmailMessage :- The body of the Email Message.
                '                           intReviewStatisticsID   :- The Review ID of the review that is used.
                ' Returns               :
                ' Parameters Affected   :   strFromEmailID, strToEmailID, strCCToEmailID, strSubject, strEmailMessage :- These values are returned by the subroutine by reference.
                ' Description           :   Generate the email message as defined in the System Email Messages table in the database.
                ' Purpose               :   Generate the email message as defined in the System Email Messages table in the database.
                ' Assumptions           :   The message ID exists in the database.
                '                           The message does not contain any other parameters besides the following :
                '                               1.  <SENDER_NAME>
                '                               2.  <REVIEW_TYPE>
                '                               3.  <REVIEW_DATE>
                '                               4.  <REVIEWEE_NAME>
                '                               5.  <PROJECT_NAME>
                ' Dependencies          :   None.
                ' Author                :   DipaliS
                ' Created               :   1 Nov 2004
                ' Revisions             :   1.  HiteshS on 19th Jan.2005
                '                               For IssueID >> 15375
                '                               Changes made in fonction to Get Reviewes EmailIDs
                '                               for a given ReviewStatisticsID
                '=======================================================================================
                Dim strUserName, strProjectName As String
                Dim rsReview, rsReviewees As String
                Dim strReceiverList, strEmailID As String
                Dim drReview As IDataReader

                '============================================================
                'Added By       :   HiteshS on 19th Jan.2005
                'Issue ID       :   15375
                'Description    :   Get The Reviewers EmailIDs for a ReviewStatisticsID
                '============================================================
                Dim strSQL As String
                Dim drReviewerEmailIDs As IDataReader
                '============================================================
                'Issue ID       :   15375
                'End of Modification by HiteshS on 19th Jan.2005
                '============================================================

                '1. Code for String Builder Changes - IssueID - 6052 
                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                ' Get the message body, and subject.
                strEmailMessage = CommonFunction.EmailMessages.funcGetEmailMessageForProject(CType(HttpContext.Current.Session("intProjectID"), Long), 73, strSubject)

                '2. Code for String Builder Changes - IssueID - 6052 
                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                ' Retrieve information about the Sender.
                Call CommonFunction.EmailMessages.GetSenderInfo(strUserName, strFromEmailID)
                strMessage.Replace("<SENDER_NAME>", strUserName)

                ' Retrieve information about the Project.
                Call CommonFunction.EmailMessages.GetProjectInfo(CType(HttpContext.Current.Session("intProjectID"), Long), strProjectName, 73, strCCToEmailID)
                strMessage.Replace("<PROJECT_NAME>", strProjectName)

                If intReviewStatisticsID = 0 Then
                    Exit Sub
                End If

                ' Retrieve the information of the review.
                drReview = CommonFunctions.Data.GetDataReader("Exec usp_Sel_tbl_PM_ReviewStatistics_ReviewPlanning " & intReviewStatisticsID, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                If drReview.Read Then

                    ' Review Type.
                    strEmailSubject.Replace("<REVIEW_TYPE>", CommonFunction.Data.CheckIsDBNull(drReview("ReviewType")).ToString.Trim)
                    strMessage.Replace("<REVIEW_TYPE>", CommonFunction.Data.CheckIsDBNull(drReview("ReviewType")).ToString)

                    ' Review Date.
                    strEmailSubject.Replace("<REVIEW_DATE>", CommonFunction.Dates.CGetDate(CType(CommonFunction.Data.CheckIsDBNull(drReview("ReviewedDate")), Date)))
                    strMessage.Replace("<REVIEW_DATE>", CommonFunction.Dates.CGetDate(CType(CommonFunction.Data.CheckIsDBNull(drReview("ReviewedDate")), Date)))

                    ' Reviewee Name.
                    strEmailSubject.Replace("<REVIEWEE_NAME>", CommonFunction.Data.CheckIsDBNull(drReview("Reviewee")).ToString.Trim)
                    strMessage.Replace("<REVIEWEE_NAME>", CommonFunction.Data.CheckIsDBNull(drReview("Reviewee")).ToString.Trim)

                    If CommonFunction.Data.CheckIsDBNull(drReview("RevieweeID")).ToString.Trim <> "" Then
                        Call GetEmployeeInfo(CType(CommonFunction.Data.CheckIsDBNull(drReview("RevieweeID"), "0"), Long), strUserName, strEmailID)
                        If strEmailID <> "" Then
                            strToEmailID = strToEmailID & strEmailID & "; "
                        End If
                    End If

                    '============================================================
                    'Added By       :   HiteshS on 19th Jan.2005
                    'Issue ID       :   15375
                    'Description    :   Get The Reviewers EmailIDs for a ReviewStatisticsID
                    '============================================================
                    strSQL = "Select A.EmailID "
                    strSQL += " From tbl_PM_Employee as A WITH (NOLOCK)"
                    strSQL += "	Inner Join tbl_PM_ReviewStatistics_Reviewers as B WITH (NOLOCK) on A.EmployeeID = B.ReviewerID "
                    strSQL += " Where B.ReviewStatisticsID = " & intReviewStatisticsID
                    ' Added By MahendraV On 11:49 AM 9/7/2007 For WhizibleSEM 7.1
                    ' To show only Active employee
                    ' Start_MV_9/7/2007
                    strSQL += "       AND ISNULL(A.Status,0) = 0 "
                    ' End_MV_9/7/2007

                    ' Retrieve the information of the reviewer EmailIDs.
                    drReviewerEmailIDs = CommonFunctions.Data.GetDataReader(strSQL, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                    strCCToEmailID = ""
                    Do While drReviewerEmailIDs.Read()
                        strCCToEmailID += drReviewerEmailIDs("EmailID").ToString + ";"
                    Loop
                    CommonFunction.Data.DisposeDataReader(drReviewerEmailIDs)
                    strCCToEmailID = Left(strCCToEmailID, Len(strCCToEmailID) - 1)
                    '============================================================
                    'Issue ID       :   15375
                    'End of Modification by HiteshS on 19th Jan.2005
                    '============================================================

                End If
                CommonFunction.Data.DisposeDataReader(drReview)

                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
            End Sub
            Public Shared Sub GetEmailMessage_29(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, Optional ByVal intReviewStatisticsID As Long = 0)

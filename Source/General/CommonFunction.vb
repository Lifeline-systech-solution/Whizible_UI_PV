            Public Shared Sub GetEmailMessage_1002(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal lngProjectID As Long)
                Dim strUserName As String

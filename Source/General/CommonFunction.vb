            sbHTML.Append("strParentPage = opener.opener.location.href;" + vbCrLf)

            sbHTML.Append("if (strParentPage.toUpperCase().indexOf('" + parentPage.ToUpper + "') != -1)" + vbCrLf)
            sbHTML.Append("{" + vbCrLf)
            sbHTML.Append("if(window.opener.opener.document.forms['" + parentFormName + "']!=null){")
            sbHTML.Append("window.opener.opener.document.forms['" + parentFormName + "'].action = '" + submitToPage + "';" + vbCrLf)

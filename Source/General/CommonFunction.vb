        Private Shared Sub LogError(ByVal MailEx As Exception, ByVal Args As Email_ErrorInfo)
            ' Fires when an error occurs While Sending an Email
            ' Check the application Environment
            Try
                If CommonFunctions.General.GetApplicationKeySetting("Environment") = "P" Then
                    'create the error object handler
                    Dim strInnerException As String = ""
                    Dim strStackInfo As String = ""
                    Dim strErrorMessage As String = ""
                    Dim strPageName As String
                    Dim strLogDirectory As String
                    Dim strSource As String = ""
                    Dim strInnerSource As String = ""

                    strInnerException = MailEx.InnerException.ToString
                    strErrorMessage = MailEx.InnerException.InnerException.Message.ToString
                    strStackInfo = MailEx.StackTrace.ToString
                    strInnerSource = MailEx.Source + "-->" + MailEx.InnerException.Source
                    strInnerSource += vbCrLf + "SMTP Server: " + Args.SMTPServer + vbCrLf + "SMTP Server Port: " + Args.SMTPServerPort + vbCrLf + "SMTP Server Installation Type: " + Args.SMTPServer_InstallationType
                    strSource = "EMAIL"
                    Dim objErrorHandler As New ExceptionHandler.ErrorHandler
                    ''calling the process error method of errorhandler class
                    strPageName = HttpContext.Current.Request.Path
                    strPageName = strPageName.Substring(strPageName.LastIndexOf("/") + 1, strPageName.Length - strPageName.LastIndexOf("/") - 1)

                    If CType(InStr(strPageName.ToUpper, "DEFAULT.ASPX"), Boolean) Or CType(InStr(strPageName.ToUpper, "GLOBAL.ASPX"), Boolean) Then
                        strLogDirectory = HttpContext.Current.Server.MapPath("Attachments")
                    Else
                        strLogDirectory = HttpContext.Current.Server.MapPath("../../Attachments")
                    End If

                    objErrorHandler.ErrorMessage = strErrorMessage
                    objErrorHandler.InnerStackInfo = strInnerException
                    objErrorHandler.StackInfo = strStackInfo
                    objErrorHandler.LogDirectory = strLogDirectory
                    objErrorHandler.InnerSource = strInnerSource
                    objErrorHandler.Source = strSource
                    objErrorHandler.PageName = strPageName
                    objErrorHandler.ErrorNumber = Err.Number
                    objErrorHandler.DetailErrorMsg = False
                    objErrorHandler.WriteErrorLog()
                    objErrorHandler = Nothing

                End If
            Catch ex As Exception
                '  Err.Raise(Err.Number, "CommonFunctions->Emails-->LogError", ex.Message)
            End Try


        End Sub


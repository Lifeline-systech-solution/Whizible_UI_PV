        Public Shared Function GetDependantLocationScript(ByVal EditMode As Boolean, Optional ByVal strFormName As String = "frmCommonPage", Optional ByVal ParentControlName As String = "BusinessGroupID", Optional ByVal ChildControlName As String = "LocationID", Optional ByVal strConnectionStringSEM As String = "", Optional ByVal strPrimaryKey As String = "") As String
            '=====================================================================
            ' Procedure Name        : GetDependantLocationScript()
            ' Purpose               : Generic function to create Array Structure to Plot Dependant Organization Unit and DU , DT 
            ' Description           : same as above
            ' Parameters Passed     : None
            ' Returns               : String
            ' Parameters Affected   : 
            ' Assumptions           : ControlNames are 
            '                         BusinessGroupID , LocationID , ResourcePoolID , ResourceGroupID 
            '
            ' Dependencies          : 
            ' Author                : NitinVS 

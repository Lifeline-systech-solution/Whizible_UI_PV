            Public Shared Sub GetEmailMessage_79(ByVal strEmployeeID As String, ByVal strParentTaskIDs As String, ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal strTitle As String)
                '=====================================================================
                ' Procedure Name        :	GetEmailMessage_79
                ' Parameters Passed     :   strEmployeeID	:- EmployeeID to whom the message needs to be sent
                '							strParentTaskIDs:- ParentTaskIDs of the tasks
                '							strToEmailID    :- The EmailID of the person to whom the message will be returned.
                '                           strSubject      :- The Subject of the Email Message.
                '                           strEmailMessage :- The body of the Email Message.
                '                           strTitle        :- Title (Deliverable name)
                ' Returns               :
                ' Parameters Affected   :   strToEmailID, strSubject, strEmailMessage :- These values are returned by the subroutine by reference.
                ' Description           :   Generate the email message as defined in the System Email Messages 
                '							table in the database for the created Tasks.
                ' Assumptions           :   The message ID exists in the database.
                ' Dependencies          :	None
                ' Author                :	ShamkantD
                ' Created               :	31st August 2004
                ' Revisions             :	
                '=====================================================================
                Dim blnUseSQL As Boolean = CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean)
                Dim intMessageID As Integer, strUserName As String
                Dim strListOfEmailIDs As String
                Dim drEmailMessage As IDataReader, drEmployeeDetails As IDataReader, drTaskInformation As IDataReader
                Dim intCounter As Integer, strTaskDetails As String

                '1. Code for String Builder Changes - IssueID - 6052 
                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                intMessageID = 79
                '' START : Integrated by ParagD On 14-Aug-2006 for whizible SP 7.2

                '' START : Added By ParagD On 13-July-2006
                '' Purpose : 
                '' HAIL 23011 - "Project Name" is not displaying in the auto generated mail after 
                '' assigning the  task to resources in IS WSEM."    
                '' Retrieve information about the Project.
                Dim strProjectName, strSQL As String
                Dim objDr As IDataReader
                'retrieve info about the project
                strSQL = "usp_Sel_tbl_PM_Project " + CType(HttpContext.Current.Session("intProjectID"), String)
                objDr = Data.GetDataReader(strSQL, blnUseSQL)
                If objDr.Read Then
                    strProjectName = objDr("ProjectName").ToString + ""
                End If
                Data.DisposeDataReader(objDr)
                '' END : Added By ParagD On 13-July-2006
                '' END : Integrated by ParagD On 14-Aug-2006 for whizible SP 7.2

                ' Get the message body, and subject.
                drEmailMessage = CommonFunction.Data.GetDataReader("EXEC usp_Sel_tbl_PM_EmailMessages " & intMessageID, blnUseSQL)
                If drEmailMessage.Read Then
                    strEmailMessage = CType(CommonFunction.Data.CheckIsDBNull(drEmailMessage("Body"), ""), String).Trim
                    strSubject = CType(CommonFunction.Data.CheckIsDBNull(drEmailMessage("Subject"), ""), String).Trim
                End If

                '2. Code for String Builder Changes - IssueID - 6052 
                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                '' START : Integrated by ParagD On 14-Aug-2006 for whizible SP 7.2
                '' START : Commented & Modified By ParagD On 13-July-2006
                '' Purpose : 
                '' HAIL 23011 - "Project Name" is not displaying in the auto generated mail after 
                '' assigning the  task to resources in IS WSEM."    
                '' Retrieve information about the Project.

                '' strSubject = Replace(strSubject, "<DELIVERABLE_NAME>", strTitle)

                '' START :ParagD On 23-Aug-2006
                '' strSubject = Replace(strSubject, "<DELIVERABLE_NAME>", strProjectName & ":" & strTitle)
                strEmailSubject.Replace("<DELIVERABLE_NAME>", " New Task Assigned [Project :- " & strProjectName & "] [Deliverable :- " & strTitle & " ]")
                '' END : ParagD On 23-Aug-2006

                '' END : Commented & Modified By ParagD On 13-July-2006
                '' END : Integrated by ParagD On 14-Aug-2006 for whizible SP 7.2   



                Call GetSenderInfo(strUserName, strFromEmailID)
                strMessage.Replace("<SENDER_NAME>", strUserName)

                'Get the To Name and Email Address
                drEmployeeDetails = CommonFunction.Data.GetDataReader("EXEC usp_tbl_Sel_EmployeeInfo " & strEmployeeID, blnUseSQL)

                If drEmployeeDetails.Read Then
                    strMessage.Replace("<NAME>", CType(CommonFunction.Data.CheckIsDBNull(drEmployeeDetails("EmployeeName"), ""), String).Trim)

                    If CType(CommonFunction.Data.CheckIsDBNull(drEmployeeDetails("EmailID"), ""), String).Trim <> "" Then
                        strToEmailID = CType(CommonFunction.Data.CheckIsDBNull(drEmployeeDetails("EmailID"), ""), String).Trim
                    Else
                        strToEmailID = ""
                    End If
                End If

                'Get the Task information
                intCounter = 1
                strTaskDetails = ""
                drTaskInformation = CommonFunction.Data.GetDataReader("EXEC usp_sel_tbl_PM_ProjectTasks_ResourceParentTaskWise " & strEmployeeID & ",'" & strParentTaskIDs & "'", blnUseSQL)
                While drTaskInformation.Read

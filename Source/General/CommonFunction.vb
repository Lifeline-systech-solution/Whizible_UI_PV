            Public Shared Sub GetEmailMessage_30(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal intReviewStatisticsID As String, ByVal dtmOldReviewDate As Date, ByVal dtmOldReviewStartDate As Date, ByVal dtmOldReviewEnddate As Date)
                '=====================================================================
                ' Procedure Name		:	GetEmailMessage_30 (REVIEW RESCHEDULED.)
                ' Parameters Passed     :	strFromEmailID	:- The Mail ID of the sender.
                '							strToEmailID	:- The EmailID of the person to whom the message will be returned.
                '							strCCToEmailID	:- The EmailID's of the people to whom the CC must be sent.
                '							strSubject		:- The Subject of the Email Message.
                '							strEmailMessage	:- The body of the Email Message.		
                '							intReviewStatisticsID	:- The Review ID of the review that is planned.
                '							dtmOldReviewDate:- The old review date.
                ' Returns               :	
                ' Parameters Affected   :	strFromEmailID, strToEmailID, strCCToEmailID, strSubject, strEmailMessage :- These values are returned by the subroutine by reference.
                ' Description           :	Generate the email message as defined in the System Email Messages table in the database.
                ' Purpose               :	Generate the email message as defined in the System Email Messages table in the database.
                ' Assumptions           :	The message ID exists in the database.
                '							The message does not contain any other parameters besides the following :
                '								1.	<NAME>
                '								2.	<SENDER_NAME>
                '								3.	<REVIEW_TYPE>	
                '								4.	<OLD_REVIEW_DATE>
                '								5.	<REVIEW_DATE>
                '								6.	<REVIEWER_NAME>
                '								7.	<REVIEWEE_NAME>
                '								8.	<PROJECT_NAME>		
                '								9.	<DURATION_IN_HOURS>
                ' Dependencies          :	None.
                ' Author                :	RajaniR
                ' Created               :	26th June 2001
                ' Revisions             :   20 Oct 2004
                'By dipaliS             :   Added two more parameters for Review Start and Review End old Dates
                '=====================================================================						

                Dim strUserName As String, strProjectName As String
                Dim drReview As IDataReader
                Dim strReceiverList As String, strEmailID As String

                '1. Code for String Builder Changes - IssueID - 6052 
                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                ' Get the message body, and subject.
                strEmailMessage = CommonFunction.EmailMessages.funcGetEmailMessageForProject(CType(HttpContext.Current.Session("intProjectID"), Long), 30, strSubject)

                '2. Code for String Builder Changes - IssueID - 6052 
                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                ' Retrieve information about the Sender.
                Call CommonFunction.EmailMessages.GetSenderInfo(strUserName, strFromEmailID)
                strMessage.Replace("<SENDER_NAME>", strUserName)

                ' Retrieve information about the Project.
                Call CommonFunction.EmailMessages.GetProjectInfo(CType(HttpContext.Current.Session("intProjectID"), Long), strProjectName, 30, strCCToEmailID)
                strMessage.Replace("<PROJECT_NAME>", strProjectName)
                strEmailSubject.Replace("<PROJECT_NAME>", strProjectName)

                If intReviewStatisticsID = "" Then
                    Exit Sub
                End If

                ' Retrieve the information of the review.
                drReview = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_PM_ReviewStatistics_ReviewPlanning " & intReviewStatisticsID, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                If drReview.Read Then

                    ' Review Type.
                    strEmailSubject.Replace("<REVIEW_TYPE>", CommonFunction.Data.CheckIsDBNull(drReview("ReviewType")).ToString)
                    strMessage.Replace("<REVIEW_TYPE>", CommonFunction.Data.CheckIsDBNull(drReview("ReviewType")).ToString)

                    ' Old Review Date.
                    strEmailSubject.Replace("<OLD_REVIEW_DATE>", CommonFunction.Dates.CGetDate(dtmOldReviewDate))
                    strMessage.Replace("<OLD_REVIEW_DATE>", CommonFunction.Dates.CGetDate(dtmOldReviewDate))

                    'Code Commented by DipaliS 20 Oct 2004
                    ' Review Date.
                    'strSubject = Replace(strSubject, "<REVIEW_DATE>", CommonFunction.Dates.CGetDate(CType(CommonFunction.Data.CheckIsDBNull(drReview("ReviewedDate")), Date)))
                    'strEmailMessage = Replace(strEmailMessage, "<REVIEW_DATE>", CommonFunction.Dates.CGetDate(CType(CommonFunction.Data.CheckIsDBNull(drReview("ReviewedDate")), Date)))

                    'Code Added by DipaliS 20 Oct 2004
                    strEmailSubject.Replace("<OLD_REVIEW_START_DATE>", CommonFunction.Dates.CGetDate(dtmOldReviewStartDate))
                    strMessage.Replace("<OLD_REVIEW_START_DATE>", CommonFunction.Dates.CGetDate(dtmOldReviewStartDate))

                    strEmailSubject.Replace("<OLD_REVIEW_END_DATE>", CommonFunction.Dates.CGetDate(dtmOldReviewEnddate))
                    strMessage.Replace("<OLD_REVIEW_END_DATE>", CommonFunction.Dates.CGetDate(dtmOldReviewEnddate))

                    strEmailSubject.Replace("<REVIEW_START_DATE>", CommonFunction.Dates.CGetDate(CType(CommonFunction.Data.CheckIsDBNull(drReview("ReviewStartDate")), Date)))
                    strMessage.Replace("<REVIEW_START_DATE>", CommonFunction.Dates.CGetDate(CType(CommonFunction.Data.CheckIsDBNull(drReview("ReviewStartDate")), Date)))

                    strEmailSubject.Replace("<REVIEW_END_DATE>", CommonFunction.Dates.CGetDate(CType(CommonFunction.Data.CheckIsDBNull(drReview("ReviewEndDate")), Date)))
                    strMessage.Replace("<REVIEW_END_DATE>", CommonFunction.Dates.CGetDate(CType(CommonFunction.Data.CheckIsDBNull(drReview("ReviewEndDate")), Date)))


                    'End addition by DipaliS

                    ' Review Effort.
                    If CommonFunction.Data.CheckIsDBNull(drReview("ReviewType")).ToString.Trim <> "" Then
                        strMessage.Replace("<DURATION_IN_HOURS>", FormatNumber(drReview("ReviewEffort"), 2, , ))
                    End If

                    ' Reviewer Name.
                    strEmailSubject.Replace("<REVIEWER_NAME>", CommonFunction.Data.CheckIsDBNull(drReview("ReviewedBy")).ToString.Trim)
                    strMessage.Replace("<REVIEWER_NAME>", CommonFunction.Data.CheckIsDBNull(drReview("ReviewedBy")).ToString.Trim)

                    ' Reviewee Name.
                    strEmailSubject.Replace("<REVIEWEE_NAME>", CommonFunction.Data.CheckIsDBNull(drReview("Reviewee")).ToString.Trim)
                    strMessage.Replace("<REVIEWEE_NAME>", CommonFunction.Data.CheckIsDBNull(drReview("Reviewee")).ToString.Trim)

                    ' Added By RajaniR on 15th July 2002.
                    ' Work Product Type.
                    strEmailSubject.Replace("<WORK_PRODUCT_TYPE>", CommonFunction.Data.CheckIsDBNull(drReview("WorkProductType")).ToString.Trim)
                    strMessage.Replace("<WORK_PRODUCT_TYPE>", CommonFunction.Data.CheckIsDBNull(drReview("WorkProductType")).ToString.Trim)
                    ' End Addition.

                    ' Receiver names (reviewer and reviewee).
                    strReceiverList = CommonFunction.Data.CheckIsDBNull(drReview("ReviewedBy")).ToString.Trim & ", " & CommonFunction.Data.CheckIsDBNull(drReview("Reviewee")).ToString.Trim & ","
                    strMessage.Replace("<NAME>", strReceiverList)

                    ' Added by RajaniR on Saturday, August 17, 2002 17:13
                    If CommonFunction.Data.CheckIsDBNull(drReview("ReviewedBy")).ToString.Trim <> "" Then
                        Dim drReviewers As IDataReader = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_PM_ReviewStatistics_Reviewers " & intReviewStatisticsID, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                        Do While drReviewers.Read
                            If CommonFunction.Data.CheckIsDBNull(drReviewers("ReviewerID")).ToString.Trim <> "" Then
                                Call CommonFunction.EmailMessages.GetEmployeeInfo(CType(CommonFunction.Data.CheckIsDBNull(drReviewers("ReviewerID")), Long), strUserName, strEmailID)
                                If strEmailID <> "" Then
                                    strToEmailID = strToEmailID & strEmailID & "; "
                                End If
                            End If
                        Loop
                        CommonFunction.Data.DisposeDataReader(drReviewers)
                    End If
                    ' End Addition.

                    'Modified by MrugajaB on 2nd Feb 2006 for Multiple reviewees feature
                    'Purpose:MailIDs for multiple reviewees should be concatenated

                    'If CommonFunction.Data.CheckIsDBNull(drReview("ReviewerID")).ToString.Trim <> "" Then
                    '    Call CommonFunction.EmailMessages.GetEmployeeInfo(CType(CommonFunction.Data.CheckIsDBNull(drReview("ReviewerID")), Long), strUserName, strEmailID)
                    '    If strEmailID <> "" Then
                    '        strToEmailID = strToEmailID & strEmailID & "; "
                    '    End If
                    'End If

                    ' Added by RajaniR on Saturday, August 17, 2002 17:13
                    If CommonFunction.Data.CheckIsDBNull(drReview("Reviewee")).ToString.Trim <> "" Then
                        Dim drReviewers As IDataReader = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_PM_ReviewStatistics_Authors " & intReviewStatisticsID, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                        Do While drReviewers.Read
                            If CommonFunction.Data.CheckIsDBNull(drReviewers("AuthorID")).ToString.Trim <> "" Then
                                Call CommonFunction.EmailMessages.GetEmployeeInfo(CType(CommonFunction.Data.CheckIsDBNull(drReviewers("AuthorID")), Long), strUserName, strEmailID)
                                If strEmailID <> "" Then
                                    If strToEmailID.IndexOf(strEmailID) < 0 Then
                                        strToEmailID = strToEmailID & strEmailID & "; "
                                    End If
                                End If
                            End If
                        Loop
                        CommonFunction.Data.DisposeDataReader(drReviewers)
                    End If
                    ' End Addition.

                    'End Modification by MrugajaB
                End If
                CommonFunction.Data.DisposeDataReader(drReview)

                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
            End Sub


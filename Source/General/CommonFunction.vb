        '=============================================
        ' Procedure Name		: funcReplacePlaceHolders
        ' Description           : 
        ' Purpose               : Get string with replace placeholders
        ' Parameters Passed     : None
        ' Returns               : Message String
        ' Parameters Affected   : AttributeID,MsgID,EmailMessages
        ' Assumptions           :
        ' Dependencies          :
        ' Author                : PrashantSJ
        ' Created               : May 09, 2008
        ' Revisions             :
        '=====================================================================
        Public Shared Function funcReplacePlaceHolders(ByVal MsgID As Integer, ByVal PrimaryKeyValue As Integer, ByVal EMessage As String) As String
            Dim strSQL As String
            Dim objEMDr As IDataReader
            Dim blnUseSQL As Boolean
            Dim strTempMessage As String
            Dim strDropDownEditSQL As String = ""
            Dim strPlaceHolder As String = ""
            Dim strFieldvalue As String = ""
            Dim strTempFieldvalue As String = ""
            Dim strReplace As String = ""
            Dim objDS As DataSet
            Dim RecParsed As String = ""
            Dim initial As Integer
            Dim next1 As Integer
            Dim tempNext1 As Integer
            Dim strFieldvalue1 As String
            strPlaceHolder = EMessage
            strTempMessage = strPlaceHolder

            blnUseSQL = CType(General.GetApplicationKeySetting("UseSQL"), Boolean)
            If strPlaceHolder.Length > 0 Then
                While strPlaceHolder.Length > 0
                    initial = strPlaceHolder.IndexOf("<", 0) ''
                    next1 = strPlaceHolder.IndexOf(">", initial + 1)
                    tempNext1 = next1

                    If next1 <= 0 Then
                        next1 = strPlaceHolder.Length - 1
                    End If
                    If tempNext1 <> -1 Then
                        RecParsed = strPlaceHolder.Substring(initial + 1, next1 - (initial)).Trim
                        RecParsed = RecParsed.Substring(0, RecParsed.Length - 1) 'LEFT(@RecParsed,Len(@RecParsed)-1)''

                        strSQL = "usp_Replace_PlaceHolders_UFFieldValue " & MsgID.ToString & "," & PrimaryKeyValue.ToString & ",N'" & CommonFunction.General.BuildQueryString(RecParsed) & "'"
                        objEMDr = CommonFunction.Data.GetDataReader(strSQL, blnUseSQL)
                        While objEMDr.Read
                            strFieldvalue = CStr(CommonFunction.Data.CheckIsDBNull(objEMDr("ActualFieldValue")))
                            strDropDownEditSQL = CStr(CommonFunction.Data.CheckIsDBNull(objEMDr("DropDownEditSQL")))
                        End While
                        'Added By vijaYD On 24 August 2009
                        If CommonFunction.General.BuildQueryString(RecParsed).Contains("START DATE") = True And MsgID = 1 Then
                            strFieldvalue = CommonFunctions.Dates.CGetDate(CDate(strFieldvalue))
                            strFieldvalue1 = CommonFunction.Data.CheckIsDBNull(CommonFunctions.Data.GetDataScalar("Select ExpectedStartDate From tbl_PM_Project Where ProjectID=" + CType(HttpContext.Current.Session("intProjectID"), String), True))
                            strFieldvalue = strFieldvalue + vbTab + "  Before  Revision : " + CommonFunctions.Dates.CGetDate(CDate(strFieldvalue1))
                        End If

                        If CommonFunction.General.BuildQueryString(RecParsed).Contains("END DATE") = True And MsgID = 1 Then
                            strFieldvalue = CommonFunctions.Dates.CGetDate(CDate(strFieldvalue))
                            strFieldvalue1 = CommonFunction.Data.CheckIsDBNull(CommonFunctions.Data.GetDataScalar("Select ExpectedEndDate From tbl_PM_Project Where ProjectID=" + CType(HttpContext.Current.Session("intProjectID"), String), True))
                            strFieldvalue = strFieldvalue + vbTab + "  Before  Revision : " + CommonFunctions.Dates.CGetDate(CDate(strFieldvalue1))
                        End If

                        If CommonFunction.General.BuildQueryString(RecParsed).Contains("WORK (HRS)") = True And MsgID = 1 Then
                            strFieldvalue1 = CommonFunction.Data.CheckIsDBNull(CommonFunctions.Data.GetDataScalar("Select EstimatedEfforts From tbl_PM_Project Where ProjectID=" + CType(HttpContext.Current.Session("intProjectID"), String), True))
                            strFieldvalue = strFieldvalue + vbTab + "  Before  Revision : " + strFieldvalue1
                        End If
                        If CommonFunction.General.BuildQueryString(RecParsed).Contains("DURATION (DAYS)") = True And MsgID = 1 Then
                            strFieldvalue1 = CommonFunction.Data.CheckIsDBNull(CommonFunctions.Data.GetDataScalar("Select ExpectedDuration From tbl_PM_Project Where ProjectID=" + CType(HttpContext.Current.Session("intProjectID"), String), True))
                            strFieldvalue = strFieldvalue + vbTab + "  Before  Revision : " + strFieldvalue1
                        End If
                        'End Addition By vijaYD On 24 August 2009
                        CommonFunction.Data.DisposeDataReader(objEMDr)

                        If strDropDownEditSQL <> "" Then

                            objDS = CommonFunction.Data.GetDataSet(CommonFunctions.General.ReplacePlaceHolders(strDropDownEditSQL, True), "EmailMessage", , , blnUseSQL)

                            objDS.Tables(0).Columns(0).ColumnName = objDS.Tables(0).Columns(0).ColumnName.Replace(" ", "")

                            For Each objdataRow As DataRow In objDS.Tables(0).Select("" + objDS.Tables(0).Columns(0).ColumnName + "='" + strFieldvalue + "'")
                                If objDS.Tables(0).Columns.Count < 2 Then
                                    strTempFieldvalue = CStr(CommonFunction.Data.CheckIsDBNull(objdataRow.Item(0)))
                                Else
                                    strTempFieldvalue = CStr(CommonFunction.Data.CheckIsDBNull(objdataRow.Item(1)))
                                End If
                            Next

                            strFieldvalue = strTempFieldvalue
                        End If

                        strReplace = "<" + RecParsed + ">"
                        'If strFieldvalue <> "" Then
                        strTempMessage = strTempMessage.Replace(strReplace, strFieldvalue)
                        'End If
                    End If
                    strPlaceHolder = strPlaceHolder.Substring((next1 + 1), strPlaceHolder.Length - (next1 + 1)) ''' Instead of length it will be length-1
                    'strPlaceHolder = strPlaceHolder.Substring((next1), strPlaceHolder.Length - (next1))  ''' Instead of length it will be length-1
                    strFieldvalue = ""
                    strDropDownEditSQL = ""
                    strTempFieldvalue = ""
                End While
            End If

            objDS = Nothing
            funcReplacePlaceHolders = strTempMessage
            ''''

        End Function


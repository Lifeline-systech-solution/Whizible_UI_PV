        Public Shared Function funcReturnOriginalFileName(ByVal strFromwhere As String, ByVal lngAttachmentID As Long) As String
            '-- Function gets the File's Original name from the database

            Dim strSQL As String
            Dim strURL As String
            Dim drfuncAttachments As IDataReader
            Dim strSourceFilePath As String
            Dim strDestinationFileName As String
            Dim strAttachmentType As String
            strAttachmentType = "File"
            strFromwhere = strFromwhere + ""
            strFromwhere = strFromwhere.Trim.ToUpper()

            Select Case strFromwhere

                Case "PM"
                    strSQL = "SELECT MsProjectFileName,OriginalFileName FROM tbl_PM_Project WHERE ProjectID = " + HttpContext.Current.Session("intProjectId").ToString

                Case "BTS"
                    strSQL = "SELECT * FROM tbl_IB_Attachments WHERE AttachmentID = " + lngAttachmentID.ToString

                Case "KM"
                    strSQL = "SELECT * FROM tbl_KM_Attachments WHERE AttachmentID = " + lngAttachmentID.ToString

                Case "TPT"
                    strSQL = "SELECT * FROM tbl_PRS_Templates WHERE TemplateID = " + lngAttachmentID.ToString

                Case "RESUME"
                    strSQL = "SELECT * FROM tbl_PM_Employee WHERE EmployeeID = " + lngAttachmentID.ToString

                Case "PRMD"
                    strSQL = "SELECT * FROM tbl_PRS_ProcessMappingDocuments WHERE MappingID = " + lngAttachmentID.ToString

                Case "CRM_ADMIN"
                    strSQL = "usp_Sel_tbl_CRM_SubRequestType_Templates  null, " + lngAttachmentID.ToString

                Case "CRM"
                    strSQL = "usp_sel_tbl_CRM_Attachments " + lngAttachmentID.ToString

            End Select

            drfuncAttachments = CommonFunctions.Data.GetDataReader(strSQL, CType(CommonFunctions.General.GetApplicationKeySetting("UseSQL"), Boolean))

            If Not drfuncAttachments.Read() Then
                CommonFunction.Data.DisposeDataReader(drfuncAttachments)
                Return ""
            End If

            If strFromwhere = "KM" Or strFromwhere = "BTS" Then
                If CType(CommonFunctions.Data.CheckIsDBNull(drfuncAttachments("SaveAsLink"), "false"), Boolean) Then
                    strAttachmentType = "Link"
                End If
            End If

            If strAttachmentType = "File" Then 'And drfuncAttachments.Read Then

                Select Case strFromwhere
                    Case "RTS"
                        strSourceFilePath = "..\..\Attachments\" + strFromwhere + "\" + CommonFunctions.Data.CheckIsDBNull(drfuncAttachments("GeneratedFileName"), "").ToString

                    Case "PM"
                        'strSourceFilePath = "..\..\Projects\" + CommonFunctions.Data.CheckIsDBNull(drfuncAttachments("MSProjectFileName")).ToString
                        strSourceFilePath = "..\..\Projects\" + CommonFunctions.Data.CheckIsDBNull(drfuncAttachments("MSProjectFileName")).ToString

                    Case "BTS"
                        strSourceFilePath = "..\..\Attachments\" + strFromwhere + "\" + CommonFunctions.Data.CheckIsDBNull(drfuncAttachments("FilePath")).ToString

                    Case "KM"
                        strSourceFilePath = "..\..\Attachments\" + strFromwhere + "\" + CommonFunctions.Data.CheckIsDBNull(drfuncAttachments("Attachments"), "").ToString

                    Case "TPT"
                        strSourceFilePath = "..\..\Attachments\" + strFromwhere + "\" + CommonFunctions.Data.CheckIsDBNull(drfuncAttachments("FileName"), "").ToString

                    Case "RESUME"
                        strSourceFilePath = "..\..\Attachments\" + strFromwhere + "\" + CommonFunctions.Data.CheckIsDBNull(drfuncAttachments("SystemGeneratedFileName"), "").ToString

                    Case "PRMD"
                        strSourceFilePath = "..\..\Attachments\" & strFromwhere & "\" & CommonFunctions.Data.CheckIsDBNull(drfuncAttachments("GeneratedFileName")).ToString

                    Case "CRM_ADMIN", "CRM"
                        strSourceFilePath = "..\..\Attachments\CRM\" & CommonFunctions.Data.CheckIsDBNull(drfuncAttachments("SystemFileName")).ToString

                End Select

                strSourceFilePath = HttpContext.Current.Server.MapPath(strSourceFilePath)

                If strFromwhere = "CRM_ADMIN" Then
                    strDestinationFileName = "..\..\Attachments\CRM"
                Else
                    strDestinationFileName = "..\..\Attachments\" + strFromwhere
                End If

                '************************************************
                'Modified By    :   SachinR 
                'Modified On    :   Mar 19 2004, added "Or strFromwhere = "TPT""
                '************************************************
                'For show attachment in PM and BTS - Returning only Original file name
                If strFromwhere = "PM" Or strFromwhere = "BTS" Or strFromwhere = "KM" Or strFromwhere = "TPT" Then
                    strURL = drfuncAttachments("OriginalFileName").ToString + ""
                    '************************************************
                    'Modification end   :   SachinR
                    '************************************************
                Else
                    strURL = strDestinationFileName & "\" & HttpContext.Current.Server.UrlPathEncode(drfuncAttachments("OriginalFileName").ToString)
                End If


                strDestinationFileName = HttpContext.Current.Server.MapPath(strDestinationFileName)
                'Modified and Added by PrashantD on 16 July 2007
                'Purpose: Page crash if filename has special character. Such files can be uploaded from Linux machine
                Dim strDestinationFilePath As String
                strDestinationFilePath = strDestinationFileName + "\"
                'strDestinationFileName = strDestinationFileName + "\" + drfuncAttachments("OriginalFileName").ToString
                strDestinationFileName = drfuncAttachments("OriginalFileName").ToString
                Try


                    If (CommonFunctions.FileDirectory.IsFileExists(strSourceFilePath)) Then
                        'CommonFunctions.FileDirectory.CopyFile(strSourceFilePath, strDestinationFileName, True)
                        CommonFunctions.FileDirectory.CopyFile(strSourceFilePath, strDestinationFilePath + strDestinationFileName, True)
                    End If
                Catch ex As Exception
                    'Handling exception for CRM only
                    If strFromwhere = "PM" Or strFromwhere = "BTS" Or strFromwhere = "KM" Or strFromwhere = "TPT" Then
                    Else
                        Dim strFileName As String = CommonFunction.FileDirectory.GetUniqueFileName()
                        strFileName = strFileName & drfuncAttachments("OriginalFileName").ToString.Substring(drfuncAttachments("OriginalFileName").ToString.LastIndexOf("."))
                        strURL = strDestinationFilePath & strFileName
                        If (CommonFunctions.FileDirectory.IsFileExists(strSourceFilePath)) Then
                            'CommonFunctions.FileDirectory.CopyFile(strSourceFilePath, strDestinationFileName, True)
                            CommonFunctions.FileDirectory.CopyFile(strSourceFilePath, strDestinationFilePath + strFileName, True)
                        End If
                    End If
                End Try
                'End of addition by PrashantD on 16 July 2007
            Else
                strURL = drfuncAttachments("OriginalFileName").ToString
            End If

            CommonFunction.Data.DisposeDataReader(drfuncAttachments)

            Return (strURL)

        End Function


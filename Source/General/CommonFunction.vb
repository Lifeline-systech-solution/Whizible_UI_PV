            Public Shared Sub GetEmailMessage_471(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal intScheduleID As Long)
                '=====================================================================
                ' Procedure Name		:	GetEmailMessage_471 (Deliverable Creation Mail)
                ' Parameters Passed     :	strFromEmailID	:- The Mail ID of the sender.
                '							strToEmailID	:- The EmailID of the person to whom the message will be returned.

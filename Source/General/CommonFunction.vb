        Public Shared Shadows Function GeneratePrimaryKeyValue(ByVal ControlsHashTable As Hashtable, ByVal WhizGlobal As WebPages.Template.IGlobal, ByVal strDataType As String, Optional ByVal intMaxLength As Integer = 0, Optional ByVal intPrevMax As Long = 0) As String
            '=====================================================================
            ' Procedure Name        :	GeneratePrimaryKeyValue
            ' Purpose               :	Generate PrimaryKey Value
            ' Description           :	Same as above
            ' Parameters Passed     :	None.
            ' Parameters Affected   :	None.
            ' Returns               :	Unique Primary Key Value
            ' Assumptions           :	None.
            ' Dependencies          :	None.
            ' Author                :	UmeshJ
            ' Created               :	Thursday, December 11, 2003 
            ' Revisions             :
            '=====================================================================
            If WhizGlobal.ParentTagID = 0 Then
                Select Case WhizGlobal.TagID
                    Case CommonFunction.Constants.APP_TAG_TASK_TYPE_MAINTENANCE_PM
                        GeneratePrimaryKeyValue = CommonFunctions.General.CheckIsNothing(ControlsHashTable("TaskTypeID")).ToString.Trim
                    Case Else
                        Select Case strDataType.Trim.ToUpper
                            Case "UNIQUEIDENTIFIER"
                                'If the Data Type of the Primary Key is uniqueidentifier then the primary key will be generated as guid.
                                GeneratePrimaryKeyValue = Guid.NewGuid.ToString
                            Case "NVARCHAR", "VARCHAR"
                                'If the data type is varchar or nvarchar then the unique primary key will be generated by considering its length
                            Case "BIGINT", "INT", "DECIMAL", "NUMERIC"
                                'PK will be Previous Max + 1
                                GeneratePrimaryKeyValue = (intPrevMax + 1).ToString
                            Case Else
                        End Select

                End Select
            End If
        End Function

                ' Created               :	3rd April 2004
                ' Revisions             :
                '=====================================================================		
                Dim blnUseSQL As Boolean = CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean)

                Dim intMessageID As Integer
                Dim drEmployeeLeaveDetails As IDataReader
                Dim drEmailMessage As IDataReader
                Dim drApprover As IDataReader

                'Integrated By ManishK On  03rd Jan 06 For WFH
                'addition by SachinR On 02 Dec 2005 For WFH

                '1. Code for String Builder Changes - IssueID - 6052 
                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                'Added By VarunA on 14-May-2007 Cleanup Activity for leave workflow
                'Purpose: To send mails to configure ones
                Dim drMailIDCC As IDataReader
                'End By VarunA  on 14-May-2007

                Dim strRequestType As String
                drEmployeeLeaveDetails = CommonFunction.Data.GetDataReader("usp_sel_tbl_PM_EmployeeLeaveDetails " + intLeaveId.ToString, blnUseSQL)
                If drEmployeeLeaveDetails.Read Then
                    strRequestType = drEmployeeLeaveDetails("LeaveOrWFH").ToString + ""
                End If
                CommonFunction.Data.DisposeDataReader(drEmployeeLeaveDetails)
                If strRequestType = "" Then strRequestType = "L"

                If strRequestType = "W" Then
                    intMessageID = 455
                Else
                    intMessageID = 84
                End If

                'intMessageID = 84
                'End of addition by SachinR On 02 Dec 2005 For WFH
                'End of Integrated By ManishK On  03rd Jan 06 For WFH

                ' Get the message body, and subject.
                drEmailMessage = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_EmailMessages " + intMessageID.ToString, blnUseSQL)
                If drEmailMessage.Read Then
                    strEmailMessage = CommonFunction.Data.CheckIsDBNull(drEmailMessage("Body")).ToString
                    strSubject = CommonFunction.Data.CheckIsDBNull(drEmailMessage("Subject")).ToString

                End If
                CommonFunction.Data.DisposeDataReader(drEmailMessage)

                '2. Code for String Builder Changes - IssueID - 6052 
                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                drEmployeeLeaveDetails = CommonFunction.Data.GetDataReader("usp_sel_tbl_PM_EmployeeLeaveDetails " + intLeaveId.ToString, blnUseSQL)
                If drEmployeeLeaveDetails.Read Then
                    strMessage.Replace("<From_Date>", CommonFunction.Dates.CGetDate(CType(drEmployeeLeaveDetails("FromDate"), Date)).ToString)
                    strMessage.Replace("<To_Date>", CommonFunction.Dates.CGetDate(CType(drEmployeeLeaveDetails("ToDate"), Date)).ToString)
                    strEmailSubject.Replace("<LEAVE_TYPE>", drEmployeeLeaveDetails("LeaveType").ToString)
                    strFromEmailID = drEmployeeLeaveDetails("emailid").ToString
                    strMessage.Replace("<SENDER_NAME>", drEmployeeLeaveDetails("employeename").ToString)
                    'Added By ShraddhaM on 10,May 2007 for Flexcell Issue ID : 6171
                    'In Leave Mail half Day leave is considered
                    If CType(drEmployeeLeaveDetails("HalfDay"), Boolean) = True Then
                        strMessage.Replace("<HALF_DAY>", " Half Day")
                    Else
                        strMessage.Replace("<HALF_DAY>", "")
                    End If
                    'Ended By ShraddhaM on 10,May 2007 for Flexcell Issue ID : 6171
                    'In Leave Mail half Day leave is considered
                End If
                CommonFunction.Data.DisposeDataReader(drEmployeeLeaveDetails)

                drApprover = CommonFunction.Data.GetDataReader("usp_Sel_ApproverEmailID " + intLeaveId.ToString, blnUseSQL)
                If drApprover.Read Then
                    strToEmailID = drApprover("emailid").ToString
                    strMessage.Replace("<NAME>", drApprover("Employeename").ToString)
                End If
                CommonFunction.Data.DisposeDataReader(drApprover)

                'Added By JayavantK, On 14-Sep-2004
                drApprover = CommonFunction.Data.GetDataReader("usp_Sel_ApproverEmailID_ForCC " + intLeaveId.ToString, blnUseSQL)
                If CommonFunctions.General.CheckIsNothing(drApprover, "") <> "" Then
                    strCCToEmailID = ""
                    While drApprover.Read()
                        If Not strToEmailID.Equals(drApprover("emailid").ToString()) Then
                            If drApprover("emailid").ToString <> "" Then
                                strCCToEmailID &= drApprover("emailid").ToString & ", "
                            End If
                        End If
                    End While
                    CommonFunction.Data.DisposeDataReader(drApprover)
                End If
                'End Addition

                'Added by VarunA on 14-May-2007 Cleanup Activity for leave workflow
                'Purpose: To send mails to configure ones
                drMailIDCC = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_EmailMessage_MailIDForCC " + intMessageID.ToString, blnUseSQL)
                If CommonFunctions.General.CheckIsNothing(drMailIDCC, "") <> "" Then
                    While drMailIDCC.Read()
                        If Not strToEmailID.Equals(drMailIDCC("emailid").ToString()) Then
                            If drMailIDCC("emailid").ToString <> "" Then
                                strCCToEmailID &= drMailIDCC("emailid").ToString & ", "
                            End If
                        End If
                    End While
                    CommonFunction.Data.DisposeDataReader(drMailIDCC)
                End If
                'End By VarunA on 14-May-2007 

                'Added By VarunA on 19-June-2007 Whizible Regression Project Issue-13396
                'Purpose : For CC last emaid id has comma separated which to be removed.
                If strCCToEmailID <> "" Then
                    strCCToEmailID = Left(strCCToEmailID, strCCToEmailID.Length - 2)
                End If
                'End By VarunA on 19-June-2007

                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
            End Sub


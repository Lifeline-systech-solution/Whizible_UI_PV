                'Purpose : Help Desk -> Discussion Thread  : For the discussion  thread mail to list goes blank if the request is posted by the HRM person for own. 
                If ToEmailID = "" Then
                    '-- code modified by purvaj on 25 jun 2009 for 8.1 Issue fixes
                    '-- 1st character of To email ID was getting truncated because,
                    '-- This if block was previously called before do while loop of 'to emailID'
                    '--, it shuold be called after the loop.From email ID was always getting appended to toemailID.
                    '--- "," + appended
                    ToEmailID = "," + FromEmailID
                    '-- End modification purvaj
                End If
                'End of addition by SuchitraP

                If Trim(ToEmailID & "") <> "" Then
                    ToEmailID = Right(ToEmailID, Len(ToEmailID) - 1)
                End If

                If Trim(strUserName & "") <> "" Then
                    strUserName = Right(strUserName, Len(strUserName) - 1)
                End If

                ' the discussion details
                dr = CommonFunctions.Data.GetDataReader("usp_CRM_Discussions  " & RequestID, blnUseSQL)
                Dim strIsShowToCustomer As String
                Do While dr.Read
                    'by Amit Mahadik on 29 July 2011 
                    'for the purpose:  Whiziblesem 10.0 Issue ID:50821
                    strIsShowToCustomer = Trim(dr("IsShowToCustomer").ToString & "")
                    'Added by Amit Mahadik on 01 August 2011 Purpose:Whizible SEM 10.0 IssueID 50822
                    If LoginType <> "C" And strIsShowToCustomer.ToUpper() = "TRUE" Then
                        strIsShowToCustomer = "TRUE"
                    End If
                    'Added by Amit Mahadik on 01 August 2011 Purpose:Whizible SEM 10.0 IssueID 50822
                    If IsShowToCustomer = "1" Then  ''checkbox
                        If strIsShowToCustomer.ToUpper() = "TRUE" Then ''from column
                            strDiscussions &= "Comment added by " & Trim(dr("SubmittedBy").ToString & "")
                            strDiscussions &= " on " & CommonFunctions.Dates.CGetDateTime(CType(dr("SubmittedDate"), Date))
                            strDiscussions &= vbCrLf & "  " & Trim(dr("DiscussionThread").ToString & "") & vbCrLf & vbCrLf & vbCrLf

                        End If
                    Else
                        strDiscussions &= "Comment added by " & Trim(dr("SubmittedBy").ToString & "")
                        strDiscussions &= " on " & CommonFunctions.Dates.CGetDateTime(CType(dr("SubmittedDate"), Date))
                        strDiscussions &= vbCrLf & "  " & Trim(dr("DiscussionThread").ToString & "") & vbCrLf & vbCrLf & vbCrLf

                    End If

                Loop
                CommonFunctions.Data.DisposeDataReader(dr)

                ' Retrieve the request(s) details.
                dr = CommonFunctions.Data.GetDataReader("usp_CRM_Get_RequestDetail_ForEmail '" & RequestID & "'", blnUseSQL)
                If dr.Read Then

                    strEmailSubject.Replace("<REQUEST_SUBJECT>", dr("Subject").ToString)
                    strEmailSubject.Replace("<REQUESTOR>", dr("RequestorName").ToString())
                    strMessage.Replace("<NAME>", strUserName)
                    strMessage.Replace("<REQUEST_SUBJECT>", dr("Subject").ToString)
                    strMessage.Replace("<DATE>", CommonFunctions.Dates.CGetDateTime(Now()))
                    strMessage.Replace("<DISCUSSION_THREAD>", strDiscussions)
                End If
                CommonFunctions.Data.DisposeDataReader(dr)


                '4. Code for String Builder Changes - IssueID - 6052 
                EmailMessage = strMessage.ToString
                Subject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
            End Sub
            ''End Modified and integrated by Amit Mahadik Whiziblesem 10.0 Issue ID:50821

        End Class

        Public Class IBMessages

            Public Shared Sub GetEmailMessage_8(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal intIssueID As Long)
                '=====================================================================
                ' Procedure Name		:	GetEmailMessage_8 (ISSUE ENTERED BY CUSTOMER)
                ' Parameters Passed     :	strToEmailID	:- The EmailID of the person to whom the message will be returned.
                '							strSubject		:- The Subject of the Email Message.
                '							strEmailMessage	:- The Body of the Email Message.
                '							intIssueID		:- The ID of the Issue entered by the customer.
                ' Returns               :	No return values.
                ' Parameters Affected   :	strToEmailID, strSubject, strEmailMessage :- These values are returned by the subroutine by reference.
                ' Description           :	Generate the email message as defined in the System Email Messages table in the database.
                ' Purpose               :	Generate the email message as defined in the System Email Messages table in the database.
                ' Assumptions           :	The message ID exists in the database.
                '							The message does not contain any other parameters besides the following :
                '								1.	<NAME>
                '								2.	<SENDER_NAME>
                '								3.	<PROJECT_NAME> 
                '								4.	<SUMMARY>
                '								5.	<DESCRIPTION>	
                '								6.	<ISSUE_ID>
                ' Dependencies          :	None.
                ' Author                :	AniruddhaD
                ' Created               :	Feb 16, 2004
                ' Revisions             :
                '=====================================================================		

                Dim strUserName As String = ""
                Dim strProjectName As String = ""
                Dim drReceiver As IDataReader
                Dim drIssue As IDataReader
                Dim strListOfReceivers As String = ""
                Dim intMessageID As Long = 8
                Dim strProjectIssueType As String = ""
                Dim strProjectIssueStatus As String = ""
                Dim blnShowToCustomer As Boolean = False
                Dim strMailToEmployeeIDList As String = ""
                Dim strMailCCToEmployeeIDList As String = ""
                Dim drEmployee As IDataReader

                'Added by SavitaS on 21 Aug 2006 for SP7 integration
                Dim strReportedBy As String = ""
                Dim strReportedByPersonEmail As String = ""
                Dim objDr As IDataReader
                Dim intResponsible As String = ""
                Dim strResponsiblePersonEmail As String = ""
                'End of Addition by SavitaS on 21 Aug 2006 for SP7 integration

                '1. Code for String Builder Changes - IssueID - 6052 

                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                ' Get the message body, and subject.

                'commented by AniruddhaD on 20 Dec 2005 for providing projects combo on issue list page (IssueID:685)
                'strEmailMessage = funcGetEmailMessageForProject(CType(HttpContext.Current.Session("intProjectID"), Long), intMessageID, strSubject)

                'Modified by MrugajaB on 1st March 2006 for Multiple Reviewees Feature Issue ID.1835
                'Purpose:If mail is getting fired fro place other than issue base then consider project in session
                If CType(HttpContext.Current.Session("IssueProject"), Long) <> 0 Then
                    'Added by AniruddhaD on 20 Dec 2005 for providing projects combo on issue list page (IssueID:685)
                    strEmailMessage = funcGetEmailMessageForProject(CType(HttpContext.Current.Session("IssueProject"), Long), intMessageID, strSubject)
                Else
                    strEmailMessage = funcGetEmailMessageForProject(CType(HttpContext.Current.Session("intProjectID"), Long), intMessageID, strSubject)
                End If

                '2. Code for String Builder Changes - IssueID - 6052 

                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                ' Retrieve information about the Project.
                'commented by AniruddhaD on 20 Dec 2005 for providing projects combo on issue list page (IssueID:685)
                'Call GetProjectInfo(CType(HttpContext.Current.Session("intProjectID"), Long), strProjectName, intMessageID, strCCToEmailID)

                'Modified by MrugajaB on 1st March 2006 for Multiple Reviewees Feature Issue ID.1835
                'Purpose:If mail is getting fired fro place other than issue base then consider project in session
                If CType(HttpContext.Current.Session("IssueProject"), Long) <> 0 Then
                    'Added by AniruddhaD on 20 Dec 2005 for providing projects combo on issue list page (IssueID:685)
                    Call GetProjectInfo(CType(HttpContext.Current.Session("IssueProject"), Long), strProjectName, intMessageID, strCCToEmailID)
                Else
                    Call GetProjectInfo(CType(HttpContext.Current.Session("intProjectID"), Long), strProjectName, intMessageID, strCCToEmailID)
                End If
                'End Modification


                '3. Code for String Builder Changes - IssueID - 6052 
                'strEmailMessage = Replace(strEmailMessage, "<PROJECT_NAME>", strProjectName)
                strMessage.Replace("<PROJECT_NAME>", strProjectName)

                'strSubject = Replace(strSubject, "<PROJECT_NAME>", strProjectName)
                strEmailSubject.Replace("<PROJECT_NAME>", strProjectName)

                ' Retrieve information about the Sender.
                Call GetSenderInfo(strUserName, strFromEmailID)

                '3. Code for String Builder Changes - IssueID - 6052 
                'strEmailMessage = Replace(strEmailMessage, "<SENDER_NAME>", strUserName)
                strMessage.Replace("<SENDER_NAME>", strUserName)
                If Trim(strListOfReceivers) = "" Then
                    strListOfReceivers = "All"
                End If

                '3. Code for String Builder Changes - IssueID - 6052 
                'strEmailMessage = Replace(strEmailMessage, "<NAME>", strListOfReceivers)
                strMessage.Replace("<NAME>", strListOfReceivers)

                ' If the Issue ID is not specified, then exit the subroutine.
                If intIssueID = 0 Then
                    Exit Sub
                End If

                ' Retrieve the Issue details.
                drIssue = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_IB_Issue " + intIssueID.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))

                ' If the Issue exists, then...
                If drIssue.Read Then
                    '3. Code for String Builder Changes - IssueID - 6052 
                    strMessage.Replace("<ISSUE_TYPE>", drIssue("Type").ToString.Trim)
                    strMessage.Replace("<ISSUE_ID>", intIssueID.ToString)
                    strMessage.Replace("<SUMMARY>", drIssue("Summary").ToString.Trim)
                    strEmailSubject.Replace("<SUMMARY>", drIssue("Summary").ToString.Trim)
                    strMessage.Replace("<DESCRIPTION>", drIssue("Description").ToString.Trim)
                    strProjectIssueType = drIssue("Type").ToString.Trim
                    strProjectIssueStatus = drIssue("Status").ToString.Trim
                    blnShowToCustomer = CType(drIssue("ShowToCustomer"), Boolean)
                    'Added by SavitaS on 21 Aug 2006 for SP7 integration
                    strReportedBy = CType(CommonFunction.Data.CheckIsDBNull(drIssue("ReportedBy"), ""), String)
                    strReportedBy = strReportedBy.Trim
                    intResponsible = CType(CommonFunctions.Data.CheckIsDBNull(drIssue("AssignTO").ToString, ""), String)
                    'End of Addition by SavitaS on 21 Aug 2006 for SP7 integration
                End If
                CommonFunction.Data.DisposeDataReader(drIssue)

                ' Get the list of users to whom the mail must be sent.

                'commented by AniruddhaD on 20 Dec 2005 for providing projects combo on issue list page (IssueID:685)
                'drIssue = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_IB_IssueBaseMails NULL, " + HttpContext.Current.Session("intProjectID").ToString + ", '" + CommonFunction.General.BuildQueryString(strProjectIssueType) + "', '" + CommonFunction.General.BuildQueryString(strProjectIssueStatus) + "'", CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))


                'Modified by MrugajaB on 1st March 2006 for Multiple Reviewees Feature Issue ID.1835
                'Purpose:If mail is getting fired fro place other than issue base then consider project in session
                If CType(HttpContext.Current.Session("IssueProject"), Long) <> 0 Then
                    'Added by AniruddhaD on 20 Dec 2005 for providing projects combo on issue list page (IssueID:685)
                    drIssue = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_IB_IssueBaseMails NULL, " + HttpContext.Current.Session("IssueProject").ToString + ", '" + CommonFunction.General.BuildQueryString(strProjectIssueType) + "', '" + CommonFunction.General.BuildQueryString(strProjectIssueStatus) + "'", CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                Else
                    drIssue = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_IB_IssueBaseMails NULL, " + HttpContext.Current.Session("intProjectID").ToString + ", '" + CommonFunction.General.BuildQueryString(strProjectIssueType) + "', '" + CommonFunction.General.BuildQueryString(strProjectIssueStatus) + "'", CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                End If

                If drIssue.Read Then
                    strMailToEmployeeIDList = drIssue("MailToEmployeeIDList").ToString
                    strMailCCToEmployeeIDList = drIssue("MailCCToEmployeeIDList").ToString
                End If
                CommonFunction.Data.DisposeDataReader(drIssue)

                ' Get the employee email ids.

                'Commented by AniruddhaD on 20 Dec 2005 for providing projects combo on issue list page (IssueID:685)
                'drEmployee = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_IB_IssueBaseMails_EmployeeList " + HttpContext.Current.Session("intProjectID").ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))

                'Modified by MrugajaB on 1st March 2006 for Multiple Reviewees Feature Issue ID.1835
                'Purpose:If mail is getting fired fro place other than issue base then consider project in session
                If CType(HttpContext.Current.Session("IssueProject"), Long) <> 0 Then

                    'Added by AniruddhaD on 20 Dec 2005 for providing projects combo on issue list page (IssueID:685)
                    drEmployee = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_IB_IssueBaseMails_EmployeeList " + HttpContext.Current.Session("IssueProject").ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                Else
                    drEmployee = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_IB_IssueBaseMails_EmployeeList " + HttpContext.Current.Session("intProjectID").ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                End If
                Do While drEmployee.Read
                    If drEmployee("EmailID").ToString.Trim <> "" Then
                        If blnShowToCustomer = True Or (blnShowToCustomer = False And (drEmployee("ResourceType").ToString = "E" Or drEmployee("ResourceType").ToString = "CE")) Then
                            If InStr(strMailToEmployeeIDList, "," + drEmployee("EmployeeID").ToString.Trim + ",") <> 0 Then
                                If InStr(strToEmailID, drEmployee("EmailID").ToString.Trim) = 0 Then
                                    strToEmailID = strToEmailID + drEmployee("EmailID").ToString.Trim + ";"
                                End If
                            End If
                            If InStr(strMailCCToEmployeeIDList, "," + drEmployee("EmployeeID").ToString.Trim + ",") <> 0 Then
                                If InStr(strCCToEmailID, drEmployee("EmailID").ToString.Trim) = 0 Then
                                    strCCToEmailID = strCCToEmailID + ";" + drEmployee("EmailID").ToString.Trim
                                End If
                            End If
                        End If
                    End If
                Loop
                CommonFunction.Data.DisposeDataReader(drEmployee)

                If intResponsible.ToString <> "" Then
                    'End of Commented and modified by SavitaS on 21 Aug 2006 for whiziblesem SP7  Integration
                    ' Commented and modified By MahendraV On 11:49 AM 9/7/2007 For WhizibleSEM 7.1
                    ' To get only Active employee emailID
                    ' Start_MV_9/7/2007
                    ' strResponsiblePersonEmail = CType(CommonFunctions.Data.GetDataScalar("SELECT ISNULL(EmailID,'') FROM tbl_PM_Employee WHERE EmployeeID = " + intResponsible.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean)), String)
                    strResponsiblePersonEmail = CType(CommonFunctions.Data.GetDataScalar("SELECT ISNULL(EmailID,'') FROM tbl_PM_Employee WITH (NOLOCK) WHERE ISNULL(Status,0) = 0 AND EmployeeID = " + intResponsible.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean)), String)
                    ' End_MV_9/7/2007
                End If

                If (InStr(strCCToEmailID, strResponsiblePersonEmail) = 0) And (InStr(strToEmailID, strResponsiblePersonEmail) = 0) Then
                    If strToEmailID <> "" Then
                        strToEmailID = strToEmailID + ";" + strResponsiblePersonEmail
                    Else
                        strToEmailID = strResponsiblePersonEmail
                    End If
                End If


                'Added by SavitaS on 21 Aug 2006 for SP7 integration
                If strReportedBy <> "" Then
                    'Modified by MrugajaB on 1st March 2006 for Multiple Reviewees Feature Issue ID.1835
                    'Purpose:If mail is getting fired fro place other than issue base then consider project in session
                    If CType(HttpContext.Current.Session("IssueProject"), Long) <> 0 Then

                        objDr = CommonFunction.Data.GetDataReader("Exec usp_sel_tbl_IB_Issue_reportedBy '" + strReportedBy + "'," + CType(HttpContext.Current.Session("IssueProject"), String), CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                    Else
                        objDr = CommonFunction.Data.GetDataReader("Exec usp_sel_tbl_IB_Issue_reportedBy '" + strReportedBy + "'," + CType(HttpContext.Current.Session("intProjectID"), String), CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                    End If
                    'End Modification by MrugajaB

                End If
                If objDr.Read Then
                    strReportedByPersonEmail = objDr("EmailID").ToString
                End If
                Data.DisposeDataReader(objDr)
                If (InStr(strCCToEmailID, strReportedByPersonEmail) = 0) And (InStr(strToEmailID, strReportedByPersonEmail) = 0) Then
                    If strCCToEmailID <> "" Then
                        strCCToEmailID = strCCToEmailID + ";" + strReportedByPersonEmail
                    Else
                        strCCToEmailID = strReportedByPersonEmail
                    End If
                End If

                'End Addition by SavitaS on 21 Aug 2006 for SP7 integration

                '--- Added By purvaj on 1 July 2009 8.1 Issue Fixes
                '--- If To is blank then mail is sent to the Issue responsible person set at project settings.
                If strToEmailID = "" Then
                    strToEmailID = CommonFunction.General.CheckIsNothing(CommonFunction.Data.CheckIsDBNull(CommonFunction.Data.GetDataScalar("usp_sel_IssueResponsiblePerson_forDTmail " + CType(CommonFunction.General.CheckIsNothing(HttpContext.Current.Session("IssueProject"), "0"), Long).ToString, True), ""), "")
                    'Integrated by Amit J on 07-Jun-2010 - HotFix 9.0.046
                    'Purpose:Create New Project=>Reposible person field is blank=>Try to assign an issue.=> Email (should be in silent Mode)  genration logic Crashes.
                    'Added by kanchanH to resolve the page crash on issue page. 
                    'If no responsible person is set and Send Mail option is unchecked then mail should be sent to person who posted the issue.
                    If strToEmailID = "" Then
                        strToEmailID = strFromEmailID
                    End If
                    'End of Integration By AmitJ
                End If
                '--- ENd addition purvaj

                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                    strEmailSubject = Nothing

            End Sub
            '=====================================================================
            ' Procedure Name		:	GetEmailMessage_33 (ISSUE BASE DISCUSSION THREAD.)
            ' Parameters Passed     :	strFromEmailID	:- The Mail ID of the sender.
            '							strToEmailID	:- The EmailID of the person to whom the message will be returned.
            '							strCCToEmailID	:- The EmailID's of the people to whom the CC must be sent.
            '							strSubject		:- The Subject of the Email Message.
            '							strEmailMessage	:- The body of the Email Message.			
            '							intIssueID		:- The Issue ID.
            ' Returns               :	
            ' Parameters Affected   :	strFromEmailID, strToEmailID, strCCToEmailID, strSubject, strEmailMessage :- These values are returned by the subroutine by reference.
            ' Description           :	Generate the email message as defined in the System Email Messages table in the database.
            ' Purpose               :	Generate the email message as defined in the System Email Messages table in the database.
            ' Assumptions           :	The message ID exists in the database.
            '							The message does not contain any other parameters besides the following :
            '								1.	<NAME>
            '								2.	<SENDER_NAME>
            '								3.	<ISSUE_ID> usp_Sel_tbl_IB_IssueBaseMails
            '								7.	<PROJECT_NAME>
            ' Dependencies          :	None.
            ' Author                :	SachinR
            ' Created               :	Monday, Feb 09, 2004 
            ' Revisions             :
            '=====================================================================						
            Public Shared Sub GetEmailMessage_33(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal lngIssueID As Long)
                Dim strSQL As String
                Dim objDr As IDataReader
                Dim lngMessageID As Long = 0
                Dim strUserName As String = ""
                Dim strProjectName As String = ""
                Dim lngProjectID As Long = 0
                Dim strDiscussion As String = ""
                Dim strIssueSummary As String = ""
                Dim strProjectIssueType As String = ""
                Dim strMailToEmployeeIDList As String = ""
                Dim strMailCCToEmployeeIDList As String = ""
                Dim blnShowToCustomer As Boolean
                Dim strIssueStatus As String = ""
                Dim strResponsiblePersonID As String = ""
                Dim blnUseSQL As Boolean
                Dim blnIsActive As Boolean
                Dim blnIsComplete As Boolean
                Dim strReportedBy As String = ""

                'Added By VidyaJ on 2nd June 2005
                Dim blnShowDTToCustomer As Boolean
                Dim intIndex As Integer = 0

                'Added by PadmanabhA for whiziblesem version 6 Issue base Email Configuration Issue ID.2338
                Dim strResponsiblePersonEmail As String = ""
                Dim strReportedByPersonEmail As String = ""
                'End Addition
                'added by SavitaS
                Dim intCust As Integer = 1

                '1. Code for String Builder Changes - IssueID - 6052 

                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                blnUseSQL = CType(General.GetApplicationKeySetting("UseSQL"), Boolean)

                lngMessageID = 33 'message for issue

                Try

                    If lngIssueID > 0 Then

                        'get the details of the issue
                        strSQL = "usp_Sel_tbl_IB_Issue  " + lngIssueID.ToString
                        objDr = Data.GetDataReader(strSQL, blnUseSQL)
                        If objDr.Read Then
                            strIssueSummary = objDr("Summary").ToString + ""
                            lngProjectID = CType(objDr("ProjectID"), Long)
                            strProjectIssueType = objDr("Type").ToString + ""
                            strIssueStatus = objDr("Status").ToString + ""
                            blnShowToCustomer = CType(objDr("ShowToCustomer"), Boolean)
                            strResponsiblePersonID = CType(CommonFunctions.Data.CheckIsDBNull(objDr("AssignTO").ToString, ""), String)
                            strReportedBy = CType(CommonFunction.Data.CheckIsDBNull(objDr("ReportedBy"), ""), String)
                            strReportedBy = strReportedBy.Trim
                        Else
                            strIssueSummary = ""
                            lngProjectID = 0
                            strProjectIssueType = ""
                            strIssueStatus = ""
                            blnShowToCustomer = False
                            strResponsiblePersonID = ""
                            strReportedBy = ""
                        End If
                        Data.DisposeDataReader(objDr)

                        'Added by PadmanabhA for whiziblesem version 6 Issue base Email Configuration Issue ID.2338
                        'User Id is taken using reportedBy value
                        objDr = CommonFunction.Data.GetDataReader("Exec usp_sel_tbl_IB_Issue_reportedBy '" + strReportedBy + "'," + CType(lngProjectID, String), blnUseSQL)

                        If objDr.Read Then
                            strReportedByPersonEmail = objDr("EmailID").ToString
                        End If
                        Data.DisposeDataReader(objDr)

                        'Commented and modified by SavitaS on 21 Aug 2006 for whiziblesem SP7  Integration
                        'If strResponsiblePersonEmail <> "" Then
                        If strResponsiblePersonID <> "" Then
                            'End of Commented and modified by SavitaS on 21 Aug 2006 for whiziblesem SP7  Integration
                            ' Commented and modified By MahendraV On 11:49 AM 9/7/2007 For WhizibleSEM 7.1
                            ' To get only Active employee emailID
                            ' Start_MV_9/7/2007
                            ' strResponsiblePersonEmail = CType(CommonFunctions.Data.GetDataScalar("SELECT ISNULL(EmailID,'') FROM tbl_PM_Employee WHERE EmployeeID = " + strResponsiblePersonID, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean)), String)
                            strResponsiblePersonEmail = CType(CommonFunctions.Data.GetDataScalar("SELECT ISNULL(EmailID,'') FROM tbl_PM_Employee WITH ( NOLOCK) WHERE ISNULL(Status,0) = 0 AND EmployeeID = " + strResponsiblePersonID, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean)), String)
                            ' End_MV_9/7/2007
                        End If

                        'End Addition
                        'End Addition

                        If lngProjectID <= 0 Then Exit Sub

                        'get message body and subject
                        strEmailMessage = funcGetEmailMessageForProject(lngProjectID, lngMessageID, strSubject)

                        '2. Code for String Builder Changes - IssueID - 6052 

                        strMessage = New System.Text.StringBuilder("")
                        strEmailSubject = New System.Text.StringBuilder("")
                        strMessage.Append(strEmailMessage)
                        strEmailSubject.Append(strSubject)

                        ' Retrieve information about the Sender.
                        strFromEmailID = ""
                        Call GetSenderInfo(strUserName, strFromEmailID)
                        'strEmailMessage = strEmailMessage.Replace("<SENDER_NAME>", strUserName)
                        strMessage.Replace("<SENDER_NAME>", strUserName)

                        'Retrieve information about the Project.
                        Call GetProjectInfo(lngProjectID, strProjectName, lngMessageID, strCCToEmailID)
                        'strEmailMessage = strEmailMessage.Replace("<PROJECT_NAME>", strProjectName)
                        strMessage.Replace("<PROJECT_NAME>", strProjectName)
                        'strSubject = strSubject.Replace("<PROJECT_NAME>", strProjectName)
                        strEmailSubject.Replace("<PROJECT_NAME>", strProjectName)

                        ' Insert the Issue ID.
                        'strEmailMessage = strEmailMessage.Replace("<ISSUE_ID>", lngIssueID.ToString)
                        strMessage.Replace("<ISSUE_ID>", lngIssueID.ToString)
                        'strSubject = strSubject.Replace("<ISSUE_ID>", lngIssueID.ToString)
                        strEmailSubject.Replace("<ISSUE_ID>", lngIssueID.ToString)

                        ' Insert the Issue Summary.
                        'strEmailMessage = strEmailMessage.Replace("<ISSUE_SUMMARY>", strIssueSummary)
                        strMessage.Replace("<ISSUE_SUMMARY>", strIssueSummary)

                        'get the details of discussion thread
                        strSQL = "usp_Sel_tbl_IB_Discussion " + lngIssueID.ToString
                        objDr = Data.GetDataReader(strSQL, blnUseSQL)
                        While objDr.Read
                            If Not IsDBNull(objDr("UserName")) Then
                                'Added by VidyaJ on 2nd June 2005
                                If intIndex = 0 Then
                                    blnShowDTToCustomer = CType(objDr("ShowToCustomer"), Boolean)
                                End If
                                intIndex = intIndex + 1
                                'End of Addition
                                'Modified By VidyaJ 0n 2nd June 2005
                                If (blnShowToCustomer = False) Or (blnShowDTToCustomer = False) Or (blnShowToCustomer = True And CType(objDr("ShowToCustomer"), Boolean) = True) Then
                                    strDiscussion += "Comment added by " + objDr("UserName").ToString + " On " + Dates.CGetDateTime(CType(objDr("DiscussionDate"), Date)) + vbCrLf
                                    strDiscussion += objDr("Comments").ToString
                                    strDiscussion += vbCrLf + vbCrLf
                                End If

                            End If
                        End While
                        Data.DisposeDataReader(objDr)

                        ' Insert the discussion thread.
                        'strEmailMessage = strEmailMessage.Replace("<DISCUSSION_THREAD>", strDiscussion.Trim)
                        strMessage.Replace("<DISCUSSION_THREAD>", strDiscussion.Trim)

                        ' Get the list of users to whom the mail must be sent.				
                        strMailToEmployeeIDList = ""
                        strMailCCToEmployeeIDList = ""
                        strSQL = "usp_Sel_tbl_IB_IssueBaseMails NULL, " + lngProjectID.ToString + ", '" + General.BuildQueryString(strProjectIssueType) + "', '" + General.BuildQueryString(strIssueStatus) + "'"

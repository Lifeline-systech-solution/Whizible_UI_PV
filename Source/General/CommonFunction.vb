                drTask = CommonFunctions.Data.GetDataReader("Exec usp_Sel_EmployeeEmailAddresses_New " & intProjectEmployeeRoleID, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                If CommonFunctions.General.CheckIsNothing(drTask) <> "" Then

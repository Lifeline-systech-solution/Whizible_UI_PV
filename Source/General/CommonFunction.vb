                                strMailToEmployeeIDList = objDr("MailToEmployeeIDList").ToString + ""
                            End If
                            If Not IsDBNull(objDr("MailCCToEmployeeIDList")) Then
                                strMailCCToEmployeeIDList = objDr("MailCCToEmployeeIDList").ToString + ""
                            End If
                        End If
                        Data.DisposeDataReader(objDr)

                        If strMailCCToEmployeeIDList = "" Then strMailCCToEmployeeIDList = ","

                        strSQL = "usp_Sel_tbl_PM_ProjectTasks_IssueTasks " + lngIssueID.ToString
                        objDr = Data.GetDataReader(strSQL, blnUseSQL)
                        While objDr.Read
                            If Not IsDBNull(objDr("IsActive")) Then
                                blnIsActive = CType(objDr("IsActive"), Boolean)
                            Else
                                blnIsActive = False
                            End If
                            If Not IsDBNull(objDr("IsTaskComplete")) Then
                                blnIsComplete = CType(objDr("IsTaskComplete"), Boolean)
                            Else
                                blnIsComplete = False
                            End If

                            If blnIsActive And Not blnIsComplete Then
                                If InStr(1, strMailToEmployeeIDList, "," + objDr("EmployeeID").ToString + ",") = 0 And InStr(1, strMailCCToEmployeeIDList, "," + objDr("EmployeeID").ToString + ",") = 0 Then
                                    strMailCCToEmployeeIDList += objDr("EmployeeID").ToString + ","
                                End If
                            End If

                        End While
                        Data.DisposeDataReader(objDr)

                        'get the employee email ids
                        If strToEmailID <> "" Then strToEmailID += ";"
                        If strCCToEmailID <> "" Then strCCToEmailID += ";"

                        strSQL = "usp_Sel_tbl_IB_IssueBaseMails_EmployeeList " + lngProjectID.ToString
                        objDr = Data.GetDataReader(strSQL, blnUseSQL)
                        While objDr.Read
                            If Not IsDBNull(objDr("EmailID")) Then
                                'Modified By VidyaJ on 2nd June 2005 - 
                                'Mail Discussion thread to customer only if that Discussion thread is shown to customer


                                'Integrated by MrugajaB for Whiziblesem SP7 Issue ID.4518 on 29th June 2006
                                'Commented and Modified by SavitaS on 25 May 2006 for FourSoft IssueID 2002
                                'If (blnShowToCustomer = True And blnShowDTToCustomer = True And (objDr("ResourceType").ToString.Trim = "C" Or objDr("ResourceType").ToString.Trim = "CC")) Or (blnShowToCustomer = False And (objDr("ResourceType").ToString.Trim = "E" Or objDr("ResourceType").ToString.Trim = "CE")) Then
                                If (blnShowToCustomer = True And (objDr("ResourceType").ToString.Trim = "C" Or objDr("ResourceType").ToString.Trim = "CC")) Or (blnShowDTToCustomer = True And ((objDr("ResourceType").ToString.Trim = "C" Or objDr("ResourceType").ToString.Trim = "CC") Or (objDr("ResourceType").ToString.Trim = "E" Or objDr("ResourceType").ToString.Trim = "CE"))) Then
                                    If (blnShowDTToCustomer = False And objDr("ResourceType").ToString.Trim = "C") Then
                                    Else
                                        If (objDr("ResourceType").ToString.Trim = "C") Then
                                            If InStr(1, strMailToEmployeeIDList, "," + objDr("EmployeeID").ToString.Trim + ",") <> 0 And InStr(1, strToEmailID, objDr("EmailID").ToString) = 0 Then
                                                intCust = 1
                                            End If
                                            If InStr(1, strMailCCToEmployeeIDList, "," + objDr("EmployeeID").ToString + ",") <> 0 And InStr(1, strCCToEmailID, objDr("EmailID").ToString) = 0 Then
                                                intCust = 0
                                            End If
                                        Else
                                            If (objDr("ResourceType").ToString.Trim = "CC" Or objDr("ResourceType").ToString.Trim = "CE") Then
                                                If blnShowDTToCustomer = False Then
                                                Else
                                                    If InStr(1, strMailToEmployeeIDList, "," + objDr("EmployeeID").ToString.Trim + ",") <> 0 And InStr(1, strToEmailID, objDr("EmailID").ToString) = 0 Then
                                                        strToEmailID += objDr("EmailID").ToString + ";"
                                                    End If
                                                    If InStr(1, strMailCCToEmployeeIDList, "," + objDr("EmployeeID").ToString + ",") <> 0 And InStr(1, strCCToEmailID, objDr("EmailID").ToString) = 0 Then
                                                        strCCToEmailID += objDr("EmailID").ToString + ";"
                                                    End If
                                                End If
                                            Else
                                                If InStr(1, strMailToEmployeeIDList, "," + objDr("EmployeeID").ToString.Trim + ",") <> 0 And InStr(1, strToEmailID, objDr("EmailID").ToString) = 0 Then
                                                    strToEmailID += objDr("EmailID").ToString + ";"
                                                End If
                                                If InStr(1, strMailCCToEmployeeIDList, "," + objDr("EmployeeID").ToString + ",") <> 0 And InStr(1, strCCToEmailID, objDr("EmailID").ToString) = 0 Then
                                                    strCCToEmailID += objDr("EmailID").ToString + ";"
                                                End If
                                            End If
                                        End If
                                    End If
                                End If
                                '-------------------------------
                                'Integrated by SavitaS on 25 May 2006 for FourSoft IssueID 2002
                                ''' Purpose : 407 - Foursoft - Auto mails not sent to responsible person 
                                '''                         after entering discussion thread.
                                If ((objDr("ResourceType").ToString.Trim = "E" Or objDr("ResourceType").ToString.Trim = "CE")) Then
                                    If InStr(1, strMailToEmployeeIDList, "," + objDr("EmployeeID").ToString.Trim + ",") <> 0 And InStr(1, strToEmailID, objDr("EmailID").ToString) = 0 Then
                                        strToEmailID += objDr("EmailID").ToString + ";"
                                    End If
                                    If InStr(1, strMailCCToEmployeeIDList, "," + objDr("EmployeeID").ToString + ",") <> 0 And InStr(1, strCCToEmailID, objDr("EmailID").ToString) = 0 Then
                                        strCCToEmailID += objDr("EmailID").ToString + ";"
                                    End If
                                End If
                                'End Integration by SavitaS
                                '------------------------------------------------
                                'End Integration
                            End If
                        End While
                        Data.DisposeDataReader(objDr)

                    End If

                    'Integrated by MrugajaB for Whiziblesem SP7 Issue ID.4518 on 29th June 2006

                    'Commented and added below by SavitaS on 25 May 2006 for FourSoft IssueID 2002
                    'Added by PadmanabhA for whiziblesem version 6 Issue base Email Configuration Issue ID.2338
                    'If (InStr(strCCToEmailID, strReportedByPersonEmail) = 0) And (InStr(strToEmailID, strReportedByPersonEmail) = 0) Then
                    '    strCCToEmailID = strCCToEmailID + ";" + strReportedByPersonEmail
                    'End If

                    'If (InStr(strCCToEmailID, strResponsiblePersonEmail) = 0) And (InStr(strToEmailID, strResponsiblePersonEmail) = 0) Then
                    '    strCCToEmailID = strCCToEmailID + ";" + strResponsiblePersonEmail
                    'End If
                    ' End comment by SavitaS
                    'End addition

                    'End addition
                    'Integrated and Modified by SavitaS on 25 May 2006 for FourSoft IssueID 2002

                    Dim dr As IDataReader
                    Dim strCustEmail As String = ""
                    Dim ReportedBy As Integer
                    Dim strCust As String = ""
                    strCust = "Select tbl_pm_project.CustomerID,tbl_pm_customer.EmailID  from tbl_pm_project,tbl_pm_customer where tbl_pm_project.CustomerID=tbl_pm_customer.Customer and  tbl_pm_project.projectid=" + lngProjectID.ToString

                    dr = CommonFunctions.Data.GetDataReader(strCust, blnUseSQL)
                    If dr.Read Then
                        strCustEmail = CType(CommonFunctions.Data.CheckIsDBNull(dr("EmailID"), ""), String)
                    End If
                    CommonFunctions.Data.DisposeDataReader(dr)

                    strSQL = "Select CustomerID from tbl_PM_Customer where CustomerID in ('" + strReportedBy + "')"
                    dr = Data.GetDataReader(strSQL, blnUseSQL)
                    If dr.Read Then
                        ReportedBy = 1
                    Else
                        ReportedBy = 0
                    End If

                    'Added By AmitJ For CashTech IssueId 5466 => Page crash when saving discussion thread.
                    'If mails are not configured for an issue type,then page crashes while changing status of an issue in the discussion thread.  
                    If strToEmailID Is Nothing Then strToEmailID = ""
                    If strCCToEmailID Is Nothing Then strCCToEmailID = ""
                    'End of Addition By AmitJ
                    'Added and Modified by SavitaS on 29 May 2006  for FourSoft IssueID 2002
                    If (ReportedBy = 1 And blnShowDTToCustomer = False) Then

                        If (InStr(strCCToEmailID, strResponsiblePersonEmail) = 0) And (InStr(strToEmailID, strResponsiblePersonEmail) = 0) Then
                            'Commented and Modified by SavitaS on 22 Aug 2006 for SP7 Integration
                            'strCCToEmailID = strCCToEmailID + ";" + strResponsiblePersonEmail
                            If strToEmailID.ToString <> "" Then
                                strToEmailID = strToEmailID + ";" + strResponsiblePersonEmail
                            Else
                                strToEmailID = strResponsiblePersonEmail
                            End If
                            'End of Commented and Modified by SavitaS on 22 Aug 2006 for SP7 Integration
                        End If
                    Else
                        'Added by PadmanabhA for whiziblesem version 6 Issue base Email Configuration Issue ID.2338
                        If (InStr(strCCToEmailID, strReportedByPersonEmail) = 0) And (InStr(strToEmailID, strReportedByPersonEmail) = 0) Then
                            If intCust = 1 Then
                                If strToEmailID.ToString <> "" Then
                                    strToEmailID = strToEmailID + ";" + strReportedByPersonEmail
                                Else
                                    strToEmailID = strReportedByPersonEmail
                                End If
                            Else
                                If strCCToEmailID.ToString <> "" Then
                                    strCCToEmailID = strCCToEmailID + ";" + strReportedByPersonEmail
                                Else
                                    strCCToEmailID = strReportedByPersonEmail
                                End If
                            End If
                        End If
                        'Commented and added below by SavitaS on 21 aug 2006 for Whiziblesem SP7 Integration
                        'If (InStr(strCCToEmailID, strResponsiblePersonEmail) = 0) And (InStr(strToEmailID, strResponsiblePersonEmail) = 0) Then
                        '    strCCToEmailID = strCCToEmailID + ";" + strResponsiblePersonEmail
                        'End If
                        'End of Commented and added below by SavitaS on 21 aug 2006 for Whiziblesem SP7 Integration
                    End If
                    'End addition

                    'Added by SavitaS on 21 aug 2006 for Whiziblesem SP7 Integration
                    If (InStr(strCCToEmailID, strResponsiblePersonEmail) = 0) And (InStr(strToEmailID, strResponsiblePersonEmail) = 0) Then
                        'Commented and Modified by SavitaS on 22 Aug 2006 for SP7 Integration
                        'strCCToEmailID = strCCToEmailID + ";" + strResponsiblePersonEmail
                        If strToEmailID.ToString <> "" Then
                            strToEmailID = strToEmailID + ";" + strResponsiblePersonEmail
                        Else
                            strToEmailID = strResponsiblePersonEmail
                        End If
                        'End of Commented and Modified by SavitaS on 22 Aug 2006 for SP7 Integration
                    End If
                    'End of Added by SavitaS on 21 aug 2006 for Whiziblesem SP7 Integration

                    'Addition by SuchitraP on 3-Apr-2009 for IssueID : 29781
                    'Purpose : Create a Issue by a RES R1, and post a DT against the same. The Mailer "To" list was going blank.
                    '           However, if posted by any other Project Resource, the Mail was fired properly.
                    If (InStr(strToEmailID, strResponsiblePersonEmail) = 0) Then
                        If strToEmailID.ToString <> "" Then
                            If (InStr(strCCToEmailID, strResponsiblePersonEmail) = 0) Then
                                strToEmailID = strToEmailID + ";" + strResponsiblePersonEmail
                            End If
                        Else
                            strToEmailID = strResponsiblePersonEmail
                        End If
                    End If
                    'End of addition by SuchitraP 

                    If (blnShowDTToCustomer = True) Then
                        If CType(HttpContext.Current.Session("LoginType"), String) <> "C" Then
                            If ReportedBy <> 1 Then
                                If intCust = 1 Then
                                    If strToEmailID.ToString <> "" Then
                                        If (InStr(strToEmailID, strCustEmail) = 0) And (InStr(strCCToEmailID, strCustEmail) = 0) Then
                                            'Modified By VarunA on 6-July-2009 RequestID-21492
                                            'Purpose : To have semicolon when show to customer is on.
                                            'strToEmailID = strToEmailID + strCustEmail
                                            strToEmailID = strToEmailID + ";" + strCustEmail
                                            'End By VarunA on 6-July-2009 RequestID-21492
                                        End If
                                    Else
                                        strToEmailID = strCustEmail
                                    End If
                                Else
                                    If strCCToEmailID.ToString <> "" Then
                                        If (InStr(strToEmailID, strCustEmail) = 0) And (InStr(strCCToEmailID, strCustEmail) = 0) Then
                                            'Modified By VarunA on 6-July-2009 RequestID-21492
                                            'Purpose : To have semicolon when show to customer is on.
                                            'strCCToEmailID = strCCToEmailID + strCustEmail
                                            strCCToEmailID = strCCToEmailID + ";" + strCustEmail
                                            'End By VarunA on 6-July-2009 RequestID-21492
                                        End If
                                    Else
                                        strCCToEmailID = strCustEmail
                                    End If
                                End If
                            End If
                        End If
                    End If
                    'End Integration by SavitaS
                    'End Integration
                    'End addition
                Catch ex As Exception
                    Err.Raise(Err.Number, "CommonFunctions->EmailMessages->GetEmailMessage_33", ex.Message)
                End Try

                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
            End Sub

            '=====================================================================
            ' Procedure Name		:	GetEmailMessage_14 (NEW ISSUE ASSIGNMENT)
            ' Parameters Passed     :	strToEmailID		:- The EmailID of the person to whom the message will be returned.
            '							strSubject			:- The Subject of the Email Message.
            '							strEmailMessage		:- The body of the Email Message.
            '							intIssueID			:- The ID of the Issue Assigned to the employee.
            '							strEmployeeIDList	:- The ID of the employee to whom the Issue has been assigned.
            ' Returns               :	No return values.
            ' Parameters Affected   :	strToEmailID, strSubject, strEmailMessage :- These values are returned by the subroutine by reference.
            ' Description           :	Generate the email message as defined in the System Email Messages table in the database.
            ' Purpose               :	Generate the email message as defined in the System Email Messages table in the database.
            ' Assumptions           :	The message ID exists in the database.
            '							The message does not contain any other parameters besides the following :
            '								1.	<NAME>
            '								2.	<SENDER_NAME>
            '								3.	<PROJECT_NAME> 
            '								4.	<TASK_NAME>
            '								5.	<ISSUE_ID>
            ' Dependencies          :	None.
            ' Author                :	RajaniR
            ' Created               :	21st November 2001
            ' Revisions             :	Modified By RajaniR on 26th August 2002.
            '								Changed the function to accept multiple Employee IDs.
            '								Changed the last parameter from intEmployeeID -> strEmployeeIDList.
            ' Revision              :   Converted to VB.NET.
            ' Revised By            :   SachinR
            ' Revised On            :   16 Feb 2004
            ' Purpose               :   This procedure was originally written in VB6.0 which is here converted to VB.NET (7.0)
            '                           No logic is changed here from the original.
            '=====================================================================		
            Public Shared Sub GetEmailMessage_14(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal lngIssueID As Long, ByVal strEmployeeIDList As String)
                Dim strUserName As String
                Dim strProjectName As String
                Dim objDrReceiver As IDataReader
                Dim objDrIssue As IDataReader
                Dim objDrTask As IDataReader
                Dim lngTaskID As Long
                Dim lngProjectID As Long
                Dim lngMessageID As Long
                Dim lngEmployeeID As Long
                Dim intCtr As Integer
                Dim strTempArray() As String
                Dim strReceiverList As String
                Dim strEmailID As String
                'Code Commented By DipaliS 19 July 2004 for Issue 11988 and added following
                'Dim lngCustomerIssueID As Long
                Dim strCustomerIssueID As String
                'End addition by DipaliS
                Dim strSQL As String
                Dim blnUseSQL As Boolean

                '1. Code for String Builder Changes - IssueID - 6052 

                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder


                blnUseSQL = CType(General.GetApplicationKeySetting("UseSQL"), Boolean)
                lngMessageID = 14

                strToEmailID = ""
                strTempArray = Split(strEmployeeIDList, ",")
                For intCtr = 0 To strTempArray.Length - 1
                    If strTempArray(intCtr).Trim <> "" Then

                        lngEmployeeID = CType(strTempArray(intCtr).Trim, Long)

                        ' Retrieve information about the RECEIVER.
                        strSQL = "usp_tbl_Sel_EmployeeInfo " + strTempArray(intCtr).Trim
                        objDrReceiver = Data.GetDataReader(strSQL, blnUseSQL)
                        If objDrReceiver.Read Then
                            ' Get the Email ID of the resource.
                            strToEmailID += Data.CheckIsDBNull(objDrReceiver("EmailID"), "").ToString + ";"

                            ' Get the name of the resource.
                            strReceiverList += objDrReceiver("UserName").ToString + ","
                        End If
                        Data.DisposeDataReader(objDrReceiver)
                    End If
                Next

                If strReceiverList <> "" Then
                    strReceiverList = Left(strReceiverList, InStrRev(strReceiverList, ",") - 1)
                End If

                'Retrieve the associated TaskID for the Issue.	
                strSQL = "usp_Sel_IB_GetAssociatedTaskIDForIssue " + lngIssueID.ToString + "," + lngEmployeeID.ToString
                objDrIssue = Data.GetDataReader(strSQL, blnUseSQL)
                If objDrIssue.Read Then
                    lngTaskID = CType(Data.CheckIsDBNull(objDrIssue("TaskID"), "0"), Long)
                    lngProjectID = CType(Data.CheckIsDBNull(objDrIssue("ProjectID"), "0"), Long)
                End If
                Data.DisposeDataReader(objDrIssue)

                ' Get the message body, and subject.
                strEmailMessage = funcGetEmailMessageForProject(lngProjectID, lngMessageID, strSubject)

                '2. Code for String Builder Changes - IssueID - 6052 

                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                ' Insert the receiver list in the mail body.
                strMessage.Replace("<NAME>", strReceiverList)

                strMessage.Replace("<ISSUE_ID>", lngIssueID.ToString)
                strEmailSubject.Replace("<ISSUE_ID>", lngIssueID.ToString)


                ' Retrieve information about the Project.
                Call GetProjectInfo(lngProjectID, strProjectName, lngMessageID, strCCToEmailID)
                strMessage.Replace("<PROJECT_NAME>", strProjectName)
                strEmailSubject.Replace("<PROJECT_NAME>", strProjectName)

                'A CC needs to be sent to the Responsible Person as well.
                strSQL = "Exec usp_Sel_tbl_IB_Issue " + lngIssueID.ToString
                objDrIssue = Data.GetDataReader(strSQL, blnUseSQL)
                If objDrIssue.Read Then
                    If Not IsDBNull(objDrIssue("AssignTo")) Then
                        Call GetEmployeeInfo(CType(objDrIssue("AssignTo"), Long), strUserName, strEmailID)
                        If strEmailID <> "" Then
                            If InStr(1, strToEmailID, strEmailID) = 0 And InStr(1, strCCToEmailID, strEmailID) = 0 Then
                                strCCToEmailID += ";" + strEmailID
                            End If
                        End If
                    End If
                    'Get the Customer Issue ID
                    'Code Commented By DipaliS 19 July 2004 and added following
                    'lngCustomerIssueID = CType(Data.CheckIsDBNull(objDrIssue("CustomerIssueID"), "0").ToString, Long)
                    strCustomerIssueID = Data.CheckIsDBNull(objDrIssue("CustomerIssueID"), "0").ToString
                End If
                Data.DisposeDataReader(objDrIssue)

                'Code Commented By DipaliS 19 July 2004 and added following
                'If lngCustomerIssueID > 0 Then
                If strCustomerIssueID <> "0" Then
                    'Code Commented By DipaliS 19 July 2004 and added following
                    'strSubject = strSubject.Replace("<CUSTOMER_ISSUE_ID>", "; Customer Issue ID: " + lngCustomerIssueID.ToString + "")
                    'strSubject = strSubject.Replace("<CUSTOMER_ISSUE_ID>", "; Customer Issue ID: " + strCustomerIssueID + "")
                    strEmailSubject.Replace("<CUSTOMER_ISSUE_ID>", "; Customer Issue ID: " + strCustomerIssueID + "")

                Else
                    'strSubject = strSubject.Replace("<CUSTOMER_ISSUE_ID>", "")
                    strEmailSubject.Replace("<CUSTOMER_ISSUE_ID>", "")
                End If

                'Code Commented By DipaliS 19 July 2004 and added following
                'If lngCustomerIssueID > 0 Then
                If strCustomerIssueID <> "0" Then
                    'Code Commented By DipaliS 19 July 2004 and added following
                    'strEmailMessage = strEmailMessage.Replace("<CUSTOMER_ISSUE_ID>", "Customer Issue ID : " + lngCustomerIssueID.ToString + "")
                    'strEmailMessage = strEmailMessage.Replace("<CUSTOMER_ISSUE_ID>", "Customer Issue ID : " + strCustomerIssueID + "")
                    strMessage.Replace("<CUSTOMER_ISSUE_ID>", "Customer Issue ID : " + strCustomerIssueID + "")
                Else
                    'strEmailMessage = strEmailMessage.Replace("<CUSTOMER_ISSUE_ID>", "")
                    strMessage.Replace("<CUSTOMER_ISSUE_ID>", "")
                End If

                ' Retrieve information about the Sender.
                Call GetSenderInfo(strUserName, strFromEmailID)
                'strEmailMessage = strEmailMessage.Replace("<SENDER_NAME>", strUserName)
                strMessage.Replace("<SENDER_NAME>", strUserName)

                ' If the Issue ID is not specified, or Task is missing, then exit the subroutine.
                If lngIssueID <= 0 Or lngTaskID <= 0 Then
                    Exit Sub
                End If

                ' Retrieve the task details.
                strSQL = "usp_Sel_tbl_PM_ProjectTasks " + lngProjectID.ToString + "," + lngTaskID.ToString
                objDrTask = Data.GetDataReader(strSQL, blnUseSQL)
                If objDrTask.Read Then
                    'strEmailMessage = strEmailMessage.Replace("<TASK_NAME>", objDrTask("TaskName").ToString + "")
                    strMessage.Replace("<TASK_NAME>", objDrTask("TaskName").ToString + "")
                End If
                Data.DisposeDataReader(objDrTask)
                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
            End Sub

            'Added by MrugajaB for WhizibleSEM SP7
            'Code Commented & Added By PradipK on 8-June-2006
            'Purpose:To Check ShowToCustomer condition from Discussion Thread(DT) table if Mail is from DT.
            'Public Shared Sub GetEmailMessage_34(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal intIssueID As Long)
            Public Shared Sub GetEmailMessage_34(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal intIssueID As Long, Optional ByVal strFrom As String = "")
                'End Addition By PradipK on 8-June-2006
                'End Addition  
                '=====================================================================
                ' Procedure Name		:	GetEmailMessage_34 (ISSUE STATUS CHANGED.)
                ' Parameters Passed     :	strFromEmailID	:- The Mail ID of the sender.

                Dim strUserName As String
                Dim strProjectName As String
                Dim drReader As IDataReader
                Dim strToUserName As String

                '1. Code for String Builder Changes - IssueID - 6052 

                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                ' Get the message body, and subject.
                strEmailMessage = funcGetEmailMessageForProject(0, 12, strSubject)

                '2. Code for String Builder Changes - IssueID - 6052 

                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                Call GetSenderInfo(strUserName, strFromEmailID)
                strCCToEmailID = strFromEmailID
                strMessage.Replace("<SENDER_NAME>", strUserName)

                ' Get the Email ID, and Name of the User ( Employee / Customer ).
                If strUserType = "E" Then
                    drReader = CommonFunction.Data.GetDataReader("SELECT * FROM tbl_PM_Employee WHERE EmployeeID = " + intUserID.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                    If drReader.Read Then
                        strToEmailID = CommonFunction.Data.CheckIsDBNull(drReader("EmailID")).ToString
                        strToUserName = CommonFunction.Data.CheckIsDBNull(drReader("UserName")).ToString
                    End If
                ElseIf strUserType = "C" Then
                    drReader = CommonFunction.Data.GetDataReader("SELECT * FROM tbl_PM_Customer WHERE Customer = " + intUserID.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                    If drReader.Read Then
                        strToEmailID = CommonFunction.Data.CheckIsDBNull(drReader("EmailID")).ToString
                        strToUserName = CommonFunction.Data.CheckIsDBNull(drReader("CustomerName")).ToString
                    End If
                End If
                'code added by SajiU on 13 Dec 2006
                Dim strMsg As String = ""
                Dim I As Integer = HttpContext.Current.Request.Url.ToString.IndexOf("Source")

                ''Commented And Added By Vaijat K On 23/10/2015
                ''strMsg = HttpContext.Current.Request.Url.ToString.Substring(0, I - 1) + "/Default.aspx"
                'Modified By Chakshuta H on 28th-Oct-2015 Purpose::to handle null(CommonFunction.Data.CheckIsDBNull())
                ''Commented By Vidya Jadhav ON 24 Nov 2016 For Euornet NextGen Upgrade Purpose:For Site URL Issue

                Dim ActionType As String = CommonFunction.Data.CheckIsDBNull(CommonFunction.Data.GetDataScalar("Select S.ActionType From tbl_PM_CompanyInformation C Left Join tbl_CNF_SiteDetailsActionMaster S ON C.ActionType=S.ID WHERE C.CompanyInfoID=1", True), "")
                If ActionType = "Default" Then
                    strMsg = HttpContext.Current.Request.Url.ToString.Substring(0, I - 1) + "/Default.aspx"
                ElseIf ActionType = "Dynamic" Then
                    strMsg = CommonFunction.Data.GetDataScalar("Select SiteEmailID From tbl_PM_CompanyInformation WHERE CompanyInfoID=1", True)
                ElseIf ActionType = "None" Then
                    strMsg = ""
                End If

                ''End Of Commented By Vidya Jadhav ON 24 Nov 2016 For Euornet NextGen Upgrade Purpose:For Site URL Issue

                'Dispose the data reader

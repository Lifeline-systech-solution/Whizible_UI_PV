            Public Shared Sub GetEmailMessage_441(ByVal strEmployeeID As String, ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal intProjectID As Integer, ByVal strApprovalStatus As String, ByVal intRevisionReasonID As Integer)
                '=====================================================================
                ' Procedure Name        :	GetEmailMessage_441
                ' Parameters Passed     :   strEmployeeID	    :- Employee ID (Approver ID) to whom the message needs to be sent
                '							strToEmailID        :- The EmailID of the person to whom the message will be returned.
                '                           strSubject          :- The Subject of the Email Message.
                '                           strEmailMessage     :- The body of the Email Message.
                '                           intProjectID        :- Project ID
                '                           strApprovalStatus   :- Approval Status (approved / rejected)
                ' Returns               :
                ' Parameters Affected   :   strToEmailID, strSubject, strEmailMessage :- These values are returned by the subroutine by reference.
                ' Description           :   Generate the email message as defined in the System Email Messages 
                '							table in the database for the Project that is being sent for approval.
                ' Assumptions           :   The message ID exists in the database.
                ' Dependencies          :	None
                ' Author                :	ShamkantD
                ' Created               :	30 Sep 2004
                ' Revisions             :	
                '=====================================================================
                Dim blnUseSQL As Boolean = CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean)
                Dim intMessageID As Integer, strUserName As String
                Dim strListOfEmailIDs As String
                Dim drEmailMessage As IDataReader, drEmployeeDetails As IDataReader, drProjectInformation As IDataReader
                Dim strProjectDetails As String = ""
                Dim strApproverComments As String = ""
                Dim strQuery As String = ""
                Dim strApprovalStatusText As String = ""
                Dim intBusinessGroupID As Integer = 0
                Dim intLocationID As Integer = 0
                Dim strCCIDs As String = ""
                Dim drApprovers As IDataReader

                '1. Code for String Builder Changes - IssueID - 6052 
                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                If strApprovalStatus = "A" Then
                    strApprovalStatusText = "approved"
                Else
                    strApprovalStatusText = "rejected"
                End If

                intMessageID = 441

                ' Get the message body, and subject.
                drEmailMessage = CommonFunction.Data.GetDataReader("EXEC usp_Sel_tbl_PM_EmailMessages " & intMessageID, blnUseSQL)
                If drEmailMessage.Read Then
                    strEmailMessage = CType(CommonFunction.Data.CheckIsDBNull(drEmailMessage("Body"), ""), String).Trim
                    strSubject = CType(CommonFunction.Data.CheckIsDBNull(drEmailMessage("Subject"), ""), String).Trim
                End If

                '2. Code for String Builder Changes - IssueID - 6052 
                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                Call GetSenderInfo(strUserName, strFromEmailID)
                strMessage.Replace("<SENDER_NAME>", strUserName)

                'Replace the place holders
                strEmailSubject.Replace("<APPROVAL_STATUS>", strApprovalStatusText)
                strMessage.Replace("<APPROVAL_STATUS>", strApprovalStatusText)

                'Get the approver's comments
                strQuery = "EXEC usp_Sel_PM_Project_Baseline_Revision_Rejection_Reason " & intRevisionReasonID.ToString() & ",'" & Left(strApprovalStatus.Trim().ToUpper(), 1) & "'"
                strApproverComments = CommonFunction.General.CheckIsNothing(CommonFunction.Data.CheckIsDBNull(CommonFunction.Data.GetDataScalar(strQuery, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean)), ""), "").ToString()
                'Replace the place holders
                strMessage.Replace("<APPROVER_COMMENTS>", strApproverComments)

                'Get the To Name and Email Address
                drEmployeeDetails = CommonFunction.Data.GetDataReader("EXEC usp_tbl_Sel_EmployeeInfo " & strEmployeeID, blnUseSQL)

                If drEmployeeDetails.Read Then
                    strMessage.Replace("<NAME>", CType(CommonFunction.Data.CheckIsDBNull(drEmployeeDetails("EmployeeName"), ""), String).Trim)

                    If CType(CommonFunction.Data.CheckIsDBNull(drEmployeeDetails("EmailID"), ""), String).Trim <> "" Then
                        strToEmailID = CType(CommonFunction.Data.CheckIsDBNull(drEmployeeDetails("EmailID"), ""), String).Trim
                    Else
                        strToEmailID = ""
                    End If
                End If

                'Get the Project information
                strProjectDetails = ""
                drProjectInformation = CommonFunction.Data.GetDataReader("EXEC usp_Sel_tbl_PM_Project " & intProjectID.ToString(), blnUseSQL)
                If drProjectInformation.Read Then
                    strProjectDetails &= "Project Code" & vbTab & ": " & CType(CommonFunction.Data.CheckIsDBNull(drProjectInformation("ProjectCode"), ""), String) & vbCrLf
                    strProjectDetails &= "Abbreviated Name" & vbTab & ": " & CType(CommonFunction.Data.CheckIsDBNull(drProjectInformation("ShortJobTitle"), ""), String) & vbCrLf
                    strProjectDetails &= "Project Name" & vbTab & ": " & CType(CommonFunction.Data.CheckIsDBNull(drProjectInformation("ProjectName"), ""), String) & vbCrLf

                    'Added by ShamkantD on 21 Nov 2004
                    'Get Business Group ID and Location ID
                    intBusinessGroupID = CType(CommonFunction.Data.CheckIsDBNull(drProjectInformation("BusinessGroupID"), "0"), Integer)
                    intLocationID = CType(CommonFunction.Data.CheckIsDBNull(drProjectInformation("LocationID"), "0"), Integer)
                    'End of addition - ShamkantD on 21 Nov 2004

                    strEmailSubject.Replace("<PROJECT_NAME>", CType(CommonFunction.Data.CheckIsDBNull(drProjectInformation("ProjectName"), ""), String))
                End If

                'Added by ShamkantD on 21 Nov 2004
                'Issue ID 14092
                'Added by TruptiK for hexaware requestno 2447
                'Modified By JyotiG
                'Issue ID : 5687
                strQuery = "usp_Sel_tbl_PM_Employee_Approvers " & intBusinessGroupID.ToString() & "," & intLocationID.ToString() & "," & intProjectID.ToString()
                'strQuery = "usp_Sel_tbl_PM_Employee_Approvers " & intBusinessGroupID.ToString() & "," & intLocationID.ToString()
                'end of addition by TruptuK

                drApprovers = CommonFunction.Data.GetDataReader(strQuery, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))

                While drApprovers.Read
                    Dim strEmpID As String = ""
                    Dim strName As String = ""
                    Dim strEmail As String = ""
                    strEmpID = CommonFunction.Data.CheckIsDBNull(drApprovers("EmployeeID"), "0").ToString

                    'Get the To Name and Email Address
                    'Modified By VidyaJ - IssueID - 11175
                    ' drEmployeeDetails = CommonFunction.Data.GetDataReader("EXEC usp_tbl_Sel_EmployeeInfo " & strEmpID, blnUseSQL)

                    ' If drEmployeeDetails.Read Then
                    If CType(CommonFunction.Data.CheckIsDBNull(drApprovers("UserName"), ""), String).Trim() <> CType(CommonFunction.Data.CheckIsDBNull(drApprovers("SendForApprovalBy"), ""), String).Trim Then

                        strName = CType(CommonFunction.Data.CheckIsDBNull(drApprovers("EmployeeName"), ""), String).Trim()
                        If CType(CommonFunction.Data.CheckIsDBNull(drApprovers("EmailID"), ""), String).Trim <> "" Then
                            strEmail = CType(CommonFunction.Data.CheckIsDBNull(drApprovers("EmailID"), ""), String).Trim
                        Else
                            strEmail = ""
                        End If
                        'End If
                        If strEmail <> "" Then
                            strCCIDs += strEmail + ";"
                        End If
                    End If
                End While

                strCCToEmailID = strCCIDs
                'End of addition - ShamkantD on 21 Nov 2004

                'Replace the place holders
                strMessage.Replace("<PROJECT_INFORMATION>", strProjectDetails)

                ' Modified by NitinVS on 18 Aug 2005 for WhizibleSEM SP4 IssueID 20745
                CommonFunction.Data.DisposeDataReader(drApprovers)
                ' End Modification by NitinVS on 18 Aug 2005 for WhizibleSEM SP4 IssueID 20745

                CommonFunction.Data.DisposeDataReader(drEmailMessage)
                CommonFunction.Data.DisposeDataReader(drEmployeeDetails)
                CommonFunction.Data.DisposeDataReader(drProjectInformation)

                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
            End Sub


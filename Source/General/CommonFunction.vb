                CommonFunction.Data.DisposeDataReader(drTemp)
                strCCToEmailID &= strFromEmailID
                'Added By JayavantK, On - 25-Aug-2004 - End

                'Commented By JayavantK, On 25-Aug-2004 - Start
                '' Added By JayavantK on 25-Jun-2004 - End
                'strCCToEmailID = ""
                'strQuery = "usp_Sel_GetCcEmailIDs_ResourceAllocation " & intRequestID.ToString()
                'strQuery &= ", " & CommonFunctions.General.CheckIsNothing(HttpContext.Current.Session("intUserID"), "0")
                'drTemp = CommonFunctions.Data.GetDataReader(strQuery, blnUseSQL)
                'If CommonFunctions.General.CheckIsNothing(drTemp, "") <> "" Then
                '    While drTemp.Read()
                '        strCCToEmailID &= CommonFunctions.General.CheckIsNothing(drTemp("EmailID"), "") & ","
                '    End While
                'End If
                'CommonFunctions.Data.DisposeDataReader(drTemp)
                'strCCToEmailID &= strFromEmailID
                '' Added By JayavantK on 25-Jun-2004 - End
                'Commented By JayavantK, On 25-Aug-2004 - End

                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
            End Sub

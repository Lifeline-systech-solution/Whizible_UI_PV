        Public Shared Sub CreateLog(ByVal fileText As String, ByVal filePrefix As String)
            Dim m_strErrFilePath As String = CommonFunctions.FileDirectory.CleanPath(Microsoft.VisualBasic.Left(AppDomain.CurrentDomain.BaseDirectory, Len(AppDomain.CurrentDomain.BaseDirectory))) + " Attachments\"
            Dim ERROR_PREFIX As String = "QueryScheduler_ERROR_"
            Dim QS_LOG As String = "Log"

            m_strErrFilePath = m_strErrFilePath.Replace("\MailLog", "")
            If Not CommonFunctions.FileDirectory.IsDirectoryExists(m_strErrFilePath & QS_LOG) Then
                CommonFunctions.FileDirectory.CreateDirectory(m_strErrFilePath, QS_LOG)
            End If

            CommonFunctions.FileDirectory.WriteFileStream(m_strErrFilePath & QS_LOG, CommonFunctions.FileDirectory.GetLogFileName(filePrefix), fileText)
            CommonFunctions.FileDirectory.CleanPath(m_strErrFilePath & QS_LOG & "\" & CommonFunctions.FileDirectory.GetLogFileName(filePrefix))
        End Sub
        Public Shared Function SendEmailSSLCompatible(ByVal mail As MyMessage, ByVal isWithCC As Boolean, ByVal isWithBCC As Boolean, ByRef successMessage As String) As String
            '============================================================================
            'Procedure Name		: SendEmailSSLCompatible
            'Description		: Send mail with SSl Compatible settings....
            '					 
            '					 
            'Return Values		: None
            'Author				: AMIT MAHADIK
            'Created			: 30 MAR 2011
            '============================================================================
            Dim Context As HttpContext = HttpContext.Current
            Try

                ''Commented and Added For SSL Mail Sending for version 4.0
                'Dim Message As New CDO.MessageClass
                'Dim iConf As New CDO.ConfigurationClass
                Dim Message As New CDO.Message
                Dim iConf As New CDO.Configuration
                'Commented For SSL Mail Sending for version 4.0
                iConf.Fields(CDO.CdoConfiguration.cdoSendUsingMethod).Value = CDO.CdoSendUsing.cdoSendUsingPort
                iConf.Fields(CDO.CdoConfiguration.cdoSMTPServerPort).Value = mail.Port.ToString()
                iConf.Fields(CDO.CdoConfiguration.cdoSMTPServer).Value = mail.SMTPServer
                iConf.Fields(CDO.CdoConfiguration.cdoSMTPAuthenticate).Value = CDO.CdoProtocolsAuthentication.cdoBasic
                iConf.Fields(CDO.CdoConfiguration.cdoSendUserName).Value = mail.UseName
                iConf.Fields(CDO.CdoConfiguration.cdoSendPassword).Value = mail.Password
                iConf.Fields(CDO.CdoConfiguration.cdoSMTPUseSSL).Value = mail.IsSSLEnabled
                iConf.Fields.Update()
                Message.Configuration = iConf
                Message.AutoGenerateTextBody = True
                Message.From = mail.FromEmailID
                Message.To = mail.ToEmailID

                If isWithCC Then
                    Message.CC = mail.CCEmailID
                End If
                If isWithBCC Then
                    Message.BCC = mail.BCCEmailID
                End If
                Message.Subject = mail.Subject
                If mail.IsBodyHtml Then
                    Message.HTMLBody = mail.EmailBody
                Else
                    Message.TextBody = mail.EmailBody
                End If

                Message.Send()
                successMessage = "SUCCESS"

                '''''***********************************ADDED BY AMIT MAHADIK ON 08 APRIL 2011 ***********************************
                Return ""
                '''''***********************************END ADDED BY AMIT MAHADIK ON 08 APRIL 2011 ***********************************


            Catch ex As Exception
                '''''***********************************ADDED BY AMIT MAHADIK ON 08 APRIL 2011 ***********************************
                Return ex.Message
                '''''***********************************END ADDED BY AMIT MAHADIK ON 08 APRIL 2011 ***********************************

                successMessage = "ERROR"
                Dim args As Email_ErrorInfo
                With args
                    .SMTPServer = CommonFunctions.General.CheckIsNothing(CommonFunctions.Application.SMTPServer)
                    .SMTPServer_InstallationType = ""
                    .SMTPServerPort = CommonFunctions.General.CheckIsNothing(CommonFunctions.Application.SMTPServerPort)
                End With
                Call LogError(ex, args)
                args = Nothing
                Context.Session("Mail_strToEmailID") = mail.ToEmailID
                Context.Session("Mail_strSubject") = mail.Subject
                Context.Session("Mail_strEmailMessage") = mail.EmailBody

            Finally

            End Try
        End Function

        Public Shared Sub GetFromAndToDates(ByVal strFlag As String, ByRef dtmFromDate As String, ByRef dtmToDate As String, ByVal dtmCustomDate As String)
            '#### NOTE: THIS FUNCTION Will Go Into Application's CommonFunctions ####
            '=====================================================================
            ' Procedure Name		:	GetFromAndToDates
            ' Purpose				:	To Retrieve the Date Range for the specified custom period.
            ' Description			:	Same as above.
            ' Parameters Passed		:	intFlag		:- Flag for the available custom periods.
            '								1 : This Week
            '								2 : Previous week
            '								3 : This Month
            '								4 : Previous Month
            '								5 : (This Financial Year)Year To Date 
            '								6 : This Quarter
            '								7 : Previous Quarter
            '								8 : Previous Financial Year
            '								9 : Next Month( Not used)*****
            '								10 : Year Start Date to year End date	
            '							dtmFromDate :- The From Date will be returned in this varaible.
            '							dtmToDate	:- The To Date will be returned in this varaible.
            '							dtmCustomDate : The date specified.
            ' Parameters Affected	:	dtmFromDate, dtmToDate			
            ' Returns				:	No return Values.
            ' Assumptions			:
            ' Dependencies			:
            ' Author				:	RajaniR
            ' Created				:	Wednesday, February 06, 2002 15:35
            ' Revisions				:   SuryabirD, Feb 5, 2004
            '=====================================================================
            Dim cmdDateRange As New SqlClient.SqlCommand
            'Try

            cmdDateRange.CommandType = CommandType.StoredProcedure

            If Trim(dtmCustomDate & "") <> "" Then
                cmdDateRange.CommandText = "usp_GetFromAndToDates_ForSpecificDate"
            Else
                cmdDateRange.CommandText = "usp_GetFromAndToDates"
            End If

            '-- Adding Parameters
            cmdDateRange.Parameters.Add(New SqlClient.SqlParameter("@intFlag", SqlDbType.Int))
            cmdDateRange.Parameters("@intFlag").Value = CType(strFlag, Integer)

            cmdDateRange.Parameters.Add(New SqlClient.SqlParameter("@FromDate", SqlDbType.DateTime))
            cmdDateRange.Parameters("@FromDate").Direction = ParameterDirection.Output

            cmdDateRange.Parameters.Add(New SqlClient.SqlParameter("@ToDate", SqlDbType.DateTime))
            cmdDateRange.Parameters("@ToDate").Direction = ParameterDirection.Output

            If Trim(dtmCustomDate & "") <> "" Then
                cmdDateRange.Parameters.Add(New SqlClient.SqlParameter("@CustomDate", SqlDbType.DateTime))
                cmdDateRange.Parameters("@CustomDate").Value = CType(dtmCustomDate, DateTime)
            End If

            'Execute the Command and get the Command object
            cmdDateRange = CommonFunction.Data.GetSQLCommandExecute(cmdDateRange, CType(CommonFunctions.General.GetApplicationKeySetting("UseSQL"), Boolean))

            dtmFromDate = cmdDateRange.Parameters("@FromDate").Value.ToString 'CommonFunctions.Data.GetSQLCommandExecute(cmdDateRange.Parameters("@FromDate"))
            dtmToDate = cmdDateRange.Parameters("@ToDate").Value.ToString

            cmdDateRange.Dispose()
            cmdDateRange = Nothing

        End Sub


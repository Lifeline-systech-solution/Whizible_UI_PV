            Public Shared Sub GetEmailMessage_438(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal lngDeliverableID As Long, ByVal lngDiscussionID As Long, ByVal intShow As Int16)
                '=====================================================================
                ' Procedure Name		:	GetEmailMessage_432 (Deliverables DISCUSSION THREAD.)
                ' Parameters Passed     :	strFromEmailID	:- The Mail ID of the sender.
                '							strToEmailID	:- The EmailID of the person to whom the message will be returned.
                '							strCCToEmailID	:- The EmailID's of the people to whom the CC must be sent.
                '							strSubject		:- The Subject of the Email Message.
                '							strEmailMessage	:- The body of the Email Message.			
                '							lngDeliverableID:- The Deliverable ID.
                '							lngDiscussionID :- The Deliverable Discussion ID.
                ' Returns               :	
                ' Parameters Affected   :	strFromEmailID, strToEmailID, strCCToEmailID, strSubject, strEmailMessage :- These values are returned by the subroutine by reference.
                ' Description           :	Generate the email message as defined in the System Email Messages table in the database.
                ' Purpose               :	Generate the email message as defined in the System Email Messages table in the database.
                ' Assumptions           :	The message ID exists in the database.
                '							The message does not contain any other parameters besides the following :
                '								1.	<NAME>
                '								2.	<SENDER_NAME>
                '								3.	<SR_CODE> 
                '								4.	<PROJECT_NAME>
                ' Dependencies          :	None.
                ' Author                :	NileshD
                ' Created               :	July 09, 2004 
                ' Revisions             :   Copied by SachinR from PBNIT41 on 20 Aug 2004 for deliverable discussion thread
                '                           email message.Modified for Deliverable discussion thread mail.
                '=====================================================================		

                Dim blnUseSQL As Boolean
                Dim lngMessageID As Long
                Dim drEmailMessage As IDataReader
                Dim drDiscussionDetails As IDataReader
                Dim drEmailID As IDataReader
                Dim drType As IDataReader
                Dim drStatus As IDataReader
                Dim strDiscussion As String
                Dim strMailToEmployeeIDList As String = ""
                Dim strMailCCToEmployeeIDList As String = ""
                Dim strType As String
                Dim strStatus As String
                Dim strSQL As String
                Dim lngUserid As Long

                blnUseSQL = CType(General.GetApplicationKeySetting("UseSQL"), Boolean)

                '1. Code for String Builder Changes - IssueID - 6052 
                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                lngMessageID = 438 'message for Discussion Thread for SR

                Try
                    ' Get the message body, and subject.
                    drEmailMessage = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_EmailMessages " + lngMessageID.ToString, blnUseSQL)
                    If drEmailMessage.Read Then
                        strEmailMessage = CommonFunction.Data.CheckIsDBNull(drEmailMessage("Body")).ToString
                        strSubject = CommonFunction.Data.CheckIsDBNull(drEmailMessage("Subject")).ToString
                    End If
                    drEmailMessage.Close()
                    CommonFunction.Data.DisposeDataReader(drEmailMessage)


                    '2. Code for String Builder Changes - IssueID - 6052 
                    strMessage = New System.Text.StringBuilder("")
                    strEmailSubject = New System.Text.StringBuilder("")
                    strMessage.Append(strEmailMessage)
                    strEmailSubject.Append(strSubject)

                    'Get the senders name and emailid
                    If HttpContext.Current.Session("LoginType").ToString <> "C" Then
                        'if not customer login then get from employee table
                        drEmailID = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_Deliverable_Discussions_EmailID " + lngDiscussionID.ToString, blnUseSQL)
                        If drEmailID.Read Then
                            strMessage.Replace("<SENDER_NAME>", drEmailID("UserName").ToString)
                            strFromEmailID = drEmailID("EmailID").ToString
                        End If
                    Else
                        lngUserid = CType(HttpContext.Current.Session("intUserID"), Long)
                        drEmailID = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_Customer " + lngUserid.ToString, blnUseSQL)
                        If drEmailID.Read Then
                            strMessage.Replace("<SENDER_NAME>", drEmailID("CustomerID").ToString)
                            strFromEmailID = drEmailID("EmailID").ToString
                        End If
                    End If

                    drEmailID.Close()
                    CommonFunction.Data.DisposeDataReader(drEmailID)

                    'depends on show to customer check box get the discussion threads messages details.
                    If intShow = 0 Then
                        drDiscussionDetails = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_Deliverable_Discussions " + lngDeliverableID.ToString, blnUseSQL)
                    Else
                        drDiscussionDetails = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_Deliverable_Discussions " + lngDeliverableID.ToString + ", 1", blnUseSQL)
                    End If

                    If drDiscussionDetails.Read Then
                        strEmailSubject.Replace("<PROJECT_NAME>", drDiscussionDetails("ProjectName").ToString)
                        strEmailSubject.Replace("<TITLE>", drDiscussionDetails("Title").ToString)
                        strMessage.Replace("<TITLE>", drDiscussionDetails("Title").ToString)
                        strDiscussion = vbCrLf + "Comment added by " + drDiscussionDetails("UserName").ToString
                        strDiscussion += " on " + CommonFunction.Dates.CGetDateTime(CType(drDiscussionDetails("DiscussionDate"), Date)) + vbCrLf
                        strDiscussion += CommonFunction.Data.CheckIsDBNull(drDiscussionDetails("Comments"), "").ToString + vbCrLf
                        strStatus = CommonFunction.Data.CheckIsDBNull(drDiscussionDetails("Status"), "").ToString + ""
                        strType = CommonFunction.Data.CheckIsDBNull(drDiscussionDetails("IssueType"), "").ToString + ""
                    End If
                    strDiscussion += vbCrLf

                    While drDiscussionDetails.Read
                        strDiscussion += "Comment added by " + drDiscussionDetails("UserName").ToString
                        strDiscussion += " on " + CommonFunction.Dates.CGetDateTime(CType(drDiscussionDetails("DiscussionDate"), Date)) + vbCrLf
                        strDiscussion += CommonFunction.Data.CheckIsDBNull(drDiscussionDetails("Comments"), "").ToString + vbCrLf
                    End While

                    strMessage.Replace("<DISCUSSION_THREAD>", strDiscussion)

                    drDiscussionDetails.Close()
                    CommonFunction.Data.DisposeDataReader(drDiscussionDetails)

                    ' Get the list of users to whom the mail must be sent.				
                    strMailToEmployeeIDList = ""
                    strMailCCToEmployeeIDList = ""
                    strSQL = "usp_Sel_tbl_IB_IssueBaseMails NULL, " + HttpContext.Current.Session("intProjectID").ToString + ", '" + strType + "', '" + strStatus + "'"
                    drEmailID = Data.GetDataReader(strSQL, blnUseSQL)
                    If drEmailID.Read Then
                        If Not IsDBNull(drEmailID("MailToEmployeeIDList")) Then
                            strMailToEmployeeIDList = CommonFunction.Data.CheckIsDBNull(drEmailID("MailToEmployeeIDList"), "").ToString + ""
                        End If
                        If Not IsDBNull(drEmailID("MailCCToEmployeeIDList")) Then
                            strMailCCToEmployeeIDList = CommonFunction.Data.CheckIsDBNull(drEmailID("MailCCToEmployeeIDList"), "").ToString + ""
                        End If
                    End If
                    Data.DisposeDataReader(drEmailID)

                    If strMailCCToEmployeeIDList = "" Then strMailCCToEmployeeIDList = ","

                    'get the employee email ids
                    If strToEmailID <> "" Then strToEmailID += ";"
                    If strCCToEmailID <> "" Then strCCToEmailID += ";"

                    strSQL = "usp_Sel_tbl_IB_IssueBaseMails_EmployeeList " + HttpContext.Current.Session("intProjectID").ToString
                    drEmailID = Data.GetDataReader(strSQL, blnUseSQL)
                    While drEmailID.Read
                        If Not IsDBNull(drEmailID("EmailID")) Then
                            If intShow = 0 Then
                                'select email ids of company employees only.
                                If (drEmailID("ResourceType").ToString.Trim = "E" Or drEmailID("ResourceType").ToString.Trim = "CE") Then
                                    If InStr(1, strMailToEmployeeIDList, "," + drEmailID("EmployeeID").ToString.Trim + ",") <> 0 And InStr(1, strToEmailID, drEmailID("EmailID").ToString) = 0 Then
                                        strToEmailID += CommonFunction.Data.CheckIsDBNull(drEmailID("EmailID"), "").ToString + ";"
                                    End If
                                    If InStr(1, strMailCCToEmployeeIDList, "," + drEmailID("EmployeeID").ToString + ",") <> 0 And InStr(1, strCCToEmailID, drEmailID("EmailID").ToString) = 0 Then
                                        strCCToEmailID += CommonFunction.Data.CheckIsDBNull(drEmailID("EmailID"), "").ToString + ";"
                                    End If
                                End If
                            Else
                                'select email ids of company employee as well as customers too
                                If InStr(1, strMailToEmployeeIDList, "," + drEmailID("EmployeeID").ToString.Trim + ",") <> 0 And InStr(1, strToEmailID, drEmailID("EmailID").ToString) = 0 Then
                                    strToEmailID += CommonFunction.Data.CheckIsDBNull(drEmailID("EmailID"), "").ToString + ";"
                                End If
                                If InStr(1, strMailCCToEmployeeIDList, "," + drEmailID("EmployeeID").ToString + ",") <> 0 And InStr(1, strCCToEmailID, drEmailID("EmailID").ToString) = 0 Then
                                    strCCToEmailID += CommonFunction.Data.CheckIsDBNull(drEmailID("EmailID"), "").ToString + ";"
                                End If
                            End If
                        End If
                    End While
                    Data.DisposeDataReader(drEmailID)

                    'Addition by SuchitraP on 8-Apr-2009 for IssueID : 29947
                    'Purpose :  For the discussion thread mail to list goes blank though the responsible person is set for the deliverable.
                    If strToEmailID = "" Then
                        Dim strResponsiblePerson As String
                        Dim drDeliverableDetails As IDataReader
                        drDeliverableDetails = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_PM_ProjectDeliverables " + HttpContext.Current.Session("intProjectID").ToString + ", " + lngDeliverableID.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                        If drDeliverableDetails.Read Then
                            strResponsiblePerson = drDeliverableDetails("ResponsiblePerson").ToString.Trim
                            If strResponsiblePerson <> "" Then
                                strToEmailID += strResponsiblePerson + ";"
                            End If
                        End If

                        CommonFunction.Data.DisposeDataReader(drDeliverableDetails)
                    End If

                    If strCCToEmailID = "" Then
                        strCCToEmailID = strFromEmailID
                    End If
                    'End of addition by SuchitraP on 8-Apr-2009

                Catch ex As Exception
                    Err.Raise(Err.Number, "CommonFunctions->EmailMessages->GetEmailMessage_432", ex.Message)
                End Try
                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
            End Sub

            Public Shared Sub GetEmailMessage_439(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal intScheduleID As Long)
                '=====================================================================
                ' Procedure Name		:	GetEmailMessage_439 (Deliverable STATUS CHANGED.)
                ' Parameters Passed     :	strFromEmailID	:- The Mail ID of the sender.
                '							strToEmailID	:- The EmailID of the person to whom the message will be returned.
                '							strCCToEmailID	:- The EmailID's of the people to whom the CC must be sent.
                '							strSubject		:- The Subject of the Email Message.
                '							strEmailMessage	:- The body of the Email Message.			
                '							intDeliverableID:- The Deliverable ID.
                ' Returns               :	
                ' Parameters Affected   :	strFromEmailID, strToEmailID, strCCToEmailID, strSubject, strEmailMessage :- These values are returned by the subroutine by reference.
                ' Description           :	Generate the email message as defined in the System Email Messages table in the database.
                ' Purpose               :	Generate the email message as defined in the System Email Messages table in the database.
                ' Assumptions           :	The message ID exists in the database.
                '							The message does not contain any other parameters besides the following :
                '								1.	<NAME>
                '								2.	<SENDER_NAME>
                '								3.	<TITLE> 
                '								7.	<PROJECT_NAME>
                ' Dependencies          :	None.
                ' Author                :	SachinR
                ' Created               :	24 Aug 2004
                ' Revisions             :
                '=====================================================================						

                Dim intMessageID As Integer = 439
                Dim strUserName, strProjectName As String
                Dim intProjectID As Integer
                Dim drDeliverable As IDataReader
                Dim strStatus As String = ""
                Dim strIssueType As String = ""
                Dim strMailToEmployeeIDList As String = ""
                Dim strMailCCToEmployeeIDList As String = ""
                Dim drEmployee As IDataReader
                Dim blnShowToCustomer As Boolean = False
                Dim strTitle As String

                '1. Code for String Builder Changes - IssueID - 6052 
                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                ' If the Issue ID is not specified, then exit the subroutine.
                If intScheduleID = 0 Then
                    Exit Sub
                End If
                intProjectID = CType(HttpContext.Current.Session("intProjectID"), Integer)

                ' Get Issue Type details assigned for this Deliverable
                drDeliverable = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_PM_Deliverable_IssUeType " + intScheduleID.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                If drDeliverable.Read Then
                    strTitle = drDeliverable("Title").ToString.Trim
                    strIssueType = drDeliverable("IssueType").ToString.Trim
                    strStatus = drDeliverable("Status").ToString.Trim

                End If
                CommonFunction.Data.DisposeDataReader(drDeliverable)

                'Commented By VidyaJ on 8th Dec 2004
                '' Get the details of the deliverable.
                'drDeliverable = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_PM_Deliverable_Discussions_EmailID " + intScheduleID.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                'If drDeliverable.Read Then
                '    strTitle = drDeliverable("Title").ToString.Trim
                '    ' intProjectID = CType(drDeliverable("ProjectID"), Integer)
                '    strIssueType = drDeliverable("IssueType").ToString.Trim
                '    strStatus = drDeliverable("Status").ToString.Trim
                '    blnShowToCustomer = True   'CType(drDeliverable("ShowToCustomer"), Boolean)
                'End If
                'CommonFunction.Data.DisposeDataReader(drDeliverable)

                ' If the Project ID not found, exit the subroutine.
                ' NOTE: This case can come if the Issue was not found in the table.
                If intProjectID = 0 Then
                    Exit Sub
                End If

                ' Get the message body, and subject.
                strEmailMessage = funcGetEmailMessageForProject(intProjectID, intMessageID, strSubject)

                '2. Code for String Builder Changes - IssueID - 6052 
                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                ' Retrieve information about the Sender.
                Call GetSenderInfo(strUserName, strFromEmailID)
                strMessage.Replace("<SENDER_NAME>", strUserName)

                ' Retrieve information about the Project.
                Call GetProjectInfo(intProjectID, strProjectName, intMessageID, strCCToEmailID)
                strMessage.Replace("<PROJECT_NAME>", strProjectName)
                strEmailSubject.Replace("<PROJECT_NAME>", strProjectName)

                ' Insert the deliverable title.
                strMessage.Replace("<TITLE>", strTitle.Trim)
                strEmailSubject.Replace("<TITLE>", strTitle.Trim)

                ' Insert the Status.
                strMessage.Replace("<STATUS>", strStatus)

                ' Insert the Date.
                strMessage.Replace("<DATE>", CommonFunction.Dates.CGetDateTime(Now()))

                ' Get the list of users to whom the mail must be sent.		
                drDeliverable = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_IB_IssueBaseMails NULL, " + intProjectID.ToString + ", '" + CommonFunction.General.BuildQueryString(strIssueType) + "', '" + CommonFunction.General.BuildQueryString(strStatus) + "'", CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                If drDeliverable.Read Then
                    strMailToEmployeeIDList = drDeliverable("MailToEmployeeIDList").ToString.Trim
                    strMailCCToEmployeeIDList = drDeliverable("MailCCToEmployeeIDList").ToString.Trim
                End If
                CommonFunction.Data.DisposeDataReader(drDeliverable)

                ' Get the employee email ids.
                drEmployee = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_IB_IssueBaseMails_EmployeeList " + intProjectID.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                Do While drEmployee.Read
                    If drEmployee("EmailID").ToString.Trim <> "" Then
                        If blnShowToCustomer = True Or (blnShowToCustomer = False And (drEmployee("ResourceType").ToString.Trim = "E" Or drEmployee("ResourceType").ToString.Trim = "CE" Or drEmployee("ResourceType").ToString.Trim = "OT" Or drEmployee("ResourceType").ToString.Trim = "CC")) Then
                            If InStr(strMailToEmployeeIDList, "," + drEmployee("EmployeeID").ToString.Trim & ",") <> 0 Then
                                If InStr(strToEmailID, drEmployee("EmailID").ToString) = 0 Then
                                    strToEmailID = strToEmailID + drEmployee("EmailID").ToString.Trim + ";"
                                End If
                            End If
                            If InStr(strMailCCToEmployeeIDList, "," + drEmployee("EmployeeID").ToString.Trim + ",") <> 0 Then
                                If InStr(strCCToEmailID, drEmployee("EmailID").ToString.Trim) = 0 Then
                                    strCCToEmailID = strCCToEmailID + ";" + drEmployee("EmailID").ToString.Trim
                                End If
                            End If
                        End If
                    End If
                Loop
                CommonFunction.Data.DisposeDataReader(drEmployee)

                'Addition by SuchitraP on 8-Apr-2009 for IssueID : 29947
                'Purpose : For the deliverable after changing the IR status of deliverable for the mail to list goes blank though the responsible person is set for that deliverable.
                Dim strResponsiblePerson As String
                Dim drDeliverableDetails As IDataReader
                drDeliverableDetails = CommonFunction.Data.GetDataReader("Exec usp_Sel_tbl_PM_ProjectDeliverables " + HttpContext.Current.Session("intProjectID").ToString + ", " + intScheduleID.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                If drDeliverableDetails.Read Then
                    strResponsiblePerson = drDeliverableDetails("ResponsiblePerson").ToString.Trim
                    If strResponsiblePerson <> "" Then
                        strToEmailID += strResponsiblePerson + ";"
                    End If
                End If

                CommonFunction.Data.DisposeDataReader(drDeliverableDetails)
                'End of addition by SuchitraP on 8-Apr-2009

                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
            End Sub

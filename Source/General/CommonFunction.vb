            ' Revisions             :
            '=====================================================================
            Dim strOUPool As String = ""
            Dim txtScript As New System.Text.StringBuilder
            Dim strScript As String
            Dim lngBusinessGroupID, lngOUPoolID, lngProjectID As Long
            Dim strSQL, strBusinessGroupID As String
            Dim drTemp As IDataReader
            Dim strQuery As String = ""
            Dim intCount As Integer = 0

            'Added by PrasadP on 20th July 2006

            'create function to add new option in combo box at runtime.
            txtScript.Append("function AddOption(strValue,strText)" & vbCrLf)
            txtScript.Append("{" & vbCrLf)
            txtScript.Append("objNewElement = document.createElement('OPTION');" & vbCrLf)
            txtScript.Append("objNewElement.innerHTML = strText;" & vbCrLf)
            txtScript.Append("objNewElement.value = strValue;" & vbCrLf)
            txtScript.Append("return objNewElement;" & vbCrLf)
            txtScript.Append("}" & vbCrLf)


            'End of code Addition  by PrasadP on 20th July 2006
            txtScript.Append("var arrBG_OU = new Array();" & vbCrLf + vbCrLf)
            strQuery = "usp_Sel_tbl_CNF_BusinessGroup_OU 0"
            If strPrimaryKey <> "" And strPrimaryKey <> "0" Then
                strQuery &= ",1," & strPrimaryKey
            End If

            drTemp = CommonFunctions.Data.GetDataReader(strQuery, CType(CommonFunctions.General.GetApplicationKeySetting("UseSQL"), Boolean), strConnectionStringSEM)
            While drTemp.Read()
                lngBusinessGroupID = CType(CommonFunctions.Data.CheckIsDBNull(drTemp.Item("BusinessGroupID"), "0"), Long)
                lngOUPoolID = CType(CommonFunctions.Data.CheckIsDBNull(drTemp.Item("OUPoolID"), "0"), Long)
                strOUPool = CommonFunctions.General.CheckIsNothing(drTemp.Item("Location"), "")
                txtScript.Append("arrBG_OU[" & intCount.ToString() & "] = new Array(3);" & vbCrLf)
                txtScript.Append("arrBG_OU[" & intCount.ToString() & "][0] = " & lngBusinessGroupID.ToString() & ";" & vbCrLf)
                txtScript.Append("arrBG_OU[" & intCount.ToString() & "][1] = " & lngOUPoolID.ToString() & ";" & vbCrLf)
                'txtScript.Append("arrBG_OU[" & intCount.ToString() & "][2] = '" & strOUPool & "';" & vbCrLf)

                strOUPool = """" + strOUPool + """"
                txtScript.Append("arrBG_OU[" & intCount.ToString() & "][2] = " & strOUPool & ";" & vbCrLf)

                intCount = intCount + 1
            End While
            CommonFunction.Data.DisposeDataReader(drTemp)
            '$$$$$$$$$$

            'txtScript.Append("BusinessGroup_Change(1);" & vbCrLf + vbCrLf)

            txtScript.Append("function BusinessGroup_Change(intWhen,intRowNo){" & vbCrLf)
            txtScript.Append("  var objBGId = GetObjectReference('" + strFormName + "','" + ParentControlName + "'+intRowNo);" & vbCrLf)
            txtScript.Append("  var objOUPool = GetObjectReference('" + strFormName + "','" + ChildControlName + "'+intRowNo);" & vbCrLf)
            txtScript.Append("  var lngSelectedOUPool,lngSelectedProgram,j, i;" & vbCrLf)
            txtScript.Append("  if(objBGId==null || objOUPool == null ) return;" + vbCrLf)
            txtScript.Append(" var lngBGId = objBGId[objBGId.selectedIndex].value;" + vbCrLf)
            txtScript.Append("  if(lngBGId > 0){ i = 0;" & vbCrLf)
            txtScript.Append("    lngSelectedOUPool = objOUPool[objOUPool.selectedIndex].value;" & vbCrLf)
            txtScript.Append("    objOUPool.length = 0;" & vbCrLf)
            'txtScript.Append("    objOUPool.add(new Option('', ''));" & vbCrLf)
            txtScript.Append("   objOUPool.appendChild(AddOption('',''));" & vbCrLf)
            txtScript.Append("    for(i=0; i < arrBG_OU.length;i++){" & vbCrLf)
            txtScript.Append("    if(lngBGId == arrBG_OU[i][0]){" & vbCrLf)
            '  txtScript.Append("        objOUPool.add(new Option(arrBG_OU[i][2], arrBG_OU[i][1]));" & vbCrLf)
            txtScript.Append("          objOUPool.appendChild(AddOption(arrBG_OU[i][1],arrBG_OU[i][2]));" & vbCrLf)
            txtScript.Append("          if(objOUPool.style.display!='none') " + vbCrLf)
            txtScript.Append("          objOUPool.focus();" + vbCrLf)
            txtScript.Append("        if(arrBG_OU[i][1] == lngSelectedOUPool){" & vbCrLf)
            txtScript.Append("            objOUPool.selectedIndex = objOUPool.length - 1;" & vbCrLf)
            txtScript.Append("        }" & vbCrLf)
            txtScript.Append("     }" & vbCrLf)
            txtScript.Append("    }" & vbCrLf)

            txtScript.Append("  }" & vbCrLf)
            txtScript.Append("  else" & vbCrLf)
            txtScript.Append("  {" & vbCrLf)
            txtScript.Append("    objOUPool.length = 0;" & vbCrLf)
            'txtScript.Append("    objOUPool.add(new Option('', ''));" & vbCrLf)
            txtScript.Append("   objOUPool.appendChild(AddOption('',''));" & vbCrLf)
            txtScript.Append("  }" & vbCrLf)
            txtScript.Append("  if(intWhen == 0){ " & vbCrLf)
            txtScript.Append("      var objDU=GetObjectReference('" + strFormName + "','ResourcePoolID'); " + vbCrLf)
            txtScript.Append("      var objDT=GetObjectReference('" + strFormName + "','ResourceGroupID'); " + vbCrLf)
            txtScript.Append("  if(objDU==null ) return;" + vbCrLf)
            txtScript.Append("      objDU.length = 0;" & vbCrLf)
            'txtScript.Append("      objDU.add(new Option('', ''));" & vbCrLf)
            txtScript.Append("   objDU.appendChild(AddOption('',''));" & vbCrLf)
            txtScript.Append("  if(objDT == null ) return;" + vbCrLf)
            txtScript.Append("      objDT.length = 0;" & vbCrLf)
            'txtScript.Append("      objDT.add(new Option('', ''));" & vbCrLf)
            txtScript.Append("   objDT.appendChild(AddOption('',''));" & vbCrLf)
            txtScript.Append("  }" & vbCrLf)
            txtScript.Append("}" & vbCrLf)

            strScript = txtScript.ToString
            txtScript = Nothing

            GetDependantLocationScript = strScript

        End Function

        Public Shared Function GetDependantResourcePoolScript(ByVal EditMode As Boolean, Optional ByVal strFormName As String = "frmCommonPage", Optional ByVal ParentControlName As String = "LocationID", Optional ByVal ChildControlName As String = "ResourcePoolID", Optional ByVal strConnectionStringSEM As String = "", Optional ByVal strPrimaryKey As String = "") As String
            '=====================================================================
            ' Procedure Name        : GetDependantResourcePoolScript()
            ' Purpose               : Generic function to create Array Structure to Plot Dependant DU , DT 
            ' Description           : same as above
            ' Parameters Passed     : None
            ' Returns               : String
            ' Parameters Affected   : 
            ' Assumptions           : ControlNames are 
            '                         BusinessGroupID , LocationID , ResourcePoolID , ResourceGroupID 
            '
            ' Dependencies          : 
            ' Author                : NitinVS 
            ' Created               : 23 Feb 2006 
            ' Revisions             :
            '=====================================================================
            Dim strOUPool As String = ""
            Dim txtScript As New System.Text.StringBuilder
            Dim strScript As String
            Dim lngBusinessGroupID, lngOUPoolID, lngProjectID As Long
            Dim strSQL, strBusinessGroupID As String
            Dim drTemp As IDataReader
            Dim strQuery As String = ""
            Dim intCount As Integer = 0
            Dim strResourcePool As String
            Dim lngResourcePoolID As Long
            intCount = 0
            strResourcePool = ""
            lngResourcePoolID = 0
            lngOUPoolID = 0

            txtScript.Append("var arrOU_DU = new Array();" + vbCrLf)

            strQuery = "usp_Sel_tbl_PM_OUPool_ResourcePools 0"

            If strPrimaryKey <> "" And strPrimaryKey <> "0" Then
                strQuery &= ",1," & strPrimaryKey
            End If

            drTemp = CommonFunctions.Data.GetDataReader(strQuery, CType(CommonFunctions.General.GetApplicationKeySetting("UseSQL"), Boolean), strConnectionStringSEM)
            While drTemp.Read
                lngOUPoolID = CType(CommonFunctions.Data.CheckIsDBNull(drTemp.Item("OUPoolID"), "0"), Long)
                lngResourcePoolID = CType(CommonFunctions.Data.CheckIsDBNull(drTemp.Item("ResourcePoolID"), "0"), Long)
                strResourcePool = CommonFunctions.General.CheckIsNothing(drTemp.Item("ResourcePoolName"), "")

                txtScript.Append("arrOU_DU[" + intCount.ToString + "] = new Array(3);" + vbCrLf)
                txtScript.Append("arrOU_DU[" + intCount.ToString + "][0]= " + lngOUPoolID.ToString + ";" + vbCrLf)
                txtScript.Append("arrOU_DU[" + intCount.ToString + "][1]= " + lngResourcePoolID.ToString + ";" + vbCrLf)
                'txtScript.Append("arrOU_DU[" + intCount.ToString + "][2]= '" + strResourcePool.Trim + "';" + vbCrLf)

                strResourcePool = """" + strResourcePool + """"
                txtScript.Append("arrOU_DU[" + intCount.ToString + "][2]= " + strResourcePool.Trim + ";" + vbCrLf)

                intCount += 1
            End While
            CommonFunction.Data.DisposeDataReader(drTemp)

            'txtScript.Append(" OUPool_OnChange(GetObjectReference('" + strFormName + "','" + ParentControlName + "'),1);" + vbCrLf)

            txtScript.Append(" function OUPool_OnChange(objOU,intWhen,intRowNo){" + vbCrLf)
            txtScript.Append(" var objDU=GetObjectReference('" + strFormName + "','" + ChildControlName + "'+intRowNo); " + vbCrLf)
            txtScript.Append(" if (objOU== null) return;" + vbCrLf)
            txtScript.Append(" var intOUID=objOU[objOU.selectedIndex].value; " + vbCrLf)
            txtScript.Append(" if(objDU!=null){" + vbCrLf)
            txtScript.Append(" var intDUID; " + vbCrLf)
            txtScript.Append(" if (objDU!=null) " + vbCrLf)
            txtScript.Append(" intDUID=objDU.value; " + vbCrLf)
            txtScript.Append(" var i,intCount=0;" + vbCrLf)
            'txtScript.Append(" objDU.options.length=0; " + vbCrLf)
            txtScript.Append(" objDU.length=0; " + vbCrLf)
            'txtScript.Append(" objDU.add(new Option('',''));" + vbCrLf)
            txtScript.Append("   objDU.appendChild(AddOption('',''));" & vbCrLf)
            txtScript.Append(" for(i=0;i<arrOU_DU.length;i++)" + vbCrLf)
            txtScript.Append(" {" + vbCrLf)
            txtScript.Append(" if(arrOU_DU[i][0]==intOUID){" + vbCrLf)
            'txtScript.Append(" objDU.add(new Option(arrOU_DU[i][2],arrOU_DU[i][1]));" + vbCrLf)
            txtScript.Append(" objDU.appendChild(AddOption(arrOU_DU[i][1],arrOU_DU[i][2]));" & vbCrLf)
            txtScript.Append("          if(objDU.style.display!='none') " + vbCrLf)
            txtScript.Append("              objDU.focus();" + vbCrLf)

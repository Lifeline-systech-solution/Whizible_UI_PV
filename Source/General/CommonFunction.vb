            Public Shared Sub GetEmailMessage_3(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal intTimeSheetID As Integer)
                '=====================================================================
                ' Procedure Name		:	GetEmailMessage_3 (TIMESHEET AUTHENTICATION)
                ' Parameters Passed     :	strToEmailID	:- The EmailID of the person to whom the message will be returned.
                '							strSubject		:- The Subject of the Email Message.
                '							strEmailMessage	:- The body of the Email Message.
                '							intTimeSheetID	:- The Timesheet ID.
                ' Returns               :	
                ' Parameters Affected   :	strToEmailID, strSubject, strEmailMessage :- These values are returned by the subroutine by reference.
                ' Description           :	Generate the email message as defined in the System Email Messages table in the database.
                ' Purpose               :	Generate the email message as defined in the System Email Messages table in the database.
                ' Assumptions           :	The message ID exists in the database.
                '							The message does not contain any other parameters besides the following :
                '								1.	<SENDER_NAME>
                '								2.	<SITE NAME> 
                '								3.	<PROJECT_NAME> 
                '								4.	<NAME>
                ' Dependencies          :	None.
                ' Author                :	AniruddhaD
                ' Created               :	Feb 23, 2004
                ' Revisions             :
                '=====================================================================	

                Dim strUserName, strProjectName, strListOfReceivers As String
                Dim drTSAuthenticatedBy, drReciever As IDataReader
                Dim intMessageID As Integer = 3
                'Added By VivekP On 16 Sep 2005 For WhizibleSEM SP4
                Dim strStartDate As String
                Dim strEndDate As String

                '1. Code for String Builder Changes - IssueID - 6052 

                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                'End Of Addition By VivekP On 16 Sep 2005 For WhizibleSEM SP4

                ' Get the message body, and subject.
                strEmailMessage = funcGetEmailMessageForProject(CType(HttpContext.Current.Session("intProjectID"), Long), intMessageID, strSubject)

                '2. Code for String Builder Changes - IssueID - 6052 

                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                ' Retrieve information about the Project.
                Call GetProjectInfo(CType(HttpContext.Current.Session("intProjectID"), Long), strProjectName, intMessageID, strCCToEmailID)
                strMessage.Replace("<PROJECT_NAME>", strProjectName)
                strEmailSubject.Replace("<PROJECT_NAME>", strProjectName & " [Timesheet No : " & intTimeSheetID & "]")

                ' Retrieve information about the Sender.
                Call GetSenderInfo(strUserName, strFromEmailID)
                strMessage.Replace("<SENDER_NAME>", strUserName)

                ' Get the person (CUSTOMER/INTERNAL) who is responsible for authenticating the timesheet.
                drTSAuthenticatedBy = CommonFunction.Data.GetDataReader("EXEC usp_Sel_TimeSheetAuthenticationType " + intTimeSheetID.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))

                If drTSAuthenticatedBy.Read Then

                    If drTSAuthenticatedBy("AuthenticatedBy").ToString = "C" Then

                        ' Added by GokulP on 21 Oct 2009 for IssueID : 33751
                        Dim drCustProjectTimesheet As IDataReader
                        drCustProjectTimesheet = CommonFunction.Data.GetDataReader("EXEC usp_Sel_CustomerEmailIDForProjectTimeSheet " + CType(HttpContext.Current.Session("intProjectID"), String), CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                        While drCustProjectTimesheet.Read
                            If drCustProjectTimesheet("EmailID").ToString.Trim <> "" Then
                                strToEmailID = strToEmailID + drCustProjectTimesheet("EmailID").ToString + "; "
                                strListOfReceivers = strListOfReceivers + drCustProjectTimesheet("CustomerName").ToString + ", "
                            End If
                        End While
                        CommonFunction.Data.DisposeDataReader(drCustProjectTimesheet)
                        'End of Addition by GokulP on 21 Oct 2009 for IssueID : 33751

                        ' Get the email id's from project customer contact table to send the mail.
                        drReciever = CommonFunction.Data.GetDataReader("EXEC usp_Sel_CustomerEmailIDForTimeSheet " + CType(HttpContext.Current.Session("intProjectID"), String), CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                        Do While drReciever.Read
                            If drReciever("EmailID").ToString.Trim <> "" Then
                                strToEmailID = strToEmailID + drReciever("EmailID").ToString + "; "
                            End If
                            'Modified by VivekP On  29 Aug 2005 For WhizibleSEM Sp4
                            strListOfReceivers = strListOfReceivers + drReciever("EmployeeName").ToString + ", "
                            'End Of Modification By VivekP On  29 Aug 2005 For WhizibleSEM Sp4
                        Loop
                        CommonFunction.Data.DisposeDataReader(drReciever)
                    Else
                        ' Get the email id of the Internal person responsible for authenticating the time sheet.
                        drReciever = CommonFunction.Data.GetDataReader("EXEC usp_Sel_InternalAuthenticatorForTimeSheet " + intTimeSheetID.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                        Do While drReciever.Read
                            If drReciever("EmailID").ToString.Trim <> "" Then
                                strToEmailID = strToEmailID + drReciever("EmailID").ToString + "; "
                            End If
                            strListOfReceivers = strListOfReceivers + drReciever("EmployeeName").ToString + ", "
                        Loop
                        CommonFunction.Data.DisposeDataReader(drReciever)
                    End If

                End If
                CommonFunction.Data.DisposeDataReader(drTSAuthenticatedBy)

                If Not strListOfReceivers Is Nothing Then
                    If strListOfReceivers.Trim = "" Then
                        strListOfReceivers = "All"
                    End If
                Else
                    strListOfReceivers = "All"
                End If

                'Added By VivekP On 16 Sep 2005 For WhizibleSEM SP4
                strStartDate = CommonFunctions.Dates.GetDate(CType(CommonFunctions.Data.GetDataScalar("SELECT FromDate  FROM tbl_PM_TimesheetInvoice WHERE TimeSheetNo=" + intTimeSheetID.ToString, True), Date))
                strEndDate = CommonFunctions.Dates.GetDate(CType(CommonFunctions.Data.GetDataScalar("SELECT ToDate  FROM tbl_PM_TimesheetInvoice WHERE TimeSheetNo=" + intTimeSheetID.ToString, True), Date))
                strMessage.Replace("<START_DATE>", strStartDate)
                strMessage.Replace("<END_DATE>", strEndDate)
                'End Of Addition By VivekP On 16 Sep 2005 For WhizibleSEM SP4


                ' Construct real message by replacing the real data.
                strMessage.Replace("<NAME>", strListOfReceivers)
                strMessage.Replace("<SITE NAME>", "http://" + HttpContext.Current.Request.ServerVariables("SERVER_NAME"))


                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing
            End Sub


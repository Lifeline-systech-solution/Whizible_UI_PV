                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                strUserName = HttpContext.Current.Session("strUserName").ToString
                strProjectName = CType(CommonFunctions.Data.CheckIsDBNull(CommonFunctions.Data.GetDataScalar("select ProjectName from tbl_PM_Project WHERE ProjectID = " + lngProjectID.ToString, True), ""), String)

                ' Retrieve information about the Sender.
                Call GetSenderInfo(strUserName, strFromEmailID)
                strEmailSubject.Replace("<PROJECT_NAME>", strProjectName)
                strMessage.Replace("<PROJECT_NAME>", strProjectName)
                strMessage.Replace("<SENDER_NAME>", strUserName)
                If lngProjectID = 0 Then Exit Sub

                strCCToEmailID = strFromEmailID

                strUserName = ""
                dr = CommonFunctions.Data.GetDataReader("usp_tbl_PM_ProjInfo_Discussions_MailTo_list " & lngProjectID.ToString, True)
                'End Modification By nitinVS on 1 Mar 2007 for WhizibleSEM SP9 
                'End Integration by SandipL SP8 to SP9
                Do While dr.Read
                    'If Trim(dr("EMailID").ToString & "") <> "" And UCase(Trim(strFromEmailID & "")) <> UCase(Trim(dr("EMailID").ToString & "")) Then
                    strToEmailID &= "," & dr("EMailID").ToString & ""
                    strUserName &= "," & dr("UserName").ToString & ""
                    'End If
                Loop
                CommonFunctions.Data.DisposeDataReader(dr)

                If Trim(strToEmailID & "") <> "" Then
                    strToEmailID = Right(strToEmailID, Len(strToEmailID) - 1)
                End If

                If Trim(strUserName & "") <> "" Then
                    strUserName = Right(strUserName, Len(strUserName) - 1)
                End If

                ' the discussion details
                dr = CommonFunctions.Data.GetDataReader("usp_tbl_PM_ProjInfo_Discussions  " & lngProjectID, True)
                Do While dr.Read
                    strDiscussions &= "Comment added by " & Trim(dr("UserName").ToString & "")

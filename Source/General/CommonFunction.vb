                Dim strEmployeeNames As String
                Dim strProjectName As String

                '1. Code for String Builder Changes - IssueID - 6052 
                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                intMessageID = 52

                ' Get the message body, and subject.
                drEmailMessage = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_EmailMessages " + intMessageID.ToString, blnUseSQL)
                If drEmailMessage.Read Then
                    strEmailMessage = CommonFunction.Data.CheckIsDBNull(drEmailMessage("Body")).ToString
                    strSubject = CommonFunction.Data.CheckIsDBNull(drEmailMessage("Subject")).ToString
                End If
                drEmailMessage.Close()
                CommonFunction.Data.DisposeDataReader(drEmailMessage)

                drRFI = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_RFIs " + intRFIID.ToString, blnUseSQL)
                If drRFI.Read Then
                    intProjectID = CType(drRFI("ProjectID"), Integer)
                    strRFIRaisedBy = drRFI("RFIRaisedBy").ToString
                End If
                drRFI.Close()
                CommonFunction.Data.DisposeDataReader(drRFI)

                '2. Code for String Builder Changes - IssueID - 6052 
                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                strEmailSubject.Replace("<RFI_ID>", intRFIID.ToString)
                strMessage.Replace("<RFI_ID>", intRFIID.ToString)

                drProject = CommonFunction.Data.GetDataReader("SELECT ProjectName From tbl_PM_Project WHERE ProjectID = " + intProjectID.ToString, blnUseSQL)
                If drProject.Read Then
                    strEmailSubject.Replace("<PROJECT_NAME>", drProject("ProjectName").ToString)
                End If
                drProject.Close()
                CommonFunction.Data.DisposeDataReader(drProject)

                strMessage.Replace("<SENDER_NAME>", HttpContext.Current.Session("strUserName").ToString)

                GetProjectInfo(intProjectID, strProjectName, 52, strCCToEmailID)

                ' Commented and modified By MahendraV On 11:49 AM 9/7/2007 For WhizibleSEM 7.1
                ' To get only Active employee emailID
                ' Start_MV_9/7/2007
                ' drRaisedBy = CommonFunction.Data.GetDataReader("SELECT * FROM tbl_PM_Employee WHERE UserName = '" + strRFIRaisedBy + "'", blnUseSQL)
                'Intrgrated by TruptiK on 22-May-09
                'Added by SonalD on 25th March 2009
                strRFIRaisedBy = Replace(strRFIRaisedBy, "'", "''")
                'End of addition by SonalD 
                'End of integrated by TruptiK on 22-May-09
                drRaisedBy = CommonFunction.Data.GetDataReader("SELECT * FROM tbl_PM_Employee WITH (NOLOCK) WHERE UserName = '" + strRFIRaisedBy + "' AND ISNULL(Status,0) = 0 ", blnUseSQL)
                ' End_MV_9/7/2007
                While drRaisedBy.Read
                    'Added for issue id 12489 
                    If InStr(strCCToEmailID, drRaisedBy("EmailID").ToString) = 0 Then
                        strCCToEmailID = strCCToEmailID + ";" + drRaisedBy("EmailID").ToString + ";"
                    End If
                End While
                drRaisedBy.Close()
                CommonFunction.Data.DisposeDataReader(drRaisedBy)

                drMailTo = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_Employee_GetRFIAccountsPersons " + intRFIID.ToString, blnUseSQL)
                While drMailTo.Read
                    strToEmailID = strToEmailID + drMailTo("EMailID").ToString + ";"
                    If InStr(strMailToNames, drMailTo("UserName").ToString) = 0 Then
                        strMailToNames = strMailToNames + drMailTo("UserName").ToString + ","
                    End If


                End While
                drMailTo.Close()
                CommonFunction.Data.DisposeDataReader(drMailTo)

                strMessage.Replace("<NAME>", strMailToNames)
                GetSenderInfo(strEmployeeNames, strFromEmailID)

                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing

            End Sub


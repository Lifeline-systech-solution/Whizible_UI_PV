                    'End By VarunA on 11-Dec-2007
                    strMessage.Replace("<ISSUE_ID>", intIssueID.ToString)

                    strEmailSubject.Replace("<SUMMARY>", drIssue("Summary").ToString.Trim)
                    strMessage.Replace("<SUMMARY>", drIssue("Summary").ToString.Trim)

                    strMessage.Replace("<DESCRIPTION>", drIssue("Description").ToString.Trim)
                    'Added by SavitaS on 21 Aug 2006 for SP7 integration
                    'strReportedBy = CType(CommonFunction.Data.CheckIsDBNull(drIssue("ReportedBy"), ""), String)
                    'strReportedBy = strReportedBy.Trim
                    'End of Addition by SavitaS on 21 Aug 2006 for SP7 integration

                    'Commented and Added by SavitaS on 22 Aug 2006 for SP7 integration
                    'If drIssue("AssignTo").ToString.Trim <> "" Then
                    If CommonFunctions.General.CheckIsNothing(drIssue("AssignTo").ToString.Trim) <> "" Then
                        ' Call GetEmployeeInfo(CType(drIssue("AssignTo"), Long), strUserName, strToEmailID)
                        'intResponsible = CType(drIssue("AssignTo"), String)
                        intResponsible = CType(CommonFunctions.Data.CheckIsDBNull(drIssue("AssignTO").ToString, ""), String)
                        blnUseSQL = CType(General.GetApplicationKeySetting("UseSQL"), Boolean)
                        strSQLAssignTo = "usp_tbl_Sel_EmployeeInfo " + intResponsible.ToString
                        objDrAssignTo = Data.GetDataReader(strSQLAssignTo, blnUseSQL)
                        If objDrAssignTo.Read Then
                            strUserName = objDrAssignTo("UserName").ToString + ""
                        End If
                        Data.DisposeDataReader(objDrAssignTo)
                        'End of Commented and Added by SavitaS on 22 Aug 2006 for SP7 integration

                        strMessage.Replace("<NAME>", strUserName)
                    End If
                    'End If
                    'CommonFunction.Data.DisposeDataReader(drIssue)

                    'Added by SavitaS on 22 Aug 2006 for SP7 integration

                    strSQL = "usp_Sel_tbl_IB_IssueBaseMails_EmployeeList " + CType(HttpContext.Current.Session("IssueProject"), String)
                    objDr = Data.GetDataReader(strSQL, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
                    While objDr.Read
                        If objDr("EmployeeID").ToString = intResponsible.ToString Then

                            If InStr(1, strMailToEmployeeIDList, "," + objDr("EmployeeID").ToString.Trim + ",") <> 0 And InStr(1, strToEmailID, objDr("EmailID").ToString) = 0 Then
                                If strToEmailID <> "" Then
                                    strToEmailID += ";" + objDr("EmailID").ToString
                                Else
                                    strToEmailID = objDr("EmailID").ToString
                                End If
                            End If
                            If InStr(1, strMailCCToEmployeeIDList, "," + objDr("EmployeeID").ToString + ",") <> 0 And InStr(1, strCCToEmailID, objDr("EmailID").ToString) = 0 Then
                                If strCCToEmailID.ToString <> "" Then
                                    strCCToEmailID += ";" + objDr("EmailID").ToString
                                Else
                                    strCCToEmailID = objDr("EmailID").ToString
                                End If
                            End If
                        End If
                    End While
                    'End of Added by SavitaS on 22 Aug 2006 for SP7 integration

                End If
                CommonFunction.Data.DisposeDataReader(drIssue)

                If intResponsible <> "" Then
                    'End of Commented and modified by SavitaS on 21 Aug 2006 for whiziblesem SP7  Integration
                    ' Commented and modified By MahendraV On 11:49 AM 9/7/2007 For WhizibleSEM 7.1
                    ' To get only Active employee emailID
                    ' Start_MV_9/7/2007
                    ' strResponsiblePersonEmail = CType(CommonFunctions.Data.GetDataScalar("SELECT ISNULL(EmailID,'') FROM tbl_PM_Employee WHERE EmployeeID = " + intResponsible.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean)), String)
                    strResponsiblePersonEmail = CType(CommonFunctions.Data.GetDataScalar("SELECT ISNULL(EmailID,'') FROM tbl_PM_Employee WITH (NOLOCK) WHERE ISNULL(Status,0) = 0 AND EmployeeID = " + intResponsible.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean)), String)
                    ' End_MV_9/7/2007

        Public Shared Function OpenOutlookWhenClickOnEmail(ByVal strToEmailID As String _
        , Optional ByVal strCCEmailID As String = "" _
        , Optional ByVal strBCCEmailID As String = "" _
        , Optional ByVal strSubject As String = "" _
        , Optional ByVal strHi As String = "" _
        , Optional ByVal strBody As String = "" _
        , Optional ByVal strRegards As String = "" _
        , Optional ByVal IsDisplayShortenEmail As Boolean = True, Optional ByVal DisplayName As String = "") As String

            '=============================================
            ' Procedure Name : OpenOutlookWhenClickOnEmail
            ' Description : 
            ' Purpose : To open outlook onclick of emailID.
            ' Parameters Passed : strName - String - parameter to return Name
            ' Returns : None
            ' Parameters Affected :
            ' Assumptions :
            ' Dependencies :
            ' Author : MahendraV
            ' Created : 09-July-2009
            ' Revisions :
            '=====================================================================
            Dim sbString As StringBuilder = New StringBuilder
            Dim strIsExist As Boolean = False
            strToEmailID = HttpUtility.HtmlEncode(strToEmailID)
            strCCEmailID = HttpUtility.HtmlEncode(strCCEmailID)
            strBCCEmailID = HttpUtility.HtmlEncode(strBCCEmailID)

            sbString.Append("<A href='mailto:")
            sbString.Append(strToEmailID)
            sbString.Append("?")
            If strCCEmailID <> "" Then
                sbString.Append("cc=")
                sbString.Append(strCCEmailID)
                strIsExist = True
            End If
            If strBCCEmailID <> "" Then
                If strIsExist = True Then
                    sbString.Append("&bcc=")
                Else
                    sbString.Append("bcc=")
                End If
                strIsExist = True
                sbString.Append(strBCCEmailID)
            End If
            If strSubject <> "" Then
                If strIsExist = True Then
                    sbString.Append("&subject=")
                Else
                    sbString.Append("subject=")
                End If
                strIsExist = True
                sbString.Append(strSubject)
            End If
            If strIsExist = True Then
                sbString.Append("&body=Hi ")
            Else
                sbString.Append("body=Hi ")
            End If
            sbString.Append(strHi)
            sbString.Append(",%0A%0A")
            sbString.Append(strBody)
            sbString.Append("%0ARegards,%0A")
            sbString.Append(strRegards)
            sbString.Append("' title='")
            sbString.Append(strToEmailID)
            sbString.Append("' >")
            If IsDisplayShortenEmail = True Then
                If DisplayName <> "" Then
                    sbString.Append(IIf(DisplayName.Length <= 20, DisplayName, DisplayName.Substring(0, Math.Min(20, DisplayName.Length)).ToString() + "..").ToString)
                Else
                    sbString.Append(IIf(strToEmailID.Length <= 20, strToEmailID, strToEmailID.Substring(0, Math.Min(20, strToEmailID.Length)).ToString() + "..").ToString)
                End If
            Else
                If DisplayName <> "" Then
                    sbString.Append(DisplayName.ToString)
                Else
                    sbString.Append(strToEmailID.ToString)
                End If

            End If
            sbString.Append("</A>")
            strIsExist = False
            OpenOutlookWhenClickOnEmail = sbString.ToString()
        End Function
        '---- End addition purvaj


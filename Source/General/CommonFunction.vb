        Public Shared Sub SendWorkflowEmails(ByVal MsgID As Integer, ByVal PrimaryKeyValue As String, Optional ByVal Comments As String = "", Optional ByVal FromMobileApprovals As Boolean = False)
            '=============================================
            ' Procedure Name		: SendWorkflowEmails
            ' Description           : To send mail for workflow action
            ' Purpose               : same as purpose
            ' Parameters Passed     : MsgID, PrimaryKeyvalue
            ' Parameters Affected   :
            ' Assumptions           :
            ' Dependencies          :
            ' Author                : PrashantSJ
            ' Created               : May 10 2008
            ' Revisions             :
            '=====================================================================
            Dim drEmailMessage As IDataReader
            Dim blnSendEMail As Boolean
            Dim blnShowPopUp As Boolean
            Dim sbEM As New System.Text.StringBuilder
            Dim strComments As String

            Dim m_strToEmailID As String = ""
            Dim m_strCCEmailID As String = ""
            Dim m_strSubject As String = ""
            Dim m_strMessage As String = ""
            Dim m_strFromEmailID As String = ""

            'Modified By Amol Changle On: 24 Apr 2009
            If Comments = "" Then
                strComments = CommonFunction.General.CheckIsNothing(HttpContext.Current.Request.Form("txtComments_hidden"), "").ToString()
            Else
                strComments = Comments
            End If
            'End Addition

            strComments = HttpContext.Current.Server.UrlEncode(strComments)


            ' Retrieve the details of the message to be sent to the Resource.
            sbEM.Append("usp_Sel_IM_EmailMessages " & MsgID)

            drEmailMessage = CommonFunction.Data.GetDataReader(sbEM.ToString, CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean))
            If drEmailMessage.Read Then
                blnSendEMail = CType(drEmailMessage("SendMail"), Boolean)
                blnShowPopUp = CType(drEmailMessage("ShowPopup"), Boolean)
            End If
            CommonFunction.Data.DisposeDataReader(drEmailMessage)
            sbEM.Remove(0, sbEM.Length)

            If blnSendEMail = True Then

                'Modified By Amol Changle ON: 24 Apr 2009
                'Purpose: To Send Silent Emails
                If Not FromMobileApprovals Then
                    ' Check if a popup message has to be shown.
                    If blnShowPopUp = True Then
                        sbEM.Append("<Script language=javascript>")
                        'Added By Dipali V On 29th April 2020 For Mail Pop Up should not Close under main window
                        'sbEM.Append("window.open('../General/SendEmail.aspx?MessageID=" + MsgID.ToString + "&workflow=1&PrimaryKeyValue=" + PrimaryKeyValue.ToString + "&Comments=" + strComments.Replace("'", "\'") + "','','resizable=yes,scrollbars=yes,toolbar=no,statusbar=no,left=' + (window.screen.width - 600)/2 + ',top=' + (window.screen.height - 500)/2 + ',width=600,height=500');")
                        sbEM.Append("window.open('../General/SendEmail.aspx?MessageID=" + MsgID.ToString() + "&workflow=1&PrimaryKeyValue=" + PrimaryKeyValue.ToString + "&Comments=" + strComments.Replace("'", "\'") + "','_blank', 'resizable=yes,scrollbars=yes,toolbar=no,statusbar=no,left=' + (window.screen.width - 600) / 2 + ',top=' + (window.screen.height - 500) / 2 + ',width=600,height=500');")
                        sbEM.Append("window.focus()")
                        'End of Added By Dipali V On 29th April 2020 For Mail Pop Up should not Close under main window
                        sbEM.Append("</Script>")
                        General.WriteHTML(sbEM.ToString)
                        ' Else, if the mail has to be sent silently, then...
                    Else

                        'Call CommonFunction.EmailMessages.IBMessages.GetEmailMessage_34(strFromEmailID, strToEmailID, strCCToEmailId, strSubject, strEmailMsg, lngIssueID, "DT") 'ie Mail fires from DT

                        'Call CommonFunction.Emails.SendEmailWithCC(strToEmailID, strCCToEmailId, strFromEmailID, strSubject, strEmailMsg)
                        Call CommonFunction.EmailMessages.ConfigurableWorkflowMessages.GetEmailMessage(m_strFromEmailID, m_strToEmailID, m_strCCEmailID, m_strSubject, m_strMessage, MsgID, PrimaryKeyValue.ToString, strComments)
                        CommonFunction.Emails.AppSendEmailWithCC(m_strToEmailID, m_strCCEmailID, m_strFromEmailID, m_strSubject, m_strMessage)

                    End If
                Else
                    Call CommonFunction.EmailMessages.ConfigurableWorkflowMessages.GetEmailMessage(m_strFromEmailID, m_strToEmailID, m_strCCEmailID, m_strSubject, m_strMessage, MsgID, PrimaryKeyValue.ToString, strComments)
                    CommonFunction.Emails.AppSendEmailWithCC(m_strToEmailID, m_strCCEmailID, m_strFromEmailID, m_strSubject, m_strMessage)
                End If
                'End Modification
            End If
            sbEM = Nothing

        End Sub


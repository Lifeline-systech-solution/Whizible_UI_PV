            Public Shared Sub GetEmailMessage_21(ByRef strFromEmailID As String, ByRef strToEmailID As String, ByRef strCCToEmailID As String, ByRef strSubject As String, ByRef strEmailMessage As String, ByVal intProjectID As Integer)
                '=====================================================================
                ' Procedure Name		:	GetEmailMessage_21 (PROJECT INITIATION NOTIFICATION)
                ' Parameters Passed     :	strToEmailID	:- The EmailID of the person to whom the message will be returned.
                '							strSubject		:- The Subject of the Email Message.
                '							strEmailMessage	:- The body of the Email Message.	
                '							intProjectID	:- The project ID of the new project.
                ' Returns               :	
                ' Parameters Affected   :	strToEmailID, strSubject, strEmailMessage :- These values are returned by the subroutine by reference.
                ' Description           :	Generate the email message as defined in the System Email Messages table in the database.
                ' Purpose               :	Generate the email message as defined in the System Email Messages table in the database.
                ' Assumptions           :	The message ID exists in the database.
                '							The message does not contain any other parameters besides the following :
                '								1.	<NAME>
                '								2.	<SENDER_NAME>
                '								3.	<PROJECT_NAME>	
                '								4.	<INITIATED_BY>
                '								5.	<INITIATED_ON>
                '								6.	<APPROVED_BY>
                '								7.	<APPROVED_ON>
                '								8.	<TEAM_MEMBERS>
                '								9.	<PEAK_TEAM_SIZE>
                '								10.	<INFO_SYSTEMS_NOTES>
                '								11.	<HR_NOTES>
                '								12.	<ADMIN_NOTES>
                '								13.	<ENGINEERING_NOTES>
                ' Dependencies          :	None.
                ' Author                :	RajaniR
                ' Created               :	15th September 2001
                ' Revisions             :   By AbhijeetD 29th March 2004
                '                           Conversion of the function to .net
                '=====================================================================		

                Dim blnUseSQL As Boolean = CType(CommonFunction.General.GetApplicationKeySetting("UseSQL"), Boolean)

                Dim strUserName As String
                Dim strProjectName As String
                Dim drEmployee As IDataReader
                Dim drProject As IDataReader
                Dim drTeamMembers As IDataReader
                Dim drEmailMessage As IDataReader

                Dim intCtr As Integer
                Dim strTeamMemberList As String
                Dim strTempArray As String()
                Dim strListOfEmployeeIDs As String
                Dim strListOfEmployeeNames As String
                Dim strListOfEmailIDs As String
                Dim intMessageID As Integer

                intMessageID = 21

                '1. Code for String Builder Changes - IssueID - 6052 

                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                ' Get the message body, and subject.
                drEmailMessage = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_EmailMessages " + intMessageID.ToString, blnUseSQL)
                If drEmailMessage.Read Then
                    strEmailMessage = CommonFunction.Data.CheckIsDBNull(drEmailMessage("Body")).ToString
                    strSubject = CommonFunction.Data.CheckIsDBNull(drEmailMessage("Subject")).ToString
                    strListOfEmployeeIDs = CommonFunction.Data.CheckIsDBNull(drEmailMessage("ListOfEmployees")).ToString
                End If
                CommonFunction.Data.DisposeDataReader(drEmailMessage)


                '2. Code for String Builder Changes - IssueID - 6052 

                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                ' Retrieve information about the Project.
                Call GetProjectInfo(intProjectID, strProjectName, intMessageID, strCCToEmailID)
                strMessage.Replace("<PROJECT_NAME>", strProjectName)
                strEmailSubject.Replace("<PROJECT_NAME>", strProjectName)

                ' Retrieve information about the Sender.
                Call GetSenderInfo(strUserName, strFromEmailID)
                strMessage.Replace("<SENDER_NAME>", strUserName)

                drTeamMembers = CommonFunction.Data.GetDataReader("usp_Sel_EmployeeEmailAddresses " + intProjectID.ToString, blnUseSQL)
                While drTeamMembers.Read
                    ' Retrieve the name of the team members, and their posts, and format them.									
                    strTeamMemberList = strTeamMemberList + CommonFunction.Data.CheckIsDBNull(drTeamMembers("EmployeeName")).ToString + vbTab + " : " + CommonFunction.Data.CheckIsDBNull(drTeamMembers("RoleDescription")).ToString + vbCrLf
                End While

                ' Insert the formatted list of team members in the message.
                strMessage.Replace("<TEAM_MEMBERS>", strTeamMemberList)

                CommonFunction.Data.DisposeDataReader(drTeamMembers)

                ' Get the list of employees to whom the mail must be sent.
                strTempArray = strListOfEmployeeIDs.Split(","c)

                For intCtr = strTempArray.GetLowerBound(0) To strTempArray.GetUpperBound(0)
                    If Trim(strTempArray(intCtr) + "") <> "" Then
                        drEmployee = CommonFunction.Data.GetDataReader("usp_tbl_Sel_EmployeeInfo " + strTempArray(intCtr), blnUseSQL)
                        If drEmployee.Read Then
                            strListOfEmployeeNames = strListOfEmployeeNames + (CommonFunction.Data.CheckIsDBNull(drEmployee("UserName")).ToString + "") + ", "
                            ' Modified by RajaniR on Saturday, September 28, 2002 12:26.
                            If Trim(CommonFunction.Data.CheckIsDBNull(drEmployee("EmailID")).ToString + "") <> "" Then
                                strListOfEmailIDs = strListOfEmailIDs + (CommonFunction.Data.CheckIsDBNull(drEmployee("EmailID")).ToString + "") + "; "
                            End If
                            ' End Modification.
                        End If
                        CommonFunction.Data.DisposeDataReader(drEmployee)
                    End If
                Next

                If Right(strListOfEmployeeNames, 2) = ", " Then
                    strListOfEmployeeNames = Left(strListOfEmployeeNames, Len(strListOfEmployeeNames) - 2)
                End If

                If Trim(strListOfEmployeeNames) = "" Then
                    strListOfEmployeeNames = "All"
                End If

                strMessage.Replace("<NAME>", strListOfEmployeeNames)

                drProject = CommonFunction.Data.GetDataReader("usp_Sel_tbl_PM_PIN " + intProjectID.ToString, blnUseSQL)
                If drProject.Read Then

                    ' Initiated By.
                    If Trim(CommonFunction.Data.CheckIsDBNull(drProject("InitiatedByName")).ToString) <> "" Then
                        strMessage.Replace("<INITIATED_BY>", CommonFunction.Data.CheckIsDBNull(drProject("InitiatedByName")).ToString + "")
                    Else
                        strMessage.Replace("<INITIATED_BY>", "-")
                    End If

                    ' Initiation Date.
                    If Trim(CommonFunction.Data.CheckIsDBNull(drProject("InitiationDate")).ToString) <> "" Then
                        strMessage.Replace("<INITIATED_ON>", CommonFunction.Dates.CGetDate(CType(CommonFunction.Data.CheckIsDBNull(drProject("InitiationDate")), Date)))
                    Else
                        strMessage.Replace("<INITIATED_ON>", "-")
                    End If

                    ' Approved By.
                    If Trim(CommonFunction.Data.CheckIsDBNull(drProject("ApprovedByName")).ToString) <> "" Then
                        strMessage.Replace("<APPROVED_BY>", CommonFunction.Data.CheckIsDBNull(drProject("ApprovedBy")).ToString + "")
                    Else
                        strMessage.Replace("<APPROVED_BY>", "-")
                    End If

                    ' Approval Date.
                    If Trim(CommonFunction.Data.CheckIsDBNull(drProject("ApprovalDate")).ToString) <> "" Then
                        strMessage.Replace("<APPROVED_ON>", CommonFunction.Dates.CGetDate(CType(CommonFunction.Data.CheckIsDBNull(drProject("ApprovalDate")).ToString, Date)))
                    Else
                        strMessage.Replace("<APPROVED_ON>", "-")
                    End If

                    ' The Peak Team Size.
                    If Not CommonFunction.Data.CheckIsDBNull(drProject("PeakTeamSize")).ToString.Trim = "" Then
                        strMessage.Replace("<PEAK_TEAM_SIZE>", CommonFunction.Data.CheckIsDBNull(drProject("PeakTeamSize")).ToString & "")
                    Else
                        strMessage.Replace("<PEAK_TEAM_SIZE>", "Not specified.")
                    End If

                End If
                CommonFunction.Data.DisposeDataReader(drProject)

                strToEmailID = strListOfEmailIDs

                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing

            End Sub


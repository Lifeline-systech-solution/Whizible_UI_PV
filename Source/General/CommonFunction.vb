                Dim strUserName As String = ""
                Dim strProjectName As String = ""
                Dim strListOfReceivers As String = ""
                Dim lngProjectID As Long = 0
                Dim strComments As String = ""
                Dim intMessageID As Integer = 0
                Dim strTemp As String

                '1. Code for String Builder Changes - IssueID - 6052 
                Dim strMessage As System.Text.StringBuilder
                Dim strEmailSubject As System.Text.StringBuilder

                intMessageID = 5

                strQuery = "Exec usp_Sel_tbl_PM_TimesheetInvoice_Details " & intTimeSheetID.ToString()
                drTimesheet = CommonFunctions.Data.GetDataReader(strQuery, CType(CommonFunctions.General.GetApplicationKeySetting("UseSQL"), Boolean))
                If CommonFunctions.General.CheckIsNothing(drTimesheet) <> "" Then
                    If drTimesheet.Read() Then
                        strComments = drTimesheet.Item("Comments").ToString()
                        strComments = CommonFunctions.General.UnBuildQueryString(strComments)
                        If strComments = "" Then strComments = "No Comments"
                        lngProjectID = CType(CommonFunctions.Data.CheckIsDBNull(drTimesheet.Item("ProjectID"), "0"), Long)
                    End If
                End If
                CommonFunctions.Data.DisposeDataReader(drTimesheet)

                ' Get the message body, and subject.
                strEmailMessage = funcGetEmailMessageForProject(lngProjectID, intMessageID, strSubject)

                '2. Code for String Builder Changes - IssueID - 6052 
                strMessage = New System.Text.StringBuilder("")
                strEmailSubject = New System.Text.StringBuilder("")
                strMessage.Append(strEmailMessage)
                strEmailSubject.Append(strSubject)

                ' Retrieve information about the Project.
                Call GetProjectInfo(lngProjectID, strProjectName, intMessageID, strCCToEmailID)
                strMessage.Replace("<PROJECT_NAME>", strProjectName)
                strEmailSubject.Replace("<PROJECT_NAME>", strProjectName & " [Timesheet No : " & intTimeSheetID.ToString() & "]")

                ' Retrieve information about the Sender.
                Call GetSenderInfo(strUserName, strFromEmailID)

                strQuery = "EXEC usp_Sel_CustomerEmailIDForTimeSheet " & lngProjectID.ToString
                strCCToEmailID = strFromEmailID & ";"
                drTimesheet = CommonFunctions.Data.GetDataReader(strQuery, CType(CommonFunctions.General.GetApplicationKeySetting("UseSQL"), Boolean))
                If CommonFunctions.General.CheckIsNothing(drTimesheet) <> "" Then
                    While drTimesheet.Read()
                        strTemp = drTimesheet.Item("EmailID").ToString().Trim()
                        If strTemp <> "" Then
                            strTemp = CommonFunctions.General.UnBuildQueryString(strTemp)
                            strCCToEmailID &= strTemp & ";"
                        End If

                    End While
                End If
                CommonFunctions.Data.DisposeDataReader(drTimesheet)
                strMessage.Replace("<SENDER_NAME>", strUserName)

                strMessage.Replace("<COMMENTS>", strComments)

                ' Retrieve information about the PERSON RESPONSIBLE FOR GENERATING INVOICE.
                strQuery = "Exec usp_sel_ProjectManager_For_RejectTimeSheet " & intTimeSheetID.ToString()
                drTimesheet = CommonFunctions.Data.GetDataReader(strQuery, CType(CommonFunctions.General.GetApplicationKeySetting("UseSQL"), Boolean))
                If CommonFunctions.General.CheckIsNothing(drTimesheet) <> "" Then
                    ' If drTimesheet.Read() Then
                    If strCCToEmailID <> "" Then strCCToEmailID &= ";"
                    'Modified By VivekP On 11 Aug 2005 For WhizibleSEM Sp4 IssueID-87
                    Do While drTimesheet.Read

                        'strCCToEmailID &= drTimesheet.Item("EmailID").ToString()
                        strToEmailID &= drTimesheet.Item("EmailID").ToString() & ";"


                        'End If
                    Loop
                    'End Of Modification By VivekP On 11 Aug 2005 For WhizibleSEM Sp4 IssueID-87
                End If
                CommonFunctions.Data.DisposeDataReader(drTimesheet)

                If Trim(strListOfReceivers) = "" Then
                    strListOfReceivers = "All"
                End If

                strMessage.Replace("<NAME>", strListOfReceivers)

                '4. Code for String Builder Changes - IssueID - 6052 
                strEmailMessage = strMessage.ToString
                strSubject = strEmailSubject.ToString

                '5. Code for String Builder Changes - IssueID - 6052 
                strMessage = Nothing
                strEmailSubject = Nothing


            End Sub


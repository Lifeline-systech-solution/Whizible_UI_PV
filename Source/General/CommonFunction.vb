        ''' <summary>
        ''' Opt-in rate limit for WebMethod write operations (same algorithm as API ValidateRateLimit).
        ''' Web.config: RateLimit_Enabled, RateLimit_Duration_Minutes, RateLimit_Count.
        ''' Returns True when the caller should respond with HTTP 429.
        ''' Added by Vishal Mane on 29/05/2026.
        ''' ''' </summary>
        'Commented and Added by Vishal Mane on 03/06/2026 to apply Rate Limit on Save/Update/Delete methods only
        Private Structure RateLimitEntry
            Public Count As Integer
            Public Timestamp As DateTime
        End Structure

        Private Shared ReadOnly RequestCounts As New Dictionary(Of String, RateLimitEntry)()
        Private Shared ReadOnly SyncRoot As New Object()
        Public Shared Function CheckRateLimit(request As HttpRequest) As Boolean
            If request Is Nothing Then
                Return False
            End If

            If Not IsRateLimitEnabled() Then
                Return False
            End If

            Dim durationMinutes As Integer = GetConfigInt("RateLimit_Duration_Minutes", 1)
            Dim maxCount As Integer = GetConfigInt("RateLimit_Count", 100)
            Dim key As String = GetRateLimitKey(request)
            Dim rateLimited As Boolean = False

            SyncLock SyncRoot
                If Not RequestCounts.ContainsKey(key) Then
                    RequestCounts(key) = New RateLimitEntry With {
                        .Count = 1,
                        .Timestamp = DateTime.UtcNow
                    }
                Else
                    Dim entry As RateLimitEntry = RequestCounts(key)
                    If (DateTime.UtcNow - entry.Timestamp).TotalMinutes < durationMinutes Then
                        If entry.Count >= maxCount Then
                            rateLimited = True
                        Else
                            entry.Count += 1
                            RequestCounts(key) = entry
                        End If
                    Else
                        RequestCounts(key) = New RateLimitEntry With {
                            .Count = 1,
                            .Timestamp = DateTime.UtcNow
                        }
                    End If
                End If
            End SyncLock

            Return rateLimited
        End Function

        Private Shared Function IsRateLimitEnabled() As Boolean
            Dim enabled As Object = CommonFunctions.General.GetApplicationKeySetting("RateLimit_Enabled")
            If enabled Is Nothing Then
                Return True
            End If
            Dim enabledText As String = enabled.ToString().Trim()
            Return Not (String.Equals(enabledText, "false", StringComparison.OrdinalIgnoreCase) OrElse enabledText = "0")
        End Function

        Private Shared Function GetConfigInt(key As String, defaultValue As Integer) As Integer
            Dim value As Object = CommonFunctions.General.GetApplicationKeySetting(key)
            If value Is Nothing Then
                Return defaultValue
            End If
            Dim parsed As Integer
            If Integer.TryParse(value.ToString(), parsed) Then
                Return parsed
            End If
            Return defaultValue
        End Function

        Private Shared Function GetRateLimitKey(request As HttpRequest) As String
            Dim ip As String = GetClientIp(request)
            Dim pageName As String = System.IO.Path.GetFileName(request.Path)
            Dim methodName As String = GetCallingWebMethodName()
            Dim userKey As String = String.Empty

            If HttpContext.Current IsNot Nothing Then
                If HttpContext.Current.Session IsNot Nothing AndAlso HttpContext.Current.Session("intUserID") IsNot Nothing Then
                    userKey = HttpContext.Current.Session("intUserID").ToString()
                ElseIf HttpContext.Current.User IsNot Nothing AndAlso HttpContext.Current.User.Identity IsNot Nothing Then
                    userKey = HttpContext.Current.User.Identity.Name
                End If
            End If

            Return ip & "|" & pageName & "|" & methodName & "|" & userKey
        End Function

        Private Shared Function GetClientIp(request As HttpRequest) As String
            If request IsNot Nothing AndAlso Not String.IsNullOrEmpty(request.UserHostAddress) Then
                Return request.UserHostAddress
            End If
            Return "unknown"
        End Function

        Private Shared Function GetCallingWebMethodName() As String
            Try
                Dim stack As New System.Diagnostics.StackTrace()
                For i As Integer = 1 To stack.FrameCount - 1
                    Dim frame As System.Diagnostics.StackFrame = stack.GetFrame(i)
                    Dim method = frame.GetMethod()
                    If method Is Nothing Then
                        Continue For
                    End If
                    Dim declaringType = method.DeclaringType
                    If declaringType IsNot Nothing AndAlso declaringType.Name = "RateLimiter" Then
                        Continue For
                    End If
                    Return method.Name
                Next
            Catch
            End Try
            Return "unknown"
        End Function

    End Class

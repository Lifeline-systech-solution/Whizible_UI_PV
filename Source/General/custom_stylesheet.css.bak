/*******TreeBody styling Start*****/
/*Added By Vaijat K ON 28/11/2015*/
#PageDiv #divControls .clsTable a
{
    text-decoration: underline !important; /*Added By Vaijat K ON 21/12/2015*/
}
 .gridFootable tr td a {
        text-decoration:underline !important;           /* ADDED BY PUNEET M ON 24-11-2015 ANCHOR UNDERLINE IN GRID */
    }
     .clsPageBody .clsGridTable tr td a
    {
        text-decoration:underline !important; /* ADDED BY Vaijat K ON 18/12/2015 ANCHOR UNDERLINE IN GRID */
    }
     #divItems .clsGridTable tr td a
    {
        text-decoration:underline !important; /* ADDED BY Vaijat K ON 18/12/2015 ANCHOR UNDERLINE IN GRID */
       white-space: pre-wrap !important; /* ADDED BY dIPALI v oN 8TH jUNE 2020 fOR DATA SHOULD BE display proper in grid */
      word-break: break-word !important;
    }


 #divItems .clsGridTable tr td 
    {
        text-decoration:underline !important; /* ADDED BY Vaijat K ON 18/12/2015 ANCHOR UNDERLINE IN GRID */
       white-space: pre-wrap !important; /* ADDED BY dIPALI v oN 8TH jUNE 2020 fOR DATA SHOULD BE display proper in grid */
      word-break: break-word !important;
    }


#divListTag .clsGridTable tr td a {
    text-decoration: underline !important; /* ADDED BY Vaijat K ON 18/12/2015 ANCHOR UNDERLINE IN GRID */
    white-space: pre-wrap !important; /* ADDED BY dIPALI v oN 8TH jUNE 2020 fOR DATA SHOULD BE display proper in grid */
    word-break: break-word !important;
}



#divListTag .clsGridTable tr td  {
    text-decoration: underline !important; /* ADDED BY Vaijat K ON 18/12/2015 ANCHOR UNDERLINE IN GRID */
    white-space: pre-wrap !important; /* ADDED BY dIPALI v oN 8TH jUNE 2020 fOR DATA SHOULD BE display proper in grid */
    word-break: break-word !important;
}

#divListTag .clsGridTable tr td a :hover{
    text-decoration: underline !important; /* ADDED BY Vaijat K ON 18/12/2015 ANCHOR UNDERLINE IN GRID */
    white-space: pre-wrap !important; /* ADDED BY dIPALI v oN 8TH jUNE 2020 fOR DATA SHOULD BE display proper in grid */
    word-break: break-word !important;
}

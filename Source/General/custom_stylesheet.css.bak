body
{
	margin:0px;
    overflow: hidden;
}

BODY.clsBody
{
	/*margin: 0px !important;*/
	padding: 0px 2px 0px 2px !important;
	border: 0px;
}

#tree
{
    
    font-size: 12px !important;
    font-weight:700;
}

#tree a
{
    
    font-size: 12px !important;
    font-weight: normal !important;
}

.footable
{
	border-spacing: 0px !important;
}


.footable thead tr th
{
	padding:3px !important;
}

.iframeLinks
{
	float: left;
	width: 100%;
	height:30px;
	display: block;
	border:none;
}
#tblGrid01034 a 
{
	font-size:12px;
}

/*.iframeTreeMain
{
    float:left;
    width:20%;
    display:block;
	border:none;
}*/
/*Added by Dhanashri S for Test*/
.iframeSub
{
    float:left;
    /*width:69.7%;*/
	width:100%;
    display:block;
	border:none;
}
/*End of Addition by Dhanashri S*/
.hideTree
{
    width: 100% !important;
}

.clsTableBannerFrame
{
	margin-right:10px;
}

#tree
{
/*	overflow-y:hidden !important;
	overflow-x:hidden !important;
*/
	height:100%;
}

#divListPageTag
{
    /*margin-top: 1%;*/
}

/*Added by Dhanashri 4 Mar 2015*/
.clsGridTable td
{
    
    padding: 3px !important;
    border-right: 1px solid #d6d5d7;
}
/*Ended by Dhanashri*/
.clsGridTable th
{
    border-right: 1px solid #c2c2c2 !important;
}

/*Context Menu hover */
tr.CtMn_Node_Hover
{
    background: #F9D49F !important;
}


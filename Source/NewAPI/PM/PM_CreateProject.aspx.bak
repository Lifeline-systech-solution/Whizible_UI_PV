                    $('#newprobasicinformation').addClass("active");
                    $('.newprojectabtmenu li a[href="#newprobasicinformation"]').tab('show');
                }
                //prevStep();   



            });

            $(document).on("click", ".budget_tbl .add", function () {
                var empty = false;
                var input = $(this).parents("tr").find('input[type="text"]');
                var select = $(this).parents("tr").find('select');
                //console.log(select);
                input.each(function () {
                    if (!$(this).val()) {
                        $(this).addClass("error");
                        empty = true;
                    } else {
                        $(this).removeClass("error");
                    }
                });

                select.each(function () {
                    if (!$(this).parent("td").html($(this).val())) {
                        $(this).addClass("error");
                        empty = true;
                    } else {
                        $(this).removeClass("error");
                    }
                });

                select.each(function () {
                    $(this).parent("td").html($(this).val());
                });

                $(this).parents("tr").find(".error").first().focus();
                if (!empty) {
                    input.each(function () {
                        $(this).parent("td").html($(this).val());
                    });
                    select.each(function () {
                        $(this).parent("td").html($(this).val());
                    });
                    $(this).parents("tr").find(".add, .edit").toggle();
                    $(this).parents("tr").find(".delete, .cancelrowvalue").toggle();
                    $(".budget_tbl .add-new").removeAttr("disabled");
                }
            });
            
            //Cancel row value
            $(document).on("click", ".budget_tbl .cancelrowvalue", function () {
                try {
                    var empty = false;
                    var input = $(this).parents("tr").find('input[type="text"]');
                    var select = $(this).parents("tr").find('select');

                    input.each(function () {
                        $(this).parent("td").html($(this).html('<span data-bs-toggle="tooltip" title="John Smith" class="usernameshort circle-bggreen usernamecirclesmall"></span>'));
                        $(this).parent("td").html();
                    });
                    select.each(function () {
                        $(this).parent("td").html($(this).val());
                    });
                    $(this).parents("tr").find(".add, .edit").toggle();
                    $(this).parents("tr").find(".delete, .cancelrowvalue").toggle();
                }
                catch (ex) {
                    //alert(ex.message);
                }
            });


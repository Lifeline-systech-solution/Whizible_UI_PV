                                $("#textDuration").prop("disabled", true);
                                if (globalrevisionFlag == "Revision") {
                                    $("#texthours").prop("disabled", false);
                                    $("#dtProjectStartDate").prop("disabled", false);
                                    $("#dtProjectEndDate").prop("disabled", false);
                                }

                                //Added By Usha Pandit For Changes on 17.01.2020 for work hrs enable disable
                                if (globalWFstatus.indexOf("Sent for Approval") != -1) {

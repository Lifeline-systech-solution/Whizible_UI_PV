        function ConvertDate(str)
        {           
            var date = new Date(str),
            mnth = ("0" + (date.getMonth() + 1)).slice(-2),
            day = ("0" + date.getDate()).slice(-2);

            if (mnth == "01") {
                mnth = "Jan";
            }
            else if (mnth == "02") {
                mnth = "Feb";
            }
            else if (mnth == "03") {
                mnth = "Mar";
            }
            else if (mnth == "04") {
                mnth = "Apr";
            }
            else if (mnth == "05") {
                mnth = "May";
            }
            else if (mnth == "06") {
                mnth = "Jun";
            }
            else if (mnth == "07") {
                mnth = "Jul";
            }
            else if (mnth == "08") {
                mnth = "Aug";
            }
            else if (mnth == "09") {
               // mnth = "Sept";
                mnth = "Sep";
            }
            else if (mnth == "10") {
                mnth = "Oct";
            }
            else if (mnth == "11") {
                mnth = "Nov";
            }
            else if (mnth == "12") {
                mnth = "Dec";
            }
            return [day, mnth,date.getFullYear() ].join(" ");
        }

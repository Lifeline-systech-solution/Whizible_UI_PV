                            if (blnBasicActive == true) {
                            }
                            else {
                                nextStep();
                            }                           
                            globalProjectId = prjResult[0];
                            curProjectBudgetValue = prjResult[1];
                            curProjectSumOfAllBillAmt = prjResult[2];
                            curProjectCurrencyCode = prjResult[4];
                            curCorporateCurrencyCode = prjResult[5];
                            curGlobalConversionRate = prjResult[6];

                            globalResourceCount = NoOfResource;
                            $("#cboMilestoneCurrency").attr('disabled', false);
                            $("#cboMilestoneCurrency").val(prjResult[3]);
                            $("#cboMilestoneCurrency").attr('disabled', true);
                            curMilestoneNotStoredBillAmt = 0;
                            
                            if (WhichAction == "C") {
                                currentDiscussionFlag = 'Project';
                            }

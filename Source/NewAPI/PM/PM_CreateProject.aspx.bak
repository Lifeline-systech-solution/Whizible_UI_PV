        function Edit_ResourceCost(ResourceCostID, enableEditForAmount, editMode, e) {
            if (IsSaveButtonEnabled == 0) {
                $("#modalResourceCost").attr("disabled", true);
                if (Browser == 'IE') {
                }
                else {
                    $("#modalResourceCost").css({ 'pointer-events': 'none' });
                }
                EnableDisableResourceCostFields(false, ResourceCostID, enableEditForAmount, editMode);
                $('#editNoOfResource' + ResourceCostID + ' , #editAllocation' + ResourceCostID).on('input', function () {
                    if ($('#labelBudgetChangeHidden' + ResourceCostID).hasClass("clsOriginalBudgetChange") == false) {
                        getBudgetForResourceEdit(ResourceCostID);
                    }
                });
                $("#editResourceCostStartDate" + ResourceCostID + ", #editResourceCostEndDate" + ResourceCostID).change(function () {
                    if ($('#labelBudgetChangeHidden' + ResourceCostID).hasClass("clsOriginalBudgetChange") == false) {
                        getBudgetForResourceEdit(ResourceCostID);
                    }
                });
                curEditNoOfResource = $("#editNoOfResource" + ResourceCostID).val();

                $(".input-group-btn .btncalendar").css({ "padding": "4px 8px" });
                $(".form-control").css({ "padding": "4px 8px" });

                $(e).addClass("clseditmodeactive" + ResourceCostID);
                $(".clseditmodeactive" + ResourceCostID).addClass("editactive");
            }

        }
        function EnableDisableResourceCostFields(flag, ResourceCostID, enableEditForAmount, editMode) {
            $("#editNoOfResource" + ResourceCostID).attr("disabled", flag);
            $("#editNoOfResource" + ResourceCostID).attr("readonly", flag);
            $("#editResourceCostStartDate" + ResourceCostID).attr("disabled", flag);
            $("#editResourceCostStartDate" + ResourceCostID).attr("readonly", flag);
            $("#editResourceCostEndDate" + ResourceCostID).attr("disabled", flag);
            $("#editResourceCostEndDate" + ResourceCostID).attr("readonly", flag);
            $("#editBudget" + ResourceCostID).attr("disabled", flag);
            $("#editBudget" + ResourceCostID).attr("readonly", flag);
            $("#editRoleCost" + ResourceCostID).attr("disabled", flag);
            $("#editRoleCost" + ResourceCostID).attr("readonly", flag);

            if (flag == false) {
                $(".clsResourceCalendar" + ResourceCostID).removeClass("clsShowHide");
                $("#editAllocation" + ResourceCostID).removeClass("clsShowHide");
                $(".curResourceProgress" + ResourceCostID).addClass("clsShowHide");
            }
            else {
                $(".clsResourceCalendar" + ResourceCostID).addClass("clsShowHide");
                $(".curResourceProgress" + ResourceCostID).removeClass("clsShowHide");
                $("#editAllocation" + ResourceCostID).addClass("clsShowHide");
            }
            if (editMode == "singleEditMode") {
                var editval = $("#editAllocation" + ResourceCostID).val();
                $(".curResourceProgress" + ResourceCostID + " .progress-bar").css("cssText", "width: " + editval + "%;color:black;");
                $(".curResourceProgress" + ResourceCostID + " .progress-bar").text(editval + "%");
            }
            //if (flag == false && enableEditForAmount == 0) {
            //    $("#editIsActiveCostHead" + WorkOrderCostID).attr("disabled", flag);
            //}
            //else {
            //    $("#editCostToCompany" + WorkOrderCostID).attr("disabled", flag);
            //    $("#editReimbersable" + WorkOrderCostID).attr("disabled", flag);
            //    $("#editBillable" + WorkOrderCostID).attr("disabled", flag);
            //    $("#editCostToCompany" + WorkOrderCostID).attr("readonly", flag);
            //    $("#editReimbersable" + WorkOrderCostID).attr("readonly", flag);
            //    $("#editBillable" + WorkOrderCostID).attr("readonly", flag);
            //    if (editMode != "changeMode") {
            //        $("#editIsActiveCostHead" + WorkOrderCostID).attr("disabled", flag);
            //    }
            //}
            //if (flag == true && enableEditForAmount == 0) {
            //    $("#editIsActiveCostHead" + WorkOrderCostID).attr("checked", false);
            //}
        }
        function EnableDisableProjectCostFields(flag, WorkOrderCostID, enableEditForAmount, editMode) {
            if (flag == false && enableEditForAmount == 0) {
                $("#editIsActiveCostHead" + WorkOrderCostID).attr("disabled", flag);
            }
            else {
                $("#editCostToCompany" + WorkOrderCostID).attr("disabled", flag);
                $("#editReimbersable" + WorkOrderCostID).attr("disabled", flag);
                $("#editBillable" + WorkOrderCostID).attr("disabled", flag);
                $("#editCostToCompany" + WorkOrderCostID).attr("readonly", flag);
                $("#editReimbersable" + WorkOrderCostID).attr("readonly", flag);
                $("#editBillable" + WorkOrderCostID).attr("readonly", flag);
                if (editMode != "changeMode") {
                    $("#editIsActiveCostHead" + WorkOrderCostID).attr("disabled", flag);
                }
            }
            if (flag == true && enableEditForAmount == 0) {
                $("#editIsActiveCostHead" + WorkOrderCostID).attr("checked", false);
            }
        }
        function Save_milestone() {
            if (Validatemilestone() == 0) {
                var MileStoneName = $("#textMilestoneName").val();
                var StartDate = $("#dtMilestoneStartDate").val();
                var EndDate = $("#dtMilestoneEndDate").val();
                var BillAmount = $("#textMilestonebillamount").val();
                var Currency = $("#cboMilestoneCurrency").val();

                if (BillAmount == "") {
                    BillAmount = 0;
                }

                if (SelectedMilestonID != "")
                {
                    MileStoneID = SelectedMilestonID;
                } else {
                    //MileStoneID = "NULL";
                    MileStoneID = "0";
                }

                var Data = {
                    MileStoneID: encodeURI(MileStoneID),
                    ProjectID: encodeURI(globalProjectId),
                    MileStoneName: encodeURI(MileStoneName),//Add,Edit Mode
                    StartDate: encodeURI(StartDate),
                    EndDate: encodeURI(EndDate),
                    BillAmount: encodeURI(BillAmount),
                    //Currency: encodeURI(Currency),
                    //UserID: encodeURI(UserID),
                    StrUserName: encodeURI(StrUserName),
                    FromWhichMode: encodeURI(MilestoneMode),
                    WhichAction: encodeURI(WhichAction),
                }              
                StartLoader("#BodyCreateProject")
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/Save_MileStoneDetails'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (Result) {
                        // debugger;                        
                        if (Result != "") {
                            StopAjaxLoader("#BodyCreateProject");
                            alertify.set('notifier', 'position', 'top-right');
                            if (SelectedMilestonID != "") {
                                alertify.notify('<%= MyBase.GetResourceString("A_MilestoneUpdate") %>', 'success', 5);
                            }
                            else {
                                alertify.notify('<%= MyBase.GetResourceString("A_Milestone") %>', 'success', 5);
                            }
                            $("#addnew_Milestonemodal").modal('hide');
                            GetMileStoneDetails();
                            ClearAllMileStoneControls();
                            collapseExpandPanel("collapse");
                            //$("#btnDraft").addClass('next-step');

                            //Added By Dipali V On 15th Oct 2020 For 2020 For Get According to Contract type Section should display 
                            if ($("#CboCompanyengagemnt").val() != 0) {
                                var curContractType = $("#CboCompanyengagemnt").val();
                                ShowHideMileStoneSite(curContractType);
                            }
                            //End of Added By Dipali V On 15th Oct 2020 For 2020 For Get According to Contract type Section should display

                        }
                        $(".nav-tabs li:nth-child(2)").addClass("Compltedstep");
                        var currentImagePath = "../../../Whizible2.0-new/dist/img/tick-green.svg";
                        $(".nav-tabs li:nth-child(2)").find(".completeicon").find("img").attr("src", currentImagePath);
                    },
                    error: function (err) {
                        // alert("error");
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
            }
        }
        function SaveProjectCostDetails(ProjectCostId, e, CostHeadDetails) {
            var flag = "";
            var CostHead = "";
            var CostToCompany = "";
            var Reimbursable = "";
            var Billable = "";
            var IsActive = 0;
            var curDescription = "";

            if (CostHeadDetails == "details") {
                ProjectCostId = globalWorkOrderCostID;
            }
            if (ProjectCostId == 0) {
                flag = "New";
            }
            else {
                flag = "Edit";
            }

            if (ValidateProjectCost(flag, ProjectCostId, CostHeadDetails) == 0) {
                if (flag == "Edit" && CostHeadDetails != "details") {
                    CostHead = $("#txtCostHeadHidden" + ProjectCostId).val();
                    CostToCompany = $("#editCostToCompany" + ProjectCostId).val();
                    Reimbursable = $("#editReimbersable" + ProjectCostId).val();
                    Billable = $("#editBillable" + ProjectCostId).val();
                    if ($("#editIsActiveCostHead" + ProjectCostId).is(':checked')) {
                        IsActive = 1;
                    }
                }
                else if (flag == "Edit" && CostHeadDetails == "details") {
                    CostHead = globalCostHeadID;
                    CostToCompany = $("#editCostToCompany").val();
                    Reimbursable = $("#editReimbursable").val();
                    Billable = $("#editBillable").val();
                    curDescription = $("#editDescription").val();
                    if ($("#chkIsActive").is(':checked')) {
                        IsActive = 1;
                    }
                }
                else if (flag == "New" && CostHeadDetails == "details") {
                    CostHead = $("#CPCostHead_0 option:selected").val();
                    CostToCompany = $("#editCostToCompany").val();
                    Reimbursable = $("#editReimbursable").val();
                    Billable = $("#editBillable").val();
                    curDescription = $("#editDescription").val();
                    if ($("#chkIsActive").is(':checked')) {
                        IsActive = 1;
                    }
                }
                else {
                    CostHead = $("#CPCostHead_0 option:selected").val();
                    CostToCompany = $("#editCostToCompany0").val();
                    Reimbursable = $("#editReimbersable0").val();
                    Billable = $("#editBillable0").val();
                    IsActive = 1;
                }
                //added by imran on 06-09-2022 
                if (Billable == "") {
                    Billable = 0;
                }

                if (SelectedProjectCurrency == "") {
                    SelectedProjectCurrency = 0;
                }
                //End of comment by imran on 06-09-2022 
                
                var Data = {
                    WorkOrderCostID: encodeURI(ProjectCostId),
                    ProjectID: encodeURI(globalProjectId),
                    CurrencyID: encodeURI(SelectedProjectCurrency),
                    Billable: encodeURI(Billable),
                    Reimbersable: encodeURI(Reimbursable),
                    CostToCompany: encodeURI(CostToCompany),
                    IsActive: encodeURI(IsActive),
                    CostHeadID: encodeURI(CostHead),
                    Description: encodeURI(curDescription),
                    UserName: encodeURI(StrUserName),
                    WhichAction: encodeURI(WhichAction)
                }               
                StartLoader("#BodyCreateProject")
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/Save_ProjectCostDetails'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (Result) {
                        // debugger;                        
                        if (Result != "") {
                            StopAjaxLoader("#BodyCreateProject");
                            alertify.set('notifier', 'position', 'top-right');
                            if (flag == "Edit") {
                                alertify.notify('<%= MyBase.GetResourceString("A_ProjectCostUpdate") %>', 'success', 5);
                                //$(".clsEditProjectCost").attr("disabled", false);
                            }
                            else {
                                alertify.notify('<%= MyBase.GetResourceString("A_ProjectCost") %>', 'success', 5);
                            }
                            //$("#CPaddnewsitemodal").modal('hide');
                            //GetProjectCostDetails(0);

                            EnableDisableNavigateLinks("Enable", "Project Cost");
                            if (flag == "Edit" && CostHeadDetails != "details") {
                                GetProjectCostDetails(0, 0, 0, "Edit");
                                $("#editCostToCompanyHidden" + ProjectCostId).val(CostToCompany);
                                $("#editReimbersableHidden" + ProjectCostId).val(Reimbursable);
                                $("#editBillableHidden" + ProjectCostId).val(Billable);
                                var blnEditActiveExist = false;
                                $(".clsprojeditmodeactive" + ProjectCostId).removeClass("projeditactive");
                                var rows = tableProjectCost.rows({ 'search': 'applied' }).nodes();
                                $('*[class*=clsprojeditmodeactive]', rows).each(function () {
                                    if ($(this).hasClass("projeditactive")) {
                                        blnEditActiveExist = true;
                                    }
                                });

                                if (blnEditActiveExist == false) {
                                    $(".clsEditEditProjectCost", rows).attr("disabled", false);
                                    if (Browser == 'IE') {
                                    }
                                    else {
                                        $(".clsEditEditProjectCost", rows).css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                                    }
                                }
                            }
                            else {
                                GetProjectCostDetails(0);
                            }
                            if (flag == "New" && CostHeadDetails == "details") {
                                FillCostHeadCombox();
                                $(".procostdetailpanel").hide();
                            }
                            if (flag == "Edit" && CostHeadDetails == "details") {
                                $("#CPCostHead_0").addClass("clsShowHide");
                                $("#editCostHead").removeClass("clsShowHide");
                                $("#costheaddetailslist").removeClass("clsShowHide");
                                $(".procostdetailpanel").hide();
                            }
                            else {
                                $("#CPCostHead_0").removeClass("clsShowHide");
                                $("#editCostHead").addClass("clsShowHide");
                                $("#costheaddetailslist").addClass("clsShowHide");
                            }
                            $(".addnewcostbtn").attr("disabled", false);
                            if (Browser == 'IE') {
                            }
                            else {
                                $(".addnewcostbtn").css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                            }
                            if (flag == "Edit") {
                                EnableDisableProjectCostFields(true, ProjectCostId, 1, "singleEditMode");
                                cancelEdit_ProjectCost(ProjectCostId, 1, "cancelModeEdit");
                            }
                        }
                        else {
                            StopAjaxLoader("#BodyCreateProject");
                        }
                        if (WhichAction == "C") {
                            if (cntActualProjectCost > 0 || cntResourceCost > 0) {
                                $(".nav-tabs li:nth-child(3)").addClass("Compltedstep");
                                var currentImagePath = "../../../Whizible2.0-new/dist/img/tick-green.svg";
                                $(".nav-tabs li:nth-child(3)").find(".completeicon").find("img").attr("src", currentImagePath);
                            }
                            else {
                                $(".nav-tabs li:nth-child(3)").addClass("Compltedstep");
                                var currentImagePath = "../../../Whizible2.0-new/dist/img/tick-orange.svg";
                                $(".nav-tabs li:nth-child(3)").find(".completeicon").find("img").attr("src", currentImagePath);
                            }
                        }
                        collapseExpandPanel("collapse");
                    },
                    error: function (err) {
                        // alert("error");
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
            }
            else {
                $(e).parents("tr").find(".add, .edit").toggle();
                $(e).parents("tr").find(".delete, .cancelrowvalue").toggle();
            }
            if (cntActualProjectCost > 0 || cntResourceCost > 0) {
                $(".nav-tabs li:nth-child(3)").addClass("Compltedstep");
                var currentImagePath = "../../../Whizible2.0-new/dist/img/tick-green.svg";
                $(".nav-tabs li:nth-child(3)").find(".completeicon").find("img").attr("src", currentImagePath);
            }
            else {
                $(".nav-tabs li:nth-child(3)").addClass("Compltedstep");
                var currentImagePath = "../../../Whizible2.0-new/dist/img/tick-orange.svg";
                $(".nav-tabs li:nth-child(3)").find(".completeicon").find("img").attr("src", currentImagePath);
            }
        }

        function setDeleteProjectCost(ProjectCostId) {
            $('*[id*=Delete_ProjectCost_]').each(function () {
                $(this).removeClass("clsdeleteProjectCost");
            });
            $("#" + ProjectCostId).addClass("clsdeleteProjectCost");
        }
        function setDeleteCostHead() {
            $("#btnDeleteCostHead").removeAttr("data-bs-target");
            var curProjectCostHeadIds;
            var rows = tableProjectCostHead.rows({ 'search': 'applied' }).nodes();

            curProjectCostHeadIds = $('input[class="costheadchck"]:checked:not(:disabled)', rows).map(function () {
                return this.value;
            }).get().join(',');

            if (curProjectCostHeadIds == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("C_CostHeadDelete") %>', 'error', 5);
                $("#chkCostHeadAll").focus();
                return;
            }
            else {
                $("#btnDeleteCostHead").attr("data-bs-target", "#deleteProjectCostHeadmodal");
            }
        }
        function setDeleteResourceCost(ProjectCostId) {
            $('*[id*=Delete_ResourceCost_]').each(function () {
                $(this).removeClass("clsdeleteResourceCost");
            });
            $("#" + ProjectCostId).addClass("clsdeleteResourceCost");
        }
        function setDeleteProjectSite(ProjectSiteId) {
            $('*[id*=Delete_ProjectSite_]').each(function () {
                $(this).removeClass("clsdeleteProjectSite");
            });

            $("#" + ProjectSiteId).addClass("clsdeleteProjectSite");

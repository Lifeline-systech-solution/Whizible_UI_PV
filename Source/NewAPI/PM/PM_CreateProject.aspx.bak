        function GetResourceCostOUDuration() {
            var objStart = document.getElementById("dtCostResourceStartDate");
            var objEnd = document.getElementById("dtCostResourceEndDate");

            var dtstart = new Date(objStart.value);
            var dtend = new Date(objEnd.value);
            if (isNaN(dtstart.getTime()) && isNaN(dtend.getTime())) {
            }
            else {
                if (objStart.value != "" && objEnd.value != "") {
                    var Data = { strStartDate: objStart.value, strEndDate: objEnd.value, ProjectID: FromWhereProjectId, UserID: UserID, OU: $("#cboProjectOU").val(), FromWhereData: WhichAction };
                    $.ajax({
                        url: encodeURI(strUrl + '/api/PM_CreateProject/GetOUDuration'),
                        type: "POST",
                        data: JSON.stringify(Data),
                        dataType: "json",
                        contentType: "application/json;charset-utf=8",
                        async: false,
                        beforeSend: function (xhr) {
                            xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                            if (Data) {
                                xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                            }
                        },
                        success: function (result) {
                            SetResourceCostWorkDays = result;
                        },
                        error: function (err) {
                            console.log(err);
                            window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                        }
                    });
                }
            }
        }
        function GetResourceCostOUHours() {
            SetResourceCostWorkHours = "";
            if ($("#cboProjectOU").val() != "") {
                var Data = { OU: $("#cboProjectOU").val() };
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/GetWorkingHrByOU'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (result) {
                        if (result != "") {
                            for (var i = 0; i < result.length; i++) {
                                var obResult = result[i];
                                var NoResource = $("#textNoOfCostResources").val();
                                var ResourceCostRole = $("#cboResourceCostRole option:selected").val();
                                SetResourceCostWorkHours = obResult.WorkingHours;

                                var AllocationPercentage = $("#textCostResourceAllocation").val();
                                var curRoleCost = $("#textCostResourceMaxRate").val();
                                var TotalWorkDays = (parseInt(SetResourceCostWorkDays) * parseInt(AllocationPercentage)) / 100;

                                var AllResourceTotalWorkDays = NoResource * TotalWorkDays;

                                var AllResourceTotalWorkHrs = AllResourceTotalWorkDays * SetResourceCostWorkHours;

                                var TotalBudget = AllResourceTotalWorkHrs * curRoleCost;


                                if (ResourceCostRole == 0) {
                                    TotalBudget = parseFloat(0).toFixed(2);
                                }
                                if (curGlobalConversionRate == 0) {
                                    curGlobalConversionRate = 1;
                                }
                                TotalBudget = TotalBudget * parseFloat(curGlobalConversionRate);
                                TotalBudget = parseFloat(TotalBudget).toFixed(2);
                                $("#textCostResourceBudget").val(TotalBudget);
                                globalOriginalBudgetValue = TotalBudget;
                                if (globalOriginalBudgetChange != 1)
                                    globalOriginalBudgetChange = 0;
                            }
                        }
                    },
                    error: function (err) {
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + "";
                        //StopAjaxLoader("#bodyIssueDetails");
                    }
                });
            }
        }


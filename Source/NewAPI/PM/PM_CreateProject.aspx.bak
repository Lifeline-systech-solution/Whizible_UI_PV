        function SaveResourceCostRoles(ResourceCostId, e) {
            var flag = "";

            if (ResourceCostId == 0) {
                flag = "New";
            }
            else {
                flag = "Edit";
            }

            if (ValidateResourceCostRoles(flag, ResourceCostId) == 0) {
                var ResourceCostRole = 0;
                var NoOfCostResources = 0;
                var CostResourceStartDate = "";
                var CostResourceEndDate = "";
                var CostResourceAllocation = 0.00;
                var CostResourceBudget = 0.00;
                var CostResourceMaxRate = 0.00;
                var IsBudgetChange = 0;
                if (flag == "New") {
                    ResourceCostRole = $("#cboResourceCostRole option:selected").val();
                    NoOfCostResources = $("#textNoOfCostResources").val();
                    CostResourceStartDate = $("#dtCostResourceStartDate").val();
                    CostResourceEndDate = $("#dtCostResourceEndDate").val();
                    CostResourceAllocation = $("#textCostResourceAllocation").val();
                    CostResourceBudget = $("#textCostResourceBudget").val();
                    CostResourceMaxRate = $("#textCostResourceMaxRate").val();
                    if (globalOriginalBudgetChange == 1 || globalMaxRateChange == 1) {
                        IsBudgetChange = 1;
                    }

                }
                else {
                    ResourceCostRole = $("#editResourceCostHidden" + ResourceCostId).val();
                    NoOfCostResources = $("#editNoOfResource" + ResourceCostId).val();
                    CostResourceStartDate = $("#editResourceCostStartDate" + ResourceCostId).val();
                    CostResourceEndDate = $("#editResourceCostEndDate" + ResourceCostId).val();
                    CostResourceAllocation = $("#editAllocation" + ResourceCostId).val();
                    CostResourceBudget = $("#editBudget" + ResourceCostId).val();
                    CostResourceMaxRate = $("#editRoleCost" + ResourceCostId).val();
                    if ($("#labelBudgetChangeHidden" + ResourceCostId).hasClass("clsOriginalBudgetChange"))
                        IsBudgetChange = 1;
                    else {
                        IsBudgetChange = 0;
                    }
                }
                if (curGlobalConversionRate == 0) {
                    CostResourceBudget = parseFloat(CostResourceBudget) / parseFloat(1);
                }
                else {
                    CostResourceBudget = parseFloat(CostResourceBudget) / parseFloat(curGlobalConversionRate);
                }
                var Data = {
                    ProjectID: encodeURI(globalProjectId),
                    RoleID: encodeURI(ResourceCostRole),
                    NoOfResource: encodeURI(NoOfCostResources),
                    StartDate: encodeURI(CostResourceStartDate),
                    EndDate: encodeURI(CostResourceEndDate),
                    PercentageAllocation: encodeURI(CostResourceAllocation),
                    Budget: encodeURI(CostResourceBudget),
                    RoleCost: encodeURI(CostResourceMaxRate),
                    CurrencyID: encodeURI(SelectedProjectCurrency),
                    ResourceCostID: encodeURI(ResourceCostId),
                    UserName: encodeURI(StrUserName),
                    WhichAction: encodeURI(WhichAction),
                    IsOriginalBudgetChange: encodeURI(IsBudgetChange),
                }
                StartLoader("#BodyCreateProject")
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/Save_ResourceCostDetails'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (Result) {

                        if (Result != "") {
                            StopAjaxLoader("#BodyCreateProject");
                            alertify.set('notifier', 'position', 'top-right');

                            if (flag == "New") {
                                alertify.notify('<%= MyBase.GetResourceString("A_ResourceCost") %>', 'success', 5);
                            }
                            else {
                                alertify.notify('<%= MyBase.GetResourceString("A_ResourceCostUpdate") %>', 'success', 5);
                            }
                            $("#b_addnew_rolemodal").modal('hide');
                            if (flag == "New") {
                                getResourceCostGridDetails();
                                globalOriginalBudgetChange = 0;
                                globalMaxRateChange = 0;
                            }
                            else {
                                EnableDisableResourceCostFields(true, ResourceCostId, 1, "singleEditMode");
                                $("#editNoOfResourceHidden" + ResourceCostId).val(NoOfCostResources);
                                $("#editResourceCostStartDateHidden" + ResourceCostId).val(CostResourceStartDate);
                                $("#editResourceCostEndDateHidden" + ResourceCostId).val(CostResourceEndDate);
                                $("#editAllocationHidden" + ResourceCostId).val(CostResourceAllocation);
                                $("#editBudgetHidden" + ResourceCostId).val(CostResourceBudget);
                                $("#editRoleCostHidden" + ResourceCostId).val(CostResourceMaxRate);

                                $(e).parents("tr").find(".add, .edit").toggle();
                                $(e).parents("tr").find(".delete, .cancelrowvalue").toggle();
                                getResourceCostGridDetails("edit");
                                ClearResourceCostRoleFields();
                            }
                            $(".input-group-btn .btncalendar").css({ "padding": "6px 12px" });
                            $(".form-control").css({ "padding": "6px 12px" });
                        }
                        else {
                            StopAjaxLoader("#BodyCreateProject");
                        }

                        $(".clseditmodeactive" + ResourceCostId).removeClass("editactive");
                        var blnEditActiveExist = false;

                        var rows = tableResourceCost.rows({ 'search': 'applied' }).nodes();
                        $('*[class*=clseditmodeactive]', rows).each(function () {
                            if ($(this).hasClass("editactive")) {
                                blnEditActiveExist = true;
                            }
                        });

                        if (blnEditActiveExist == false) {
                            $("#modalResourceCost").attr("disabled", false);
                            if (Browser == 'IE') {
                            }
                            else {
                                $("#modalResourceCost").css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                            }
                        }


                        if (WhichAction == "C") {
                            if (cntActualProjectCost > 0 || cntResourceCost > 0) {
                                $(".nav-tabs li:nth-child(3)").addClass("Compltedstep");
                                var currentImagePath = "../../../Whizible2.0-new/dist/img/tick-green.svg";
                                $(".nav-tabs li:nth-child(3)").find(".completeicon").find("img").attr("src", currentImagePath);
                            }
                            else {
                                $(".nav-tabs li:nth-child(3)").addClass("Compltedstep");
                                var currentImagePath = "../../../Whizible2.0-new/dist/img/tick-orange.svg";
                                $(".nav-tabs li:nth-child(3)").find(".completeicon").find("img").attr("src", currentImagePath);
                            }
                        }
                        collapseExpandPanel("collapse");
                        EnableDisableNavigateLinks("Enable", "Resource Cost");
                    },
                    error: function (err) {
                        // alert("error");
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
            }
            if (cntActualProjectCost > 0 || cntResourceCost > 0) {
                $(".nav-tabs li:nth-child(3)").addClass("Compltedstep");
                var currentImagePath = "../../../Whizible2.0-new/dist/img/tick-green.svg";
                $(".nav-tabs li:nth-child(3)").find(".completeicon").find("img").attr("src", currentImagePath);
            }
            else {
                $(".nav-tabs li:nth-child(3)").addClass("Compltedstep");
                var currentImagePath = "../../../Whizible2.0-new/dist/img/tick-orange.svg";
                $(".nav-tabs li:nth-child(3)").find(".completeicon").find("img").attr("src", currentImagePath);
            }
        }
        function addCostHead() {

            clearCostHeadDetails();
        }
        function SaveProjectCostHeadDetails(ProjectCostHeadDetailsId, e) {
            var flag = "";

            if (globalCostHeadDetailsID == 0) {
                flag = "New";
            }
            else {
                flag = "Edit";
            }

            if (ValidateProjectCostHeadDetails(flag, globalCostHeadDetailsID) == 0) {

                var CostHeadStartDate = "";
                var CostHeadEndDate = "";
                var IsPublic = 0;
                var IsBillable = 0;
                var IsUserCanOverride = 0;
                var UserId = '<%= Session("intUserID") %>';
                if (flag == "New") {
                    CostHeadStartDate = $("#dtCostHeadStartDate").val();
                    CostHeadEndDate = $("#dtCostHeadEndDate").val();
                    if ($("#chkIsPublic").is(':checked')) {
                        IsPublic = 1;
                    }
                    if ($("#chkIsBillable").is(':checked')) {
                        IsBillable = 1;
                    }
                    if ($("#chkIsUserCanOverride").is(':checked')) {
                        IsUserCanOverride = 1;
                    }
                }
                else {
                    CostHeadStartDate = $("#dtCostHeadStartDate").val();
                    CostHeadEndDate = $("#dtCostHeadEndDate").val();
                    if ($("#chkIsPublic").is(':checked')) {
                        IsPublic = 1;
                    }
                    if ($("#chkIsBillable").is(':checked')) {
                        IsBillable = 1;
                    }
                    if ($("#chkIsUserCanOverride").is(':checked')) {
                        IsUserCanOverride = 1;
                    }
                }
                //CostResourceBudget = parseFloat(CostResourceBudget) / parseFloat(curGlobalConversionRate);
                var Data = {
                    StartDate: encodeURI(CostHeadStartDate),
                    EndDate: encodeURI(CostHeadEndDate),
                    IsPublic: encodeURI(IsPublic),
                    Billable: encodeURI(IsBillable),
                    UserCanOverride: encodeURI(IsUserCanOverride),
                    WorkOrderCostID: encodeURI(globalWorkOrderCostID),
                    WorkOrderCostDetailID: encodeURI(globalCostHeadDetailsID),
                    UserName: encodeURI(UserId),
                    WhichAction: encodeURI(WhichAction),
                }
                StartLoader("#BodyCreateProject")
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/Save_ResourceCostHeadDetails'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (Result) {

                        if (Result != "") {
                            StopAjaxLoader("#BodyCreateProject");
                            alertify.set('notifier', 'position', 'top-right');

                            if (flag == "New") {
                                alertify.notify('<%= MyBase.GetResourceString("A_ResourceCostHead") %>', 'success', 5);
                            }
                            else {
                                alertify.notify('<%= MyBase.GetResourceString("A_ResourceCostHeadUpdate") %>', 'success', 5);
                            }
                            $("#addcostdetailmodal").modal('hide');
                            if (flag == "New") {
                                GetProjectCostHeadDetails(globalWorkOrderCostID, 0);
                            }
                            else {
                                GetProjectCostHeadDetails(globalWorkOrderCostID, 0);

                            }
                            clearCostHeadDetails();

                        }
                        else {
                            StopAjaxLoader("#BodyCreateProject");
                        }

                    },
                    error: function (err) {
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
            }
        }

        var cntRecs = 0;
        function ValidateResourceCostRoles(flag, ResourceCostId) {
            var checkRCRole = 0;

            var ResourceCostRole = "";
            var NoOfCostResources = "";
            var CostResourceStartDate = "";
            var CostResourceEndDate = "";
            var CostResourceAllocation = "";
            var CostResourceBudget = "";
            var CostResourceMaxRate = "";

            var objResourceCostRole = "";
            var objNoOfCostResources = "";
            var objCostResourceStartDate = "";
            var objCostResourceEndDate = "";
            var objCostResourceAllocation = "";
            var objCostResourceBudget = "";
            var objCostResourceMaxRate = "";

            globalResourceCount = $("#textNoOfResource").val();
            if (flag == "New") {
                ResourceCostRole = $("#cboResourceCostRole option:selected").val();
                NoOfCostResources = $("#textNoOfCostResources").val();
                CostResourceStartDate = $("#dtCostResourceStartDate").val();
                CostResourceEndDate = $("#dtCostResourceEndDate").val();
                CostResourceAllocation = $("#textCostResourceAllocation").val();
                CostResourceBudget = $("#textCostResourceBudget").val();
                CostResourceMaxRate = $("#textCostResourceMaxRate").val();
                objResourceCostRole = $("#cboResourceCostRole");
                objNoOfCostResources = $("#textNoOfCostResources");
                objCostResourceStartDate = $("#dtCostResourceStartDate");
                objCostResourceEndDate = $("#dtCostResourceEndDate");
                objCostResourceAllocation = $("#textCostResourceAllocation");
                objCostResourceBudget = $("#textCostResourceBudget");
                objCostResourceMaxRate = $("#textCostResourceMaxRate");
            }
            else {
                ResourceCostRole = $("#editResourceCostHidden" + ResourceCostId).val();
                NoOfCostResources = $("#editNoOfResource" + ResourceCostId).val();
                CostResourceStartDate = $("#editResourceCostStartDate" + ResourceCostId).val();
                CostResourceStartDate = CostResourceStartDate.toString().trim();
                CostResourceEndDate = $("#editResourceCostEndDate" + ResourceCostId).val();
                CostResourceEndDate = CostResourceEndDate.toString().trim();
                CostResourceAllocation = $("#editAllocation" + ResourceCostId).val();
                CostResourceBudget = $("#editBudget" + ResourceCostId).val();
                CostResourceMaxRate = $("#editRoleCost" + ResourceCostId).val();
                //objResourceCostRole = $("#cboResourceCostRole");
                objNoOfCostResources = $("#editNoOfResource" + ResourceCostId);
                objCostResourceStartDate = $("#editResourceCostStartDate" + ResourceCostId);
                objCostResourceEndDate = $("#editResourceCostEndDate" + ResourceCostId);
                objCostResourceAllocation = $("#editAllocation" + ResourceCostId);
                objCostResourceBudget = $("#editBudget" + ResourceCostId);
                objCostResourceMaxRate = $("#editRoleCost" + ResourceCostId);
            }

            if (flag == "New") {
                if (ResourceCostRole == "0") {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('<%= MyBase.GetResourceString("A_Role") %>', 'error', 5);
                    objResourceCostRole.focus();
                    checkRCRole = 1;
                    return checkRCRole;
                }
            }

            if (NoOfCostResources == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_Resources") %>', 'error', 5);
                objNoOfCostResources.focus();
                checkRCRole = 1;
                return checkRCRole;
            }

            //alert(cntResourceCost);
            cntRecs = 0
            var rows = tableResourceCost.rows({ 'search': 'applied' }).nodes();
            $('*[id*=editNoOfResource]', rows).each(function () {
                if (flag == "Edit" && globalNoOfResourceCheck == false && $(this).attr("id").toString().indexOf("editNoOfResourceHidden") == -1) {
                    if (cntRecs == 0) {
                        curResourceCostResourceCount = 0;
                    }
                    if ($(this).attr("id") == "editNoOfResource" + ResourceCostId) {
                        curResourceCostResourceCount = parseInt(curResourceCostResourceCount) + parseInt(curEditNoOfResource);
                    }
                    else {
                        curResourceCostResourceCount = parseInt(curResourceCostResourceCount) + parseInt($(this).val());
                    }
                    cntRecs = cntRecs + 1;

                    //if (cntRecs == cntResourceCost - 1) {
                    //    alert("cntRecs == cntResourceCost");
                    //    cntRecs = 0;
                    //}
                }
            });

            if (flag == "New" && NoOfCostResources != "") {
                //if (checkSpecialCharacter(NoOfCostResources) == true) {
                //    alertify.set('notifier', 'position', 'top-right');
                //    alertify.notify('No Of Resources cannot contain any of these /\\:*?<>|,"+- Characters', 'error');
                //    objNoOfCostResources.focus();
                //    checkRCRole = 1;
                //    return checkRCRole;
                //}
                if (checkSpecialCharacter($("#textNoOfCostResources").val(), WebConfigSpecialCharacters) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('No. Of Resources should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                    $("#textNoOfCostResources").focus();
                    checkRCRole = 1;
                    return checkRCRole;
                }
                if (parseInt(NoOfCostResources) <= 0) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify("No Of Resources should be greater than zero", 'error', 5);
                    objNoOfCostResources.focus();
                    checkRCRole = 1;
                    return checkRCRole;
                }
                if (globalNoOfResourceCheck == false) {
                    var totalNoOfCostResources = parseInt(NoOfCostResources) + parseInt(curResourceCostResourceCount);



                    if (parseInt(totalNoOfCostResources) > parseInt(globalResourceCount)) {
                        alertify.set('notifier', 'position', 'top-right');

                        alertify.notify("No Of Resources should not be greater than Project's total no of resources (" + globalResourceCount + ")", 'error', 5);

                        objNoOfCostResources.focus();
                        checkRCRole = 1;
                        return checkRCRole;
                    }
                }
            }

            if (flag == "Edit" && NoOfCostResources != "") {

                //if (checkSpecialCharacter(NoOfCostResources) == true) {
                //    alertify.set('notifier', 'position', 'top-right');
                //    alertify.notify('No Of Resources cannot contain any of these /\\:*?<>|,"+- Characters', 'error');
                //    objNoOfCostResources.focus();
                //    checkRCRole = 1;
                //    return checkRCRole;
                //}
                if (checkSpecialCharacter($("#textNoOfCostResources").val(), WebConfigSpecialCharacters) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('No. Of Resources should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                    $("#textNoOfCostResources").focus();
                    checkRCRole = 1;
                    return checkRCRole;
                }
                if (parseInt(NoOfCostResources) <= 0) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify("No Of Resources should be greater than zero", 'error', 5);
                    objNoOfCostResources.focus();
                    checkRCRole = 1;
                    return checkRCRole;
                }
                if (globalNoOfResourceCheck == false) {
                    var totalNoOfCostResources = (parseInt(curResourceCostResourceCount) - parseInt(curEditNoOfResource)) + parseInt(NoOfCostResources);

                    if (parseInt(totalNoOfCostResources) > parseInt(globalResourceCount)) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify("No Of Resources should not be greater than Project's total no of resources", 'error', 5);
                        objNoOfCostResources.focus();
                        checkRCRole = 1;
                        return checkRCRole;
                    }
                }
            }
            if (CostResourceStartDate == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_StartDate") %>', 'error', 5);
                objCostResourceStartDate.focus();
                checkRCRole = 1;
                return checkRCRole;
            }

            if (CostResourceStartDate != "") {
                if (flag == "New") {
                    checkRCRole = ValidateDate(0, "ResourceRoleStartDate");

                    if (checkRCRole == 1) {
                        objCostResourceStartDate.focus();
                        return checkRCRole;
                    }
                }
                if (flag == "Edit") {
                    checkRCRole = ValidateDate(ResourceCostId, "EditResourceRoleStartDate");

                    if (checkRCRole == 1) {
                        objCostResourceStartDate.focus();
                        return checkRCRole;
                    }
                }
            }

            if (CostResourceEndDate == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_EndDate") %>', 'error', 5);
                objCostResourceEndDate.focus()
                checkMile = 1;
                return checkMile;
            }

            if (CostResourceEndDate != "") {
                if (Date.parse(CostResourceEndDate) < Date.parse(CostResourceStartDate)) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('<%= MyBase.GetResourceString("A_LessThanStart") %>', 'error', 5);
                    objCostResourceEndDate.focus();
                    checkRCRole = 1;
                    return checkRCRole;
                }
                if (flag == "New") {
                    checkRCRole = ValidateDate(0, "ResourceRoleEndDate");

                    if (checkRCRole == 1) {
                        objCostResourceEndDate.focus();
                        return checkRCRole;
                    }
                }
                if (flag == "Edit") {
                    checkRCRole = ValidateDate(ResourceCostId, "EditResourceRoleEndDate");

                    if (checkRCRole == 1) {
                        objCostResourceEndDate.focus();
                        return checkRCRole;
                    }
                }
            }

            if (CostResourceAllocation == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_Allocation") %>', 'error', 5);
                objCostResourceAllocation.focus();
                checkRCRole = 1;
                return checkRCRole;
            }

            //Added By Dipali V On 11 Th Jun 2020 for isuse id 24915
            if (CostResourceAllocation == 0) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('Allocation should be greater than 0', 'error', 5);
                objCostResourceAllocation.focus();
                checkRCRole = 1;
                return checkRCRole;
            }
            //End of Added By Dipali V On 11 Th Jun 2020 for isuse id 24915
            if (CostResourceAllocation != "") {
                //if (checkSpecialCharacter(CostResourceAllocation) == true) {
                //    alertify.set('notifier', 'position', 'top-right');
                //    alertify.notify('Allocation % cannot contain any of these /\\:*?<>|,"+- Characters', 'error');
                //    objCostResourceAllocation.focus();
                //    checkRCRole = 1;
                //    return checkRCRole;
                //}
                if (checkSpecialCharacter($("#textCostResourceAllocation").val(), WebConfigSpecialCharacters) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('Allocation should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                    $("#textCostResourceAllocation").focus();
                    checkRCRole = 1;
                    return checkRCRole;
                }
                if (parseFloat(CostResourceAllocation) > 100) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('<%= MyBase.GetResourceString("A_AllocationLimit") %>', 'error', 5);
                    objCostResourceAllocation.focus();
                    checkRCRole = 1;
                    return checkRCRole;
                }
            }

            if (CostResourceBudget == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_Budget") %>', 'error', 5);
                objCostResourceBudget.focus();
                checkRCRole = 1;
                return checkRCRole;
            }
            if (CostResourceBudget != "") {
                //if (checkSpecialCharacter(CostResourceBudget) == true) {
                //    alertify.set('notifier', 'position', 'top-right');
                //    alertify.notify('Budget cannot contain any of these /\\:*?<>|,"+- Characters', 'error');
                //    objCostResourceBudget.focus();
                //    checkRCRole = 1;
                //    return checkRCRole;
                //}
                if (checkSpecialCharacter($("#textCostResourceBudget").val(), WebConfigSpecialCharacters) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('Budget should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                    $("#textCostResourceBudget").focus();
                    checkRCRole = 1;
                    return checkRCRole;
                }
            }
            if (CostResourceMaxRate != "") {
                //if (checkSpecialCharacter(CostResourceMaxRate) == true) {
                //    alertify.set('notifier', 'position', 'top-right');
                //    alertify.notify('Max Rate cannot contain any of these /\\:*?<>|,"+- Characters', 'error');
                //    objCostResourceMaxRate.focus();
                //    checkRCRole = 1;
                //    return checkRCRole;
                //}
                if (checkSpecialCharacter($("#textCostResourceMaxRate").val(), WebConfigSpecialCharacters) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('Max Rate should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                    $("#textCostResourceMaxRate").focus();
                    checkRCRole = 1;
                    return checkRCRole;
                }
            }


            return checkRCRole;
        }
        //28.01.2020
        function validateCostHeadDates(dtFromdate, dtToDate) {

            var checkFlag = 0;

            for (var rec = 0; rec < arrGlobalCostHeadStartDate.length; rec++) {
                var dtFrom = arrGlobalCostHeadStartDate[rec];
                var dtTo = arrGlobalCostHeadEndDate[rec];
                //Added By Usha Pandit On 11.06.2020 For getting cost head details in array
                var costHeadDtlId = arrGlobalCostHeadId[rec];

                if (dtFrom != undefined && dtTo != undefined) {
                    var dtFromdate = new Date(dtFromdate);
                    var dtToDate = new Date(dtToDate);
                    var dtFrom = new Date(dtFrom);
                    var dtTo = new Date(dtTo);

                    if ((dtFromdate >= dtFrom && dtFromdate <= dtTo) || (dtToDate >= dtFrom && dtToDate <= dtTo) || (dtFromdate < dtFrom && dtToDate > dtTo) || (dtFromdate <= dtFrom && dtToDate > dtFrom)) {

                        if ((costHeadDtlId != globalCostHeadDetailsID && globalCostHeadDetailsID != 0) || globalCostHeadDetailsID == 0) {
                            alertify.set('notifier', 'position', 'top-right');
                            alertify.notify('<%= MyBase.GetResourceString("A_LessThanLast") %>', 'error', 5);
                            checkFlag = 1;
                            return checkFlag;
                        }
                    }
                }
                //End Of Added By Usha Pandit On 11.06.2020 For getting cost head details in array
            }

            return checkFlag;
        }
        //28.01.2020

        function ValidateProjectCostHeadDetails(flag, CostHeadDetailId) {
            try {
                var checkRCHRole = 0;
                var CostHeadStartDate = "";
                var CostHeadEndDate = "";
                var IsPublic = 0;
                var IsBillable = 0;
                var IsUserCanOverride = 0;

                var objCostHeadStartDate = "";
                var objCostHeadEndDate = "";
                var objIsPublic = 0;
                var objIsBillable = 0;
                var objIsUserCanOverride = 0;

                CostHeadStartDate = $("#dtCostHeadStartDate").val();
                CostHeadEndDate = $("#dtCostHeadEndDate").val();
                if ($("#chkIsPublic").is(':checked')) {
                    IsPublic = 1;
                }
                if ($("#chkIsBillable").is(':checked')) {
                    IsBillable = 1;
                }
                if ($("#chkIsUserCanOverride").is(':checked')) {
                    IsUserCanOverride = 1;
                }
                objCostHeadStartDate = $("#dtCostHeadStartDate");
                objCostHeadEndDate = $("#dtCostHeadEndDate");
                objIsPublic = $("#chkIsPublic");
                objIsBillable = $("#chkIsBillable");
                objIsUserCanOverride = $("#chkIsUserCanOverride");

                if (CostHeadStartDate == "") {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('<%= MyBase.GetResourceString("A_StartDate") %>', 'error', 5);
                    objCostHeadStartDate.focus();
                    checkRCHRole = 1;
                    return checkRCHRole;
                }
                if (CostHeadEndDate == "") {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('<%= MyBase.GetResourceString("A_EndDate") %>', 'error', 5);
                    objCostHeadEndDate.focus();
                    checkRCHRole = 1;
                    return checkRCHRole;
                }

                if (CostHeadStartDate != "") {
                    checkRCHRole = ValidateDate(0, "ResourceCostHeadStartDate");

                    if (checkRCHRole == 1) {
                        objCostHeadStartDate.focus();
                        return checkRCHRole;
                    }
                    //Added By Usha Pandit On 11.06.2020 For getting date validation
                    if (Date.parse(CostHeadEndDate) < Date.parse(CostHeadStartDate)) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify('<%= MyBase.GetResourceString("A_LessThanStart") %>', 'error', 5);
                        objCostHeadEndDate.focus();
                        checkRCHRole = 1;
                        return checkRCHRole;
                    }
                    //End Of Added By Usha Pandit On 11.06.2020 For getting date validation
                    if (validateCostHeadDates(CostHeadStartDate, CostHeadEndDate) == 1) {
                        checkRCHRole = 1;
                        return checkRCHRole;
                    }

                }

                if (CostHeadEndDate != "") {
                    if (Date.parse(CostHeadEndDate) < Date.parse(CostHeadStartDate)) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify('<%= MyBase.GetResourceString("A_LessThanStart") %>', 'error', 5);
                        objCostHeadEndDate.focus();
                        checkRCHRole = 1;
                        return checkRCHRole;
                    }
                    if (validateCostHeadDates(CostHeadStartDate, CostHeadEndDate) == 1) {
                        checkRCHRole = 1;
                        return checkRCHRole;
                    }

                    checkRCHRole = ValidateDate(0, "ResourceCostHeadEndDate");

                    if (checkRCHRole == 1) {
                        objCostHeadEndDate.focus();
                        return checkRCHRole;
                    }

                }
                return checkRCHRole;
            }
            catch (ex) {
                //alert(ex.message);
            }
        }
        function SaveTemplateSite() {
            var RateCardId = $("#CboRateCardTemplate option:selected").val();
            if (RateCardId == 0) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_Template") %>', 'error', 5);
                $("#CboRateCardTemplate").focus();
                return;
            }
            if ($("#RadiobtnSingleSite").is(':checked')) {
                if (cntSites >= 1) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('<%= MyBase.GetResourceString("A_MultipleSite") %>', 'error', 5);
                    return;
                }
                var curRateCardSiteCount = 0;

                var className = $("#CboRateCardTemplate option:selected").attr('class');
                if ((className).toString().indexOf("RateCardSiteCount") != -1) {
                    curRateCardSiteCount = className.toString().replace("RateCardSiteCount", "");
                }

                if (curRateCardSiteCount > 1) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('Selected template has multiple sites. ' + '<%= MyBase.GetResourceString("A_MultipleSite") %>', 'error', 5);
                    return;
                }

            }
            var Data = {
                TemplateID: encodeURI(RateCardId),
                ProjectID: encodeURI(globalProjectId),
                UserName: encodeURI(StrUserName),
                WhichAction: encodeURI(WhichAction)
            }
            StartLoader("#BodyCreateProject")
            $.ajax({
                url: encodeURI(strUrl + '/api/PM_CreateProject/Save_TemplateSite'),
                type: "POST",
                data: JSON.stringify(Data),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (Data) {
                        xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                    }
                },
                success: function (Result) {


                    if (Result != "") {
                        StopAjaxLoader("#BodyCreateProject");
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify('<%= MyBase.GetResourceString("A_TemplateSave") %>', 'success', 5);
                        if (Result == "1") {
                           
                        }
                        //$("#CPaddnewsitemodal").modal('hide');
                        GetSiteDetails();
                        //ClearAllMileStoneControls();
                    }
                    else {
                        StopAjaxLoader("#BodyCreateProject");
                    }
                },
                error: function (err) {
                    // alert("error");
                    console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
        }

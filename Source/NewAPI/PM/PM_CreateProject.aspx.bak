            </div>
        </div>

        <div id="divAppReject" class="modal fade custmodal" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog modalsmall">
                <!-- Modal content-->
                <div class="modal-content" style="height: 300px">
                    <div class="modal-header">
                        <button type="button" class="close" data-bs-dismiss="modal" onclick="CloseAppReject()">&times;</button> <%--Onclick function Added By Rutuja D. on 24 Dec 2021 for close the Popup IssueID = 31934--%>
                        <h4 class="modal-title" id="lblAppRejectCaption"></h4>
                    </div>

                    <div class="modal-body" style="height: 200px">

                        <div class="form-group">
                            <div class="col-md-12 row" style="margin-top: 10px;">
                                <label class="control-label col-md-4 p-0 text-end">Comment : <span style='color: red;'>*</span></label>
                                <span class="col-md-8">
                                    <% CommonFunctions.HTMLControls.DrawTextArea("txtWFARComments", "txtWFARComments", "Enter Comments", "form-control", ,,,,, 100, 1000,,,,,,,, "PlaceHolder = 'Enter Comments (Maxlength 1000 Chars)' autocomplete='Off' maxlength='1000' ",,,,,,,,,,) %>

                                </span>
                            </div>
                        </div>

                    </div>


                    <div class="modal-footer">
                        <button type="button" class="btn btnyellow ml-1 float-end" onclick="ApproveRejectClick()"><span id="btnappreject"></span></button>
                        <button type="button" class="btn borderbtn nobtnstyle-xs " data-bs-dismiss="modal" onclick="CloseAppReject()">Close</button> <%--Onclick function Added By Rutuja D. on 24 Dec 2021 for close the Popup IssueID =31934--%>
                    </div>
                </div>
            </div>
        </div>

        <div id="divRevision" class="modal fade custmodal" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog modalsmall">
                <!-- Modal content-->
                <div class="modal-content" style="height: 300px">
                    <div class="modal-header">
                        <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                        <h4 class="modal-title" id="lblRevision">Revision </h4>
                    </div>

                    <div class="modal-body" style="height: 200px">

                        <div class="form-group">
                            <div class="col-md-12 row" style="margin-top: 10px;">
                                <label class="control-label col-md-4 p-0 text-end">Comment : <span style='color: red;'>*</span></label>
                                <span class="col-md-8">
                                    <% CommonFunctions.HTMLControls.DrawTextArea("txtRevisionComments", "txtRevisionComments", "Enter Comments", "form-control", ,,,,, 100, 1000,,,,,,,, "PlaceHolder = 'Enter Comments (Maxlength 1000 Chars)' autocomplete='Off' maxlength='1000' ",,,,,,,,,,) %>

                                </span>
                            </div>
                        </div>

                    </div>


                    <div class="modal-footer">
                        <button type="button" class="btn btnyellow ml-1 float-end" onclick="Revision_Onclick()">Revision</button>
                        <button type="button" class="btn borderbtn nobtnstyle-xs " data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>


        <div id="divRevisionhistory" class="modal fade custmodal" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog modal-lg">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                        <h4 class="modal-title">Revision History Details</h4>
                    </div>

                    <div class="modal-body">
                        <table id="ProjectRevisionTbl" class="table table-bordered" style="width: 100%">
                            <thead>
                                <tr>
                                    <th width="20%"><%= MyBase.GetResourceString("C_TiTle") %></th>
                                    <th width="20%"><%= MyBase.GetResourceString("C_EventTime") %></th>
                                    <th width="20%"><%= MyBase.GetResourceString("C_ActionTaken") %></th>
                                    <th width="20%"><%= MyBase.GetResourceString("C_From_Stage") %></th>
                                    <th width="20%"><%= MyBase.GetResourceString("C_To_Stage") %></th>
                                    <th width="20%"><%= MyBase.GetResourceString("C_Approver") %></th>
                                    <th width="20%"><%= MyBase.GetResourceString("C_Comments") %></th>
                                </tr>
                            </thead>
                            <tbody id="ProjectRevisionTbody">
                            </tbody>

                        </table>

                    </div>


                    <div class="modal-footer">
                        <button type="button" class="btn borderbtn nobtnstyle-xs " data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
          <%-- Added by Chetan M on 02 Aug 2021 for capture History --%>
        <div class="modal custmodal fade" id="PIShowHistoryModal" aria-hidden="true" data-bs-dismiss="modal">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="">History</h5>
                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">                        
                        <table id="PIHistoryTbl" class="table table-stripped table-bordered PIHistoryTbl" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Modified Field</th>
                                    <th>Old Value</th>
                                    <th>New Value</th>
                                    <th>Modified Date</th>                                    
                                    <th>Modified By</th>
                                </tr>
                            </thead>
                            <tbody id="ProjectHistoryTbody">
                                
                            </tbody>
                        </table>

                        <br/><br />
                        <div class="modal-footer">
                        <button type="button" class="btn borderbtn nobtnstyle-xs " data-bs-dismiss="modal">Close</button>
                       </div>
                       
                    </div>
                </div>
            </div>
        </div>
          <%-- End of Added by Chetan M on 02 Aug 2021 for capture History --%>

        <div id="divComments" class="modal fade custmodal" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog modalsmall">
                <!-- Modal content-->
                <div class="modal-content" style="height: 300px">
                    <div class="modal-header">
                        <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                        <h4 class="modal-title" id="lblComments">Comment </h4>
                    </div>

                    <div class="modal-body" style="height: 200px">

                        <div class="form-group">
                            <div class="col-md-12 row" style="margin-top: 10px;">
                                <label class="control-label col-md-4 p-0 text-end">Comment : <span style='color: red;'>*</span></label>
                                <span class="col-md-8">
                                    <% CommonFunctions.HTMLControls.DrawTextArea("txtComments", "txtComments", "Enter Comments", "form-control", ,,,,, 100, 1000,,,,,,,, "PlaceHolder = 'Enter Comments (Maxlength 1000 Chars)' autocomplete='Off' maxlength='1000' ",,,,,,,,,,) %>

                                </span>
                            </div>
                        </div>

                    </div>


                    <div class="modal-footer">
                        <button type="button" class="btn btnyellow ml-1 float-end" onclick="Comments_onclick('PH')">Ok</button>
                        <button type="button" class="btn borderbtn nobtnstyle-xs " data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>



        <div id="Conformationmodel" class="modal fade custmodal" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog modalsmall">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                        <h4 class="modal-title">Confirmation</h4>
                    </div>

                    <div class="modal-body">
                        <p align="center" id="PMSG"></p>

                        <div class="form-group mt-4">
                            <div class="row">
                                <div class="col-xs-6 col-sm-6 text-start">
                                    <button class="btn borderbtn ml-1" data-bs-dismiss="modal">Cancel</button>
                                </div>
                                <div class="col-xs-6 col-sm-6">
                                    <button class="btn btnyellow ml-1 float-end" onclick="AllowtoApproveTimesheetblock('0')" data-bs-dismiss="modal">Ok</button>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
            <div class="clearfix"></div>
        </div>

        <%-- End of Added By Dipali V On 23rd Dec 2019 For Work Flow --%>
    </div>
    <div id="EnggConfirmation" class="modal fade custmodal" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modalsmall">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Confirmation</h4>
                </div>

                <div class="modal-body">

                    <p align="center" id="SpnAlert"></p>

                    <div class="form-group mt-4">
                        <div class="row">
                            <div class="col-xs-6 col-sm-6 text-start">
                                <button class="btn borderbtn ml-1" data-bs-dismiss="modal" onclick="cancel()">Cancel</button>
                            </div>
                            <div class="col-xs-6 col-sm-6">
                                <button class="btn btnyellow ml-1 float-end" onclick="YesUpdate()" id="Confirmation">Yes</button>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
        <div class="clearfix"></div>
    </div>
</body>

</html>

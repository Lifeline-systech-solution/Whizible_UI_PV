            }
            else {
                if (blnProjectRoleAccess == "False") {
                    $("#newproadvanceoption").addClass("active");
                    $("#newprobasicinformation").removeClass("active");
                    $('.newprojectabtmenu li a[href="#newproadvanceoption"]').tab('show');
                }
                else {
                    //alert(111);
                    $("#newprobasicinformation").removeClass("active");
                    $("#newproadvanceoption").addClass("active");
                }
            }
            if ($("#tabnewproadvanceoption").hasClass("active")) {
            }
            else {
                if (blnProjectRoleAccess == "False") {
                    $("#tabnewproadvanceoption").addClass("active");
                    $('.newprojectabtmenu li a[href="#newproadvanceoption"]').tab('show');
                }
                else {
                    //alert(222);
                }
            }
            if ($("#tabprobasicinformation").hasClass("active")) {
                $("#tabprobasicinformation").removeClass("active");
            }
        }
        var blnBasicActive = false;
        var blnAdvancedActive = false;

        //Added By Usha Pandit On 18.01.2020 For Resource work hour validation 
        function GetResourceHours() {
            var WorkHours = "0";
            var Data = {
                ProjectID: encodeURI(globalProjectId)
            }
            //StartLoader("#BodyCreateProject");
            $.ajax({
                url: encodeURI(strUrl + '/api/PM_CreateProject/getResourceHours'),
                type: "POST",
                data: JSON.stringify(Data),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (Data) {
                        xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                    }
                },
                success: function (Result) {

                    WorkHours = Result;
                    //StopAjaxLoader("#BodyCreateProject");   
                },
                error: function (err) {
                    // alert("error");
                    //StopAjaxLoader("#BodyCreateProject");
                    console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
            return WorkHours;
        }
        //Added By Usha Pandit On 18.01.2020 For Resource work hour validation 

        function Validation() {
            var chkval = 0;
            blnBasicActive = false;
            if ($("#textAbbProjectName").val() != "" && $("#textAbbProjectName").val() != undefined && $("#textAbbProjectName").val() != null) {
                var abbrname = $("#textAbbProjectName").val().toString().trim();
                $("#textAbbProjectName").val(abbrname);
            }
            if ($("#textProjectName").val() != "" && $("#textProjectName").val() != undefined && $("#textProjectName").val() != null) {
                var prjname = $("#textProjectName").val().toString().trim();
                $("#textProjectName").val(prjname);
            }
            if ($("#textDescription").val() != "" && $("#textDescription").val() != undefined && $("#textDescription").val() != null) {
                var prjdescr = $("#textDescription").val().toString().trim();
                $("#textDescription").val(prjdescr);
            }
            var AbbName = $("#textAbbProjectName").val();
            var ProjectName = $("#textProjectName").val();
            var Description = $("#textDescription").val();
            var NoOfResource = $("#textNoOfResource").val();
            var ProjectStartDate = $("#dtProjectStartDate").val();
            var ProjectEnddate = $("#dtProjectEndDate").val();
            var ProjectCustomer = $("#cboProjectCustomer").val();
            var Duration = $("#textDuration").val();
            var Hours = $("#texthours").val();
            var ProjectBG = $("#cboProjectBG").val();
            var ProjectOU = $("#cboProjectOU").val();
            var PracticeTemplate = $("#cboPracticeTemplate").val();
            var ProjectCurrency = $("#cboProjectCurrency").val();
            var ProjectBudget = $("#textTotalBudget").val();

            if (AbbName == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_AbbrProjectName") %>', 'error', 5);
                $("#textAbbProjectName").focus();
                chkval = 1;
                return chkval;
            }

            if (AbbName != "") {
                NameExists = checkDuplicateProject(AbbName, "Abbreviated Name");
                if (NameExists == 1) {
                    $("#textAbbProjectName").focus();
                    chkval = 1;
                    return chkval;
                }
                else if (checkSpecialCharacter(AbbName, WebConfigSpecialCharacters) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('Abbreviated Name should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                    $("#textAbbProjectName").focus();
                    chkval = 1;
                    return chkval;
                }
            }

            if (ProjectName == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_ProjectName") %>', 'error', 5);
                $("#textProjectName").focus();
                chkval = 1;
                return chkval;
            }

            if (ProjectName != "") {
                NameExists = checkDuplicateProject(ProjectName, "Project Name");
                if (NameExists == 1) {
                    $("#textProjectName").focus();
                    chkval = 1;
                    return chkval;
                }
                else if (checkSpecialCharacter(ProjectName, WebConfigSpecialCharacters) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('Project Name should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                    $("#textProjectName").focus();
                    chkval = 1;
                    return chkval;
                }
            }

          

            if (NoOfResource == "" && globalNoOfResourceCheck == false) {

                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_Resources") %>', 'error', 5);
                $("#textNoOfResource").focus();
                chkval = 1;
                return chkval;
            }
            if (globalNoOfResourceCheck == false) {
                if (NoOfResource != "") {
                    //if (checkSpecialCharacter($('#textNoOfResource').val()) == true) {
                    //    alertify.set('notifier', 'position', 'top-right');
                    //    alertify.notify('No Of Resources cannot contain any of these /\\:*?<>|,"+- Characters', 'error');
                    //    $('#textNoOfResource').focus();
                    //    chkval = 1;
                    //    return chkval;
                    //}
                    if (checkSpecialCharacter(NoOfResource, WebConfigSpecialCharacters) == true) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.error('Number of Resources should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                        $("#textNoOfResource").focus();
                        chkval = 1;
                        return chkval;
                    }
                    if (parseInt(NoOfResource) <= 0) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify("No Of Resources should be greater than zero", 'error', 5);
                        $('#textNoOfResource').focus();
                        chkval = 1;
                        return chkval;
                    }
                }
            }

            if (ProjectCustomer == "0") {

                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_Customer") %>', 'error', 5);
                $("#cboProjectCustomer").focus();
                chkval = 1;
                return chkval;
            }

            if (Description != "") {
                if (checkSpecialCharacter(Description, WebConfigSpecialCharacters) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('Description should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                    $("#textDescription").focus();
                    chkval = 1;
                    return chkval;
                }
            }

            if (ProjectStartDate == "") {

                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_StartDate") %>', 'error', 5);
                $("#dtProjectStartDate").focus();
                chkval = 1;
                return chkval;
            }


            if (ProjectEnddate == "") {

                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_EndDate") %>', 'error', 5);
                $("#dtProjectEndDate").focus();
                chkval = 1;
                return chkval;
            }


            if (ProjectEnddate != "") {
                if (Date.parse(ProjectEnddate) < Date.parse(ProjectStartDate)) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('<%= MyBase.GetResourceString("A_LessThanStart") %>', 'error', 5);
                    $("#dtProjectEndDate").focus();
                    chkval = 1;
                    return chkval;
                }
            }

            if ((Duration == "" && WhichAction == "D" && blnProjectRoleAccess == "False") || (Duration == "" && WhichAction == "C" && blnProjectRoleAccess == "False")) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_DurationDays") %>', 'error', 5);
                $("#textDuration").focus();
                chkval = 1;
                return chkval;
            }

            if (Hours == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_WorkHours") %>', 'error', 5);
                $("#texthours").focus();
                chkval = 1;
                return chkval;
            }

            if (Hours != "") {
                //if (checkSpecialCharacter($('#texthours').val()) == true) {
                //    alertify.set('notifier', 'position', 'top-right');
                //    alertify.notify('Hours cannot contain any of these /\\:*?<>|,"+- Characters', 'error');
                //    $('#texthours').focus();
                //    chkval = 1;
                //    return chkval;
                //}
                if (checkSpecialCharacter($('#texthours').val(), WebConfigSpecialCharacters) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('Hours should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                    $("#texthours").focus();
                    chkval = 1;
                    return chkval;
                }

                if (WhichAction == "C") {
                    var resourceHrs = GetResourceHours();
                    if (parseInt(Hours) < parseInt(resourceHrs)) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify('<%= MyBase.GetResourceString("A_ResourceHrsCheck") %>' + ' - [' + resourceHrs + ']', 'error', 5);
                        $('#texthours').focus();
                        chkval = 1;
                        return chkval;
                    }
                }
            }

            if (ProjectBG == "0") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_BusinessGroup") %>', 'error', 5);
                $("#cboProjectBG").focus();
                chkval = 1;
                return chkval;
            }

            if (ProjectOU == "0" || ProjectOU == "") {

                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_OrganizationUnit") %>', 'error', 5);
                $("#cboProjectOU").focus();
                chkval = 1;
                return chkval;
            }


            if (WhichAction == "C") {
                if ($("#cboProjectStatus").val() == "0") {

                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify("'Project Status' Should not be left blank", 'error', 5);
                    $("#cboProjectStatus").focus();
                    chkval = 1;
                    return chkval;

                }
            }


            //Added By Dipali V On 31st July 2020 For Alltech Customzation
            if (IsDUMandetory == "True") {
                if ($("#cboDU").val() == "0") {

                    setTimeout(function () {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify("'Delivery Unit' Should not be left blank", 'error', 5);
                        $("#cboDU").focus();
                    }, 4000);

                    chkval = 1;
                    return chkval;

                }
            }


            if (ISDTMandetory == "True") {
                if ($("#cboDT").val() == "0") {
                    setTimeout(function () {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify("'Delivery Team' Should not be left blank", 'error', 5);
                        $("#cboDT").focus();
                    }, 4000);
                    chkval = 1;
                    return chkval;

                }
            }
            //End of Added By Dipali V On 31st July 2020 For Alltech Customzation

            if (PracticeTemplate == "0") {

                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_Practice") %>', 'error', 5);
                $("#cboPracticeTemplate").focus();
                chkval = 1;
                return chkval;
            }

            if (ProjectCurrency == "0" && $("#CboCompanyengagemnt option:selected").val() == 1) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_ProjectCurrency") %>', 'error', 5);
                goToAdvancedTab();
                $("#cboProjectCurrency").focus();
                chkval = 1;
                return chkval;
            }
            if (ProjectCurrency != "0" || (ProjectCurrency == 0 && $("#CboCompanyengagemnt option:selected").val() != 1)) {
                if (globalProjectId != 0) {

                    if (globalProjectCurrency != ProjectCurrency) {
                        if (cntResourceCost > 0) {
                            alertify.set('notifier', 'position', 'top-right');
                            alertify.notify('<%= MyBase.GetResourceString("A_ProjectCurrencyChange") %>', 'error', 10);
                            //alertify.notify('Please verify Resource Costs entered for current project currency. You are allowed to change Project currency only after deleting existing Resource Cost details', 'error', 10);
                            goToAdvancedTab();
                            $("#cboProjectCurrency").val(globalProjectCurrency);
                            $("#cboProjectCurrency").focus();
                            chkval = 1;
                            return chkval;
                        }
                    }
                }
            }
            if (ProjectBudget == "" && $("#CboCompanyengagemnt option:selected").val() == 1) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_ProjectValue") %>', 'error', 5);
                goToAdvancedTab();
                $("#textTotalBudget").focus();
                chkval = 1;
                return chkval;
            }
            if (ProjectBudget != "") {
                if (RestrictNonNumeric(document.getElementById("textTotalBudget")) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('Please enter Total Budget in numeric format', 'error', 5);
                    goToAdvancedTab();
                    $("#textTotalBudget").focus();
                    chkval = 1;
                    return chkval;
                }
                if (parseFloat(ProjectBudget) <= 0) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('Total Budget should be greater than zero', 'error', 5);
                    goToAdvancedTab();
                    $("#textTotalBudget").focus();
                    chkval = 1;
                    return chkval;
                }
            }

            if (chkval == 0) {
                if (FromWhichMode == "Edit") {
                   
                    $("#btnDraftNext").addClass('next-step');
                    if ($("#newproadvanceoption").hasClass("active")) {

                        chkval = 0;
                    }
                    else {
                        if (blnProjectRoleAccess == "False") {
                            blnBasicActive = true;
                            $("#newproadvanceoption").addClass("active");
                            $("#newprobasicinformation").removeClass("active");
                            $('.newprojectabtmenu li a[href="#newproadvanceoption"]').tab('show');
                        }
                        else {
                            $("#step1").removeClass("active");
                            $("#step2").addClass("active");
                        }
                    }
                    if ($("#tabnewproadvanceoption").hasClass("active")) {
                    }
                    else {
                        if (blnProjectRoleAccess == "False") {
                            $("#tabnewproadvanceoption").addClass("active");
                            $('.newprojectabtmenu li a[href="#newproadvanceoption"]').tab('show');
                        }
                        else {
                            $("#step1").removeClass("active");
                            $("#step2").addClass("active");
                            var $active = $('.wizard .nav-tabs li a.active');
                            $active.next().removeClass('disabled');
                            nextTab($active);
                            $('.wizard .nav-tabs li a.active').prev('li').addClass('Compltedstep');
                        }
                    }
                    if ($("#tabprobasicinformation").hasClass("active")) {
                        $("#tabprobasicinformation").removeClass("active");
                    }
                }
            }
            return chkval;
        }

        

        var FromWhereData = '';
       
        function GetProjectDetails(FromWhereData, EditProjectId) {
            try {
                var Data = {
                    FromWhereData: encodeURI(FromWhereData), //FromWhereData
                    ProjectID: encodeURI(EditProjectId)
                }

                StartLoader("#BodyCreateProject")
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/GetProjectDetails'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (Result) {


                        if (Result != "") {                            
                            try {
                                //01.04.2021
                                $(".clsSteps").each(function () {
                                    if (LoginType == "C" && ($(this).attr("href") == "#step2" || $(this).attr("href") == "#step3" || $(this).attr("href") == "#step5")) {
                                        $(this).css({ 'pointer-events': 'none' });
                                    }                                    
                                    else if (LoginType == "C" && blnProjectRoleAccess == "True") {
                                        $("#btnDraftNext").attr('disabled', true);
                                    }
                                });
                                //01.04.2021
                                for (var i = 0; i < Result.length; i++) {
                                    //added by Chetan M on 20th Dec 2019                                
                                    SelectedProjectCustomerID = Result[i].ProjectCustomer;
                                    // End of addition by Chetan M on 20th Dec 2019 

                                    $("#textAbbProjectName").val(Result[i].AbbProjectName);
                                    $("#textProjectName").val(Result[i].ProjectName);
                                    $("#textDescription").val(Result[i].Description);
                                    //-----------------Added By Nikhil A 
                                    if (WhichAction == "C") {//Added By Dipali V On 2nd Feb 2021 For Actual project should get to session
                                        var HeaderCaption = $(parent.document.getElementById('mainHeadingProject'));
                                        HeaderCaption.text("");

                                        HeaderCaption.append(" Project : " + Result[i].ProjectName);
                                        HeaderCaption.append(' <i class="fa fa-key" onclick="SetDefaultProject()" title="Set as default project" style="cursor:pointer;"></i>');
                                    }
                                    //-----------------End Of Added By Nikhil A
                                    //Added By Usha Pandit For Changes on 17.01.2020 for work hrs enable disable
                                    globalWorkFlowStatus = Result[i].BaselineStatus;
                                    //End Of Added By Usha Pandit For Changes on 17.01.2020 for work hrs enable disable

                                    if (Result[i].IsOldProject == 1) {
                                        //$("#textNoOfResource").val("");
                                        $("#textNoOfResource").val(Result[i].NoOfResource);
                                        globalNoOfResourceCheck = true;
                                        globalTotalBudgetCheck = true;
                                        $(".clsRequiredResourceLabel").removeClass("required");
                                        $("#textNoOfResource").attr("disabled", true);
                                    }
                                    else {
                                        $("#textNoOfResource").val(Result[i].NoOfResource);
                                    }

                                    $("#dtProjectStartDate").val(Result[i].ProjectStartDate);
                                    $("#dtProjectEndDate").val(Result[i].ProjectEnddate);
                                    $("#cboProjectCustomer").val(Result[i].ProjectCustomer);

                                    $("#textDuration").val(Result[i].Duration);

                                    $("#cboProjectBG").val(Result[i].ProjectBG);
                                    GetLocation(Result[i].ProjectBG);
                                    if ($('#cboProjectOU option').length != 1) {
                                        $("#cboProjectOU").val(Result[i].ProjectOU);
                                    }
                                    else {
                                        $("#cboProjectOU").val(0);
                                    }
                                    //End Of Added By Usha Pandit On 06.03.2020 For selecting placeholder if no data exists in OU dropdown

                                    GetOUDuration();
                                    GetOUHours();


                                    if (WhichAction == "C") {
                                        if ($('#cboProjectStatus option').length != 1) {
                                            $("#cboProjectStatus").val(Result[i].ProjectStatus);
                                        }
                                        else {
                                            $("#cboProjectStatus").val(0);
                                        }

                                    }

                                    $("#texthours").val(Result[i].Hours);

                                    //Added By Usha Pandit On 17.01.2020 For getting saved duration
                                    $("#textDuration").val(Result[i].Duration);
                                    //End Of Added By Usha Pandit On 17.01.2020 For getting saved duration

                                    /// alert(Result[i].ProjectType);
                                    $("#cboPracticeTemplate").val(Result[i].ProjectType);

                                    $("#cboProjectProjectGroup").val(Result[i].ProjectGroupID);

                                    //Added By Dipali V On 31st July 2020  For Alltech Customzation
                                    //debugger;
                                    //Commented and Added By Nikhil A 
                                    //if (IsDUMandetory == "True") {
                                    //    if ($('#cboDU option').length != 1 && Result[i].ResourcePoolID != "") {
                                    //        $("#cboDU").val(Result[i].ResourcePoolID);
                                    //    }
                                    //    else {
                                    //        $("#cboDU").val("0");
                                    //    }
                                    //}
                                    
                                    if ($('#cboDU option').length != 1 && Result[i].ResourcePoolID != "") {
                                            $("#cboDU").val(Result[i].ResourcePoolID);
                                        }
                                        else {
                                            $("#cboDU").val("0");
                                        }
                                   //End of Commented and Added By Nikhil A 

                                    //alert(Result[i].ResourcePoolID);
                                    //debugger;
                                    //if (ISDTMandetory == "True") {
                                    //    if ($('#cboDT option').length != 1 && Result[i].ResourceGroupID != "") {
                                    //        $("#cboDT").val(Result[i].ResourceGroupID);

                                    //    }
                                    //    else {
                                    //        $("#cboDT").val("0");
                                    //    }
                                    //}
                                    
                                     if ($('#cboDT option').length != 1 && Result[i].ResourceGroupID != "") {
                                            $("#cboDT").val(Result[i].ResourceGroupID);

                                        }
                                        else {
                                            $("#cboDT").val("0");
                                    }
                                    
                                    //debugger;
                                    //Added By Dipail V On 7th Aug 2020 For OU Change DU should list out
                                    if (Result[i].ResourceGroupID == "0" || Result[i].ResourceGroupID == "") {
                                        if (Result[i].ProjectOU != "") {
                                            OU_Onchange(Result[i].ProjectOU, 'Edit');
                                             // Added By Nikhil A 
                                            $("#cboDU option[value='" + Result[i].ResourcePoolID + "']").prop('selected', true);
                                            //Commented and Added By Nikhil A 
                                            //if (document.getElementById('cboDU') != null) {
                                            //    document.getElementById('cboDU').insertBefore(new Option("Select Delivery Unit", '0'), document.getElementById('cboDU').firstChild)
                                            //    $("#cboDU option[value=0]").prop('selected', true);
                                            //}
                                         
                                            //if (document.getElementById('cboDT') != null) {
                                            //    $("#cboDT option").remove();
                                            //    document.getElementById('cboDT').insertBefore(new Option("Select Delivery Team", '0'), document.getElementById('cboDT').firstChild)
                                            //    $("#cboDT option[value=0]").prop('selected', true);
                                            //}
                                            //End Of Added By Usha Pandit On 17.08.2020 For checking null value
                                        }
                                    } else {

                                        if (Result[i].ProjectOU != "") {
                                            OU_Onchange(Result[i].ProjectOU, 'Edit');
                                            // document.getElementById('cboDU').insertBefore(new Option("Select Delivery Unit", '0'), document.getElementById('cboDU').firstChild)
                                            //$("#cboDU option[value='" + Result[i].ResourceGroupID + "']").prop('selected', true);
                                            $("#cboDU option[value='" + Result[i].ResourcePoolID + "']").prop('selected', true);

                                        }


                                    }

                                    //debugger;
                                    var ResourceGroupID;
                                    if (Result[i].ResourceGroupID == "0") {

                                        ResourceGroupID = "";
                                    }
                                    else {
                                        ResourceGroupID = Result[i].ResourceGroupID;

                                    }


                                    if ($('#cboDT option').length != 1) {
                                        
                                        if (ResourceGroupID != "") {
                                            ChangeProjectDelivery_Unit(Result[i].ResourcePoolID);
                                            $("#cboDT option[value='" + Result[i].ResourceGroupID + "']").prop('selected', true);
                                            //$("#cboDT").val(ResourceGroupID);
                                        }
                                        else if (ISDUDTDependent == "True") {
                                            // $("#cboDT").val("0");
                                            if (ResourceGroupID == "") {
                                                //alert($("#cboDT").val());
                                                var value = $("#cboDU").val();

                                                //alert(value);
                                                ChangeProjectDelivery_Unit(value);
                                            } else {
                                                ChangeProjectDelivery_Unit(Result[i].ResourcePoolID);
                                            }
                                        }
                                    } else {
                                        $("#cboDT").val("0");
                                    }
                                    //alert($("#cboDT").val());

                                    $("#cboProjectCurrency").val(Result[i].ProjectCurrency);
                                    globalProjectCurrency = Result[i].ProjectCurrency;

                                    $("#cboProjectSponsor").val(Result[i].ProjectSponsar);
                                    if (Result[i].ContractType != 0) {
                                        curGlobalContractType = Result[i].ContractType;
                                        $("#CboCompanyengagemnt").val(Result[i].ContractType);
                                    }

                                    if ($("#CboCompanyengagemnt").val() != 1) {
                                        $(".clsRequiredProjectValue").removeClass("required");
                                        $(".clsRequiredProjectCurrency").removeClass("required");
                                    }
                                    if ($("#CboCompanyengagemnt").val() != 1 && Result[i].ProjectBuget == 0) {
                                        $("#textTotalBudget").val("");
                                    }
                                    else {
                                        //$("#textTotalBudget").val(Result[i].ProjectBuget);//Commented & Added By Dipali V On 9th May 2020 for issue id 24892
                                        $("#textTotalBudget").val(Result[i].ProjectBuget.toFixed(2));
                                    }

                                    if (Result[i].IsBillable == 0) {
                                        $("#chkBillable").prop("checked", false);
                                    }
                                    else {
                                        $("#chkBillable").prop("checked", true);
                                    }

                                    curProjectBudgetValue = Result[i].ProjectBuget;
                                    curProjectSumOfAllBillAmt = Result[i].SumBillAmount;
                                    curProjectCurrencyCode = Result[i].CurrencyCode;
                                    curCorporateCurrencyCode = Result[i].CorporateCurrencyCode;
                                    curGlobalConversionRate = Result[i].ConversionRate;

                                    globalResourceCount = Result[i].NoOfResource;

                                    $("#cboMilestoneCurrency").attr('disabled', false);
                                    $("#cboMilestoneCurrency").val(Result[i].ProjectCurrency);
                                    $("#cboMilestoneCurrency").attr('disabled', true);

                                    GetProjectPractice(Result[i].ProjectType);

                                    if (EditProjectId != 0 && WhichAction == 'C') {
                                        $("#texthours").prop("disabled", true);
                                        $("#textDuration").prop("disabled", true);
                                       
                                        if (globalWFstatus == "Pending Approval") {
                                            $("#texthours").prop("disabled", false);
                                            $("#dtProjectStartDate").prop("disabled", false);
                                            $("#dtProjectEndDate").prop("disabled", false);
                                        }
                                        if ((globalWFstatus == "Approved" && globalWorkFlowStatus == "C") || globalWFstatus == "Pending Approval") {
                                            $("#texthours").prop("disabled", false);
                                            $("#dtProjectStartDate").prop("disabled", false);
                                            $("#dtProjectEndDate").prop("disabled", false);
                                        }
                                        if (globalWorkFlowStatus == "R" || globalWFstatus.indexOf("Rejected") != -1) {
                                            $("#texthours").prop("disabled", false);
                                            $("#dtProjectStartDate").prop("disabled", false);
                                            $("#dtProjectEndDate").prop("disabled", false);
                                        }
                                        if (globalWFstatus == "") {
                                            $("#texthours").prop("disabled", false);
                                            $("#dtProjectStartDate").prop("disabled", false);
                                            $("#dtProjectEndDate").prop("disabled", false);
                                        }
                                       
                                    }
                                    StopAjaxLoader("#BodyCreateProject");
                                }
                            }
                            catch (ex) {
                                //alert(ex.message);
                            }
                        } //Result end if
                    },
                    error: function (err) {
                       
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
                var currencyImagePath = "";
                if (curProjectCurrencyCode == "USD") {
                    currencyImagePath = "../../../Whizible2.0-new/dist/img/USD.svg";
                }
                if (curProjectCurrencyCode == "INR") {
                    currencyImagePath = "../../../Whizible2.0-new/dist/img/rupee.svg";
                }
                if (curProjectCurrencyCode == "SGD") {
                    currencyImagePath = "../../../Whizible2.0-new/dist/img/SGD.svg";
                }
                if (curProjectCurrencyCode == "EUR") {
                    currencyImagePath = "../../../Whizible2.0-new/dist/img/EUR.svg";
                }
                if (curProjectCurrencyCode == "NZD") {
                    currencyImagePath = "../../../Whizible2.0-new/dist/img/NZD.svg";
                }
                if (curProjectCurrencyCode == "GBP") {
                    currencyImagePath = "../../../Whizible2.0-new/dist/img/GBP.svg";
                }

                $("#budgetCurrency").attr("src", currencyImagePath);
                if (curCorporateCurrencyCode == "USD") {
                    currencyImagePath = "../../../Whizible2.0-new/dist/img/USD.svg";
                }
                if (curCorporateCurrencyCode == "INR") {
                    currencyImagePath = "../../../Whizible2.0-new/dist/img/rupee.svg";
                }
                if (curCorporateCurrencyCode == "SGD") {
                    currencyImagePath = "../../../Whizible2.0-new/dist/img/SGD.svg";
                }
                if (curCorporateCurrencyCode == "EUR") {
                    currencyImagePath = "../../../Whizible2.0-new/dist/img/EUR.svg";
                }
                if (curCorporateCurrencyCode == "NZD") {
                    currencyImagePath = "../../../Whizible2.0-new/dist/img/NZD.svg";
                }
                if (curCorporateCurrencyCode == "GBP") {
                    currencyImagePath = "../../../Whizible2.0-new/dist/img/GBP.svg";
                }
                $("#rateCurrency").attr("src", currencyImagePath);
            }
            catch (ex) {
                //alert(ex.message);
            }
        }


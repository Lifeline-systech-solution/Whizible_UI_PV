                                if ((globalWFstatus == "Approved" && globalWorkFlowStatus == "C") || globalWFstatus == "Pending Approval") {
                                    $("#texthours").prop("disabled", false);
                                    $("#dtProjectStartDate").prop("disabled", false);
                                    $("#dtProjectEndDate").prop("disabled", false);
                                }
                                if (globalWorkFlowStatus == "R" || globalWFstatus.indexOf("Rejected") != -1) {
                                    $("#texthours").prop("disabled", false);
                                    $("#dtProjectStartDate").prop("disabled", false);
                                    $("#dtProjectEndDate").prop("disabled", false);
                                }
                                if (globalWFstatus == "") {
                                    $("#texthours").prop("disabled", false);
                                    $("#dtProjectStartDate").prop("disabled", false);
                                    $("#dtProjectEndDate").prop("disabled", false);
                                }
                                //End Of Added By Usha Pandit For Changes on 17.01.2020 for work hrs enable disable
                            }
                            $("#btnDraftNext").attr('disabled', false);
                            if (Browser == 'IE') {
                            }
                            else {
                                $("#btnDraftNext").css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                            }

                        }
                        else {
                            StopAjaxLoader("#BodyCreateProject");
                        }
                        collapseExpandPanel("collapse");
                        //debugger;
                        //Added By Dipali V On 15th Oct 2020 For 2020 For Get According to Contract type Section should display 
                        if ($("#CboCompanyengagemnt").val() != 0) {
                            var curContractType = $("#CboCompanyengagemnt").val();
                            ShowHideMileStoneSite(curContractType);
                        }
                        //End of Added By Dipali V On 15th Oct 2020 For 2020 For Get According to Contract type Section should display
                        $(".nav-tabs li:nth-child(1)").addClass("Compltedstep");
                        var currentImagePath = "../../../Whizible2.0-new/dist/img/tick-green.svg";
                        $(".nav-tabs li:nth-child(1)").find(".completeicon").find("img").attr("src", currentImagePath);
                    },
                    error: function (err) {
                        // alert("error");
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });

                var currencyImagePath = "";
                if (curProjectCurrencyCode == "USD") {
                    currencyImagePath = "../../../Whizible2.0-new/dist/img/USD.svg";
                }
                if (curProjectCurrencyCode == "INR") {

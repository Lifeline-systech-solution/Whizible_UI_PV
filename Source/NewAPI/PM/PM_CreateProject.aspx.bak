                        {
                            strHTML = "";
                            strHTML1 = "";

                            IsCustomFieldAssigned.push(CustomFiledObj.IsCustomFieldAssigned);
                            //Added by imran 05-08-2021 For check validation rule 1 Compulsary or not
                            var ValidationRulesnew = CustomFiledObj.ValidationRules.replace('16,17', '1617').split(",");                           
                            var ruleoneValidationCheck = "";

                            for (n = 0; n < ValidationRulesnew.length; n++)
                            {
                                if (ValidationRulesnew[n] == 1)
                                {
                                    ruleoneValidationCheck = 1;
                                }
                            }
                            //End By imran 05-08-2021

                            if (ruleoneValidationCheck == 1)
                            {
                                strHTML1 += "<div class='form-group text-end' id='div" + CustomFiledObj.DatabaseFieldName + "'>" +
                                    "<label class='control-label' id=" + "lbl" + CustomFiledObj.DatabaseFieldName + ">" + CustomFiledObj.UserGivenCaption + "  ";
                                    if (CustomFiledObj.IsCustomFieldAssigned == true)
                                    {
                                        strHTML1 += "<span id=Mandatory" + CustomFiledObj.DatabaseFieldName + " style = 'color:red;' value = '" + CustomFiledObj.ValidationRules + "'>*</span > ";
                                    }

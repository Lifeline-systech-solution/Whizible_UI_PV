        //New script added by pradip.p on 21-12-2019 for resource cost detail panel

        function Projectcostdetailclick(curCostHeadId, curWorkOrderCostID) {
            //$("div#row-main").css('background','#eeeeee');
            $(".procostdetailpanel").show();
            $('html, body').animate({
                scrollTop: $(".procostdetailpanel").offset().top -= 200
            }, 500);

            if (curCostHeadId != 0 && curWorkOrderCostID != 0) {
                if ($("#costheaddetailslist").hasClass("active")) {
                    $("#procostdetail").removeClass("active");
                    $("#procostmaster").addClass("active");
                    if ($("#procostmaster").hasClass("clsShowHide")) {
                        $("#procostmaster").removeClass("clsShowHide")
                    }
                    $("#costheaddetailslist").removeClass("active");
                    $("#costheadeditlist").addClass("active");
                }
                $("#chkIsActive").prop("disabled", false);
            }
            globalWorkOrderCostID = curWorkOrderCostID;
            globalCostHeadID = curCostHeadId;
            if (curCostHeadId != 0 && curWorkOrderCostID != 0) {
                $("#CPCostHead_0").addClass("clsShowHide");
                $("#editCostHead").removeClass("clsShowHide");
                $("#CPCostGroup_0").addClass("clsShowHide");
                $("#editCostGroup").removeClass("clsShowHide");
                $(".addnewcostbtn, .clsEditEditProjectCost").attr("disabled", true);
                if (Browser == 'IE') {
                }
                else {
                    $(".addnewcostbtn, .clsEditEditProjectCost").css({ 'pointer-events': 'none' });
                }
                $(".clsEditProjectCost, .clsDeleteProCost ").attr("disabled", true);
                if (Browser == 'IE') {
                }
                else {
                    $(".clsEditProjectCost, .clsDeleteProCost ").css({ 'pointer-events': 'none' });
                }
                $('#newproprojectcost').find(".table_outer").find(".dataTables_wrapper").find(".dataTables_paginate").find('*').attr('disabled', true);
                if (Browser == 'IE') {
                }
                else {
                    $('#newproprojectcost').find(".table_outer").find(".dataTables_wrapper").find(".dataTables_paginate").find('*').css({ 'pointer-events': 'none' });
                }
                EnableDisableNavigateLinks("Disable", "Project Cost");
            }
            GetProjectCostDetails(curCostHeadId, curWorkOrderCostID, "details");
            GetProjectCostHeadDetails(curWorkOrderCostID, 0);
            $('#dtCostHeadStartDate, #dtCostHeadEndDate').datepicker({
                autoclose: true,
                changeMonth: true,
                changeYear: true, //added by pradip on 09-04-2020
                dateFormat: 'dd M yy'
            });

            if (curCostHeadId != 0)
                $("#costheaddetailslist").removeClass("clsShowHide");
            return false;
        }
        
        
        function FillRateCardCombo() {
            isRateCardHasMultipleSites = false;
            var CostHeadParameter = {
                CustomerID: encodeURI(SelectedProjectCustomerID),
            }
            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_CreateProject/GetTemplateRateCard',

                method: 'Post',
                data: JSON.stringify(CostHeadParameter),
                dataType: "json",
                async: false,
                contentType: "application/json",  /*;charset-utf=8*/
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (CostHeadParameter) {
                        xhr.setRequestHeader("Params", encryptString(isJson(CostHeadParameter) ? CostHeadParameter : JSON.stringify(CostHeadParameter)));
                    }
                },
                success: function (data) {


                    var RateCardHTML = '';

                    RateCardHTML += '<select id="CboRateCardTemplate" name="CboRateCardTemplate" tabindex="1" style="width : 100%!important;" class="form-control form-select">';
                    RateCardHTML += '<option title = "Select Rate Card" value = "0">Select Rate Card</option>';
                    if (data.length != 0) {
                        for (var i = 0; i < data.length; i++) {
                            var ObjRateCard = data[i];
                            if (ObjRateCard.SiteCount > 1) {
                                isRateCardHasMultipleSites = true;
                            }
                            RateCardHTML += '<option class ="RateCardSiteCount' + ObjRateCard.SiteCount + '" title="' + ObjRateCard.TemplateID + '" value="' + ObjRateCard.TemplateID + '">' + ObjRateCard.TemplateName + '</option>';
                        }
                    }
                    RateCardHTML += '</select>';


                    $(".ratecarddropdown").html(RateCardHTML);
                },
                error: function (xhr, errorThrown) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + xhr + "";
                },
            });
        }
        function isEditOriginalBudgetChanged(curResourceCostId) {
            if ($("#labelBudgetChangeHidden" + curResourceCostId).hasClass("clsOriginalBudgetChange")) {
                if ($("#labelBudgetChangeHidden" + curResourceCostId).hasClass("clsMarkedOriginalBudgetChange")) {

                    if (parseFloat($("#editBudgetHidden" + curResourceCostId).val()) == parseFloat($("#editBudget" + curResourceCostId).val())) {
                        $("#labelBudgetChangeHidden" + curResourceCostId).removeClass("clsOriginalBudgetChange");
                        $("#labelBudgetChangeHidden" + curResourceCostId).removeClass("clsMarkedOriginalBudgetChange");

                        //alert(parseFloat($("#editBudgetHidden" + curResourceCostId).val()));
                        //alert(parseFloat($("#editBudget" + curResourceCostId).val()));
                    }
                }
            }
            else {
                if (parseFloat($("#editBudgetHidden" + curResourceCostId).val()) != parseFloat($("#editBudget" + curResourceCostId).val())) {
                    $("#labelBudgetChangeHidden" + curResourceCostId).addClass("clsOriginalBudgetChange");
                    $("#labelBudgetChangeHidden" + curResourceCostId).addClass("clsMarkedOriginalBudgetChange");
                }
                else {

                }
            }
        }

        function deleteProjectCostDetails() {
            var curProjectCostId = $(".clsdeleteProjectCost").attr('data-id');
            var PMProjectCostParameter = {
                WorkOrderCostID: encodeURI(curProjectCostId),
                ProjectID: encodeURI(globalProjectId),
                WhichAction: encodeURI(WhichAction),
            }

            $.ajax({
                url: strUrl + '/api/PM_CreateProject/DeleteProjectCost',
                method: 'Post',
                data: JSON.stringify(PMProjectCostParameter),
                dataType: 'json',
                async: false,
                contentType: "application/json",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (PMProjectCostParameter) {
                        xhr.setRequestHeader("Params", encryptString(isJson(PMProjectCostParameter) ? PMProjectCostParameter : JSON.stringify(PMProjectCostParameter)));
                    }
                },
                success: function (result) {
                    if (result.toString().indexOf("deleted successfully") != -1) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.success(result);
                        GetProjectCostDetails(0);
                    }
                    else {
                        alertify.set('notifier', 'position', 'top-right');

                        alertify.error(result);
                    }
                    $("#procostdetailpanel").hide('fast');
                    EnableDisableNavigateLinks("Enable", "Project Cost");
                    if (cntProjectCost == 0 && $(".budget_tbl tbody tr td").hasClass("dataTables_empty")) {
                        $(".budget_tbl tbody tr td").removeClass("clsShowHide");
                    }
                },
                error: function (err) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
            if (cntActualProjectCost == 0 && cntResourceCost == 0) {
                $(".nav-tabs li:nth-child(3)").addClass("Compltedstep");
                var currentImagePath = "../../../Whizible2.0-new/dist/img/tick-orange.svg";
                $(".nav-tabs li:nth-child(3)").find(".completeicon").find("img").attr("src", currentImagePath);
            }
        }

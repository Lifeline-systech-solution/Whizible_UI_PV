        function RevisionHistory_onclick() {


            var Parameters = {

                ProjectID: globalProjectId

            }
            var param = JSON.stringify(Parameters);
            var strResult = AJAXCallWithResult("/api/PM_CreateProject/GetRevisionHistory", param, false);
            StartLoader("#BodyCreateProject")
            $("#ProjectRevisionTbody").html('');
            $("#divRevisionhistory").modal("show");
            $("#ProjectRevisionTbl").dataTable().fnDestroy();

            var strHTML = "";
            for (var i = 0; i < strResult.length; i++) {
                //debugger;
                strHTML += '<tr>'
                strHTML += '<td> ' + strResult[i].WorkflowInstanceID + '</td>'
                strHTML += '<td> ' + strResult[i].EventTime + '</td>'
                strHTML += '<td> ' + strResult[i].ActionType + '</td>'
                strHTML += '<td> ' + strResult[i].FromStage + '</td>'
                strHTML += '<td> ' + strResult[i].ToStage + '</td>'
                strHTML += '<td> ' + strResult[i].UserName + '</td>'
                strHTML += '<td> ' + strResult[i].comments + '</td>'
                strHTML += '</tr>'
            }
            $("#ProjectRevisionTbody").html("");

            StopAjaxLoader("#BodyCreateProject")
            $("#ProjectRevisionTbody").append(strHTML);
            tableMilestone = $('#ProjectRevisionTbl').DataTable({
                "pageLength": 5,
                "bdestroy": true,
                "lengthChange": false,
                "bFilter": false,
                "ordering": false,
                "responsive": true,
                "columnDefs": [
                    { "width": "100px" }

                ],
                "drawCallback": function (settings) {
                    $('[data-bs-toggle="tooltip"]').tooltip();
                }
            });


            if (strHTML == "") {
                $("#divRevisionhistory tbody tr td").prop("colspan", 7);
                $("#divRevisionhistory tbody tr td").html("No data available in table");
            }
            //  StopAjaxLoader("#WBSBody")
        }

        <%-- Added by Chetan M on 02 Aug 2021 for capture History --%>
        function History_onclick() {
            var ProjectIDNew = globalProjectId;
            if (WhichAction != 'C') {
                ProjectIDNew = 0;
            }
            var Parameters = {

                ProjectID: ProjectIDNew

            }
            var param = JSON.stringify(Parameters);
            var strResult = AJAXCallWithResult("/api/PM_CreateProject/GetProjectHistory", param, false);
            StartLoader("#BodyCreateProject")
            $("#ProjectHistoryTbody").html('');
            $("#PIShowHistoryModal").modal("show");
            $("#PIHistoryTbl").dataTable().fnDestroy();

            var strHTML = "";
            for (var i = 0; i < strResult.length; i++) {                
                if (strResult[i].Value == null) {
                    strResult[i].Value = '';
                }
                if (strResult[i].NewValue == null) {
                    strResult[i].NewValue = '';
                }
                strHTML += '<tr>'
                strHTML += '<td> ' + strResult[i].FieldName + '</td>'
                strHTML += '<td> ' +strResult[i].Value + '</td>'
                strHTML += '<td> ' + strResult[i].NewValue + '</td>'
                strHTML += '<td> ' + strResult[i].ModifiedDate + '</td>'
                strHTML += '<td> ' + strResult[i].ModifiedBy + '</td>'                
                strHTML += '</tr>'
            }
            $("#ProjectHistoryTbody").html("");

            StopAjaxLoader("#BodyCreateProject")
            $("#ProjectHistoryTbody").append(strHTML);
            tableMilestone = $('#PIHistoryTbl').DataTable({
                "pageLength": 5,
                "bdestroy": true,
                "lengthChange": false,
                "bFilter": false,
                "ordering": false,
                "responsive": true,
                "columnDefs": [
                    { "width": "100px" }

                ],
                "drawCallback": function (settings) {
                    $('[data-bs-toggle="tooltip"]').tooltip();
                }
            });


            if (strHTML == "") {
                $("#PIShowHistoryModal tbody tr td").prop("colspan", 6);
                $("#PIShowHistoryModal tbody tr td").html("No data available in table");
            }
            //  StopAjaxLoader("#WBSBody")
        }


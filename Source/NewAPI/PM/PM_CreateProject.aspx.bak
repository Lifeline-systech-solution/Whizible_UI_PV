        function allowDecimalValues(obj) {
            //alert()
            // debugger;
            varControlval = "";
            var Control = $("#" + obj).val();

            Controlval = Control.replace(/[^\d.]/g, '').replace(/(^[\d]{2})[\d]/g, '$1').replace(/(\..*)\./g, '$1').replace(/(\.[\d]{4})./g, '$1');    // not more than 4 digits after decimal
        }

        //Practice Settings Integration Start
        function BindDataWithAccess() {
            //$("#tblProjectConfigAccess").insertBefore("<a href='#step3' data-bs-toggle='tab' aria-controls='step3' class='btn borderbtn backbtn prevtab mr - 1'>Back</a>");
            $("#tblProjectConfigAccess").dataTable().fnDestroy();
            var createProject = {
                RoleID: encodeURI(RoleID),
                UserID: encodeURI(UserID),
                LoginType: encodeURI(LoginType),
                ProjectID: encodeURI(globalProjectId)
            }
            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_CreateProject/GetProjectNodeAccesDetails',
                method: 'Post',
                data: JSON.stringify(createProject),
                dataType: 'json',
                async: false,
                contentType: "application/json",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (createProject) {
                        xhr.setRequestHeader("Params", encryptString(isJson(createProject) ? createProject : JSON.stringify(createProject)));
                    }
                },
                success: function (result) {
                    console.log(result);
                    m_PKToken = GenerateToken();
                    //validatetoken();
                    var strHtml = "";
                    $("#tblbdyProjectConfigAccess").empty();
                    var GetDetailsWithAccess = result.GetDetailsWithAccess;

                    for (var i = 0; i < GetDetailsWithAccess.length; i++) {
                        var RowID = GetDetailsWithAccess[i]["RowID"];
                        var OrderID = GetDetailsWithAccess[i]["OrderID"];
                        var Settings = GetDetailsWithAccess[i]["Settings"];
                        var URL = GetDetailsWithAccess[i]["URL"];
                        var Description = GetDetailsWithAccess[i]["Description"];
                        var IsActive = GetDetailsWithAccess[i]["IsActive"];
                        var TagID = GetDetailsWithAccess[i]["TagID"];
                        var V = GetDetailsWithAccess[i]["V"];
                        var A = GetDetailsWithAccess[i]["A"];
                        var D = GetDetailsWithAccess[i]["D"];
                        var E = GetDetailsWithAccess[i]["E"];
                        var CompleteAccess = GetDetailsWithAccess[i]["Access"];
                        var Red = GetDetailsWithAccess[i]["Red"];
                        var Green = GetDetailsWithAccess[i]["Green"];
                        var Yellow = GetDetailsWithAccess[i]["Yellow"];

                        if (IsActive == true) {
                            strHtml += "<tr>";
                            if (Green == true) {
                                strHtml += " <td><a data-bs-toggle='tooltip' data-bs-container='body' href='javascript:' class='chckcongigureicon' title='Completed'><i class='far fa-check-circle checkconfgr_circle_green'></i></a></td>";
                            } else if (Yellow == true) {
                                strHtml += " <td><a data-bs-toggle='tooltip' data-bs-container='body' href='javascript:' class='chckcongigureicon' title='Partially Configure'><i class='far fa-check-circle checkconfgr_circle_orang'></i></a></td>";
                            } else {
                                strHtml += " <td><a data-bs-toggle='tooltip' data-bs-container='body' href='javascript:' class='chckcongigureicon'title='Pending'><i class='far fa-check-circle checkconfgr_circle_blue'></i></a></td>";
                            }
                            if (V == false && A == false && D == false && E == false) {
                                strHtml += "<td class='text-start'>" + Settings + "</td>";
                            } else {
                                strHtml += "<td class='text-start'>" + Settings + "</td>";
                            }
                            strHtml += "<td>" + Description + "</td>";
                            strHtml += "<td>";

                            if (V == false && A == false && E == false && CompleteAccess == false) {
                                strHtml += "Configure";
                            } else {
                                //m_PKToken = 1;
                                <%--strHtml += "<a href='#' onclick='window.open(&quot;" + URL + "&PKToken=<%=m_PKToken_FromCreateProject%>&ProjectID=" + globalProjectId + "&quot;,&quot;mywindow&quot;,&quot;width=1100,scrollbars=yes,height=500&quot;);' >Configure</a>";--%>
                                //Commented And Added By Omkar P On 19.12.2019
                                //strHtml += "<a href='#' onclick='window.open(&quot;" + URL + "&ProjectID=" + globalProjectId + "&PKToken=" + m_PKToken + "&quot;,&quot;mywindow&quot;,&quot;width=1100,scrollbars=yes,height=500&quot;);' >Configure</a>";
                                strHtml += "<a href='#' onclick='window.open(&quot;" + URL + "&ProjectID=" + globalProjectId + "&PKToken=" + m_PKToken + "&quot;,&quot;mywindow&quot;,&quot;width=1100,resizable=yes,scrollbars=yes,toolbar=yes,menubar=yes,location=yes,height=500&quot;);' >Configure</a>";
                                //End Of Added By Omkar P On 19.12.2019
                            }
                            strHtml += "</td>";
                            strHtml += "</tr>";
                        }
                    }
                    $("#tblbdyProjectConfigAccess").html(strHtml);

                    $('#tblProjectConfigAccess').DataTable({
                        "bFilter": false,
                        "ordering": false,
                        "responsive": true,
                        "searching": true,
                        "scrollCollapse": true,
                        "paging": false,
                        "bInfo": false,
                        "bSortable": false
                    });
                    $('[data-bs-toggle="tooltip"]').tooltip();
                    //alert($("#tblProjectConfigAccess_filter label").html());
                    //var searchbackHTML = $("#tblProjectConfigAccess_filter label").html();
                    //searchbackHTML = searchbackHTML + '<a href="#step3" data-bs-toggle="tab" aria-controls="step3" class="btn borderbtn backbtn searchprevtab mr-1">Back</a>';
                    //$("#tblProjectConfigAccess_filter label").html(searchbackHTML);

                    //<a href="#step3" data-bs-toggle="tab" aria-controls="step3" class="btn borderbtn backbtn prevtab mr-1">Back</a>
                    $(".backbtn").insertAfter("#tblProjectConfigAccess_filter label");
                    $('<a href="#step3" data-bs-toggle="tab" aria-controls="step3" class="btn borderbtn backbtn searchprevtab mr-1">Back</a>').insertAfter("#tblProjectConfigAccess_filter label");
                    //$('.searchprevtab').click(function () {
                    $(".searchprevtab").on('click', function () {
                        //$('.nav-tabs > .active').prev('li').find('a').trigger('click');
                        //$(".nav-tabs li:nth-child(4)").removeClass("active");
                        //$(".nav-tabs li:nth-child(3)").addClass("active")

                        var active = $('.wizard .wizard-inner .nav-tabs li a.active');
                        var prevTab1 = active.parents('li');
                        var whichtab = $(prevTab1).prev('li').find('a').attr('href');
                        $('.wizard>.tab-content>.tab-pane').removeClass('active');
                        $('.wizard>.tab-content>.tab-pane').removeClass('show');
                        $(whichtab).addClass('active');
                        $(whichtab).addClass('show');
                        $(".wizard .wizard-inner .nav-tabs li").removeClass('Compltedstep');
                        $(".wizard .wizard-inner .nav-tabs li a").removeClass('active');
                        prevTab1.addClass('Compltedstep');
                        $(prevTab1).prev('li').find('a').addClass('active');

                    });
                },
                error: function (err) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + "";
                }
            });
        }

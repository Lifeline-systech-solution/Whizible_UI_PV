        //plotting The Custom fields 01-07-2021
        function PloatCustomControl1(ProjectID, DatabaseFieldName,ShowOnlyActive, Type, EntityName, UserID,LoginType) 
        {     
            var strHTML = "";
            var strHTML1 = "";
            var customFiled = { ProjectId: ProjectID, DatabaseFieldName: DatabaseFieldName, ShowOnlyActive: ShowOnlyActive, Type: Type, EntityName: EntityName, UserID: UserID, LoginType: LoginType };
            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_CreateProject/GetCustomFieldsMaster',
                method: 'Post',
                data: JSON.stringify(customFiled),
                dataType: 'json',
                async: false,
                contentType: "application/json",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (customFiled) {
                        xhr.setRequestHeader("Params", encryptString(isJson(customFiled) ? customFiled : JSON.stringify(customFiled)));
                    }
                },
                success: function (result)
                {
                    for (var i = 0; i < result.length; i++)
                    {                        
                        var CustomFiledObj = result[i];
                       // console.log(CustomFiledObj);

                        var custCon = "#custr" + CustomFiledObj.RowNumber + "c" + CustomFiledObj.ColumnNumber;
                        var custCon1 = "#custr" + CustomFiledObj.RowNumber + "L" + CustomFiledObj.ColumnNumber;

                        GetUniqueID.push(CustomFiledObj.UniqueID);

                        //CustomFieldText

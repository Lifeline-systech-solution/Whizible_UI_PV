        function getProjectCode(ProjectOU, ProjectBG, ProjectGroupID, ProjectCustomer, IsBillable) {
            var curProjectcode = "";
            var ProjectCodeParameter = {
                ProjectOU: encodeURI(ProjectOU),
                ProjectBG: encodeURI(ProjectBG),
                ProjectGroupID: encodeURI(ProjectGroupID),
                ProjectCustomer: encodeURI(ProjectCustomer),
                IsBillable: encodeURI(IsBillable)
            }

            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_CreateProject/getProjectCode',

                method: 'Post',
                data: JSON.stringify(ProjectCodeParameter),
                dataType: "json",
                async: false,
                contentType: "application/json",  /*;charset-utf=8*/
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (ProjectCodeParameter) {
                        xhr.setRequestHeader("Params", encryptString(isJson(ProjectCodeParameter) ? ProjectCodeParameter : JSON.stringify(ProjectCodeParameter)));
                    }
                },
                success: function (data) {

                    if (data.length != 0) {
                        for (var i = 0; i < data.length; i++) {

                            var ObjProjCode = data[i];
                            //alert(ObjProjCode.ErrorCode);
                            //alert(ObjProjCode.JobCode);
                            curProjectcode = ObjProjCode.JobCode;
                            //objOption.text = ObjProjCode.ErrorCode;
                            //objOption.value = ObjProjCode.JobCode;
                        }
                    }
                },
                error: function (xhr, errorThrown) {
                    curProjectcode = "";
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + xhr + "";
                    //alert(xhr.error);
                },
            });
            return curProjectcode;
        }

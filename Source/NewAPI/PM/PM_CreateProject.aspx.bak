        var FromWhereAction = "";
        var ProjectOnHoldComments = "";
        var BlockTimeSheetComments = "";
        function Action_onclick(FromWhere) {
            GetAllComments();
            FromWhereAction = FromWhere;
            $("#txtComments").val('');
            $("#divComments").modal('show');
            if (FromWhere == 'HP' || FromWhere == 'RP') { //ON HOLD ,RESUME PROJECT
                $("#txtComments").val(ProjectOnHoldComments);
            }
            else if (FromWhere == 'RT' || FromWhere == 'HT') { //BLOACK TIMESHEET ,RESUME TIMESHEET
                $("#txtComments").val(BlockTimeSheetComments);
            }


        }

        function Comments_onclick(FromWhere) {
            var comment = $("#txtComments").val();         //Added By Rehan C
            if ($("#txtComments").val() == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_Comments") %>', 'error', 25);
                $("#txtComments").focus();
                return false;

            }
            //Added By Rehan on 07/11/2022 To check validation for Special characters  on 11/11/2022
            if (checkSpecialCharacter(comment, WebConfigSpecialCharacters) == true) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('Comment Should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                $("#txtComments").focus();
                return false;
            }
            //End of Comment By Rehan C
            var Parameters = {

                ProjectID: globalProjectId,
                Remarks: $("#txtComments").val().toString().replace(/'/g, "''"),
                TagID: 32,
                WhichFlag: FromWhereAction,
                UserName: StrUserName

            }

            //hold Timesheet,Resume timesheet,Resume project,block timesheet
            var param = JSON.stringify(Parameters);
            var strResult = AJAXCallWithResult("/api/PM_CreateProject/TakeActionHPHTBT", param, false);
            if (strResult != undefined) {
                StartLoader("#BodyCreateProject")
                if (strResult == "1") {

                    alertify.set('notifier', 'position', 'top-right');
                    //alertify.notify("Action taken Successfully.", 'success', 25);
                    alertify.notify('<%= MyBase.GetResourceString("A_ActionDone") %>', 'success', 25);
                    $("#divComments").modal('hide');
                    CheckIsBlockTimesheet = 0;
                    WorkFlowLink(32, globalProjectId);

                    //Added By Usha Pandit For Changes on 18.01.2020 for work hrs enable disable                       
                    GetProjectDetails(WhichAction, globalProjectId);
                    //End Of Added By Usha Pandit For Changes on 18.01.2020 for work hrs enable disable

                    StopAjaxLoader("#BodyCreateProject");
                }

            }
        }


        function GetAllComments() {
            var Parameters = {
                ProjectID: globalProjectId,
                TagID: 32,
                //WhichFlag: FromWhereAction,
                //UserName : StrUserName

            }

            //hold Timesheet,Resume timesheet,Resume project,block timesheet
            var param = JSON.stringify(Parameters);
            var strResult = AJAXCallWithResult("/api/PM_CreateProject/GetComments", param, false);
            if (strResult != undefined) {

                if (strResult != "") {
                    for (i = 0; i <= strResult.length - 1; i++) {
                        //debugger;
                        ProjectOnHoldComments = strResult[i].ProjectOnHoldComments;
                        BlockTimeSheetComments = strResult[i].BlockTimeSheetComments;

                    }
                }

            }
        }

        var ajaxResult;
        function AJAXCallWithResult(url, param, async) {

            $.ajax({
                url: encodeURI(strUrl) + url,
                type: "POST",
                data: param,
                async: async,
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (param) {
                        xhr.setRequestHeader("Params", encryptString(isJson(param) ? param : JSON.stringify(param)));
                    }
                },
                success: function (data) {
                    StopAjaxLoader("#WBSBody");
                    ajaxResult = data;
                },
                error: function (err) {
                    StopAjaxLoader("#WBSBody");
                    console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
            return ajaxResult;
        }

        //Added By Rutuja D. on 26 March 2020 For Issueid = 23015
        function GetBusinessGroup() {

            ProjectID = globalProjectId;
            var param = JSON.stringify(ProjectID);
            var strResult = AJAXCallWithResult("/api/PM_CreateProject/GetBusinessGroup", param, false);

            var objCbo1 = document.getElementById("cboProjectBG");

            $("#cboProjectBG option").remove();

            for (var i = 0; i < strResult.length; i++) {
                var Objresult = strResult[i];
                var objOption = document.createElement("OPTION");
                objCbo1.options.add(objOption);

                objOption.text = Objresult.BusinessGroup;
                objOption.value = Objresult.BusinessGroupID;

            }

        }
        //End Added By Rutuja D. on 26 March 2020 For Issueid = 23015
        //Added By Dipali V ON 32st July 2020 For Alttech Customzation
        var IsDUMandetory = ""; IsDUReqclass = ""; ISDTMandetory = "", IsDTReqclass = "";
        var strhtmlNew = "";
        function GetplotConditionalyControl() {

            $.ajax({
                url: encodeURI(strUrl + '/api/PM_CreateProject/GetplotConditionalyControl'),
                type: "POST",
                data: JSON.stringify(),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                },
                success: function (result) {
                    //debugger;
                    strhtmlNew = '<div class="row newproformrow">'
                    for (var i = 0; i < result.length; i++) {
                        ISDUEnabled = result[i].ISDUEnabled;
                        ISDTEnabled = result[i].ISDTEnabled;
                        ISDUMandetory = result[i].ISDUMandetory;
                        ISDTMandetory = result[i].ISDTMandetory;
                        ISDUDTDependent = result[i].ISDUDTDependent;
                        //debugger;
                        if (ISDUEnabled == "True") {
                            if (ISDUMandetory == "True") {
                                IsDUMandetory = "True"
                                IsDUReqclass = "required";
                            }
                            else {
                                IsDUMandetory = "False";
                                IsDUReqclass = "";

                            }
                            if (ISDUDTDependent == "True") {
                                strhtmlNew += '<div class="col-sm-3"><label class="control-label ' + IsDUReqclass + ' mt-onehalf text-end">Delivery Unit</label></span><div>';
                                strhtmlNew += '<%=CommonFunctions.HTMLControls.DrawComboBox("cboDU", "usp_whizible2_sel_tbl_PM_DeliveryUnit", , , "Onchange=""ChangeProjectDelivery_Unit('')"" Mandatory=1 class=""form-control form-select""", False, ReturnAsHTML:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                 strhtmlNew += '</div>';
                                 strhtmlNew += '</div>';

                             }
                             else {
                                 strhtmlNew += '<div class="col-sm-3"><label class="control-label ' + IsDUReqclass + ' mt-onehalf text-end">Delivery Unit</label><div>';
                                 strhtmlNew += '<%=CommonFunctions.HTMLControls.DrawComboBox("cboDU", "usp_whizible2_sel_tbl_PM_DeliveryUnit", , , "Mandatory=0 class=""form-control form-select""", False, ReturnAsHTML:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                 strhtmlNew += '</div>';
                                 strhtmlNew += '</div>';
                             }
                         }

                         if (ISDTEnabled == "True") {
                             // if (ISDTMandetory == "True") {
                             //     IsDTMandetory = "1";
                             //     IsDTReqclass="required";
                             //}
                             //else {
                             //     IsDUMandetory = "0";
                             //     IsDUReqclass="";

                             //}
                             if (ISDTMandetory == "True") {
                                 strhtmlNew += '<div class="col-sm-3"><label class="control-label required mt-onehalf text-end">Delivery Team</label><div>';
                                 strhtmlNew += '<%=CommonFunctions.HTMLControls.DrawComboBox("cboDT", "usp_whizible2_sel_tbl_PM_DeliveryTeam", , , "Mandatory=1 class=""form-control form-select""", False, ReturnAsHTML:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                 strhtmlNew += '</div>';
                                 strhtmlNew += '</div>'
                             }
                             else {
                                 strhtmlNew += '<div class="col-sm-3"><label class="control-label  mt-onehalf text-end">Delivery Team</label><div>';
                                 strhtmlNew += '<%=CommonFunctions.HTMLControls.DrawComboBox("cboDT", "usp_whizible2_sel_tbl_PM_DeliveryTeam", , , "Mandatory=0 class=""form-control form-select""", False, ReturnAsHTML:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                 strhtmlNew += '</div>';
                                 strhtmlNew += '</div>';
                             }
                         }
                         strhtmlNew += '</div>';
                     }
                     $(".DivConfigure").html("");
                     //$(".DivConfigure").html(strhtmlNew);
                 },
                 error: function (err) {
                     //alert(err.responseText);
                     window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                     //StopAjaxLoader("#bodyIssueDetails");
                 }
             });
            //alert(strhtmlNew);
            $(".DivConfigure").html(strhtmlNew);
        }



        //For Onchange of DU Get DT
        function ChangeProjectDelivery_Unit(value) {

            //if (Flag == "Add") {
            //    var DUvalue = $("#cboDU").val();
            //} else {
            //    DUvalue = Flag;

            //}

            if (value == "" && value != undefined) {
                DUvalue = $("#cboDU").val();
            } else {
                DUvalue = value;
            }
            // alert(DUvalue);
            if (DUvalue != "0") {
                if ($("#cboDT").length != "0") {
                    var DUvalue = { DUvalue: DUvalue };
                    var param = JSON.stringify(DUvalue);
                    var strResult = AJAXCallWithResult("/api/PM_CreateProject/GetProjectDeliveryTeam", param, false);

                    var objCboDT = document.getElementById("cboDT");

                    $("#cboDT option").remove();

                    for (var i = 0; i < strResult.length; i++) {
                        var Objresult = strResult[i];
                        var objOption = document.createElement("OPTION");
                        objCboDT.options.add(objOption);

                        objOption.text = Objresult.DTName;
                        objOption.value = Objresult.DTID;

                    }

                }
            }
            else {
                //Commented and added by Chetan M on 16 Dec 2020 for issue fixing
                //$("#cboDT option").remove();
                //document.getElementById('cboDT').insertBefore(new Option("Select Delivery Team", '0'), document.getElementById('cboDT').firstChild)
                //$("#cboDT option[value=0]").prop('selected', true);
                if (document.getElementById('cboDT') != null) {
                    $("#cboDT option").remove();
                    document.getElementById('cboDT').insertBefore(new Option("Select Delivery Team", '0'), document.getElementById('cboDT').firstChild)
                    $("#cboDT option[value=0]").prop('selected', true);
                }
                //End of Commented and added by Chetan M on 16 Dec 2020 for issue fixing

            }

        }

        var OUvalue = "";
        var flag;
        function OU_Onchange(OUvalue, flag) {
            //debugger;

            //Commented And Added By Usha Pandit On 14.08.2020 For getting DU/Dt drop down on project creation             
            //if ($("#cboProjectOU") != undefined) {
            if ($("#cboProjectOU") != undefined && globalProjectId != 0 && WhichAction == 'C') {
                ProjectID = globalProjectId;
                //End Of Added By Usha Pandit On 14.08.2020 For getting DU/Dt drop down on project creation             
                if (OUvalue == "" || OUvalue == undefined) {
                    OUvalue = $("#cboProjectOU").val();
                }
                else {
                    OUvalue = OUvalue;
                }
                //alert(OUvalue);
                if (OUvalue != "0") {
                    if ($("#cboDU").length != "0") {
                        var OUvalue = { OUvalue: OUvalue, ProjectID: ProjectID };
                        var param = JSON.stringify(OUvalue);
                        var strResult = AJAXCallWithResult("/api/PM_CreateProject/GetProjectDeliveryUNIT", param, false);

                        var objcboDU = document.getElementById("cboDU");
                        //objcboDU.options.add(objOption);
                        //objOption.text = "";
                        //objOption.value = "";

                        $("#cboDU option").remove();
                        if (flag == "OnChange") {
                            //Commented and added by Chetan M on 16 Dec 2020 for issue fixing
                            //document.getElementById('cboDU').insertBefore(new Option("Select Delivery Unit", '0'), document.getElementById('cboDU').firstChild)
                            //$("#cboDU option[value=0]").prop('selected', true);
                            if (document.getElementById('cboDU') != null) {
                                document.getElementById('cboDU').insertBefore(new Option("Select Delivery Unit", '0'), document.getElementById('cboDU').firstChild)
                                $("#cboDU option[value=0]").prop('selected', true);
                            }
                            //End of Commented and added by Chetan M on 16 Dec 2020 for issue fixing
                        }
                         else {
                            $("#cboDU option").remove();
                                document.getElementById('cboDU').insertBefore(new Option("Select Delivery Unit", '0'), document.getElementById('cboDU').firstChild)
                                $("#cboDU option[value=0]").prop('selected', true);
                        }
                        //$('#cboDU option').append('<option value="0">Select Delivery Unit </option>');
                        for (var i = 0; i < strResult.length; i++) {
                            //debugger;
                            var Objresult = strResult[i];
                            var objOption = document.createElement("OPTION");
                            objcboDU.options.add(objOption);
                            //if (i == 0) {
                            //   objOption.text = "";
                            //   objOption.value = "0";
                            //}


                            objOption.text = Objresult.DUName;
                            objOption.value = Objresult.DUID;
                            //$( "#myselect option:selected" ).text();
                            if (flag == "OnChange") {
                                if ($("#cboDT").length != 0) {
                                    if (document.getElementById('cboDT') != null) {
                                        $("#cboDT option").remove();
                                        document.getElementById('cboDT').insertBefore(new Option("Select Delivery Team", '0'), document.getElementById('cboDT').firstChild)
                                        $("#cboDT option[value=0]").prop('selected', true);
                                        // $("#cboDU option[value=0]").prop('selected', true);
                                    }
                                }
                            }

                        }

                    }
                }
                else {
                    //Commented and added by Chetan M on 16 Dec 2020 for issue fixing
                   // $("#cboDU option").remove();
                     //document.getElementById('cboDU').insertBefore(new Option("Select Delivery Unit", '0'), document.getElementById('cboDU').firstChild)
                     //   $("#cboDU option[value=0]").prop('selected', true);
                    if (document.getElementById('cboDU') != null) {
                         $("#cboDU option").remove();
                        document.getElementById('cboDU').insertBefore(new Option("Select Delivery Unit", '0'), document.getElementById('cboDU').firstChild)
                        $("#cboDU option[value=0]").prop('selected', true);
                    }

                    //$("#cboDT option").remove();
                    //document.getElementById('cboDT').insertBefore(new Option("Select Delivery Team", '0'), document.getElementById('cboDT').firstChild)
                    //$("#cboDT option[value=0]").prop('selected', true);
                    if (document.getElementById('cboDT') != null) {
                        $("#cboDT option").remove();
                        document.getElementById('cboDT').insertBefore(new Option("Select Delivery Team", '0'), document.getElementById('cboDT').firstChild)
                        $("#cboDT option[value=0]").prop('selected', true);
                    }
                    //End of Commented and added by Chetan M on 16 Dec 2020 for issue fixing
                }
            }
            //debugger;
            //alert($("#cboDT").val());        


        }


        //Added By Riddhesh Patil on 10-NOV-2022 
        function checkSpecialCharacter(value, WebConfigSpecialCharacters) {
            if (WebConfigSpecialCharacters != '') {
                var regularExpression = WebConfigSpecialCharacters;
                regularExpression += '"';
                var isSpecialCharacter = 0;
                for (var i = 0; i < regularExpression.length; i++) {
                    if (value.indexOf(regularExpression[i]) != -1) {
                        isSpecialCharacter = 1
                    }
                }
                if (isSpecialCharacter == 1) {
                    return true;
                }
                else {
                    return false;
                }
            }
            else {
                return false;
            }
        }
		//End of Added By Riddhesh Patil

    </script>
    <!--read more read less jquery-->
</head>


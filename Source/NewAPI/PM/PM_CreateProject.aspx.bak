                    ResourceGroupID: encodeURI(ResourceGroupID),
                    ResourcePoolID: encodeURI(ResourcePoolID),
                    ProjectStatus: encodeURI(ProjectStatus),
                    //End of Added By Dipali V On 31st July 2020 For Alltech Customzation
                }
                StartLoader("#BodyCreateProject")
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/Draft_ProjectDetails'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (Result) {
                        // debugger;

                        if (Result != "") {
                            //-----------------Added By Nikhil A ----------------------
                            if (WhichAction == "C") {//Added By Dipali V On 2nd Feb 2021 For Actual project should get to session
                                var HeaderCaption = $(parent.document.getElementById('mainHeadingProject'));
                                HeaderCaption.text("");
                                //HeaderCaption.text("Project : " + ProjectName);
                                HeaderCaption.append(" Project : " + ProjectName);
                                HeaderCaption.append(' <i class="fa fa-key" onclick="SetDefaultProject()" title="Set as default project" style="cursor:pointer;"></i>');
                                //Added By Dipali V On 2nd Feb 2021 only Actual Project Should Set to session
                                setSessionProject(globalProjectId, ProjectName)
                            }
                             //End of Added By Dipali V On 2nd Feb 2021 only Actual Project Should Set to session
                            //------------------Added By Nikhil A----------------------
                            var prjResult = Result.split("##");
                            StopAjaxLoader("#BodyCreateProject");
                            alertify.set('notifier', 'position', 'top-right');
                            if (WhichAction == "C") {

                                <%--alertify.notify('<%= MyBase.GetResourceString("A_SaveProject") %>', 'success', 5);--%>

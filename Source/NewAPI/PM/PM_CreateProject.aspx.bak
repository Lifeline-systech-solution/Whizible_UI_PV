        function Edit_ProjectCost(WorkOrderCostID, enableEditForAmount, editMode, e) {
            if (IsSaveButtonEnabled == 0) {

                $(".addnewcostbtn").attr("disabled", true);
                if (Browser == 'IE') {
                }
                else {
                    $(".addnewcostbtn").css({ 'pointer-events': 'none' });
                }
                if ($(".clsEditProjectCost").attr("disabled") != "disabled") {
                    EnableDisableProjectCostFields(false, WorkOrderCostID, enableEditForAmount, editMode);
                }
                $(".clsEditEditProjectCost").prop("disabled", true);

                if (Browser == 'IE') {
                }
                else {
                    $(".clsEditEditProjectCost").css({ 'pointer-events': 'none' });

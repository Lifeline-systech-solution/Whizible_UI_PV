        function CheckResourceDefaultAssignment() {

            var isAssignToProjectByDefault = 0;
            var Data = {
                RoleID: encodeURI(RoleID),
            }
            StartLoader("#BodyCreateProject");
            $.ajax({
                url: encodeURI(strUrl + '/api/PM_CreateProject/Get_ProjectRoleDetails'),
                type: "POST",
                data: JSON.stringify(Data),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (Data) {
                        xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                    }
                },
                success: function (Result) {
                    if (Result != "") {
                        for (var i = 0; i < Result.length; i++) {
                            isAssignToProjectByDefault = Result[i].AssignToProjectByDefault;
                            globalRoleLevel = Result[i].Level;
                        }
                    }
                    else {
                        //StopAjaxLoader("#BodyCreateProject");
                    }
                },
                error: function (err) {
                    console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });

            return isAssignToProjectByDefault;
        }


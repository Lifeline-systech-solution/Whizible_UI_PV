                                        "</textarea>";
                                }
                                else
                                {
                                    strHTML += "<span id='res" + CustomFiledObj.DatabaseFieldName + "'><b> NA </b> </span>";

                                    //added by imran 09-07-2021 for hide the input box IsCustomFieldAssigned=false
                                    strHTML += "<br/><input type='hidden' class='form-control' id='txt" + CustomFiledObj.DatabaseFieldName + "' autocomplete='off'  value=" + CustomFiledObj.DefaultValue + " >";

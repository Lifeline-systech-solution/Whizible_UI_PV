        function SetSaveSiteDetails(flag) {
            if (flag == "Edit") {
                $("#btnEditSaveSite").removeAttr("data-bs-target");
            }
            else {
                $("#btnSaveSite").removeAttr("data-bs-target");
            }

            if (ValidateSite(flag) == 0) {

                var SiteOffShoreCheck = false;
                if (flag == "Edit") {
                    objOffShoreCheck = document.getElementById("chkEditOffshoreSite");
                    if ($("#chkEditOffshoreSite").is(':checked')) {
                        SiteOffShoreCheck = true;
                    }
                    else {
                        SiteOffShoreCheck = false;
                    }
                }
                else {
                    objOffShoreCheck = document.getElementById("chkAddOffshoreSite");
                    if ($("#chkAddOffshoreSite").is(':checked')) {
                        SiteOffShoreCheck = true;
                    }
                    else {
                        SiteOffShoreCheck = false;
                    }
                }
                if (SiteOffShoreCheck == true) {
                    if (cntSites != 0) {
                        if ((isDefaultSiteExists == true && flag != "Edit") || (isDefaultSiteExists == true && flag == "Edit" && SelectedProjectSiteID != DefaultSiteId)) {
                            if (flag == "Edit") {
                                $("#btnEditSaveSite").attr("data-bs-target", "#offshoreNotificationModal");
                            }
                            else {
                                $("#btnSaveSite").attr("data-bs-target", "#offshoreNotificationModal");
                            }
                            $("#btnSaveDefaultSite").unbind('click');
                            $('#btnSaveDefaultSite').click(function (e) {
                                //e.preventDefault();                                
                                Save_Site(flag);
                            });
                        }
                        else {
                            Save_Site(flag);
                        }
                    }
                    else {
                        Save_Site(flag);
                    }
                }
                else {
                    Save_Site(flag);
                }
            }
        }
        function Save_Site(flag)
        {            
            if (ValidateSite(flag) == 0) {

                var City = $("#txtCity").val();
                var WeekDays = $("#txtWeekDays").val();
                var WorkHrs = $("#txtWorkHours").val();
                var HoursPerMonth = $("#txtWorkHoursPerMonth").val();
                var WorkHoursCapPerDay = $("#txtWorkHoursCap").val();

                var SiteName = $("#txtSiteName").val();
                var SiteCurrency = $("#cboSiteCurrency option:selected").val();
                var SiteRateMethod = $("#cboRateMethod option:selected").val();
                var SiteWeekStartDay = $("#cboStartingDayOfWeek option:selected").val();
                var blnIsOffshore = 0;
                var SiteShortName = '';

                var SiteAddress1 = '';
                var SiteAddress2 = '';
                var SiteCountry = 0;
                var SiteState = '';

                var SiteZip = '';
                var SiteFax = '';
                var SitePhone = '';
                var SiteEmailID = '';
                var SiteRemarks = '';

                if (flag == "Edit") {
                    City = $("#txtEditCity").val();
                    SiteName = $("#txtEditSiteName").val();
                    SiteShortName = $("#txtEditSiteShortName").val();
                    SiteAddress1 = $("#txtEditAddress1").val();
                    SiteAddress2 = $("#txtEditAddress2").val();
                    SiteState = $("#txtEditState").val();
                    SiteZip = $("#txtEditZip").val();
                    SiteFax = $("#txtEditFax").val();
                    SitePhone = $("#txtEditPhone").val();
                    SiteEmailID = $("#txtEditEmail").val();
                    SiteRemarks = $("#txtEditRemarks").val();
                    //Added by imran on 06-09-2022
                    if ($("#cboEditSiteCountry option:selected").val() == "") {
                        SiteCountry = 0;
                    }
                    else {
                        SiteCountry = $("#cboEditSiteCountry option:selected").val();
                    }
                    //End of comment by imran on 06-09-2022
                    
                    SiteCurrency = $("#cboEditSiteCurrency option:selected").val();
                    //SiteCurrency = $("#cboEditSiteCurrency option:selected").text();
                    SelectedSiteCurrencytext = $("#cboEditSiteCurrency option:selected").text();;//Added By Dipali V On 11th June 2020 For Issue ID 24913
                    SiteRateMethod = $("#cboEditRateMethod option:selected").val();
                    SiteWeekStartDay = $("#cboEditStartingDayOfWeek option:selected").val();
                    WeekDays = $("#txtEditWeekDays").val();
                    WorkHrs = $("#txtEditWorkHours").val();
                    HoursPerMonth = $("#txtEditWorkHoursPerMonth").val();
                    WorkHoursCapPerDay = $("#txtEditWorkHoursCap").val();
                    if ($("#chkEditOffshoreSite").is(':checked')) {
                        blnIsOffshore = 1;
                    }
                }
                else {
                    if ($("#chkAddOffshoreSite").is(':checked')) {
                        blnIsOffshore = 1;
                    }
                }

                var ProjectSiteID = '';
                if (SelectedProjectSiteID != "") {
                    ProjectSiteID = SelectedProjectSiteID;
                } else {
                    //Commented and added by imran on 06-09-2022
                    //ProjectSiteID = "NULL";
                    ProjectSiteID = 0;
                     //End of comment by imran on 06-09-2022
                }

                var Data = {
                    ProjectSiteID: encodeURI(ProjectSiteID),
                    ProjectID: encodeURI(globalProjectId),
                    CurrencyID: encodeURI(SiteCurrency),
                    RateMethod: encodeURI(SiteRateMethod),
                    StartingDayOfWeek: encodeURI(SiteWeekStartDay),
                    Name: encodeURI(SiteName),
                    City: encodeURI(City),
                    WeekDays: encodeURI(WeekDays),
                    WorkHrs: encodeURI(WorkHrs),
                    HoursPerMonth: encodeURI(HoursPerMonth),
                    WorkHoursCapPerDay: encodeURI(WorkHoursCapPerDay),
                    StrUserName: encodeURI(StrUserName),
                    WhichAction: encodeURI(WhichAction),
                    IsOffshore: encodeURI(blnIsOffshore),
                    ShortName: encodeURI(SiteShortName),
                    Address: encodeURI(SiteAddress1),
                    Address1: encodeURI(SiteAddress2),
                    CountryID: encodeURI(SiteCountry),
                    State: encodeURI(SiteState),
                    Zip: encodeURI(SiteZip),
                    Fax: encodeURI(SiteFax),
                    Phone: encodeURI(SitePhone),
                    EmailID: encodeURI(SiteEmailID),
                    Remarks: encodeURI(SiteRemarks),
                }
                              
                StartLoader("#BodyCreateProject")
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/Save_SiteDetails'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (Result) {
                        // debugger;                        
                        if (Result != "") {
                            StopAjaxLoader("#BodyCreateProject");
                            alertify.set('notifier', 'position', 'top-right');
                            if (flag == "Edit") {
                                alertify.notify('<%= MyBase.GetResourceString("A_SiteUpdate") %>', 'success', 5);
                            }
                            else {
                                alertify.notify('<%= MyBase.GetResourceString("A_Site") %>', 'success', 5);
                            }
                            $("#CPaddnewsitemodal").modal('hide');
                            GetSiteDetails();
                            if (flag == "Edit") {
                                if (blnIsOffshore == 0) {
                                    $("#chkEditOffshoreSite").prop("checked", false);
                                    $("#chkEditOffshoreSite").prop("disabled", false);
                                }
                                else {
                                    $("#chkEditOffshoreSite").prop("checked", true);
                                    $("#chkEditOffshoreSite").prop("disabled", true);
                                }
                            }
                            //ClearAllMileStoneControls();
                        }
                        else {
                            StopAjaxLoader("#BodyCreateProject");
                        }
                        $(".nav-tabs li:nth-child(2)").addClass("Compltedstep");
                        var currentImagePath = "../../../Whizible2.0-new/dist/img/tick-green.svg";
                        $(".nav-tabs li:nth-child(2)").find(".completeicon").find("img").attr("src", currentImagePath);
                        collapseExpandPanel("collapse");
                        if (SelectedFreezeFlag == 1) {
                            $("#lnkfreezeSite").addClass("clsShowHide");
                        }
                        else if (SelectedFreezeFlag == 0 && SelectedWhichAction == 'C' && $("#lnkfreezeSite").hasClass("clsShowHide") == true) {
                            $("#lnkfreezeSite").removeClass("clsShowHide");
                        }
                    },
                    error: function (err) {
                        // alert("error");
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
            }
        }

        function Save_Role(flag, editProjectSiteRoleID, e) {
            if (ValidateRole(flag, editProjectSiteRoleID) == 0) {

                var RoleName = $("#cbositeRole option:selected").val();
                var NormalRate = $("#textnormalrate").val();
                var ExtraRate = $("#textExtraRate").val();
                var HolidayRate = $("#textholidayRate").val();
                var IsApplied = 0;
                if (flag == "Edit") {
                    RoleName = $("#txtRoleHidden" + editProjectSiteRoleID).val();
                    NormalRate = $("#editNormalRate" + editProjectSiteRoleID).val();
                    ExtraRate = $("#editExtraRate" + editProjectSiteRoleID).val();
                    HolidayRate = $("#editHolidayRate" + editProjectSiteRoleID).val();
                }

                var ProjectSiteRoleID = '';
                if (editProjectSiteRoleID != "") {
                    ProjectSiteRoleID = editProjectSiteRoleID;
                } else {
                    ProjectSiteRoleID = "NULL";
                }

                var Data = {
                    ProjectSiteRoleID: encodeURI(ProjectSiteRoleID),
                    CurrencyID: encodeURI(SelectedSiteCurrency),
                    RoleID: encodeURI(RoleName),
                    NormalRate: encodeURI(NormalRate),
                    ExtraRate: encodeURI(ExtraRate),
                    HolidayRate: encodeURI(HolidayRate),
                    ProjectSiteID: encodeURI(SelectedProjectSiteID),
                    UserName: encodeURI(StrUserName),
                    WhichAction: encodeURI(WhichAction),
                    IsApplied: encodeURI(IsApplied)
                }
                StartLoader("#BodyCreateProject")
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/Save_RoleDetails'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (Result) {
                        // debugger;                        
                        if (Result != "") {
                            StopAjaxLoader("#BodyCreateProject");
                            alertify.set('notifier', 'position', 'top-right');
                            if (flag == "Edit") {
                                alertify.notify('<%= MyBase.GetResourceString("A_RoleSaveUpdate") %>', 'success', 5);
                            }
                            else {
                                alertify.notify('<%= MyBase.GetResourceString("A_RoleSave") %>', 'success', 5);
                            }
                            $("#w_addnewrolemodal").modal('hide');
                            //GetRateCardDetails();

                            if (flag == "Edit") {
                                $("#editNormalRate" + editProjectSiteRoleID).addClass("textinput");
                                $("#editExtraRate" + editProjectSiteRoleID).addClass("textinput");
                                $("#editHolidayRate" + editProjectSiteRoleID).addClass("textinput");
                                var curNormalRate = $("#editNormalRate" + editProjectSiteRoleID).val();
                                var curExtraRate = $("#editExtraRate" + editProjectSiteRoleID).val();
                                var curHolidayRate = $("#editHolidayRate" + editProjectSiteRoleID).val();
                                $("#editNormalRateHidden" + editProjectSiteRoleID).val(curNormalRate);
                                $("#editExtraRateHidden" + editProjectSiteRoleID).val(curExtraRate);
                                $("#editHolidayRateHidden" + editProjectSiteRoleID).val(curHolidayRate);
                                $(e).closest('.ratecardedit_row').toggleClass('ratecardedit_row_open');
                            }
                            else {
                                GetRateCardDetails();
                            }

                            GetProjectSiteRole(0);
                            ClearRoleDetails();
                        }
                        else {
                            StopAjaxLoader("#BodyCreateProject");
                        }
                    },
                    error: function (err) {
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });

            }
        }

        function ValidateDate(ID, Flag) {
            var checkFlag = 0;
            var strDate = "";
            if (Flag == "StartDate") {
                strDate = $("#dtMilestoneStartDate").val();
            }
            if (Flag == "EndDate") {
                strDate = $("#dtMilestoneEndDate").val();
            }

            if (Flag == "ResourceRoleStartDate") {
                strDate = $("#dtCostResourceStartDate").val();
            }
            if (Flag == "ResourceRoleEndDate") {
                strDate = $("#dtCostResourceEndDate").val();
            }

            if (Flag == "EditResourceRoleStartDate") {
                strDate = $("#editResourceCostStartDate" + ID).val();
            }
            if (Flag == "EditResourceRoleEndDate") {
                strDate = $("#editResourceCostEndDate" + ID).val();
            }
            if (Flag == "ResourceCostHeadStartDate") {
                strDate = $("#dtCostHeadStartDate").val();
            }
            if (Flag == "ResourceCostHeadEndDate") {
                strDate = $("#dtCostHeadEndDate").val();
            }

            PMPlanParameter = {
                ProjectID: encodeURI(globalProjectId),
                SelectedDate: encodeURI(strDate),
                WhichAction: encodeURI(WhichAction)
            }
            strApiFunction = "/api/PM_CreateProject/ValidateDate";

            $.ajax({
                url: encodeURI(strUrl) + strApiFunction,
                method: 'Post',
                data: JSON.stringify(PMPlanParameter),
                dataType: "json",
                async: false,
                contentType: "application/json",  /*;charset-utf=8*/
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (PMPlanParameter) {
                        xhr.setRequestHeader("Params", encryptString(isJson(PMPlanParameter) ? PMPlanParameter : JSON.stringify(PMPlanParameter)));
                    }
                },
                success: function (data) {
                    if (data != undefined && data != "") {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify(data, 'error', 5);
                        checkFlag = 1;
                        return checkFlag;
                    }
                    else {
                        checkFlag = 0;
                        return checkFlag;
                    }
                },
                error: function (xhr, errorThrown) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + xhr + "";
                },
            });
            return checkFlag;
        }
        var checkMile
        function Validatemilestone() {
            var checkMile = 0;
            var curMilestoneNotStoredBillAmt = $("#textMilestonebillamount").val();
            if ($("#textMilestoneName").val() == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_MilestoneName") %>', 'error', 5);
                $("#textMilestoneName").focus()
                checkMile = 1;
                return checkMile;
            }

            if ($("#textMilestoneName").val() != "") {
                NameExists = checkDuplicateMilestone($("#textMilestoneName").val());
                if (NameExists == 1) {
                    $("#textMilestoneName").focus();
                    checkMile = 1;
                    return checkMile;
                }
                else if (checkSpecialCharacter($("#textMilestoneName").val(), WebConfigSpecialCharacters) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('Milestone Name should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                    $("#textMilestoneName").focus();
                    chkval = 1;
                    return chkval;
                }
            }

            if ($("#dtMilestoneStartDate").val() == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_MilestoneStartDate") %>', 'error', 5);
                $("#dtMilestoneStartDate").focus();
                checkMile = 1;
                return checkMile;
            }

            if ($("#dtMilestoneEndDate").val() == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_MilestoneEndDate") %>', 'error', 5);
                $("#dtMilestoneEndDate").focus();
                checkMile = 1;
                return checkMile;
            }

            if ($("#dtMilestoneStartDate").val() != "") {
                checkMile = ValidateDate(0, "StartDate");

                if (checkMile == 1) {
                    $("#dtMilestoneStartDate").focus();
                    return checkMile;
                }
            }

            if ($("#dtMilestoneEndDate").val() != "") {
                if (Date.parse($("#dtMilestoneEndDate").val()) < Date.parse($("#dtMilestoneStartDate").val())) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('<%= MyBase.GetResourceString("A_LessThanStart") %>', 'error', 5);
                    $("#dtMilestoneEndDate").focus();
                    checkMile = 1;
                    return checkMile;
                }
                checkMile = ValidateDate(0, "EndDate");

                if (checkMile == 1) {
                    $("#dtMilestoneEndDate").focus();
                    return checkMile;
                }
            }


            if ($("#textMilestonebillamount").val() != "") {
                //if (checkSpecialCharacter($("#textMilestonebillamount").val()) == true) {
                //    alertify.set('notifier', 'position', 'top-right');
                //    alertify.notify("'Bill Amount' cannot contain any of these /\:*?<>|,+- characters.", 'error');
                //    $("#textMilestonebillamount").focus();
                //    checkMile = 1;
                //    return checkMile;
                //}
                if (checkSpecialCharacter($("#textMilestonebillamount").val(), WebConfigSpecialCharacters) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('Bill Amount should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                    $("#textMilestonebillamount").focus();
                    chkval = 1;
                    return chkval;
                }
                if (curProjectBudgetValue != 0) {
                    //Commented And Added By Usha Pandit On 19.06.2020 for giving correct validation
                    if (parseFloat($("#textMilestonebillamount").val()) != "0") {
                        //End Of Added By Usha Pandit On 19.06.2020 for giving correct validation
                        var sumOfBillAmount = (parseFloat(curProjectSumOfAllBillAmt) + parseFloat(curMilestoneNotStoredBillAmt)) - parseFloat(curMilestoneStoredBillAmt);

                        if (parseFloat(sumOfBillAmount) > parseFloat(curProjectBudgetValue)) {
                            alertify.set('notifier', 'position', 'top-right');
                            var RemainingBudget = parseFloat(curProjectBudgetValue).toFixed(2) - parseFloat(curProjectSumOfAllBillAmt);
                            if (RemainingBudget <= 0) {
                                RemainingBudget = 0;
                            }
                            alertify.notify('Total Budget for the project - ' + parseFloat(curProjectBudgetValue).toFixed(2) + ' <br> Sum of Milestone\'s Bill Amount - ' + parseFloat(curProjectSumOfAllBillAmt).toFixed(2) + ' <br> The remaining budget for the project is - ' + parseFloat(RemainingBudget).toFixed(2), 'error', 5);
                            //End Of Added By Usha Pandit On 19.06.2020 for giving correct alert with remaining budget value
                            $("#textMilestonebillamount").focus();
                            checkMile = 1;
                            return checkMile;
                        }
                    }
                }
            }
            return checkMile;
        }

        //Added By Dipali V On 20st Oct 2020 For JD Customzation Closed Project

        function chkInheritDataLink() {
            var NoInheridateLink = 0;
            var Parameters = {};

            Parameters = {
                ProjectID: encodeURI(globalProjectId),
            }

            if (ProjectID != '') {
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_CreateProject/chkInheritDataLink',
                    method: 'Post',
                    data: JSON.stringify(Parameters),
                    dataType: "json",
                    async: false,
                    contentType: "application/json",  /*;charset-utf=8*/
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Parameters) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Parameters) ? Parameters : JSON.stringify(Parameters)));
                        }
                    },
                    success: function (data) {
                        if (data != "") {
                            if (data == 1) {
                                NoInheridateLink = 1;
                            }
                        }

                    },
                    error: function (xhr, errorThrown) {
                        //Msg = "";
                        NoInheridateLink = 0;
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + xhr + "";
                    },
                });
                return NoInheridateLink;
            }
        }
        //End of Added By Dipali V On 20st Oct 2020 For JD Customzation 

        function checkDuplicateProject(ProjectName, Flag) {
            var isProjectNameExists = 0;
            var Parameters = {};
            if (Flag == "Project Name") {
                Parameters = {
                    ProjectName: encodeURI(ProjectName),
                    ProjectID: encodeURI(globalProjectId),
                    WhichAction: encodeURI(WhichAction),
                    Flag: Flag
                }
            }
            else {
                Parameters = {
                    AbbProjectName: encodeURI(ProjectName),
                    ProjectID: encodeURI(globalProjectId),
                    WhichAction: encodeURI(WhichAction),
                    Flag: Flag
                }
            }

            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_CreateProject/chkProjectNameExists',
                method: 'Post',
                data: JSON.stringify(Parameters),
                dataType: "json",
                async: false,
                contentType: "application/json",  /*;charset-utf=8*/
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (Parameters) {
                        xhr.setRequestHeader("Params", encryptString(isJson(Parameters) ? Parameters : JSON.stringify(Parameters)));
                    }
                },
                success: function (data) {
                    if (data == 0) {
                        isProjectNameExists = 0;
                    }
                    else if (data == 1) {
                        if (Flag == "Project Name") {
                            alertify.set('notifier', 'position', 'top-right');
                            alertify.error('<%= MyBase.GetResourceString("A_ProjectNameExists") %>');
                            isProjectNameExists = 1;
                        }
                        else {
                            alertify.set('notifier', 'position', 'top-right');
                            alertify.error('<%= MyBase.GetResourceString("A_AbbreviatedNameExists") %>');
                            isProjectNameExists = 1;
                        }
                    }
                },
                error: function (xhr, errorThrown) {
                    isProjectNameExists = 1;
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + xhr + "";
                },
            });
            return isProjectNameExists;
        }

        function checkDuplicateSite(sitename) {
            var isSiteExists = 0;
            var curProjectSiteID = 0;
            if (SelectedProjectSiteID != "") {
                curProjectSiteID = SelectedProjectSiteID;
            }
            else {
                curProjectSiteID = 0;
            }
            var Parameters = {
                Name: encodeURI(sitename),
                ProjectID: encodeURI(globalProjectId),
                ProjectSiteID: encodeURI(curProjectSiteID),
                WhichAction: encodeURI(WhichAction)
            }

            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_CreateProject/chkSiteExists',

                method: 'Post',
                data: JSON.stringify(Parameters),
                dataType: "json",
                async: false,
                contentType: "application/json",  /*;charset-utf=8*/
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (Parameters) {
                        xhr.setRequestHeader("Params", encryptString(isJson(Parameters) ? Parameters : JSON.stringify(Parameters)));
                    }
                },
                success: function (data) {
                    if (data == 0) {
                        isSiteExists = 0;
                    }
                    else if (data == 1) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.error('<%= MyBase.GetResourceString("A_SiteName") %>');
                        isSiteExists = 1;
                    }
                },
                error: function (xhr, errorThrown) {
                    isSiteExists = 1;
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + xhr + "";
                },
            });
            return isSiteExists;
        }
        function checkDuplicateMilestone(milestonename) {
            var isMilestoneExists = 0;
            var curProjectMilestoneID = 0;

            if (SelectedMilestonID != "") {
                curProjectMilestoneID = SelectedMilestonID;
            }
            else {
                curProjectMilestoneID = 0;
            }
            var Parameters = {
                MileStoneName: encodeURI(milestonename),
                ProjectID: encodeURI(globalProjectId),
                MileStoneID: encodeURI(curProjectMilestoneID),
                WhichAction: encodeURI(WhichAction)
            }

            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_CreateProject/chkMileStoneExists',

                method: 'Post',
                data: JSON.stringify(Parameters),
                dataType: "json",
                async: false,
                contentType: "application/json",  /*;charset-utf=8*/
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (Parameters) {
                        xhr.setRequestHeader("Params", encryptString(isJson(Parameters) ? Parameters : JSON.stringify(Parameters)));
                    }
                },
                success: function (data) {
                    if (data == 0) {
                        isMilestoneExists = 0;
                    }
                    else if (data == 1) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.error('<%= MyBase.GetResourceString("A_MilestoneExists") %>');
                        isMilestoneExists = 1;
                    }
                },
                error: function (xhr, errorThrown) {
                    isMilestoneExists = 1;
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + xhr + "";
                },
            });
            return isMilestoneExists;
        }
        function isNormalInteger(str) {
            return /^[-+]?[0-9]*\.?[0-9]+$/.test(str);
        }
        function ValidateProjectCost(flag, ProjectCostId, CostHeadDetails) {
            var checkProjectCost = 0;
            var CostGroup = "";
            var CostHead = "";
            var CostToCompany = "";
            var Reimbursable = "";
            var Billable = "";
            var objCostGroup = "";
            var objCostHead = "";
            var objCostToCompany = "";
            var objReimbursable = "";
            var objBillable = "";
            if (CostHeadDetails == "details") {

                var IsActive = 0;
                CostToCompany = $("#editCostToCompany").val();
                Reimbursable = $("#editReimbursable").val();
                Billable = $("#editBillable").val();
                objCostToCompany = $("#editCostToCompany");
                objReimbursable = $("#editReimbursable");
                objBillable = $("#editBillable");
                if ($("#chkIsActive").is(':checked')) {
                    IsActive = 1;
                }

                if (flag == "New") {
                    CostGroup = $("#CPCostGroup_0 option:selected").val();
                    objCostGroup = $("#CPCostGroup_0");
                    CostHead = $("#CPCostHead_0 option:selected").val();
                    objCostHead = $("#CPCostHead_0");
                }
                if (flag == "New") {
                    if (CostGroup == "0") {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify('<%= MyBase.GetResourceString("A_CostGroup") %>', 'error', 5);
                        objCostGroup.focus();
                        checkProjectCost = 1;
                        return checkProjectCost;
                    }
                    if (CostHead == "0") {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify('<%= MyBase.GetResourceString("A_CostHead") %>', 'error', 5);
                        objCostHead.focus();
                        checkProjectCost = 1;
                        return checkProjectCost;
                    }
                }
                if (CostToCompany == "") {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('<%= MyBase.GetResourceString("A_CostToCompany") %>', 'error', 5);
                    objCostToCompany.focus();
                    checkProjectCost = 1;
                    return checkProjectCost;
                }
                if (CostToCompany != "") {
                    //if (checkSpecialCharacter(CostToCompany) == true) {
                    //    alertify.set('notifier', 'position', 'top-right');
                    //    alertify.notify("'Cost To Company' cannot contain any of these /\:*?<>|,+- characters.", 'error');
                    //    objCostToCompany.focus();
                    //    checkProjectCost = 1;
                    //    return checkProjectCost;
                    //}
                    if (checkSpecialCharacter(CostToCompany, WebConfigSpecialCharacters) == true) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.error('Cost To Company should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                        objCostToCompany.focus();
                        checkProjectCost = 1;
                        return checkProjectCost;
                    }
                    var curResult = isNormalInteger(CostToCompany);
                    if (curResult == false) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify("Please enter Cost To Company value in numeric format", 'error');
                        objCostToCompany.focus();
                        checkProjectCost = 1;
                        return checkProjectCost;
                    }
                }

                if (Reimbursable == "") {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('<%= MyBase.GetResourceString("A_Reimbursable") %>', 'error', 5);
                    objReimbursable.focus();
                    checkProjectCost = 1;
                    return checkProjectCost;
                }
                if (Reimbursable != "") {
                    //if (checkSpecialCharacter(Reimbursable) == true) {
                    //    alertify.set('notifier', 'position', 'top-right');
                    //    alertify.notify("'Reimbursable' cannot contain any of these /\:*?<>|,+- characters.", 'error');
                    //    objReimbursable.focus();
                    //    checkProjectCost = 1;
                    //    return checkProjectCost;
                    //}
                    if (checkSpecialCharacter(Reimbursable, WebConfigSpecialCharacters) == true) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.error('Reimbursable should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                        objReimbursable.focus();
                        checkProjectCost = 1;
                        return checkProjectCost;
                    }
                    var curResult = isNormalInteger(Reimbursable);
                    if (curResult == false) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify("Please enter Reimbursable value in numeric format", 'error');
                        objReimbursable.focus();
                        checkProjectCost = 1;
                        return checkProjectCost;
                    }
                }
                if (Billable != "") {
                    //if (checkSpecialCharacter(Billable) == true) {
                    //    alertify.set('notifier', 'position', 'top-right');
                    //    alertify.notify("'Billable' cannot contain any of these /\:*?<>|,+- characters.", 'error');
                    //    objBillable.focus();
                    //    checkProjectCost = 1;
                    //    return checkProjectCost;
                    //}
                    if (checkSpecialCharacter(Billable, WebConfigSpecialCharacters) == true) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.error('Billable should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                        objBillable.focus();
                        checkProjectCost = 1;
                        return checkProjectCost;
                    }
                    var curResult = isNormalInteger(Billable);
                    if (curResult == false) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify("Please enter Billable value in numeric format", 'error');
                        objBillable.focus();
                        checkProjectCost = 1;
                        return checkProjectCost;
                    }
                }
                if (checkSpecialCharacter($("#editDescription").val(), WebConfigSpecialCharacters) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('Description should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                    $("#editDescription").focus();
                    checkProjectCost = 1;
                    return checkProjectCost;
                }
            }
            else {
                if (flag == "Edit") {
                    CostHead = $("#txtCostHeadHidden" + ProjectCostId).val();
                    CostToCompany = $("#editCostToCompany" + ProjectCostId).val();
                    Reimbursable = $("#editReimbersable" + ProjectCostId).val();
                    Billable = $("#editBillable" + ProjectCostId).val();
                    objCostToCompany = $("#editCostToCompany" + ProjectCostId);
                    objReimbursable = $("#editReimbersable" + ProjectCostId);
                    objBillable = $("#editBillable" + ProjectCostId);
                }
                else {
                    CostHead = $("#CPCostHead_0 option:selected").val();
                    CostToCompany = $("#editCostToCompany0").val();
                    Reimbursable = $("#editReimbersable0").val();
                    Billable = $("#editBillable0").val();
                    objCostHead = $("#CPCostHead_0");
                    objCostToCompany = $("#editCostToCompany0");
                    objReimbursable = $("#editReimbersable0");
                    objBillable = $("#editBillable0");
                }
                if (CostHead == "0") {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('<%= MyBase.GetResourceString("A_CostHead") %>', 'error', 5);
                    objCostHead.focus();
                    checkProjectCost = 1;
                    return checkProjectCost;
                }
                if (CostToCompany == "") {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('<%= MyBase.GetResourceString("A_CostToCompany") %>', 'error', 5);
                    objCostToCompany.focus();
                    checkProjectCost = 1;
                    return checkProjectCost;
                }
                if (CostToCompany != "") {
                    if (checkSpecialCharacter(CostToCompany) == true) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify("'Cost To Company' cannot contain any of these /\:*?<>|,+- characters.", 'error');
                        objCostToCompany.focus();
                        checkProjectCost = 1;
                        return checkProjectCost;
                    }
                    var curResult = isNormalInteger(CostToCompany);
                    if (curResult == false) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify("Please enter Cost To Company value in numeric format", 'error');
                        objCostToCompany.focus();
                        checkProjectCost = 1;
                        return checkProjectCost;
                    }
                }
                if (Reimbursable == "") {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('<%= MyBase.GetResourceString("A_Reimbursable") %>', 'error', 5);
                    objReimbursable.focus();
                    checkProjectCost = 1;
                    return checkProjectCost;
                }
                if (Reimbursable != "") {
                    if (checkSpecialCharacter(Reimbursable) == true) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify("'Reimbursable' cannot contain any of these /\:*?<>|,+- characters.", 'error');
                        objReimbursable.focus();
                        checkProjectCost = 1;
                        return checkProjectCost;
                    }
                    var curResult = isNormalInteger(Reimbursable);
                    if (curResult == false) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify("Please enter Reimbursable value in numeric format", 'error');
                        objReimbursable.focus();
                        checkProjectCost = 1;
                        return checkProjectCost;
                    }
                }
                if (Billable != "") {
                    if (checkSpecialCharacter(Billable) == true) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify("'Billable' cannot contain any of these /\:*?<>|,+- characters.", 'error');
                        objBillable.focus();
                        checkProjectCost = 1;
                        return checkProjectCost;
                    }
                    var curResult = isNormalInteger(Billable);
                    if (curResult == false) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify("Please enter Billable value in numeric format", 'error');
                        objBillable.focus();
                        checkProjectCost = 1;
                        return checkProjectCost;
                    }
                }
            }
            return checkProjectCost;
        }
        function ValidateOffshoreSites(flag) {
            var checkOffshore = 0;

            if ($("#CboCompanyengagemnt option:selected").val() == 0) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('Please Select Commercial Details', 'error', 5);
                $("#CboCompanyengagemnt").focus();
                checkOffshore = 1;
            }
            else if (cntSites > 0 && isDefaultSiteExists == false && (flag == 2 || flag == 3)) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_OffshoreSite") %>', 'error', 5);
                checkOffshore = 1;
            }
            return checkOffshore;
        }

        function ValidateSite(flag) {

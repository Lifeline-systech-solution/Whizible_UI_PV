        var ls = []
        function GetLinksAfterWorkFlowEnabled(TagID, globalProjectId, WhichFlag) {
            // debugger
            selectedTagID = TagID;
            var WBSParameters = {
                TagID: encodeURI(TagID),
                ProjectID: encodeURI(globalProjectId),
                UserID: encodeURI(UserID),
                WhichFlag: encodeURI(WhichFlag),
                LoginType: encodeURI(LoginType)

            };
            //Added By Dipali V On 25st Dec 2020 For Links are not Display
           // if (ls == []) {
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_CreateProject/GetLinksAfterWorkFlowEnabled',
                    method: 'Post',
                    data: JSON.stringify(WBSParameters),
                    dataType: 'json',
                    async: false,
                    contentType: "application/json",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (WBSParameters) {
                            xhr.setRequestHeader("Params", encryptString(isJson(WBSParameters) ? WBSParameters : JSON.stringify(WBSParameters)));
                        }
                    },
                    success: function (result) {
                        //debugger;
                        ls = result;
                        //if (result != "")
                        //{


                        //}
                        //$("#" + WhichFlag + "_" + TagID).css("display", "none");
                        //$("#li" + WhichFlag + "_" + TagID).css("display", "none");
                        //if (WhichFlag == "CR") {
                        //    $("#BtnChecklist_" + TagID).css("display", "none");
                        //    $("#liBtnChecklist_" + TagID).css("display", "none");
                        //}

                    },


                    error: function (err) {
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }

                });

                for (var i = 0; i < ls.length; i++) {
                    //debugger;
                    if (WhichFlag == ls[i].Flag) {
                        var result = ls[i].IsEnabled;

                        if (result == 1) {
                            //debugger;
                            if (WhichFlag == "RT") {
                                CheckIsBlockTimesheet = result;
                            }
                            $("#" + WhichFlag + "_" + TagID).css("display", "block");
                            $("#li" + WhichFlag + "_" + TagID).css("display", "block");
                            if (WhichFlag == "CR") {
                                $("#BtnChecklist_" + TagID).css("display", "block");
                                $("#liBtnChecklist_" + TagID).css("display", "block");
                            }
                        }
                        else {

                            if (WhichFlag == "HP") {
                                $("#HP_" + TagID).css("display", "none");
                                $("#liHP_" + TagID).css("display", "none");
                            } else if (WhichFlag == "HT") {
                                $("#HT_" + TagID).css("display", "none");
                                $("#liHT_" + TagID).css("display", "none");
                            }
                            else if (WhichFlag == "RT") {
                                $("#RT_" + TagID).css("display", "none");
                                $("#liRT_" + TagID).css("display", "none");
                            }
                            else if (WhichFlag == "RP") {
                                $("#RP_" + TagID).css("display", "none");
                                $("#liRP_" + TagID).css("display", "none");
                            }
                            else if (WhichFlag == "RH") {
                                $("#RH_" + TagID).css("display", "none");
                                $("#liRH_" + TagID).css("display", "none");
                            }
                            //$("#" + WhichFlag + "_" + TagID).css("display", "none");
                            //$("#li" + WhichFlag + "_" + TagID).css("display", "none");
                            if (WhichFlag == "CR") {
                                $("#BtnChecklist_" + TagID).css("display", "none");
                                $("#liBtnChecklist_" + TagID).css("display", "none");
                            }
                        }
                    }
                }
           // }
//End of Added By Dipali V For links not Display  issue
            // return  CheckIsBlockTimesshet;
        }


        //For WorkFlow Section Added By Dipali V On 21st Dec 2019 
        var Entity = "";
        var GlobalUniqueID = "";
        var glovalStatus = "";
        var SelectedWF = "";
        var GlWorkFlowInstance = "";
        var WFFlag = "";
        var globalWFstatus = "";
        function GetWorkFlow(TagID) {

            var WBSParameters = {
                TagID: encodeURI(TagID),
                ProjectID: encodeURI(globalProjectId)
            }

            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_WBS/GetWorkFlow',
                method: 'Post',
                data: JSON.stringify(WBSParameters),
                dataType: 'json',
                async: false,
                contentType: "application/json",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (WBSParameters) {
                        xhr.setRequestHeader("Params", encryptString(isJson(WBSParameters) ? WBSParameters : JSON.stringify(WBSParameters)));
                    }
                },
                success: function (result) {
                    //StartLoader("#WBSBody");
                    if (result != "") {
                        var objCbo1 = document.getElementById("cboWF");
                        $("#cboWF option").remove();


                        var objOption = document.createElement("OPTION");
                        objCbo1.options.add(objOption, 0);
                        objCbo1.selectedIndex = 0;


                        for (var i = 0; i < result.length; i++) {
                            //debugger;
                            var Objresult = result[i];
                            var objOption = document.createElement("OPTION");
                            objCbo1.options.add(objOption);
                            objOption.value = Objresult.ProjectNatureofDemandID;
                            objOption.text = Objresult.NatureOfDemand;
                        }
                    }


                    $('select option')
                        .filter(function () {
                            return !this.value || $.trim(this.value).length == 0 || $.trim(this.text).length == 0;
                        })
                        .remove();
                    // alert(selectedWorkflow);
                    if (selectedWorkflow != "" && selectedWorkflow != 0) {
                        //  $("#cboWF").val(GlWorkFlowInstance);
                        $("#cboWF option[value='" + selectedWorkflow + "']").attr("selected", true);

                    }
                },
                error: function (err) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });

        }
        function WorkFlowLink(TagID, strPrimaryKey, revisionFlag) {
            try {
                var WBSWorkFlow = {

                    TagID: encodeURI(TagID),
                    ProjectID: encodeURI(globalProjectId),
                    UserID: encodeURI(UserID),
                    RoleID: encodeURI('<%= Session("IntPostID") %>'),
                    strPrimaryKey: encodeURI(strPrimaryKey)
                }
                //var Flag = true;
                StartLoader("BodyCreateProject");
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_CreateProject/PlotWorkflowLinks',
                    type: "POST",
                    data: JSON.stringify(WBSWorkFlow),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (WBSWorkFlow) {
                            xhr.setRequestHeader("Params", encryptString(isJson(WBSWorkFlow) ? WBSWorkFlow : JSON.stringify(WBSWorkFlow)));
                        }
                    },
                    success: function (strResult) {

                        if (globalProjectId != 0) {
                            if (strResult != undefined) {
                                //if (strResult != "") {//Added By Dipali V On 7th Jan 2020 For IssueID 21207
                                if (strResult != "") {
                                    $("#libtnLink_" + TagID).css("display", "inline-block");
                                } else {
                                    $("#libtnLink_" + TagID).css("display", "none");
                                }
                                $(".d-ellipsislnks").css("display", "inline-block");

                                //Added By Reshma Chavan on 11th Dec 2020 for closed project
                                if (chkInheritDataLink() == 1) {
                                    $("#liInheriateData_32").css("display", "inline-block");
                                    $("#btnDraft").removeAttr("disabled");
                                    $("#btnResourceCost").removeAttr("disabled");
                                    $("#btnSaveSite").removeAttr("disabled");
                                    $("#btnProjectCost").removeAttr("disabled");
                                    $("#btnDeleteCostHead").removeAttr("disabled");
                                    $("#btnAddCostHead").removeAttr("disabled");
                                    $('#CboCompanyengagemnt').removeAttr("disabled");
                                    $(".addnewcostbtn,.clsProSiteDelete,.clsEditSite, .addnewcostbtn, .clsEditProjectCost, .clsDeleteProCost, #modalResourceCost, .clsEditResourceCost, .clsDeleteResCost, #btnProjectcostdetailEdit").removeAttr("disabled");
                                }
                                else {
                                    $("#liInheriateData_32").css("display", "none");
                                    $("#btnDraft").attr("disabled", true);
                                    $("#btnResourceCost").attr("disabled", true);
                                    $("#btnSaveSite").attr("disabled", true);
                                    $("#btnProjectCost").attr("disabled", true);
                                    $("#btnDeleteCostHead").attr("disabled", true);
                                    $("#btnAddCostHead").attr("disabled", true);
                                    $('#CboCompanyengagemnt').attr("disabled", true);
                                    //$(".addnewcostbtn,.clsProSiteDelete,.clsEditSite, .addnewcostbtn, .clsEditProjectCost, .clsDeleteProCost, #modalResourceCost, .clsEditResourceCost, .clsDeleteResCost, #btnProjectcostdetailEdit").prop("disabled", true);
                                    $(".addnewcostbtn,.clsProSiteDelete,.addnewcostbtn, .clsEditProjectCost, .clsDeleteProCost, #modalResourceCost, .clsEditResourceCost, .clsDeleteResCost, #btnProjectcostdetailEdit").prop("disabled", true);
                                }

                                //End of Added By Reshma Chavan on 11th Dec 2020 for closed project
                                $("#libtnLink_" + TagID).html("");
                                $("#libtnLink_" + TagID).html(strResult);
                                // debugger;
                                RevisionLink(strPrimaryKey, TagID, globalProjectId);
                                GetWorkFlowStatus(TagID, globalProjectId);

                                SaveLink(TagID, globalProjectId, revisionFlag);
                                WFFlag = ["CR", "HT", "HP", "RT", "RP", "RH"]
                                for (i = 0; i <= WFFlag.length; i++) {
                                    GetLinksAfterWorkFlowEnabled(32, globalProjectId, WFFlag[i]);
                                }
                                GetEnableddisabledControls();
                            }

                            else {
                                $("#libtnLink_" + TagID).css("display", "none");
                                //$(".d-ellipsislnks").css("display", "none");
                            }
                        }
                        GetWFName();
                        //Added by Dipali V On 7th Jan 2020 For No Li Then Pop_Up Should not open
                        var NoDisplay = 0;
                        var TotalLI = "";
                        $("#ulWFlinks li").each(function (i) {
                            //debugger
                            TotalLI = $("#ulWFlinks li").length;
                            if ($(this).css("display") == "none") {
                                // NoDisplay = 1;
                                NoDisplay++;
                            }

                        });


                        if (TotalLI == NoDisplay) {

                            $(".d-ellipsislnks").css("display", "none");
                        } else {
                            $(".d-ellipsislnks").css("display", "inline-block");

                            //Added By Reshma Chavan on 11th Dec 2020 for closed project
                            if (chkInheritDataLink() == 1) {
                                $("#liInheriateData_32").css("display", "inline-block");
                                $("#btnDraft").removeAttr("disabled");
                                $("#btnResourceCost").removeAttr("disabled");
                                $("#btnSaveSite").removeAttr("disabled");
                                $("#btnProjectCost").removeAttr("disabled");
                                $("#btnDeleteCostHead").removeAttr("disabled");
                                $("#btnAddCostHead").removeAttr("disabled");
                                $('#CboCompanyengagemnt').removeAttr("disabled");
                                //$(".clsEditProjectCost").removeAttr("disabled");
                                $(".addnewcostbtn,.clsProSiteDelete,.clsEditSite, .addnewcostbtn, .clsEditProjectCost, .clsDeleteProCost, #modalResourceCost, .clsEditResourceCost, .clsDeleteResCost, #btnProjectcostdetailEdit").removeAttr("disabled");

                            }
                            else {
                                $("#liInheriateData_32").css("display", "none");
                                $("#btnDraft").attr("disabled", true);
                                $("#btnResourceCost").attr("disabled", true);
                                $("#btnSaveSite").attr("disabled", true);
                                $("#btnProjectCost").attr("disabled", true);
                                $("#btnDeleteCostHead").attr("disabled", true);
                                $("#btnAddCostHead").attr("disabled", true);
                                $(".clsEditProjectCost").attr("disabled", true);
                                $('#CboCompanyengagemnt').attr("disabled", true);
                                $(".addnewcostbtn,.clsProSiteDelete,.clsEditSite, .addnewcostbtn, .clsEditProjectCost, .clsDeleteProCost, #modalResourceCost, .clsEditResourceCost, .clsDeleteResCost, #btnProjectcostdetailEdit").prop("disabled", true);

                                // $("#bodyProjectCostDetails .actioncolumn").css("display", "none")
                            }
                            //End of Added By Reshma Chavan on 11th Dec 2020 for closed project
                        }
                        //End of Added by Dipali V On 7th Jan 2020 For No Li Then Pop_Up Should not open
                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });

                return Flag;
            }
            catch (ex) {
                //alert(ex.message);
            }
        }

        function GetWorkFlowStatus(TagID, strPrimaryKey) {
            try {
                var WBSWorkFlow = {

                    TagID: encodeURI(TagID),
                    ProjectID: encodeURI(globalProjectId),
                    LoginType: encodeURI('<%= Session("intPostID") %>'),
                    strPrimaryKey: encodeURI(strPrimaryKey)
                }
                //var Flag = true;
                StartLoader("WBSBody");
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_WBS/GetWorkFlowStatus',
                    type: "POST",
                    data: JSON.stringify(WBSWorkFlow),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (WBSWorkFlow) {
                            xhr.setRequestHeader("Params", encryptString(isJson(WBSWorkFlow) ? WBSWorkFlow : JSON.stringify(WBSWorkFlow)));
                        }
                    },
                    success: function (strResult) {
                        if (strResult != undefined && strResult != "") {
                            //debugger;
                            globalWFstatus = "";
                            globalWFstatus = strResult;

                            if (TagID == "32")//Project WF Status
                            {
                                //Added By Dipali V On 7th Jan 2020 For As Per WF Status & Stage Tooltip should come
                                var WFStageStaus = "";
                                var WFName = "";
                                if (strResult.indexOf("(") > -1) {
                                    WFStageStaus = "Work Flow Status(Work Flow Stage)";
                                    WFName = "Work Flow Name"

                                } else {
                                    WFStageStaus = "Work Flow Status";
                                    WFName = "Work Flow Name"
                                }

                                $("#spnWFstatus_32").text("Status : " + strResult);
                                $("#spnWFstatus_32").css("display  ", "inline");
                                $('[data-bs-toggle="tooltip"]').tooltip();
                                $("#spnWFstatus_32").attr("data-original-title", "");
                                $("#spnWFstatus_32").attr("data-original-title", WFStageStaus);
                                $("#spnWFstatus_32").attr('data-bs-toggle', 'tooltip');
                                $("#spnWFstatus_32").attr('data-bs-placement', 'bottom');
                                GetWFName();
                                var WFName = "";
                                if (selectedWorkflowName != "") {
                                    if (selectedWorkflowName.length < 20) {
                                        WFName = selectedWorkflowName = selectedWorkflowName;
                                    }
                                    else {
                                        var str = selectedWorkflowName.substring(0, 20);
                                        WFName = str + '...';

                                    }


                                    $("#spnWFName_32").text("Work flow Name : " + WFName);
                                    $("#spnWFName_32").css("display  ", "inline");
                                    $('[data-bs-toggle="tooltip"]').tooltip();
                                    $("#spnWFName_32").attr("data-original-title", "");
                                    $("#spnWFName_32").attr("data-original-title", selectedWorkflowName);
                                    $("#spnWFName_32").attr('data-bs-toggle', 'tooltip');
                                    $("#spnWFName_32").attr('data-bs-placement', 'bottom');
                                }
                                //End of Added By Dipali V On 7th Jan 2020 For As Per WF Status & Stage Tooltip should come
                            }
                        }
                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });

            }
            catch (ex) {
                //alert(ex.message)
            }


        }

        function Submit_Onclick(TagID, WhichActionWF, UniqueID, Mode) {
            //debugger;
            Entity = TagID;
            GlobalUniqueID = UniqueID;
            // alert(GlobalUniqueID);
            selectedWorkflow = GetSelectedWorkfLOW(GlobalUniqueID)
            // debugger;
            // alert(selectedWorkflow);
            $("#divSendForApproval").modal('show');
            $("#lblCaption").text("<%= MyBase.GetResourceString("C_WF") %> " + WhichActionWF);
            if (selectedWorkflow != "") {
                GetWorkFlow(TagID);
            }
            $("#txtWFComments").val('');

        }
        //End Of Added By Usha Pandit On 13.01.2020 For WhichAction Flag change to prevent impact on Project Creation functionality

        function SubmitonClick() {
            var Remarks = $("#txtWFComments").val();         //Added By Rehan C
            if ($("#cboWF").val() == "0") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify("<%= MyBase.GetResourceString("A_Workflowblank") %>", 'error', 25);
                $("#cboWF").focus();
                return false;
            }


            if ($("#txtWFComments").val() == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify("<%= MyBase.GetResourceString("A_Comments") %>", 'error', 25);
                $("#txtWFComments").focus();
                return false;
            }
            //Added By Rehan C To check validation for Special characters  on 11/11/2022
            if (checkSpecialCharacter(Remarks, WebConfigSpecialCharacters) == true) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('Comment Should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                $("#txtWFComments").focus();
                return false;
            }
            //End of Comment By Rehan C

            // MsgID = getMsgID(Entity);
            // alert(MsgID);
            var Remarks = $("#txtWFComments").val();
            Remarks = Remarks.replace(/'/g, "''")
            var UserName = '<%=Session("strUserName")%>';
            var UserID = '<%=Session("intUserID")%>';
            var eaP = {
                intEntityID: GlobalUniqueID,
                MasterTagID: Entity,
                Status: 'S',
                ProjectID: globalProjectId,
                Remarks: $("#txtWFComments").val(),
                UserName: '<%=Session("strUserName")%>',
                RoleID: <%=Session("intPostID")%>,
                UserID: <%=Session("intUserID")%>,
                LoginType: '<%=Session("LoginType")%>',
                WorkflowID: $("#cboWF").val()
            }
            $.ajax({
                url: strUrl + '/api/Approval/EntityApproval',
                type: "POST",
                data: JSON.stringify(eaP),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (eaP) {
                        xhr.setRequestHeader("Params", encryptString(isJson(eaP) ? eaP : JSON.stringify(eaP)));
                    }
                },
                success: function (data) {
                    if (data != "" || data != undefined) {
                        var Status = "";
                        var Result = data.split("||");
                        GlWorkFlowInstance = Result[0];
                        selectedWorkflow = Result[1];
                        var MSG = "";
                        if (Entity == "32") {
                            MSG = "<%= MyBase.GetResourceString("A_SendWF") %>";
                            MsgID = 1;
                        }

                        // alert(data);
                        var IsShowMailPopUP = "";
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.notify(MSG, 'success', 25);
                        $("#divSendForApproval").modal('hide');
                        // var uri = '../Email/SendEmail.aspx?MessageID=' + MsgID + "&workflow=1&PrimaryKeyValue=" + GlWorkFlowInstance + "&WorkFlowInstance=" + GlWorkFlowInstance + "&m_strcomments=" + encodeURI(Remarks) + "&UserName=" + UserName + "&UserID=" + UserID, '', 'resizable=yes,scrollbars=yes,toolbar=no,statusbar=no,left=' + (window.screen.width - 600) / 2 + ',top=' + (window.screen.height - 500) / 2 + ',width=600,height=500';
                        //" + encodeURIComponent(Remarks) + 
                        IsShowMailPopUP = GetWorkFlowMailCondition(MsgID, Entity, GlobalUniqueID, GlWorkFlowInstance, $("#txtWFComments").val(), UserName, UserID);
                        if (IsShowMailPopUP == 1) {
                            window.open('../Email/SendEmail.aspx?MessageID=' + MsgID + "&workflow=1&PrimaryKeyValue=" + GlWorkFlowInstance + "&WorkFlowInstance=" + GlWorkFlowInstance + "&m_strcomments=&UserName=" + UserName + "&UserID=" + UserID, '', 'resizable=yes,scrollbars=yes,toolbar=no,statusbar=no,left=' + (window.screen.width - 600) / 2 + ',top=' + (window.screen.height - 500) / 2 + ',width=600,height=500');
                        }
                        //  debugger;
                        globalrevisionFlag = "";
                        WorkFlowLink(32, globalProjectId);

                        //Added By Usha Pandit For Changes on 18.01.2020 for work hrs enable disable                       
                        GetProjectDetails(WhichAction, globalProjectId);
                        //End Of Added By Usha Pandit For Changes on 18.01.2020 for work hrs enable disable
                       
                        if (IsSaveButtonEnabled == 1) {
                            EnableDisableAsWorkflow();
                        }
                    }
                },
                error: function (err) {

                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""

                }
            });

        }



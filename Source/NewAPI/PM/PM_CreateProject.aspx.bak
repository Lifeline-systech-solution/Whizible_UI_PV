                    // var alert = "<%= MyBase.GetResourceString("A_Warning") %>";
                    var alert = "The Resource timesheet entry is blocked currently.\nCurrent stage approvers have access to resume the timesheet.\nTo resume the timesheet, Click 'RESUME TIMESHEET' link before approving.\nIf you want to continue without resuming timesheet click OK else click CANCEL.";

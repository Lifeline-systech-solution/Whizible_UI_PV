        //Added By Imran 06-07-2021
        //Check Validation For Custom Controls ValidationRules
        function CheckValidationCustomData()
        {
            var projectParameters = { ProjectID: ProjectID }
            var param = JSON.stringify(projectParameters);
            $.ajax
                ({
                    url: encodeURI(strUrl) + '/api/PM_CreateProject/GetValidationCustomFieldsData',
                    type: "POST",
                    data: param,
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (param) {
                            xhr.setRequestHeader("Params", encryptString(isJson(param) ? param : JSON.stringify(param)));
                        }
                    },
                    success: function (result)
                    {       
                        for (var i = 0; i < result.length; i++)
                        {
                            var CustomFiledObj = result[i];                          

                            ControlMaxLength.push(CustomFiledObj.MaxLength);
                            ControlMinValue.push(CustomFiledObj.MinValue);
                            ControlMaxValue.push(CustomFiledObj.MaxValue);
                            ControlDefaultValue.push(CustomFiledObj.DefaultValue);

                            ValidationMessageFiled.push('#txt'+CustomFiledObj.DatabaseFieldName);
                            ValidationMessageFieldName.push(CustomFiledObj.UserGivenCaption); 
                        }
                    },
                    error: function (errormessage)
                    {
                        alert(errormessage.innerHtml);
                        return false;
                    }
                });
        }

        function cancelEdit_ProjectCost(WorkOrderCostID, enableEditForAmount, editMode) {
            EnableDisableProjectCostFields(true, WorkOrderCostID, enableEditForAmount, editMode);
            //GetProjectCostDetails(0);
            //$(".clsEditProjectCost").attr("disabled", false);
            //$(".clsEditProjectCost").css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
            //$(".clsDeleteProCost").attr("disabled", false);
            //$(".clsDeleteProCost").css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
            EnableDisableNavigateLinks("Enable", "Project Cost");
            $(".addnewcostbtn").attr("disabled", false);
            if (Browser == 'IE') {
            }
            else {
                $(".addnewcostbtn").css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
            }
            if (editMode != "cancelModeEdit") {
                var oldeditCostToCompany = $("#editCostToCompanyHidden" + WorkOrderCostID).val();
                var oldeditReimbersable = $("#editReimbersableHidden" + WorkOrderCostID).val();
                var oldeditBillable = $("#editBillableHidden" + WorkOrderCostID).val();
                //$("#editCostToCompany" + WorkOrderCostID).val(oldeditCostToCompany);
                //$("#editReimbersable" + WorkOrderCostID).val(oldeditReimbersable);
                //$("#editBillable" + WorkOrderCostID).val(oldeditBillable);
                if (oldeditCostToCompany != "") {
                    $("#editCostToCompany" + WorkOrderCostID).val(oldeditCostToCompany.toFixed(2));
                }

                if (oldeditReimbersable != "") {
                    $("#editReimbersable" + WorkOrderCostID).val(oldeditReimbersable.toFixed(2));
                }

                if (oldeditBillable != "") {
                    $("#editBillable" + WorkOrderCostID).val(oldeditBillable.toFixed(2));
                }
                var blnEditActiveExist = false;
                $(".clsprojeditmodeactive" + WorkOrderCostID).removeClass("projeditactive");
                var rows = tableProjectCost.rows({ 'search': 'applied' }).nodes();
                $('*[class*=clsprojeditmodeactive]', rows).each(function () {
                    if ($(this).hasClass("projeditactive")) {
                        blnEditActiveExist = true;
                    }
                });

                if (blnEditActiveExist == false) {
                    $(".clsEditEditProjectCost", rows).attr("disabled", false);
                    if (Browser == 'IE') {
                    }
                    else {
                        $(".clsEditEditProjectCost", rows).css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                    }
                }
            }
        }

        function cancelEdit_ResourceCost(ResourceCostID, enableEditForAmount, editMode, e) {

            EnableDisableResourceCostFields(true, ResourceCostID, enableEditForAmount, editMode);
            //GetResourceCostDetails();
            EnableDisableNavigateLinks("Enable", "Resource Cost");
            $(".input-group-btn .btncalendar").css({ "padding": "6px 12px" });
            $(".form-control").css({ "padding": "6px 12px" });
            if (editMode == "cancelMode") {
                var oldeditNoOfResource = $("#editNoOfResourceHidden" + ResourceCostID).val();
                var oldeditResourceCostStartDate = $("#editResourceCostStartDateHidden" + ResourceCostID).val();
                var oldeditResourceCostEndDate = $("#editResourceCostEndDateHidden" + ResourceCostID).val();
                var oldeditAllocation = $("#editAllocationHidden" + ResourceCostID).val();
                var oldeditBudget = $("#editBudgetHidden" + ResourceCostID).val();
                var oldeditRoleCost = $("#editRoleCostHidden" + ResourceCostID).val();
                $("#editNoOfResource" + ResourceCostID).val(oldeditNoOfResource);
                $("#editResourceCostStartDate" + ResourceCostID).val(oldeditResourceCostStartDate);
                $("#editResourceCostEndDate" + ResourceCostID).val(oldeditResourceCostEndDate);
                $("#editAllocation" + ResourceCostID).val(oldeditAllocation);
                $("#editBudget" + ResourceCostID).val(oldeditBudget);
                $("#editRoleCost" + ResourceCostID).val(oldeditRoleCost);
                if ($("#labelBudgetChangeHidden" + ResourceCostID).hasClass("clsOriginalBudgetChange")) {
                    if ($("#labelBudgetChangeHidden" + ResourceCostID).hasClass("clsMarkedOriginalBudgetChange")) {
                        $("#labelBudgetChangeHidden" + ResourceCostID).removeClass("clsOriginalBudgetChange");
                        $("#labelBudgetChangeHidden" + ResourceCostID).removeClass("clsMarkedOriginalBudgetChange");
                    }
                }
            }
            $(".clseditmodeactive" + ResourceCostID).removeClass("editactive");
            var blnEditActiveExist = false;
            var rows = tableResourceCost.rows({ 'search': 'applied' }).nodes();
            $('*[class*=clseditmodeactive]', rows).each(function () {
                if ($(this).hasClass("editactive")) {
                    blnEditActiveExist = true;
                }
            });

            if (blnEditActiveExist == false) {
                $("#modalResourceCost").attr("disabled", false);
                if (Browser == 'IE') {
                }
                else {
                    $("#modalResourceCost").css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                }
            }
        }


                else {
                    //$(".clsDeleteResCost").attr("disabled", true);
                    //$(".clsDeleteResCost").css({ 'pointer-events': 'none' });
                    //$(".clsEditResourceCost").attr("disabled", true);
                    //$(".clsEditResourceCost").css({ 'pointer-events': 'none' });

         //Added By Imran M Custom Fileds 01-07-2021
        function PopulateCustomFileds()
        {   
           // alert();
            $("#customfiledlable").hide();
            $("#CustomFiledsControl").empty();   

            var m_lngRoleId;         
            var m_strEntityName = "Projects";
            var userId = UserID;

            //Check Corporate Level
            var CorporateRoleLevel = ajaxCall(encodeURI(strUrl) + "/api/PM_CreateProject/GetCorporateRoleLevel", "POST", "application/json;charset=utf-8", "json", JSON.stringify({ userId: userId }));
            var intCorporateRoleLevel = CorporateRoleLevel[0].Column1;     
            if (intCorporateRoleLevel != 0 && intCorporateRoleLevel != 1 && intCorporateRoleLevel != 2)
            {
                //RoleId Get
                var RoleId = ajaxCall(encodeURI(strUrl) + "/api/PM_CreateProject/GetRoleId", "POST", "application/json;charset=utf-8", "json", JSON.stringify({ ProjectID: ProjectID, userId: userId }));
                m_lngRoleId = RoleId[0].Column1;    
            }
                                 
            //Row And Column Count And Generate Div tag
            var isCustomField = getCustomFieldsMaxRowColCount(ProjectID, m_strEntityName);  
            if (isCustomField == true)
            {
                 // Parameters Sequence ProjectID,DatabaseFieldName,ShowOnlyActive,Type,EntityName,UserID,LoginType 
                 PloatCustomControl1(ProjectID, 'NULL', '1', 'NULL', m_strEntityName, UserID, LoginType);
                 $("#customfiledlable").show();
            }
            else
            {                
                //Clear The Control    
                $("#customfiledlable").hide();
                $("#CustomFiledsControl").empty(); 
            }
        }
        //End By Imran 01-07-2021


        //Added By Imran M Custom Fileds rows and columns 01-07-2021
        function getCustomFieldsMaxRowColCount(projectId,m_strEntityName)
        {
            var ret = false;
            //commented and added by imran on 06-09-2022
            //var _Data = { ProjectID: parseInt(projectId), Type: 'null', ProjectType: m_strEntityName, UserID: UserID, LoginType: LoginType };
            var _Data = { ProjectID: parseInt(projectId), Type: 0, ProjectType: m_strEntityName, UserID: UserID, LoginType: LoginType };
            //end of comment by imran on 06-09-2022
            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_CreateProject/GetCustomFieldMasterRowNumber',
                method: 'Post',
                data: JSON.stringify(_Data),
                dataType: 'json',
                async: false,
                contentType: "application/json",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (_Data) {
                        xhr.setRequestHeader("Params", encryptString(isJson(_Data) ? _Data : JSON.stringify(_Data)));
                    }
                },
                success: function (result) {
                    if (result != undefined)
                    {
                        if (result[0] == "0")
                        {
                            $("#customfiledlable").hide();
                            ret = false;
                        }
                        else
                        {
                            CreateCustomFieldTable(result[0], result[1]);                       
                            ret = true;
                        }                        
                    }
                },
                error: function (err) {
                }
            });
            return ret;
        }
        //End By Imran 01-07-2021


        //Added By Imran Create Table as per row column 01-07-2021
        function CreateCustomFieldTable(rows, columns)
        {
            var strtablebind = "";
            for (var i = 1; i < rows + 1; i++)
            {
                strtablebind += " <div class='row mt-1' " + "id=" + "custr" + i + ">";
                for (var j = 1; j < columns + 1; j++) 
                {
                    strtablebind += "<div class='col-md-2'" + "id=" + "custr" + i + "L" + j + "> </div>";
                    strtablebind += "<div class='col-md-4'" + "id=" + "custr" + i + "c" + j + "> </div>";
                }
                strtablebind += "</div>";
            }
            
           $("#CustomFiledsControl").html(strtablebind);
        }
        //End By Imran 01-07-2021

        //Added By Imran 07-07-2021 Clear All Array Value
        function CustomArrayValueclear()
        {
            $("#CustomFiledsControl").empty();           
            ValidationMessage = [];
            ValidationMessageFieldName = [];
            ValidationMessageFiled = [];
            ControlMaxLength = [];
            ControlMinValue = [];
            ControlMaxValue = [];
            MaxlengthValueArray = [];
            MinValueArray = [];
            MaxValueArray = [];
            ValidationFieldsName = [];
            ValidationFieldID = [];
            ValidationRules = [];
            GetUniqueID = [];
            ControlDefaultValue = [];
            FinalId = [];
            finalValue = [];
            IsCustomFieldAssigned = [];
        }

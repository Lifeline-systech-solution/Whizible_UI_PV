            var objWorkHoursPerMonth = "";
            var objWorkHoursCap = "";
            var objEmailId = "";
            var objZip = "";
            var objSitePhNo = "";
            var objSiteFax = "";
            var objSiteRemarks = "";

            if (flag == "Edit") {
                objCity = $("#txtCity");
                objSiteName = $("#txtEditSiteName");
                objSiteCurrency = $("#cboEditSiteCurrency");
                objRateMethod = $("#cboEditRateMethod");
                objStartingDayOfWeek = $("#cboEditStartingDayOfWeek");
                objWeekDays = $("#txtEditWeekDays");
                objWorkHours = $("#txtEditWorkHours");
                objWorkHoursPerMonth = $("#txtEditWorkHoursPerMonth");
                objWorkHoursCap = $("#txtEditWorkHoursCap");
                objEmailId = document.getElementById("txtEditEmail");
                objZip = document.getElementById("txtEditZip");
                objSitePhNo = document.getElementById("txtEditPhone");
                objSiteFax = document.getElementById("txtEditFax");
                objSiteRemarks = document.getElementById("txtEditRemarks");
                City = $("#txtCity").val();
                SiteName = $("#txtEditSiteName").val();
                SiteCurrency = $("#cboEditSiteCurrency option:selected").val();
                SiteRateMethod = $("#cboEditRateMethod option:selected").val();
                SiteWeekStartDay = $("#cboEditStartingDayOfWeek option:selected").val();
                SiteWeekDays = $("#txtEditWeekDays").val();
                SiteWorkHours = $("#txtEditWorkHours").val();
                SiteWorkHoursPerMonth = $("#txtEditWorkHoursPerMonth").val();
                SiteWorkHoursCap = $("#txtEditWorkHoursCap").val();
                SiteEmailId = $("#txtEditEmail").val();
                SiteZip = $("#txtEditZip").val();
                SitePhNo = $("#txtEditPhone").val();
                SiteFax = $("#txtEditFax").val();
                SiteRemarks = $("#txtEditRemarks").val();
            }
            else {
                objSiteName = $("#txtSiteName");
                objCity = $("#txtCity");
                objSiteCurrency = $("#cboSiteCurrency");
                objRateMethod = $("#cboRateMethod");
                objStartingDayOfWeek = $("#cboStartingDayOfWeek");
                objWeekDays = $("#txtWeekDays");
                objWorkHours = $("#txtWorkHours");
                objWorkHoursPerMonth = $("#txtWorkHoursPerMonth");
                objWorkHoursCap = $("#txtWorkHoursCap");
                SiteName = $("#txtSiteName").val();
                SiteCurrency = $("#cboSiteCurrency option:selected").val();
                SiteRateMethod = $("#cboRateMethod option:selected").val();
                SiteWeekStartDay = $("#cboStartingDayOfWeek option:selected").val();
                SiteWeekDays = $("#txtWeekDays").val();
                SiteWorkHours = $("#txtWorkHours").val();
                SiteWorkHoursPerMonth = $("#txtWorkHoursPerMonth").val();
                SiteWorkHoursCap = $("#txtWorkHoursCap").val();
            }

            if (SiteName == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_BlankSiteName") %>', 'error', 5);
                objSiteName.focus();
                checkSite = 1;
                return checkSite;
            }
            if (City != "") {
                //Added By Rehan C for Special Char Validation on 19th Jan 2023
                if (checkSpecialCharacter(City, WebConfigSpecialCharacters) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('City should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                    $("#txtCity").focus();
                    checkSite = 1;
                    return checkSite;
                }
                //End Of Comment By Rehan C  
            }
            if (SiteName != "") {
                NameExists = checkDuplicateSite(SiteName);
                if (NameExists == 1) {
                    objSiteName.focus();

        function restrictAlphabets(e, flag, curId) {
            //debugger;

            var x = e.which || e.keycode;
            if (flag == "resource") {
                GetOUDuration();
                GetOUHours();
            }
            if (flag == "costtocompany") {
                var curValue = $("#editCostToCompany" + curId).val();
                var curDecimalIndex = $("#editCostToCompany" + curId).val().indexOf('.');
                if (curDecimalIndex != -1) {
                    if (curValue.substring(curDecimalIndex, curDecimalIndex.length).length > 2) {
                        return false;
                    }
                }
            }

            if (flag == "reimbersable") {
                var curValue = $("#editReimbersable" + curId).val();
                var curDecimalIndex = $("#editReimbersable" + curId).val().indexOf('.');
                if (curDecimalIndex != -1) {
                    if (curValue.substring(curDecimalIndex, curDecimalIndex.length).length > 2) {
                        return false;
                    }
                }
            }
            if (flag == "billable") {
                var curValue = $("#editBillable" + curId).val();
                var curDecimalIndex = $("#editBillable" + curId).val().indexOf('.');
                if (curDecimalIndex != -1) {
                    if (curValue.substring(curDecimalIndex, curDecimalIndex.length).length > 2) {
                        return false;
                    }
                }
            }
            if (flag == "phno") {
                if ((x >= 48 && x <= 57) || x == 8 || x == 43 || x == 45 ||
                    (x >= 35 && x <= 40))
                    return true;
                else
                    return false;
            }
            //Added By Usha Pandit On 14.01.2021 For allowing only non decimal values 
            //for project site related hours
            if (flag == "workhrs") {                
                if (e.which !== 8 && e.which !== 0 && e.which < 48 || e.which > 57) {
                    return false;
                }
                else {
                    return true;
                }
            }
            //End Of Added By Usha Pandit On 14.01.2021 For allowing only non decimal values 
            //for project site related hours
            if (flag == "resource" || flag == "zipcode" || flag == "weekdays" || flag == "fax") {
                if ((x >= 48 && x <= 57) || x == 8 ||
                    (x >= 35 && x <= 40))
                    return true;
                else
                    return false;
            }
            else {
                if ((x >= 48 && x <= 57) || x == 8 ||
                    (x >= 35 && x <= 40) || x == 46)
                    return true;
                else
                    return false;
            }
        }

        $("#textNoOfResource").blur(function () {
            var Duration = $("#textDuration").val();
            var NoOfResource = $("#textNoOfResource").val();
            if ($("#textNoOfResource").val() != "") {
                
                if (globalProjectId == 0) {
                    //End Of Added By Usha Pandit For Changes on 17.01.2020 for work hrs enable disable
                    if (SetWorkingHours != "") {
                        var Hours = SetWorkingHours * NoOfResource * Duration;
                        $("#texthours").val(Hours);
                    } else {
                        var Hours = NoOfResource * Duration
                        $("#texthours").val(Hours);
                    }
                }
            }
        })

        $("#cboProjectOU").change(function () {
            SetWorkingHours = "";
            if ($("#cboProjectOU").val() != "") {
                var Data = { OU: $("#cboProjectOU").val() };
                $.ajax({

                    url: encodeURI(strUrl + '/api/PM_CreateProject/GetWorkingHrByOU'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (result) {
                        // debugger;

                        if (result != "") {
                            for (var i = 0; i < result.length; i++) {

                                var obResult = result[i];

                                var NoResource = $("#textNoOfResource").val();
                                SetWorkingHours = obResult.WorkingHours;
                                var Duration = $("#textDuration").val();

                                if (NoResource != "") {
                                    $("#texthours").val(SetWorkingHours * NoResource * Duration);
                                }
                                else {
                                    $("#texthours").val(SetWorkingHours * Duration);
                                }
                                //if (SetWorkingHours != "") {

                                //}
                                //else {
                                //     $("#texthours").val(NoOfResource * result);
                                //}
                            }
                        }

                    },
                    error: function (err) {
                        // alert("error");
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + "";
                        //StopAjaxLoader("#bodyIssueDetails");
                    }
                });

            }


        });

        function GenerateToken() {
            var SelectedProjectID = globalProjectId;
            var strSessionResult = ajaxCall("PM_CreateProject.aspx/GeneratePK_Token", "POST", "application/json;charset=utf-8", "json", JSON.stringify({ ProjectID: SelectedProjectID }));

            if (strSessionResult != undefined) {
                return (strSessionResult.d);
            }
            else
                return 0;
        }

        function validatetoken() {
            try {
                var SelectedProjectID = globalProjectId;

                if (SelectedProjectID != undefined) {
                    var resultPKToken = ajaxCall("PM_CreateProject.aspx/ValidatePK_Token", "POST", "application/json;charset=utf-8", "json", JSON.stringify({ ProjectID: SelectedProjectID, PKToken: m_PKToken }));

                    if (resultPKToken != undefined) {
                        if (resultPKToken.d == false) {
                            window.location.href = "../../General/CommonPage.aspx?MasterTagID=1836";
                        }
                    }
                }
            }
            catch (ex) {
                //alert(ex.message());
            }
        }
        function ShowHideMileStoneSite(ContractTypeID) {
            try {
                var curContractType = ContractTypeID;
                var curActiveAttribute = "";
                curActiveAttribute = checkMilestoneSiteActive(curContractType);
                curActiveCommercial = curActiveAttribute;

                if (curActiveAttribute == "Milestone") {
                    $(".divRateCard").hide();
                    $("#cboMilestoneCurrency").attr('disabled', true);
                    GetMileStoneDetails();
                    $("#2").hide();
                    $("#1").show();
                    $("#divFixedBidNote").removeClass("clsShowHide");
                    $("#siteButtons").hide();
                    $("#milestoneButtons").show();
                    if (WhichAction == "C") {
                    }
                    else {
                        $("#addMilestoneLink").removeClass("clsShowHide");
                        $("#addMilestoneLink").attr('disabled', false);
                        $("#addMilestoneLink").css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                    }
                    $(".ratecarddropdown").hide();
                    $(".CP_sitedetailpanel").hide('fast');

                }
                else if (curActiveAttribute == "Site") {
                    ShowSiteDetails();
                    $(".ratecarddropdown").show();
                    $("#milestoneButtons").hide();
                    $("#siteButtons").show();
                    $("#addnewsite1").removeClass("clsShowHide");
                    $("#addnewsite1").show();
                    $("#addnewsite1, #addnewsiterole").attr('disabled', false);
                    $("#addnewsite1, #addnewsiterole").css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                }
                else {
                    var divHTML = '';
                    divHTML = '<div style="text-align:center;height: 744px;overflow: auto;width: 100%;background-color:white;margin-top:3%;"><b style="margin-top:6%;"><center>You are not authorized to view this record. </center></b></div>';
                    if (ContractTypeID == "1") {
                        $("#1").html(divHTML);
                        $("#1").show();
                        $("#2").hide();
                        $("#siteButtons").hide();
                        $("#milestoneButtons").show();
                        $("#addMilestoneLink").attr('disabled', true);
                        $("#addMilestoneLink").css({ 'pointer-events': 'none' });
                    }
                    else {
                        $("#2").html(divHTML);
                        $("#2").show();
                        $("#1").hide();
                        $("#milestoneButtons").hide();
                        $("#siteButtons").show();
                        $("#addnewsite1, #addnewsiterole").attr('disabled', true);
                        $("#addnewsite1, #addnewsiterole").css({ 'pointer-events': 'none' });
                    }
                }
            }
            catch (ex) {
                //alert(ex.message);
            }
        }
        function checkMilestoneSiteActive(ContractTypeID) {
            var ActiveAttribute = "";
            var Data = {
                WhichAction: encodeURI(WhichAction), //FromWhereData
                ContractTypeID: encodeURI(ContractTypeID) //ContractTypeID
            }
            StartLoader("#BodyCreateProject");
            $.ajax({
                url: encodeURI(strUrl + '/api/PM_CreateProject/CheckMilestoneSiteActiveDeactive'),
                type: "POST",
                data: JSON.stringify(Data),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (Data) {
                        xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                    }
                },
                success: function (Result) {
                    // debugger;                   

                    if (Result != "") {
                        if (Result.length > 0) {
                            for (var i = 0; i < Result.length; i++) {
                                //Amount += parseInt(Result[i].MilestoneActive - 0);                           
                                StopAjaxLoader("#BodyCreateProject");
                                if (Result[i].MilestoneActive == "1") {
                                    ActiveAttribute = "Milestone";
                                }
                                else if (Result[i].SiteActive == "1") {
                                    ActiveAttribute = "Site";
                                }
                            }
                        }
                        else {
                            ActiveAttribute = "";
                        }
                    }
                    else {
                        ActiveAttribute = "";
                    }
                    StopAjaxLoader("#BodyCreateProject");
                },
                error: function (err) {
                    console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
            return ActiveAttribute;
        }

        function GetMileStoneDetails() {
            try {
                cntMilestones = 0;
                //debugger;
                var Data = {
                    WhichAction: encodeURI(WhichAction), //FromWhereData
                    ProjectID: encodeURI(globalProjectId) //Draft ProjectID Or Actual Project Id
                }
                StartLoader("#BodyCreateProject");
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/GetMileStoneDetails'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (Result) {
                        // debugger;
                        $(".addnewmilestone_tbl").dataTable().fnDestroy();
                        var MilestoneHTML = "";
                        var curtotalBillAmount = "";
                        $("#bodyMilestoneDetails").html("");
                        if (Result != "") {
                            var Amount = 0;
                            cntMilestones = Result.length;
                            for (var i = 0; i < Result.length; i++) {
                                Amount += parseFloat(Result[i].BillAmount - 0);
                                MilestoneHTML += "<tr>"
                                if (blnEditAccess == "False") {
                                    if (WhichAction == "C") {
                                        MilestoneHTML += "<td  class='text-start'><a>" + Result[i].MileStoneName + "</a></td>";
                                    }
                                    else {
                                        MilestoneHTML += "<td  class='text-start'><a>" + Result[i].MileStoneName + "</a></td>";
                                    }
                                }
                                else {
                                    if (WhichAction == "C") {
                                        MilestoneHTML += "<td class='text-start'><a href='javascript:;' onclick=Edit_mileStone(" + Result[i].MileStoneID + "," + Result[i].ProjectID + ",'" + Result[i].WhichAction + "')>" + Result[i].MileStoneName + "</a></td>";
                                    }
                                    else {
                                        MilestoneHTML += "<td class='text-start'><a href='javascript:;' onclick=Edit_mileStone(" + Result[i].MileStoneID + "," + Result[i].ProjectID + ",'" + Result[i].WhichAction + "')>" + Result[i].MileStoneName + "</a></td>";
                                    }
                                }
                                MilestoneHTML += "<td>" + Result[i].StartDate + "</td>";
                                MilestoneHTML += "<td>" + Result[i].EndDate + "</td>"

                                if (Result[i].BillAmount == 0.00) {
                                    MilestoneHTML += "<td></td>"
                                }
                                else {
                                    MilestoneHTML += "<td>" + Result[i].BillAmount + "</td>"
                                }
                                //End Of Added By Usha Pandit On 09.03.2020 For not showing 0 if Bill Amount is not entered

                                if (WhichAction == "C") {
                                    var statusPercentage = '0';
                                    if (Result[i].CompletionPercentage == "") {
                                        statusPercentage = '0';
                                    }
                                    else {
                                        statusPercentage = Result[i].CompletionPercentage;
                                    }

                                    if (Result[i].IsClosed == 1 && Result[i].MilestoneStatus == "Milestone Closed") {
                                        statusPercentage = '100';
                                    }
                                    MilestoneHTML += "<td><div class='progress'><div class='progress-bar' role='progressbar' style='width:" + statusPercentage + "%;color:black;' aria-valuenow='80' aria-valuemin='0' aria-valuemax='100'>" + statusPercentage + "%</div>";
                                    MilestoneHTML += " </div></td>";
                                }
                                else if (WhichAction == "D" || WhichAction == "N") {
                                    MilestoneHTML += "<td><div class='progress'><div class='progress-bar' role='progressbar' style='width:0%;color:black;' aria-valuenow='80' aria-valuemin='0' aria-valuemax='100'>" + 0 + "%</div>";
                                    MilestoneHTML += " </div></td>";
                                }
                                curProjectBudgetValue = Result[i].ProjectValue;
                                curProjectSumOfAllBillAmt = Result[i].SumOfAllBillAmt;

                                MilestoneHTML += "<td>" + Result[i].Currency + "</td>"
                                MilestoneHTML += "</tr>"
                                StopAjaxLoader("#BodyCreateProject");
                            }
                            curtotalBillAmount = Amount;
                         
                            $("#bodyMilestoneDetails").html(MilestoneHTML);
                            tableMilestone = $('.addnewmilestone_tbl').DataTable({
                                "pageLength": 5,
                                "bdestroy": true,
                                "lengthChange": false,
                                "bFilter": false,
                                "ordering": false,
                                "responsive": true,
                                "columnDefs": [
                                    { "width": "100px", "targets": 0 }

                                ],
                                "drawCallback": function (settings) {
                                    $('[data-bs-toggle="tooltip"]').tooltip();
                                }
                            });
                            if (MilestoneHTML == "") {
                                $(".addnewmilestone_tbl tbody tr td").prop("colspan", 6);
                            }

                          
                            if (curtotalBillAmount != "") {
                                $("#totalBillAmount").text(curtotalBillAmount.toFixed(2));
                            }

                            if (WhichAction == "C") {
                                $("#Btnsave").addClass("clsShowHide");
                            }
                            else {
                                $("#Btnsave").removeClass("clsShowHide");
                            }
                        }
                        else {
                            $("#bodyMilestoneDetails").html(MilestoneHTML);
                            tableMilestone = $('.addnewmilestone_tbl').DataTable({
                                "pageLength": 5,
                                "bdestroy": true,
                                "lengthChange": false,
                                "bFilter": false,
                                "ordering": false,
                                "responsive": true,
                                "drawCallback": function (settings) {
                                    $('[data-bs-toggle="tooltip"]').tooltip();
                                }
                            });
                        }
                        if (cntMilestones <= 5) {
                            disablePagination();
                        }
                        StopAjaxLoader("#BodyCreateProject");
                    },
                    error: function (err) {
                        // alert("error");
                        //alert(err.responseText);
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
                if ($(".addnewmilestone_tbl tbody tr td").hasClass("dataTables_empty")) {
                    $(".addnewmilestone_tbl tbody tr td").attr('colspan', 6);
                }
            }
            catch (ex) {
                //alert(ex.message);
            }

            if (cntMilestones > 0 || cntSites > 0) {
                //$(".nav-tabs li:nth-child(2)").find("a").find("span").css("background-color", "#7FFF00");
            }
            else {
                //$(".nav-tabs li:nth-child(2)").find("a").find("span").css("background-color", "yellow");
            }
        }


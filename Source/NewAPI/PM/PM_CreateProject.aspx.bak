        function GetProjectSiteRole(ProjectID) {
            // debugger;           

            StartLoader("#BodyCreateProject");
            var curProjectSiteID = '';
            if (SelectedProjectSiteID != "") {
                curProjectSiteID = SelectedProjectSiteID;
            } else {
                curProjectSiteID = 0;
            }

            $.ajax({

                url: encodeURI(strUrl + '/api/PM_CreateProject/GetProjectSiteRole'),
                type: "POST",
                data: JSON.stringify({ ProjectSiteID: encodeURI(curProjectSiteID), WhichAction: encodeURI(WhichAction) }),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                },
                success: function (result) {
                    var objCboOU = document.getElementById('cbositeRole');
                    if (objCboOU != null) {
                        $("#cbositeRole").empty();

                        for (var i = 0; i < result.length; i++) {
                            // alert(result.length);
                            //debugger;
                            var ObjStatus = result[i];
                            var objOption = document.createElement("OPTION");
                            objCboOU.options.add(objOption);
                            objOption.text = ObjStatus.roleDescription;
                            objOption.value = ObjStatus.Role;
                        }
                    }
                },
                error: function (err) {
                    // alert("error");
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    //StopAjaxLoader("#bodyIssueDetails");
                }
            });
            StopAjaxLoader("#BodyCreateProject")
        }

        function GetResourceCostRole() {
            // debugger;           

            StartLoader("#BodyCreateProject");
            var projectParameters = { RequestID: encodeURI(0) }
            var param = JSON.stringify(projectParameters);
            $.ajax({
                url: encodeURI(strUrl + '/api/PM_CreateProject/GetResourceCostRole'),
                type: "POST",
                data:param,
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (param) {
                        xhr.setRequestHeader("Params", encryptString(isJson(param) ? param : JSON.stringify(param)));
                    }
                },
                success: function (result) {
                    var objCboOU = document.getElementById('cboResourceCostRole');
                    if (objCboOU != null) {
                        $("#cboResourceCostRole").empty();

                        for (var i = 0; i < result.length; i++) {
                            // alert(result.length);
                            //debugger;
                            var ObjStatus = result[i];
                            var objOption = document.createElement("OPTION");
                            objCboOU.options.add(objOption);
                            objOption.text = ObjStatus.RoleDescription;
                            objOption.value = ObjStatus.RoleID;
                        }
                    }
                },
                error: function (err) {
                    // alert("error");
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    //StopAjaxLoader("#bodyIssueDetails");
                }
            })
            StopAjaxLoader("#BodyCreateProject")
        }

         function Draft_Onclick()
        {          
            if (Validation() == 0)
            {
                
                alertify.set('notifier', 'position', 'top-right');
                //Added by Imran 06-07-2021 Save Custom Fields
                if (ValidationFieldID.length > 0)
                {
                   
                    var IsValidate = MilestoneGetvalidate();                   
                    if (IsValidate == 0)
                        {                        
                            for (i = 0; i < ValidationFieldID.length; i++)
                            {
                                var k = $(ValidationFieldID[i]).val();
                                if (k == "undefined")
                                {}
                                else
                                {         
                                    ValidationFieldID[i] = ValidationFieldID[i].replace('#txt', '');
                                    FinalId.push(ValidationFieldID[i]);
                                    finalValue.push(k); 
                                }                           
                            }

                            var _data;
                            _data = '{' + 'ProjectID' + ':' + ProjectID + ',';
                            for (i = 0; i < FinalId.length; i++) {
                                _data += FinalId[i] + ':' + "'" + finalValue[i].trim().replace(/'/g, "~") + "'" + ',';
                            }
                            _data = _data.substring(0, _data.length - 1);
                            _data = _data + '}';

                            var m = JSON.stringify(_data).replace('"', '');
                                m = _data.replace('"', '');                      
                            //console.log(m);  
                            //return false;
                            $.ajax({
                                url: encodeURI(strUrl) + '/api/PM_CreateProject/SaveCustomFieldsValue',
                                type: "POST",
                                data: m,
                                dataType: "json",
                                contentType: "application/json;charset-utf=8",
                                async: false,
                                beforeSend: function (xhr) {
                                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                                    //if (m) {
                                    //    xhr.setRequestHeader("Params", encryptString(isJson(m) ? m : JSON.stringify(m)));
                                    //}
                                },
                                success: function (response)
                                {
                                    
                                    if (response == "1")
                                    {
                                        CustomArrayValueclear();
                                        SaveProjectInfo();
                                        GetHistoryExists();//Added by Chetan M on 3 Aug 2021 for Capture history
                                    }
                                },
                                error: function (errormessage)
                                {
                                    //alert(errormessage.innerHtml);
                                    //return false;
                                }
                            });
                        }
                   
                }
                else
                {
                    //Added by imran 06-07-2021
                    SaveProjectInfo();
                    GetHistoryExists();
                    //End by imran 06-07-2021
                }
                //End By imran 06-07-2021            
        }

        function SaveProjectInfo()
        {
                var AbbProjectName = $("#textAbbProjectName").val();
                var ProjectName = $("#textProjectName").val();
                var Description = $("#textDescription").val();
                var NoOfResource = $("#textNoOfResource").val();
                var ProjectStartDate = $("#dtProjectStartDate").val();
                var ProjectEnddate = $("#dtProjectEndDate").val();
                var ProjectCustomer = $("#cboProjectCustomer").val();
                var Duration = $("#textDuration").val();
                var Hours = $("#texthours").val();
                var ProjectBG = $("#cboProjectBG").val();
                var ProjectOU = $("#cboProjectOU").val();
                // var PracticeTemplate = $("#cboPracticeTemplate").val();
                var ProjectValue = $("#textTotalBudget").val();
                var ProjectGroupID = $("#cboProjectProjectGroup").val();
                var ProjectCurrency = $("#cboProjectCurrency option:selected").val();
                var ProjectBuget = $("#textTotalBudget").val();
                var ProjectSponsar = $("#cboProjectSponsor").val();
                var PracticeTemplate = $("#cboPracticeTemplate option:selected").text();
                SelectedProjectCurrency = ProjectCurrency;
                SelectedProjectCustomerID = ProjectCustomer;
                var ProjectType = $("#cboProjectType").text();
                var ProjectStatus = $("#cboProjectStatus").val();
                var IsBillable = 0;

                if ($("#chkBillable").is(':checked')) {
                    IsBillable = 1;
                }

                var IsConvertedToProject = 0;
                if (WhichAction == "C") {
                    IsConvertedToProject = 1;
                }
                else if (WhichAction == "D" || WhichAction == "N") {
                    IsConvertedToProject = 0;
                }
                //debugger;
                //Added By Dipali V On 31st July 2020 for Alltech Customzation
                var ResourcePoolID;
                var ResourceGroupID;

                //Commented And Added By Usha Pandit On 14.08.2020 For correct validation
                //if ($("#cboDU").val()!= undefined ||  $("#cboDU").val()!= null) {
                if ($("#cboDU").val() != undefined && $("#cboDU").val() != null) {
                    //End Of Added By Usha Pandit On 14.08.2020 For correct validation
                    ResourcePoolID = $("#cboDU").val();
                } else {

                    ResourcePoolID = "0";
                }

                //Commented And Added By Usha Pandit On 14.08.2020 For correct validation
                //if ($("#cboDT").val() != undefined || $("#cboDT").val() != null) {

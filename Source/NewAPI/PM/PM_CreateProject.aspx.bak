        function EnableAsWorkflow() {
            $("#btnDraft").prop("disabled", false);
            $("#addnewsite1").prop("disabled", false);
            $("#lnkfreezeSite").prop("disabled", false);
            $(".addnewcostbtn,.clsProSiteDelete,.clsEditSite, .addnewcostbtn, .clsEditProjectCost, .clsDeleteProCost, #modalResourceCost, .clsEditResourceCost, .clsDeleteResCost, #btnProjectcostdetailEdit").prop("disabled", false);
            if (Browser == 'IE') {
            }
            else {
                $("#addnewsite1, #lnkfreezeSite, .addnewcostbtn,.clsEditSite,.addnewcostbtn, .clsEditProjectCost, .clsDeleteProCost, #modalResourceCost, .clsEditResourceCost, .clsDeleteResCost, #btnProjectcostdetailEdit").css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
            }
            try {
                if (tableSite != undefined && tableSite != '') {
                    var rows = tableSite.rows({ 'search': 'applied' }).nodes();
                    $(".clsProSiteDelete", rows).attr("disabled", false);
                    if (Browser == 'IE') {
                    }
                    else {
                        $(".clsProSiteDelete", rows).css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                    }
                    $(".clsEditSite", rows).attr("disabled", false);
                    if (Browser == 'IE') {
                    }
                    else {
                        $(".clsEditSite", rows).css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                    }

                }

                if (tableProjectCost != undefined && tableProjectCost != '') {
                    var rows = tableProjectCost.rows({ 'search': 'applied' }).nodes();

                    $(".clsEditProjectCost", rows).attr("disabled", false);
                    if (Browser == 'IE') {
                    }
                    else {
                        $(".clsEditProjectCost", rows).css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                    }
                    $(".clsDeleteProCost", rows).attr("disabled", false);
                    if (Browser == 'IE') {
                    }
                    else {
                        $(".clsDeleteProCost", rows).css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                    }
                    $("#btnProjectcostdetailEdit", rows).attr("disabled", false);
                    if (Browser == 'IE') {
                    }
                    else {
                        $("#btnProjectcostdetailEdit", rows).css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                    }
                }
                if (tableResourceCost != undefined && tableResourceCost != '') {
                    var rows = tableResourceCost.rows({ 'search': 'applied' }).nodes();
                    $(".clsEditResourceCost", rows).attr("disabled", false);
                    if (Browser == 'IE') {
                    }
                    else {
                        $(".clsEditResourceCost", rows).css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                    }
                    $(".clsDeleteResCost", rows).attr("disabled", false);
                    if (Browser == 'IE') {
                    }
                    else {
                        $(".clsDeleteResCost", rows).css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                    }
                }
            }
            catch (ex) {
                //alert(ex.message);
            }

            //$(".addnewcostbtn").css("cursor", "no-drop");

            $('#CboCompanyengagemnt').prop("disabled", false);
        }

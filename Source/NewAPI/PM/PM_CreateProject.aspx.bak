            $('#sitenameheader').click(function () {
                try {
                    var table = $(this).parents('table').eq(0);

                    var rows = table.find('tr:gt(0)').toArray().sort(comparer($(this).index()))

                    this.asc = !this.asc;
                    if (!this.asc) {
                        rows = rows.reverse();
                    }
                    //alert(rows.length);
                    for (var i = 0; i < rows.length; i++) {
                        table.append(rows[i]);
                    }
                    //tableSite.order([0, 'desc']).draw();
                    //sortTable();
                }
                catch (ex) {
                    //alert(ex.message);
                }
            });
            $('#sitecity').click(function () {
                var table = $(this).parents('table').eq(0)
                var rows = table.find('tr:gt(0)').toArray().sort(comparer($(this).index()))
                this.asc = !this.asc;
                if (!this.asc) {
                    rows = rows.reverse();
                }

                for (var i = 0; i < rows.length; i++) {
                    table.append(rows[i]);
                }
            });

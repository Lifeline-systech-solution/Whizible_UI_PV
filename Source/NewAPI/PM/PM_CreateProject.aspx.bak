        //Added By Dipali V On 22nd Jan 2021 For Check Mandatory WF checlist Reponse presnet of not
        var MadatoryWFchecklistMapped = 0;
         function CheckWFChecklistMadatory() {
           
            // alert(WBSProjectId);
            var ProjectSiteDetails = {
                ProjectID: encodeURI(globalProjectId),
                StrUserName: encodeURI('<%=Session("strUserName")%>'),
               
            };

            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_CreateProject/CheckWFChecklistMadatory',
                method: 'Post',
                data: JSON.stringify(ProjectSiteDetails),
                dataType: 'json',
                async: false,
                contentType: "application/json",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (ProjectSiteDetails) {
                        xhr.setRequestHeader("Params", encryptString(isJson(ProjectSiteDetails) ? ProjectSiteDetails : JSON.stringify(ProjectSiteDetails)));
                    }
                },
                success: function (result) {
                    if (result != "") {
                        
                        MadatoryWFchecklistMapped = result;
                    }
                },


                error: function (err) {
                    console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }

            });
            return MadatoryWFchecklistMapped;
        }
        //End of Added By Dipali V On 22nd Jan 2021 For Check Mandatory WF checlist Reponse presnet of not

        var CheckIsBlockTimesheet = 0;
        function Approve_Onclick(WFID, WorkFlowInstance, TagID, UniqueID, WhichActionWF, Mode, IsApproverConfigured, Stage) {
            if (CheckWFChecklistMadatory() == 1) {//Added By Dipali V On 22nd Jan 2021 For Checking WF Checklist
                Entity = TagID;
                GlobalUniqueID = UniqueID;
                SelectedWF = WFID;
                if (WhichActionWF == "Approve") {
                    glovalStatus = "A";

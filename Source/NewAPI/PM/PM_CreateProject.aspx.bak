        //Added By Imran 06-07-2021
        //Check ValidationRules

        function MilestoneGetvalidate()
        {       
            alertify.set('notifier', 'position', 'top-right');
            var checkval = 0;

            for (i = 0; i < ValidationFieldID.length; i++)
            {     
                if (IsCustomFieldAssigned[i] != 0)
                {
                    for (var j = 0; j < ValidationRules[i].length; j++)
                    {
                        var validationRule = ValidationRules[i][j];                      
                        switch (validationRule)
                        {
                            case "1":
                                //For Blank 
                                if ($(ValidationFieldID[i]).val() == "")
                                {
                                    checkval = 1;
                                    alertify.error("'" + ValidationMessageFieldName[i] + "'" + " Should Not Be Left Blank.");
                                    $(ValidationFieldID[i]).focus();
                                    return checkval;
                                }
                                break;
                                //For validate Date
                            case "2":
                                if ($(ValidationFieldID[i]).val() != "") {
                                    if (!isDate($(ValidationFieldID[i]).val())) {
                                        checkval = 1;
                                        alertify.error("' "+ ValidationMessageFieldName[i] +"'" + " The Date you Have Entered Is Invalid !!!");
                                        $(ValidationFieldID[i]).focus()
                                        return checkval;
                                    }
                                };
                                break;
                                //For Number
                            case "3":
                                if ($(ValidationFieldID[i]).val() != "") {
                                    if (!jQuery.isNumeric($(ValidationFieldID[i]).val())) {
                                        checkval = 1;
                                        alertify.error("'" + ValidationMessageFieldName[i]+ "'" + " Please Enter Only Numeric Values");
                                        $(ValidationFieldID[i]).focus()
                                        return checkval;
                                    }
                                };
                                break;

                             //for Alphabets
                            case "9":                               
                                if ($(ValidationFieldID[i]).val() != "") {
                                    var Controlvalue = $(ValidationFieldID[i]).val();
                                    if (Controlvalue != "") {
                                        var pattern = /^[a-z A-Z]+$/;
                                        if (!pattern.test(Controlvalue)) {
                                            checkval = 1;
                                            alertify.error("'" + ValidationMessageFieldName[i] + "'" + " Please Enter Only Alphabets (A-Z, a-z)");
                                            $(ValidationFieldID[i]).focus()
                                            return checkval;
                                        }
                                    }
                                };
                                break;

                            case "12": //For Maxlength 
                                if ($(ValidationFieldID[i]).val() != "")
                                {     
                                    if ((ControlMaxLength[i]) > 0)
                                    {
                                        if ($(ValidationFieldID[i]).val().length > ControlMaxLength[i]) {
                                            var length = $(ValidationFieldID[i]).val().length;
                                            checkval = 1;
                                            alertify.error("'" + ValidationMessageFieldName[i] + "'" + " Max Length Is " + ControlMaxLength[i] + " Characters.\r\nYou Have Entered " + length + " Characters.");
                                            $(ValidationFieldID[i]).focus()
                                            return checkval;
                                        }
                                    }                                        
                                    
                                 };                                   
                                break;

                            case "13":
                                //For Positive Number
                                if ($(ValidationFieldID[i]).val() < 0)
                                {
                                    checkval = 1;
                                    alertify.error("'"+ "Please Enter Only Positive Numeric Value For " + "'" + ValidationMessageFieldName[i]);
                                    $(ValidationFieldID[i]).focus()
                                    return checkval;
                                }
                                else
                                {
                                    if (!jQuery.isNumeric($(ValidationFieldID[i]).val()))
                                    {
                                        checkval = 1;
                                        alertify.error("'"+ "Please Enter Only Positive Numeric Value For " + "'" + ValidationMessageFieldName[i]);
                                        $(ValidationFieldID[i]).focus()
                                        return checkval;                                             
                                    };
                                }                                
                                break;

                            case "15":
                                //For Special Char
                                if ($(ValidationFieldID[i]).val() != "") {
                                    var Controlvalue = $(ValidationFieldID[i]).val();
                                    if (checkSpecialCharacter(Controlvalue) == true) {
                                        checkval = 1;
                                        alertify.error("'" + ValidationMessageFieldName[i] + "'" + " Cannot Contain Any of These /\\:*?<>|,+- Characters.");
                                        $(ValidationFieldID[i]).focus()
                                        return checkval;
                                    }
                                };
                                break;
                            case "16":
                                //For  Minimum Value Check  
                                if ( (ControlMinValue[i] < $(ValidationFieldID[i]).val()))
                                {
                                    checkval = 1;
                                    alertify.error("'" + ValidationMessageFieldName[i] + "'" + " The Value Should Be Less Than " + ControlMinValue[i]);
                                    $(ValidationFieldID[i]).focus()
                                    return checkval;
                                }                               
                                break;
                            case "17":
                                if ((ControlMaxValue[i] < $(ValidationFieldID[i]).val()))
                                {
                                    checkval = 1;
                                    alertify.error("'" + ValidationMessageFieldName[i] + "'" + " The Value Should Be Less Than " + ControlMaxValue[i]);
                                    $(ValidationFieldID[i]).focus()
                                    return checkval;
                                }
                                break;

                            case "18":
                                //For  Value Range
                                if ($(ValidationFieldID[i]).val() != "")
                                {                                     
                                    var Condition = $(ValidationFieldID[i]).val() >= ControlMinValue[i] && $(ValidationFieldID[i]).val() <= ControlMaxValue[i]
                                    if (Condition == false)
                                    {
                                        checkval = 1;
                                        alertify.error("'" + ValidationMessageFieldName[i] + "'" + " The Value of <ID> Should Be In The Range of  (" + ControlMinValue[i] + " - " + ControlMaxValue[i] + " )" );
                                        $(ValidationFieldID[i]).focus()
                                        return checkval;
                                    }                                    
                                }
                                break;

                            case "19"://for only integers
                                if ($(ValidationFieldID[i]).val() != "") {
                                    var Controlvalue = $(ValidationFieldID[i]).val();
                                    if (Controlvalue != "") {
                                        //var pattern = /^[a-zA-Z]+$/;
                                        if ($.isNumeric(Controlvalue)) {
                                            checkval = 1;
                                            alertify.error("'" + ValidationMessageFieldName[i] + "'" + " Please Enter Only Integer Value");
                                            $(ValidationFieldID[i]).focus()
                                            return checkval;
                                        }
                                    }
                                };
                                break;

                            case "20":     //For Only Positive Integers
                                if ($(ValidationFieldID[i]).val() != "") {
                                    var regex = /^[0-9]+$/;
                                    var Controlvalue = $(ValidationFieldID[i]).val();
                                    if (regex.test(Controlvalue) == false) {
                                        checkval = 1;
                                        alertify.error("'" + ValidationMessageFieldName[i] + "'" + " Please Enter Only Positive Integer");
                                        $(ValidationFieldID[i]).focus()
                                        return checkval;
                                    }
                                };
                                break;
                            case "1617":
                                //alert(ControlMinValue[i] + ' ' + ControlMaxValue[i]);
                                if ($(ValidationFieldID[i]).val() >= ControlMinValue[i] && $(ValidationFieldID[i]).val() <= ControlMaxValue[i])
                                {
                                    checkval = 0;
                                }
                                else
                                {
                                    checkval = 1;
                                    alertify.error("'" + ValidationMessageFieldName[i] + "'" + " The Value Should Be Greater Than " + ControlMinValue[i] + " And Less Than " + ControlMaxValue[i]);
                                    $(ValidationFieldID[i]).focus()
                                    return checkval;
                                }
                                break;
                        }
                    }
                }
                else {
                     checkval = 0;
                }
                
            }
            return checkval;
        }
        //End By Imran 06-07-2021

        //Added By Imran 06-07-2021
        //Function to check the special character on string
        function checkSpecialCharacter(value)
        {
            var regularExpression = '{}|`~[]<>\!"@#$%^&*()?_+-=/';
            var isSpecialCharacter = 0;
            for (var i = 0; i < regularExpression.length; i++)
            {
                if (value.indexOf(regularExpression[i]) != -1)
                {
                    isSpecialCharacter = 1
                }
            }
            if (isSpecialCharacter == 1) {
                return true;
            }
            else {
                return false;
            }
        }
        //End By Imran 06-07-2021


        function GetEmployeeSpecificBGOU() {
            var Result = ajaxCall(strUrl + "/api/PM_CreateProject/GetEmployeeSpecificBGOU", "POST", "application/json;charset=utf-8", "json",
                JSON.stringify({ UserID: UserID }));
      
            if (Result != "" && Result != undefined && Result != null) {
                LoginSpecificBG = Result[0].ProjectBG
                LoginSpecificOU = Result[0].ProjectOU
                //alert();
                $("#cboProjectBG").val(LoginSpecificBG);
                GetLocation(LoginSpecificBG);
            }
            else {
                GetLocation(0);
            }
           
            var exists = false;
            $('#cboProjectOU option').each(function () {
                if (this.value == LoginSpecificOU) {
                    exists = true;
                }
            });
            if (exists == true) {
                $("#cboProjectOU").val(LoginSpecificOU);
            }
           
        }


        function BG_Onchange() {

            StartLoader("#BodyCreateProject");
            var BG = $("#cboProjectBG").val();
            if (BG != 0) {
                GetLocation(BG)
                if ($("#cboProjectOU option:selected").val() == 0) {
                    
                    if (globalProjectId == 0) {
                        $("#textDuration").val("0");
                        $("#texthours").val("0");
                    }
                   
                    $("#textDuration").val("0");
                }
            }
            else if (BG == 0) {
                GetLocation(BG);
            }
            StopAjaxLoader("#BodyCreateProject");
        }

        function ProjectPractice_Onchange() {
            StartLoader("#BodyCreateProject");
            var ProjectPractice = $("#cboPracticeTemplate").val();
            if (ProjectPractice != 0) {
                GetProjectPractice(ProjectPractice)
            }
            StopAjaxLoader("#BodyCreateProject");


        }

        function GetLocation(BussinessGroup) {


            var BussinessGroup = {
                BussinessGroup: BussinessGroup
                //Added By Rutuja D. on 26 March 2020 For Issueid = 23015
                , ProjectID: globalProjectId
                //End Added By Rutuja D. on 26 March 2020 For Issueid = 23015	
            };
            $.ajax({

                url: encodeURI(strUrl + '/api/PM_CreateProject/GetLocation'),
                type: "POST",
                data: JSON.stringify(BussinessGroup),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (BussinessGroup) {
                        xhr.setRequestHeader("Params", encryptString(isJson(BussinessGroup) ? BussinessGroup : JSON.stringify(BussinessGroup)));
                    }
                },
                success: function (result) {
                    var objCboOU = document.getElementById('cboProjectOU');
                    var objOption = document.createElement("OPTION");
                    if (objCboOU != null) {
                        $("#cboProjectOU").empty();

                        for (var i = 0; i < result.length; i++) {


                            var ObjStatus = result[i];
                            var objOption = document.createElement("OPTION");
                            objCboOU.options.add(objOption);
                            objOption.text = ObjStatus.LocationName;
                            objOption.value = ObjStatus.LocationID;
                        }
                        //objOption.value = LoginSpecificBG;
                    }
                },
                error: function (err) {
                    // alert("error");
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    //StopAjaxLoader("#bodyIssueDetails");
                }
            })
        }


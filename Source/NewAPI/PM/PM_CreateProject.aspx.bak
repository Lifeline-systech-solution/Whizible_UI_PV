                        }
                        if (CustomFiledObj.MaxValue != null && CustomFiledObj.MaxValue != "") {
                            MaxValueArray.push(CustomFiledObj.DatabaseFieldName + "=" + CustomFiledObj.MaxValue);
                        }
                        CustomFiledObj = "";
                    }
                }
            });
           
            CheckValidationCustomData();

            //Fill Custom Fields Default Values
            FillCustomDefaultValues();
           
            //Actual Save Data Show
            FillCustomFields();
        }

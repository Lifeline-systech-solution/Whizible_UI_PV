                                "order": [[0, 'desc']],
                                "responsive": true,
                                "drawCallback": function (settings) {
                                    $('[data-bs-toggle="tooltip"]').tooltip();
                                }
                            });

                            $(".addnewsite_tbl tbody tr td").prop("colspan", 7);
                        }
                        if (cntSites <= 5) {
                            disablePagination();
                        }
                        $('#sitenameheader').removeClass("sorting_asc");
                        StopAjaxLoader("#BodyCreateProject");
                    },
                    error: function (err) {
                        //alert("error");
                        //alert(err.responseText);
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
            }
            catch (ex) {
                //alert(ex.message());
            }

            if (cntSites > 1) {
                $("#RadiobtnSingleSite").attr("checked", false);
                $("#RadiobtnSingleSite").attr("disabled", true);
                $("#RadiobtnMultipleSite").attr("checked", true);
            }
            else {
                $("#RadiobtnSingleSite").attr("disabled", false);
                //Added By Usha Pandit On 13.01.2021 For selecting Single site option if only one site is exists
                if (cntSites == 1) {
                    $("#RadiobtnSingleSite").attr("checked", true);
                    $("#RadiobtnMultipleSite").attr("checked", false);
                }
                //End Of Added By Usha Pandit On 13.01.2021 For selecting Single site option if only one site is exists
            }
            if (cntMilestones > 0 || cntSites > 0) {
                //$(".nav-tabs li:nth-child(2)").find("a").find("span").css("background-color", "#7FFF00");
            }
            else {
                //$(".nav-tabs li:nth-child(2)").find("a").find("span").css("background-color", "yellow");
            }
        }
        function editRole(curProjectSiteRole) {
            $("#editNormalRate" + curProjectSiteRole).removeClass("textinput");
            $("#editExtraRate" + curProjectSiteRole).removeClass("textinput");
            $("#editHolidayRate" + curProjectSiteRole).removeClass("textinput");
            //$(e).closest('.ratecardedit_row').toggleClass('ratecardedit_row_open');
        }
        function cancelRole(curProjectSiteRole) {
            $("#editNormalRate" + curProjectSiteRole).addClass("textinput");
            $("#editExtraRate" + curProjectSiteRole).addClass("textinput");
            $("#editHolidayRate" + curProjectSiteRole).addClass("textinput");
            var oldeditNormalRate = $("#editNormalRateHidden" + curProjectSiteRole).val();
            var oldeditExtraRate = $("#editExtraRateHidden" + curProjectSiteRole).val();
            var oldeditHolidayRate = $("#editHolidayRateHidden" + curProjectSiteRole).val();
            $("#editNormalRate" + curProjectSiteRole).val(oldeditNormalRate);
            $("#editExtraRate" + curProjectSiteRole).val(oldeditExtraRate);
            $("#editHolidayRate" + curProjectSiteRole).val(oldeditHolidayRate);
        }
        function FillCostGroupCombox() {
            var CostHeadParameter = {
                ProjectID: encodeURI(globalProjectId),
                WhichAction: encodeURI(WhichAction),
            }

            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_CreateProject/GetProjectCostGroups',

                method: 'Post',
                data: JSON.stringify(CostHeadParameter),
                dataType: "json",
                async: false,
                contentType: "application/json",  /*;charset-utf=8*/
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (CostHeadParameter) {
                        xhr.setRequestHeader("Params", encryptString(isJson(CostHeadParameter) ? CostHeadParameter : JSON.stringify(CostHeadParameter)));
                    }
                },
                success: function (data) {
                    var objCbo1 = document.getElementById("CPCostGroup_0");
                    $("#CPCostGroup_0 option").remove();

                    if (data.length != 0) {
                        for (var i = 0; i < data.length; i++) {

                            var ObjProjModule = data[i];

                            var objOption = document.createElement("OPTION");
                            objCbo1.options.add(objOption);

                            objOption.text = ObjProjModule.CostGroup;
                            objOption.value = ObjProjModule.CostGroupID;
                        }
                    }
                },
                error: function (xhr, errorThrown) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + xhr + "";
                },
            });
        }
        function FillCostHeadCombox() {
            var curCostGroupId = $("#CPCostGroup_0 option:selected").val();

            var CostHeadParameter = {
                ProjectID: encodeURI(globalProjectId),
                CostGroupID: encodeURI(curCostGroupId),
                WhichAction: encodeURI(WhichAction),
            }

            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_CreateProject/GetProjectCostHeads',

                method: 'Post',
                data: JSON.stringify(CostHeadParameter),
                dataType: "json",
                async: false,
                contentType: "application/json",  /*;charset-utf=8*/
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (CostHeadParameter) {
                        xhr.setRequestHeader("Params", encryptString(isJson(CostHeadParameter) ? CostHeadParameter : JSON.stringify(CostHeadParameter)));
                    }
                },
                success: function (data) {
                    var objCbo1 = document.getElementById("CPCostHead_0");
                    $("#CPCostHead_0 option").remove();

                    if (data.length != 0) {
                        for (var i = 0; i < data.length; i++) {

                            var ObjProjModule = data[i];

                            var objOption = document.createElement("OPTION");
                            objCbo1.options.add(objOption);

                            objOption.text = ObjProjModule.CostHead;
                            objOption.value = ObjProjModule.CostHeadID;
                        }
                    }
                },
                error: function (xhr, errorThrown) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + xhr + "";
                },
            });
        }

        function GetProjectCostDetails(curCostHeadID, curWorkOrderCostID, CostHeadDetails, mode) {
            try {
                if (CostHeadDetails == "details") {
                }
                else {
                    curWorkOrderCostID = 0;
                }
                if (CostHeadDetails == "details") {
                }
                else {
                    cntProjectCost = 0;
                    cntActualProjectCost = 0;
                }
                var Data = {
                    WhichAction: encodeURI(WhichAction), //FromWhereData                    
                    ProjectID: encodeURI(globalProjectId),
                    CostHeadID: encodeURI(curCostHeadID),
                    WorkOrderCostID: encodeURI(curWorkOrderCostID),
                }
                if (CostHeadDetails == "details") {
                    //alert($("#editCostToCompany" + curCostHeadID));
                }
                StartLoader("#BodyCreateProject");
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/GetProjectCostDetails'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (Result) {
                        //debugger;
                        var ProjectCostHTML = "";
                        if (CostHeadDetails == "details" || mode == "Edit") {
                        }
                        else {
                            $(".budget_tbl").dataTable().fnDestroy();
                            $("#bodyProjectCostDetails").html("");
                        }
                        var curTotalCostToCompany = 0.0;
                        var curTotalReimbursable = 0.0;
                        var curTotalBillable = 0.0;
                        var curCurrencyCode = '';

                        if (Result != "") {
                            if (CostHeadDetails == "details") {
                            }
                            else {
                                cntProjectCost = Result.length;
                            }
                            //alert(Result.length);
                            for (var i = 0; i < Result.length; i++) {
                                var isActive = "";
                                var enableEdit = 0;
                                if (Result[i].IsActive == "1") {
                                    isActive = "checked";
                                    enableEdit = 1;
                                }
                                if (CostHeadDetails == "details") {
                                    if (Result[i].IsActive == "1") {
                                        $("#chkIsActive").prop("checked", true);
                                    }
                                    else {
                                        $("#chkIsActive").prop("checked", false);
                                    }

                                    $("#editCostGroup").val(Result[i].CostGroup);
                                    $("#editCostHead").val(Result[i].CostHead);
                                    $("#editCostToCompany").val(Result[i].CostToCompany);
                                    $("#editReimbursable").val(Result[i].Reimbersable);
                                    $("#editBillable").val(Result[i].Billable);
                                    $("#editDescription").val(Result[i].Description);
                                }
                                var curWorkOrderCostID = Result[i].WorkOrderCostID;
                                var curCostHeadId = Result[i].CostHeadID;
                                var curCostToCompany = Result[i].CostToCompany;
                                var curReimbersable = Result[i].Reimbersable;
                                var curBillable = Result[i].Billable;
                                curTotalCostToCompany = Result[i].TotalCostToCompany;
                                curTotalReimbursable = Result[i].TotalReimbersable;
                                curTotalBillable = Result[i].TotalBillable;
                                if (Result[i].CurrencyCode != "") {
                                    curCurrencyCode = Result[i].CurrencyCode;
                                    //Added By Usha Pandit On 16.12.2020 For getting correct currency details
                                    curProjectCurrencyCode = Result[i].CurrencyCode;
                                    //End Of Added By Usha Pandit On 16.12.2020 For getting correct currency details
                                }
                                if (CostHeadDetails == "details") {

                                }
                                else {

                                    if (Result[i].IsSetByUser == 0) {

                                    }
                                    else {
                                        cntActualProjectCost = cntActualProjectCost + 1;
                                    }
                                }
                                var inputCostToCompany = '<%=CommonFunctions.HTMLControls.DrawTextBox("editCostToCompany" + "WorkOrderCostIndex", "editCostToCompany" + "WorkOrderCostIndex", "form-control", , 8, "curCostToCompany", "left", , True, True, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;costtocompany&quot;, " + "WorkOrderCostIndex" + ")' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputCostToCompany = inputCostToCompany.replace(/WorkOrderCostIndex/g, curWorkOrderCostID);
                                inputCostToCompany = inputCostToCompany.replace(/curCostToCompany/g, curCostToCompany);
                                var inputReimbersable = '<%=CommonFunctions.HTMLControls.DrawTextBox("editReimbersable" + "WorkOrderCostIndex", "editReimbersable" + "WorkOrderCostIndex", "form-control", , 8, "curReimbersable", "left", , True, True, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;reimbersable&quot;, " + "WorkOrderCostIndex" + ")' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputReimbersable = inputReimbersable.replace(/WorkOrderCostIndex/g, curWorkOrderCostID);
                                inputReimbersable = inputReimbersable.replace(/curReimbersable/g, curReimbersable);
                                var inputBillable = '<%=CommonFunctions.HTMLControls.DrawTextBox("editBillable" + "WorkOrderCostIndex", "editBillable" + "WorkOrderCostIndex", "form-control", , 8, "curBillable", "left", , True, True, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;billable&quot;, " + "WorkOrderCostIndex" + ")' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputBillable = inputBillable.replace(/WorkOrderCostIndex/g, curWorkOrderCostID);
                                inputBillable = inputBillable.replace(/curBillable/g, curBillable);

                                var inputCostToCompanyHidden = '<%=CommonFunctions.HTMLControls.DrawTextBox("editCostToCompanyHidden" + "WorkOrderCostIndex", "editCostToCompanyHidden" + "WorkOrderCostIndex", "form-control", , 8, "curCostToCompany", "center", , True, True, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;costtocompany&quot;, " + "WorkOrderCostIndex" + ")' autocomplete='off'", IsHidden:=True, returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputCostToCompanyHidden = inputCostToCompanyHidden.replace(/WorkOrderCostIndex/g, curWorkOrderCostID);
                                inputCostToCompanyHidden = inputCostToCompanyHidden.replace(/curCostToCompany/g, curCostToCompany);
                                var inputReimbersableHidden = '<%=CommonFunctions.HTMLControls.DrawTextBox("editReimbersableHidden" + "WorkOrderCostIndex", "editReimbersableHidden" + "WorkOrderCostIndex", "form-control", , 8, "curReimbersable", "center", , True, True, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;reimbersable&quot;, " + "WorkOrderCostIndex" + ")' autocomplete='off'", IsHidden:=True, returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputReimbersableHidden = inputReimbersableHidden.replace(/WorkOrderCostIndex/g, curWorkOrderCostID);
                                inputReimbersableHidden = inputReimbersableHidden.replace(/curReimbersable/g, curReimbersable);
                                var inputBillableHidden = '<%=CommonFunctions.HTMLControls.DrawTextBox("editBillableHidden" + "WorkOrderCostIndex", "editBillableHidden" + "WorkOrderCostIndex", "form-control", , 8, "curBillable", "center", , True, True, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;billable&quot;, " + "WorkOrderCostIndex" + ")' autocomplete='off'", IsHidden:=True, returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputBillableHidden = inputBillableHidden.replace(/WorkOrderCostIndex/g, curWorkOrderCostID);
                                inputBillableHidden = inputBillableHidden.replace(/curBillable/g, curBillable);

                                ProjectCostHTML += "<tr>";
                                ProjectCostHTML += "<td class='text-start'><a href='javascript:;' class='clsEditEditProjectCost' id='btnProjectcostdetailEdit' onclick='Projectcostdetailclick(" + curCostHeadId + ", " + curWorkOrderCostID + ")'>" + Result[i].CostHead + "</a></td>";
                                var hiddenCostHeadId = '<%=CommonFunctions.HTMLControls.DrawTextBox("txtCostHeadHidden" + "WorkOrderCostIndex", "txtCostHeadHidden" + "WorkOrderCostIndex", "form-control", , , "curCostHeadId", "left", , , IsHidden:=True, returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                hiddenCostHeadId = hiddenCostHeadId.replace(/WorkOrderCostIndex/g, curWorkOrderCostID);
                                hiddenCostHeadId = hiddenCostHeadId.replace(/curCostHeadId/g, curCostHeadId);
                                ProjectCostHTML += hiddenCostHeadId;
                                ProjectCostHTML += "<td class='text-center'>";
                                ProjectCostHTML += "<label class='switch'>";
                                ProjectCostHTML += "<input id = 'editIsActiveCostHead" + curWorkOrderCostID + "' onclick='enableEditForAmounts(" + curWorkOrderCostID + "," + enableEdit + ", &quot;editMode&quot;)' type='checkbox' " + isActive + " disabled >";
                                ProjectCostHTML += "<span class='slider_switch round'></span>";
                                ProjectCostHTML += "</label>";
                                ProjectCostHTML += "</td>";
                                ProjectCostHTML += "<td>" + inputCostToCompany + inputCostToCompanyHidden + "</td>";
                                ProjectCostHTML += "<td>" + inputReimbersable + inputReimbersableHidden + "</td>";
                                //ProjectCostHTML += "<td>25000 <span class='removerow float-end'><img src='../../../Whizible2.0-new/dist/img/close-gray.svg' alt=''></span></td>";
                                ProjectCostHTML += "<td>" + inputBillable + inputBillableHidden + "</td>";
                                ProjectCostHTML += "<td class='actioncolumn'>";
                                ProjectCostHTML += "<a href='javascript:;' id='btnProjectCost' onclick='SaveProjectCostDetails(" + curWorkOrderCostID + ", this)' class='add' title='' data-bs-toggle='tooltip' data-bs-container='body' data-original-title='Save' style='display: none;'>";
                                ProjectCostHTML += "<img class='material-icons' src='../../../Whizible2.0-new/dist/img/save.svg' alt='' width='16px'>";
                                ProjectCostHTML += "</a>";

                                ProjectCostHTML += "<a class='edit_SH_Detail clsEditProjectCost nostylebtn edit' onclick='Edit_ProjectCost(" + curWorkOrderCostID + ", " + enableEdit + ", &quot;editMode&quot;, this)' href='javascript:;' title='' data-bs-toggle='tooltip' data-bs-placement='top' data-bs-container='body' data-original-title='Edit' style='display: inline;'>";

                                ProjectCostHTML += "<img src='../../../Whizible2.0-new/dist/img/edit.svg' width='16px'>";
                                ProjectCostHTML += "</a>";
                                if (blnDeleteAccess == "False") {

                                }
                                else {
                                    ProjectCostHTML += "<a id='Delete_ProjectCost_" + curWorkOrderCostID + "' style='cursor:pointer;' class='nostylebtn clsDeleteProCost delete' data-id='" + curWorkOrderCostID + "' data-bs-toggle='modal' onclick='setDeleteProjectCost(this.id)' data-bs-target='#deleteProjectcostmodal' style='display: inline;'><i class='far fa-trash-alt' title='' data-bs-toggle='tooltip' data-bs-placement='top' data-bs-container='body' data-original-title='Delete'></i></a>";
                                }
                                ProjectCostHTML += "<a href='javascript:;' class='nostylebtn cancelrowvalue' onclick='cancelEdit_ProjectCost(" + curWorkOrderCostID + ", " + enableEdit + ", &quot;cancelMode&quot;)' style='display: none;'><i class='fas fa-times' title='' data-bs-toggle='tooltip' data-bs-placement='top' data-bs-container='body' data-original-title='Cancel'></i></a>";
                                ProjectCostHTML += "</td>";
                                ProjectCostHTML += "</tr>";
                                StopAjaxLoader("#BodyCreateProject");
                            }
                        }

                        if (CostHeadDetails == "details") {
                        }
                        else {
                            if (mode != "Edit") {
                                $("#bodyProjectCostDetails").html(ProjectCostHTML);
                                tableProjectCost = $('.budget_tbl').DataTable({
                                    "pageLength": 5,
                                    "bdestroy": true,
                                    "lengthChange": false,
                                    "bFilter": false,
                                    "ordering": false,
                                    "responsive": true,
                                    "columns": [{ "width": "25px" }, { "width": "25px" }, { "width": "45px" }, { "width": "45px" }, { "width": "25px" }, { "width": "25px" }],
                                    "drawCallback": function (settings) {
                                        $('*[id*=editIsActiveCostHead]').change(function () {
                                            var curWorkOrderId = $(this).attr("id");
                                            curWorkOrderId = curWorkOrderId.replace("editIsActiveCostHead", "");
                                            if ($(this).is(':checked')) {
                                                EnableDisableProjectCostFields(false, curWorkOrderId, 1, "changeMode");
                                            }
                                            else {
                                                EnableDisableProjectCostFields(true, curWorkOrderId, 1, "changeMode");
                                            }
                                        });
                                        $(this).parents("tr").find(".add, .edit").toggle();
                                        $(this).parents("tr").find(".delete, .cancelrowvalue").toggle();
                                    }
                                });

                                if (cntProjectCost <= 5) {
                                    disablePagination();
                                }
                                if (ProjectCostHTML == "") {
                                    $(".budget_tbl tbody tr td").prop("colspan", 6);
                                }
                            }
                            //Added & Commented By Dipali V On 6th June 2020 For Issue ID  24923
                            // alert(curTotalCostToCompany);
                            if (curTotalCostToCompany != "" || curTotalCostToCompany != 0) {
                                $("#totalCostToCompany").text(curTotalCostToCompany.toFixed(2));
                            } else {

                                $("#totalCostToCompany").text(curTotalCostToCompany);
                            }

                            if (curTotalReimbursable != "" || curTotalReimbursable != 0) {
                                $("#totalReimbursable").text(curTotalReimbursable.toFixed(2));
                            } else {

                                $("#totalReimbursable").text(curTotalReimbursable);
                            }


                            if (curTotalBillable != "" || curTotalBillable != 0) {
                                $("#totalBillable").text(curTotalBillable.toFixed(2));
                            } else {
                                $("#totalBillable").text(curTotalBillable);


                            }
                            var currencyImagePath = "";
                            if (curProjectCurrencyCode == "USD") {
                                currencyImagePath = "../../../Whizible2.0-new/dist/img/USD.svg";
                            }
                            if (curProjectCurrencyCode == "INR") {
                                currencyImagePath = "../../../Whizible2.0-new/dist/img/rupee.svg";
                            }
                            if (curProjectCurrencyCode == "SGD") {
                                currencyImagePath = "../../../Whizible2.0-new/dist/img/SGD.svg";
                            }
                            if (curProjectCurrencyCode == "EUR") {
                                currencyImagePath = "../../../Whizible2.0-new/dist/img/EUR.svg";
                            }
                            if (curProjectCurrencyCode == "NZD") {
                                currencyImagePath = "../../../Whizible2.0-new/dist/img/NZD.svg";
                            }
                            if (curProjectCurrencyCode == "GBP") {
                                currencyImagePath = "../../../Whizible2.0-new/dist/img/GBP.svg";
                            }
                            $(".CurrencySymbol").attr("src", currencyImagePath);
                            $('*[id*=editIsActiveCostHead]').change(function () {
                                var curWorkOrderId = $(this).attr("id");
                                curWorkOrderId = curWorkOrderId.replace("editIsActiveCostHead", "");
                                if ($(this).is(':checked')) {
                                    EnableDisableProjectCostFields(false, curWorkOrderId, 1, "changeMode");
                                }
                                else {
                                    EnableDisableProjectCostFields(true, curWorkOrderId, 1, "changeMode");
                                }
                            });
                        }
                        StopAjaxLoader("#BodyCreateProject");
                    },
                    error: function (err) {
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
                if (CostHeadDetails == "details") {
                }
                else {
                    $(".addnewcostbtn").attr("disabled", false);
                    if (Browser == 'IE') {
                    }
                    else {
                        $(".addnewcostbtn").css({ 'pointer-events': 'initial', 'cursor': 'pointer' });
                    }
                }
                var actions = $(".budget_tbl td.actioncolumn").html();
                $(".budget_tbl .addnewcostbtn").click(function () {
                   
                });
            }
            catch (ex) {
                //alert(ex.message());
            }
            clearTooltip();

            $("#CPCostGroup_0").change(function () {
                FillCostHeadCombox();
            });
            if (IsSaveButtonEnabled == 1) {
                EnableDisableAsWorkflow();
            }

        }

        function GetProjectCostHeadDetails(curCostHeadID, curCostHeadDetailId, flag) {
            try {
                cntProjectCostHeads = 0;
                globalCostHeadDetailsID = 0;
                globalLastCostHeadEndDate = "";
                globalLastCostHeadEndDateId = 0;
                //Added By Usha Pandit On 11.06.2020 For getting cost head details in array
                if (curCostHeadDetailId == 0) {
                    arrGlobalCostHeadStartDate = [];
                    arrGlobalCostHeadEndDate = [];
                    arrGlobalCostHeadId = [];
                }
                //End Of Added By Usha Pandit On 11.06.2020 For getting cost head details in array

                var Data = {
                    WhichAction: encodeURI(WhichAction), //FromWhereData                                        
                    WorkOrderCostID: encodeURI(curCostHeadID),
                    WorkOrderCostDetailID: encodeURI(curCostHeadDetailId),
                }

                StartLoader("#BodyCreateProject");
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/GetProjectCostHeadDetails'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (Result) {
                        // debugger;
                        var ProjectCostHeadHTML = "";
                        if (flag == "editcosthead") {

                        }
                        else {
                            $(".budgetdetails_tbl").dataTable().fnDestroy();
                            $("#bodyProjectCostHeadDetails").html("");
                        }
                        if (Result != "") {
                            cntProjectCostHeads = Result.length;

                            for (var i = 0; i < Result.length; i++) {
                                var curWorkOrderCostID = Result[i].WorkOrderCostID;
                                var curWorkOrderCostDetailID = Result[i].WorkOrderCostDetailID;

                                if (flag == "editcosthead") {
                                    $("#addcostdetailmodal").modal('show');
                                    $("#dtCostHeadStartDate").val(Result[i].StartDate);
                                    $("#dtCostHeadEndDate").val(Result[i].EndDate);

                                    if (Result[i].IsPublic_YesNo == "Yes") {
                                        $("#chkIsPublic").prop("checked", true);
                                    }
                                    else {
                                        $("#chkIsPublic").prop("checked", false);
                                    }
                                    if (Result[i].Billable_YesNo == "Yes") {
                                        $("#chkIsBillable").prop("checked", true);
                                    }
                                    else {
                                        $("#chkIsBillable").prop("checked", false);
                                    }
                                    if (Result[i].UserCanOverride_YesNo == "Yes") {
                                        $("#chkIsUserCanOverride").prop("checked", true);
                                    }
                                    else {
                                        $("#chkIsUserCanOverride").prop("checked", false);
                                    }
                                    globalCostHeadDetailsID = curWorkOrderCostDetailID;
                                }
                                globalLastCostHeadEndDate = Result[i].LastDate;
                                globalLastCostHeadEndDateId = Result[i].LastDateId;
                                //Added By Usha Pandit On 11.06.2020 For getting cost head details in array
                                if (curCostHeadDetailId == 0) {
                                    arrGlobalCostHeadStartDate[i] = Result[i].StartDate;
                                    arrGlobalCostHeadEndDate[i] = Result[i].EndDate;
                                    arrGlobalCostHeadId[i] = Result[i].WorkOrderCostDetailID;
                                }
                                //End Of Added By Usha Pandit On 11.06.2020 For getting cost head details in array
                                var checkDeleteCostHead = '<%=CommonFunctions.HTMLControls.DrawCheckBox("chkCostHeadSingle" + "WorkOrderCostHeadIndex", "chkCostHeadSingle" + "WorkOrderCostHeadIndex", value:="WorkOrderCostHeadIndex", cssClass:="costheadchck", returnHTML:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                checkDeleteCostHead = checkDeleteCostHead.replace(/WorkOrderCostHeadIndex/g, curWorkOrderCostDetailID);

                                ProjectCostHeadHTML += "<tr>";
                                ProjectCostHeadHTML += "<td><a href='javascript:;' onclick='GetProjectCostHeadDetails(" + curWorkOrderCostID + ", " + curWorkOrderCostDetailID + ", &quot;editcosthead&quot;);'>" + Result[i].StartDate + "</a></td>";
                                ProjectCostHeadHTML += "<td>" + Result[i].EndDate + "</td>";
                                ProjectCostHeadHTML += "<td>" + Result[i].IsPublic_YesNo + "</td>";
                                ProjectCostHeadHTML += "<td>" + Result[i].UserCanOverride_YesNo + "</td>";
                                ProjectCostHeadHTML += "<td>" + Result[i].Billable_YesNo + "</td>";
                                ProjectCostHeadHTML += "<td>";
                                ProjectCostHeadHTML += "<div class='custom_chckbox'>";
                                ProjectCostHeadHTML += checkDeleteCostHead;
                                ProjectCostHeadHTML += "<label for='" + "chkCostHeadSingle" + curWorkOrderCostDetailID + "'></label>";
                                ProjectCostHeadHTML += "</div>";
                                ProjectCostHeadHTML += "</td>";
                                ProjectCostHeadHTML += "</tr>";
                                if (blnDeleteAccess == "False") {

                                }
                                else {
                                    ProjectCostHeadHTML += "<a id='Delete_ProjectCost_" + curWorkOrderCostID + "' style='cursor:pointer;' class='nostylebtn clsDeleteProCost delete' data-id='" + curWorkOrderCostID + "' data-bs-toggle='modal' onclick='setDeleteProjectCost(this.id)' data-bs-target='#deleteProjectcostmodal' style='display: inline;'><i class='far fa-trash-alt' title='' data-bs-toggle='tooltip' data-bs-placement='top' data-bs-container='body' data-original-title='Delete'></i></a>";
                                }

                                StopAjaxLoader("#BodyCreateProject");
                            }
                        }
                        if (flag == "editcosthead") {
                        }
                        else {

                            $("#bodyProjectCostHeadDetails").html(ProjectCostHeadHTML);


                            tableProjectCostHead = $('.budgetdetails_tbl').DataTable({
                                "pageLength": 5,
                                "bdestroy": true,
                                "lengthChange": false,
                                "bFilter": false,
                                "ordering": false,
                                "responsive": true,
                                "columns": [{ "width": "25px" }, { "width": "25px" }, { "width": "45px" }, { "width": "45px" }, { "width": "25px" }, { "width": "25px" }],
                                "drawCallback": function (settings) {


                                    $(".costheadchck").change(function () {
                                        var rowCount = $("input[type=checkbox]", rows).length;
                                        var CheckedcheckedBoxes = $("input[type=checkbox]:checked:not(:disabled)", rows);

                                        if (rowCount == CheckedcheckedBoxes.length) {
                                            $("#chkCostHeadAll").prop('checked', true);
                                        }
                                        if (!$(this).prop("checked")) {
                                            $("#chkCostHeadAll").prop("checked", false);
                                        }
                                    });
                                    //$(this).parents("tr").find(".add, .edit").toggle();
                                    //$(this).parents("tr").find(".delete, .cancelrowvalue").toggle();
                                }
                            });
                            var rows = tableProjectCostHead.rows({ 'search': 'applied' }).nodes();
                            $("#chkCostHeadAll").click(function () {
                                $('.costheadchck', rows).prop('checked', $(this).prop('checked'));
                            });
                            $(".costheadchck").change(function () {
                                var rowCount = $("input[type=checkbox]", rows).length;
                                var CheckedcheckedBoxes = $("input[type=checkbox]:checked:not(:disabled)", rows);

                                if (rowCount == CheckedcheckedBoxes.length) {
                                    $("#chkCostHeadAll").prop('checked', true);
                                }
                                if (!$(this).prop("checked")) {
                                    $("#chkCostHeadAll").prop("checked", false);
                                }
                            });
                        }
                        if (flag == "editcosthead") {
                        }
                        else {
                            $(".clsProjectName").html("<strong>Project :</strong> " + $("#textProjectName").val() + "</div>");
                            if (cntProjectCostHeads <= 5) {
                                disablePagination();
                            }
                            if (ProjectCostHeadHTML == "") {
                                $(".budgetdetails_tbl tbody tr td").prop("colspan", 6);
                            }
                        }
                        StopAjaxLoader("#BodyCreateProject");
                    },
                    error: function (err) {
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });

            }
            catch (ex) {
                //alert(ex.message());
            }
            clearTooltip();
        }

        function AddNewProjectCostRecordold(e) {
            try {
                if (cntProjectCost == 0 && $(".budget_tbl tbody tr td").hasClass("dataTables_empty")) {
                    $(".budget_tbl tbody tr td").addClass("clsShowHide");
                }
                $(e).attr("disabled", "disabled");

                if (Browser == 'IE') {
                }
                else {
                    $(e).css({ 'pointer-events': 'none' });
                }

                EnableDisableNavigateLinks("Disable", "Project Cost");
                $(".addnewcostbtn").attr("disabled", true);
                if (Browser == 'IE') {
                }
                else {
                    $(".addnewcostbtn").css({ 'pointer-events': 'none' });
                }
                var index = $(".budget_tbl tbody tr:last-child").index();

                actions = '<a href="javascript:;" title="Save" data-bs-toggle="tooltip" data-bs-container="body"  id="btnProjectCost" onclick="SaveProjectCostDetails(0, this)">'
                    + '<img class="material-icons" src="../../../Whizible2.0-new/dist/img/save.svg" alt="" width="16px">'
                    + '</a>'

                    + '<a href="javascript:;" onclick="cancelAdd_ProjectCost(this)" class=""  style = "display: inline !important;cursor:pointer;">'
                    + '<i class="fas fa-times" data-bs-toggle="tooltip" data-bs-placement="top" title="Cancel"></i>'
                    + '</a>';

                <%--var CostHeadCombo = '<% CommonFunctions.HTMLControls.DrawComboBox("CPCostHead_0", "Usp_Whizible2_Sel_tbl_CNF_CostHeads",,, "class=""form-control"" style=""width:auto;""",,,, ,).Replace("'", "\'")%>';--%>
                var CostHeadCombo = '<% CommonFunctions.HTMLControls.DrawComboBox("CPCostHead_0", "Usp_Whizible2_Sel_tbl_CNF_CostHeads",,, "class=""form-control form-select""",,,, ,).Replace("'", "\'")%>';

                var inputCostToCompany = '<%=CommonFunctions.HTMLControls.DrawTextBox("editCostToCompany0", "editCostToCompany0", "form-control", , 8,, "center", , True, True, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;costtocompany&quot;, 0)' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';

                var inputReimbersable = '<%=CommonFunctions.HTMLControls.DrawTextBox("editReimbersable0", "editReimbersable0", "form-control", , 8,, "center", , True, True, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;reimbersable&quot;, 0)' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';

                var inputBillable = '<%=CommonFunctions.HTMLControls.DrawTextBox("editBillable0", "editBillable0", "form-control", , 8,, "center", , True, True, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;billable&quot;, 0)' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';


                var row = '<tr class="">' + '<td class="text-start">' + CostHeadCombo + '</td>' + '<td class="text-center"></td>'
                    + '<td class="text-end">' + inputCostToCompany + '</td>'
                    + '<td class="text-end">' + inputReimbersable + '</td>'
                    + '<td class="text-end">' + inputBillable + '</td>'
                    + '<td class="actioncolumn">' + actions + '</td>' + '</tr>';

                $(".budget_tbl tbody").append(row);
                $(".budget_tbl tbody tr").eq(index + 1).find(".add, .edit").toggle();
                $(".budget_tbl tbody tr").eq(index + 1).find(".delete, .cancelrowvalue").toggle();

                FillCostHeadCombox();
                EnableDisableProjectCostFields(false, 0, 1, "addMode");
            }
            catch (ex) {
                //alert(ex.message());
            }
        }

        function AddNewProjectCostRecord(e) {
            try {
                if (cntProjectCost == 0 && $(".budget_tbl tbody tr td").hasClass("dataTables_empty")) {
                    $(".budget_tbl tbody tr td").addClass("clsShowHide");
                }
                $(e).attr("disabled", "disabled");

                if (Browser == 'IE') {
                }
                else {
                    $(e).css({ 'pointer-events': 'none' });
                }

                EnableDisableNavigateLinks("Disable", "Project Cost", "costheaddetails");
                $(".addnewcostbtn").attr("disabled", true);
                if (Browser == 'IE') {
                }
                else {
                    $(".addnewcostbtn").css({ 'pointer-events': 'none' });
                }

                <%--var CostHeadCombo = '<% CommonFunctions.HTMLControls.DrawComboBox("CPCostHead_0", "Usp_Whizible2_Sel_tbl_CNF_CostHeads",,, "class=""form-control""",,,, ,).Replace("'", "\'")%>';--%>
                $("#CPCostHead_0").removeClass("clsShowHide");
                $("#procostmaster").css({ 'display': 'block' });
                $("#editCostHead").addClass("clsShowHide");
                $("#CPCostGroup_0").removeClass("clsShowHide");
                $("#editCostGroup").addClass("clsShowHide");

                $("#costheaddetailslist").addClass("clsShowHide");
                $("#procostdetail").addClass("clsShowHide");
                $("#procostmaster").removeClass("clsShowHide");
                $("#costheaddetailslist").removeClass("active");
                $("#costheadeditlist").addClass("active");
                FillCostGroupCombox();
                FillCostHeadCombox();
                Projectcostdetailclick(0, 0);
                $("#editCostGroup").val("");
                $("#editCostToCompany").val("");
                $("#editReimbursable").val("");
                $("#editBillable").val("");
                $("#editDescription").val("");
                $("#chkIsActive").prop("checked", true);
                $("#chkIsActive").prop("disabled", true);
                EnableDisableProjectCostFields(false, 0, 1, "addMode");
                $('#newproprojectcost').find(".table_outer").find(".dataTables_wrapper").find(".dataTables_paginate").find('*').attr('disabled', true);
                if (Browser == 'IE') {
                }
                else {
                    $('#newproprojectcost').find(".table_outer").find(".dataTables_wrapper").find(".dataTables_paginate").find('*').css({ 'pointer-events': 'none' });
                }
                $(".clsEditEditProjectCost").prop("disabled", true);

                if (Browser == 'IE') {
                }
                else {
                    $(".clsEditEditProjectCost").css({ 'pointer-events': 'none' });
                }
                //$('#newproprojectcost .table_outer .dataTables_wrapper .dataTables_paginate *').attr('disabled', true);
            }
            catch (ex) {
                //alert(ex.message());
            }
        }
        function showhidemastercostheaddetails(flag) {
            if (flag == "procostmaster") {
                $("#procostmaster").removeClass("clsShowHide");
                $("#procostdetail").addClass("clsShowHide");
                $("#editCostHead").removeClass("clsShowHide");
            }
            if (flag == "procostdetail") {
                $("#procostmaster").addClass("clsShowHide");
                $("#procostdetail").removeClass("clsShowHide");
            }
        }
        function CreateDefaultSite(NewProjectID) {
            var curProjectID = "0";
            var Data = {
                ProjectID: encodeURI(NewProjectID),
                DraftProjectID: encodeURI(globalProjectId),
                StrUserName: encodeURI(StrUserName),
            }
            StartLoader("#BodyCreateProject");
            $.ajax({
                url: encodeURI(strUrl + '/api/PM_CreateProject/Save_DefaultProjectSite'),
                type: "POST",
                data: JSON.stringify(Data),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (Data) {
                        xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                    }
                },
                success: function (Result) {
                    // debugger;                        
                    curProjectID = Result;
                },
                error: function (err) {
                    // alert("error");
                    console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
            return curProjectID;
        }

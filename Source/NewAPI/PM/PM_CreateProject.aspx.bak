                        checkSite = 1;
                        return checkSite;
                    }
                }
                //End Added By Rutuja D. 31 Dec 2019 For Enter Only Numeric Values 
            }
            if (SiteWorkHours != "" && SiteWorkHoursCap != "") {
                var TotalWorkHrCap = parseFloat(SiteWorkHours) + parseFloat(SiteWorkHoursCap);
                if (TotalWorkHrCap > 24) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('<%= MyBase.GetResourceString("A_WHandExCap") %>', 'error', 5);
                    objWorkHours.focus();
                    checkSite = 1;
                    return checkSite;
                }
            }

            if (flag != "Edit") {
                if (cntSites == 0) {
                    if ($("#chkAddOffshoreSite").is(':checked')) {

                    }

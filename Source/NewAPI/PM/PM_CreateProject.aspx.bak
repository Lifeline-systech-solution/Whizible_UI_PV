        function Revision_Onclick() {

            if ($("#txtRevisionComments").val() == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_Comments") %>', 'error', 25);
                $("#txtRevisionComments").focus();
                return false;
            }
            var Commentes = $("#txtRevisionComments").val();

            try {
                var WBSWorkFlow = {

                    TagID: encodeURI(strRevisionTagId),
                    ProjectID: encodeURI(globalProjectId),
                    UserID: encodeURI(UserID),
                    Remarks: Commentes.replace(/'/g, "''"),
                    UserName: encodeURI('<%= Session("strUserName") %>'),
                    strPrimaryKey: encodeURI(strUniquePrimaryKey),
                    WBSID: encodeURI(WBSID),
                }
                //var Flag = true;
                StartLoader("WBSBody");
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_CreateProject/PerformRevision',
                    type: "POST",
                    data: JSON.stringify(WBSWorkFlow),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (WBSWorkFlow) {
                            xhr.setRequestHeader("Params", encryptString(isJson(WBSWorkFlow) ? WBSWorkFlow : JSON.stringify(WBSWorkFlow)));
                        }
                    },
                    success: function (strResult) {

                        StartLoader("#BodyCreateProject")
                        //debugger;
                        if (strResult == "1") {

                            alertify.set('notifier', 'position', 'top-right');
                            alertify.notify("<%= MyBase.GetResourceString("A_Revision") %>", 'success', 25);
                            $("#divRevision").modal('hide');
                            globalrevisionFlag = "Revision";
                            WorkFlowLink(32, globalProjectId, "Revision");
                            //Added By Dipali V On 7th Jan 2020 Save Link Disabled
                            $("#btnDraft").prop("disabled", false);
                            $(".addnewcostbtn").prop("disabled", false);
                            $("#addnewsite1").prop("disabled", false);
                            GetProjectDetails(WhichAction, globalProjectId);
                            StopAjaxLoader("WBSBody");


                        }

                        StopAjaxLoader("#BodyCreateProject");
                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
                // return Flag;
            }
            catch (ex) {
                //  alert(ex.message);
            }

        }

        var globalrevisionFlag = '';
        function SaveLink(TagID, strPrimaryKey, revisionFlag) {
            try {
                var WBSWorkFlow = {

                    TagID: encodeURI(TagID),
                    ProjectID: encodeURI(globalProjectId),
                    UserID: encodeURI(UserID),
                    RoleID: encodeURI(RoleID),
                    strPrimaryKey: encodeURI(strPrimaryKey)
                }
                //var Flag = true;
                //StartLoader("#BodyCreateProject");
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_WBS/SaveLinksCondition',
                    type: "POST",
                    data: JSON.stringify(WBSWorkFlow),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (WBSWorkFlow) {
                            xhr.setRequestHeader("Params", encryptString(isJson(WBSWorkFlow) ? WBSWorkFlow : JSON.stringify(WBSWorkFlow)));
                        }
                    },
                    success: function (strResult) {
                        if (strResult != undefined) {
                            //alert(IsSaveButtonEnabled);
                            //alert(globalWFstatus);
                            //alert(TagID);
                            if (TagID == "32")//milstone
                            {
                                //Commented And Added By Usha Pandit On 13.01.2020 For Enabling Save button on Revion
                                //if (globalWFstatus != "Approved" || $("#btnRevision_" + TagID).length != 1) {
                                if (globalWFstatus != "Approved" || $("#btnRevision_" + TagID).length != 1 || (revisionFlag != undefined || globalrevisionFlag == "Revision")) {
                                    //End Of Added By Usha Pandit On 13.01.2020 For Enabling Save button on Revion

                                    if (strResult == "1" || strResult == "2") {
                                        IsSaveButtonEnabled = 0;
                                        EnableAsWorkflow();
                                        $("#btnDraft").prop("disabled", false);
                                        $(".addnewcostbtn").prop("disabled", false);
                                        $("#addnewsite1").prop("disabled", false);
                                    }
                                    else {
                                        IsSaveButtonEnabled = 1;
                                        EnableDisableAsWorkflow();
                                    }
                                }

                                else {
                                    IsSaveButtonEnabled = 1;
                                    EnableDisableAsWorkflow();
                                }
                            }
                            //alert(IsSaveButtonEnabled);
                        }
                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });

            }
            catch (ex) {
                //alert(ex.message);
            }


        }

        function GetWFName() {

            var projectParameters = {
                ProjectID: globalProjectId,
            }
            //var param = JSON.stringify(projectParameters);
            var param = JSON.stringify(globalProjectId);
            var data = AJAXCallWithResult("/api/PM_CreateProject/GetWFName", param, false);
            if (data != undefined) {  
                //Commented and added by Chetan M on 15 Dec 2020 for null Issue
                //if (data.length != 0) {
                if (data.length != 0 && data != "0") {
                    //End of Commented and added by Chetan M on 15 Dec 2020 for null Issue
                    for (i = 0; i < data.length; i++) {
                        //selectedWorkflow = data[i].NatureofDemandID;
                        selectedWorkflowName = data[i].WorkflowName;//added by dipali v on 13th Jan 2020 For WF Name
                    }
                }
            }
            return selectedWorkflowName;
        }


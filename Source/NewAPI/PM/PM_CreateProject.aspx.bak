                ProjectID: encodeURI(ProjectID)
            };

             $.ajax({
                url: encodeURI(strUrl + '/api/PM_CreateProject/GetDefaultCustomFieldsValues'),
                type: "POST",
                data: JSON .stringify(Data),
                dataType: "json",
                contentType: "application/json;charset-utf=8",

        function GetResourceCostDetails() {
            GetResourceCostRole();
            getResourceCostGridDetails();
            $("#cboResourceCostRole").change(function () {
                var curRoleId = $(this).val();
                if (curRoleId != 0) {
                    getRatePerHour(curRoleId);
                }
                else {
                    var RateCost = parseFloat(0).toFixed(2);
                    $("#textCostResourceMaxRate").val(RateCost);
                }
                globalMaxRateChange = 0;
                globalOriginalBudgetChange = 0;
                getBudget();

            });
            $('#textNoOfCostResources, #textCostResourceAllocation').on('input', function () {
                if (globalOriginalBudgetChange != 1 && globalMaxRateChange != 1) {
                    getBudget();
                }
            });
            $('#textCostResourceMaxRate').on('input', function () {
                if (globalOriginalBudgetChange != 1 && globalMaxRateChange != 1) {
                    getBudget();
                    globalMaxRateChange = 1;
                }
            });
            $("#dtCostResourceStartDate, #dtCostResourceEndDate").change(function () {
                if (globalOriginalBudgetChange != 1 && globalMaxRateChange != 1) {
                    getBudget();
                }
            });

            clearTooltip();
            if (IsSaveButtonEnabled == 1) {
                EnableDisableAsWorkflow();
            }
        }

        function getPercentageSettings() {
            StartLoader("#BodyCreateProject")
            $.ajax({
                url: encodeURI(strUrl + '/api/PM_CreateProject/GetPercentageSettings'),
                type: "POST",
                data: JSON.stringify({}),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                },
                success: function (Result) {
                    // debugger;                        
                    if (Result != "") {
                        for (var i = 0; i < Result.length; i++) {
                            ResourceCostPercentage = Result[i].ResourceCostPercent;
                            ProfitMarginPercentage = Result[i].ProfitMarginPercent;
                        }
                    }
                    StopAjaxLoader("#BodyCreateProject");

                },
                error: function (err) {
                    // alert("error");
                    console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
        }
        function disablePagination() {
            $(".paginate_button").each(function () {
                if ($(this).hasClass("previous")) {
                    $(this).css({ 'pointer-events': 'none' });
                }
                if ($(this).hasClass("next")) {
                    $(this).css({ 'pointer-events': 'none' });
                }
            });
        }
        function getResourceCostGridDetails(mode) {
            try {
                cntResourceCost = 0;
                curResourceCostResourceCount = 0;
                var Data = {
                    WhichAction: encodeURI(WhichAction), //FromWhereData                    
                    ProjectID: encodeURI(globalProjectId),
                }

                StartLoader("#BodyCreateProject");
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/GetResourceCostDetails'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (Result) {
                        // debugger;
                        var ResourceCostHTML = "";
                        var ResourceCostSummaryHTML = "";
                        if (mode != "edit") {
                            $(".budgetresourcecost_tbl").dataTable().fnDestroy();
                            $("#bodyResourceCostDetails").html("");
                        }
                        var curProjectValue = 0.0;
                        var curTotalBudget = 0.0;
                        var curProfitMargin = 0.0;
                        var curResourceCostPercent = 0.0;
                        var curConversionRate = 0.0;
                        var curCurrencyCode = "";
                        var curResourceCostID = 0;
                        if (Result != "") {
                            cntResourceCost = Result.length;
                            for (var i = 0; i < Result.length; i++) {
                                //var curProjectSiteRoleID = Result[i].ProjectSiteRoleID;                               
                                var ResourceAllocation = Result[i].PercentageAllocation;
                                curTotalBudget = Result[i].TotalBudget;
                                curResourceCostPercent = Result[i].ResourceCostPercentage;
                                curProfitMargin = Result[i].ProfitMargin;
                                curConversionRate = Result[i].ConversionRate;
                                //curGlobalConversionRate = curConversionRate;
                                curProjectValue = Result[i].ProjectValue;
                                curCurrencyCode = Result[i].CurrencyCode;
                                curResourceCostID = Result[i].ResourceCostID;
                                curNoOfResource = Result[i].NoOfResource;
                                curResourceCostResourceCount = curResourceCostResourceCount + curNoOfResource;
                                curStartDate = Result[i].StartDate;
                                curEndDate = Result[i].EndDate;
                                curRoleCost = Result[i].RoleCost;
                                curResourceRoleId = Result[i].RoleID;
                                ResourceCostHTML += '<tr>';

                                var hiddenResourceRoleId = '<%=CommonFunctions.HTMLControls.DrawTextBox("editResourceCostHidden" + "ResourceCostIndex", "editResourceCostHidden" + "ResourceCostIndex", "form-control", , , "curResourceRoleId", "left", , , IsHidden:=True, returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                hiddenResourceRoleId = hiddenResourceRoleId.replace(/ResourceCostIndex/g, curResourceCostID);
                                hiddenResourceRoleId = hiddenResourceRoleId.replace(/curResourceRoleId/g, curResourceRoleId);

                                ResourceCostHTML += '<td class="text-start">';
                                ResourceCostHTML += '<a class="toggler" href="javascript:;" data-original-title="">';
                                ResourceCostHTML += '</a> ' + Result[i].RoleDescription;
                                ResourceCostHTML += hiddenResourceRoleId;
                                ResourceCostHTML += '</td>';

                                //ResourceCostHTML += '<td>' + curNoOfResource + '</td>';

                                var inputNoOfResource = '<%=CommonFunctions.HTMLControls.DrawTextBox("editNoOfResource" + "ResourceCostIndex", "editNoOfResource" + "ResourceCostIndex", "form-control", , 8, "curNoOfResource", "center", , True, True, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;resource&quot;, " + "ResourceCostIndex" + ")' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputNoOfResource = inputNoOfResource.replace(/ResourceCostIndex/g, curResourceCostID);
                                inputNoOfResource = inputNoOfResource.replace(/curNoOfResource/g, curNoOfResource);

                                var inputNoOfResourceHidden = '<%=CommonFunctions.HTMLControls.DrawTextBox("editNoOfResourceHidden" + "ResourceCostIndex", "editNoOfResourceHidden" + "ResourceCostIndex", "form-control", , 8, "curNoOfResource", "center", , True, True, IsHidden:=True, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;resource&quot;, " + "ResourceCostIndex" + ")' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputNoOfResourceHidden = inputNoOfResourceHidden.replace(/ResourceCostIndex/g, curResourceCostID);
                                inputNoOfResourceHidden = inputNoOfResourceHidden.replace(/curNoOfResource/g, curNoOfResource);


                                ResourceCostHTML += '<td>' + inputNoOfResource + inputNoOfResourceHidden + '</td>';

                                //ResourceCostHTML += '<td>' + Result[i].StartDate + '</td>';
                                var inputStartDate = '<div class="input-group">';
                                inputStartDate += '<%=CommonFunctions.HTMLControls.DrawTextBox("editResourceCostStartDate" + "ResourceCostIndex", "editResourceCostStartDate" + "ResourceCostIndex", "form-control clsBudgetDate", , , "curStartDate", "center", , True, True, ToBeInserted:="onPaste='return false' onkeypress='return Date_OnKeyPress(event)' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputStartDate = inputStartDate.replace(/ResourceCostIndex/g, curResourceCostID);
                                inputStartDate = inputStartDate.replace(/curStartDate/g, curStartDate);
                                inputStartDate += '<span class="input-group-btn clsResourceCalendar clsShowHide">';
                                inputStartDate += '<button class="btn btncalendar" type="button"><i class="fas fa-calendar-alt"></i></button>';
                                inputStartDate += '</span>';
                                inputStartDate += '</div>';
                                inputStartDate = inputStartDate.replace(/clsResourceCalendar/g, "clsResourceCalendar" + curResourceCostID);

                                var inputStartDateHidden = '<div class="input-group">';
                                inputStartDateHidden += '<%=CommonFunctions.HTMLControls.DrawTextBox("editResourceCostStartDateHidden" + "ResourceCostIndex", "editResourceCostStartDateHidden" + "ResourceCostIndex", "form-control clsBudgetDate", , , "curStartDate", "center", , True, True, IsHidden:=True, ToBeInserted:="onPaste='return false' onkeypress='return Date_OnKeyPress(event)' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputStartDateHidden = inputStartDateHidden.replace(/ResourceCostIndex/g, curResourceCostID);
                                inputStartDateHidden = inputStartDateHidden.replace(/curStartDate/g, curStartDate);
                                inputStartDateHidden += '</div>';
                                inputStartDateHidden = inputStartDateHidden.replace(/clsResourceCalendar/g, "clsResourceCalendar" + curResourceCostID);


                                ResourceCostHTML += '<td>' + inputStartDate + inputStartDateHidden + '</td>';

                                var inputEndDate = '<div class="input-group">';
                                inputEndDate += '<%=CommonFunctions.HTMLControls.DrawTextBox("editResourceCostEndDate" + "ResourceCostIndex", "editResourceCostEndDate" + "ResourceCostIndex", "form-control clsBudgetDate", , , "curEndDate", "center", , True, True, ToBeInserted:="onPaste='return false' onkeypress='return Date_OnKeyPress(event)' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputEndDate = inputEndDate.replace(/ResourceCostIndex/g, curResourceCostID);
                                inputEndDate = inputEndDate.replace(/curEndDate/g, curEndDate);
                                inputEndDate += '<span class="input-group-btn clsResourceCalendar clsShowHide">';
                                inputEndDate += '<button class="btn btncalendar" type="button"><i class="fas fa-calendar-alt"></i></button>';
                                inputEndDate += '</span>';
                                inputEndDate += '</div>';
                                inputEndDate = inputEndDate.replace(/clsResourceCalendar/g, "clsResourceCalendar" + curResourceCostID);

                                var inputEndDateHidden = '<div class="input-group">';
                                inputEndDateHidden += '<%=CommonFunctions.HTMLControls.DrawTextBox("editResourceCostEndDateHidden" + "ResourceCostIndex", "editResourceCostEndDateHidden" + "ResourceCostIndex", "form-control clsBudgetDate", , , "curEndDate", "center", , True, True, IsHidden:=True, ToBeInserted:="onPaste='return false' onkeypress='return Date_OnKeyPress(event)' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputEndDateHidden = inputEndDateHidden.replace(/ResourceCostIndex/g, curResourceCostID);
                                inputEndDateHidden = inputEndDateHidden.replace(/curEndDate/g, curEndDate);
                                inputEndDateHidden += '</div>';
                                inputEndDateHidden = inputEndDateHidden.replace(/clsResourceCalendar/g, "clsResourceCalendar" + curResourceCostID);

                                ResourceCostHTML += '<td class="text-start">' + inputEndDate + inputEndDateHidden + '</td>';

                                var hiddenResourceAllocation = '<%=CommonFunctions.HTMLControls.DrawTextBox("editAllocation" + "ResourceCostIndex", "editAllocation" + "ResourceCostIndex", "form-control clsShowHide", , 5, "curResourceAllocation", "left", ,, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;allocation&quot;, " + "ResourceCostIndex" + ")' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                hiddenResourceAllocation = hiddenResourceAllocation.replace(/ResourceCostIndex/g, curResourceCostID);
                                hiddenResourceAllocation = hiddenResourceAllocation.replace(/curResourceAllocation/g, ResourceAllocation);

                                var inputResourceAllocationHidden = '<%=CommonFunctions.HTMLControls.DrawTextBox("editAllocationHidden" + "ResourceCostIndex", "editAllocationHidden" + "ResourceCostIndex", "form-control", , 8, "curResourceAllocation", "center", , True, True, IsHidden:=True, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;allocation&quot;, " + "ResourceCostIndex" + ")' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputResourceAllocationHidden = inputResourceAllocationHidden.replace(/ResourceCostIndex/g, curResourceCostID);
                                inputResourceAllocationHidden = inputResourceAllocationHidden.replace(/curResourceAllocation/g, ResourceAllocation);


                                ResourceCostHTML += '<td>';
                                hiddenResourceAllocation += '<div class="progress curResourceProgress">';

                                if (ResourceAllocation == "") {
                                    hiddenResourceAllocation += '<div class="progress-bar" role="progressbar" style="width: 0%;color:black;" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">0%</div>';
                                }
                                else {
                                    hiddenResourceAllocation += '<div class="progress-bar" role="progressbar" style="width: ' + ResourceAllocation + '%;color:black;" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">' + ResourceAllocation + '%</div>';
                                }
                                hiddenResourceAllocation = hiddenResourceAllocation.replace(/curResourceProgress/g, "curResourceProgress" + curResourceCostID);

                                //var budgetconversion = parseFloat(Result[i].Budget) * parseFloat(curConversionRate);
                                //budgetconversion = parseFloat(budgetconversion).toFixed(2);

                                var budgetconversion = parseFloat(Result[i].Budget);
                                budgetconversion = parseFloat(budgetconversion).toFixed(2);

                                ResourceCostHTML += '</div>';
                                ResourceCostHTML += hiddenResourceAllocation + inputResourceAllocationHidden;
                                ResourceCostHTML += '</td>';

                                //ResourceCostHTML += '<td>' + budgetconversion + '</td>';                                
                                //ResourceCostHTML += '<td>' + curRoleCost + '</td>';

                                var inputBudget = '<%=CommonFunctions.HTMLControls.DrawTextBox("editBudget" + "ResourceCostIndex", "editBudget" + "ResourceCostIndex", "form-control", , 11, "curbudgetconversion", "center", , True, True, ToBeInserted:="oninput='isEditOriginalBudgetChanged(" + "ResourceCostIndex" + ")' onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;budget&quot;, " + "ResourceCostIndex" + ")' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputBudget = inputBudget.replace(/ResourceCostIndex/g, curResourceCostID);
                                inputBudget = inputBudget.replace(/curbudgetconversion/g, budgetconversion);

                                var inputBudgetHidden = '<%=CommonFunctions.HTMLControls.DrawTextBox("editBudgetHidden" + "ResourceCostIndex", "editBudgetHidden" + "ResourceCostIndex", "form-control", , 11, "curbudgetconversion", "center", , True, True, IsHidden:=True, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;budget&quot;, " + "ResourceCostIndex" + ")' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputBudgetHidden = inputBudgetHidden.replace(/ResourceCostIndex/g, curResourceCostID);
                                inputBudgetHidden = inputBudgetHidden.replace(/curbudgetconversion/g, budgetconversion);

                                var clsOriginalBudgetChange = "";
                                if (Result[i].IsOriginalBudgetChange == 1) {
                                    clsOriginalBudgetChange = "clsOriginalBudgetChange";
                                }
                                var labelBudgetChangeHidden = '<label id="labelBudgetChangeHidden' + curResourceCostID + '" class = "' + clsOriginalBudgetChange + '"></label>';


                                ResourceCostHTML += '<td>' + inputBudget + inputBudgetHidden + labelBudgetChangeHidden + '</td>';

                                var inputRoleCost = '<%=CommonFunctions.HTMLControls.DrawTextBox("editRoleCost" + "ResourceCostIndex", "editRoleCost" + "ResourceCostIndex", "form-control", , 11, "curRoleCost", "center", , True, True, ToBeInserted:="onPaste='return false' oninput='changeBudgetOnRateChange(" + "ResourceCostIndex" + ")' onkeypress='return restrictAlphabets(event, &quot;budget&quot;, " + "ResourceCostIndex" + ")' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputRoleCost = inputRoleCost.replace(/ResourceCostIndex/g, curResourceCostID);
                                inputRoleCost = inputRoleCost.replace(/curRoleCost/g, curRoleCost);

                                var inputRoleCostHidden = '<%=CommonFunctions.HTMLControls.DrawTextBox("editRoleCostHidden" + "ResourceCostIndex", "editRoleCostHidden" + "ResourceCostIndex", "form-control", , 11, "curRoleCost", "center", , True, True, IsHidden:=True, ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;budget&quot;, " + "ResourceCostIndex" + ")' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputRoleCostHidden = inputRoleCostHidden.replace(/ResourceCostIndex/g, curResourceCostID);
                                inputRoleCostHidden = inputRoleCostHidden.replace(/curRoleCost/g, curRoleCost);

                                ResourceCostHTML += '<td>' + inputRoleCost + inputRoleCostHidden + '</td>';

                                ResourceCostHTML += "<td class='actioncolumn'>";
                                ResourceCostHTML += "<a href='javascript:;' id='btnResourceCost' onclick='SaveResourceCostRoles(" + curResourceCostID + ", this)' id='btnResourceCost' class='add' title='' data-bs-toggle='tooltip' data-bs-container='body' data-original-title='Save' style='display: none;'>";
                                ResourceCostHTML += "<img class='material-icons' src='../../../Whizible2.0-new/dist/img/save.svg' alt='' width='16px'>";
                                ResourceCostHTML += "</a>";

                                ResourceCostHTML += "<a class='edit_SH_Detail clsEditResourceCost nostylebtn edit' onclick='Edit_ResourceCost(" + curResourceCostID + ", 1, &quot;editMode&quot;, this)' href='javascript:;' title='' data-bs-toggle='tooltip' data-bs-placement='top' data-bs-container='body' data-original-title='Edit' style='display: inline;'>";

                                ResourceCostHTML += "<img src='../../../Whizible2.0-new/dist/img/edit.svg' width='16px'>";
                                ResourceCostHTML += "</a>";
                                if (blnDeleteAccess == "False") {

                                }
                                else {
                                    ResourceCostHTML += "<a id='Delete_ResourceCost_" + curResourceCostID + "' style='cursor:pointer;' class='nostylebtn clsDeleteResCost delete' data-id='" + curResourceCostID + "' data-bs-toggle='modal' onclick='setDeleteResourceCost(this.id)' data-bs-target='#deleteResourcecostmodal' style='display: inline;'><i class='far fa-trash-alt' title='' data-bs-toggle='tooltip' data-bs-placement='top' data-bs-container='body' data-original-title='Delete'></i></a>";
                                }
                                ResourceCostHTML += "<a href='javascript:;' class='nostylebtn cancelrowvalue' onclick='cancelEdit_ResourceCost(" + curResourceCostID + ", 1, &quot;cancelMode&quot;, this)' style='display: none;'><i class='fas fa-times' title='' data-bs-toggle='tooltip' data-bs-placement='top' data-bs-container='body' data-original-title='Cancel'></i></a>";
                                ResourceCostHTML += "</td>";

                                ResourceCostHTML += '</tr>';

                                StopAjaxLoader("#BodyCreateProject");
                            }
                            if (mode != "edit") {
                                $("#bodyResourceCostDetails").html(ResourceCostHTML);
                                tableResourceCost = $('.budgetresourcecost_tbl').DataTable({
                                    "pageLength": 5,
                                    "bdestroy": true,
                                    "lengthChange": false,
                                    "bFilter": false,
                                    "ordering": false,
                                    "responsive": true,
                                    "drawCallback": function (settings) {
                                        $('[data-bs-toggle="tooltip"]').tooltip();
                                        $('.clsBudgetDate').datepicker({
                                            autoclose: true,
                                            changeMonth: true,
                                            changeYear: true, //added by pradip on 09-04-2020
                                            dateFormat: 'dd M yy'
                                        });
                                    }
                                });
                            }
                            $('#editResourceCostStartDate, #editResourceCostEndDate').datepicker({
                                autoclose: true,
                                changeMonth: true,
                                changeYear: true, // added by pradip on 09-04-2020
                                dateFormat: 'dd M yy'
                            });
                        }
                        else {
                            if (mode != "edit") {
                                $("#bodyResourceCostDetails").html(ResourceCostHTML);
                                tableResourceCost = $('.budgetresourcecost_tbl').DataTable({
                                    "pageLength": 5,
                                    "bdestroy": true,
                                    "lengthChange": false,
                                    "bFilter": false,
                                    "ordering": false,
                                    "responsive": true,
                                    "drawCallback": function (settings) {
                                        $('[data-bs-toggle="tooltip"]').tooltip();
                                    }
                                });
                                $(".budgetresourcecost_tbl tbody tr td").prop("colspan", 8);
                                $(".budgetresourcecost_tbl tbody tr td").css("text-align", "center");
                            }
                        }
                        if (cntResourceCost <= 5) {
                            disablePagination();
                        }

                        var currencyImagePath = "";
                        if (curProjectCurrencyCode == "USD") {
                            currencyImagePath = "../../../Whizible2.0-new/dist/img/USD.svg";
                        }
                        if (curProjectCurrencyCode == "INR") {
                            currencyImagePath = "../../../Whizible2.0-new/dist/img/rupee.svg";
                        }
                        if (curProjectCurrencyCode == "SGD") {
                            currencyImagePath = "../../../Whizible2.0-new/dist/img/SGD.svg";
                        }
                        if (curProjectCurrencyCode == "EUR") {
                            currencyImagePath = "../../../Whizible2.0-new/dist/img/EUR.svg";
                        }
                        if (curProjectCurrencyCode == "NZD") {
                            currencyImagePath = "../../../Whizible2.0-new/dist/img/NZD.svg";
                        }

                        ResourceCostSummaryHTML += "";

                        ResourceCostSummaryHTML += '<dl class="dl-horizontal float-start">';
                        ResourceCostSummaryHTML += '<dt><%=MyBase.GetResourceString("C_TotalResource")%> <span>(<%=MyBase.GetResourceString("C_Average")%>)</span></dt>';
                        ResourceCostSummaryHTML += '<dd>';
                        ResourceCostSummaryHTML += '<img src="' + currencyImagePath + '" width="16px" alt="" title="">&nbsp;&nbsp;';
                        //ResourceCostSummaryHTML += '<div>' + "(" + '<img src="' + currencyImagePath + '" width="16px" alt="" title="">' + ")" + '</div>';
                        if (curResourceCostPercent > ResourceCostPercentage) {
                            ResourceCostSummaryHTML += curTotalBudget + ' <i style="color: #f10000 !important;" class="costindicator fas fa-long-arrow-alt-down"></i></dd>';
                        }
                        else {
                            ResourceCostSummaryHTML += curTotalBudget + ' <i style="color: #81cf09 !important;" class="costindicator fas fa-long-arrow-alt-up"></i></dd>';
                        }

                        ResourceCostSummaryHTML += '</dl>';
                        ResourceCostSummaryHTML += '<dl class="dl-horizontal profitmargin float-start">';
                        ResourceCostSummaryHTML += '<dt><%=MyBase.GetResourceString("C_margin")%><span>(<%=MyBase.GetResourceString("C_Average")%>)</span></dt>';

                        if (curProfitMargin < ProfitMarginPercentage) {
                            ResourceCostSummaryHTML += '<dd>' + curProfitMargin + '% <i style="color: #f10000 !important;" class="costindicator fas fa-long-arrow-alt-down"></i></dd>';
                        }
                        else {
                            ResourceCostSummaryHTML += '<dd>' + curProfitMargin + '% <i style="color: #81cf09 !important;" class="costindicator fas fa-long-arrow-alt-up"></i></dd>';
                        }

                        ResourceCostSummaryHTML += '</dl>';
                        if (curTotalBudget != "" || curTotalBudget != 0) {
                            $("#totalBudget").text(curTotalBudget.toFixed(2));// For Issue ID 24923
                        } else {
                            $("#totalBudget").text(curTotalBudget);

                        }
                        $(".resourcecost").html(ResourceCostSummaryHTML);

                        if ((curGlobalConversionRate == 0 && curCorporateCurrencyCode != curProjectCurrencyCode) || curProjectCurrencyCode == "") {
                            $("#noteResourceCostCurrency").removeClass("clsShowHide");
                        }
                        else {

                            if (!$("#noteResourceCostCurrency").hasClass("clsShowHide"))
                                $("#noteResourceCostCurrency").addClass("clsShowHide");
                        }


                        StopAjaxLoader("#BodyCreateProject");
                    },
                    error: function (err) {
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
            }
            catch (ex) {
                //alert(ex.message());
            }
        }
        function changeBudgetOnRateChange(ResourceCostId) {

            if ($('#labelBudgetChangeHidden' + ResourceCostId).hasClass("clsOriginalBudgetChange") == false) {
                getBudgetForResourceEdit(ResourceCostId);
            }

            if ($("#labelBudgetChangeHidden" + ResourceCostId).hasClass("clsOriginalBudgetChange")) {
                if ($("#labelBudgetChangeHidden" + ResourceCostId).hasClass("clsMarkedOriginalBudgetChange")) {

                    //if (parseFloat($("#editBudgetHidden" + ResourceCostId).val()) == parseFloat($("#editBudget" + ResourceCostId).val())) {
                    //    $("#labelBudgetChangeHidden" + ResourceCostId).removeClass("clsOriginalBudgetChange");
                    //    $("#labelBudgetChangeHidden" + ResourceCostId).removeClass("clsMarkedOriginalBudgetChange");

                    //    //alert(parseFloat($("#editBudgetHidden" + curResourceCostId).val()));
                    //    //alert(parseFloat($("#editBudget" + curResourceCostId).val()));
                    //}
                }
            }
            else {
                if (parseFloat($("#editBudgetHidden" + ResourceCostId).val()) != parseFloat($("#editBudget" + ResourceCostId).val())) {
                    $("#labelBudgetChangeHidden" + ResourceCostId).addClass("clsOriginalBudgetChange");
                    $("#labelBudgetChangeHidden" + ResourceCostId).addClass("clsMarkedOriginalBudgetChange");
                }
                else {

                }
            }
        }

        function getBudget() {
            var curNoOfCostResources = $("#textNoOfCostResources").val();
            var curCostResourceStartDate = $("#dtCostResourceStartDate").val();
            var curCostResourceEndDate = $("#dtCostResourceEndDate").val();
            var curResourceAllocation = $("#textCostResourceAllocation").val();

            if (curNoOfCostResources != "" && curCostResourceStartDate != "" && curCostResourceEndDate != "" && curResourceAllocation != "") {
                GetResourceCostOUDuration(0);
                GetResourceCostOUHours(0);
            }
        }

        function getBudgetForResourceEdit(ResourceCostId) {
            var curNoOfCostResources = $("#editNoOfResource" + ResourceCostId).val();
            var curCostResourceStartDate = $("#editResourceCostStartDate" + ResourceCostId).val();
            var curCostResourceEndDate = $("#editResourceCostEndDate" + ResourceCostId).val();
            var curResourceAllocation = $("#editAllocation" + ResourceCostId).val();

            if (curNoOfCostResources != "" && curCostResourceStartDate != "" && curCostResourceEndDate != "" && curResourceAllocation != "") {
                GetEditResourceCostOUDuration(ResourceCostId);
                GetEditResourceCostOUHours(ResourceCostId);
            }
        }

        function getRatePerHour(RoleID) {
            var projectParameters = { RoleID: encodeURI(RoleID) };
            var param = JSON.stringify(projectParameters);
            $.ajax({
                url: encodeURI(strUrl + '/api/PM_CreateProject/GetRatePerHour'),
                type: "POST",
                data: param,
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (param) {
                        xhr.setRequestHeader("Params", encryptString(isJson(param) ? param : JSON.stringify(param)));
                    }
                },
                success: function (result) {
                    for (var i = 0; i < result.length; i++) {
                        $("#textCostResourceMaxRate").val(result[i].RoleCost);
                        //debugger;                        
                    }
                },
                error: function (err) {
                    // alert("error");
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    //StopAjaxLoader("#bodyIssueDetails");
                }
            });
        }
        function GetRateCardDetails() {
            try {
                cntSiteRoles = 0;
                var Data = {
                    WhichAction: encodeURI(WhichAction), //FromWhereData                    
                    ProjectSiteID: encodeURI(SelectedProjectSiteID),
                }
                StartLoader("#BodyCreateProject");
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/GetRateCardDetails'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (Result) {
                        // debugger;
                        var RateCardHTML = "";
                        $(".ratecardtble").dataTable().fnDestroy();
                        $("#bodyRateCardDetails").html("");

                        if (Result != "") {
                            cntSiteRoles = Result.length;
                            for (var i = 0; i < Result.length; i++) {
                                var curProjectSiteRoleID = Result[i].ProjectSiteRoleID;
                                var curRoleId = Result[i].RoleID;
                                var curNormalRate = Result[i].NormalRate;
                                var curExtraRate = Result[i].ExtraRate;
                                var curHolidayRate = Result[i].HolidayRate;
                                SelectedSiteCurrencytext = $("#cboEditSiteCurrency option:selected").text();;//Added By Dipali V On 11th June 2020 For Issue ID 24913
                                RateCardHTML += "<tr class='ratecardedit_row'>";
                                RateCardHTML += "<td width='35%' class='text-start'>" + Result[i].RoleDescription;
                                //<% CommonFunctions.HTMLControls.DrawTextBox("textnormalrate", "textnormalrate", "form-control", , ,,,,,,,, "onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;normalrate&quot;)' autocomplete='off'",,,,,,, True) %>

                                var hiddenrole = '<%=CommonFunctions.HTMLControls.DrawTextBox("txtRoleHidden" + "ProjectSiteRoleIndex", "txtRoleHidden" + "ProjectSiteRoleIndex", "form-control", , , "curRoleId", "left", , , IsHidden:=True, returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                hiddenrole = hiddenrole.replace(/ProjectSiteRoleIndex/g, curProjectSiteRoleID);
                                hiddenrole = hiddenrole.replace(/curRoleId/g, curRoleId);
                                var inputNormalRate = '<%=CommonFunctions.HTMLControls.DrawTextBox("editNormalRate" + "ProjectSiteRoleIndex", "editNormalRate" + "ProjectSiteRoleIndex", "form-control textinput", , 9, "curNormalRate", "left", , , ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;normalrate&quot;)' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputNormalRate = inputNormalRate.replace(/ProjectSiteRoleIndex/g, curProjectSiteRoleID);
                                inputNormalRate = inputNormalRate.replace(/curNormalRate/g, curNormalRate);
                                var inputExtraRate = '<%=CommonFunctions.HTMLControls.DrawTextBox("editExtraRate" + "ProjectSiteRoleIndex", "editExtraRate" + "ProjectSiteRoleIndex", "form-control textinput", , 9, "curExtraRate", "left", , , ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;extrarate&quot;)' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputExtraRate = inputExtraRate.replace(/ProjectSiteRoleIndex/g, curProjectSiteRoleID);
                                inputExtraRate = inputExtraRate.replace(/curExtraRate/g, curExtraRate);
                                var inputHolidayRate = '<%=CommonFunctions.HTMLControls.DrawTextBox("editHolidayRate" + "ProjectSiteRoleIndex", "editHolidayRate" + "ProjectSiteRoleIndex", "form-control textinput", , 9, "curHolidayRate", "left", , , ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;holidayrate&quot;)' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputHolidayRate = inputHolidayRate.replace(/ProjectSiteRoleIndex/g, curProjectSiteRoleID);
                                inputHolidayRate = inputHolidayRate.replace(/curHolidayRate/g, curHolidayRate);

                                var inputNormalRateHidden = '<%=CommonFunctions.HTMLControls.DrawTextBox("editNormalRateHidden" + "ProjectSiteRoleIndex", "editNormalRateHidden" + "ProjectSiteRoleIndex", "form-control textinput", , 9, "curNormalRate", "left", , , ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;normalrate&quot;)' autocomplete='off'", IsHidden:=True, returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputNormalRateHidden = inputNormalRateHidden.replace(/ProjectSiteRoleIndex/g, curProjectSiteRoleID);
                                inputNormalRateHidden = inputNormalRateHidden.replace(/curNormalRate/g, curNormalRate);
                                var inputExtraRateHidden = '<%=CommonFunctions.HTMLControls.DrawTextBox("editExtraRateHidden" + "ProjectSiteRoleIndex", "editExtraRateHidden" + "ProjectSiteRoleIndex", "form-control textinput", , 9, "curExtraRate", "left", , , ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;extrarate&quot;)' autocomplete='off'", IsHidden:=True, returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputExtraRateHidden = inputExtraRateHidden.replace(/ProjectSiteRoleIndex/g, curProjectSiteRoleID);
                                inputExtraRateHidden = inputExtraRateHidden.replace(/curExtraRate/g, curExtraRate);
                                var inputHolidayRateHidden = '<%=CommonFunctions.HTMLControls.DrawTextBox("editHolidayRateHidden" + "ProjectSiteRoleIndex", "editHolidayRateHidden" + "ProjectSiteRoleIndex", "form-control textinput", , 9, "curHolidayRate", "left", , , ToBeInserted:="onPaste='return false' onkeypress='return restrictAlphabets(event, &quot;holidayrate&quot;)' autocomplete='off'", IsHidden:=True, returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputHolidayRateHidden = inputHolidayRateHidden.replace(/ProjectSiteRoleIndex/g, curProjectSiteRoleID);
                                inputHolidayRateHidden = inputHolidayRateHidden.replace(/curHolidayRate/g, curHolidayRate);


                                RateCardHTML += hiddenrole;
                                RateCardHTML += "</td>";
                                RateCardHTML += "<td>";
                                //RateCardHTML += "<input id='editNormalRate" + curProjectSiteRoleID + "' type='text' class='textinput' value='" + Result[i].NormalRate + "' name>";
                                RateCardHTML += inputNormalRate + inputNormalRateHidden;
                                RateCardHTML += "</td>";
                                RateCardHTML += "<td>";
                                //RateCardHTML += "<input id='editExtraRate" + curProjectSiteRoleID + "' type='text' class='textinput' value='" + Result[i].ExtraRate + "' name>";
                                RateCardHTML += inputExtraRate + inputExtraRateHidden;
                                RateCardHTML += "</td>";
                                RateCardHTML += "<td>";
                                //RateCardHTML += "<input id='editHolidayRate" + curProjectSiteRoleID + "' type='text' class='textinput' value='" + Result[i].HolidayRate + "' name>";
                                RateCardHTML += inputHolidayRate + inputHolidayRateHidden;
                                RateCardHTML += "</td>";

                                var inputCurrencyCode = '<%=CommonFunctions.HTMLControls.DrawTextBox("editCurrencyCode" + "ProjectSiteRoleIndex", "editCurrencyCode" + "ProjectSiteRoleIndex", "form-control textinput", , 9, "curCurrencyCode", "center", , , ToBeInserted:="onkeypress='return restrictAlphabets(event, &quot;holidayrate&quot;)' autocomplete='off'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                                inputCurrencyCode = inputCurrencyCode.replace(/ProjectSiteRoleIndex/g, curProjectSiteRoleID);
                                //inputCurrencyCode = inputCurrencyCode.replace(/curCurrencyCode/g, Result[i].CurrencyCode);
                                inputCurrencyCode = inputCurrencyCode.replace(/curCurrencyCode/g, SelectedSiteCurrencytext);
                                RateCardHTML += "<td>";
                                RateCardHTML += inputCurrencyCode;
                                RateCardHTML += "</td>";
                                RateCardHTML += "<td width='10%' class='addnewpanel_Actionlink'>";

                                RateCardHTML += "<a class='ratecardedit' onclick='editRole(" + curProjectSiteRoleID + ")' href='javascript:;' data-bs-toggle='tooltip' data-bs-placement='top' data-original-title='Edit'><img src='../../../Whizible2.0-new/dist/img/edit.svg' width='16px'></a>";

                                RateCardHTML += "<a class='saveratecardedit' onclick='Save_Role(&quot;Edit&quot;," + curProjectSiteRoleID + ", this)' href='javascript:;'><img class='material-icons' src='../../../Whizible2.0-new/dist/img/save.svg' alt='' width='16px' data-bs-toggle='tooltip' data-bs-placement='top' data-original-title='Save'></a>";
                                RateCardHTML += "<a class='cancleratecardedit' onclick='cancelRole(" + curProjectSiteRoleID + ")' href='javascript:;'><i class='fas fa-times' title='' data-bs-toggle='tooltip' data-bs-placement='top' data-bs-container='body' data-original-title='Cancel'></i></a>";
                                RateCardHTML += "</td>";
                                RateCardHTML += "</tr>";

                                StopAjaxLoader("#BodyCreateProject");
                            }
                            $("#bodyRateCardDetails").html(RateCardHTML);
                        }

                        $('.ratecardedit, .sndetail a, .cancleratecardedit').click(function () {
                            $(this).closest('.ratecardedit_row').toggleClass('ratecardedit_row_open');

                            if ($(this).closest('.ratecardedit_row').hasClass("textinput")) {

                                $(this).closest('.ratecardedit_row').removeClass("textinput");
                            }
                            else {
                                $(this).closest('.ratecardedit_row').addClass("textinput");
                            }
                        });
                        tableRateCard = $('.ratecardtble').DataTable({
                            "pageLength": 5,
                            "bdestroy": true,
                            "lengthChange": false,
                            "bFilter": false,
                            "ordering": false,
                            "responsive": true,
                            "drawCallback": function (settings) {
                                $('[data-bs-toggle="tooltip"]').tooltip();                                                              
                            }
                        });
                        if (RateCardHTML == "") {
                            $(".ratecardtble tbody tr td").prop("colspan", 6);
                        }

                        if (cntSiteRoles == 0 && $(".ratecardtble tbody tr td").hasClass("dataTables_empty")) {
                            $(".ratecardtble tbody tr td").css("cssText", "text-align: center !important;");
                            //$(".ratecardtble tbody tr td").css({ "text-align": "center!important" });
                        }
                        if (cntSiteRoles <= 5) {
                            $("#CProletab .table-responsive .dataTables_wrapper .dataTables_paginate .paginate_button").each(function () {
                                if ($(this).hasClass("previous")) {
                                    $(this).css({ 'pointer-events': 'none' });
                                }
                                if ($(this).hasClass("next")) {
                                    $(this).css({ 'pointer-events': 'none' });
                                }
                            });
                        }
                        if (WhichAction == "C") {
                            if (cntSiteRoles > 0)
                                $("#lnkupdateBillingInfo").removeClass("clsShowHide");
                            else
                                $("#lnkupdateBillingInfo").addClass("clsShowHide");
                        }
                        StopAjaxLoader("#BodyCreateProject");
                    },
                    error: function (err) {
                        //alert("error");
                        //alert(err.responseText);
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
                $(".editratecard_detail").click(function () {
                    $(".ratecarddropdown").toggleClass("open");
                });
            }
            catch (ex) {
                //alert(ex.message());
            }
        }

        function Edit_mileStone(MilesToneID, ProjectID, WhichAction) {
            //alert($("#modalMilestone").text());
            $("#modalMilestone").text("Edit Milestone");
            SelectedMilestonID = MilesToneID;
            MilestoneMode = "Edit";
            //alert(SelectedMilestonID);
            var Data = {
                MilesToneID: encodeURI(SelectedMilestonID),
                WhichAction: encodeURI(WhichAction), //FromWhereData
                ProjectID: encodeURI(ProjectID)
            }
            StartLoader("#BodyCreateProject")
            $.ajax({
                url: encodeURI(strUrl + '/api/PM_CreateProject/BindMileStoneDetails'),
                type: "POST",
                data: JSON.stringify(Data),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (Data) {
                        xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                    }
                },
                success: function (Result) {
                    if (Result != "") {
                        for (var i = 0; i < Result.length; i++) {
                            $("#addnew_Milestonemodal").modal('show');
                            $("#textMilestoneName").val(Result[0].MileStoneName);
                            $("#dtMilestoneStartDate").val(Result[0].StartDate);
                            $("#dtMilestoneEndDate").val(Result[0].EndDate);
                            //Commented And Added By Usha Pandit On 09.03.2020 For not showing 0 if Bill Amount is not entered
                            //$("#textMilestonebillamount").val(Result[0].BillAmount);
                            if (Result[0].BillAmount == 0.00) {
                                $("#textMilestonebillamount").val('');
                            }
                            else {
                                $("#textMilestonebillamount").val(Result[0].BillAmount);
                            }
                            //End Of Added By Usha Pandit On 09.03.2020 For not showing 0 if Bill Amount is not entered
                            curProjectBudgetValue = Result[0].ProjectValue;
                            curProjectSumOfAllBillAmt = Result[0].SumOfAllBillAmt;
                            curMilestoneStoredBillAmt = Result[0].BillAmount;
                            $("#cboMilestoneCurrency").attr('disabled', false);
                            $("#cboMilestoneCurrency").val(Result[0].Currency);
                            $("#cboMilestoneCurrency").attr('disabled', true);
                            StopAjaxLoader("#BodyCreateProject");
                        }
                    }
                    else {
                        StopAjaxLoader("#BodyCreateProject");
                    }
                },
                error: function (err) {
                    // alert("error");
                    //alert(err.responseText);
                    console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
        }

        var SelectedFreezeFlag = "";
        var SelectedWhichAction = "";
        var selectedSite = "";
        function Edit_Site(ProjectSiteID, CurrencyID, ProjectSiteName, FreezeFlag) {
            try {
                  //Added By Nikhil A on 1-March-2022 for removing the site calender button if project is in Draft Mode
                if (WhichAction == 'D' || WhichAction == 'N') {
                    $("#lnkSitecalender").addClass("clsShowHide");
                }
                else {
                     $("#lnkSitecalender").removeClass("clsShowHide");
                }
                //end of Added By Nikhil

                cntSiteRoles = 0;
                $(".CP_sitedetailpanel").show();
                $('html, body').animate({
                    scrollTop: $(".CP_sitedetailpanel").offset().top -= 200
                }, 500);
                if ($("#lnkCProletab").hasClass("active")) {
                    $("#CProletab").removeClass("active");
                    $("#CPdetailtab").addClass("active");
                    $("#lnkCProletab").removeClass("active");
                    $("#lnkCPdetailtab").addClass("active");
                }

                if (FreezeFlag == 1) {
                    $("#lnkfreezeSite").addClass("clsShowHide");
                }
                else if (FreezeFlag == 0 && WhichAction == 'C' && $("#lnkfreezeSite").hasClass("clsShowHide") == true) {
                    $("#lnkfreezeSite").removeClass("clsShowHide");
                }
                SelectedFreezeFlag = FreezeFlag;
                SelectedWhichAction = WhichAction;
                SelectedProjectSiteID = ProjectSiteID;
                selectedSite= ProjectSiteID;
                SelectedSiteCurrency = CurrencyID;
                SelectedProjectSiteName = ProjectSiteName;
                GetProjectSiteRole(0);
                $(".selectedsitename").html(SelectedProjectSiteName);
                ProjectSiteMode = "Edit";
                GetRateCardDetails();

                var Data = {
                    WhichAction: encodeURI(WhichAction), //FromWhereData
                    ProjectID: encodeURI(globalProjectId), //Draft ProjectID Or Actual Project Id
                    ProjectSiteID: encodeURI(SelectedProjectSiteID)
                }
                StartLoader("#BodyCreateProject");
                $.ajax({
                    url: encodeURI(strUrl + '/api/PM_CreateProject/GetSiteDetails'),
                    type: "POST",
                    data: JSON.stringify(Data),
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (Data) {
                            xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                        }
                    },
                    success: function (Result) {
                        if (Result != "") {
                            for (var i = 0; i < Result.length; i++) {

                                $("#txtEditSiteName").val(Result[i].Name);
                                $("#txtEditSiteShortName").val(Result[i].ShortName);
                                $("#cboEditSiteCurrency").val(Result[i].CurrencyID);
                                $("#cboEditRateMethod").val(Result[i].RateMethod);
                                $("#cboEditStartingDayOfWeek").val(Result[i].StartingDayOfWeek);
                                $("#txtEditWeekDays").val(Result[i].WeekDays);
                                $("#txtEditWorkHours").val(Result[i].WorkHrs);
                                $("#txtEditWorkHoursPerMonth").val(Result[i].HoursPerMonth);
                                $("#txtEditWorkHoursCap").val(Result[i].WorkHoursCapPerDay);
                                if (Result[i].IsOffshore == 0) {
                                    $("#chkEditOffshoreSite").prop("checked", false);
                                    $("#chkEditOffshoreSite").prop("disabled", false);
                                }
                                else {
                                    $("#chkEditOffshoreSite").prop("checked", true);
                                    $("#chkEditOffshoreSite").prop("disabled", true);
                                }

                                $("#txtEditAddress1").val(Result[i].Address);
                                $("#txtEditAddress2").val(Result[i].Address1);
                                $("#cboEditSiteCountry").val(Result[i].CountryID);
                                $("#txtEditState").val(Result[i].State);
                                $("#txtEditCity").val(Result[i].City);
                                $("#txtEditZip").val(Result[i].Zip);
                                $("#txtEditFax").val(Result[i].Fax);
                                $("#txtEditPhone").val(Result[i].Phone);
                                $("#txtEditEmail").val(Result[i].EmailID);
                                $("#txtEditRemarks").val(Result[i].Remarks);

                                //if (WhichAction == "C") {
                                //    $("#addnewsiterole").attr("disabled", true);
                                //    if (Browser == 'IE') {
                                //    }
                                //    else {
                                //        $("#addnewsiterole").css({ 'pointer-events': 'none' });
                                //    }
                                //}

                                $(".clsEditSite, #addnewsite1, .clsProSiteDelete").attr("disabled", true);
                                $(".clsEditSite").css({ 'pointer-events': 'none' });
                                if (Browser == 'IE') {
                                }
                                else {
                                    $("#addnewsite1").css({ 'pointer-events': 'none' });
                                    $(".clsProSiteDelete").css({ 'pointer-events': 'none' });
                                }

                                StopAjaxLoader("#BodyCreateProject");
                            }
                        }
                        else {
                            StopAjaxLoader("#BodyCreateProject");
                        }
                    },
                    error: function (err) {
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
            }
            catch (ex) {
                //alert(ex.message);
            }
        }
        //Added By Dipali V On 7th Jan 2020 For Selected WF
        function GetSelectedWorkfLOW(GlobalUniqueID) {
            var eaP = {
                GlobalUniqueID: encodeURI(GlobalUniqueID),
                TagID: encodeURI(Entity),
                ProjectID: encodeURI(globalProjectId),

            }
            $.ajax({
                url: strUrl + '/api/PM_CreateProject/GetSelectedWorkfLOW',
                type: "POST",
                data: JSON.stringify(eaP),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (eaP) {
                        xhr.setRequestHeader("Params", encryptString(isJson(eaP) ? eaP : JSON.stringify(eaP)));
                    }
                },
                success: function (data) {
                    //debugger;
                    if (data.length != 0) {
                        for (i = 0; i < data.length; i++) {
                            selectedWorkflow = data[i].NatureofDemandID;
                            // selectedWorkflowName = data[i].Description;//added by dipali v on 13th Jan 2020 For WF Name
                        }
                    }
                },
                error: function (err) {

                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""

                }
            });
            return selectedWorkflow;
        }
        //End of Added By Dipali V On 7th Jan 2020 For Selected WF


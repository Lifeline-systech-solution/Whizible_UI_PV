                        $("#chkAddOffshoreSite").focus();
                        checkSite = 1;
                        return checkSite;
                    }
                }
            }

            return checkSite;
        }

        function ValidateRole(flag, editProjectSiteRoleID) {
            var checkRole = 0;

            var RoleName = "";
            var NormalRate = "";
            var ExtraRate = "";
            var HolidayRate = "";

            var objRoleName = "";
            var objNormalRate = "";
            var objExtraRate = "";
            var objHolidayRate = "";
            if (flag == "Edit") {
                objRoleName = $("#txtRoleHidden" + editProjectSiteRoleID);
                objNormalRate = $("#editNormalRate" + editProjectSiteRoleID);
                objExtraRate = $("#editExtraRate" + editProjectSiteRoleID);
                objHolidayRate = $("#editHolidayRate" + editProjectSiteRoleID);
                RoleName = $("#txtRoleHidden" + editProjectSiteRoleID).val();
                NormalRate = $("#editNormalRate" + editProjectSiteRoleID).val();
                ExtraRate = $("#editExtraRate" + editProjectSiteRoleID).val();
                HolidayRate = $("#editHolidayRate" + editProjectSiteRoleID).val();
            }
            else {
                objRoleName = $("#cbositeRole");
                objNormalRate = $("#textnormalrate");
                objExtraRate = $("#textExtraRate");
                objHolidayRate = $("#textholidayRate");
                RoleName = $("#cbositeRole option:selected").val();
                NormalRate = $("#textnormalrate").val();
                ExtraRate = $("#textExtraRate").val();
                HolidayRate = $("#textholidayRate").val();
            }

            if (RoleName == "0" && flag != "Edit") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_Role") %>', 'error', 5);
                objRoleName.focus();
                checkRole = 1;
                return checkRole;
            }

            if (NormalRate == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_NormalRate") %>', 'error', 5);
                objNormalRate.focus();
                checkRole = 1;
                return checkRole;
            }
            if (NormalRate != "") {
                if (checkSpecialCharacter(NormalRate) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('Normal Rate cannot contain any of these /\\:*?<>|,"+- Characters', 'error');
                    objNormalRate.focus();
                    checkRole = 1;
                    return checkRole;
                }
            }
            if (ExtraRate != "") {
                if (checkSpecialCharacter(ExtraRate) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('Extra Rate cannot contain any of these /\\:*?<>|,"+- Characters', 'error');
                    objExtraRate.focus();
                    checkRole = 1;
                    return checkRole;
                }
            }
            if (HolidayRate != "") {
                if (checkSpecialCharacter(HolidayRate) == true) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.notify('Holiday Rate cannot contain any of these /\\:*?<>|,"+- Characters', 'error');
                    objHolidayRate.focus();
                    checkRole = 1;
                    return checkRole;
                }
            }
            return checkRole;
        }


                    }
                } else {

                    ProjectStatus = "0";
                }

                //  alert(ProjectTypeID);
                var Data = {
                    FromWhichMode: encodeURI(FromWhichMode),//Add,Edit Mode
                    AbbProjectName: encodeURI(AbbProjectName),
                    //ProjectName: encodeURI(ProjectName),
                    //Description: encodeURI(Description),
                     ProjectName: ProjectName,

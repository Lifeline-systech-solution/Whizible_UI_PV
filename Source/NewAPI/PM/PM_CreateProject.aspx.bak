        var MsgID = "";
        function ApproveRejectClick() {
            var comments = $("#txtWFARComments").val();   //Added By Rehan C
            if ($("#cboWF").val() == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify("WorkFlow Should not be blank.", 'error', 25);
                $("#cboWF").focus();
                return false;
            }

            if ($("#txtWFARComments").val() == "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.notify('<%= MyBase.GetResourceString("A_Comments") %>', 'error', 25);
                $("#txtWFARComments").focus();
                return false;
            }
            //Added By Rehan on 07/11/2022 To check validation for Special characters  on 11/11/2022
            if (checkSpecialCharacter(comments, WebConfigSpecialCharacters) == true) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('Comment Should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                $("#txtWFARComments").focus();
                return false;
            }
            //End Of Comment By Rehan C


            if (glovalStatus == 'A') {
                stAction = "SYS_APPROVE";
            }
            else {
                stAction = "SYS_REJECT";
            }
            // debugger
            MsgID = getMsgID(Entity);
            //alert(MsgID);
            var Remarks = $("#txtWFARComments").val();
            Remarks = Remarks.replace(/'/g, "''");
            var UserName = '<%=Session("strUserName")%>';
            var UserID = <%=Session("intUserID")%>;
            // alert(MsgID);
            var eaP = {
                intEntityID: GlobalUniqueID,
                MasterTagID: Entity,
                Status: glovalStatus,
                ProjectID: globalProjectId,
                Remarks: Remarks,
                UserName: '<%=Session("strUserName")%>',
                RoleID: <%=Session("intPostID")%>,
                UserID: <%=Session("intUserID")%>,
                LoginType: '<%=Session("LoginType")%>',

                WorkflowID: SelectedWF
            }
            $.ajax({
                url: strUrl + '/api/Approval/EntityApproval',
                type: "POST",
                data: JSON.stringify(eaP),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (eaP) {
                        xhr.setRequestHeader("Params", encryptString(isJson(eaP) ? eaP : JSON.stringify(eaP)));
                    }
                },
                success: function (data) {
                    //debugger;
                    if (data != "" || data != undefined) {
                        // alert(data);
                        // alert(GlWorkFlowInstance);
                        var IsShowMailPopUP = "";
                        var Result = data.split("||");
                        GlWorkFlowInstance = Result[0];
                        selectedWorkflow = Result[1];

                        //debugger;
                        IsShowMailPopUP = GetWorkFlowMailCondition(MsgID, Entity, GlobalUniqueID, GlWorkFlowInstance, Remarks, UserName, UserID);
                        var Status = "";
                        //Added By Dipali V On 6th Jan 2020 For alert Change Issues
                        if (glovalStatus == "A") {
                            Status = "Approve Revision Successfully"; //Approve Revison";
                        } else {
                            Status = "Reject Revision Successfully";///"Reject Revison";
                        }
                        //End of Addition By Dipali V On 6th Jan 2020 For alert Change Issues


                        alertify.set('notifier', 'position', 'top-right');
                        //alertify.notify(Status + " Successfully.", 'success', 25);
                        alertify.notify(Status, 'success', 25);
                        CheckIsBlockTimesheet = 0;
                        $("#divAppReject").modal('hide');
                        $("#divAppReject").removeClass('in');
                        // alert(IsShowMailPopUP);
                        if (IsShowMailPopUP == 1) {
                            window.open('../Email/SendEmail.aspx?MessageID=' + MsgID + "&workflow=1&PrimaryKeyValue=" + GlWorkFlowInstance + "&WorkFlowInstance=" + GlWorkFlowInstance + "&m_strcomments=null&UserName=" + UserName + "&UserID=" + UserID, '', 'resizable=yes,scrollbars=yes,toolbar=no,statusbar=no,left=' + (window.screen.width - 600) / 2 + ',top=' + (window.screen.height - 500) / 2 + ',width=600,height=500');
                        }

                        if (glovalStatus == "A") {
                            RevisionLink(GlobalUniqueID, Entity, globalProjectId);
                        }
                        globalrevisionFlag = "";
                        WorkFlowLink(32, globalProjectId);

                        //Added By Usha Pandit For Changes on 18.01.2020 for work hrs enable disable
                        GetProjectDetails(WhichAction, globalProjectId);
                        //End Of Added By Usha Pandit For Changes on 18.01.2020 for work hrs enable disable

                        //GetLinksAfterWorkFlowEnabled(32,globalProjectId)
                        
                        if (IsSaveButtonEnabled == 1) {
                            EnableDisableAsWorkflow();
                        }
                    }
                },
                error: function (err) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            })
        }

        function getMsgID(entity) {
            var Result = "";
            if (entity == "32") {
                if (glovalStatus == "A") {
                    Result = 2;
                }
                else {
                    Result = 3;
                }
            }

            return Result;


        }

        function GetWorkFlowMailCondition(MessageID, TagID, PrimaryKeyValue, WorkFlowInstance, m_strcomments, UserName, UserID) {
            var Result = "";
            // alert(WBSProjectId);
            var WBSParameters = {

                MessageID: encodeURI(MessageID),
                TagID: encodeURI(TagID),
                PrimaryKeyValue: encodeURI(PrimaryKeyValue),
                WorkFlowInstance: encodeURI(WorkFlowInstance),
                m_strcomments: encodeURI(m_strcomments),
                UserName: encodeURI(UserName),
                UserID: encodeURI(UserID)

            };

            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_WBS/GetWorkFlowMailCondition',
                method: 'Post',
                data: JSON.stringify(WBSParameters),
                dataType: 'json',
                async: false,
                contentType: "application/json; charset=utf-8", 
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (WBSParameters) {
                        xhr.setRequestHeader("Params", encryptString(isJson(WBSParameters) ? WBSParameters : JSON.stringify(WBSParameters)));
                    }
                },
                success: function (result) {
                    if (result != "") {
                        //alert(result);
                        Result = result;
                    }
                },


                error: function (err) {
                    console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }

            });
            return Result;
        }

        function RevisionLink(strPrimaryKey, TagID, ProjectId) {
            try {
                var WBSWorkFlow = {

                    TagID: encodeURI(TagID),
                    ProjectID: encodeURI(globalProjectId),
                    UserID: encodeURI(UserID),
                    RoleID: encodeURI('<%= Session("intpostID") %>'),
                    strPrimaryKey: encodeURI(strPrimaryKey)
                }
                //var Flag = true;
                StartLoader("WBSBody");
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_CreateProject/RevisionLink',
                    type: "POST",
                    data: JSON.stringify(WBSWorkFlow),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (WBSWorkFlow) {
                            xhr.setRequestHeader("Params", encryptString(isJson(WBSWorkFlow) ? WBSWorkFlow : JSON.stringify(WBSWorkFlow)));
                        }
                    },
                    success: function (strResult) {
                        if (strResult != "") {
                            $("#libtnRevisionLink_" + TagID).css("display", "inline-block");
                            $("#btnRevisionLink_" + TagID).css("display", "inline-block");
                            //Added & commented by Dipali V On 7th Jan 2020 For Resume link Click Issues
                            $("#btnRevisionLink_" + TagID).html("");
                            $("#libtnRevisionLink_" + TagID).html("");
                            // $("#btnRevisionLink_" + TagID).html(strResult);
                            $("#libtnRevisionLink_" + TagID).html(strResult);
                            //End of Addition & commented by Dipali V On 7th Jan 2020 For Resume link Click Issues

                            //alert(strResult);
                            //StopAjaxLoader("WBSBody");
                        } else {
                            $("#libtnRevisionLink_" + TagID).css("display", "none");
                            //commented by Dipali V On 7th Jan 2020 For Resume link Click Issues
                            //$("#btnRevisionLink_" + TagID).css("display", "none");

                        }
                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
                // return Flag;
            }
            catch (ex) {
                // alert(ex.message);
            }


        }

        var strUniquePrimaryKey = "";
        var strRevisionTagId = "";
        var WBSID = "";
        function RevisionOnclick(strPrimaryKey, TagID) {
            $("#txtRevisionComments").val('');
            strUniquePrimaryKey = strPrimaryKey;
            strRevisionTagId = TagID;
            if (strRevisionTagId == "32") {
                WBSID = strUniquePrimaryKey;

        function setPhaseFilterValueOnEditMode(columnName, operatorValue, FiledValue) {
            var getFiledName = PhaseJson[columnName];
            var FiledIds = getFiledName.split(',');
            var listofvalue = [FiledValue, operatorValue];
            //console.log(listofvalue);
            for (var i = 0; i < FiledIds.length; i++) {
                var filedId = FiledIds[i];
                var prefix = filedId.substring(0, 3);
                var value = listofvalue[i];
                value = value.replace("'", "");
                value = value.replace("'", "");
                if (prefix == "cbo") {
                    //console.log(filedId + " " + value);

                    if (filedId == "txtPhaseFilterResponsiblePerson" || filedId == "txtPhaseFilterPhase") {
                        jQuery("select#" + filedId + " option[value=" + value + " ]").prop('selected', true);
                    } else {
                        //  $("#"+filedId+" option:contains(" + value + ")").prop('selected', true);
                        $("#" + filedId + " option").filter(function () {
                            return $(this).text().trim() == value;
                        }).prop('selected', true);
                    }

                } else if (prefix == "txt") {
                    //console.log(filedId + " " + value);
                    $("#" + filedId).val(value);
                } else if (prefix = "chk") {
                    chkboxclick = 1;
                    //console.log(filedId + " " + value);
                    if (value == "1") {

                        $(".clsCheckBox").prop('checked', true);
                    } else {
                        $(".clsCheckBox").prop('checked', false);
                    }
                }

            }


        }
        function clearPhaseAllFiled() {

            $.each(PhaseJson, function (key, value) {

                var getFiledName = value;
                var FiledIds = getFiledName.split(',');

                for (var i = 0; i < FiledIds.length; i++) {
                    var filedId = FiledIds[i];
                    var prefix = filedId.substring(0, 3);

                    if (prefix == "cbo") {
                        $("#" + filedId).val($("#" + filedId + " option:first").val());

                    } else if (prefix == "txt") {

                        $("#" + filedId).val("");
                    } else if (prefix = "chk") {

                        $("#txtPhaseFilterCurrentPhase.clsCheckBox").prop('checked', false);
                    }
                }

            });

        }

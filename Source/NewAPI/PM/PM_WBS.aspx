        function genrateQuery() {
            for (var i = 0; i < FieldNamelst.length; i++) {

                var filedId = FieldNamelst[i];
                var opretorId = Operatorlst[i] + "Oprator";
                var operatorValue = $("#" + opretorId + " option:selected").text();

                if (filedId.indexOf("cbo") != -1) {

                    var filedValue = $("#" + filedId + " option:selected").val();
                    ////alert(filedValue);

                    if (filedValue.length > 0) {

                        var columnName = ColumnNamelst[i];
                        if (columnName == "ResponsiblePerson") {
                            strPhaseQuery += columnName + operatorValue + filedValue + " AND ";
                        } else {
                            strPhaseQuery += columnName + operatorValue + "'" + filedValue + "' AND ";
                        }
                        ////alert(strPhaseQuery);
                    }

                }

                if (filedId.indexOf("txt") != -1) {

                    if (filedId == "txtPhaseFilterEstimatedStartDate" || filedId == "txtPhaseFilterEstimatedEndDate") {
                        var filedValue = $("#" + filedId).val();

                        if (filedValue.length > 0) {

                            // var operatorValue = $("#" + opretorId + " option:selected").text();

                            var columnName = ColumnNamelst[i];
                            strPhaseQuery += columnName + operatorValue + "'" + filedValue + "' AND ";
                        }
                    } else {
                        var filedValue = $("#" + filedId).val();

                        if (filedValue.length > 0) {



                            var columnName = ColumnNamelst[i];
                            strPhaseQuery += columnName + operatorValue + filedValue + " AND ";
                        }

                    }

                }
                if (filedId.indexOf("chk") != -1) {


                    if (chkboxclick == 1) {


                        var filedValue = "";
                        // //alert(filedValue);
                        if ($('input[type="checkbox"]').is(":checked")) {
                            filedValue = "1";

                        } else if ($('input[type="checkbox"]').is(":not(:checked)")) {
                            filedValue = "0";

                        }
                        var operatorValue = $("#" + opretorId + " option:selected").text();
                        var columnName = ColumnNamelst[i];
                        strPhaseQuery += columnName + operatorValue + filedValue + " AND ";
                    }
                }

            }
            var removeChar = strPhaseQuery.lastIndexOf("AND");

            strPhaseQuery = strPhaseQuery.substr(0, removeChar);
            return strPhaseQuery;
        }



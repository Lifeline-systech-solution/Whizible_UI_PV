            }

            wbsFileDetailsCurrentPage = pageNumber || 1;
            if (wbsFileDetailsCurrentPage < 1) wbsFileDetailsCurrentPage = 1;
            if (wbsFileDetailsTotalPages > 0 && wbsFileDetailsCurrentPage > wbsFileDetailsTotalPages) {
                wbsFileDetailsCurrentPage = wbsFileDetailsTotalPages;
            }

            var startIndex = (wbsFileDetailsCurrentPage - 1) * wbsFileDetailsPageSize;
            var endIndex = Math.min(startIndex + wbsFileDetailsPageSize, wbsFileDetailsAllRows.length);
            var pageRows = wbsFileDetailsAllRows.slice(startIndex, endIndex);

            $.each(pageRows, function (_, row) {
                var responseText = row.errorMessage || row.ErrorMessage || "";
                var isValid = row.isValid || row.IsValid || 0;
                var isSaved = row.isSaved || row.IsSaved || 0;
                var responseCell = (wbsFileDetailsFlag === 1 && isValid === 1 && isSaved === 1)
                    ? '<span class="wbs-excel-success-status">' + WBSExcelRes.successful + '</span>'
                    : '<span class="wbs-excel-error-status">' + (responseText || WBSExcelRes.invalid) + '</span>';
                //Added By Vyankat Bhure on 08-07-2026 for Milestone Details and Bill Amount in File Details
                var milestoneDetails = row.milestoneDetails != null ? row.milestoneDetails : (row.MilestoneDetails != null ? row.MilestoneDetails : "");
                var billAmountRaw = row.billAmount != null ? row.billAmount : (row.BillAmount != null ? row.BillAmount : "");
                var billAmountDisplay = (billAmountRaw === "" || billAmountRaw === null || typeof billAmountRaw === "undefined")
                    ? ""
                    : billAmountRaw;
                //End of Added By Vyankat Bhure on 08-07-2026 for Milestone Details and Bill Amount in File Details

                tableBody.append(
                    '<tr>' +
                    '<td class="text-center">' + (row.rowNumber || row.RowNumber || "") + '</td>' +
                    '<td class="text-center">' + $("<div/>").text(row.milestoneName || row.MilestoneName || "").html() + '</td>' +
                    '<td class="text-center">' + WBSExcelFormatDisplayDate(row.startDate || row.StartDate || "", isValid) + '</td>' +
                    '<td class="text-center">' + WBSExcelFormatDisplayDate(row.endDate || row.EndDate || "", isValid) + '</td>' +
                    //Added By Vyankat Bhure on 08-07-2026 for Milestone Details and Bill Amount in File Details
                    '<td class="text-center">' + $("<div/>").text(milestoneDetails).html() + '</td>' +
                    '<td class="text-center">' + $("<div/>").text(billAmountDisplay).html() + '</td>' +
                    //End of Added By Vyankat Bhure on 08-07-2026 for Milestone Details and Bill Amount in File Details
                    '<td class="text-start">' + responseCell + '</td>' +
                    '</tr>'
                );
            });

            updateWBSFileDetailsPaginationControls();
        }

        function updateWBSFileDetailsPaginationControls() {
            if (wbsFileDetailsTotalRecords > 0) {
                $("#wbsFileDetailsPaginationControls").css("display", "flex");
                $("#wbsFileDetailsTotalRecords").text(wbsFileDetailsTotalRecords);
                WBSFileDetailsPagination();
            } else {
                $("#wbsFileDetailsPaginationControls").hide();
                wbsFileDetailsCurrentPage = 1;
                wbsFileDetailsTotalRecords = 0;
                wbsFileDetailsTotalPages = 0;
            }
        }

        function WBSFileDetailsPagination() {
            $("#wbsFileDetailsBtnPrevious, #wbsFileDetailsBtnNext").removeClass("fa-disabled");
            $("#wbsFileDetailsLinkPrevious, #wbsFileDetailsLinkNext").removeClass("disabled");

            if (parseInt(wbsFileDetailsCurrentPage, 10) <= 1) {
                $("#wbsFileDetailsBtnPrevious").addClass("fa-disabled");
                $("#wbsFileDetailsLinkPrevious").addClass("disabled");
            }

            if (parseInt(wbsFileDetailsCurrentPage, 10) >= parseInt(wbsFileDetailsTotalPages, 10)) {
                $("#wbsFileDetailsBtnNext").addClass("fa-disabled");
                $("#wbsFileDetailsLinkNext").addClass("disabled");
            }
        }

        function WBSFileDetailsPrevList() {
            if ($("#wbsFileDetailsBtnPrevious").hasClass("fa-disabled") || $("#wbsFileDetailsLinkPrevious").hasClass("disabled")) {
                return false;
            }
            if (wbsFileDetailsCurrentPage > 1) {
                RenderWBSFileDetailsPage(wbsFileDetailsCurrentPage - 1);
            }
            return false;
        }

        function WBSFileDetailsNextList() {
            if ($("#wbsFileDetailsBtnNext").hasClass("fa-disabled") || $("#wbsFileDetailsLinkNext").hasClass("disabled")) {
                return false;
            }
            if (wbsFileDetailsCurrentPage < wbsFileDetailsTotalPages) {
                RenderWBSFileDetailsPage(wbsFileDetailsCurrentPage + 1);
            }
            return false;
        }
        //End of Added By Vyankat Bhure on 08-07-2026 for File Details pagination (same as Uploaded File Details main page)
        //End of Added By Vyankat B. on 02-07-2026 for WBS Excel Uploaded File download and status info

        //Added By Vyankat B. on 02-07-2026 for WBS Excel Upload pagination (same as PM_AssignedTasks.aspx)
        function updateWBSUploadPaginationControls(paginationInfo) {
            if (!paginationInfo) {
                $("#paginationControls").hide();
                return;
            }

            wbsExcelUploadCurrentPage = parseInt(paginationInfo.CurrentPage || paginationInfo.currentPage || wbsExcelUploadCurrentPage || 1, 10);
            wbsExcelUploadPageSize = parseInt(paginationInfo.PageSize || paginationInfo.pageSize || wbsExcelUploadPageSize || 5, 10);
            wbsExcelUploadTotalRecords = parseInt(paginationInfo.TotalRecords || paginationInfo.totalRecords || 0, 10);
            wbsExcelUploadTotalPages = parseInt(paginationInfo.TotalPages || paginationInfo.totalPages || 0, 10);

            if (!wbsExcelUploadTotalPages && wbsExcelUploadTotalRecords > 0) {
                wbsExcelUploadTotalPages = Math.ceil(wbsExcelUploadTotalRecords / wbsExcelUploadPageSize);
            }

            if (wbsExcelUploadTotalRecords > 0) {
                $("#paginationControls").css("display", "flex");
                $("#wbsUploadTotalRecords").text(wbsExcelUploadTotalRecords);
                WBSUploadPagination();
            } else {
                $("#paginationControls").hide();
                wbsExcelUploadCurrentPage = 1;
                wbsExcelUploadTotalRecords = 0;
                wbsExcelUploadTotalPages = 0;
            }
        }

        function WBSUploadPagination() {
            $("#wbsBtnPrevious, #wbsBtnNext").removeClass("fa-disabled");
            $("#wbsLinkPrevious, #wbsLinkNext").removeClass("disabled");

            if (parseInt(wbsExcelUploadCurrentPage, 10) <= 1) {
                $("#wbsBtnPrevious").addClass("fa-disabled");
                $("#wbsLinkPrevious").addClass("disabled");
            }

            if (parseInt(wbsExcelUploadCurrentPage, 10) >= parseInt(wbsExcelUploadTotalPages, 10)) {
                $("#wbsBtnNext").addClass("fa-disabled");
                $("#wbsLinkNext").addClass("disabled");
            }
        }

        function WBSUploadPrevList() {
            if ($("#wbsBtnPrevious").hasClass("fa-disabled") || $("#wbsLinkPrevious").hasClass("disabled")) {
                return false;
            }

            if (wbsExcelUploadCurrentPage > 1) {
                GetWBSExcelUploadRequestDetails(wbsExcelUploadCurrentPage - 1, wbsExcelUploadPageSize);
            }
            return false;
        }

        function WBSUploadNextList() {
            if ($("#wbsBtnNext").hasClass("fa-disabled") || $("#wbsLinkNext").hasClass("disabled")) {
                return false;
            }

            if (wbsExcelUploadCurrentPage < wbsExcelUploadTotalPages) {
                GetWBSExcelUploadRequestDetails(wbsExcelUploadCurrentPage + 1, wbsExcelUploadPageSize);
            }
            return false;
        }
        //End of Added By Vyankat B. on 02-07-2026 for WBS Excel Upload pagination (same as PM_AssignedTasks.aspx)
        //End of added by Aditya J. on 12-06-2026 for WBS Excel Upload UI
    </script>



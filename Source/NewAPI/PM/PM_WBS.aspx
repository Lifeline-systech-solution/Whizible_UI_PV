        function WBSExcelValidateProjectSelection() {
            var projectId = GetWBSExcelSelectedProjectId();
            if (!projectId || projectId === "0" || projectId === 0) {
                alertify.set("notifier", "position", "top-right");
                alertify.error(WBSExcelRes.selectProject);
                return null;
            }
            return projectId;
        }

        function WBSExcelProcessSelectedFile(file) {
            //Added By Vyankat Bhure on 08-07-2026 for WBS Excel Upload role access (TagID 86168)
            if (!hasWBSExcelAddAccess) return;
            //End of Added By Vyankat Bhure on 08-07-2026 for WBS Excel Upload role access (TagID 86168)
            var fileInput = document.getElementById("wbs-excel-file-upload");
            var fileName = document.getElementById("wbs-excel-file-name");
            var uploadBtn = document.getElementById("wbs-excel-upload-btn");
            if (!fileInput || !fileName || !uploadBtn) return;

            if (file) {
                var validTypes = [".xlsx", ".xls"];
                var fileExtension = "." + file.name.split(".").pop().toLowerCase();
                if (validTypes.indexOf(fileExtension) === -1) {
                    alertify.set("notifier", "position", "top-right");
                    alertify.error(WBSExcelRes.invalidExcelFile);
                    fileInput.value = "";
                    fileName.textContent = WBSExcelRes.noFileChosen;
                    uploadBtn.disabled = true;
                    return;
                }
                if (file.size > 5 * 1024 * 1024) {
                    alertify.set("notifier", "position", "top-right");
                    alertify.error(WBSExcelRes.fileSizeLimit);
                    fileInput.value = "";
                    fileName.textContent = WBSExcelRes.noFileChosen;
                    uploadBtn.disabled = true;
                    return;
                }
                fileName.textContent = file.name;
                uploadBtn.disabled = false;
            } else {
                fileName.textContent = WBSExcelRes.noFileChosen;
                uploadBtn.disabled = true;
            }
        }

        //Added By Vyankat B. on 06-07-2026 for WBS Excel template download via AJAXCallWithResultNew
        function DownloadWBSTemplate() {
            //Added By Vyankat Bhure on 08-07-2026 for WBS Excel Upload role access (TagID 86168)
            if (!hasWBSExcelAddAccess) return;
            //End of Added By Vyankat Bhure on 08-07-2026 for WBS Excel Upload role access (TagID 86168)
            var projectId = WBSExcelValidateProjectSelection();
            if (!projectId) return;

            var templateParams = { projectID: parseInt(projectId, 10) };

            StartLoader("#WBSBody");
            AJAXCallWithResultNew(
                "api/PM_WBS_ExcelUpload/DownloadWBSTemplate",
                JSON.stringify(templateParams),
                true,
                {
                    responseType: "blob",
                    defaultFileName: "WBSTemplate.xlsx",
                    onSuccess: function (result) {
                        if (!WBSExcelDownloadBlobResult(result)) {

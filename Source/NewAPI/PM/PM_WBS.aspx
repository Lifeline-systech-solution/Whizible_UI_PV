                    if (strHTML == "") {
                        $("#wbsPhaseHistorytbl tbody tr td").prop("colspan", 6);
                    }


                },
                error: function (err) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
        }

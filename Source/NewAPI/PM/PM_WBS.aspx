        //Added By Vyankat B. on 06-07-2026 for WBS Excel Upload - common W26 API ajax helper (JSON, blob with async callback, and FormData)
        function buildW26Url(url) {
            if (strUrlW26.endsWith('/') && url.startsWith('/')) {
                return strUrlW26 + url.substring(1);
            } else if (strUrlW26.endsWith('/') && !url.startsWith('/')) {
                return strUrlW26 + url;
            } else if (!strUrlW26.endsWith('/') && url.startsWith('/')) {
                return strUrlW26 + url;
            } else {
                return strUrlW26 + '/' + url;
            }
        }

        function normalizeW26ApiResponse(data) {
            if (typeof normalizeApiResponse === "function") {
                var normalized = normalizeApiResponse(data);
                if (normalized && typeof normalized === "object" && !normalized.raw) {
                    normalized.raw = data;
                }
                return normalized;
            }
            return {
                raw: data,
                list: []
            };
        }

        function AJAXCallWithResultNew(url, param, async, options) {
            var result = null;
            var fullUrl = buildW26Url(url);
            var type = "POST";
            options = options || {};
            var isFormData = options.isFormData === true;
            var responseType = options.responseType || "json";
            var isBlobRequest = responseType === "blob";
            if (isBlobRequest) {
                async = true;
            }
            var ajaxOptions = {
                url: encodeURI(fullUrl),
                type: type,
                data: param,
                async: async,
                contentType: isFormData ? false : ((type === "GET") ? "application/x-www-form-urlencoded" : "application/json;charset=utf-8"),
                processData: !isFormData,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token_W26API"));
                    if (param && !isFormData) {
                        xhr.setRequestHeader("Params", encryptString(isJson(param) ? param : JSON.stringify(param)));
                    }
                },
                success: function (data, textStatus, jqXHR) {
                    if (isBlobRequest) {
                        var disposition = jqXHR.getResponseHeader("Content-Disposition");
                        var fileName = options.defaultFileName || "Download.xlsx";
                        if (disposition && disposition.indexOf("filename=") !== -1) {
                            var matches = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/.exec(disposition);
                            if (matches != null && matches[1]) {
                                fileName = matches[1].replace(/['"]/g, "");
                            }
                        }
                        result = {
                            blob: data,
                            fileName: fileName,
                            xhr: jqXHR
                        };
                    } else {
                        result = normalizeW26ApiResponse(data);
                    }
                    console.log('AJAX Success for ' + url + ':', data);
                    if (typeof options.onSuccess === "function") {
                        options.onSuccess(result);
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.error('AJAX Error for ' + url + ':', {
                        status: jqXHR.status,
                        statusText: jqXHR.statusText,
                        textStatus: textStatus,
                        errorThrown: errorThrown,
                        responseText: jqXHR.responseText
                    });
                    result = null;
                    if (typeof options.onError === "function") {
                        options.onError(jqXHR, textStatus, errorThrown);
                    }
                },
                complete: function () {
                    if (typeof options.onComplete === "function") {
                        options.onComplete();
                    }
                }
            };

            if (isBlobRequest) {
                ajaxOptions.xhrFields = { responseType: "blob" };
            } else {
                ajaxOptions.dataType = "json";
            }

            $.ajax(ajaxOptions);
            return isBlobRequest ? null : result;
        }

        function WBSExcelGetApiResponse(result) {
            if (!result) {
                return null;
            }
            return result.raw ? result.raw : result;
        }

        function WBSExcelDownloadBlobResult(blobResult, mimeType) {
            if (!blobResult || !blobResult.blob) {
                return false;
            }

            var blob = new Blob([blobResult.blob], { type: mimeType || "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
            var url = window.URL.createObjectURL(blob);
            var tempLink = document.createElement("a");
            tempLink.href = url;
            tempLink.download = blobResult.fileName || "Download.xlsx";
            document.body.appendChild(tempLink);
            tempLink.click();
            document.body.removeChild(tempLink);
            window.URL.revokeObjectURL(url);
            return true;
        }

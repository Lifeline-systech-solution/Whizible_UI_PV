                            QueryText += " > '" + ModuleFilterText + "'";
                        }
                    }
                    else if (ModuleFilterOperator == ">=") {
                        if (QueryText != "") {
                            QueryText += " AND " + AllFields[i] + "";
                            QueryText += " >= ''" + ModuleFilterText + "''";
                        }
                        else {

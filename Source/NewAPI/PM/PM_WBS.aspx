        function GetCombovalues(SQL, CmboName) {
            // 
            if (SQL != "" && SQL != undefined) {
                SQL = SQL.replace("<PROJECT_ID>", WBSProjectId)
                SQL = SQL.replace("<UNIQUE_ID>", "NULL")
            }
            var WBSParameters = {
                SQL: SQL,

            };
            if (SQL != "" && SQL != undefined) {
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_WBS/GetCombovalues',
                    method: 'Post',
                    data: JSON.stringify(WBSParameters),
                    dataType: 'json',
                    async: false,
                    contentType: "application/json",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (WBSParameters) {
                            xhr.setRequestHeader("Params", encryptString(isJson(WBSParameters) ? WBSParameters : JSON.stringify(WBSParameters)));
                        }
                    },
                    success: function (strResult) {
                        if (strResult != "") {


                            // var objCbo1 = document.getElementById(CmboName + "" + CmboName);
                            // $("#" + CmboName +"option").remove();
                            //  var objOption1 = document.createElement("OPTION");
                            // //objCbo1.options.add(objOption1, 0);
                            ////objCbo1.selectedIndex = 0;
                            // for (var i = 0; i < result.length; i++) {
                            //    ;
                            //     var Objresult = result[i];
                            //    // var objOption = document.createElement("OPTION");
                            //     objCbo1.options.add(objOption1);
                            //     objOption1.value = Objresult.ControlID;
                            //     objOption1.text = Objresult.ControlValue;

                            // }
                            var objCbo1 = document.getElementById(CmboName);

                            $("#" + CmboName + " option").remove();
                            // alert(CmboName);
                            //Added By Dipali V On 22nd April 2020 For IssueID 23257
                            if (CmboName == "projectsiteid") {

                                AppendOptioncbo(CmboName, "Site");
                            }
                            if (CmboName == "deliverablesizeunitid") {

                                AppendOptioncbo(CmboName, "Deliverable Size Unit");
                            }//End of Added By Dipali V On 22nd April 2020 For IssueID 23257

                            for (var i = 0; i < strResult.length; i++) {
                                var Objresult = strResult[i];
                                var objOption = document.createElement("OPTION");
                                objCbo1.options.add(objOption);

                                objOption.value = Objresult.ControlID;
                                objOption.text = Objresult.ControlValue == 0 ? '' : Objresult.ControlValue;

                            }



                        }
                        $('select option')
                            .filter(function () {
                                return !this.value || $.trim(this.value).length == 0 || $.trim(this.text).length == 0;
                            })
                            .remove();
                    },

                    error: function (err) {
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });

            } else {
                //;
                //Added By Dipali V On 22nd April 2020 For IssueID 23257
                if (CmboName == "projectsiteid") {

                    AppendOptioncbo(CmboName, "Site");
                }
                if (CmboName == "deliverablesizeunitid") {

                    AppendOptioncbo(CmboName, "Deliverable Size Unit");
                }//End of Added By Dipali V On 22nd April 2020 For IssueID 23257
            }
        }




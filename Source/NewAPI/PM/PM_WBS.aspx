        //End of Added By Vyankat B. on 06-07-2026 for WBS Excel template download via AJAXCallWithResultNew

        function WBSExcelUploadBtn() {
            WBSExcelUploadFile();
        }

        function WBSExcelFormatErrorMessage(errMsg) {
            if (!errMsg) return "";
            return String(errMsg).replace(/^[A-Za-z0-9]+\$/, "").trim();
        }

        function WBSExcelSplitErrorMessages(errMsg) {
            var clean = WBSExcelFormatErrorMessage(errMsg);
            if (!clean) return [];
            return clean.split(" | ").filter(function (item) { return item && item.trim() !== ""; });
        }

        function WBSExcelSortErrorMessages(list) {
            return list.slice().sort(function (a, b) {
                var rowA = parseInt((String(a).match(/^Row\s+(\d+)\s*:/i) || [])[1], 10);
                var rowB = parseInt((String(b).match(/^Row\s+(\d+)\s*:/i) || [])[1], 10);
                if (isNaN(rowA) && isNaN(rowB)) return 0;
                if (isNaN(rowA)) return 1;
                if (isNaN(rowB)) return -1;
                return rowA - rowB;
            });
        }

        function WBSExcelShowErrors(messages) {
            alertify.set("notifier", "position", "top-right");
            var list = [];
            if (Array.isArray(messages)) {
                list = messages;
            } else if (messages) {
                list = WBSExcelSplitErrorMessages(messages);
                if (list.length === 0) {
                    list = [String(messages).trim()];
                }
            }
            list = list.filter(function (msg) { return msg && String(msg).trim() !== ""; });
            if (list.length === 0) return;

            list = WBSExcelSortErrorMessages(list);
            var combinedMessage = list.join("<br/>");
            var displaySeconds = Math.max(8, list.length * 4);
            alertify.error(combinedMessage, displaySeconds);
        }

        function WBSExcelGetRowErrorMessages(rows) {
            var messages = [];
            if (!rows || rows.length === 0) return messages;
            var failedRows = [];
            $.each(rows, function (_, row) {
                var isValid = row.isValid || row.IsValid || 0;
                if (isValid === 1) return;
                failedRows.push(row);
            });
            failedRows.sort(function (a, b) {
                var rowA = parseInt(a.rowNumber || a.RowNumber || 0, 10);
                var rowB = parseInt(b.rowNumber || b.RowNumber || 0, 10);
                return rowA - rowB;
            });
            $.each(failedRows, function (_, row) {
                var rowNo = row.rowNumber || row.RowNumber || "";
                var rowError = row.errorMessage || row.ErrorMessage || "";
                if (!rowError) return;
                var prefix = rowNo ? ("Row " + rowNo + ": ") : "";
                messages.push(prefix + rowError);
            });
            return messages;
        }

        //Added By Vyankat Bhure on 08-07-2026 — show valid API dates as DD MMM YYYY;
        // keep invalid Excel text as-is (do not use new Date on MM-DD like 01-13-2026);
        // for invalid rows (IsValid=0) never convert — show value exactly as returned by API/DB
        function WBSExcelFormatDisplayDate(dateValue, isValid) {
            if (!dateValue) return "";
            var str = String(dateValue).trim();
            if (!str) return "";

            // Invalid row: always show stored text (e.g. 01-13-2026), never convert to 13 Jan
            if (isValid === 0 || isValid === "0") {
                return str;
            }

            if (/^\d{1,2}\s+[A-Za-z]{3}\s+\d{4}/.test(str)) {
                return str;
            }

            // Only format known-valid API values (yyyy-MM-dd). Raw/invalid Excel text stays unchanged.
            if (/^\d{4}-\d{2}-\d{2}$/.test(str)) {
                var parts = str.split("-");
                var parsed = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
                if (!isNaN(parsed.getTime())) {
                    var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    var day = ("0" + parsed.getDate()).slice(-2);
                    var month = months[parsed.getMonth()];
                    var year = parsed.getFullYear();
                    return day + " " + month + " " + year;
                }
            }

            return str;
        }
        //End of Added By Vyankat Bhure on 08-07-2026 — show valid API dates as DD MMM YYYY; keep invalid Excel text as-is

        function WBSExcelIsFatalUploadError(errMsg) {
            if (!errMsg) return false;
            var arrData = String(errMsg).split("$");
            if (arrData[0] === "D") return true;
            return arrData.some(function (item) {
                var lower = (item || "").toLowerCase();
                return lower.indexOf("invalid template") >= 0
                    || lower.indexOf("excel is empty") >= 0
                    || lower.indexOf("worksheet not found") >= 0
                    || lower.indexOf("maximum 100 records") >= 0
                    || lower.indexOf("can be uploaded in a single file") >= 0;
            });
        }

        //Added By Vyankat Bhure on 08-07-2026 — detect max-100-records so list is not refreshed
        function WBSExcelIsMaxRecordsLimitError(errMsg) {
            if (!errMsg) return false;
            var lower = String(errMsg).toLowerCase();
            return lower.indexOf("maximum 100 records") >= 0
                || lower.indexOf("can be uploaded in a single file") >= 0;
        }
        //End of Added By Vyankat Bhure on 08-07-2026 — detect max-100-records so list is not refreshed

        function WBSExcelHandleUploadResponse(result) {
            alertify.set("notifier", "position", "top-right");
            if (!result) {
                alertify.error(WBSExcelRes.uploadFailed);
                return false;
            }

            var errMsg = result.errorMessages || result.ErrorMessages || result.message || result.Message || "";
            var totalRows = result.totalRows || result.TotalRows || 0;

            //Added By Vyankat Bhure on 08-07-2026 — show exact max-records alert; do not treat as list refresh
            if (WBSExcelIsMaxRecordsLimitError(errMsg)) {
                alertify.error(WBSExcelRes.maxRecordsLimit || "Maximum 100 records can be uploaded in a single file");
                return "MAX_RECORDS";
            }
            //End of Added By Vyankat Bhure on 08-07-2026 — show exact max-records alert; do not treat as list refresh

            if (WBSExcelIsFatalUploadError(errMsg)) {
                alertify.error(WBSExcelFormatErrorMessage(errMsg) || WBSExcelRes.uploadFailed);
                return false;
            }

            if (!errMsg && !totalRows && String(result.flag || result.Flag || "0") === "0") {
                alertify.error(WBSExcelRes.uploadFailed);
                return false;
            }

            alertify.success(WBSExcelRes.uploadSuccess);
            return true;
        }

        //Added By Vyankat B. on 06-07-2026 for WBS Excel file upload via AJAXCallWithResultNew
        function WBSExcelUploadFile() {
            //Added By Vyankat Bhure on 08-07-2026 for WBS Excel Upload role access (TagID 86168)
            if (!hasWBSExcelAddAccess) return;
            //End of Added By Vyankat Bhure on 08-07-2026 for WBS Excel Upload role access (TagID 86168)
            var projectId = WBSExcelValidateProjectSelection();
            if (!projectId) return;

            var fileInput = document.getElementById("wbs-excel-file-upload");
            var fileName = document.getElementById("wbs-excel-file-name");
            var uploadBtn = document.getElementById("wbs-excel-upload-btn");
            if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                alertify.set("notifier", "position", "top-right");
                alertify.error(WBSExcelRes.selectFileToUpload);
                return;
            }

            StartLoader("#WBSBody");
            var formData = new FormData();
            formData.append("ProjectID", projectId);
            formData.append("UploadedFile", fileInput.files[0]);
            formData.append("UserName", UserName);
            formData.append("intEmployeeID", UserID);

            var ajaxResult = AJAXCallWithResultNew("api/PM_WBS_ExcelUpload/WBSExcelUpload", formData, false, { isFormData: true });
            StopAjaxLoader("#WBSBody");

            if (!ajaxResult) {
                alertify.set("notifier", "position", "top-right");
                alertify.error(WBSExcelRes.uploadFailed);
                return;
            }

            var result = WBSExcelGetApiResponse(ajaxResult);
            var uploaded = WBSExcelHandleUploadResponse(result);
            if (uploadBtn) {
                uploadBtn.disabled = true;
                uploadBtn.textContent = WBSExcelRes.upload;
            }
            if (fileInput) fileInput.value = "";
            if (fileName) fileName.textContent = WBSExcelRes.noFileChosen;
            //Added By Vyankat Bhure on 08-07-2026 — max records: alert only, do not add to Uploaded File Details list
            if (uploaded === "MAX_RECORDS") {
                return;
            }
            //End of Added By Vyankat Bhure on 08-07-2026 — max records: alert only, do not add to Uploaded File Details list
            if (uploaded) {
                wbsExcelUploadCurrentPage = 1;
                GetWBSExcelUploadRequestDetails(wbsExcelUploadCurrentPage, wbsExcelUploadPageSize);
                if (typeof GetMilestoneList === "function") {
                    GetMilestoneList(null);
                }
            } else if (result && (result.errorMessages || result.ErrorMessages)) {
                wbsExcelUploadCurrentPage = 1;
                GetWBSExcelUploadRequestDetails(wbsExcelUploadCurrentPage, wbsExcelUploadPageSize);
            }
        }

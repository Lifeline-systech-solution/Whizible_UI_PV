        //function for Sum of bill amount validation
        function BillAmountValidation() {
            NewMilestoneID = NewMilestoneID.toString().replace(/ /g, '');
            try {
                var WBSParameters = {

                    ProjectID: encodeURI(WBSProjectId),
                    MilestoneID: encodeURI(NewMilestoneID)
                }
                var Flag = true;
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_WBS/GetSumOfBillAmount',
                    type: "POST",
                    data: JSON.stringify(WBSParameters),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (WBSParameters) {
                            xhr.setRequestHeader("Params", encryptString(isJson(WBSParameters) ? WBSParameters : JSON.stringify(WBSParameters)));
                        }
                    },
                    success: function (strResult) {
                        if (strResult != undefined) {
                            //  ;
                            var dblSumBillAmt = parseFloat(strResult[0]);
                            var dblProjectValue = parseFloat(strResult[1]);
                            var dblCurMilestBillAmt = parseFloat(document.getElementById("txtMLBillAmount").value);

                            var BillAmount = dblProjectValue - dblSumBillAmt;
                            //alert(dblSumBillAmt);
                            // alert(BillAmount);
                            // alert(dblProjectValue);
                            /// alert(dblCurMilestBillAmt);
                            if (dblCurMilestBillAmt != 0) {
                                if (dblCurMilestBillAmt > BillAmount) {
                                    Flag = false;
                                }
                                else {
                                    Flag = true;
                                }
                            }
                        }
                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
                return Flag;
            }
            catch (ex) {
                //alert(ex.message);
            }
        }

        //function for completion percentage validation
        function CompletionPercentageValidation() {
            //alert(NewMilestoneID);
            //;
            NewMilestoneID = NewMilestoneID.toString().replace(/ /g, '');
            //alert(NewMilestoneID);
            try {
                var WBSParameters = {

                    ProjectID: encodeURI(WBSProjectId),
                    MilestoneID: encodeURI(NewMilestoneID)
                }
                var Flag = true;
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_WBS/GetSumOfCompletionPercentage',
                    type: "POST",
                    data: JSON.stringify(WBSParameters),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (WBSParameters) {
                            xhr.setRequestHeader("Params", encryptString(isJson(WBSParameters) ? WBSParameters : JSON.stringify(WBSParameters)));
                        }
                    },
                    success: function (strResult) {
                        // alert(NewMilestoneID);
                        // alert(WBSProjectId);
                        // ;
                        var SumCompletionPercentage = strResult;
                        // alert(SumCompletionPercentage);
                        SumCompletionPercentage = (SumCompletionPercentage == '' || isNaN(SumCompletionPercentage)) ? 0 : SumCompletionPercentage;
                        var CurCompletionPercentage = parseFloat(document.getElementById("txtMLCompletionPercentage").value);
                        CurCompletionPercentage = (CurCompletionPercentage == '' || isNaN(CurCompletionPercentage)) ? 0 : CurCompletionPercentage;
                        var CompPercentage = 100 - SumCompletionPercentage;
                        if (CurCompletionPercentage > CompPercentage) {
                            alertify.error("Sum of Completion Percentage of All Milestones Should Be Less Than '100%'.");
                            document.getElementById("txtMLCompletionPercentage").focus();
                            Flag = false;
                        }
                        else {
                            Flag = true;
                        }
                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
                return Flag;
            }
            catch (ex) {
                //alert(ex.message);
            }
        }



        //Added By Vyankat B. on 02-07-2026 for WBS Excel Uploaded File Details list
        function GetWBSExcelUploadRequestDetails(pageNumber, pageSize) {
            var projectId = GetWBSExcelSelectedProjectId();
            if (!projectId || projectId === "0" || projectId === 0) {
                $("#wbsUploadedfilesBody").html('<tr><td colspan="5" class="text-center">' + WBSExcelRes.selectProject + '</td></tr>');
                $("#paginationControls").hide();

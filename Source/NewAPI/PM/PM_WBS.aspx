                        if (Delete != 1) {
                            $("#MLtabMilestone .delete").hide();
                        }
                        if (Edit != 1) {
                            $("#MLtabMilestone .edit").hide();
                        }
                    }
                },
                error: function (err) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""

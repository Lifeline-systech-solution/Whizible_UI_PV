        //*****Start Functionality for milestone deta *****//
        //Get Responsible Person List
        function MLResponsiblePerson(WBSProjectId) {
            var WBSParameters = {
                ProjectID: encodeURI(WBSProjectId)
            }
            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_WBS/GetMLResponsiblePerson',
                type: "POST",
                data: JSON.stringify(WBSParameters),
                dataType: "json",
                async: false,
                contentType: "application/json;charset-utf=8",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (WBSParameters) {
                        xhr.setRequestHeader("Params", encryptString(isJson(WBSParameters) ? WBSParameters : JSON.stringify(WBSParameters)));
                    }
                },
                success: function (strResult) {

                    if (strResult != "") {
                        var objCbo1 = document.getElementById("txtMLResponsiblePerson");
                        var objCbo2 = document.getElementById("txtMLFilterResponsiblePerson");

                        $("#txtMLFilterResponsiblePerson option").remove();
                        $("#txtMLResponsiblePerson option").remove();


                        var objOption1 = document.createElement("OPTION");
                        var objOption2 = document.createElement("OPTION");



                        for (var i = 0; i < strResult.length; i++) {
                            var Objresult = strResult[i];
                            var objOption1 = document.createElement("OPTION");
                            var objOption2 = document.createElement("OPTION");

                            objCbo1.options.add(objOption1);
                            objCbo2.options.add(objOption2);

                            objOption2.text = Objresult.EmployeeName;
                            objOption2.value = Objresult.EmployeeID == 0 ? '' : Objresult.EmployeeID;

                            objOption1.text = Objresult.EmployeeName;
                            objOption1.value = Objresult.EmployeeID == 0 ? '' : Objresult.EmployeeID;

                        }

                    }
                },
                error: function (err) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
        }


        //Get Responsible Person for Milestone in Edit Mode

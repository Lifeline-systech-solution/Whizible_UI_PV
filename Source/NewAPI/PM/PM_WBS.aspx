        // Getting QueryText From Perticular FilterID
        function SubProjectApplyCheckFilter(ApplyID) {
            var FilterID = ApplyID.replace("Apply", "");
            if (FilterID != undefined) {
                WBSParameters = {
                    FilterID: encodeURI(FilterID),
                }
                $.ajax({
                    url: strUrl + '/api/PM_WBS/GetWhereClauseFilter',
                    type: "POST",
                    data: JSON.stringify(WBSParameters),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (WBSParameters) {
                            xhr.setRequestHeader("Params", encryptString(isJson(WBSParameters) ? WBSParameters : JSON.stringify(WBSParameters)));
                        }
                    },
                    success: function (result) {
                        //
                        $(FilterID).attr("checked");

                        var QueryText = result;
                        if (QueryText != null) {
                            QueryText = QueryText.toString().replace(/'/g, "''");
                        }
                        SubprojectQueryText = QueryText;
                        GetSubProjectList(QueryText);
                        selectedqid=FilterID;
                        var sibling = $('label[id^="Apply"]')
                        //console.log(sibling);
                        if ($("#" + ApplyID).parent().find("input").prop("checked") == true) {

                            $("#" + ApplyID).parent().find("input").prop("checked", true);
                            $("#" + ApplyID).removeAttr("data-bs-original-title", "");
                            $("#" + ApplyID).attr("data-bs-original-title", "Applied Filter");
                            //alert("Checkbox is checked.");
                        }
                        else if ($("#" + ApplyID).parent().find("input").prop("checked") == false) {
                            $(sibling).each(function () {
                                var id = this.id;
                                if (ApplyID == this.id) {
                                    $("#" + id).parent().find("input").prop("checked", true);
                                    $("#" + ApplyID).removeAttr("data-bs-original-title", "");
                                    $("#" + ApplyID).attr("data-bs-original-title", "Applied Filter");
                                }
                                else {
                                    $("#" + id).parent().find("input").prop("checked", false);
                                    $("#" + ApplyID).removeAttr("data-bs-original-title", "");
                                    $("#" + ApplyID).attr("data-bs-original-title", "Applied Filter");
                                }
                            });
                        }
                        // Added By RehanC on 4th May 2023
                        $("#SubProjectFilter .fa-filter").css("color", "#ffffff");
                        $("#SubProjectFilter").css("background", "#1359a6");
                        //End of Comment By RehanC on 4th May 2023
                        $("#SubProjectClearAllFilter").show();
                        $("#SubProjectClearAllFilter").css({ 'display': 'inline-block', 'float': 'right', 'margin': '-46px 33px 0' });
                        $("#SubProjectClearAllFilter").insertAfter("#MLsubProject .filter");
                        GlobalApplyID = "Apply" + FilterID;
                        $('#presetfilterSP').removeClass("active");
                        $('.filterpanel .cust_tabpanel li').removeClass("active");
                        $(".cust_tabpanel .keep-inside-clicks-open .dropdown-menu").removeClass("show");
                        // $(".filter").addClass("active");
                        $("#DivSubProjectFilter").addClass("active");

                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
            }
        }

        //To clear the applied filter arrow after click on clear filter button

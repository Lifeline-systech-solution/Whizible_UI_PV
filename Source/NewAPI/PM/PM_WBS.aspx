        //To check the validation for the WBS fields       
        function WBSFieldValidation() {

            var checkval = 0;
            for (var i = 0; i < ValidationControlname.length; i++) {

                for (var j = 0; j < ControlValidationRules[i].length; j++) {
                    var validationRule = ControlValidationRules[i][j];
                    switch (validationRule) {

                        case "1":
                            //For Blank                            
                            if ($(ControlValidationFieldID[i]).val() == "" && $(ControlValidationFieldID[i]).val() != undefined) {
                                checkval = 1;
                                alertify.error(ValidationControlCaption[i] + " Should Not Be Left Blank.");
                                $(ControlValidationFieldID[i]).focus()
                                return checkval;
                            }
                            else {
                                if (ValidationControlCaption[i] == "Work (H:M)") {
                                    var result = WorkHoursValidation(ControlValidationFieldID[i]);
                                    if (result == true) {
                                        checkval = 0;
                                    }
                                    else {
                                        checkval = 1;
                                    }
                                    return checkval;
                                }
                            }
                            break;

                        //For validate Date
                        case "2":
                            if ($(ControlValidationFieldID[i]).val() != "") {
                                if (!isDate($(ControlValidationFieldID[i]).val())) {
                                    checkval = 1;
                                    alertify.error(ValidationControlCaption[i] + " The Date You Have Entered Is Invalid !!!");
                                    $(ControlValidationFieldID[i]).focus()
                                    return checkval;
                                }
                            };
                            break;

                        //For  Number
                        case "3":
                            if ($(ControlValidationFieldID[i]).val() != "") {
                                if (!jQuery.isNumeric($(ControlValidationFieldID[i]).val())) {
                                    checkval = 1;
                                    alertify.error(ValidationControlCaption[i] + " Please Enter Only  Numeric Values !!!");
                                    $(ControlValidationFieldID[i]).focus()
                                    return checkval;
                                }
                            };
                            break;


                        case "9"://for Alphabets
                            if ($(ControlValidationFieldID[i]).val() != "") {
                                var Controlvalue = $(ControlValidationFieldID[i]).val();
                                if (Controlvalue != "") {
                                    var pattern = /^[a-zA-Z]+$/;
                                    if (!pattern.test(Controlvalue)) {
                                        checkval = 1;
                                        alertify.error(ValidationControlCaption[i] + " Please Enter Only Alphabets (A-Z, a-z) !!!");
                                        $(ControlValidationFieldID[i]).focus()
                                        return checkval;
                                    }
                                }
                            };
                            break;

                        case "12": //For Maxlength 
                            if ($(ControlValidationFieldID[i]).val() != "") {

                                if ((ControlMaxLength[i]) > 0) {
                                    if ($(ControlValidationFieldID[i]).val().length > ControlMaxLength[i]) {
                                        var length = $(ControlValidationFieldID[i]).val().length;
                                        checkval = 1;
                                        alertify.error(ValidationControlCaption[i] + " Max Length Is " + ControlMaxLength[i] + " Characters.You Have Entered " + length + " Characters.");
                                        $(ControlValidationFieldID[i]).focus()
                                        return checkval;
                                    }
                                }
                            };
                            break;

                        case "13":
                            //For Positive Number
                            if ($(ControlValidationFieldID[i]).val() < 0) {
                                checkval = 1;
                                alertify.error("Please Enter Only Positive Numeric Value For " + ValidationControlCaption[i]);
                                $(ControlValidationFieldID[i]).focus()
                                return checkval;
                            };
                            break;

                        case "14":
                            //For Duplicate

                            if ($(ControlValidationFieldID[i]).val() != "") {
                                var value = $(ControlValidationFieldID[i]).val();
                                if (ControlValidationSQLQuery[i] != "") {

                                    var Query = ControlValidationSQLQuery[i];
                                    // var Query = "SELECT Phase FROM v_tbl_IB_Project_Phases";
                                    if (ControlValidationSQLQuery[i].indexOf("FROM") > -1) {
                                        var commonColumnName = " As ExistingNames ";
                                        var index = Query.indexOf(" FROM ");  // Gets the first index where a space occours
                                        var Query1 = Query.substr(0, index); // Gets the first part
                                        var Query2 = Query.substr(index + 1);  // Gets the text part

                                        Query1 = Query1.concat(commonColumnName);
                                        Query1 = Query1.concat(Query2);
                                    }

                                    var FinalQuery = Query1 + " Where ProjectID =" + WBSProjectId;
                                    var ExistingNames = GetExistingNames(FinalQuery);
                                    for (var k = 0; k < ExistingNames.length; k++) {
                                        var ExistingName = ExistingNames[k].ExistingNames;
                                        if (value.toString().trim() == ExistingName.toString().trim()) {
                                            checkval = 1;
                                            alertify.error(ValidationControlCaption[i] + " Already Exists.");
                                            $(ControlValidationFieldID[i]).focus()
                                            return checkval;
                                        }
                                    }
                                }
                            }

                            break;

                        case "15":     //For Special Char
                            if ($(ControlValidationFieldID[i]).val() != "" && $(ControlValidationFieldID[i]).val() != undefined) {

                                var Controlvalue = $(ControlValidationFieldID[i]).val();
                                if (checkSpecialCharacter(Controlvalue) == true) {
                                    checkval = 1;
                                    alertify.error(ValidationControlCaption[i] + " Cannot Contain Any of These /\\:*?<>|,+- Characters.");
                                    $(ControlValidationFieldID[i]).focus()
                                    return checkval;
                                }
                            };
                            break;

                        case "16": //For  Minimum Value Check
                            if ($(ControlValidationFieldID[i]).val() != "") {
                                if ($(ControlValidationFieldID[i]).attr("MinValue")) {
                                    if ($(ControlValidationFieldID[i]).val().length < $(ControlValidationFieldID[i]).attr("maxlength") && $(ControlValidationFieldID[i]).val() != $(ControlValidationFieldID[i]).attr("MinValue")) {
                                        checkval = 1;
                                        alertify.error(ValidationControlCaption[i] + " The Value of <ID> Should Not Be Less Than <VALUE>.");
                                        $(ControlValidationFieldID[i]).focus()
                                        return checkval;
                                    }
                                }
                            }
                            break;

                        case "17"://For  Maximum Value Check
                            if ($(ControlValidationFieldID[i]).val() != "") {
                                if ($(ControlValidationFieldID[i]).attr("MaxValue")) {
                                    if ($(ControlValidationFieldID[i]).val().length >= $(ControlValidationFieldID[i]).attr("MaxValue") && $(ControlValidationFieldID[i]).val() != $(ControlValidationFieldID[i]).attr("MaxValue")) {
                                        checkval = 1;
                                        alertify.error(ValidationControlCaption[i] + " The Value Of <ID> Should Not Be Greater Than <VALUE>.");
                                        $(ControlValidationFieldID[i]).focus()
                                        return checkval;
                                    }
                                }
                            }
                            break;

                        case "18":  //For  Value Range
                            if ($(ControlValidationFieldID[i]).val() != "") {
                                if (ControlValidationFieldID[i].indexOf("cbo") != -1) {
                                    var Condition = $(ControlValidationFieldID[i]).text() <= $(ControlValidationFieldID[i]).attr("MinValue") && $(ControlValidationFieldID[i]).text() >= $(ControlValidationFieldID[i]).attr("MaxValue")
                                }
                                else {
                                    var Condition = $(ControlValidationFieldID[i]).val() <= $(ControlValidationFieldID[i]).attr("MinValue") && $(ControlValidationFieldID[i]).val() >= $(ControlValidationFieldID[i]).attr("MaxValue")
                                }
                                if ($(ControlValidationFieldID[i]).attr("range")) {
                                    if (Condition == false) {
                                        checkval = 1;
                                        alertify.error(ValidationControlCaption[i] + " The value of <ID> should be in the range of (<RANGE>).");
                                        $(ControlValidationFieldID[i]).focus()
                                        return checkval;
                                    }
                                }
                            }
                            break;

                        case "19"://for only integers
                            if ($(ControlValidationFieldID[i]).val() != "") {
                                var Controlvalue = $(ControlValidationFieldID[i]).val();
                                if (Controlvalue != "") {
                                    //var pattern = /^[a-zA-Z]+$/;
                                    if ($.isNumeric(Controlvalue)) {
                                        checkval = 1;
                                        alertify.error(ValidationControlCaption[i] + " Please enter only integer value");
                                        $(ControlValidationFieldID[i]).focus()
                                        return checkval;
                                    }
                                }
                            };
                            break;

                        case "20":     //For Only Positive Integers
                            if ($(ControlValidationFieldID[i]).val() != "") {
                                var regex = /^[0-9]+$/;
                                var Controlvalue = $(ControlValidationFieldID[i]).val();
                                if (regex.test(Controlvalue) == false) {
                                    checkval = 1;
                                    alertify.error(ValidationControlCaption[i] + " Please enter only positive Integer");
                                    $(ControlValidationFieldID[i]).focus()
                                    return checkval;
                                }
                            };
                            break;
                    }
                }
            }
            return checkval;
        }

        //Function to check the special character on string
        function checkSpecialCharacter(value) {
            var regularExpression = '{}|`~[]<>\!"@#$%^&*()_+-=/';
            var isSpecialCharacter = 0;
            for (var i = 0; i < regularExpression.length; i++) {
                if (value.indexOf(regularExpression[i]) != -1) {
                    isSpecialCharacter = 1
                }
            }
            if (isSpecialCharacter == 1) {
                return true;
            }
            else {
                return false;
            }
        }


        function GetProjectList() {
            var sessionproj = 0;
            sessionproj = selectedProjectID;
            if (selectedProjectID == "") {
                sessionproj = 0;
            }


            var WBSParameters = {
                UserID: encodeURI('<%= Session("intUserID") %>'),
                ProjectID: encodeURI(sessionproj),
                LoginType: encodeURI('<%= Session("LoginType") %>')

            }

            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_WBS/GetProjectList',
                method: 'Post',
                data: JSON.stringify(WBSParameters),
                dataType: 'json',
                async: false,
                contentType: "application/json",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (WBSParameters) {
                        xhr.setRequestHeader("Params", encryptString(isJson(WBSParameters) ? WBSParameters : JSON.stringify(WBSParameters)));
                    }
                },
                success: function (result) {
                    //StartLoader("#WBSBody");
                    if (result != "") {
                        
                        var objCbo1 = document.getElementById("cboWBSProjects");
                        $("#cboWBSProjects option").remove();


                        var objOption = document.createElement("OPTION");
                        objCbo1.options.add(objOption, 0);
                        objCbo1.selectedIndex = 0;


                        for (var i = 0; i < result.length; i++) {

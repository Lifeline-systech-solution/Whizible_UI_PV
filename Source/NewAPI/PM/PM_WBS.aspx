        //Edit filter functionality on Milestone tab
        var isEditActive = 0;
        function EditMilestoneFilter(MLEditID) {
            // ;
            isEditActive = 1;
            Flag = 1;
            FilterID = MLEditID.replace("MLEdit", "");
            GlobalFilterID = FilterID;
            GlobalFilterFlag = 1;
            $(".stackbasicfilter").addClass("active");
            $(".cust_tabpanel .keep-inside-clicks-open .dropdown-menu").removeClass("show");
            $('ul#MilestoneBasicFilter li a:last').parents('li').addClass('active');

            if (FilterID != undefined) {
                WBSParameters = {
                    FilterID: encodeURI(FilterID),
                }
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_WBS/MilestoneEditFilter',
                    type: "POST",
                    data: JSON.stringify(WBSParameters),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (WBSParameters) {
                            xhr.setRequestHeader("Params", encryptString(isJson(WBSParameters) ? WBSParameters : JSON.stringify(WBSParameters)));
                        }
                    },
                    success: function (strResult) {
                        clearAllBasicFilterValues();
                        if (strResult != undefined) {
                            var FilterID = strResult.FilterID;
                            GlobalFilterName = strResult.FilterName;
                            var QueryText = strResult.QueryText;
                            var MlQueryText = QueryText.split("AND");

                            for (var j = 0; j < MlQueryText.length; j++) {
                                var mlQuery = MlQueryText[j];
                                mlQuery = $.trim(mlQuery);

                                if (mlQuery.indexOf('MileStone') > -1) {
                                    if (mlQuery.indexOf('NOT LIKE') > -1) {
                                        $("select#cboMLFilterMilestone option:contains('Not Contains')").attr('selected', 'selected');
                                        mlQuery = mlQuery.split('NOT LIKE')[1]; //Splits the string after NOT LIKE comes
                                        mlQuery = $.trim(mlQuery); //Removes starting and ending whitespaces
                                        mlQuery = mlQuery.replace(/%/g, ""); //Removes % sign
                                        mlQuery = mlQuery.replace(/'/g, ""); //Removes single quotes
                                        $('#txtMLFilterMileStone').val(mlQuery);
                                    }

                                    if (mlQuery.indexOf('=') > -1) {
                                        $("select#cboMLFilterMileStone option:contains('Exact Word')").attr('selected', 'selected');
                                        mlQuery = mlQuery.split('=')[1];
                                        mlQuery = $.trim(mlQuery);
                                        mlQuery = mlQuery.replace(/'/g, "");
                                        $('#txtMLFilterMileStone').val(mlQuery);
                                    }

                                    if (mlQuery.indexOf('LIKE') > -1) {
                                        mlQuery = mlQuery.split('LIKE')[1];
                                        mlQuery = $.trim(mlQuery);
                                        mlQuery = mlQuery.replace(/'/g, "");

                                        if (mlQuery.charAt(0) == '%' && mlQuery[mlQuery.length - 1] == '%') {
                                            $("#cboMLFilterMileStone option[value=Contains]").prop('selected', true);
                                            //$("select#cboSubProjectOperator option:contains('Contains')").attr('selected', 'selected');
                                            mlQuery = mlQuery.replace(/%/g, "");
                                            $('#txtMLFilterMileStone').val(mlQuery);
                                        }
                                        else if (mlQuery.charAt(0) == '%') {
                                            $("#cboMLFilterMileStone option[value='Ends With']").prop('selected', true);
                                            mlQuery = mlQuery.replace(/%/g, "");
                                            $('#txtMLFilterMileStone').val(mlQuery);
                                        }
                                        else if (mlQuery[mlQuery.length - 1] == '%') {
                                            $("#cboMLFilterMileStone option[value='Starts With']").prop('selected', true);
                                            mlQuery = mlQuery.replace(/%/g, "");
                                            $('#txtMLFilterMileStone').val(mlQuery);
                                        }
                                    }
                                }

                                if (mlQuery.indexOf('Comments') > -1) {
                                    if (mlQuery.indexOf('NOT LIKE') > -1) {
                                        $("select#cboMLFilterComments option:contains('Not Contains')").attr('selected', 'selected');
                                        mlQuery = mlQuery.split('NOT LIKE')[1]; //Splits the string after NOT LIKE comes
                                        mlQuery = $.trim(mlQuery); //Removes starting and ending whitespaces
                                        mlQuery = mlQuery.replace(/%/g, ""); //Removes % sign
                                        mlQuery = mlQuery.replace(/'/g, ""); //Removes single quotes
                                        $('#txtMLFilterComments').val(mlQuery);
                                    }

                                    if (mlQuery.indexOf('=') > -1) {
                                        $("select#cboMLFilterComments option:contains('Exact Word')").attr('selected', 'selected');
                                        mlQuery = mlQuery.split('=')[1];
                                        mlQuery = $.trim(mlQuery);
                                        mlQuery = mlQuery.replace(/'/g, "");
                                        $('#txtMLFilterComments').val(mlQuery);
                                    }

                                    if (mlQuery.indexOf('LIKE') > -1) {
                                        mlQuery = mlQuery.split('LIKE')[1];
                                        mlQuery = $.trim(mlQuery);
                                        mlQuery = mlQuery.replace(/'/g, "");

                                        if (mlQuery.charAt(0) == '%' && mlQuery[mlQuery.length - 1] == '%') {
                                            $("#cboMLFilterComments option[value=Contains]").prop('selected', true);

                                            mlQuery = mlQuery.replace(/%/g, "");
                                            $('#txtMLFilterComments').val(mlQuery);
                                        }
                                        else if (mlQuery.charAt(0) == '%') {
                                            $("#cboMLFilterComments option[value='Ends With']").prop('selected', true);
                                            mlQuery = mlQuery.replace(/%/g, "");
                                            $('#txtMLFilterComments').val(mlQuery);
                                        }
                                        else if (mlQuery[mlQuery.length - 1] == '%') {
                                            $("#cboMLFilterComments option[value='Starts With']").prop('selected', true);
                                            mlQuery = mlQuery.replace(/%/g, "");
                                            $('#txtMLFilterComments').val(mlQuery);
                                        }
                                    }
                                }

                                if (mlQuery.indexOf('PlannedCompletionDate') > -1) {
                                    if (mlQuery.indexOf('<') != -1 || mlQuery.indexOf('>') != -1 || mlQuery.indexOf('=') != -1) {
                                        var gtpos = mlQuery.indexOf('<');
                                        var ltpos = mlQuery.indexOf('>');
                                        var eqpos = mlQuery.indexOf('=');
                                        var gtafterval = mlQuery.substring(gtpos + 1, gtpos + 2);
                                        var ltafterval = mlQuery.substring(ltpos + 1, ltpos + 2);
                                        if (gtafterval == ">" || gtafterval == "=" || ltafterval == "=") {
                                            if (gtafterval == ">" || gtafterval == "=") {
                                                var OpValue = "<" + gtafterval;
                                                var FieldValue = mlQuery.substring(mlQuery.indexOf(gtafterval) + 1);
                                                FieldValue = FieldValue.replace(/'/g, "");
                                                $('#txtMLFilterPlannedCompletionDate').val(FieldValue);
                                                $("#cboMLFilterPlannedCompletionDate option").filter(function () {
                                                    return $(this).text().trim() == OpValue;
                                                }).prop('selected', true);

                                            } else if (ltafterval == "=") {
                                                var OpValue = ">" + ltafterval;

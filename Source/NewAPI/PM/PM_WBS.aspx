        function GetCodeTemplate(Mode) {
            //;
            if (GlobalScheduleID == "") {
                ScheduleID = 0;
            }
            else {
                ScheduleID = GlobalScheduleID;
            }
            var ScheduleTypeID = $("#cbotxtDelDeliverableType").val();

            if (ScheduleTypeID == "" || ScheduleTypeID == null ) {
                ScheduleTypeID = 0;
            }
            var WBSParameters = {
                //  ProjectID: encodeURI(WBSProjectId),
                ScheduleTypeID: encodeURI(ScheduleTypeID),
            }; 
            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_WBS/GetCodeTemplate',
                method: 'Post',
                data: JSON.stringify(WBSParameters),
                dataType: 'json',
                async: false,
                contentType: "application/json",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (WBSParameters) {
                        xhr.setRequestHeader("Params", encryptString(isJson(WBSParameters) ? WBSParameters : JSON.stringify(WBSParameters)));
                    }
                },
                success: function (result) {
                    // alert(result);
                    // alert(Mode);
                    if (result == 1) {
                        if (Mode == "Add" || Mode == "Edit" || Mode == "Copy") {
                            IsCodeTemplateEdittable = 1;
                            $("#txtDelCodeTemplate").removeAttr("disabled")
                            $("#txtDelCodeTemplate").removeAttr("readonly")
                            $("#txtDelCodeTemplate").removeAttr("data-bs-original-title")
                            $("#txtDelCodeTemplate").attr("Mandatory", "1")
                            $("#DivMandatoryCodeTemplate").css("display", "inline")
                            $("#MandatoryDelMandatoryCodeTemplate").css("display", "inline");
                        }
                    } else {
                        IsCodeTemplateEdittable = 0;

                        // $("#txtDelCodeTemplate").attr("disabled", "disabled")
                        if (Mode == "Edit") {
                            $("#DivMandatoryCodeTemplate").css("display", "inline");
                        } else {
                            $("#DivMandatoryCodeTemplate").css("display", "none");
                            $("#txtDelCodeTemplate").attr("disabled", "disabled")
                        }

                        $("#txtDelCodeTemplate").removeAttr("Mandatory");
                        $("#MandatoryDelMandatoryCodeTemplate").css("display", "none")
                    }

                },

                error: function (err) {
                    console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
        }


                            QueryText += " NOT LIKE ''" + ModuleFilterText + "%''";
                        }
                        else {
                            QueryText += AllFields[i] + " ";
                            QueryText += " NOT LIKE ''" + ModuleFilterText + "%''";
                        }
                    }


                                                            }

                                                            Reply2ReplyDiscussionsHTML = "";
                                                            Reply2ReplyDiscussionsHTML += "<div class='box-comment subbox_comment'>"; //div 1 for reply
                                                            Reply2ReplyDiscussionsHTML += "<span class='usernameshort circle-bgblue float-start'>" + ShortName + "</span>";

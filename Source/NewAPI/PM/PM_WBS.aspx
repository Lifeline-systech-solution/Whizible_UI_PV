            }

            pageNumber = pageNumber || 1;
            pageSize = pageSize || 5;
            var taskParameters = {
                projectID: parseInt(projectId, 10),
                pageNumber: pageNumber,
                pageSize: pageSize
            };
            //Added By Vyankat B. on 06-07-2026 for WBS Excel upload history list via AJAXCallWithResultNew
            var result = AJAXCallWithResultNew("api/PM_WBS_ExcelUpload/GetWBSRequestDetails", JSON.stringify(taskParameters), false);
            var response = WBSExcelGetApiResponse(result);
            //End of Added By Vyankat B. on 06-07-2026 for WBS Excel upload history list via AJAXCallWithResultNew
            var tableBody = $("#wbsUploadedfilesBody");
            if ($.fn.DataTable && $.fn.DataTable.isDataTable("#tblWBSUploadedfiles")) {
                $("#tblWBSUploadedfiles").DataTable().clear().destroy();
            }
            tableBody.empty();

            if (!response) {
                tableBody.html('<tr><td colspan="5" class="text-center">' + WBSExcelRes.noRecordsFound + '</td></tr>');
                updateWBSUploadPaginationControls({ TotalRecords: 0, totalRecords: 0 });
                return;
            }

            var responseData = (response && response.data) ? response.data : response;
            if (responseData && responseData.data &&
                !responseData.wbsUploadRequestEntity &&
                !responseData.wBSUploadRequestEntity &&
                !responseData.WBSUploadRequestEntity) {
                responseData = responseData.data;
            }

            var data = (responseData && responseData.wbsUploadRequestEntity)
                ? responseData.wbsUploadRequestEntity
                : (responseData && responseData.wBSUploadRequestEntity)
                    ? responseData.wBSUploadRequestEntity
                    : (responseData && responseData.WBSUploadRequestEntity)
                        ? responseData.WBSUploadRequestEntity
                        : [];

            var paginationList = (responseData && responseData.paginationEntity)
                ? responseData.paginationEntity
                : (responseData && responseData.PaginationEntity)
                    ? responseData.PaginationEntity
                    : (responseData && responseData.wbsUploadPaginationEntity)
                        ? responseData.wbsUploadPaginationEntity
                        : (responseData && responseData.wBSUploadPaginationEntity)
                            ? responseData.wBSUploadPaginationEntity
                            : (responseData && responseData.WBSUploadPaginationEntity)
                                ? responseData.WBSUploadPaginationEntity
                                : [];

            var paginationData = (paginationList && paginationList.length > 0) ? paginationList[0] : {};

            if (data && data.length > 0) {
                wbsExcelUploadCurrentPage = paginationData.currentPage || paginationData.CurrentPage || pageNumber;
                wbsExcelUploadPageSize = paginationData.pageSize || paginationData.PageSize || pageSize;
                wbsExcelUploadTotalPages = paginationData.totalPages || paginationData.TotalPages || 1;
                wbsExcelUploadTotalRecords = paginationData.totalRecords || paginationData.TotalRecords || data.length;

                $.each(data, function (index, file) {
                    var srNo = file.srNo || file.SrNo || (((wbsExcelUploadCurrentPage - 1) * wbsExcelUploadPageSize) + index + 1);
                    var fileName = file.fileName || file.FileName || "";
                    var uploadedDate = file.uploadedDate || file.UploadedDate || "";
                    var uploadedBy = file.uploadedBy || file.UploadedBy || "";
                    var status = file.status || file.Status || "";
                    var requestId = file.requestID || file.RequestID || 0;
                    var statusBadge = "";

                    if (status === "Invalid" || status === "Invalid File" || status === "Failed") {
                        statusBadge = '<td class="text-center"><span class="badge badge-danger">' + WBSExcelRes.invalidFile + '</span>' +
                            '<i class="fas fa-info-circle error-icon" data-bs-toggle="tooltip" data-bs-placement="bottom" title="' + WBSExcelRes.showErrorDetails + '" onclick="ShowWBSUploadStatusInfo(' + requestId + ',0);"></i></td>';
                    } else if (status === "Partial Success" || status === "PARTIAL SUCCESS" || status === "Partially Successful") {
                        statusBadge = '<td class="text-center"><span class="badge badge-success">' + WBSExcelRes.partialSuccess + '</span>' +
                            '<i class="fas fa-info-circle success-icon" data-bs-toggle="tooltip" data-bs-placement="bottom" title="' + WBSExcelRes.showSuccessDetails + '" onclick="ShowWBSUploadStatusInfo(' + requestId + ',1);"></i></td>';
                    } else if (status === "Successful" || status === "Success") {
                        statusBadge = '<td class="text-center"><span class="badge badge-success">' + WBSExcelRes.successful + '</span>' +
                            '<i class="fas fa-info-circle success-icon" data-bs-toggle="tooltip" data-bs-placement="bottom" title="' + WBSExcelRes.showSuccessDetails + '" onclick="ShowWBSUploadStatusInfo(' + requestId + ',1);"></i></td>';
                    } else {
                        statusBadge = '<td class="text-center"><span class="badge badge-danger">' + status + '</span>' +
                            '<i class="fas fa-info-circle error-icon" data-bs-toggle="tooltip" data-bs-placement="bottom" title="' + WBSExcelRes.showErrorDetails + '" onclick="ShowWBSUploadStatusInfo(' + requestId + ',0);"></i></td>';
                    }

                    var row = "<tr>" +
                        '<td class="text-center">' + srNo + "</td>" +
                        '<td class="text-center"><a href="#" onclick="return WBSDownloadUploadedFile(event, \'' + fileName.replace(/'/g, "\\'") + '\');" class="download-link-table">' + fileName + "</a></td>" +
                        '<td class="text-center">' + uploadedDate + "</td>" +
                        '<td class="text-center">' + uploadedBy + "</td>" +
                        statusBadge +
                        "</tr>";
                    tableBody.append(row);
                });

                if ($.fn.DataTable) {
                    $("#tblWBSUploadedfiles").DataTable({
                        paging: false,
                        bLengthChange: false,
                        bFilter: false,
                        ordering: false,
                        responsive: true,
                        destroy: true,
                        bAutoWidth: false,
                        info: false
                    });
                }

                if ($.fn.tooltip) {
                    $('[data-bs-toggle="tooltip"]').tooltip();
                }

                if (!paginationData.totalRecords && !paginationData.TotalRecords) {
                    paginationData.totalRecords = wbsExcelUploadTotalRecords;
                    paginationData.TotalRecords = wbsExcelUploadTotalRecords;
                    paginationData.totalPages = wbsExcelUploadTotalPages;
                    paginationData.TotalPages = wbsExcelUploadTotalPages;
                    paginationData.currentPage = wbsExcelUploadCurrentPage;
                    paginationData.CurrentPage = wbsExcelUploadCurrentPage;
                    paginationData.pageSize = wbsExcelUploadPageSize;
                    paginationData.PageSize = wbsExcelUploadPageSize;
                }

                updateWBSUploadPaginationControls(paginationData);
            } else {

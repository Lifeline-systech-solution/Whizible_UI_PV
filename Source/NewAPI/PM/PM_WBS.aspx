        function GetMandatoryFields(TagID) {

            var WBSParameters = {
                TagID: TagID
            }
            $.ajax({
                url: strUrl + '/api/PM_WBS/getValidationFiled',
                type: "POST",
                data: JSON.stringify(WBSParameters),
                dataType: "json",
                async: false,
                contentType: "application/json;charset-utf=8",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (WBSParameters) {
                        xhr.setRequestHeader("Params", encryptString(isJson(WBSParameters) ? WBSParameters : JSON.stringify(WBSParameters)));
                    }
                },
                success: function (strResult) {
                    if (strResult != undefined) {
                        for (var i = 0; i < strResult.length; i++) {
                            var validationvalue = strResult[i];
                            var Controlname = validationvalue.ControlName;
                            var FiledMandatory = validationvalue.Mandatory;
                            var validationrule = validationvalue.ValidationRules;
                            var ControlCaption = validationvalue.ControlCaption;
                            var ValidationSQLQuery = validationvalue.ValidationSQLQuery;
                            var MaxLength = validationvalue.MaxLength;

                            if (FiledMandatory == true) {
                                var requeridId = MandatoryMilestoneFields[ControlCaption];
                                if (requeridId != undefined) {
                                    requeridId = "Mandatory" + requeridId.substring(3);

                                    var lblId = "#lbl" + MandatoryMilestoneFields[ControlCaption].substring(3);

                                    var mandatoryid = "#" + requeridId;
                                    if ($(mandatoryid).length > 0) {

                                    } else {
                                        var lblval = "&nbsp;&nbsp;&nbsp;<span id=" + requeridId + " value=" + validationrule + "  style='color:red;'>*</span>";
                                        $(lblId).after(lblval);
                                    }
                                }
                            } else {

                            }

                            if (validationrule != "" /*&& FiledMandatory == true*/) {

                                var requeridId = MandatoryMilestoneFields[ControlCaption];
                                if (requeridId != undefined) {
                                    var controlid = "#" + requeridId;
                                    ControlValidationFieldID.push(controlid);

                                    var ValidationRulesnew = validationrule.split(",");
                                    ValidationControlname.push(Controlname);
                                    ControlValidationRules.push(ValidationRulesnew);
                                    ValidationControlCaption.push(ControlCaption);
                                    ControlValidationSQLQuery.push(ValidationSQLQuery);
                                    ControlMaxLength.push(MaxLength);
                                }
                            }
                        }

                    }
                },
                error: function (err) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
        }


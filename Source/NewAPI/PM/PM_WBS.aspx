                    if (result != "") {
                        // ;
                        var objCbo1 = document.getElementById("cboExcutionTemp");
                        $("#cboExcutionTemp option").remove();
                        var objOption1 = document.createElement("OPTION");
                        objCbo1.options.add(objOption1, 0);

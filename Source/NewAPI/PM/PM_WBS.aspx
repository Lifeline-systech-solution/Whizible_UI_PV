        function ProjectBillAmountValidation(ControlID, WBSFlag) {

            try {
                var WBSParameters = {

                    ProjectID: encodeURI(WBSProjectId),

                    WBSFlag: encodeURI(WBSFlag)
                }
                var Flag = true;
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_WBS/GetProjectSumOfBillAmount',
                    type: "POST",
                    data: JSON.stringify(WBSParameters),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (WBSParameters) {
                            xhr.setRequestHeader("Params", encryptString(isJson(WBSParameters) ? WBSParameters : JSON.stringify(WBSParameters)));
                        }
                    },
                    success: function (strResult) {
                        if (strResult != undefined) {
                            var dblSumBillAmt = parseFloat(strResult[0]);
                            var dblProjectValue = parseFloat(strResult[1]);
                            var dblCurBillAmt = parseFloat(document.getElementById(ControlID).value);

                            var BillAmount = dblProjectValue - dblSumBillAmt;
                            if (dblCurBillAmt > BillAmount) {
                                Flag = false;
                            }
                            else {
                                Flag = true;
                            }
                        }
                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
                return Flag;
            }
            catch (ex) {
                //  alert(ex.message);
            }
        }






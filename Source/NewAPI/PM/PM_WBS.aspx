        function MilestoneRepon() {
            try {
                var WBSParameters = {

                    MilestoneID: encodeURI(NewMilestoneID),
                    ProjectID: encodeURI(WBSProjectId),
                    UserID: encodeURI(UserID)
                }
                //var Flag = true;
                StartLoader("WBSBody");
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_WBS/GetMilestoneReOpen',
                    type: "POST",
                    data: JSON.stringify(WBSParameters),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (WBSParameters) {
                            xhr.setRequestHeader("Params", encryptString(isJson(WBSParameters) ? WBSParameters : JSON.stringify(WBSParameters)));
                        }
                    },
                    success: function (strResult) {
                        if (strResult != undefined) {
                            // alertify.error('Milestone Re-Open Successfully','success');
                            alertify.set('notifier', 'position', 'top-right');
                            alertify.notify('Milestone Re-Open Successfully', 'success');
                            if (strResult == "1") {

                                window.open("../Email/SendEmail.aspx?MessageID=488&MilestoneID=" + NewMilestoneID + "&ProjectID=" + WBSProjectId + "&EmployeeID=" + UserID + "", '', 'resizable=yes,scrollbars=yes,toolbar=no,statusbar=no,left=200,top=100,width=650,height=550');
                            }
                            if (Mode == "Add") {
                                Flag = "0";
                            }
                            else if (Mode == "Edit") {
                                Flag = "1";
                            }
                            else if (Mode == "Copy") {
                                Flag = "2";
                            }
                            //GetMilestoneList(null);
                            if (Flag == 1) {
                                MilestoneAddEdit(NewMilestoneID, Flag);
                            }
                            //;
                            //Added By Dipali V On 10th April 2023 For Hide Action pop up after take any action
                            $(".clsmenupopup").removeClass('show');
                            //End of Added By Dipali V On 10th April 2023 For Hide Action pop up after take any action
                            StopAjaxLoader("WBSBody");
                        }
                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
                return Flag;
            }
            catch (ex) {
                // alert(ex.message);
            }


        }


        function IsValidRequestedTime(timeStr) {
            //;
            var checkValu = 0;
            var hour = [];
            var minute = [];
            var timePat = /^(\d{1,2}):(\d{2})?$/;
            //Added By Rutuja D. on 22 Dec 2021 For IssueID = 31912 (if ':' is not in that time then alert is coming)
            if (timeStr.indexOf('.') > -1) { }
            else {
                if (timeStr.indexOf(':') == -1) {timeStr = timeStr + ":00";}
            }
            //End of Added By Rutuja D. on 22 Dec 2021 For IssueID = 31912 (if ':' is not in that time then alert is coming)

            var matchArray = timeStr.match(timePat);
            //Added by Chetan M on 11th April 2020 for IssueID = 23272
            if (timeStr.indexOf(".") > -1) {
                checkValu = 1;
            }
            //End of Added by Chetan M on 11th April 2020 for IssueID = 23272
            if (matchArray == null) {

                //alertify.set('notifier', 'position', 'top-right');
                //alertify.error("Please specify Start Time in (hh:mm) format.\r\n(Hours:0-23,Minutes:0-59).");
                //$("#txtDelStartTime").focus(); 
                //UNCOMMENTED BY DIPALI V ON 24TH DEC 2020 FOR TIME SHOULD NOT ACCEPT ZERO
                checkValu = 1;
                 //END OF UNCOMMENTED BY DIPALI V ON 24TH DEC 2020 FOR TIME SHOULD NOT ACCEPT ZERO
            }
            if (checkValu != 1) {
                if (matchArray != null) {

                    hour = matchArray[1];
                    minute = matchArray[2];
                    if (matchArray[1].length == 0) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.error("Please enter hour.");
                        $("#txtDelStartTime").focus();
                        checkValu = 1;
                    }
                    if (checkValu != 1) {
                        if (matchArray[2].length == 0) {
                            alertify.set('notifier', 'position', 'top-right');
                            alertify.error("Please enter minute.");
                            $("#txtDelStartTime").focus();
                            checkValu = 1;
                            // return checkValu
                        }
                    }
                    if (checkValu != 1) {
                        if (hour < 0 || hour > 23) {
                            alertify.set('notifier', 'position', 'top-right');
                            alertify.error("Hour must be between 0 - 23.");
                            $("#txtDelStartTime").focus();
                            checkValu = 1;
                        }
                    }
                    if (checkValu != 1) {
                        if (minute < 0 || minute > 59) {
                            alertify.set('notifier', 'position', 'top-right');
                            alertify.error("Minute must be between 0 - 59.");
                            $("#txtDelStartTime").focus();
                            checkValu = 1;

                        }
                    }
                }
            }

            if (checkValu == 1) {
                return false;
            }
            else {
                //Added By Rutuja D. on 4 Jan 2022 For HH:MM Format display
                var hours = $("#txtDelStartTime").val();
                var fmtWork = hours;
                var fmtindx = "";
                if (hours.length == 1) {
                    fmtWork = '0' + hours + ':00';
                    hours = fmtWork;
                }
                if (hours.length == 2) {
                    fmtWork = hours + ':00';
                    hours = fmtWork;
                }
                if (hours.length == 3) {
                    fmtindx = hours.indexOf(':');
                    if (fmtindx == 1) {
                        hours = '0' + hours + '0';
                    }
                    if (fmtindx == -1) {
                        hours = hours + ':00';
                    }
                }
                if (hours.length == 4) {
                    fmtindx = hours.indexOf(':');
                    if (fmtindx == 2)
                        hours = '' + fmtWork + '0';
                    if (fmtindx == 1)
                        hours = '0' + fmtWork + '';
                }
                $("#txtDelStartTime").val(hours);
                //End of Added By Rutuja D. on 4 Jan 2022 For HH:MM Format display
                
                return true;
            }
        }


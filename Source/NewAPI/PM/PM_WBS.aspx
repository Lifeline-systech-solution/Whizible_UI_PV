function ValidatePhaseDate(EstimatedStartDate, EstimatedEndDate) {
            var checkval = 0;
            var result = GetProjectStartDateEndDate(WBSProjectId);
            for (var i = 0; i < result.length; i++) {
                var ObjDate = result[i];

            //    var estimatedStartDate = $("#txtAddPhaseStartDate").val();
            //var estimatedEndDate = $("#txtAddPhaseEndDate").val();


                if (Date.parse(ObjDate.expectedStartdate) > Date.parse(EstimatedStartDate) && Date.parse(ObjDate.expectedenddate) < Date.parse(EstimatedEndDate)) {
                    alertify.error("Start date & End Date should be between 'Project Start Date " + result[i].expectedStartdate + " and 'Project End Date " + result[i].expectedenddate + "");
                    $("#txtAddPhaseStartDate").focus();
                    checkval = 1;
                }

                else if (Date.parse(ObjDate.expectedenddate) < Date.parse(EstimatedStartDate)) {
                    alertify.error("Start date should not be greater than 'Project End Date " + result[i].expectedenddate + "");
                    $("#txtAddPhaseStartDate").focus();
                    checkval = 1;
                }

                else if (Date.parse(ObjDate.expectedStartdate) > Date.parse(EstimatedStartDate)) {
                    alertify.error("Start date should not be less than 'Project Start Date " + result[i].expectedStartdate + "");
                    $("#txtAddPhaseStartDate").focus();
                    checkval = 1;
                }

                else if (Date.parse(ObjDate.expectedenddate) < Date.parse(EstimatedEndDate)) {
                    alertify.error("End date should not be greater than 'Project End Date " + result[i].expectedenddate + "");
                    $("#txtAddPhaseEndDate").focus();
                    checkval = 1;
                }

                else if (Date.parse(ObjDate.expectedStartdate) > Date.parse(EstimatedEndDate)) {
                    alertify.error("End date should not be less than 'Project Start Date " + result[i].expectedStartdate + "");
                    $("#txtAddPhaseEndDate").focus();
                    checkval = 1;
                }
                else if (Date.parse(EstimatedStartDate) > Date.parse(EstimatedEndDate)) { 
                    //Commented And Added By Usha Pandit On 18.06.2020 For showing correct date in alert
                    //alertify.error("Start date should not be greater than End date " + EstimatedEndDate + "");
                    alertify.error("Start date should not be greater than End date - " + $("#txtAddPhaseEndDate").val() + "");   
                    //End Of Added By Usha Pandit On 18.06.2020 For showing correct date in alert
                    $("#txtAddPhaseStartDate").focus();
                    checkval = 1;
                }
                else {
                    checkval = 0;
                }
            }
            return checkval;
        }         


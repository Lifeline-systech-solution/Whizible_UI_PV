        //get phase Document Category List
        function GetSubProjectDocumentCategoryList(cboId) {
            //    
            var wbsParamete = {
                ProjectID: encodeURI(WBSProjectId),
                RoleID: encodeURI('<%= Session("intPostID") %>')
            }
            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_WBS/GetSubProjectDocumentCategoryList',
                method: 'Post',
                data: JSON.stringify(wbsParamete),
                dataType: 'json',
                async: false,
                contentType: "application/json",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (wbsParamete) {
                        xhr.setRequestHeader("Params", encryptString(isJson(wbsParamete) ? wbsParamete : JSON.stringify(wbsParamete)));
                    }
                },
                success: function (strResult) {
                    //  
                    var selHTML = "";
                    $("#SubProjectatchmentTableBody > tr > td:nth-child(1)>select#" + cboId).empty();
                    //$("#" + cboId).empty();
                    if (strResult != undefined) {
                        selHTML += "<option  value=0 >Select Category </option>";
                        for (var i = 0; i < strResult.length; i++) {
                            var d = strResult[i];
                            var CategoryID = d.CategoryID;
                            var Category = d.Category;
                            selHTML += "<option  value='" + CategoryID + "' >" + Category + "</option>";
                        }
                        $("#SubProjectatchmentTableBody > tr > td:nth-child(1)>select#" + cboId).html(selHTML);
                        $('[data-bs-toggle="tooltip"]').tooltip();
                    }
                },
                error: function (err) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });

        }



        function ModuleClearFields(IdCaption) {
            $("[id*=cbo" + IdCaption + "]").each(function (obj) {
                var cbo = this.id;
                $("#" + cbo + " option:first").prop('selected', 'selected');
            });

            $("[id*=txt" + IdCaption + "]").each(function (obj) {
                var txt = this.id;
                $("#" + txt).val('').change();
            });
        }


        $.fn.scrollGuard = function () {
            return this
                .on('mousewheel', function (e) {
                    var event = e.originalEvent;
                    var d = event.wheelDelta || -event.detail;
                    this.scrollTop += (d < 0 ? 1 : -1) * 30;
                    e.preventDefault();
                });
        };


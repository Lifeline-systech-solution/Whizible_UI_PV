            }
            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_Resources/EditFilterData',
                method: 'Post',
                data: JSON.stringify(ResourceParameters),
                dataType: 'json',
                async: false,
                contentType: "application/json",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (ResourceParameters) {
                        xhr.setRequestHeader("Params", encryptString(isJson(ResourceParameters) ? ResourceParameters : JSON.stringify(ResourceParameters)));
                    }
                },
                success: function (result) {
                    for (var i = 0; i < result.length; i++) {
                        var QueryText = result[i].WhereClause;
                        GlobalFilterName = result[i].FilterName;
                    }
                    QueryText = QueryText.replace('E.ReportingTo', 'ReportingTo');
                    BindBasicFilters(QueryText, "AL");
                    var FilterName = $("#txtFilterName").val(GlobalFilterName);
                    $(".LIResourceALBasicFilter").addClass("active");
                    setTimeout(function () {
                        $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
                    }, 350)
                },
                error: function (err) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
             setTimeout(function(){
        $.fn.dataTable.tables( {visible: true, api: true} ).columns.adjust();
            }, 350);  //Added by pradip on 13-01-2020
        }


        //function for delete and page filters
        function DeleteDefaultResourceFilter(DefaultID) {

            if (DefaultID.indexOf("Default") > -1) {
                var FilterID = DefaultID.replace("Default", "");
                DeleteResourceFilter(FilterID);
                GetResourcesList(ProjectID, null);

            }
            else {
                DeleteResourceFilter(DefaultID);
                GetResourceDefaultFilter(1019);
            }
            setTimeout(function () {
                $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
            }, 350)
        }

        ////Delete Resource Filter 
        function DeleteResourceFilter(FilterID) {

            StartLoader("#ResourceBody");
            if (FilterID != undefined) {
                ResourceParameters = {
                    FilterID: encodeURI(FilterID),
                }
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_Resources/DeleteFilterData',
                    type: "POST",
                    data: JSON.stringify(ResourceParameters),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (ResourceParameters) {
                            xhr.setRequestHeader("Params", encryptString(isJson(ResourceParameters) ? ResourceParameters : JSON.stringify(ResourceParameters)));
                        }
                    },
                    success: function (result) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.success(result);
                        SearchRecords = "0";
                        ClearBasicFilter("AL");
                        ResourceFilters();
                        $('#presetfilterAR').removeClass("active");
                        $(".bgwhite.resource_allocation > div > div > div:nth-child(3) > div >button#ResourceFilter").removeClass("activefilter");
                       // $("#ResourceALMyFiltersdropdown").css('display', 'none');
                        //$("#liResourceALMyFiltersdropdown").removeClass('active');
                        $(".LIResourceALBasicFilter").removeClass('active');
                        StopAjaxLoader("#ResourceBody");

                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
            }

            setTimeout(function(){
        $.fn.dataTable.tables( {visible: true, api: true} ).columns.adjust();
            }, 350);  //Added by pradip on 13-01-2020


        }

        //Added by Imran 03-08-2021
        function OpenResourceUtilization()
        { 
            if (ProjectID == 0)
            {
                alertify.error("<%= MyBase.GetResourceString("A_SelectProject") %>");
                return false;
            }
            else
            {
                generatetokenResourceUtilization(ProjectID,UserID); 
                PopUpWondowUtilization("PM_Resource_Utilization.aspx?PKToken=" + m_CurrentTokenUtilization + "&ProjectID=" + ProjectID+ "&UserID=" + UserID, 1150, 500);           
            }            
        }
        //End By Imran 03-08-2021

        function PopUpWondowUtilization(url, width, height)
        {
            var leftPosition, topPosition;
            //Allow for borders.
            leftPosition = (window.screen.width / 2) - ((width / 2) + 10);
            //Allow for title and status bars.
            topPosition = (window.screen.height / 2) - ((height / 2) + 50);
            //Open the window.
            window.open(url, "Window2",
            "status=no,height=" + height + ",width=" + width + ",resizable=yes,left="
            + leftPosition + ",top=" + topPosition + ",screenX=" + leftPosition + ",screenY="
            + topPosition + ",toolbar=no,menubar=no,scrollbars=no,location=no,directories=no");
        }

      

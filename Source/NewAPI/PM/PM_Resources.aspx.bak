                    //alertify.set('notifier', 'position', 'top-right');
                    //alertify.error("Request Details are mandatory");
                  <%--  if ($("#txtnoofresource").val() == "") {
                        alertify.error("<%= MyBase.GetResourceString("C_A_NoofResource") %>");

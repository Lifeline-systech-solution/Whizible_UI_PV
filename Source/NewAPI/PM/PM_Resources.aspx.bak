        var Rate;
        var Cost;
        function GetRateAndCost(NewProjectEmployeeRoleID) {
            var ResourceParameters = {
                ProjectEmployeeRoleID: encodeURI(NewProjectEmployeeRoleID),
            }
            var param = JSON.stringify(ResourceParameters);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetResourcesRateAndCost", param, false);
            if (strResult != undefined) {
                for (i = 0; i < strResult.length; i++) {
                    Rate = strResult[i].Rate;
                    Cost = strResult[i].Cost;
                }

            }
        }

        //Function for Add New Resources
        function AddNewResources() {

            var InsResource = new Object();
            InsResource.ProjectID = ProjectID;

            InsResource.ProjectEmployeeRoleID = NewProjectEmployeeRoleID;
            if (InsResource.ProjectEmployeeRoleID == '' || InsResource.ProjectEmployeeRoleID == 0) { InsResource.ProjectEmployeeRoleID = "Null" }
            else { InsResource.ProjectEmployeeRoleID = InsResource.ProjectEmployeeRoleID; }

            InsResource.Rate = Rate;
            if (InsResource.Rate == '' || InsResource.Rate == null) { InsResource.Rate = 0 }
            else { InsResource.Rate = InsResource.Rate; }

            InsResource.Cost = Cost;
            if (InsResource.Cost == '' || InsResource.Cost == null) { InsResource.Cost = 0 }
            else { InsResource.Cost = InsResource.Cost; }

            InsResource.EmployeeID = NewEmployeeID;

            InsResource.Role = $("#txtALRoleDescription :selected").val();

            InsResource.ResourcePercentage = $("#txtALResourcePercentage").val();

            InsResource.ExpectedStartDate = $("#txtALExpectedStartDate").val();

            InsResource.ExpectedEndDate = $("#txtALExpectedEndDate").val();

            InsResource.ResourceStatus = $("#txtALResourceStatus").val();
            if (InsResource.ResourceStatus == '' || InsResource.ResourceStatus == null || InsResource.ResourceStatus == 0) { InsResource.ResourceStatus = "Null" }
            else { InsResource.ResourceStatus = InsResource.ResourceStatus; }

            if ($('#chkIsResourceBillable').is(":checked")) {
                var IsResourceBillable = 1;
            }
            else {
                var IsResourceBillable = 0;
            }
            InsResource.IsResourceBillable = IsResourceBillable;


            InsResource.Responsibility = $("#txtALResponsibility").val();
            //Added by Chetan M on 11th Jan 2020
            InsResource.Responsibility = $.trim(InsResource.Responsibility.replace(/[\t\n]+/g, ' '));
            //End of added by Chetan M on 11th Jan 2020
            if (InsResource.Responsibility == '' || InsResource.Responsibility == null || InsResource.Responsibility == 0) { InsResource.Responsibility = "Null" }
            else { InsResource.Responsibility = InsResource.Responsibility; }


            InsResource.ReportingTo = $("#txtALReportingTo :selected").val();
            if (InsResource.ReportingTo == '' || InsResource.ReportingTo == null || InsResource.ReportingTo == 0) { InsResource.ReportingTo = "Null" }
            else { InsResource.ReportingTo = InsResource.ReportingTo; }

            if ($('#chkIsDefaultApprover').is(":checked")) {
                var IsDefaultApprover = true;
            }
            else {
                var IsDefaultApprover = false;
            }
            InsResource.IsDefaultApprover = IsDefaultApprover;

            InsResource.BudgetedHours = $("#txtALWorkHrs").val();

            InsResource.UserName = UserName;

            InsResource.UserID = UserID;

            if (IsAgile == 1) {

                if ($('#chkIsProductOwner').is(":checked")) {
                    var IsProductOwner = true;
                }
                else {
                    var IsProductOwner = false;
                }
                InsResource.IsProductOwner = IsProductOwner;
            }

            if (IsAgile == 1) {
                objInsResource = [InsResource.ProjectID, InsResource.ProjectEmployeeRoleID, InsResource.Rate, InsResource.Cost, InsResource.EmployeeID, InsResource.Role, InsResource.ResourcePercentage, InsResource.ExpectedStartDate, InsResource.ExpectedEndDate,
                InsResource.ResourceStatus, InsResource.IsResourceBillable, InsResource.Responsibility, InsResource.ReportingTo, InsResource.IsDefaultApprover, InsResource.BudgetedHours, InsResource.UserName, InsResource.UserID, InsResource.IsProductOwner];
            }
            else {
                objInsResource = [InsResource.ProjectID, InsResource.ProjectEmployeeRoleID, InsResource.Rate, InsResource.Cost, InsResource.EmployeeID, InsResource.Role, InsResource.ResourcePercentage, InsResource.ExpectedStartDate, InsResource.ExpectedEndDate,
                InsResource.ResourceStatus, InsResource.IsResourceBillable, InsResource.Responsibility, InsResource.ReportingTo, InsResource.IsDefaultApprover, InsResource.BudgetedHours, InsResource.UserName, InsResource.UserID];
            }

            InsertResourceControllerCall(objInsResource);
        }

        //Function for Calling Insert Controller 
        function InsertResourceControllerCall(objInsResource) {

            var resultFlag = 0;
            StartLoader("#ResourceBody");
            var param = JSON.stringify(objInsResource);
            var strResult = AJAXCallWithResult("/api/PM_Resources/InsertNewResource", param, false);
            var Result = strResult.split("||");
            if (Result[0] != "") {
                
                
                //Added By Usha Pandit On 11.05.2020 to prevent alert disappearing soon
                setTimeout(function () {
                    alertify.success(Result[0]);
                }, 4000);
                //End Of Added By Usha Pandit On 11.05.2020 to prevent alert disappearing soon
            }
            if (Mode == "Add") {
                resultFlag = "0";
            }
            else if (Mode == "Edit") {
                resultFlag = "1";
            }
            if (resultFlag == 1) {
                //Added By Reshma on 9th Jan 2020 For IssueID-21367
                var QueryText = GblQueryText;
                //End Added By Reshma on 9th Jan 2020 For IssueID-21367              
                NewProjectEmployeeRoleID = Result[1];
                ADDEditResourceOnclick(NewProjectEmployeeRoleID, NewEmployeeID, NewEmployeeName, resultFlag);
                //Commented and Added By Reshma on 9th Jan 2020 For IssueID-21367
                //GetResourcesList(ProjectID, null);
                GetResourcesList(ProjectID, QueryText);
                //End Added By Reshma on 9th Jan 2020 For IssueID-21367
                if ($('#ARdetailpanel').is(':visible')) {
                    $(".actioncol,#resourceloading").css("pointer-events", "none");
                    $(".dataTables_paginate ").css("pointer-events", "none");
                }

            }
            StopAjaxLoader("#ResourceBody");
        }


        //function Approver_OnClick
        $("#chkIsDefaultApprover").click(function () {
            var GetDefaultApprover = 0;
            var ResourceParameters = {
                ProjectID: encodeURI(ProjectID),
                ProjectEmployeeRoleID: encodeURI(NewProjectEmployeeRoleID),
            }
            var param = JSON.stringify(ResourceParameters);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetProjectEmployeeID", param, false);
            if (strResult != undefined) {
                GetDefaultApprover = strResult.intEmployeeID;
            }

            if (GetDefaultApprover != "") {
                if ($("#chkIsDefaultApprover")[0].checked) {
                    //Already default approver is present on the project. Make another resource a default approver.                                
                    alertify.error('<%= MyBase.GetResourceString("A_setDefaultApprover") %>');
                }
            }
        });

        //function Approver_OnChange
        function Approver_OnChange() {
            var ChangedReportingTo;
            ChangedReportingTo = document.getElementById("txtALReportingTo");
            if (PreviousReportingTo != ChangedReportingTo.value) {
                if (PreviousReportingTo != '' && ChangedReportingTo.value != '') {
                    if (NewProjectEmployeeRoleID != "") {
                        alertify.error('<%= MyBase.GetResourceString("A_GeneratedTimesheets") %>');
                    }
                }
            }
        }

        //Added By Riddhesh Patil on 15-NOV-2022 
        function checkSpecialCharacter(value, WebConfigSpecialCharacters) {
            if (WebConfigSpecialCharacters != '') {
                var regularExpression = WebConfigSpecialCharacters;
                regularExpression += '"';
                var isSpecialCharacter = 0;
                for (var i = 0; i < regularExpression.length; i++) {
                    if (value.indexOf(regularExpression[i]) != -1) {
                        isSpecialCharacter = 1
                    }
                }
                if (isSpecialCharacter == 1) {
                    return true;
                }
                else {
                    return false;
                }
            }
            else {
                return false;
            }
        }
		//End of Added By Riddhesh Patil

        //This function validates  detail panel fields
        function ValidateControls() {
           
            var checkval = 1;
            var objRoleDesription = $("#txtALRoleDescription :selected").val();
            //if (objRoleDesription == 0) { objRoleDesription = ""; }
            if (objRoleDesription == 0 || objRoleDesription == undefined) {
                objRoleDesription = "";
            }
            else {
                objRoleDesription = objRoleDesription;
            }
            var ExpectedStartDate = $("#txtALExpectedStartDate").val();
            var ExpectedEndDate = $("#txtALExpectedEndDate").val();
            var objResourceStatus = $("#txtALResourceStatus :selected").val();
            var objResourcePercentage = $("#txtALResourcePercentage").val();
            var objWorkHrs = $('#txtALWorkHrs').val();
            var objResponsiblity = $('#txtALResponsibility').val();
           
            if (isBlank(objRoleDesription)) {
                alertify.error('<%= MyBase.GetResourceString("A_Role") %>');
                $('#txtALRoleDescription').focus();

            }
            else if (isBlank(ExpectedStartDate)) {
                alertify.error('<%= MyBase.GetResourceString("A_StartDate") %>');
                $('#txtALExpectedStartDate').focus();

            }
            else if (isBlank(ExpectedEndDate)) {
                alertify.error('<%= MyBase.GetResourceString("A_EndDate") %>');
                $('#txtALExpectedEndDate').focus();

            }
            else if (isBlank(objResourcePercentage)) {
                alertify.error('<%= MyBase.GetResourceString("A_ResourcePercentage") %>');
                $('#txtALResourcePercentage').focus();

            }
            else if (isBlank(objWorkHrs)) {
                alertify.error('<%= MyBase.GetResourceString("A_WorkHrs") %>');
                $('#txtALWorkHrs').focus();

            }
            else if (isBlank(objResourceStatus)) {
                alertify.error('<%= MyBase.GetResourceString("A_Status") %>');
                $('#txtALResourceStatus').focus();

            }
            //Commnet and Added By Riddhesh Patil on 15-NOV-2022 
            else if (checkSpecialCharacter(objResponsiblity, WebConfigSpecialCharacters) == true) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('Responsibilities should not contain any of these ' + WebConfigSpecialCharacters + ' characters');
                $("#txtALResponsibility").focus();
                checkval = 1;
                return ;
            }
			//End of Comment Added By Riddhesh Patil

            //Added By Dipali V On 9th Jan 2020 For Reporting to Mandatory
            else if ($("#txtALReportingTo").val() == '') {
          
                if (CheckReportingTo() == 1) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error("Reporting To should not be left blank.");
                    $("#txtALReportingTo").focus();//ADDED BY DIPALI V ON 27TH DEC 2019 FOR FOCUS ON CONTROL
                    checkval = 1;
                    return;

                }
            }
            //End of Added By Dipali V On 9th Jan 2020 For Reporting to Mandatory



           else if (objResourcePercentage != "") {
                var chkresult = ResourcePercentageValidation("txtALResourcePercentage");               
                if (chkresult == true) {
                    if (objWorkHrs != "") {
                        var result = WorkHoursValidation("txtALWorkHrs");
                        if (result == true) {
                            //Added By Reshma on 17Th Jan 2020 For Work Hours Validation
                            //var strResult = ValidateWHWithProjectWorks("txtALWorkHrs");                            
                            //if (strResult == true) {
                                   //End Added By Reshma on 17Th Jan 2020 For Work Hours Validation
                                if (ExpectedStartDate != "" || ExpectedEndDate != "") {
                                    var Datecheckval = ValidateDates(ExpectedStartDate, ExpectedEndDate);
                                    if (Datecheckval == 0) {
                                        if (objResponsiblity != "") {
                                            var result = TextAreaValidate("txtALResponsibility");
                                            if (result == true) {
                                                checkval = 0;
                                            }
                                            else {
                                                checkval = 1;
                                            }
                                        }
                                        else {
                                            checkval = 0;
                                        }
                                    }
                                }
                            //}
                        }
                    }
                }
            }


            return checkval;
        }


        var EditAccess = "<%= m_blnEditAccess%>";
        var DeleteAccess = "<%= m_blnDeleteAccess%>";
        var blnViewAccess ="<%= m_blnViewAccess%>";
        var NewProjectEmployeeRoleID = 0;
        var NewEmployeeID = 0;
        var NewEmployeeName = "";
        var ReleaseEmployeeID = 0;
        var ReleaseEmployeeName = "";
        var ReleaseProjectEmployeeRoleID = 0;
        var strHTMLApprover = "";
        var IsAgile = 0;
        var CheckLinkAccess = 0;
        //For Skill plotting section
        var m_intTotalDays = 0;
        var m_intEmployeeYears = 0;
        var m_intEmployeeMonths = 0;
        var m_intToolID = 0;

                            alertify.error("<%= MyBase.GetResourceString("A_PreResourceRelease") %>");
                            //End Commented & Added By Rutuja D. 14 Jan 2020 For Display Wrong Alert                        
                            return false;
                        }
                    }
                }--%>
                //End of Commented by Vishal Mane on 11/09/2024 To remove alert 'You can not Prepone release this resource! Resource has daily activity entered greater than New Total Hours'

                //debugger;
                 //Commented By Dipali V On 17th Jun 2024
                ///////////////////////////////////////Added By Dipali V On 15th May 2024
                //Restriction of planned hours w.r.t.actual hours

                var EffectiveDate = $("#txtPrEffeDate").val();
                var NewEndDate = $("#txtPrEndDate").val();
                RequestParameters = {
                    ProjectID: encodeURI(ProjectID),
                    EffectiveDate: encodeURI(EffectiveDate),
                    NewEndDate: encodeURI(NewEndDate),
                    EmployeeID: encodeURI(NewEmployeeID),

                }
                var param = JSON.stringify(RequestParameters);
                var Result = AJAXCallWithResult("/api/PM_RequestedResources/ValidateDAWithEffectiveDate", param, false);
                if (Result != "")
                {

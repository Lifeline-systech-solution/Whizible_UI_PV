        //Function For Update Skills
        function UpdateSkills() {

            var IsvalidateSkill = IsSkillValid();

            if (IsvalidateSkill == true) {
                var strToolIds = "";
                var arrToolId = [];
                var intCnt = 0;
                var intYrs = 0;
                var intMnths = 0;
                strToolIds = strSkillId;
                var n = strToolIds.lastIndexOf(",");
                strToolIds = strToolIds.substring(0, n);
                if (strToolIds != "") {
                    if (strToolIds.indexOf(",") > -1) {
                        arrToolId = strToolIds.split(",");
                    }
                    else {
                        arrToolId = strToolIds;
                    }

                    for (intCnt = 0; intCnt <= arrToolId.length - 1; intCnt++) {

                        intYrs = $("#cboYRow_" + arrToolId[intCnt]).val();
                        if (intYrs == undefined) { intYrs = 0; }
                        else { intYrs = intYrs; }
                        intMnths = $("#cboMRow_" + arrToolId[intCnt]).val();
                        if (intMnths == undefined) { intMnths = 0; }
                        else { intMnths = intMnths; }
                        var ResourceParameter = {
                            ProjectID: encodeURI(ProjectID),
                            EmployeeID: encodeURI(ReleaseEmployeeID),
                            ToolID: arrToolId[intCnt],
                            intYrs: encodeURI(intYrs),
                            intMnths: encodeURI(intMnths)

                        }
                        var param = JSON.stringify(ResourceParameter);
                        var strResult = AJAXCallWithResult("/api/PM_Resources/UpdateSkills", param, false);

                    }
                }
            }
        }

        //var arrControlID = new Array();

        function IsSkillValid() {
            var strToolIds = "";
            var arrToolId = [];
            strToolIds = strSkillId;
            var n = strToolIds.lastIndexOf(",");
            strToolIds = strToolIds.substring(0, n);
            if (strToolIds != "") {
                if (strToolIds.indexOf(",") > -1) {
                    arrToolId = strToolIds.split(",");
                }
                else {
                    arrToolId = strToolIds;
                }
                checkvalidation = 0;
                for (intCnt = 0; intCnt <= arrToolId.length - 1; intCnt++) {

                    intYrs = $("#cboYRow_" + arrToolId[intCnt]).val();
                    if (intYrs == undefined) { intYrs = 0; }
                    else { intYrs = intYrs; }
                    intMnths = $("#cboMRow_" + arrToolId[intCnt]).val();
                    if (intMnths == undefined) { intMnths = 0; }
                    else { intMnths = intMnths; }

                    if (checkvalidation == 0) {
                        var ResourceParameter = {
                            EmployeeID: encodeURI(ReleaseEmployeeID),
                            ProjectID: encodeURI(ProjectID),
                            YearsOfExperience: encodeURI(intYrs),
                            MonthsOfExperience: encodeURI(intMnths)
                        };
                        $.ajax({
                            url: strUrl + '/api/PM_Resources/GetMonthYearValidation',
                            method: 'Post',
                            data: JSON.stringify(ResourceParameter),
                            dataType: 'json',
                            async: false,
                            contentType: "application/json",
                            beforeSend: function (xhr) {
                                xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                                if (ResourceParameter) {
                                    xhr.setRequestHeader("Params", encryptString(isJson(ResourceParameter) ? ResourceParameter : JSON.stringify(ResourceParameter)));
                                }
                            },
                            success: function (result) {
                                if (result != "") {
                                    checkvalidation = 1;
                                    alertify.set('notifier', 'position', 'top-right');
                                    alertify.error(result);
                                    if (intYrs != arrEmployeeYears[intCnt]) {
                                        $("#cboYRow_" + arrToolId[intCnt]).focus();
                                    }
                                    if (intMnths != arrEmployeeMonths[intCnt]) {
                                        $("#cboMRow_" + arrToolId[intCnt]).focus();
                                    }
                                    arrEmployeeYears = [];
                                    arrEmployeeMonths = [];
                                }

                            },
                            error: function (err) {
                                window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                            }

                        });
                    }
                }
            }


            if (checkvalidation == 1) {
                return false;

            } else {
                return true;
            }
        }


        //function for Release Resource
        function ReleaseResource() {

            $("#btnreleaseresource").removeAttr("data-bs-dismiss", "modal");
            var ResourceParameter = {
                ProjectEmployeeRoleID: encodeURI(ReleaseProjectEmployeeRoleID),
                UserID: encodeURI(UserID),
                UserName: encodeURI(UserName),
                ProjectID: encodeURI(ProjectID),
            }
            var param = JSON.stringify(ResourceParameter);
            var strResult = AJAXCallWithResult("/api/PM_Resources/ReleaseResource", param, false);
            if (strResult == "2") {

                //Commented And Added By Usha Pandit On 19.06.2020 for alert disappearing soon
                //alertify.error("<%= MyBase.GetResourceString("A_NotResourceReleased") %>");
                setTimeout(function () {
                    alertify.dismissAll();
                    alertify.error("<%= MyBase.GetResourceString("A_NotResourceReleased") %>");
                }, 3000);
                //End Of Added By Usha Pandit On 19.06.2020 for alert disappearing soon

                TaskCompletionList();
                TaskToBeVoidedList();
                TaskApproverList();
                GetProjectExperienceDetails();
                GetMPPTaskDetails();

            }
            else if (strResult == "1") {
                //Commented And Added By Usha Pandit On 19.06.2020 for alert disappearing soon
                //alertify.success("<%= MyBase.GetResourceString("A_ResourceReleased") %>");
                 //Added by dipali v on 10th feb 2021 for save button disabled if resource release 
                $("#btnSaveResource").attr("disabled", "disabled"); 
                 //End of Added by dipali v on 10th feb 2021 for save button disabled if resource release

                setTimeout(function () {
                    alertify.dismissAll();
                    alertify.success("<%= MyBase.GetResourceString("A_ResourceReleased") %>");
                }, 3000);
                //End Of Added By Usha Pandit On 19.06.2020 for alert disappearing soon
                GetResourceDefaultFilter(1019);
                $("#btnreleaseresource").attr("data-bs-dismiss", "modal");
                GetResourcesDataInEditMode(ReleaseProjectEmployeeRoleID);
                window.open("../Email/SendEmail.aspx?MessageID=16&ProjectEmployeeRoleID=" + ReleaseProjectEmployeeRoleID + "&ProjectID=" + ProjectID + "&UserID=" + UserID + "", '', 'resizable=yes,scrollbars=yes,toolbar=no,statusbar=no,left=200,top=100,width=650,height=550');
                Cancel_modal();
            }
            else {
                 //Added by dipali v on 10th feb 2021 for save button disabled if resource release 
                $("#btnSaveResource").attr("disabled", "disabled"); 
                 //End of Added by dipali v on 10th feb 2021 for save button disabled if resource release

               //Added By Dipali V On 28th july 2020 for alert issue on IE
                setTimeout(function () {
                    //alertify.dismissAll();
                    alertify.success("<%= MyBase.GetResourceString("A_ResourceReleased") %>");
                }, 3000);
                 //End of Added By Dipali V On 28th july 2020 for alert issue on IE
                GetResourceDefaultFilter(1019);
                GetResourcesDataInEditMode(ReleaseProjectEmployeeRoleID);
                $("#btnreleaseresource").attr("data-bs-dismiss", "modal");
                Cancel_modal();
            }
        }
        //End Resource Release Functinality


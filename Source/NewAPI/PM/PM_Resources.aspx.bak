        //Added By Imran 17-08-2021 For Resource Utilization
        var m_CurrentTokenUtilization = '';
        function generatetokenResourceUtilization(ProjectID,UserID) 
		{
            try {
                if (ProjectID != undefined) {
                    var generatedtoken = ajaxCall("PM_Resources.aspx/GeneratePK_TokenResourceUtilization", "POST", "application/json;charset=utf-8", "json", JSON.stringify({ ProjectID: ProjectID,TagID: 3752,UserID: UserID }));
                    if (generatedtoken != undefined) {
                        m_CurrentTokenUtilization = generatedtoken.d;
                        validatetokenResourceLoading(m_CurrentTokenUtilization);
                }
                }
            }
            catch (ex) {
                //alert(ex.message());
            }
        }
        var m_PKTokenRUtilization;
        function validatetokenResourceLoading(m_CurrentTokenUtilization,ProjectID,UserID) 
		{
            try 
			{                
                m_PKTokenRUtilization = m_CurrentTokenUtilization;
                if (ProjectID != undefined) {
                    var validatetoken = ajaxCall("PM_Resources.aspx/ValidatePK_TokenUtilization", "POST", "application/json;charset=utf-8", "json", JSON.stringify({ ProjectID: ProjectID, TagID: 3752,PKToken: m_PKTokenRUtilization,UserID:UserID }));

                    if (validatetoken != undefined) {
                        if (validatetoken.d == false) {
                            window.location.href = "../../General/CommonPage.aspx?MasterTagID=1836";
                        }
                    }
                }
            }
            catch (ex) {
                alert(ex.message());
            }
        }


        


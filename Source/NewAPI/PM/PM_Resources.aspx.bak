                                                strHTML += '<a href="#" onclick=ResourceTab_OnClick("RequestList") id="RequestedResourcesButton" class="btn btn-white ml-1">Resource Request List</a>'
                                            }
                                            else {
                                                strHTML += '<a href="#" class="btn btn-white" id="AddRequestBtn" disabled>Add Request</a>'
                                                strHTML += '<a href="#" id="RequestedResourcesButton" class="btn btn-white ml-1" disabled>Resource Request List</a>'
                                            }
                                        }
                                    }
                                    else
                                     {
                                    if (IsAllowResourceAllocation == 1) {
                                        strHTML += '<a href="#" id="RequestedResourcesButton" class="btn btn-white ml-1" disabled>Resource Request List</a>'

                                    }
                                    else {
                                        $("#RequestedResourcesButton").hide();
                                    }
                                }
                            }   
                        }
                    }
                    else { //Added & Commented By Dipali V On 10th Jan 2020 For Close Project 
                        //if (IsAllowResourceAllocation == 0) {
                        //    strHTML += '<a href="#" class="btn btn-white" id="AddRequestBtn" disabled>Add Request</a>'
                        //} else
                        //{
                        //    //Commented by imran on 07-01-2022
                        //    //strHTML += '<a href="#" class="btn btn-white" id="AddRequestBtn" disabled>Add Request</a>'
                        //    //strHTML += '<a href="#" id="RequestedResourcesButton" class="btn btn-white ml-1" disabled>Resource Request List</a>'
                        //    //End of comment by imran on 07-01-2022
                        //    //End of Added & Commented By Dipali V On 10th Jan 2020 For Close Project 
                        //}

                    }

                    if (IsAllowResourceAllocation == 1) {
                        $("#btnAddResourceNewUI").text("Add Request");
                    } else {
                        $("#btnAddResourceNewUI").text("Add Resource");
                    }
                    
                    $(".toplinkss").append(strHTML);

                },
                error: function (err) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });

        }

        function AddNewResource_OnClick()
        {
            //StartLoader("#ResourceBody");//added by Dipali V On 9th Jan 2020
            var ProjectID = $("#cboProjects option:selected").val();
            //Added By Rutuja D. 10 Jan 2020 For Check Project Is OnHold
            CheckProjectOnHold();
            CheckIsProjectCreationWorkflowReqd();
            if (IsProjectCreationWorkflowReqd == 1) {
                if (BaselineNumber == 0) {
                     //Added By RUtuja D. 13 Jan 2020 For Resource File Alert
                    //alertify.error("Project related activities such as adding Task/Resource/Timesheet entry cannot be performed as the Project is not Approved.");
                    alertify.error("<%= MyBase.GetResourceString("A_ProjectNotApproved") %>");
                     //End Added By RUtuja D. 13 Jan 2020 For Resource File Alert
                    $("#btnSaveResource").hide();

                }
                else if (ProjectOnHold == 1) {
                    //Added By RUtuja D. 13 Jan 2020 For Wrong Alert
                   // alertify.error("Project related activities such as adding Task/Resource/Timesheet entry cannot be performed as the Project is not Approved.");
                    alertify.error("<%= MyBase.GetResourceString("A_ProjectOnHold") %>");
                     //End Added By RUtuja D. 13 Jan 2020 For Wrong Alert
                     $("#btnSaveResource").hide();

                }
                else {
                    StartLoader("#ResourceBody");//added by Dipali V On 9th Jan 2020
                     window.location.href = "PM_AddNewResource.aspx?ProjectID=" + ProjectID + "";

                    //Added By Imran 22-06-2021
                    //window.location.href = "PM_Resource_Selection.aspx?ProjectID=" + ProjectID + "";
                    //End Added By Imran D. 22-06-2021
                    StopAjaxLoader("#ResourceBody");
                }
            }
            else if (ProjectOnHold == 1) {
                //Added By RUtuja D. 13 Jan 2020 For Wrong Alert
                   // alertify.error("Project related activities such as adding Task/Resource/Timesheet entry cannot be performed as the Project is not Approved.");
                   alertify.error("<%= MyBase.GetResourceString("A_ProjectOnHold") %>");
                     //End Added By RUtuja D. 13 Jan 2020 For Wrong Alert
                     $("#btnSaveResource").hide();
            }
            else {
                StartLoader("#ResourceBody");//added by Dipali V On 9th Jan 2020
                window.location.href = "PM_AddNewResource.aspx?ProjectID=" + ProjectID + "";
                StopAjaxLoader("#ResourceBody");
            }

        }

        

        //function for save and link dropdown in edit mode
        function GetResourcesLinkTabAcess(NewEmployeeID, NewEmployeeName, NewProjectEmployeeRoleID) {
            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_Resources/GetResourcesTabAcess',
                type: 'POST',
                data: {},
                dataType: 'json',
                async: false,
                contentType: "application/json",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                },
                success: function (result) {

                    var IsAllowResourceAllocation = result;
                    if (AddAccess == "True") {
                        if (IsAllowResourceAllocation == 0) {
                            $("#btnSaveResource").show();

                        }
                        else {
                            $("#btnSaveResource").hide();

                        }
                    }

                },
                error: function (err) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });

        }

        //Bind links in Edit mode to Action Dropdown
        //function bindLinksInEditMode(NewEmployeeID, NewEmployeeName, NewProjectEmployeeRoleID) {
        var IsAllowed = "";
        function bindLinksInEditMode() {

             IsAllowed = AllowedtoReleaseResource(NewProjectEmployeeRoleID);
            //alert(IsAllowed);
            ResourceParameters = {
                ProjectEmployeeRoleID: encodeURI(NewProjectEmployeeRoleID),
            }
            var param = JSON.stringify(ResourceParameters);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetResourcesLinks", param, false);
            var strHTML = '';
            $("#ulARAction").html('');
            for (i = 0; i < strResult.length; i++) {
                var LinkID = strResult[i].LinkID;
                var LinkName = strResult[i].LinkName;

                if (LinkName == "Release") {
                    strHTML += '<li>'
                    strHTML += '<a href = "#" class="ResourceReleaseBtn" id="ResourceRelease_' + NewProjectEmployeeRoleID + '" onclick=ResourceRelease_Onclick(' + NewEmployeeID + ',&quot;' + escape(NewEmployeeName) + '&quot;,' + NewProjectEmployeeRoleID + ') > ' + LinkName + '</a >'
                    strHTML += '</li>'
                }
                /*Added By Dipali V On 6th Feb 2021 For Microlink Customzation*/
                else if (LinkName == "Re-assign") {
                    strHTML += '<li>'
                    strHTML += '<a href = "#" class="ResourceReassignBtn" id="ResourceReassign_' + NewProjectEmployeeRoleID + '" onclick=ResourceReassign_Onclick(' + NewEmployeeID + ',&quot;' + escape(NewEmployeeName) + '&quot;,' + NewProjectEmployeeRoleID + ') > ' + LinkName + '</a >'
                    strHTML += '</li>'
                }
                /*End of Added By Dipali V On 6th Feb 2021 For Microlink Customzation*/
               
                else if (IsAllowed == "") {
                    if (LinkName == "Change Allocation") {
                        strHTML += '<li>'
                        strHTML += '<a href = "#" class="ChangeAllocationBtn" id="ChangeAllocation_' + NewProjectEmployeeRoleID + '" onclick=ChangeAllocation_Onclick(' + NewEmployeeID + ',&quot;' + escape(NewEmployeeName) + '&quot;,' + NewProjectEmployeeRoleID + ') > ' + LinkName + '</a >'
                        strHTML += '</li>'
                    }
                    if (LinkName == "Extend Request") {
                        strHTML += '<li>'
                        strHTML += '<a href = "#" class="ExtendRequestBtn" id="ExtendRequest_' + NewProjectEmployeeRoleID + '" onclick=ExtendRequest_Onclick(' + NewEmployeeID + ',&quot;' + escape(NewEmployeeName) + '&quot;,' + NewProjectEmployeeRoleID + ') > ' + LinkName + '</a >'
                        strHTML += '</li>'
                    }
                    if (LinkName == "Prepone Release") {
                        strHTML += '<li>'
                        strHTML += '<a href = "#" class="PreponeReleaseBtn" id="PreponeRelease_' + NewProjectEmployeeRoleID + '" onclick=PreponeRelease_Onclick(' + NewEmployeeID + ',&quot;' + escape(NewEmployeeName) + '&quot;,' + NewProjectEmployeeRoleID + ') > ' + LinkName + '</a >'
                        strHTML += '</li>'
                    }
                }
                $("#ulARAction").html('');
                $("#ulARAction").append(strHTML);
            }
            if (IsAllowed != "") {
                $("#ulARAction #ResourceRelease_" + NewProjectEmployeeRoleID).css("cursor", "not-allowed");
                $("#ChangeAllocation_" + NewProjectEmployeeRoleID).css("display", "none");
                $("#ExtendRequest_" + NewProjectEmployeeRoleID).css("display", "none");
                $("#PreponeRelease_" + NewProjectEmployeeRoleID).css("display", "none");
            }
            //Added By Rutuja D. 10 Jan 2020 For Project is Onhold
            CheckProjectOnHold();
            CheckIsProjectCreationWorkflowReqd();
            if (IsProjectCreationWorkflowReqd == 1) {
                if (BaselineNumber == 0) {
                    $("#btnSaveResource").hide();
                    $("#ChangeAllocation_" + NewProjectEmployeeRoleID).hide();
                    $("#ExtendRequest_" + NewProjectEmployeeRoleID).hide();
                    $("#PreponeRelease_" + NewProjectEmployeeRoleID).hide();
                }
                else if (ProjectOnHold == 1) {
                    $("#btnSaveResource").hide();
                    $("#ChangeAllocation_" + NewProjectEmployeeRoleID).hide();
                    $("#ExtendRequest_" + NewProjectEmployeeRoleID).hide();
                    $("#PreponeRelease_" + NewProjectEmployeeRoleID).hide();
                }
                else {
                    $("#btnSaveResource").show();
                    $("#ChangeAllocation_" + NewProjectEmployeeRoleID).show();
                    $("#ExtendRequest_" + NewProjectEmployeeRoleID).show();
                    $("#PreponeRelease_" + NewProjectEmployeeRoleID).show();
                }
            }
            else {
                $("#btnSaveResource").show();
                $("#ChangeAllocation_" + NewProjectEmployeeRoleID).show();
                $("#ExtendRequest_" + NewProjectEmployeeRoleID).show();
                $("#PreponeRelease_" + NewProjectEmployeeRoleID).show();
            }
            //End Added By Rutuja D. 10 Jan 2020 For Project is Onhold

        }


        var ajaxResult;
        function AJAXCallWithResult(url, param, async) {

            $.ajax({
                url: encodeURI(strUrl + url),
                type: "POST",
                data: param,
                async: async,
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (param) {
                        xhr.setRequestHeader("Params", encryptString(isJson(param) ? param : JSON.stringify(param)));
                    }
                },
                success: function (data) {
                    ajaxResult = data;
                },
                error: function (err) {
                    ajaxResult = undefined;
                   
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
            return ajaxResult;
        }

        function ajaxCall(url, type, contentType, dataType, data) {
            var ajaxResult;

            $.ajax({
                url: url,
                type: "POST",
                data: data,
                async: false,
                dataType: "json",
                contentType: "application/json;charset-utf=8",

                success: function (data) {

                    ajaxResult = data;
                },
                error: function (err) {
                    
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + "";
                }
            });
            return ajaxResult;
        }

        //Open Edit Panel on click
        function ADDEditResourceOnclick(ProjectEmployeeRoleID, EmployeeID, EmployeeName, Flag) {
           
            StartLoader("#ResourceBody");
            if (ProjectID != 0) {
                if (Flag == 0) {
                    if (ProjectEmployeeRoleID == 0) {
                        NewProjectEmployeeRoleID = 0;
                        ClearEditModeResource("AL");
                        $("#Resourceloading").hide();
                        $(".ARresourceuti").hide();
                        Mode = "Add";
                    }


                }
                else if (Flag == 1) {
                    NewProjectEmployeeRoleID = unescape(ProjectEmployeeRoleID);
                    NewEmployeeID = EmployeeID;
                    NewEmployeeName = unescape(EmployeeName);
                    $("#Resourceloading").show();
                    $(".ARresourceuti").show();
                    GetRoleInEditMode();
                    GetReportingToInEditMode();
                    GetRateAndCost(NewProjectEmployeeRoleID);
                    GetResourcesDataInEditMode(NewProjectEmployeeRoleID);
                    //GetResourcesLinkTabAcess(NewEmployeeID, NewEmployeeName, NewProjectEmployeeRoleID);
                    GetResourcePieChart(EmployeeID);
                    Mode = "Edit";
                    var IsResourceActive = AllowedtoReleaseResource(NewProjectEmployeeRoleID);
                    if (IsResourceActive != "") {
                        $("#btnSaveResource").prop("disabled", true);
                        $("#chkIsDefaultApprover").prop("disabled", true);

                    }
                    else {
                        $("#btnSaveResource").prop("disabled", false);
                        $("#chkIsDefaultApprover").prop("disabled", false);
                    }
                    //Added For Disabled Field When Resource WF is enable
                    if (IsAllowResourceAllocation == 1) {
                        $("#txtALExpectedStartDate").prop("disabled", true);
                        $("#txtALExpectedEndDate").prop("disabled", true);                       
                        $("#txtALResourcePercentage").prop("disabled", true);
                         //Added By Reshma on 17th Jan 2020
                        $("#txtALWorkHrs").prop("disabled", true);
                         //End Added By Reshma on 17th Jan 2020
                    }
                    else {
                        $("#txtALExpectedStartDate").prop("disabled", false);
                        $("#txtALExpectedEndDate").prop("disabled", false);
                        $("#txtALResourcePercentage").prop("disabled", false);
                         //Added By Reshma on 17th Jan 2020
                        $("#txtALWorkHrs").prop("disabled", false);
                         //End Added By Reshma on 17th Jan 2020
                    }

                }

                $("#ARdetailpanel").show('fast');
                $('html, body').animate({
                    scrollTop: $("#ARdetailpanel").offset().top -= 20
                }, 500);

                if ($('#ARdetailpanel').is(':visible')) {
                    $(".actioncol,#resourceloading").css("pointer-events", "none");
                    $(".dataTables_paginate ").css("pointer-events", "none");
                }
            }
            else {

                alertify.error('<%= MyBase.GetResourceString("A_SelectProject") %>');
                document.getElementById("cboProjects").focus();
            }

            //GetResourcesList(ProjectID, QueryText);
            //$($.fn.dataTable.tables(true)).css('width', '100%'); $($.fn.dataTable.tables(true)).DataTable().columns.adjust().draw(); 
            //Added by Chetan M on 12 Nov 2020 for loading continuosly
            StopAjaxLoader("#ResourceBody");
            //End of Added by Chetan M on 12 Nov 2020 for loading continuosly
            $("#TopDiv select").prop("disabled", true);
            $(".toplinkss").css("pointer-events", "none");
            $("#ResourceFilter").css("pointer-events", "none");
            setTimeout(function () {
                $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
            }, 350);//Added by pradip on 10-01-2020

            //Added By Rutuja D. 14 Jan 2020 For Check Project Is OnHold
            CheckProjectOnHold();
            CheckIsProjectCreationWorkflowReqd();
            
            if (IsProjectCreationWorkflowReqd == 1) {
                if (BaselineNumber == 0) {
                    $("#btnSaveResource").hide();

                }
                else if (ProjectOnHold == 1) {
                    $("#btnSaveResource").hide();
                }
                else {
                    $("#btnSaveResource").show();
                }
            }
            else if (ProjectOnHold == 1) {
                $("#btnSaveResource").hide();
            }
            else {
                $("#btnSaveResource").show();
            }
            //End Added By Rutuja D. 14 Jan 2020 For Check Project Is OnHold



        }

        //clear Resource fields in filter edit mode
        function ClearEditModeResource(Resource) {
            $("[id*=txt" + Resource + "]").each(function (obj) {
                var txt = this.id;
                $("#" + txt).val('').change();
            });
            $("#chkIsResourceBillable").prop('checked', false);
            $("#chkIsDefaultApprover").prop('checked', false);

        }

        //Start Edit Resource Functionality

        //function for check Is Agile or Not
        function CheckIsAgileProject(ProjectID) {
            var ResourceParameters = {
                ProjectID: encodeURI(ProjectID),
            }
            var param = JSON.stringify(ResourceParameters);
            var strResult = AJAXCallWithResult("/api/PM_Resources/CheckIsAgileProject", param, false);
            if (strResult != undefined) {
                return strResult;
            }

        }

        //Get Role Dropdown in Edit Mode
        function GetRoleInEditMode() {
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetRoleInEditMode", '', false);
            if (strResult != "") {
                var objCbo1 = document.getElementById("txtALRoleDescription");
                $("#txtALRoleDescription option").remove();

                for (var i = 0; i < strResult.length; i++) {
                    var Objresult = strResult[i];
                    var objOption = document.createElement("OPTION");
                    objCbo1.options.add(objOption);
                    objOption.value = Objresult.RoleID;
                    objOption.text = Objresult.RoleDescription;
                }
            }
        }

        //Get ReportingTo Dropdown data

        function GetReportingToInEditMode() {
            var IsExternal = "";
            var ChkIsExternal = "";
            var strResult1 = ResourceDetailsForIsExternal();
            var ResourceParameters = {
                ProjectID: encodeURI(ProjectID),
            }
            var param = JSON.stringify(ResourceParameters);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetReportingToInEditMode", param, false);
            if (strResult != "") {
             
                var objCbo1 = document.getElementById("txtALReportingTo");
                $("#txtALReportingTo option").remove();
                $("#txtALReportingTo optgroup").remove();

                //for (var i = 0; i < strResult.length; i++) {
                //    var Objresult = strResult[i];                   
                //    var objOption = document.createElement("OPTION");                   
                //    objCbo1.options.add(objOption);                                   
                //    objOption.value = Objresult.EmployeeID == null ? '' : Objresult.EmployeeID;
                //    objOption.text = Objresult.EmployeeName;

                //}

                for (var i = 0; i < strResult1.length; i++) {
                    if (strResult[i].IsExternal == null) {
                        var Objresult = strResult[i];
                        var objOption = document.createElement("OPTION");
                        objCbo1.options.add(objOption);
                        objOption.value = Objresult.EmployeeID == null ? '' : Objresult.EmployeeID;
                        objOption.text = Objresult.EmployeeName;
                    }
                    else if (strResult1[i].IsExternal != null && IsExternal != strResult1[i].IsExternal) {
                     
                        IsExternal = strResult1[i].IsExternal;
                        var objOption1 = document.createElement("optgroup");
                        //objCbo1.options.add(objOption1);
                        $("#txtALReportingTo").append(objOption1);
                        objOption1.label = IsExternal;
                        for (var j = 0; j < strResult.length; j++) {
                            ChkIsExternal = strResult[j].IsExternal;
                            if (IsExternal == ChkIsExternal) {
                                var Objresult = strResult[j];
                                var objOption = document.createElement("OPTION");
                                objCbo1.options.add(objOption);
                                objOption.value = Objresult.EmployeeID == null ? '' : Objresult.EmployeeID;
                                objOption.text = Objresult.EmployeeName;
                            }
                        }
                    }
                }

            }

        }

        function ResourceDetailsForIsExternal() {

            var ResourceParameters = {
                ProjectID: encodeURI(ProjectID),
            }
            var param = JSON.stringify(ResourceParameters);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetReportingToInEditMode", param, false);
            return strResult;
        }

        // Get Resource Data in Edit Mode
        var PreviousReportingTo = 0;
         //Addd By Dipali V On 8th Feb 2021 For Re-Assign Resource
        var GlobalResourceExpectedEndDate = "";
        var globalworkhours = "";
        var AlreadySavedExpectedStartDate = "";
            //End of Addd By Dipali V On 8th Feb 2021 For Re-Assign Resource
        function GetResourcesDataInEditMode(ProjectEmployeeRoleID) {

            $("#txtALDuration").prop('disabled', false);

            //Added By Reshma on 13th Jan 2020 If Project Over or not in edit resource
            if (ProjectOver != "1") {
                $("#btnSaveResource").show();
                $("#ARAction").show();
            }
            else {
                $("#btnSaveResource").hide();
                $("#ARAction").hide();
            }
            //End Added By Reshma on 13th Jan 2020 If Project Over or not in edit resource
                 
            var IsProductOwner = "";
            IsAgile = CheckIsAgileProject(ProjectID);
            if (IsAgile == 0) {
                $("#divIsProductOwner").hide();
            }
            else {
                $("#divIsProductOwner").show();
                IsProductOwner = ChkIsProductOwnerorNot();
            }


            

            var ResourceParameters = {
                ProjectEmployeeRoleID: encodeURI(ProjectEmployeeRoleID),
            }

            var param = JSON.stringify(ResourceParameters);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetResourcesDataInEditMode", param, false);
           
            if (strResult != "") {
                for (i = 0; i < strResult.length; i++) {
                    var Role = strResult[i].Role;
                    var RoleDescription = strResult[i].RoleDescription;
                    var ExpectedStartDate = strResult[i].ExpectedStartDate;
                    var ExpectedEndDate = strResult[i].ExpectedEndDate;
                    //Addd By Dipali V On 8th Feb 2021 For Re-Assign Resource
                    GlobalResourceExpectedEndDate = strResult[i].ActualEndDate;
                    //End of Addd By Dipali V On 8th Feb 2021 For Re-Assign Resource
                    var Days = GetDurationDays(ExpectedStartDate, ExpectedEndDate);
                    var ReportingTo = strResult[i].ReportingTo;
                    var EmployeeName = strResult[i].EmployeeName;
                    var ResourcePercentage = strResult[i].ResourcePercentage;
                    var Work = strResult[i].BudgetedHours;
                    var ResourceStatus = strResult[i].ResourceStatus;
                    var Responsibility = strResult[i].Responsibility;
                    var IsResourceBillable = strResult[i].IsResourceBillable;
                    var IsDefaultApprover = strResult[i].IsDefaultApprover;
                       //Added By Reshma on 14th jan 2020
                       gblRequestID = strResult[i].RequestID;
                       //Added By Reshma on 14th jan 2020
                    //Added By Reshma on 13th Jan 2020 For Tofixed
                    if (ResourcePercentage != 0 || ResourcePercentage != undefined || ResourcePercentage != null) {
                        ResourcePercentage = ResourcePercentage.toFixed(2);
                    }
                    else {
                        ResourcePercentage = ResourcePercentage;
                    }
                    //End Added By Reshma on 13th Jan 2020 For Tofixed
                  
                    if (Role == null || Role == 0) {
                        Role = "0";
                    }

                    var exists = false;
                    $('#txtALRoleDescription option').each(function () {
                        if (this.value == Role) {
                            exists = true;
                            $("#txtALRoleDescription").val(Role);
                            return false;

                        }
                    });

                    if (exists == false) {
                        $("#txtALRoleDescription option:selected").text("Project Role Is Not Specified");
                    }
                    //$("#txtALRoleDescription").val(Role);
                    $("#txtALExpectedStartDate").val(ExpectedStartDate);
                    
                    $("#txtALExpectedEndDate").val(ExpectedEndDate);
                    $("#txtALDuration").val(Days);
                    $("#txtALReportingTo").val(ReportingTo);
                    $("#txtALResource").val(EmployeeName);
                    $("#txtALResourcePercentage").val(ResourcePercentage);
                    $("#txtALWorkHrs").val(Work);
                    globalworkhours = Work;
                     AlreadySavedExpectedStartDate = ExpectedStartDate;
                    //ADDED BY DIPALI VEKHANDE ON 2ND JAN 2020 FOR PLACEHOLDER
                    if (ResourceStatus == "N/A" || ResourceStatus == 0) {
                        //Added by Chetan M on 12th Jan 2020 for IssueID = 21303
                        $("#txtALResourceStatus").val('');
                        //End of added by Chetan M on 12th Jan 2020
                        //$("#txtALResourceStatus option:selected").text("Select Status")
                    } else {
                        $("#txtALResourceStatus").val(ResourceStatus);
                    }
                    //END OF ADDED BY DIPALI VEKHANDE ON 2ND JAN 2020 FOR PLACEHOLDER
                    $("#txtALResponsibility").val(Responsibility);
                    $("#spanRole").text(RoleDescription);

                    if (IsResourceBillable == true) {
                        $("#chkIsResourceBillable").prop('checked', true);
                    }
                    else {
                        $("#chkIsResourceBillable").prop('checked', false);
                    }
                    if (IsDefaultApprover == true) {
                        $("#chkIsDefaultApprover").prop('checked', true);
                    }
                    else {
                        $("#chkIsDefaultApprover").prop('checked', false);
                    }

                }
            }

            if (IsProductOwner == "True") {
                $("#chkIsProductOwner").prop('checked', true);
            }
            else {
                $("#chkIsProductOwner").prop('checked', false);
            }
            $("#txtALResource").prop('disabled', true);
            $("#txtALDuration").prop('disabled', true);
            PreviousReportingTo = ReportingTo;

           

        }

        //Function for check IsProductOwner
        function ChkIsProductOwnerorNot() {
            var ResourceParameters = {
                ProjectID: encodeURI(ProjectID),
                ProjectEmployeeRoleID: encodeURI(NewProjectEmployeeRoleID),
            }
            var param = JSON.stringify(ResourceParameters);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetIsProductOwner", param, false);
            if (strResult != undefined) {
                return strResult;
            }
        }



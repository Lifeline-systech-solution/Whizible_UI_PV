                        else {
                            SkillPlotHTML += "<td>"
                            SkillPlotHTML += SkillHTML
                            SkillPlotHTML += "</td>"
                            SkillPlotHTML += "<td>"
                            SkillPlotHTML += SkillHTML1
                            SkillPlotHTML += "</td>"
                        }

                        SkillPlotHTML += "</tr>"
                    }
                }
            
            SkillPlotHTML += "</tbody>"
            SkillPlotHTML += "</table>"
            SkillPlotHTML += "<br>"
            $("#DivRemployeeskills").html('');
            $("#DivRemployeeskills").html(SkillPlotHTML);

            for (var i = 0; i < strResult.length; i++) {
                $('#cboYRow_' + strResult[i].ToolID).val(arrEmployeeYears[i]);
                $('#cboMRow_' + strResult[i].ToolID).val(arrEmployeeMonths[i]);
            }
        }



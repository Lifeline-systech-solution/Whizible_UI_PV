                                    arrmonth = [];
                                    arrRate = [];
                                    arryear = [];
                                    $("#tbodySkill").html("");
                                }
                            }

                        }
                    } else {

                        StopAjaxLoader("#AddNewResource");
                       alertify.set('notifier', 'position', 'top-right');

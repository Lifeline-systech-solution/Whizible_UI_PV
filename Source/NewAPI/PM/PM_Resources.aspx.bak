                            var inputTextBox = '<%=CommonFunctions.HTMLControls.DrawTextBox("cboYRow_" + "intToolID", "cboYRow_" + "intToolID", "form-control", ,,,, , , ToBeInserted:="onkeypress='return restrictAlphabets(event)' autocomplete='Off' maxlength='2'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                            //End Added By Reshma Maxlength property on 8th Jan 2020 For IssueID-21282
                            inputTextBox = inputTextBox.replace(/intToolID/g, m_intToolID);
                            SkillHTML += inputTextBox


                        }
                        if (m_intMonthsToBeShown > 0) {
                            //Added By Reshma Maxlength property on 8th Jan 2020 For IssueID-21282
                            var inputTextBox = '<%=CommonFunctions.HTMLControls.DrawTextBox("cboMRow_" + "intToolID", "cboMRow_" + "intToolID", "form-control", ,,,, , , ToBeInserted:="onkeypress='return restrictAlphabets(event)' autocomplete='Off' maxlength='2'", returnHTML:=True, EnableHTMLEncode:=True, TabIndex:=1).ToString.Replace("'", "\'")%>';
                            //End Added By Reshma Maxlength property on 8th Jan 2020 For IssueID-21282
                            inputTextBox = inputTextBox.replace(/intToolID/g, m_intToolID);
                            SkillHTML1 += inputTextBox

                        }


                        if (m_intToolID != "") {
                            strSkillId += m_intToolID + ",";
                        }

                        SkillPlotHTML += "<tr>"
                        SkillPlotHTML += "<td align='center noWrap' id='ToolID_" + m_intToolID + "' class='clsToolID'>" + m_strDescription
                        SkillPlotHTML += "</td>"


                        //Added by Chetan m on 16th Jan 2020 to check user has filled timesheet or not for Issue ID =21370

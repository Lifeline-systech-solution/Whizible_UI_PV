        //Start Section For Approvers in Release Resource
        //Function for Task Approvers List
        var m_strWorkflowApprover = 0;
        var countofIRApprovers = 0;
        var countofInvoiceGenerators = 0;
        function TaskApproverList() {
            m_strWorkflowApprover = GetIsWorkflowApprover();
            var ResourceParameter = {
                ProjectID: encodeURI(ProjectID),
                EmployeeID: encodeURI(ReleaseEmployeeID)
            }
            var param = JSON.stringify(ResourceParameter);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetTaskApprovers", param, false);
            var strHTML = "";
            $("#RtaskapproversBody").html("");
            if (strResult != undefined) {
                var m_TimesheetApprovee = strResult.m_TimesheetApprovee;
                var m_ExpenseApprovee = strResult.m_ExpenseApprovee;
                var m_strDeliverableList = strResult.m_strDeliverableList;
                var m_strIssueList = strResult.m_strIssueList;
                var m_ResponsiblePersonForIssue = strResult.m_ResponsiblePersonForIssue;
                var m_ResponsiblePersonForInvoice = strResult.m_ResponsiblePersonForInvoice;
                var m_MSPFileOwner = strResult.m_MSPFileOwner;
                var m_strRisksList = strResult.m_strRisksList;
                var m_PersonResponsibleForTimesheetblocking = strResult.m_PersonResponsibleForTimesheetblocking;
                var m_strTimesheetDefaultApprover = strResult.m_strTimesheetDefaultApprover;
                var m_strExpenseDefaultApprover = strResult.m_strExpenseDefaultApprover;
                var m_StrIRApprover = strResult.m_StrIRApprover;
                var m_strInvoiceGenerator = strResult.m_strInvoiceGenerator;
                var m_TimesheetAuthenticator = strResult.m_TimesheetAuthenticator;

                if (m_TimesheetApprovee != "") {

                    GetTimesheetApproverList();
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += ' is Timesheet Approver for ' + m_TimesheetApprovee + '. Select new Timesheet Approver'
                    strHTML += '</td>'

                    strHTML += '<td align="Left" width=25%><div>' + strHTMLApprover + '</div></td>'
                    strHTML += '</tr>'

                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }
                if (m_strTimesheetDefaultApprover == "1") {
                    GetTimesheetDefaultApprover();
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += ' is Default Timesheet Approver. Select new default Timesheet Approver'
                    strHTML += '</td>'

                    strHTML += '<td align="Left" width=20%><div>' + strHTMLApprover + '</div></td>'
                    strHTML += '</tr>'

                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }
                if (m_ExpenseApprovee != "") {
                    GetExpenseApproverList();
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += ' is Expense Approver for ' + m_ExpenseApprovee + '. Select new Expense Approver'
                    strHTML += '</td>'

                    strHTML += '<td align="Left" width=20%><div>' + strHTMLApprover + '</div></td>'
                    strHTML += '</tr>'

                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }
                if (m_strExpenseDefaultApprover == "1") {
                    GetExpenseDefaultApprover();
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += ' is Default Expense Approver. Select new default Expense Approver'
                    strHTML += '</td>'

                    strHTML += '<td align="Left" width=20%><div>' + strHTMLApprover + '</div></td>'
                    strHTML += '</tr>'

                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }

                //Purpose:-To check whether resource is IRApprover or IRGenerator before releasing.
                countofIRApprovers = GetcountofIRApprovers();
                if (m_StrIRApprover == "1" && countofIRApprovers == 0) {
                    GetRFIApproverList();
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += ' is person responsible for IR Approver. Select new person responsible for IR Approver'
                    strHTML += '</td>'

                    strHTML += '<td align="Left" width=20%><div>' + strHTMLApprover + '</div></td>'
                    strHTML += '</tr>'

                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }
                else if (m_StrIRApprover == "1" && countofIRApprovers != 0) {
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += ' is IR Approver. Select new IR Approver'
                    strHTML += '</td>'
                    strHTML += '</tr>'
                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }
                //For Invoice Generator
                countofInvoiceGenerators = GetcountofInvoiceGenerators();
                if (m_strInvoiceGenerator == "1" && countofInvoiceGenerators == 0) {
                    GetAccountPersonList();
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += '  is person responsible for Invoice Generation.select new person responsible for Invoice Generation'
                    strHTML += '</td>'

                    strHTML += '<td align="Left" width=20%><div>' + strHTMLApprover + '</div></td>'
                    strHTML += '</tr>'

                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }
                else if (m_strInvoiceGenerator == "1" && countofInvoiceGenerators != 0) {
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += ' is IR Generator. Select new IR Generator'
                    strHTML += '</td>'
                    strHTML += '</tr>'
                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }
                if (m_TimesheetAuthenticator == "1") {
                    GetProjectTimesheetApprovers();
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    //Commented And Added By Reshma on 8th Jan 2020 For IssueID-21379
                    //strHTML += ' is Timesheet Authenticator. Select new Timesheet Authenticator'
                    strHTML += ' is Person Responsible for Project Timesheet Approver. Select new Person Responsible for Project Timesheet Approver'
                    //End Added By Reshma on 8th Jan 2020 For IssueID-21379
                    strHTML += '</td>'

                    strHTML += '<td align="Left" width=20%><div>' + strHTMLApprover + '</div></td>'
                    strHTML += '</tr>'

                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }
                //Deliverable Responsible Person
                if (m_strDeliverableList != "" && m_strDeliverableList != "0") {
                    GetDeliverableApproverList();
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += '  is Responsible person for Deliverables. Select new Responsible Person for Deliverables'
                    strHTML += '</td>'

                    strHTML += '<td align="Left" width=20%><div>' + strHTMLApprover + '</div></td>'
                    strHTML += '</tr>'

                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }
                //Issue Responsible Person
                if (m_strIssueList != "" && m_strIssueList != "0") {
                    GetIssueResponsiblePerson();

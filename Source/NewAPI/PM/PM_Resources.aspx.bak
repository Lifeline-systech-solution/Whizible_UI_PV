        function ExtendRequest_Onclick(EmployeeID, EmployeeName, ProjectEmployeeRoleID) {

            $("#RRExtendRequest_Detail").modal('show');
            //Added By Reshma on 14th jan 2020 
            ClearAllFields_ExtendRequest();

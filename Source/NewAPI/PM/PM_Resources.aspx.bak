    <script>

        //Added By Madhuri.K On 04-Sep-2024 for Remove tooltip 
        $('body').on('click', function () {
            $('.tooltip').remove();
        });
        //remove tooltip
        $('body').tooltip({
            selector: '[title]:not([data-bs-toggle="popover"])',
            trigger: 'hover',
            container: 'body'
        }).on('click mousedown mouseup', '[title]:not([data-bs-toggle="popover"])', function () {
           // $('[data-bs-toggle="tooltip"], [title]:not([data-bs-toggle="popover"])').tooltip('destroy');
            $('[title]:not([data-bs-toggle="popover"])').tooltip('dispose');
        });


        //Added By Pradip on 22-10-2019
        //active collapse panel
        $('.resourcereleasemodal .panel-heading a').click(function () {
            $('.resourcereleasemodal .panel-heading').removeClass('active');

            //If the panel was open and would be closed by this click, do not active it
            if (!$(this).closest('.resourcereleasemodal .panel').find('.resourcereleasemodal .panel-collapse').hasClass('in'))
                $(this).parents('.resourcereleasemodal .panel-heading').addClass('active');
        });



        //dynamically set height
        function resizeSection(tag) {
            var divheight = $(window).height();
            $('.Tabdetailpage-content').css({ 'height': divheight - 120, "overflow-y": "auto" });

            ////var divsectionheight = $(window).height();
            ////$('.content').css({ 'height': divsectionheight - 50, "overflow-y": "auto"});
        }

        $(window).on("load resize scroll", function (e) {
            resizeSection(this);
        });

        function OpenAddnewResource()
        {
          
            if ($("#cboProjects option:selected").text() == "Select Project")
            {
                alertify.error("<%= MyBase.GetResourceString("A_SelectProject") %>");
                return false;
            }
            else
            {
                //Added By Dipali V On 9th May 2023 For Project Name Truncate
                //window.location.href = "PM_Resource_Selection.aspx?ProjectID=" + ProjectID + "&ProjectName=" + $("#cboProjects option:selected").text() + "";
                window.location.href = "PM_Resource_Selection.aspx?ProjectID=" + ProjectID + "&ProjectName=" + escape($("#cboProjects option:selected").text()) + "";
            }
            
        }


        //delete row	
        $('.removerow').click(function () {
            $(this).closest('tr').hide();
        });

    </script>


    <script>
        //Added By Riddhesh Patil on 15-NOV-2022 
        var WebConfigSpecialCharacters = '<%=ConfigurationManager.AppSettings("SpecialCharactersList").ToString%>'
       //End of Added By Riddhesh Patil
        var strUrl = '<%=System.Configuration.ConfigurationManager.AppSettings("WebAPIUrl").ToString%>'

        //call updateOptions() from document.ready

        function updateOptions() {
            var cbo = ['IsResourceBillable', 'IsDefaultApprover'];
            for (var i = 0; i < cbo.length; i++) {
                AppendOptioncbo(cbo[i], '');
            }
        }

        function AppendOptioncbo(FieldName, Caption) {
            var id = "txtALFilter" + FieldName;
            if (FieldName == "IsResourceBillable") {
                FieldName = "Billable";
            } else {
                FieldName = (Caption == '' ? FieldName : Caption);
            }
            if (FieldName == "IsDefaultApprover") {
                FieldName = "Default Approver";
            } else {
                FieldName = (Caption == '' ? FieldName : Caption);
            }
            var textval = "Select " + FieldName;

            var cbofield = document.getElementById(id);
            if (cbofield != null && cbofield != undefined) {
                cbofield.insertBefore(new Option(textval, ''), cbofield.firstChild);
                $("#" + id + " option[value='']").prop('selected', true);
            }
        }


        //Restrict Special Charaters onkeypress
        function restrictSpecialChars(e) {

            var k;
            document.all ? k = e.keyCode : k = e.which;
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || k == 32 || (k >= 48 && k <= 57));
        }


        //date function Keypress
        function Date_OnKeyPress(e) {
            var keyCode = e.which ? e.which : e.keyCode

            var flag = 0;
            var ret = (e.keyCode == 8 || e.keyCode == 46)
            {
                if (e.keyCode == 8 || e.keyCode == 46) {

                }
            }
            return ret;
        }
        //Restrict alphabets onkeypress

        function restrictAlphabets(e) {

            var x = e.which || e.keycode;

            if ((x >= 48 && x <= 57) || x == 8 || (x >= 35 && x <= 40) || x == 46 || x == 58) {
                return true;
            }
            else {
                return false;
            }
        }

       

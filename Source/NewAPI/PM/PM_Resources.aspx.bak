                    GetRisksApproverList();
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += ' is Responsible person for Risks. Select new Responsible Person for Risks'
                    strHTML += '</td>'

                    strHTML += '<td align="Left" width=20%><div>' + strHTMLApprover + '</div></td>'
                    strHTML += '</tr>'

                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }
                //Responsible Person for Issue --> Project Settings
                if (m_ResponsiblePersonForIssue == "1") {
                    GetResponsiblePersonForIssueList();
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += ' is Person Responsible for Issues. Select new Person Responsible for Issues'
                    strHTML += '</td>'

                    strHTML += '<td align="Left" width=20%><div>' + strHTMLApprover + '</div></td>'
                    strHTML += '</tr>'

                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }
                if (m_ResponsiblePersonForInvoice == "1") {
                    GetResponsiblePersonForInvoiceList();
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += ' is Person Responsible for Invoice. Select new Person Responsible for Invoice'
                    strHTML += '</td>'

                    strHTML += '<td align="Left" width=20%><div>' + strHTMLApprover + '</div></td>'
                    strHTML += '</tr>'

                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }
                //MSP File Owner --> Project Settings
                if (m_MSPFileOwner == "1") {
                    GetMSPFileOwnerList();
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += ' is MSP File Owner. Select new MSP file owner'
                    strHTML += '</td>'

                    strHTML += '<td align="Left" width=20%><div>' + strHTMLApprover + '</div></td>'
                    strHTML += '</tr>'

                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }
                if (m_PersonResponsibleForTimesheetblocking == "1") {
                    GetTimesheetblockingResponsiblePerson();
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += ' is Person Responsible For Timesheet blocking. Select new Person Responsible for Timesheet blocking'
                    strHTML += '</td>'//Modified by pradip on 08-01-2019

                    strHTML += '<td align="Left" width=20%><div>' + strHTMLApprover + '</div></td>'
                    strHTML += '</tr>'

                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }
                if (m_strWorkflowApprover == "1") {
                    GetWorkflowApproverList();
                    strHTML += '<tr>'
                    strHTML += '<td align="Left" width=80%>' + ReleaseEmployeeName
                    strHTML += ' is resposible for workflow approvals. Select the new approver'
                    strHTML += '</td>'

                    strHTML += '<td align="Left" width=20%><div>' + strHTMLApprover + '</div></td>'
                    strHTML += '</tr>'

                    $("#RtaskapproversBody").html("");
                    $("#RtaskapproversBody").append(strHTML);
                }

            }
        }


        function ResourceDetails(Flag) {
            
            var ResourceParameters = {
                ProjectID: encodeURI(ProjectID),
                EmployeeID: encodeURI(ReleaseEmployeeID),
                StrFlag: encodeURI(Flag)
            }
            var param = JSON.stringify(ResourceParameters);
            var strResult = AJAXCallWithResult("/api/PM_Resources/ResourceDetails", param, false);
            return strResult;
        }


        //Function for get Timesheet ApproverList
        function GetTimesheetApproverList() {
            //alert();
           
            //added by dipali V On 9th Jan 2020 For Dropdown Formate Change
            var IsExternal = "";
            var ChkIsExternal = "";
            var strResult1 = ResourceDetails('TimesheetApprover');

            var ResourceParameters = {
                ProjectID: encodeURI(ProjectID),
                EmployeeID: encodeURI(ReleaseEmployeeID)
            }
            //End of added by dipali V On 9th Jan 2020 For Dropdown Formate Change

            //added by dipali V On 9th Jan 2020 For Dropdown Formate Change
            var param = JSON.stringify(ResourceParameters);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetApproverList", param, false);
            strHTMLApprover = "";
            var select = "Select Approver";
            if (strResult.length > 0) {
                strHTMLApprover += '<select id="cboTimesheetApprover" name="cboTimesheetApprover" tabindex="1" class="form-select" selectpicker="">'
                strHTMLApprover += '<option value="' + 0 + '">' + select + '</option>';
                if (strResult != "") {
                    for (var i = 0; i < strResult1.length; i++) {
                        
                        if (strResult1[i].IsExternal != null && IsExternal != strResult1[i].IsExternal) {
                            IsExternal = strResult1[i].IsExternal;
                            var strHTMLIsExternal = "";

                            strHTMLApprover += '<optgroup label="' + IsExternal + '"</>';
                            for (var j = 0; j < strResult.length; j++) {
                                ChkIsExternal = strResult[j].IsExternal;
                                if (IsExternal == ChkIsExternal) {
                                    var Objresult = strResult[j];
                                    //var objOption = document.createElement("OPTION");
                                    //objCbo1.options.add(objOption);
                                    //objOption.value = Objresult.EmployeeID == null ? '' : Objresult.EmployeeID;
                                    //objOption.text = Objresult.EmployeeName;

                                    var EmployeeID = strResult[j].EmployeeID;
                                    var EmployeeName = strResult[j].EmployeeName;

                                    strHTMLApprover += '<option value="' + EmployeeID + '">' + EmployeeName + '</option>';
                                }
                            }
                        }
                    }
                    strHTMLApprover += '</select>';
                }
            }
            else {
                strHTMLApprover += '<select id="cboTimesheetApprover" name="cboTimesheetApprover" tabindex="1" class="form-select" selectpicker="">'
                strHTMLApprover += '<option value="' + 0 + '">' + select + '</option>';
                strHTMLApprover += '<option value=""></option>';
                strHTMLApprover += '</select>';
            }
        }

        });

        //To clear the applied filter arrow after click on clear filter button
        function ClearAppliedFilter(GlobalApplyID) {
            var sibling = $('label[id^="Apply"]');
            $(sibling).each(function () {
                var id = this.id;
                if ($("#" + id).parent().find("input").prop("checked") == true) {
                    $("#" + id).parent().find("input").prop("checked", false);
                }
            });
            setTimeout(function(){
        $.fn.dataTable.tables( {visible: true, api: true} ).columns.adjust();
            }, 350);  //Added by pradip on 13-01-2020

        }

        //Set Resource Default filter
        function SetResourceDefaultFilter(DefaultID, flag) {

            var RemoveDefault = 0;
            if (flag == "Default") {
                RemoveDefault = 1;
            }

            FilterID = DefaultID.replace("Default", "");
            if (FilterID != undefined) {
                ResourceParameters = {
                    ProjectID: encodeURI(ProjectID),
                    LoginType: encodeURI(LoginType),
                    UserID: encodeURI(UserID),
                    TagID: 1019,
                    FilterID: encodeURI(FilterID),
                    Flag: encodeURI(RemoveDefault)
                }
                var param = JSON.stringify(ResourceParameters);
                var strResult = AJAXCallWithResult("/api/PM_Resources/SetDefaultFilter", param, false);
                if (strResult != undefined) {
                    if (RemoveDefault == 0) {
                        FilterID = "Apply" + FilterID;
                        ApplyCheckResourceFilter(FilterID);
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.success(strResult);
                    }
                    else {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.success("<%= MyBase.GetResourceString("A_ClearDefaultFilter") %>");
                        GetResourcesList(ProjectID, null);
                    }
                }
                if (strResult == "Set Default Filter Successfully") {
                    $("#ResourceFilter").addClass("activefilter");
                    $("#ResourceClearAllFilter").css({ 'display': 'inline-block' });
                } else {
                    $("#ResourceFilter").removeClass("activefilter");
                    $("#ResourceClearAllFilter").css({ 'display': 'none' });
                }

            }

            setTimeout(function () {
                $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
            }, 350)
        }


        //Get Milestone Default Filter
        function GetResourceDefaultFilter(TagID) {
            var ResourceParameters = {
                ProjectID: encodeURI(ProjectID),
                TagID: TagID,
                LoginType: encodeURI(LoginType),
                UserID: encodeURI(UserID)
            }
            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_Resources/GetDefaultFilter',
                type: "POST",
                data: JSON.stringify(ResourceParameters),
                dataType: "json",
                async: false,
                contentType: "application/json;charset-utf=8",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (ResourceParameters) {
                        xhr.setRequestHeader("Params", encryptString(isJson(ResourceParameters) ? ResourceParameters : JSON.stringify(ResourceParameters)));
                    }
                },
                success: function (strResult) {
                    if (strResult != undefined) {
                        FilterID = strResult.FilterID;
                        var QueryText = strResult.QueryText;
                        if (QueryText != null) {
                            var QueryText = QueryText.toString().replace(/'/g, "''");
                            $("#ResourceFilter").addClass("activefilter");
                            $("#ResourceClearAllFilter").css({ 'display': 'inline-block' });
                            $(".LIResourceALBasicFilter").addClass("active");
                        }
                        else {
                            $("#ResourceFilter").removeClass("activefilter");
                            $("#ResourceClearAllFilter").css({ 'display': 'none' });
                            $(".LIResourceALBasicFilter").removeClass("active");
                        }
                        //Added By Reshma on 9th Jan 2020 For IssueID-21367
                        GblQueryText = QueryText;
                        //End of Added By Reshma on 9th Jan 2020 For IssueID-21367
                        GlobalApplyID = "Apply" + FilterID;
                        GetResourcesCount(ProjectID, QueryText);
                        GetResourcesList(ProjectID, QueryText);                       
                        GetReportingToInFilter();
                    }
                },
                error: function (err) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
        }


        //function for Apply Check
        function ApplyCheckResourceFilter(ApplyID) {
            SearchRecords = "1";
            if (GlobalApplyID == "") {

                GlobalApplyID = ApplyID;
            }
            else if (GlobalApplyID != "") {
                GlobalApplyID = ApplyID;
            }
            else {

                ApplyID = GlobalApplyID;

            }

            FilterID = ApplyID.replace("Apply", "");

            if (FilterID != undefined) {
                ResourceParameters = {
                    FilterID: encodeURI(FilterID),
                }
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_Resources/EditFilterData',
                    type: "POST",
                    data: JSON.stringify(ResourceParameters),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (ResourceParameters) {
                            xhr.setRequestHeader("Params", encryptString(isJson(ResourceParameters) ? ResourceParameters : JSON.stringify(ResourceParameters)));
                        }
                    },
                    success: function (result) {
                        for (var i = 0; i < result.length; i++) {
                            var QueryText = result[i].WhereClause;
                        }
                        if (QueryText != null) {
                            QueryText = QueryText.toString().replace(/'/g, "''");
                        }
                        //Added By Reshma on 9th jan 2020 For IssueID-21367
                        GblQueryText = QueryText;
                        //End Added By Reshma on 9th jan 2020 For IssueID-21367
                        selectedqid = FilterID;
                        var sibling = $('label[id^="Apply"]')                      

                        if ($("#" + ApplyID).parent().find("input").prop("checked") == true) {

                            $("#" + ApplyID).parent().find("input").prop("checked", true);
                            $("#" + ApplyID).removeAttr("data-bs-original-title", "");
                            //$("#" + ApplyID).attr("title", "Applied Filter");
                            $("#" + ApplyID).attr("title", "Applied Filter");

                        }
                        else if ($("#" + ApplyID).parent().find("input").prop("checked") == false)
                        {
                            $(sibling).each(function ()
                            {
                                var id = this.id;
                                if (ApplyID == this.id)
                                {
                                    $("#" + id).parent().find("input").prop("checked", true);
                                    $("#" + id).removeAttr("title", "");
                                    //$("#" + id).attr("title", "Applied Filter");
                                    $("#" + id).attr("title", "Applied Filter");
                                }
                                else {
                                    $("#" + id).parent().find("input").prop("checked", false);
                                    $("#" + id).removeAttr("title", "");
                                   // $("#" + id).attr("title", "Apply Filter");
                                    $("#" + id).attr("title", "Applied Filter");
                                }
                            });
                        }
                        GetResourcesList(ProjectID, QueryText);
                        $("#presetfilterAR").removeClass("active");
                        $("#ResourceFilter").addClass("activefilter");
                        $("#ResourceClearAllFilter").css({ 'display': 'inline-block' });
                        //$("#ResourceALMyFiltersdropdown").css('display', 'none');

                        setTimeout(function () {
                            $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
                        }, 350);
                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
            }
            setTimeout(function(){
        $.fn.dataTable.tables( {visible: true, api: true} ).columns.adjust();
            }, 350);  //Added by pradip on 13-01-2020


        }

        $("#ResourceALBasicFilter").click(function () {

            if (GlobalApplyID != null) {
                var FilterID = GlobalApplyID.replace("Apply", "");
                $("#ResourceMyFilter").removeClass("active");
                $("li#liResourceALMyFiltersdropdown").removeClass("active");
                $(".stackbasicfilter").addClass("active");
                ResourceParameters = {
                    FilterID: encodeURI(FilterID),
                }
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_Resources/EditFilterData',
                    method: 'Post',
                    data: JSON.stringify(ResourceParameters),
                    dataType: 'json',
                    async: false,
                    contentType: "application/json",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                        if (ResourceParameters) {
                            xhr.setRequestHeader("Params", encryptString(isJson(ResourceParameters) ? ResourceParameters : JSON.stringify(ResourceParameters)));
                        }
                    },
                    success: function (result) {
                        for (var i = 0; i < result.length; i++) {
                            var QueryText = result[i].WhereClause;
                            GlobalFilterName = result[i].FilterName;
                        }
                        QueryText = QueryText.replace('E.ReportingTo', 'ReportingTo');                      
                        BindBasicFilters(QueryText, "AL");
                        var FilterName = $("#txtFilterName").val(GlobalFilterName);
                        $(".LIResourceALBasicFilter").addClass("active");

                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
            }
            else {
                $("li#liResourceALMyFiltersdropdown").removeClass("active");
                $("#presetfilterAR").addClass("active");
                ClearBasicFilter("AL");
                $("#txtFilterName").val('');
                GlobalFilterName = "";
            }

setTimeout(function(){
        $.fn.dataTable.tables( {visible: true, api: true} ).columns.adjust();
            }, 350);  //Added by pradip on 13-01-2020

        });


        //EditResources Filter 

        function ResourcesEditFilter(EditID) {

            Flag = 1;
            FilterID = EditID.replace("Edit", "");

            ////Click on Edit SaveAndApply Section Will Be Display

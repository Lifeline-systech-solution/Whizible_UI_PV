                            }
                        }
                        //End of Added by Chetan m on 16th Jan 2020 to check user has filled timesheet or not for Issue ID =21370
                        if (NotDA == 1) {
                            SkillPlotHTML += "<td></td>"
                            SkillPlotHTML += "<td></td>"

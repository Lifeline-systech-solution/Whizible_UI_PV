            <!--  Resource Release Modal end here-->

            <!-- Confirm to release Modal Start here-->
            <div id="confirmrelease" class="modal fade custmodal" role="dialog" data-keyboard="false" data-backdrop="static">
                <div class="modal-dialog modalsmall">
                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                            <h4 class="modal-title"><%= MyBase.GetResourceString("C_ResourceRelease") %></h4>
                        </div>

                        <div class="modal-body">

                            <p align="center"><%= MyBase.GetResourceString("C_ConfirmRelease") %></p>

                            <div class="form-group mt-4">
                                <div class="row">
                                    <div class="col-xs-6 col-sm-6 text-start">
                                        <button class="btn borderbtn ml-1" data-bs-dismiss="modal" onclick="Cancel_modal()"><%= MyBase.GetResourceString("C_No") %></button>
                                    </div>
                                    <div class="col-xs-6 col-sm-6">
                                        <button class="btn btnyellow ml-1 float-end" onclick="ConfirmRelease()"><%= MyBase.GetResourceString("C_Yes") %></button>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
                <div class="clearfix"></div>
            </div>
            <!-- Confirm to release  End here-->


            <!-- Re-asign resource Modal -->
            <div class="modal custmodal fade reasignreleasemodal" id="reasignreleasemodal" tabindex="-1" role="dialog" aria-labelledby="resourcerequestlabel" aria-hidden="true" data-bs-dismiss="modal">
                <div class="modal-dialog modal-md" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="">Re-assign Resource</h5>
                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <p align="center" id="Spntext"></p>

                            <div class="form-group mt-4">
                                <div class="row">
                                    <div class="col-xs-6 col-sm-6 text-start">
                                        <button class="btn borderbtn ml-1" data-bs-dismiss="modal" onclick="Cancel_modal()">No</button>
                                    </div> 
                                    <div class="col-xs-6 col-sm-6">
                                        <button class="btn btnyellow ml-1 float-end" onclick="ConfirmReassign_OnClick()">Yes</button>
                                    </div>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>

            </div>
            <!-- Modal end here-->


            <div class="modal custmodal fade reasignreleasemodal" id="FutureRequestmodal" tabindex="-1" role="dialog" aria-labelledby="resourcerequestlabel" aria-hidden="true" data-bs-dismiss="modal">
                <div class="modal-dialog modal-md" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="">Warning</h5>
                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <p align="center" id="SpnFReqtext"></p>

                            <div class="form-group mt-4">
                                <div class="row">
                                    <div class="col-xs-6 col-sm-6 text-start">
                                        <button class="btn borderbtn ml-1" data-bs-dismiss="modal" onclick="Cancel_modal()">No</button>
                                    </div> 
                                    <div class="col-xs-6 col-sm-6">
                                        <button class="btn btnyellow ml-1 float-end" onclick="ConfirmFutureReq_OnClick()">Yes</button>
                                    </div>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>

            </div>
            <!-- Modal end here-->
            


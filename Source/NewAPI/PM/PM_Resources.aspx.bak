<body class="hold-transition skin-blue-light sidebar-mini fixed" id="ResourceBody">
    <%--Commented And Added By Usha Pandit On 26.07.2020 For adding loader--%>
    <%--<div id="divPMResource">--%>
    <div id="divPMResource" class="preloader">
        <%--End Of Added By Usha Pandit On 26.07.2020 For adding loader--%>
        <!-- Content Wrapper. Contains page content -->
        <%--Commented And Added By Usha Pandit On 26.07.2020 For adding loader--%>
        <%--<div class="bgwhite resource_allocation">--%>
        <div class="bgwhite resource_allocation clsShowHide">
            <%--End Of Added By Usha Pandit On 26.07.2020 For adding loader--%>
            <!-- Content Header (Page header) -->

            <div class="graybg container-fluid pt-1 pb-1" id="TopDiv">

                <div class="row mt-1">
                    <div class="col-sm-2">
                        <%--<% CommonFunctions.HTMLControls.DrawComboBox("cboProjects", "usp_Whizible2_Sel_AccessibleProjects_ForEmployee_IssueList " & Session("intUserID"),,, "class='form-control selectpicker '",,, ) %>--%>
                        <% CommonFunctions.HTMLControls.DrawComboBox("cboProjects", "Select ''",,, "class='form-select' onChange='ChangeProject()'",,, ) %>
                       <%-- <a href="PM_NewCustomFiled.aspx">t</a>--%>
                    </div>

                    <!--Added by pradip on 14-12-2021--> 
                    <div class="col-sm-6 resourcebtnlisttop">   
                        <button id="btnAddResourceNewUI" style="background-color:white;color:#1359a6;width:150px;height:40px;border-color:#fff; border:none" display: none;" onclick="OpenAddnewResource()" class="btn btn-bitbucket" data-bs-toggle="modal">Add Resource</button>
                         <button id="btnAddResourceOldUI" style="background-color:white;color:#1359a6;width:150px;height:40px;border-color:#fff; border:none" display: none;" onclick="AddNewResource_OnClick()" class="btn btn-bitbucket" data-bs-toggle="modal">Add Resource</button>
                         <button id="btnResourceUtilization" style="background-color:white;color:#1359a6;height:40px;border-color:#fff; border:none" display: none;" onclick="OpenResourceUtilization()" class="btn btn-bitbucket" data-bs-toggle="modal">Resource Utilization</button>
                        <div class="toplinkss">
                            <%--<a href="resource_main.html" class="btn btn-white">Add Resources</a>                     
                          <a href="resource-request.html" class="btn btn-white ml-1">Resource request List</a>--%>
                        </div>

                    </div>

                    <div class="col-sm-4" style="padding-left:0;">                        
                        <div class="filter float-end">                            
                            <button data-bs-toggle="collapse" data-bs-target=".filterpanelAR" data-original-title="" title="" id="ResourceFilter">
                                <i data-bs-toggle="tooltip" data-bs-placement="bottom" title="" class="fas fa-filter" data-original-title="Filters"></i>
                            </button>
                        </div>
                        <a href="javascript:;" class="mainclearalllink inline float-end" id="ResourceClearAllFilter"><strong><%= MyBase.GetResourceString("C_ClearAll") %></strong></a>
						<!--added by pradip on 09-04-2020-->               
		                     <div class="input-group srchsresourcegrp float-end">
				                <input id="serchresrclist" type="text" placeholder="Search.." onkeyup="myFunction()" class="form-control">
				                <div class="input-group-btn">
				                    <button class="btn btn-default" type="submit" style="height:35px;"><i class="fas fa-search"></i></button>
				                </div>
		            		</div>
		            	<!--End added by pradip-->
                    </div>
                </div>

              <%--  <div class="row">
                    &emsp;<button id="btnResourceUtilization" style="background-color:white;color:#1359a6;width:150px;height:40px;border-color:#fff; border:none" display: none;" onclick="OpenResourceUtilization()" class="btn btn-bitbucket" data-bs-toggle="modal">Resource Utilization</button>
                </div>--%>
            </div>



            <!--filter_panel_section_satrts_here-->
            <div id="ALfilterpanel" class="collapse filterpanel filterpanelAR" style="border-bottom: 12px solid #eee;">
                <div class="bglightgray container-fluid pt-1 pb-1 headertopp filterpanelheader">
                    <div class="row">
                        <div class="col-md-12 col-sm-12">
                            <div class="cust_tabpanel">
                                <ul class="nav nav-tabs">
                                    <%--<li class="dropdown keep-inside-clicks-open" id="liResourceALMyFiltersdropdown">--%>
                                    <li class="dropdown" id="liResourceALMyFiltersdropdown">
                                        <a class="dropdown-toggle" href="#" data-bs-toggle="dropdown" onclick="ResourceFilters()" id="ResourceMyFilter"><%= MyBase.GetResourceString("C_MyFilters") %> </a>
                                        <ul id="ResourceALMyFiltersdropdown" class="dropdown-menu MyFiltersdropdown" role="menu">
                                            <li></li>

                                        </ul>
                                    </li>
                                    <li class="LIResourceALBasicFilter">
                                        <a href="#presetfilterAR" data-bs-toggle="tab" id="ResourceALBasicFilter"><%= MyBase.GetResourceString("C_BasicFilters") %></a>
                                    </li>

                                </ul>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="issuefilter_container">
                    <div class="tab-content issuefilter_tabcontent">
                        <div id="presetfilterAR" class="tab-pane stackbasicfilter">
                            <!--filter panel start here-->
                            <div class="filterpanelwrapbasicfilter">
                                <div class="filterpanelbody" id="">
                                    <div class="fp_button text-center hidden-xs centerbtn" style="margin: 0 0 40px;">
                                        <button class="btn btnyellow" onclick="btnResourceSaveAndApplyFilter()"><%= MyBase.GetResourceString("C_SaveandApply") %></button>
                                        <button class="btn btnyellow" onclick="ResourcebtnApplyFilter()"><%= MyBase.GetResourceString("C_Apply") %></button>
                                    </div>
                                    <div class="row hidden-xs IB_filterlist">
                                        <!--basic filter start here-->
                                        <div class="form-inline">
                                            <div class="box box-solid p1 row" style="">
                                                <div class="form-group col-sm-6">
                                                    <label for="email"><%= MyBase.GetResourceString("C_Role") %></label>
                                                    <% CommonFunctions.HTMLControls.DrawComboBox("cboALFilterRoleDescription", "usp_Whizible2_Sel_Filter_FillOperatorCombo 'COMBO'",,, "class='form-select'",,,) %>
                                                    <% CommonFunctions.HTMLControls.DrawComboBox("txtALFilterRoleDescription", "usp_Whizible2_Sel_tbl_PM_Role_PopulateComboFilter Null",,, "class='form-select '",,,) %>
                                                </div>

                                                <div class="form-group col-sm-6">
                                                    <label for="email"><%= MyBase.GetResourceString("C_Allocation") %></label>
                                                    <% CommonFunctions.HTMLControls.DrawComboBox("cboALFilterResourcePercentage", "usp_Whizible2_Sel_Filter_FillOperatorCombo 'NUM'",,, "class='form-select'",,,) %>
                                                    <% CommonFunctions.HTMLControls.DrawTextBox("txtALFilterResourcePercentage", "txtALFilterResourcePercentage", "form-control",,,,,,,,,, "onkeypress='return restrictAlphabets(event)' autocomplete='off' maxlength='5'",,, True,,,, True) %>
                                                </div>
                                              
                                                <div class="form-group col-sm-6">
                                                    <label for="email"><%= MyBase.GetResourceString("C_StartDate") %></label>

                                                    <% CommonFunctions.HTMLControls.DrawComboBox("cboALFilterExpectedStartDate", "Exec usp_Whizible2_Sel_Filter_FillOperatorCombo 'DATE'",,, "class='form-select'",) %>
                                                    <div class="input-group">
                                                        <%--<% CommonFunctions.HTMLControls.DrawTextBox("txtALFilterExpectedStartDate", "txtALFilterExpectedStartDate", "form-control",,,,,,, True,,, "autocomplete='off'",,, True,,,, True) %>--%>
                                                        <% CommonFunctions.HTMLControls.DrawTextBox("txtALFilterExpectedStartDate", "txtALFilterExpectedStartDate", "form-control", , ,,,, ,,,, "onPaste='return false' onkeypress='return Date_OnKeyPress(event)' Autocomplete='off'",,, True,,,, True) %>
                                                        <span class="input-group-btn">
                                                            <button class="btn btncalendar" type="button"><i class="fas fa-calendar-alt"></i></button>
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="form-group col-sm-6">
                                                    <label for="email"><%= MyBase.GetResourceString("C_EndDate") %></label>

                                                    <% CommonFunctions.HTMLControls.DrawComboBox("cboALFilterExpectedEndDate", "Exec usp_Whizible2_Sel_Filter_FillOperatorCombo 'DATE'",,, "class='form-select'",) %>

                                                    <div class="input-group">
                                                        <%--<% CommonFunctions.HTMLControls.DrawTextBox("txtALFilterExpectedEndDate", "txtALFilterExpectedEndDate", "form-control",,,,,,, True,,, "autocomplete='off'",,, True,,,, True) %>--%>
                                                        <% CommonFunctions.HTMLControls.DrawTextBox("txtALFilterExpectedEndDate", "txtALFilterExpectedEndDate", "form-control", , ,,,, ,,,, "onPaste='return false' onkeypress='return Date_OnKeyPress(event)' Autocomplete='off'",,, True,,,, True) %>
                                                        <span class="input-group-btn">
                                                            <button class="btn btncalendar" type="button"><i class="fas fa-calendar-alt"></i></button>
                                                        </span>
                                                    </div>
                                                </div>
                                              
                                                <div class="form-group col-sm-6">
                                                    <label for="email"><%= MyBase.GetResourceString("C_Status") %></label>
                                                    <% CommonFunctions.HTMLControls.DrawComboBox("cboALFilterResourceStatus", "Exec usp_Whizible2_Sel_Filter_FillOperatorCombo 'COMBO'",,, "class='form-select'",) %>
                                                    <% CommonFunctions.HTMLControls.DrawComboBox("txtALFilterResourceStatus", "usp_Whizible2_Sel_tbl_PM_ProjectGroupResources_WhyNonBillable",,, "class='form-control '",,,) %>
                                                </div>
                                                <div class="form-group col-sm-6">


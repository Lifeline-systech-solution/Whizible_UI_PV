        //Get RFIApprover List
        function GetProjectTimesheetApprovers() {
            var ResourceParameters = {
                ProjectID: encodeURI(ProjectID),
                EmployeeID: encodeURI(ReleaseEmployeeID),
            }
            var param = JSON.stringify(ResourceParameters);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetProjectTimesheetApprovers", param, false);
            strHTMLApprover = "";
            var select = "Select Timesheet Approver";
            if (strResult.length > 0) {
                strHTMLApprover += '<select id="cboTimesheetAuthenticator" name="cboTimesheetAuthenticator" tabindex="1" class="form-select" selectpicker="">'
                strHTMLApprover += '<option value="' + 0 + '">' + select + '</option>';
                for (var i = 0; i < strResult.length; i++) {
                    var EmployeeID = strResult[i].EmployeeID;
                    var UserName = strResult[i].UserName;
                    strHTMLApprover += '<option value="' + EmployeeID + '">' + UserName + '</option>';
                }
                strHTMLApprover += '</select>';
            }
            else {
                strHTMLApprover += '<select id="cboTimesheetAuthenticator" name="cboTimesheetAuthenticator" tabindex="1" class="form-select" selectpicker="">'
                strHTMLApprover += '<option value="' + 0 + '">' + select + '</option>';
                strHTMLApprover += '<option value=""></option>';
                strHTMLApprover += '</select>';
            }

        }


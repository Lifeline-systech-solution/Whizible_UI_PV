        //Function for Task Completion
        function ResourceRelease_Onclick(EmployeeID, EmployeeName, ProjectEmployeeRoleID) {

            $("#taskcompletionBody").html("");
            $("#taskvoidedBody").html("");

            ReleaseEmployeeID = EmployeeID;
            ReleaseEmployeeName = unescape(EmployeeName);
            ReleaseProjectEmployeeRoleID = ProjectEmployeeRoleID;
            //check is Resource End date Greater than Future date
            var IsFutureResourceEndDate = GetResourceEnddateOnProject(ReleaseProjectEmployeeRoleID);
            //check is Resource Allowed to release or not and disable button according
            var IsAllowed = AllowedtoReleaseResource(ReleaseProjectEmployeeRoleID);

            if (IsFutureResourceEndDate == "1" && IsAllowed == "") {
                $("#confirmrelease").modal('show');
                $("#ResourceRelease_" + ReleaseProjectEmployeeRoleID).prop("disabled", false);

            }
            else if (IsFutureResourceEndDate == "1" && IsAllowed != "") {
                $("#ResourceRelease_" + ReleaseProjectEmployeeRoleID).prop("disabled", true);


            }
            else if (IsFutureResourceEndDate == "0" && IsAllowed == "") {
                $("#resourcerelease").modal('show');
                $("#ResourceRelease_" + ReleaseProjectEmployeeRoleID).prop("disabled", false);

            }
            else if (IsFutureResourceEndDate == "0" && IsAllowed != "") {
                $("#ResourceRelease_" + ReleaseProjectEmployeeRoleID).prop("disabled", true);

            }

        }

        function AllowedtoReleaseResource(ReleaseProjectEmployeeRoleID) {

            var ResourceParameter = {
                ProjectEmployeeRoleID: encodeURI(ReleaseProjectEmployeeRoleID),
            }
            var param = JSON.stringify(ResourceParameter);
            var strResult = AJAXCallWithResult("/api/PM_Resources/IsAllowedReleaseResource", param, false);
            if (strResult != undefined) {
                return strResult;
            }
        }


        //Added By Dipali V On 6th Feb 2021 For Re-Assign Functionality
        function ValidateForReassign() {
            var checkval = 0;
            //debugger;
            var ExpectedStartDate = $("#txtALExpectedStartDate").val();
            var ExpectedEndDate = $("#txtALExpectedEndDate").val();
            var objRoleDesription = $("#txtALRoleDescription :selected").val();
            //alert(objRoleDesription);
            if (objRoleDesription == 0 || objRoleDesription == undefined) {
                objRoleDesription = "";
            }
            else {
                objRoleDesription = objRoleDesription;
            }
            //Added By Dipali V On 26th Feb 2021 For Alert
            if (objRoleDesription =="") {
                alertify.error('<%= MyBase.GetResourceString("A_Role") %>');
                $('#txtALRoleDescription').focus();
                checkval = 1;
            }
            //End of Added By Dipali V On 26th Feb 2021 For Alert

            if (checkval == 0) {
                if (ExpectedStartDate == "") {
                    alertify.error('<%= MyBase.GetResourceString("A_StartDate") %>');
                    $('#txtALExpectedStartDate').focus();
                    checkval = 1;
                }
                else if (ExpectedEndDate == "") {
                    alertify.error('<%= MyBase.GetResourceString("A_EndDate") %>');
                    $('#txtALExpectedEndDate').focus();
                    checkval = 1;
                }
            }

            if (checkval == 0) {
                //debugger;
                var objResourcePercentage = $("#txtALResourcePercentage").val();
                if (parseFloat(objResourcePercentage) == parseFloat("0")) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('Resource Allocation % should be greater than 0');
                    $('#txtALResourcePercentage').focus();
                    checkval = 1;
                }
            }


            if (checkval == 0) {
                var objResourcePercentage = $("#txtALResourcePercentage").val();
                var isdigit = isNumeric(objResourcePercentage);
                if (isdigit == false) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('<%= MyBase.GetResourceString("A_PositiveIntegerAllocation") %>');
                    $('#txtALResourcePercentage').focus();
                    checkval = 1;
                }
            }

            //Added By Dipali V on 26th Feb 2021 For Cheecking Work hours 
            if (checkval == 0) {
                if (parseFloat($('#txtALWorkHrs').val()) == parseFloat("00:00")) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error("Work(H:M) should be greater than 0.");
                    $('#txtALWorkHrs').focus();
                    checkval = 1;
                }
            }
            //End of Added By Dipali V on 26th Feb 2021 For Cheecking Work hours 
            if (checkval == 0) {
                if ($("#txtALReportingTo").val() == '') {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error("Reporting To should not be left blank.");
                    $("#txtALReportingTo").focus();//ADDED BY DIPALI V ON 27TH DEC 2019 FOR FOCUS ON CONTROL
                    checkval = 1;
                }
            }

            if (checkval == 0) {
                if ($("#txtALResourceStatus").val() == '') {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error("Resource Status should not be left blank.");
                    $("#txtALResourceStatus").focus();//ADDED BY DIPALI V ON 27TH DEC 2019 FOR FOCUS ON CONTROL
                    checkval = 1;
                }
            }
            //debugger;
            if (checkval == 0) {
                if (ExpectedStartDate != "" || ExpectedEndDate != "") {
                    //debugger;
                    var Datecheckval = ValidateForReassignDates(ExpectedStartDate, ExpectedEndDate);
                    //debugger;
                    if (Datecheckval == 0) {
                        checkval = 0;
                    } else {
                        checkval = 1;
                    }
                }
            }


            if (checkval == 1) {
                $("#ARdetailpanel").show('fast');
                $('html, body').animate({
                    scrollTop: $("#ARdetailpanel").offset().top -= 20
                }, 500);
            }
            return checkval; 
        }

        function ValidateForReassignDates(ExpectedStartDate, ExpectedEndDate) {
            var checkval = 0;
            //debugger;
            var result = GetProjectStartDateEndDate(ProjectID);
            for (var i = 0; i < result.length; i++) {
                var ObjDate = result[i];
                 if (Date.parse(ObjDate.expectedStartdate) > Date.parse(ExpectedStartDate)) {
                    alertify.error("Start Date should be greater than The Project Start Date " + result[i].expectedStartdate);
                    $("#txtALExpectedStartDate").focus();
                    checkval = 1;
                 }

                else if (Date.parse(ObjDate.expectedenddate) < Date.parse(ExpectedEndDate)) {
                    alertify.error("End Date should be less than The Project End Date " + result[i].expectedenddate);
                    $("#txtALExpectedEndDate").focus();
                    checkval = 1;
                 }

                 else if (Date.parse(ExpectedStartDate) > Date.parse(ExpectedEndDate)) {
                    alertify.error("End date should be greater than Start Date");
                    $("#txtALExpectedEndDate").focus();
                    checkval = 1;
                 }

                else if (Date.parse(ObjDate.expectedStartdate) > Date.parse(ExpectedStartDate) && Date.parse(ObjDate.expectedenddate) < Date.parse(ExpectedEndDate)) {
                    alertify.error("Start Date And End Date Should Be Between The Project Start Date " + result[i].expectedStartdate + " And End Date " + result[i].expectedenddate + "");
                    $("#txtALExpectedStartDate").focus();
                    checkval = 1;
                }
            }
            return checkval
        }
        
        var Allocation = 0;
        var selectedEmployeeID = 0;
        function ResourceReassign_Onclick(EmployeeID, EmployeeName, ProjectEmployeeRoleID) {
            selectedEmployeeID = EmployeeID;
           //debugger;
            if (ValidateForReassign() == 0) {
                //debugger;
                var checkval = 0;
                if (ProjectEmployeeRoleID != "") {
                    var ExpectedStartDate = $("#txtALExpectedStartDate").val();
                    var ExpectedEndDate = $("#txtALExpectedEndDate").val();
                    var ResourceAllocation = $("#txtALResourcePercentage").val();
                    if (ResourceAllocation != "") {
                        if (ResourceAllocation == "0") {
                            alertify.error("Resource Percentage should be greater than 0.");
                            $("#txtALResourcePercentage").focus();
                            checkval = 1;
                            //Added By Dipali V On 9th Feb 2021 For Details Page Should Display
                            $("#ARdetailpanel").show('fast');
                            $('html, body').animate({
                                scrollTop: $("#ARdetailpanel").offset().top -= 20
                            }, 500);
                            //End of Added By Dipali V On 9th Feb 2021 For Details Page Should Display

                        }
                    }
                }
                var AvailableAllocation = GetAllocation(ExpectedStartDate, ExpectedEndDate, EmployeeID, ProjectID, ProjectEmployeeRoleID);
                //Added By Dipali V On 11th Feb 2021 For Validate Resource Avaliable %
                var ResourceAvaliableAllocation = GetAvaliableAllocation(ExpectedStartDate, ExpectedEndDate, selectedEmployeeID, ProjectID, ProjectEmployeeRoleID);
                //debugger;
                if ($('#txtALResourcePercentage').val() != "") {
                    if (ResourceAvaliableAllocation != "") {
                        if (parseFloat($('#txtALResourcePercentage').val()) > parseFloat(ResourceAvaliableAllocation)) {
                            alertify.error('Resource Avaliable % Allocation is ' + ResourceAvaliableAllocation);
                            $('#txtALResourcePercentage').focus();
                            checkval = 1;
                        }
                    }
                }
                //Added By Dipali V On 11th Feb 2021 For Validate Resource Avaliable %
                //debugger;
                var AvailableAllocation_New = AvailableAllocation.split(",");
                var AvailableAllocation = AvailableAllocation_New[0];
                //var StrResult = AvailableAllocation_New[1].split(",");
                var ExtenResUpto = AvailableAllocation_New[1];
                var futureRquestCount = AvailableAllocation_New[2];
                //alert(IsAllowResourceAllocation);
                if (IsAllowResourceAllocation == 1) {
                    //alert(IsAllowResourceAllocation);
                    if (AvailableAllocation != "") {
                        if (AvailableAllocation < 0) {
                            alertify.error("This Resource is Overallocated and cannot be assigned on the project.");
                            $("#txtALResourcePercentage").focus();
                            checkval = 1;
                        }
                    }
                    var Restemp = parseFloat(AvailableAllocation) - parseFloat(ResourceAllocation);
                    if (Restemp.value <= 0) {
                        if (parseFloat($('#txtALResourcePercentage').val()) > parseFloat(ResourceAllocation)) {
                            alertify.error('You can enter % Allocation upto ' + ResourceAllocation + '% for this Resource.\n Please reset the allocation value.');
                            //alertify.error("This Resource is Overallocated and cannot be assigned on the project.");  
                            $("#txtALResourcePercentage").focus();
                            checkval = 1;
                        }
                    }
                }
                else {
                    var objResourcePercentage = $('#txtALResourcePercentage').val();
                    if (AvailableAllocation > ExtenResUpto) {
                        alertify.error("This Resource is Overallocated and cannot be assigned on the project.");
                        $("#txtALResourcePercentage").focus();
                        checkval = 1;
                    }
                    if (checkval == 0) {
                        if (parseFloat(objResourcePercentage) <= 0 || parseFloat(objResourcePercentage) > parseFloat(ExtenResUpto)) {
                            alertify.error('<%= MyBase.GetResourceString("A_Resourcepercentagebetween") %>');
                            $('#txtALResourcePercentage').focus();
                            checkval = 1;
                        }
                    }
                    var Restemp = parseFloat(ExtenResUpto) - parseFloat(AvailableAllocation) - parseFloat(ResourceAllocation);
                    var allowalloation = parseFloat(ExtenResUpto) - parseFloat(AvailableAllocation);
                    if (checkval == 0) {
                        if (Restemp < 0) {
                            if (parseFloat($('#txtALResourcePercentage').val()) > parseFloat(allowalloation)) {
                                //alert('You can enter % Allocation upto ' + allowalloation + '% for this Resource.\n Please reset the allocation value.');
                                alertify.error("You can enter % Allocation upto " + allowalloation + "% for this Resource.\n Please reset the allocation value.");
                                $("#txtALResourcePercentage").focus();
                                checkval = 1;
                            }
                        }
                    }
                    //futureRquestCount = 3;
                    if (futureRquestCount > 0 && checkval == 0) {
                        ConfirmFutureRquestAssigned();
                        checkval = 1;
                    }
                }

                if (checkval == 0) {
                    ConfirmReAssigned();
                }
                else {
                    //Added By Dipali V On 9th Feb 2021 For Details Page Should Display
                    $("#ARdetailpanel").show('fast');
                    $('html, body').animate({
                        scrollTop: $("#ARdetailpanel").offset().top -= 20
                    }, 500);
                    //End of Added By Dipali V On 9th Feb 2021 For Details Page Should Display
                }

            }
            else {
                $("#ARdetailpanel").show('fast');
                $('html, body').animate({
                    scrollTop: $("#ARdetailpanel").offset().top -= 20
                }, 500);
            }
        }

        //Added By Dipali V On 11th Feb 2021 For Get Resource Avaliable Allocation %
        function GetAvaliableAllocation(ExpectedStartDate,ExpectedEndDate,EmployeeID,ProjectID) {
            var AvaiableReAllocation = 0;
            var Data = {
                ExpectedStartDate: encodeURI(ExpectedStartDate),
                ExpectedEndDate: encodeURI(ExpectedEndDate),
                EmployeeID: encodeURI(EmployeeID),
                ProjectID: encodeURI(ProjectID),
               
            }
                //StartLoader
                //("#BodyCreateProject");
            $.ajax({
                url: encodeURI(strUrl + '/api/PM_Resources/GetAvaliableAllocation'),
                type: "POST",
                data: JSON .stringify(Data),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (Data) {
                        xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                    }
                },
                success: function (Result) {
                    if (Result != "") {
                        AvaiableReAllocation = Result;
                    }
                },
                error: function (err) {
                    // alert("error");
                    console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
            return AvaiableReAllocation;
                
        }
        //End of Added By Dipali V On 11th Feb 2021 For Get Resource Avaliable Allocation %


      // var selectedEmployeeID = 0;
        function GetAllocation(ExpectedStartDate,ExpectedEndDate,EmployeeID,ProjectID,ProjectEmployeeRoleID) {
            var AvaiableAllocation = 0;
            var AvaiableReAllocation = 0;
            var FutureRequest = 0;
           
            var Data = {
                ExpectedStartDate: encodeURI(ExpectedStartDate),
                ExpectedEndDate: encodeURI(ExpectedEndDate),
                EmployeeID: encodeURI(EmployeeID),
                ProjectID: encodeURI(ProjectID),
                ProjectEmployeeRoleID: encodeURI(ProjectEmployeeRoleID)
            }
                //StartLoader
                //("#BodyCreateProject");
            $.ajax({
                url: encodeURI(strUrl + '/api/PM_Resources/GetAllocation'),
                type: "POST",
                data: JSON .stringify(Data),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (Data) {
                        xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                    }
                },
                success: function (Result) {
                    //debugger;
                    var Result = Result.split(",");
                    AvaiableAllocation = Result[0];
                    //var StrResult = Result[1].split(",");
                    AvaiableReAllocation = Result[1];
                    FutureRequest= Result[2];
                    //FutureRequest
                    //AvaiableReAllocation = AvaiableAllocation[0];
                },
                error: function (err) {
                    // alert("error");
                    console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
            return AvaiableAllocation + "," + AvaiableReAllocation + "," + FutureRequest;
        }
        var allowfuturerequestcancel = 0;
        function ConfirmFutureRquestAssigned() {
            $("#FutureRequestmodal").modal('hide');
            $("#FutureRequestmodal").modal('show');
            $("#SpnFReqtext").text('');
            //alert(GlobalResourceExpectedEndDate);
            $("#SpnFReqtext").text('Reassigning Resource will cancel all approved future requests for the selected resource.Press [Yes] to Continue and [No] to stay on the page');
            $(".modal, .modal-backdrop").css("overflow-y", "auto");
        }
        
        function ConfirmReAssigned() {
            $("#reasignreleasemodal").modal('hide');
            $("#reasignreleasemodal").modal('show');
            $("#Spntext").text('');
           // alert()
            var intputvalue = $("#txtALWorkHrs").val();
            var ActualStartDate = $("#txtALExpectedStartDate").val();
            //GetResourcesDataInEditMode(NewProjectEmployeeRoleID);
            //debugger;//
            if (intputvalue != globalworkhours) {
                $("#txtALWorkHrs").val(intputvalue);
            }
            else {
                $("#txtALWorkHrs").val(globalworkhours);
            }

            //Added By Dipali V On 27th Feb 2021 For Selected value should saved
            if (ActualStartDate != AlreadySavedExpectedStartDate) {
                $("#txtALExpectedStartDate").val(ActualStartDate);
            }
            else {
                $("#txtALExpectedStartDate").val(AlreadySavedExpectedStartDate);
            }
             //End of Added By Dipali V On 27th Feb 2021 For Selected value should saved
           // alert(GlobalResourceExpectedEndDate);
            var objCurrentDate = $("#txtToday").val();
            //var objCurrentDate = 
            //debugger;
            if (GlobalResourceExpectedEndDate == "" || GlobalResourceExpectedEndDate == "'") {
                GlobalResourceExpectedEndDate = objCurrentDate;
            }
            else {
                GlobalResourceExpectedEndDate = GlobalResourceExpectedEndDate;
            }
            //if (objCurrentDate > $("#txtALExpectedStartDate").val()) {
                $("#Spntext").text('Expected Start Date should be greater than earlier Actual end date (' + GlobalResourceExpectedEndDate + ').Press [Yes] to Continue and [No] to stay on the page');
            //}
            //else {
            //     $("#Spntext").text('Are you sure,you want to re-assign resource.Press [Yes] to Contioue and [No] to stay on the page');
           
            //}
             $(".modal, .modal-backdrop").css("overflow-y", "auto");
        }
        
        function ConfirmFutureReq_OnClick() {
            allowfuturerequestcancel = 1;
            if (allowfuturerequestcancel == 1)
            { 
                $("#FutureRequestmodal").modal('hide');
                ConfirmReAssigned();
            }
            else {
                //Added By Dipali V On 9th Feb 2021 For Details Page Should Display
                $("#ARdetailpanel").show('fast');
                $('html, body').animate({
                    scrollTop: $("#ARdetailpanel").offset().top -= 20
                }, 500);
                //End of Added By Dipali V On 9th Feb 2021 For Details Page Should Display
            }
        }

        function ConfirmReassign_OnClick() {
            var IsBillableChecked = "";
            if ($("#chkIsResourceBillable").is(":checked")) {
                IsBillableChecked = 1;
            }
            else {
                IsBillableChecked = 0;
            }

            var ProjectRoleID = $("#txtALRoleDescription").val();
            var ExpectedStartDate = $("#txtALExpectedStartDate").val();
            var ExpectedEndDate = $("#txtALExpectedEndDate").val();
            var EmployeeID = selectedEmployeeID;
            var ResourcePercentage = $("#txtALResourcePercentage").val();
            var Responsibility = $("#txtALResponsibility").val();
            var BudgetedHours = $("#txtALWorkHrs").val();
            var ResourceStatus = $("#txtALResourceStatus").val();
            var IsResourceBillable = IsBillableChecked;
            var ReportingTo = $("#txtALReportingTo").val();
            /* Added By Dipali V On 8th Feb 2021 For Re-Assign */
            //debugger;
            if (ResourceStatus == "") {
                ResourceStatus = 'Null';
            }
            if (Responsibility == "") {
                Responsibility = '';
            }

            if (ReportingTo == "") {
                ReportingTo = 'Null';
            }
            /* End of Added By Dipali V On 8th Feb 2021 For Re-Assign */
            var Data = {
                ExpectedStartDate: encodeURI(ExpectedStartDate),
                ExpectedEndDate: encodeURI(ExpectedEndDate),
                EmployeeID: encodeURI(EmployeeID),
                ProjectID: encodeURI(ProjectID),
                ProjectRoleID: encodeURI(ProjectRoleID),
                ResourcePercentage: encodeURI(ResourcePercentage),
                Responsibility: encodeURI(Responsibility),
                BudgetedHours: encodeURI(BudgetedHours),
                ResourceStatus: encodeURI(ResourceStatus),
                CreatedBy:encodeURI('<%= Session("strUserName") %>'),
                IsResourceBillable: encodeURI(IsResourceBillable),
                ReportingTo: encodeURI(ReportingTo),
                UserID:encodeURI('<%= Session("intUserID") %>')  //Added By Nikhil A.
            }
            //StartLoader("#BodyCreateProject");
            $.ajax({
                url: encodeURI(strUrl + '/api/PM_Resources/GetReAssignResource'),
                type: "POST",
                data: JSON.stringify(Data),
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (Data) {
                        xhr.setRequestHeader("Params", encryptString(isJson(Data) ? Data : JSON.stringify(Data)));
                    }
                },
                success: function (Result) {
                    //alert(Result);
                    if (Result != "") {
                        if (Result == "1") {
                            //debugger;
                            $("#btnSaveResource").removeAttr("disabled");
                            $("#reasignreleasemodal").modal('hide');
                            $("#reasignreleasemodal").removeClass('in');
                            setTimeout(function () {
                                //alertify.dismissAll();
                               alertify.success("Resource Re-assigned successfully");
                            }, 3000);
                            //Commented And By Nikhil A. Resource Reassign Issue
                            //window.open("../Email/SendEmail.aspx?MessageID=15&ProjectEmployeeRoleID=" + ProjectRoleID + "&ProjectID=" + ProjectID + "&UserID=" + UserID + "", '', 'resizable=yes,scrollbars=yes,toolbar=no,statusbar=no,left=200,top=100,width=650,height=550');
                            window.open("../Email/SendEmail.aspx?MessageID=15&ProjectEmployeeRoleID=" + ProjectRoleID + "&ProjectID=" + ProjectID + "&UserID=" + UserID + "&EmployeeID="+ EmployeeID +"", '', 'resizable=yes,scrollbars=yes,toolbar=no,statusbar=no,left=200,top=100,width=650,height=550');
                            GetResourcesList(ProjectID, QueryText);
                            Cancel_modal();
                        }
                    }
                },
                error: function (err) {
                    // alert("error");
                    // console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
        } 



         //End of Added By Dipali V On 6th Feb 2021 For Re-Assign Functionality

        //Resource End date On Project
        function GetResourceEnddateOnProject(ReleaseProjectEmployeeRoleID) {
            var ResourceParameter = {
                ProjectEmployeeRoleID: encodeURI(ReleaseProjectEmployeeRoleID),
            }
            var param = JSON.stringify(ResourceParameter);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetResourceEnddate", param, false);

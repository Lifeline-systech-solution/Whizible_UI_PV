        //Get Total days on Project
        function GetTotalMonthsAndDays() {
            var ResourceParameter = {
                ProjectID: encodeURI(ProjectID),
                ProjectEmployeeRoleID: encodeURI(ReleaseProjectEmployeeRoleID)
            }
            var param = JSON.stringify(ResourceParameter);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetProjectEmployeeWorkPeriod", param, false);
            if (strResult != undefined) {
                blnHasEmpRecord = true;
                m_intTotalDays = strResult.m_intTotalDays;
                GetYearsMonthsAndDays(m_intTotalDays);

            }
        }

        //Get Years and Months
        function GetYearsMonthsAndDays(m_intTotalDays) {
            var intDays;
            intDays = m_intTotalDays
            m_intEmployeeYears = (intDays / 365).toFixed(0);
            intDays = intDays % 365;

            if (intDays == 365) {
                m_intEmployeeMonths = 12;
                m_intEmployeeDays = 0;
            }
            else if (intDays >= 334) {
                m_intEmployeeMonths = 11;
                m_intEmployeeDays = intDays - 334;
            }
            else if (intDays >= 304) {
                m_intEmployeeMonths = 10;
                m_intEmployeeDays = intDays - 304;
            }
            else if (intDays >= 273) {
                m_intEmployeeMonths = 9;
                m_intEmployeeDays = intDays - 273;
            }
            else if (intDays >= 243) {
                m_intEmployeeMonths = 8;
                m_intEmployeeDays = intDays - 243;
            }
            else if (intDays >= 212) {
                m_intEmployeeMonths = 7;
                m_intEmployeeDays = intDays - 212;
            }
            else if (intDays >= 181) {
                m_intEmployeeMonths = 6;
                m_intEmployeeDays = intDays - 181;
            }
            else if (intDays >= 151) {
                m_intEmployeeMonths = 5;
                m_intEmployeeDays = intDays - 151;
            }
            else if (intDays >= 120) {
                m_intEmployeeMonths = 4;
                m_intEmployeeDays = intDays - 120;
            }
            else if (intDays >= 90) {
                m_intEmployeeMonths = 3;
                m_intEmployeeDays = intDays - 90;
            }
            else if (intDays >= 59) {
                m_intEmployeeMonths = 2;
                m_intEmployeeDays = intDays - 59;
            }
            else if (intDays >= 31) {
                m_intEmployeeMonths = 1;
                m_intEmployeeDays = intDays - 31;
            }
            else {
                m_intEmployeeMonths = 0;
                m_intEmployeeDays = intDays;
            }

        }


        //Get MPP Task Details for Employee
        function GetMPPTaskDetails() {
            var ResourceParameter = {
                ProjectID: encodeURI(ProjectID),
                EmployeeID: encodeURI(ReleaseEmployeeID)
            }
            var param = JSON.stringify(ResourceParameter);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetMPPTaskDetails", param, false);

            var strHTML = "";
            $("#RMPPtaskdetailsBody").html('');
            if (strResult != undefined) {
                if (strResult.length > 0) {
                    for (i = 0; i < strResult.length; i++) {
                        var TaskID = strResult[i].TaskID;
                        var TaskName = strResult[i].TaskName;
                        var UserName = strResult[i].UserName;
                        var StartDate = strResult[i].StartDate;
                        var EndDate = strResult[i].EndDate;

                        strHTML += '<tr>'
                        strHTML += '<td>' + TaskName + '</td>'
                        strHTML += '<td>' + UserName + '</td>'
                        strHTML += '<td>' + StartDate + '</td>'
                        strHTML += '<td>' + EndDate + '</td>'

                        strHTML += '</tr>'

                    }
                }
                else {
                    strHTML += '<tr>'
                    strHTML += '<td colspan="8" class="text-center"><%= MyBase.GetResourceString("C_NoData") %></td>'
                    strHTML += '</tr>'
                }

                $("#RMPPtaskdetailsBody").html('');
                $("#RMPPtaskdetailsBody").html(strHTML);
            }
        }


        //Update and Release Resource From Project
        var checkvalidation = 0;

        function ReleseResourceFromProject() {

            //Save Task Completion details           
            UpdateTasksCompletion();

            //Save Void Taskdetails
            UpdateTasksVoid();

            ////Save new Approvers
            UpdateApprovers();

            //Close Request
            GetExtendRequestGrid();
            UpdateRequests();

            //Update Skills
            UpdateSkills();

            //for Configurable workflow
            UpdateWorkflow();

            //Release Resource            
            if (checkvalidation == 0) {
                ReleaseResource();
            }

        }

        //Function for Update Task For Completion
        function UpdateTasksCompletion() {
            // get the list of all ID's
            var strTaskIDs;
            var arrTaskIDList = [];
            var strTaskID;
            var i;

            strTaskIDs = $('input[name=checkResource]:checked').map(function () {
                return this.value;
            }).get().join(',');


            // Insert data in User Access table.
            if (strTaskIDs != "") {
                if (strTaskIDs.indexOf(",") > -1) {
                    arrTaskIDList = strTaskIDs.split(",");
                    for (i = 0; i < arrTaskIDList.length; i++) {
                        strTaskID = arrTaskIDList[i];
                        var ResourceParameter = {
                            ProjectID: encodeURI(ProjectID),
                            EmployeeID: encodeURI(ReleaseEmployeeID),
                            UserName: encodeURI(UserName),
                            strTaskID: encodeURI(strTaskID),
                        }
                        var param = JSON.stringify(ResourceParameter);
                        var strResult = AJAXCallWithResult("/api/PM_Resources/UpdateAssignedTasks", param, false);

                    }
                }
                else {
                    var ResourceParameter = {
                        ProjectID: encodeURI(ProjectID),
                        EmployeeID: encodeURI(ReleaseEmployeeID),
                        UserName: encodeURI(UserName),
                        strTaskID: encodeURI(strTaskIDs),
                    }
                    var param = JSON.stringify(ResourceParameter);
                    var strResult = AJAXCallWithResult("/api/PM_Resources/UpdateAssignedTasks", param, false);
                }
            }
        }


        //function for Task completion list
        function TaskCompletionList() {
            var ResourceParameter = {
                ProjectID: encodeURI(ProjectID),
                EmployeeID: encodeURI(ReleaseEmployeeID)
            }
            //$("#taskcompletiontable").dataTable().fnDestroy();
            var param = JSON.stringify(ResourceParameter);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetTaskForCompletion", param, false);
            var strHTML = "";
            if (strResult != undefined) {
                if (strResult.length > 0) {
                    for (i = 0; i < strResult.length; i++) {
                        var TaskID = strResult[i].TaskID;
                        var TaskName = strResult[i].TaskName;
                        var StartDate = strResult[i].StartDate;
                        var EndDate = strResult[i].EndDate;
                        var ActualStartDate = strResult[i].ActualStartDate;
                        var Work = strResult[i].PlannedWork;
                        var ActualWork = strResult[i].ActualWork;
                        var ActualPercentComplete = strResult[i].ActualPercentComplete;

                        strHTML += '<tr>'
                        strHTML += '<td>' + TaskName + '</td>'
                        strHTML += '<td>' + StartDate + '</td>'
                        strHTML += '<td>' + EndDate + '</td>'
                        strHTML += '<td>' + ActualStartDate + '</td>'
                        strHTML += '<td>' + Work + '</td>'
                        strHTML += '<td>' + ActualWork + '</td>'
                        strHTML += '<td>' + ActualPercentComplete + '</td>'
                        strHTML += '<td><div class="custom_chckbox">'
                        strHTML += '<input type="checkbox" name="checkResource" id="checkResource_' + TaskID + '" value="' + TaskID + '" class="chcktbl">'
                        strHTML += '<label for="checkResource_' + TaskID + '" class="chcktbl" ></label>'
                        strHTML += '</div></td>'
                        strHTML += '</tr>'


                    }
                }
                else {
                    strHTML += '<tr>'
                    strHTML += '<td colspan="8" text-align="center"><%= MyBase.GetResourceString("C_NoData") %></td>'
                    strHTML += '</tr>'
                }
                $("#taskcompletionBody").html("");
                $("#taskcompletionBody").html(strHTML);
                //PaginationTabs("#taskcompletiontable");
            }
        }


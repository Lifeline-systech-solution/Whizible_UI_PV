        //Resource Percentage Validation Starts here
        function ResourcePercentageValidation(ControlID) {
            var chktotalResAllocation = GetTotalPercentageallocation(NewEmployeeID);
            var objResourcePercentage = document.getElementById(ControlID);
            var isdigit = isNumeric(objResourcePercentage.value);
            if (isdigit == false) {
                alertify.error('<%= MyBase.GetResourceString("A_PositiveIntegerAllocation") %>');
                $('#txtALResourcePercentage').focus();
                return false;
            }
            //Commented and added by Chetan M on 9th Jan 2020
            //if (disallowNegativeNumeric(objResourcePercentage)) {
            if (disallowNegativeNumeric(objResourcePercentage) && chktotalResAllocation == true) {
                //End of addded by Chetan M on 9th Jan 2020
                alertify.error('<%= MyBase.GetResourceString("A_ResourcePercentageZero") %>');
                $('#txtALResourcePercentage').focus();
                return false;
            }
             //Commented By Reshma on 9th Jan 2020 For IssueID-21287
           <%-- if (objResourcePercentage.value.indexOf('.') > -1) {
                alertify.error('<%= MyBase.GetResourceString("A_PositiveIntegerAllocation") %>');
                $('#txtALResourcePercentage').focus();
                return false;
            }--%>
            //End of Commented By Reshma on 9th Jan 2020 For IssueID-21287
            //Validate for Available Allocation
            //Validate for Available Allocation            
            if (chktotalResAllocation == false) {
                //Commented And Added By Reshma on 9th Jan 2020 For IssueID-21315
                //return false;
                if (AvailablePercentage <= 0) {
                    if (objResourcePercentage.value == 1) {
                        return true;
                    }
                    else {
                        return false;
                    }
                }
                else {
                    return false;
                }
                //End Added By Reshma on 9th Jan 2020 For IssueID-21315
            }
            //Commented And Added By Usha Pandit On 17.06.2020 For allowing percentage as per corporate level configuration
            <%--if (objResourcePercentage.value <= 0 || objResourcePercentage.value > 100) {
                alertify.error('<%= MyBase.GetResourceString("A_Resourcepercentagebetween") %>');
                $('#txtALResourcePercentage').focus();
                return false;
            }--%>
            var strResourceAllocation = GetResourceAllocationSettingValue();
            if (objResourcePercentage.value <= 0 || objResourcePercentage.value > strResourceAllocation) {
                alertify.error('<%= MyBase.GetResourceString("A_Resourcepercentagebetween") %>');
                $('#txtALResourcePercentage').focus();
                return false;
            }
            //End Of Added By Usha Pandit On 17.06.2020 For allowing percentage as per corporate level configuration
            return true;
        }

        //function for validate textarea
        function TextAreaValidate(ControlID) {
            var objResponsibility = document.getElementById(ControlID);
            var objResvalue = objResponsibility.value;
            //Added by Chetan M on 11th Jan 2020
            objResvalue = $.trim(objResvalue.replace(/[\t\n]+/g, ' '));
            //End of added by Chetan M on 11th Jan 2020
            var Max = 1000;
            var textval = objResvalue.length;
            if (objResvalue.length > Max) {
                alertify.error('You Can Enter Only ' + Max + ' Characters.You Entered ' + textval + ' Characters.');
                $('#txtALResponsibility').focus();
                return false;
            }
            return true;
        }

        //% Allocation VAlidation
        function GetTotalPercentageallocation(NewEmployeeID) {
            var ResourcePercentage = document.getElementById("txtALResourcePercentage");
            //var totalResAllocation = 0;
            //var Total = 0;
            //var AvailablePercentage = 0;
            var strResourceAllocation = GetResourceAllocationSettingValue();
            var ResourceParameter = {
                EmployeeID: encodeURI(NewEmployeeID),
                ProjectID: encodeURI(ProjectID)
            }
            var param = JSON.stringify(ResourceParameter);           
            var result = AJAXCallWithResult("/api/PM_Resources/GetTotalPercentageallocation", param, false);
            if (result != undefined) {
                totalResAllocation = result;
            }
            Total = parseFloat(totalResAllocation) + parseFloat(ResourcePercentage.value);
            AvailablePercentage = parseFloat(strResourceAllocation) - parseFloat(totalResAllocation);
            //Added By Reshma on 9th Jan 2020 For IssueID-21315
            if (ResourcePercentage.value == 0) {
                alertify.error("Resource percentage should be greater than 0");
                $("#txtALResourcePercentage").focus();
                return false;
            }
            
            
            //if (Total > strResourceAllocation) { 
            if (AvailablePercentage > 0) {
                if (Total >= strResourceAllocation) {
                    //Commented And Added By Usha Pandit On 17.07.2020 For allowing percentage as per corporate level configuration
                    //alertify.error("You Can Enter % Allocation Upto " + AvailablePercentage + "% For This Resource. Please reset the allocation value.");
                    //$("#txtALResourcePercentage").focus();
                    //return false;

                    if (ResourcePercentage.value > AvailablePercentage) {
                        alertify.error("You Can Enter % Allocation Upto " + AvailablePercentage + "% For This Resource. Please reset the allocation value.");
                        $("#txtALResourcePercentage").focus();
                        return false;
                    }
                    //End Of Added By Usha Pandit On 17.07.2020 For allowing percentage as per corporate level configuration
                }
            }
            else {
                if (ResourcePercentage.value != 1) {
                    alertify.error("You Can Enter % Allocation Upto " + AvailablePercentage + "% For This Resource. Please reset the allocation value.");
                    $("#txtALResourcePercentage").focus();
                    return false;
                }
            }
            //End Added By Reshma on 9th Jan 2020 For IssueID-21315
            return true;
        }

        function GetResourceAllocationSettingValue()
        {
            //Added by imran on 05-09-2022 Vlidation error comes
            var paramiters = {
                QueryText: ""
            }
            //var result = AJAXCallWithResult("/api/PM_Resources/GetResourceAllocationSettingValue", '', false);
            var result = AJAXCallWithResult("/api/PM_Resources/GetResourceAllocationSettingValue", JSON.stringify(paramiters), false);
            //End of coment by imran on 05-09-2022
            if (result != undefined) {
                return result;
            }
        }

        //End Resource Percentage Validation Functinality

        //Function for Work Hrs Validation
        function WorkHoursValidation(ControlID) {
            var objHMEffort = document.getElementById(ControlID);
            var objVal = objHMEffort.value;
            var objOldVal = objHMEffort.value;

            if (objHMEffort.value != "") {

                objHMEffort.value = objHMEffort.value.replace(":", ".");
                var isdigit = isNumeric(objHMEffort.value);
                objHMEffort.value = objOldVal;
                if (isdigit == false) {
                    if (ControlID == 'txtExtResourceNewAllocation') {
                        alertify.error('<%= MyBase.GetResourceString("A_PositiveNumericForNewAllocation") %>');
                    }
                    else {
                        alertify.error('<%= MyBase.GetResourceString("A_PositiveNumericWork") %>');
                    }
                    setFocus(objHMEffort);
                    return false;
                }

                var mm = objVal.split(":")[1];
                if (mm == "") {
                    if (ControlID == 'txtExtResourceNewAllocation') {
                        alertify.error('<%= MyBase.GetResourceString("A_NewAlloHMFormat") %>');
                    }
                    else {
                        alertify.error('<%= MyBase.GetResourceString("A_HMFormat") %>');
                    }
                    setFocus(objHMEffort);
                    return false;
                }

                if (objVal.indexOf(":") == -1) {
                    objHMEffort.value = objVal + ":00";
                    objVal = objHMEffort.value;
                }
                if (objHMEffort.value.indexOf(":") == -1) {
                    if (ControlID == 'txtExtResourceNewAllocation') {
                        alertify.error('<%= MyBase.GetResourceString("A_NewAlloHMFormat") %>');
                    }
                    else {
                        alertify.error('<%= MyBase.GetResourceString("A_HMFormat") %>');
                    }
                    setFocus(objHMEffort);
                    return false;
                }
                if (objHMEffort.value.indexOf(":") != -1) {
                    objHMEffort.value = objHMEffort.value.replace(':', '.');
                }

                var blnResult = disallowSpecialCharacters(objHMEffort);
                if (blnResult == true) {
                    objHMEffort.value = objOldVal;
                    if (ControlID == 'txtExtResourceNewAllocation') {
                        alertify.error('<%= MyBase.GetResourceString("A_NewAlloHMFormat") %>');
                    }
                    else {
                        alertify.error('<%= MyBase.GetResourceString("A_HMFormat") %>');
                    }
                    setFocus(objHMEffort);
                    return false;
                }

                blnResult = disallowNonNumeric(objHMEffort);
                if (blnResult == true) {
                    objHMEffort.value = objOldVal;
                    if (ControlID == 'txtExtResourceNewAllocation') {
                        alertify.error('<%= MyBase.GetResourceString("A_NewAlloHMFormat") %>');
                     }
                     else {
                         alertify.error('<%= MyBase.GetResourceString("A_HMFormat") %>');
                    }
                    setFocus(objHMEffort);
                    return false;
                }

                objHMEffort.value = objHMEffort.value.replace('.', ':');

                var WorkHour = objHMEffort.value;

                WorkHour = WorkHour.trim();
                var idxColon = WorkHour.indexOf(':');

                var hrs = WorkHour.substring(0, idxColon);
                var mins = WorkHour.substring(idxColon + 1, WorkHour.length);

                if (mins.length == 1 && mins > 5) {
                    mins = mins + "0";
                }
                if (hrs.indexOf("-") != -1) {
                    if (ControlID == 'txtExtResourceNewAllocation') {
                        alertify.error('<%= MyBase.GetResourceString("A_HoursNotZeroForNewAllocation") %>');
                    }
                    else {
                        alertify.error('<%= MyBase.GetResourceString("A_HoursNotZero") %>');
                    }
                    setFocus(objHMEffort);
                    return false;
                }
                if (hrs <= 0 && mins <= 0) {
                    if (ControlID == 'txtExtResourceNewAllocation') {
                        alertify.error('<%= MyBase.GetResourceString("A_NewAllocationGraterzero") %>');
                    }

                    else {
                        alertify.error('<%= MyBase.GetResourceString("A_HoursNotZero") %>');
                    }
                    setFocus(objHMEffort);
                    return false;
                }
             
                //Added By Reshma on 13th Jan 2020 For 24 hrs/Per day Validation
                //Commented By Reshma on 17th Jan 2020 For 24 hrs/Per day Validation
                //if (hrs < 0 || hrs > 23) {
                //     if (ControlID == 'txtALWorkHrs') {
                //         alertify.error("Please enter 'Hours' between (0-23) range.");
                //         setFocus(objHMEffort);
                //         return false;
                //    }                    
                //}
                 //End Commented By Reshma on 17th Jan 2020 For 24 hrs/Per day Validation
                //End Added By Reshma on 13th Jan 2020 For 24 hrs/Per day Validation
                if (mins.length > 2) {
                    alertify.error("<%= MyBase.GetResourceString("A_MinInTwoDecimal") %>");
                    setFocus(objHMEffort);
                    return false;
                }


                if (mins > 59 || mins < 0) {

                    alertify.error("<%= MyBase.GetResourceString("A_MinInRange") %>");
                    setFocus(objHMEffort);
                    return false;
                }

                //GetRestrictByMinHours_MinHoursForDAEntry()              
                var strResult = AJAXCallWithResult("/api/PM_Resources/GetRestrictByMinHours_MinHoursForDAEntry", '', false);

                if (strResult != undefined) {
                    RestrictByMinHours = strResult.RestrictByMinHours;
                    MinHoursForDAEntry = strResult.MinHoursForDAEntry;
                }

                var MinDAENtryDisplay = "";
                var objMinWorkHrs = MinHoursForDAEntry;

                var MinDAEntry = objMinWorkHrs;

                var objRestrictByMinHours = RestrictByMinHours;


                if (MinDAEntry == 0.25) {
                    MinDAEntry = MinDAEntry
                    MinDAENtryDisplay = "00:15"
                }
                else if (MinDAEntry == 0.50) {
                    MinDAEntry = MinDAEntry
                    MinDAENtryDisplay = "00:30"
                }
                else if (MinDAEntry == 0.75) {
                    MinDAEntry = MinDAEntry
                    MinDAENtryDisplay = "00:45"
                }
                if (objRestrictByMinHours == true) {
                    if (MinDAEntry == 0.016) {
                    }
                    else {
                        var minutes = WorkHour.split(':');

                        var p = minutes[0];
                        var dec = minutes[1];

                        if (dec.length > 2) {
                            dec = dec.substring(0, 2);
                        }
                        if (dec.length == 1) {
                            dec = dec + "0";
                        }
                        if (dec == undefined) { dec = 0; }
                        d = (dec - 0) / 60 + (p - 0);

                        if ((d / MinDAEntry) != parseInt(d / MinDAEntry)) {
                            if (ControlID == 'txtExtResourceNewAllocation') {
                                alertify.error("Please enter the New Allocation in multiple of (" + MinDAENtryDisplay + ") min");

                            }

                            else {
                                alertify.error("Please Enter the work Hours in multiple of (" + MinDAENtryDisplay + ") min");

                            }
                            setFocus(objHMEffort);
                            return false;
                        }
                    }
                }

            }
            return true;
        }

        //Function for Validation dates
        var TentativeDateOfRelieving = "";
        var ResourceJoiningDate = "";
        function ValidateDates(ExpectedStartDate, ExpectedEndDate) {
            var checkval = 0;
            var result = GetProjectStartDateEndDate(ProjectID);
            var strResult = GetResourceTentativeDateOfRelieving(NewProjectEmployeeRoleID);
            TentativeDateOfRelieving = strResult[0].TentativeDateOfRelieving;
            ResourceJoiningDate = strResult[0].DateOfJoining;
            if (TentativeDateOfRelieving == null) { TentativeDateOfRelieving = ""; }
            else { TentativeDateOfRelieving = TentativeDateOfRelieving; }
            if (ResourceJoiningDate == null) { ResourceJoiningDate = ""; }
            else { ResourceJoiningDate = ResourceJoiningDate; }
            for (var i = 0; i < result.length; i++) {
                var ObjDate = result[i];
                if (Date.parse(ObjDate.expectedenddate) < Date.parse(ExpectedStartDate)) {
                    alertify.error("Start Date Should Not be Greater Than 'Project End Date " + result[i].expectedenddate + "");
                    $("#txtALExpectedStartDate").focus();
                    checkval = 1;
                }
                else if (Date.parse(ObjDate.expectedStartdate) > Date.parse(ExpectedStartDate) && Date.parse(ObjDate.expectedenddate) < Date.parse(ExpectedEndDate)) {
                    alertify.error("Start Date And End Date Should Be Between The Project Start Date " + result[i].expectedStartdate + " And End Date " + result[i].expectedenddate + "");
                    $("#txtALExpectedStartDate").focus();
                    checkval = 1;
                }
                else if (Date.parse(ObjDate.expectedStartdate) > Date.parse(ExpectedStartDate)) {
                    //Commented and added by Chetan M on 9th Jan 2020
                    //alertify.error("Start Date Should Not Be Less Than 'Project Start Date " + result[i].expectedStartdate + "");
                    alertify.error("Planned Start Date Should Not Be less Than 'Project Start Date' " + result[i].expectedStartdate + "");
                    //End of added by Chetan M on 9th Jan 2020
                    $("#txtALExpectedStartDate").focus();
                    checkval = 1;
                }
                else if (Date.parse(ObjDate.expectedenddate) < Date.parse(ExpectedEndDate)) {
                    //Commented and added by Chetan M on 9th Jan 2020
                    //alertify.error("End Date Should Not Be Greater Than 'Project End Date " + result[i].expectedenddate + "");
                    alertify.error("Planned End Date Should Not Be Greater Than 'Project End Date'  " + result[i].expectedenddate + "");
                    //End of added by Chetan M on 9th Jan 2020
                    checkval = 1;
                }

                else if (Date.parse(ObjDate.expectedStartdate) > Date.parse(ExpectedEndDate)) {
                    alertify.error("End Date Should Not Be Less Than 'Project Start Date " + result[i].expectedStartdate + "");
                    $("#txtALExpectedEndDate").focus();
                    checkval = 1;
                }
                else if (Date.parse(ExpectedStartDate) > Date.parse(ExpectedEndDate)) {
                    alertify.error("Start Date Should Not Be Greater Than End date " + ExpectedEndDate + "");
                    $("#txtALExpectedStartDate").focus();
                    checkval = 1;
                }
                else if (Date.parse(ExpectedEndDate) > Date.parse(TentativeDateOfRelieving)) {
                    alertify.error("Resource End Date On Project Should Be Less Than Resource Tentative Relieving Date " + TentativeDateOfRelieving + "");
                    $("#txtALExpectedEndDate").focus();
                    checkval = 1;
                }
                else if (Date.parse(ExpectedStartDate) < Date.parse(ResourceJoiningDate)) {
                    alertify.error("Resource Start Date On Project Should Not Be Less Than Resource Joining Date " + ResourceJoiningDate + "");
                    $("#txtALExpectedStartDate").focus();
                    checkval = 1;
                }
                else {
                    checkval = 0;
                }
            }
            return checkval;
        }


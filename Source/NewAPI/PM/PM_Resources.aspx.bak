        //Added By Rutuja D. 10 Jan 2020 For Check Project Is OnHold

        var IsProjectCreationWorkflowReqd = "";
        function CheckProjectOnHold() {
            var ProjectID = $("#cboProjects option:selected").val();
            var param = JSON.stringify(encodeURI(ProjectID));
            var strResult = AJAXCallWithResult("/api/PM_Resources/CheckProjectOnHold", param, false);
            for (var i = 0; i < strResult.length; i++) {

                ProjectOnHold = strResult[i]["ProjectOnHold"];
                ProjectOnHoldMsg = strResult[i]["ProjectOnHoldMsg"];
                BaselineNumber = strResult[i]["BaselineNumber"];
                BaseLineMessage = strResult[i]["BaseLineMessage"];
                if (BaselineNumber == '' && BaselineNumber == undefined && BaselineNumber == null) {
                    BaselineNumber = 0;
                } else {
                    BaselineNumber = BaselineNumber;
                }

            }
        }

        function CheckIsProjectCreationWorkflowReqd() {
            var ProjectID = $("#cboProjects option:selected").val();
            var param = JSON.stringify(encodeURI(ProjectID));
            var strResult = AJAXCallWithResult("/api/PM_Resources/CheckIsProjectCreationWorkflowReqd", param, false);
            for (var i = 0; i < strResult.length; i++) {
                IsProjectCreationWorkflowReqd = strResult[i]["IsProjectCreationWorkflowReqd"];
            }
        }

        //End Added By Rutuja D. 10 Jan 2020 For Check Project Is OnHold
//added script by pradip on 09-04-2020 for search resource
        function myFunction() {

            // Declare variables
            var input, filter, table, tr, td, i, txtValue;
            input = document.getElementById("serchresrclist");
            filter = input.value.toUpperCase();
            table = document.getElementById("Resourcestbl");
            tr = table.getElementsByTagName("tr");

            // Loop through all table rows, and hide those who don't match the search query
            for (i = 0; i < tr.length; i++) {
                td = tr[i].getElementsByTagName("td")[0];
                if (td) {
                    txtValue = td.textContent || td.innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                        SearchRecords = "1";
                    } else {
                        tr[i].style.display = "none";
                        SearchRecords = "0";
                    }
                }
            }
            $($.fn.dataTable.tables(true)).DataTable()
                .columns.adjust();
            
        }

        //Added By Reshma on 13th jan 2020 For IssueID-
         //Function for Get ProjectWork Hours
        function GetProjectHours() {
          
            try {
                var ResourceParameters = {
                    ProjectID: encodeURI(ProjectID),
                }               
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_Resources/GetProjectHours',
                    type: "POST",
                    data: JSON.stringify(ResourceParameters),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    },
                    success: function (strResult) {
                        if (strResult != undefined) {    
                            ProjectHours = "";
                            ProjectHours = strResult;                           
                        }
                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
                return ProjectHours;
            }
            catch (ex) {
                // alert(ex.message);
            }
        }

        function ValidateWHWithProjectWorks(ControlID) {
        
            var objWorkHours = document.getElementById(ControlID);
            var ResourceTotalWH = GetResourcesWorkHours();
            var ProjectHours = GetProjectHours();
          
            var SumHours = ResourceTotalWH;
            var CurHours = objWorkHours.value;

            if (CurHours.indexOf(":") > -1) {
                CurHours = CurHours.replace(":", ".");
            }
          
            var RemainingHours = ProjectHours - SumHours;
           
                    if (CurHours > RemainingHours) {                       
                        alertify.error("Sum of Work (H:M) should not be greater than Project Works " + ProjectHours);
                        $("#txtALWorkHrs").focus();
                        return false;
                    }
                    else {
                         return true;                       
                    }
             }


        //function for get Resources Work Hours
        function GetResourcesWorkHours() {
           
            try {
                 var ResourceParameters = {
                    ProjectID: encodeURI(ProjectID),
                    ProjectEmployeeRoleID: encodeURI(NewProjectEmployeeRoleID),
                 }
                var SumWorkHours = "";
                $.ajax({
                    url: encodeURI(strUrl) + '/api/PM_Resources/GetResourcesWorkHours',
                    type: "POST",
                    data: JSON.stringify(ResourceParameters),
                    dataType: "json",
                    async: false,
                    contentType: "application/json;charset-utf=8",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    },
                    success: function (strResult) {
                        if (strResult != "") {
                            SumWorkHours = strResult;
                        }
                    },
                    error: function (err) {
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                });
                return SumWorkHours;
            }
            catch (ex) {
                alert(ex.message);
            }
        }
       

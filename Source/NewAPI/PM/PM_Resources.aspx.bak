                setTimeout(function () {
                    $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
                }, 350);
            });//Added by pradip on 13-01-2020

            $("select option").removeAttr("title", "");

        });

        //function for disable links
        //Commented And Added By Usha Pandit On 26.07.2020 For passing flag
        //function ChangeProject() {
        function ChangeProject(loadflag)
        {
           //End Of Added By Usha Pandit On 26.07.2020 For passing flag

            var currentProjectId = $("#cboProjects option:selected").val();
            m_SelectedProjectID = currentProjectId;
            if (m_SelectedProjectID == undefined) {
                m_SelectedProjectID = 0;
            }
          
            if (currentProjectId == 0 || currentProjectId == undefined)
            {
                alertify.error("<%= MyBase.GetResourceString("A_SelectProject") %>");
                return false;
            }
            else
             {
                 //Added by imran For New  Add New Resource new ui button 24-06-2021
                    $.ajax({
                    url: strUrl + '/api/PM_Resources/GetResourceUIAllocation',
                    type: "POST",
                    dataType: "json",
                    contentType: "application/json;charset-utf=8",
                    async: false,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    },
                       success: function (data)
                       {
                           for (var i = 0; i < data.length; i++)
                           {
                               var d = data[i];
                               if (d.ShowResourceAllocation == true) {
                                    $("#btnAddResourceNewUI").css("display", "inline-block");
                                    $("#btnAddResourceOldUI").css("display", "none");
                               }
                               else {
                                    $("#btnAddResourceNewUI").css("display", "none");
                                    $("#btnAddResourceOldUI").css("display", "inline-block");
                               }
                           }                                                                            
                          GetResourcesTabAcess();
                        },
                       error: function (err)
                       {
                        console.log(err);
                        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                    }
                    });
                    //End Comment by imran 24-06-2021
            }   
        }

       
        function FillProjectCombox()
        {
            var sessionproj = 0;
            sessionproj = SessionProjectID;
            if (SessionProjectID == "") {
                sessionproj = 0;
            }

            var ResourceParameters = {
                UserID: encodeURI(UserID),
                ProjectID: encodeURI(sessionproj),
                LoginType: encodeURI(LoginType),
            }
            var param = JSON.stringify(ResourceParameters);
            var strResult = AJAXCallWithResult("/api/PM_Resources/GetProjectID", param, false);

            var objCbo1 = document.getElementById("cboProjects");
            $("#cboProjects option").remove();
            if (strResult.length != undefined) {
                if (strResult.length != 0) {
                    for (var i = 0; i < strResult.length; i++) {

                        var ObjAccessProj = strResult[i];

                        var objOption = document.createElement("OPTION");
                        objCbo1.options.add(objOption);

                        if (SessionProjectID == ObjAccessProj.ProjectID) {
                            objOption.text = ObjAccessProj.ProjectName;
                            objOption.value = ObjAccessProj.ProjectID;
                        }
                        else {
                            objOption.text = ObjAccessProj.ProjectName;
                            objOption.value = ObjAccessProj.ProjectID;
                        }
                        if (ObjAccessProj.ProjectID == "0") {
                            objOption.text = "Select Project";
                        }
                    }
                }
            }
            //Dropwdown Space
              //$('select option')
              //          .filter(function () {
              //              return !this.value || $.trim(this.value).length == 0 || $.trim(this.text).length == 0;
              //          })
              //  .remove();
             //End of Dropwdown Space

            if (SessionProjectID != null && SessionProjectID != undefined && SessionProjectID != "") {
                jQuery("select#cboProjects option[value=" + SessionProjectID + " ]").attr("selected", "selected");
                ProjectID = SessionProjectID;
            }
        }


        //function for getting resources list
        function GetResourcesList(ProjectID, QueryText) {
         
            //StartLoader("#ResourceBody");
            //Commented and Added By reshma on 9th Jan 2020
            //if (QueryText == undefined || QueryText == '') {
            if (QueryText == undefined || QueryText == '' || QueryText == null) {
                QueryText = "Null";
                GlobalApplyID = null;
                $("#ResourceClearAllFilter").hide();
                //Added By reshma on 9th Jan 2020 For IssueID-21367
                $("#ResourceFilter").removeClass('activefilter');
                //End Added By reshma on 9th Jan 2020 For IssueID-21367
            }
            else {
                QueryText = QueryText;
            }
            var ResourceParameters = {
                ProjectID: encodeURI(ProjectID),
                QueryText: encodeURI(QueryText),
                PageSize: 100,
                PageNumber:intPageNo
            }
            $("#Resourcestbl").dataTable().fnDestroy();
            $.ajax({
                url: encodeURI(strUrl) + '/api/PM_Resources/GetResourcesList',
                type: "POST",
                data: JSON.stringify(ResourceParameters),
                dataType: "json",
                async: false,
                contentType: "application/json;charset-utf=8",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                    if (ResourceParameters) {
                        xhr.setRequestHeader("Params", encryptString(isJson(ResourceParameters) ? ResourceParameters : JSON.stringify(ResourceParameters)));
                    }
                },
                success: function (data)
                {                    
                    $("#Resourcestblbody").html("");
                    var strHTML = "";
                     
                    for (var i = 0; i < data.length; i++)
                    {
                        if (data[i].IsResourceActive == true) {
                            data[i].IsResourceActive = "Yes";
                        }
                        else {
                            data[i].IsResourceActive = "No";
                        }
                        strHTML += '<tr>'
                        strHTML += '<td class="reqid">'
                        strHTML += '<a class="rname">' + data[i].EmployeeName + '</a>'
                        if (data[i].Status == "G") {
                            strHTML += '<div title="Under-allocated" data-bs-toggle="tooltip" data-bs-container="body" data-bs-placement="bottom" class="indicator indicatorGreen"></div>'
                        }
                        else {
                            strHTML += '<div title="Over-allocated" data-bs-toggle="tooltip" data-bs-container="body" data-bs-placement="bottom" class="indicator indicatorRed"></div>'
                        }
                        strHTML += '<span><small>' + data[i].RoleDescription + '</small></span>'
                        strHTML += '</td>'
                        strHTML += '<td> ' + data[i].ExpectedStartDate + '</td>'                       
                        strHTML += '<td> ' + data[i].ExpectedEndDate + '</td>'
                        strHTML += '<td> ' + data[i].ActualEndDate + '</td>'
                        strHTML += '<td> ' + data[i].Location + '</td>'
                        strHTML += '<td> ' + data[i].ResourcePercentage + '</td>'
                        strHTML += '<td> ' + data[i].IsResourceActive + '</td>'
                        strHTML += '<td> <a href="#" onclick="ResourceUtilizationOnclick(' + data[i].ProjectEmployeeRoleID + ',' + data[i].EmployeeID + ')" id="resourceloading"><img src="../../../Whizible2.0-new/dist/img/reports.svg" alt="" data-bs-toggle="tooltip" data-bs-container="body" data-bs-placement="bottom" data-bs-title="Resource Utilization" width="20px;"></a></td>'

                        strHTML += '<td class="actioncol">'
                        if (ProjectOver != "1") //Added & Commented By Dipali V On 10th Jan 2020 For Close Project 
                        {
                            if (EditAccess == "True") {
                                strHTML += '<a href = "#" class="editresource" title="Edit" data-bs-toggle="tooltip" data-bs-container="body" data-bs-placement="bottom" onclick="ADDEditResourceOnclick(' + data[i].ProjectEmployeeRoleID + ',' + data[i].EmployeeID + ',&quot;' + escape(data[i].EmployeeName) + '&quot;,1)"> <i class="fas fa-pencil-alt"></i></a>'
                                //strHTML += '<a class="closeaction removerow nostylebtn" data-bs-toggle="modal"  data-bs-target="#resourcerelease" ><img src="../../../Whizible2.0-new/dist/img/release.png" all="" width="16px" data-bs-toggle="tooltip" data-bs-title="Release" data-bs-container="body" data-bs-placement="bottom"></a>'
                                strHTML += '<a class="closeaction removerow nostylebtn"><img src="../../../Whizible2.0-new/dist/img/release.png" all="" width="16px" data-bs-toggle="tooltip" data-bs-title="Release" data-bs-container="body" data-bs-placement="bottom" class="ResourceReleaseBtn" id="ResourceRelease_' + data[i].ProjectEmployeeRoleID + '" onclick=ResourceRelease_Onclick(' + data[i].EmployeeID + ',&quot;' + escape(data[i].EmployeeName) + '&quot;,' + data[i].ProjectEmployeeRoleID + ')></a>';
                            }
                            if (DeleteAccess == "True") {
                                if (IsAllowResourceAllocation == 0) {
                                    //Commented And Added By Reshma on 13th jan 2020 For IssueID-21381
                                    //strHTML += '<a class="nostylebtn delattachbtn" data-bs-toggle="modal"><i class="far fa-trash-alt" data-bs-toggle="tooltip" data-bs-title="Delete" data-bs-container="body" data-bs-placement="bottom" data-original-title="Delete" id="Delete_' + data[i].ProjectEmployeeRoleID + '" onclick="DeleteResource(' + data[i].ProjectEmployeeRoleID + ')" ></i></a>'
                                    strHTML += '<a class="nostylebtn delattachbtn" data-bs-toggle="modal"><i class="far fa-trash-alt" data-bs-toggle="tooltip" data-bs-title="Delete" data-bs-container="body" data-bs-placement="bottom" data-original-title="Delete" id="Delete_' + data[i].ProjectEmployeeRoleID + '" onclick="DeleteResource(' + data[i].ProjectEmployeeRoleID + ',' + data[i].EmployeeID + ')" ></i></a>'
                                     //End  Added By Reshma on 13th jan 2020 For IssueID-21381
                                }
                                else {
                                    strHTML += '<a class="nostylebtn delattachbtn" ><i class="far fa-trash-alt" data-bs-toggle="tooltip" data-bs-title="Delete" data-bs-container="body" data-bs-placement="bottom" data-original-title="Delete" id="Delete_' + data[i].ProjectEmployeeRoleID + '"></i></a>'
                                }
                            }
                        } else {
                            //Added & Commented By Dipali V On 10th Jan 2020 For Close Project 
                            strHTML += '<a href = "#" class="editresource" title="Edit" data-bs-toggle="tooltip" data-bs-container="body" data-bs-placement="bottom" onclick="ADDEditResourceOnclick(' + data[i].ProjectEmployeeRoleID + ',' + data[i].EmployeeID + ',&quot;' + escape(data[i].EmployeeName) + '&quot;,1)"> <i class="fas fa-pencil-alt"></i></a>'
                            //strHTML += '<a class="closeaction removerow nostylebtn" data-bs-toggle="modal"  data-bs-target="#resourcerelease" ><img src="../../../Whizible2.0-new/dist/img/release.png" all="" width="16px" data-bs-toggle="tooltip" data-bs-title="Release" data-bs-container="body" data-bs-placement="bottom"></a>'
                            strHTML += '<a class="closeaction removerow nostylebtn"><img src="../../../Whizible2.0-new/dist/img/release.png" all="" width="16px" data-bs-toggle="tooltip" data-bs-title="Release" data-bs-container="body" data-bs-placement="bottom" class="ResourceReleaseBtn" id="ResourceRelease_' + data[i].ProjectEmployeeRoleID + '"  disabled></a>';
                            strHTML += '<a class="nostylebtn delattachbtn" ><i class="far fa-trash-alt" data-bs-toggle="tooltip" data-bs-title="Delete" data-bs-container="body" data-bs-placement="bottom" data-original-title="Delete" id="Delete_' + data[i].ProjectEmployeeRoleID + '" disabled></i></a>'
                            //End of Added & Commented By Dipali V On 10th Jan 2020 For Close Project
                        }
                        strHTML += '</td>'
                        strHTML += '</tr>'
                    }

                    $("#Resourcestblbody").html("");
                    $("#Resourcestblbody").append(strHTML);
                    $('[data-bs-toggle="tooltip"]').tooltip();
                    //Pagination("#Resourcestbl");   
                    //SearchRecords = "1";
                    Pagination();
                    StopAjaxLoader("#ResourceBody");

                    for (var i = 0; i < data.length; i++)
                    {
                        if (data[i].IsResourceActive == "Yes")
                        {
                            $("#ResourceRelease_" + data[i].ProjectEmployeeRoleID).css("cursor", "pointer");
                            $("#ResourceRelease_" + data[i].ProjectEmployeeRoleID).attr("data-bs-toggle", "tooltip");
                            $("#ResourceRelease_" + data[i].ProjectEmployeeRoleID).removeAttr("data-original-title", "");
                            $("#ResourceRelease_" + data[i].ProjectEmployeeRoleID).attr("data-original-title", "Release");
                        }
                        else {
                            $("#ResourceRelease_" + data[i].ProjectEmployeeRoleID).css("cursor", "not-allowed");
                            $("#ResourceRelease_" + data[i].ProjectEmployeeRoleID).attr("data-bs-toggle", "tooltip");
                            $("#ResourceRelease_" + data[i].ProjectEmployeeRoleID).removeAttr("data-original-title", "");
                            $("#ResourceRelease_" + data[i].ProjectEmployeeRoleID).attr("data-original-title", "Released");
                        }

                        //Added by imran on 12-01-2022
                        if (IsAllowResourceAllocation == 0)
                        {
                            if (data[i].IsTask == 0)
                            {
                                $("#Delete_" + data[i].ProjectEmployeeRoleID).prop('disabled', false);
                                $("#Delete_" + data[i].ProjectEmployeeRoleID).css("cursor", "pointer");
                                //Added By Dipali V On 14th May 2024 For Allow Disabled Icon
                                $("#Delete_" + data[i].ProjectEmployeeRoleID).removeClass("disable");
                                  //End of Added By Dipali V On 14th May 2024 For Allow Disabled Icon
                            }
                            else
                            {
                                $("#Delete_" + data[i].ProjectEmployeeRoleID).prop('disabled', true);
                                $("#Delete_" + data[i].ProjectEmployeeRoleID).css("cursor", "not-allowed");
                                  //Added By Dipali V On 14th May 2024 For Allow Disabled Icon
                                $("#Delete_" + data[i].ProjectEmployeeRoleID).addClass("disable");
                                  //End of Added By Dipali V On 14th May 2024 For Allow Disabled Icon
                            }
                        }
                        else {
                            $("#Delete_" + data[i].ProjectEmployeeRoleID).css("cursor", "not-allowed");
                        }
                        //End comment by imran on 12-01-2022
                    }

                    //Commented by imran on 12-01-2022 for performance issue
                    //for (var i = 0; i < data.length; i++)
                    //{
                    //    if (IsAllowResourceAllocation == 0) {
                    //        //$("#Delete_" + data[i].ProjectEmployeeRoleID).css("cursor", "pointer");
                    //        //Commented and Added By Reshma on 8th Jan 2020 For IssueID-21381
                    //        //$("#Delete_" + data[i].ProjectEmployeeRoleID).css("cursor", "pointer");
                    //        var EmployeeID = data[i].EmployeeID;
                    //        var IsTaskID = IsTaskAgainstResource(EmployeeID);
                            
                    //        if (IsTaskID == 0) {                              
                    //            $("#Delete_" + data[i].ProjectEmployeeRoleID).prop('disabled', false);
                    //            $("#Delete_" + data[i].ProjectEmployeeRoleID).css("cursor", "pointer");
                    //        }
                    //        else {                               
                    //            $("#Delete_" + data[i].ProjectEmployeeRoleID).prop('disabled', true);
                    //            $("#Delete_" + data[i].ProjectEmployeeRoleID).css("cursor", "not-allowed");
                    //        }
                    //        //End Added By Reshma on 8th Jan 2020 For IssueID-21381

                    //        //Added by Chetan M on 11th Jan 2020
                    //        //Commented by imran on 11-01-2022
                    //        //var ResourceID = GetFirstResourceID();
                    //        //if (ResourceID != null || ResourceID != "" || ResourceID != '0') {
                    //        //    $("#Delete_" + ResourceID).prop('disabled', true);
                    //        //    $("#Delete_" + ResourceID).css("cursor", "not-allowed");
                    //        //    $("#Delete_" + ResourceID).css("pointerEvents", "none");
                    //        //}
                    //        //End of comment by imran on 11-01-2022
                    //        //End of added by Chetan M on 11th Jan 2020
                    //    }
                    //    else {
                    //        $("#Delete_" + data[i].ProjectEmployeeRoleID).css("cursor", "not-allowed");
                    //    }
                    //}
                    //End of comment by imran on 12-01-2022

                    //Added by imran on 11-01-2022

                    var ResourceID = GetFirstResourceID();
                    if (ResourceID != null || ResourceID != "" || ResourceID != '0') {
                        $("#Delete_" + ResourceID).prop('disabled', true);
                        $("#Delete_" + ResourceID).css("cursor", "not-allowed");
                          //Added By Dipali V On 14th May 2024 For Allow Disabled Icon
                        $("#Delete_" + ResourceID).removeAttr("onclick", "");
                        $("#Delete_" + ResourceID).addClass("disable");
                          //End of Added By Dipali V On 14th May 2024 For Allow Disabled Icon
                    }
                    //End by imran on 11-01-2022
                },
                error: function (err) {
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });
        }


        //Added by Chetan M on 11th Jan 2020
        function GetFirstResourceID() {

            var param = JSON.stringify(ProjectID);
            var ResourceID = AJAXCallWithResult("/api/PM_Resources/GetFirstResourceID", param, false);

            return ResourceID;
        }
        //End of added by Chetan M on 11th Jan 2020


        //Added By Reshma on 8th Jan 2020 For IssueID-21381
        function IsTaskAgainstResource(EmployeeID) {

            var ResourceParameters = {
                ProjectID: encodeURI(ProjectID),
                EmployeeID: encodeURI(EmployeeID)
            }
            var param = JSON.stringify(ResourceParameters);
            var strResult = AJAXCallWithResult("/api/PM_Resources/IsTaskAgainstResource", param, false);

            if (strResult != undefined) {
                var IsTask = strResult;
                return IsTask;
            }
        }

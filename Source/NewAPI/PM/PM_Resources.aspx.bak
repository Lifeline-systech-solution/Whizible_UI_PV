        var RoleID = '<%= Session("intPostID") %>';
        var UserID = '<%= Session("intUserID") %>';
        var UserName = '<%= Session("strUserName") %>';
        var Today = "";
        var ProjectID;
        var SelectedCurrentdate = "";
        var GlobalApplyID;
        var GlobalrequestID = "";
        var GlobalFilterName;
        var GetDefaultFilterID = "";

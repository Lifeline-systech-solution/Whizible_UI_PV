        var m_CurrentToken = '';
        function generatetokenResourceLoading(ResourceUTProjectEmployeeRoleID, ResourceUTEmployeeID) {
            try {
                var ProjectID = $("#cboProjects option:selected").val();
                var ProjectEmployeeRoleID = ResourceUTProjectEmployeeRoleID;
                var EmployeeID = ResourceUTEmployeeID;

                if (ProjectID != undefined) {
                    var generatedtoken = ajaxCall("PM_Resources.aspx/GeneratePK_TokenUtilization", "POST", "application/json;charset=utf-8", "json", JSON.stringify({ ProjectID: ProjectID, ProjectEmployeeRoleID: ProjectEmployeeRoleID, EmployeeID: EmployeeID }));
                    if (generatedtoken != undefined) {

                        m_CurrentToken = generatedtoken.d;
                        validatetokenResourceLoading(m_CurrentToken);
                    }
                }
            }
            catch (ex) {
                ////alert(ex.message());
            }
        }
        var m_PKToken;
        function validatetokenResourceLoading(m_CurrentToken) {
            try {
                var ProjectID = $("#cboProjects option:selected").val();
                var ProjectEmployeeRoleID = ResourceUTProjectEmployeeRoleID;
                var EmployeeID = ResourceUTEmployeeID;
                m_PKToken = m_CurrentToken;

                if (ProjectID != undefined) {
                    var validatetoken = ajaxCall("PM_Resources.aspx/ValidatePK_TokenUtilization", "POST", "application/json;charset=utf-8", "json", JSON.stringify({ ProjectID: ProjectID, ProjectEmployeeRoleID: ProjectEmployeeRoleID, EmployeeID: EmployeeID, PKToken: m_PKToken }));

                    if (validatetoken != undefined) {
                        if (validatetoken.d == false) {
                            window.location.href = "../../General/CommonPage.aspx?MasterTagID=1836";
                        }

                    }
                }
            }
            catch (ex) {
                //alert(ex.message());
            }
        }

        var currentToken = '';
        function GenerateToken() {

            try {
                var ProjectID = $("#cboProjects option:selected").val();

                if (ProjectID != undefined) {
                    var generatedtoken = ajaxCall("PM_Resources.aspx/GeneratePK_Token", "POST", "application/json;charset=utf-8", "json", JSON.stringify({ ProjectID: ProjectID }));

                    if (generatedtoken != undefined) {

                        currentToken = generatedtoken.d;
                        validatetoken();
                    }
                }
            }
            catch (ex) {
                ////alert(ex.message());
            }
        }
        var PKToken;
        function validatetoken() {

            try {
                var ProjectID = $("#cboProjects option:selected").val();

                PKToken = currentToken;

                if (ProjectID != undefined) {
                    var validatetoken = ajaxCall("PM_Resources.aspx/ValidatePK_Token", "POST", "application/json;charset=utf-8", "json", JSON.stringify({ ProjectID: ProjectID, PKToken: PKToken }));

                    if (validatetoken != undefined) {
                        if (validatetoken.d == false) {
                            window.location.href = "../../General/CommonPage.aspx?MasterTagID=1836";
                        }

                    }
                }
            }
            catch (ex) {
                //alert(ex.message());
            }
        }



        var m_intYearsToBeShown = 0;
        var m_intMonthsToBeShown = 0;
        var m_strUserName = "";
        var m_lngEmployeeID = "";
        var m_intCurrentDays = "";
        var strSkillId = "";
        var m_strEmployeeYears = "";
        var m_strEmployeeMonths = "";
        var Parameters = "";
        var m_ProjectID = "";
        var m_ProjectName = "";
        var Mode = "";
        var ResourceUTProjectEmployeeRoleID = 0;
        var ResourceUTEmployeeID = 0;
        var m_SelectedProjectID = "";
        var m_SelectedProjectName = "";
        var ItemsToShow;
        var NotDA = "";
        var m_intRequestID = 0;
        var m_intPriority = "";
        var GlobalRequestType = "";
        var IsAllowResourceAllocation = "";
        var QueryText = "";
        var totalResAllocation = 0;
        var Total = 0;
        //Added By Reshma on 9th Jan 2020
        var GblQueryText = "";
        var AvailablePercentage = 0;
        var ProjectHours = "";
        //End Added By Reshma on 9th Jan 2020
        //Added By Dipali V On 10th Jan 2020
        var ProjectOver = 0;

        var ProjectOnHold = "";
        var ProjectOnHoldMsg = "";
        var BaselineNumber = "";
        var BaseLineMessage = "";
       //Added By Reshma on 17th jan 2020
        var gblRequestID = 0;
        var GlobalStatus = "";
       //End Added By Reshma on 17th jan 2020
        var SearchRecords = "0";//Added By Dipali V On 2nd Sep 2020 For JDTIAC Upgarde
        var TotalRecords = 0;
        var GlobalResourceCount = 0;
        var intPageNo = 1;
        var ProjectStartDate;
        var enableResourceAllocation;
        var selectedqid = "";
        $(document).ready(function ()

        {
             Date.prototype.toShortFormat = function () {

                var month_names = ["Jan", "Feb", "Mar",
                    "Apr", "May", "Jun",
                    "Jul", "Aug", "Sep",
                    "Oct", "Nov", "Dec"];

                var day = this.getDate();
                var month_index = this.getMonth();
                var year = this.getFullYear();

                return "" + day + " " + month_names[month_index] + " " + year;
            }
            SelectedCurrentdate = new Date();

            //Added by imran For New  Add New Resource new ui button 24-06-2021
            //$.ajax({
            //    url: strUrl + '/api/PM_Resources/GetResourceUIAllocation',
            //    type: "POST",
            //    dataType: "json",
            //    contentType: "application/json;charset-utf=8",
            //    async: false,
            //    beforeSend: function (xhr) {
            //        xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
            //    },
            //    success: function (data) {
            //        for (var i = 0; i < data.length; i++) {
            //            var d = data[i];
            //            if (d.ShowResourceAllocation == true) {
            //                $("#btnAddResourceNewUI").css("display", "inline-block");
            //                $("#btnAddResourceOldUI").css("display", "none");
            //            }
            //            else {
            //                $("#btnAddResourceNewUI").css("display", "none");
            //                $("#btnAddResourceOldUI").css("display", "inline-block");
            //            }
            //        }
            //    },
            //    error: function (err) {
            //        console.log(err);
            //        //alert(err.responseText);
            //        window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
            //    }
            //});
            //End Comment by imran 24-06-2021

            $.ajax({
                url: strUrl + '/api/Common/GetCompanyInformation',
                type: "POST",
                dataType: "json",
                contentType: "application/json;charset-utf=8",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token"));
                },
                success: function (data) {
                    for (var i = 0; i < data.length; i++) {
                        var d = data[i];
                        enableResourceAllocation = d.AllowResourceAllocation;
                        //alert(enableResourceAllocation);
                        BindHeader();
                    }
                },
                error: function (err) {
                    console.log(err);
                    window.location.href = "../../General/ErrorPage.aspx?Mode=AJAXError&Error=" + err + ""
                }
            });

            /*Added By Usha Pandit On 26.07.2020 For adding loader*/
            $("#divPMResource").removeClass("center");
            $("#divPMResource").removeClass("preloader");
            $(".resource_allocation").removeClass('clsShowHide');
            /*End Of Added By Usha Pandit On 26.07.2020 For adding loader*/

            //Added by Omkar T on 10-01-2020
            // Commented by Gauri on 24th Sep 2024 for Datepicker Issue
            // $(".modal").scroll(function () {
                //     $('#ui-datepicker-div').hide();
            // });
            //this is for file attache and drop script
            $('form input').change(function () {
                $('form p').text(this.files.length + " file(s) selected");
            });

            //weeekly and daily tab
            $(".tab-slider--body").hide();
            $(".tab-slider--body:first").show();

            if (blnViewAccess == "False") {
                var bodyHTML = '';
                bodyHTML = '<div style="text-align:center;overflow: auto;width: 100%;background-color:white;margin-top:3%;"><b style="margin-top:6%;"><center>You are not authorized to view this record. </center></b></div>';
                $("#divPMResource").html(bodyHTML);
                return;
            }

            alertify.set('notifier', 'position', 'top-right');
            //Added By Rutuja D. 8 Jan 2020 For Set Today Date
            $('#txtToday').datepicker('setDate', new Date());
            //End Added By Rutuja D. 8 Jan 2020 For Set Today Date

            GetMaxItemsToShow();
            Parameters = getParameters();
            m_ProjectID = unescape(Parameters["ProjectID"]);
            m_ProjectName = unescape(Parameters["ProjectName"]);
            m_SelectedProjectID = unescape(Parameters["ProjectID"]);
            m_SelectedProjectName = unescape(Parameters["ProjectName"]);

            if (m_ProjectID != "undefined") {
                SessionProjectID = m_ProjectID;
                SessionProjectName = m_ProjectName;
                FillProjectCombox();
            }
            else if (m_SelectedProjectID != "undefined") {
                SessionProjectID = m_SelecteProjectID;
                SessionProjectName = m_SelectedProjectName;
                FillProjectCombox();
            }
            else {
                SessionProjectID = SessionProjectID;
                FillProjectCombox();
            }
            IsProjectOverOrNot(ProjectID)
            updateOptions();
            //Commented And Added By Usha Pandit On 26.07.2020 For passing flag
            //ChangeProject();
            ChangeProject("onload");
            //End Of Added By Usha Pandit On 26.07.2020 For passing flag

            //Comment and added by imran on 25-02-2022
            //GetResourcesTabAcess();
            //End of comment by imran on 25-02-2022

            GetResourceDefaultFilter(1019);


            //Added By Rutuja D. 10 Jan 2020 For Check Project Is OnHold
            CheckProjectOnHold();
            CheckIsProjectCreationWorkflowReqd();

            if (IsProjectCreationWorkflowReqd == 1) {
                if (BaselineNumber == 0) {
                    $("#btnSaveResource").hide();

                }
                else if (ProjectOnHold == 1) {
                    $("#btnSaveResource").hide();
                }
                else {
                    $("#btnSaveResource").show();
                }
            }
            else if (ProjectOnHold == 1) {
                $("#btnSaveResource").hide();
            }
            else {
                $("#btnSaveResource").show();
            }
            //End Added By Rutuja D. 10 Jan 2020 For Check Project Is OnHold

            //  alert(ProjectOver);

            //onchange on Project GetResource list
            $("#cboProjects").change(function () {
                $("#ARdetailpanel").hide('fast');
                ProjectID = $(this).find(':selected').val();
                IsProjectOverOrNot(ProjectID)
                GetResourceDefaultFilter(1019);
                GetResourcesTabAcess();

                //Added By Rutuja D. 10 Jan 2020 For Check Project Is OnHold
                CheckProjectOnHold();
                CheckIsProjectCreationWorkflowReqd();

                if (IsProjectCreationWorkflowReqd == 1) {
                    if (BaselineNumber == 0) {
                        $("#btnSaveResource").hide();

                    }
                    else if (ProjectOnHold == 1) {
                        $("#btnSaveResource").hide();
                    }
                    else {
                        $("#btnSaveResource").show();
                    }
                }
                else if (ProjectOnHold == 1) {
                    $("#btnSaveResource").hide();
                }
                else {
                    $("#btnSaveResource").show();
                }
                //End Added By Rutuja D. 10 Jan 2020 For Check Project Is OnHold


           });

          $('.modal').on('shown.bs.collapse', function () {
                      setTimeout(function(){
        $.fn.dataTable.tables( {visible: true, api: true} ).columns.adjust();
            }, 350);    
            }); //Added by pradip on 13-01-2020

        // ============================================================================
        function toggleSectionsBasedOnTaskType(isParentTask) {
            // Determine if sections should be enabled or disabled
            var isEnabled = isParentTask === true;
            
            // Task Attribute Section
            toggleSection('#taskAttributesContent', isEnabled);

            // Agile Section
            toggleSection('#agileContent', isEnabled);

            // Document Section
            toggleSection('#documentsContent', isEnabled);

            // Custom Fields Section
            toggleSection('#customFieldsContent', isEnabled);


            // Release and Sprint textboxes always disabled (for both parent and child tasks)
            // Modified by Auto - Added readonly attribute to ensure fields are always readonly in all cases
            $('#input_sprint, #input_release').prop('disabled', true).prop('readonly', true);
            
            // Add visual indicator (read-only styling)
            if (!isEnabled) {
                $('#taskAttributesContent').addClass('section-readonly');
                $('#agileContent').addClass('section-readonly');
                $('#documentsContent').addClass('section-readonly');
                $('#customFieldsContent').addClass('section-readonly');
                $('#btn_set_baseline_tab, #btn_clear_baseline_tab, #btn_set_baseline_offcanvas, #btn_clear_baseline_offcanvas').prop('disabled', true);
                
            } else {
                $('#taskAttributesContent').removeClass('section-readonly');
                $('#agileContent').removeClass('section-readonly');
                $('#documentsContent').removeClass('section-readonly');
                $('#customFieldsContent').removeClass('section-readonly');
                $('#btn_set_baseline_tab, #btn_clear_baseline_tab, #btn_set_baseline_offcanvas, #btn_clear_baseline_offcanvas').prop('disabled', false);
            }
        }

        // Added By Dipali V On 2nd Feb 2026 For W26 - Enhanced to disable datepickers, selectpickers, and all custom field inputs for child tasks
        function toggleSection(sectionSelector, isEnabled) {
            var $section = $(sectionSelector);
            
            // Disable form controls (input, textarea, select, button)
            // Modified by Auto - Exclude Release and Sprint fields which should always be readonly
            $section.find('input, textarea, select, button')
                .not('#input_sprint, #input_release') // Exclude Release and Sprint
                .prop('disabled', !isEnabled)
                .prop('readonly', !isEnabled);
            
            // Added by Auto - Ensure Release and Sprint are always readonly/disabled regardless of section state
            $('#input_sprint, #input_release').prop('disabled', true).prop('readonly', true);
            
            // Disable datepickers
            // Modified by Auto - Exclude Release and Sprint fields
            $section.find('input[type="date"], input.datepicker, input.hasDatepicker')
                .not('#input_sprint, #input_release') // Exclude Release and Sprint
                .each(function() {
                    var $input = $(this);
                    if ($input.data('datepicker') || $input.hasClass('hasDatepicker')) {
                        try {
                            if (isEnabled) {
                                $input.datepicker('enable');
                            } else {
                                $input.datepicker('disable');
                            }
                        } catch(e) {}
                    }
                    $input.prop('disabled', !isEnabled).prop('readonly', !isEnabled);
                });
            
            // Disable selectpickers

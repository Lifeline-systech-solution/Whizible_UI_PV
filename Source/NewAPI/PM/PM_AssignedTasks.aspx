                    LoginType: strLoginType || null,                  // @strLoginType - Required
                    SubCategoryID: parseInt(docSubCategoryID),        // @intSubCategoryID - Required
                    TagID: intTagID,                                   // @intTagID - Required (1038 for Task)
                    UniqueID: intUniqueID                              // @intUniqueID - Required (TaskID)
                };
                
                var result = AJAXCallWithResult('api/PM_AssignedTasks/AttachURL', JSON.stringify(urlParameter), false);

                if (result && result.status === "SUCCESS") {

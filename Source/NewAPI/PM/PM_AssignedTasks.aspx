        // Enhanced AJAX helper with better error handling
        function AJAXCallWithResult(url, param, async) {
            var result = null;
            var fullUrl = buildUrl(url);
            var type = "POST"
            $.ajax({
                url: encodeURI(fullUrl),
                type: type,
                data: param,
                async: async,
                dataType: "json",
                contentType: (type === "GET") ? "application/x-www-form-urlencoded" : "application/json;charset=utf-8",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token_W26API"));
                    //xhr.setRequestHeader('Accept', 'application/json');      
                    if (param) {
                        xhr.setRequestHeader("Params", encryptString(isJson(param) ? param : JSON.stringify(param)));
                    }
                },
                success: function (data) {
                    //Commented & Added By Dipali V On 12-02-2026 to normalize API response
                    //result = data;
                    result = normalizeApiResponse(data);
                    //End of Commented & Added By Dipali V On 12-02-2026 to normalize API response
                    console.log('AJAX Success for ' + url + ':', data);
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.error('AJAX Error for ' + url + ':', {
                        status: jqXHR.status,
                        statusText: jqXHR.statusText,
                        textStatus: textStatus,
                        errorThrown: errorThrown,
                        responseText: jqXHR.responseText
                    });
                    
                    // For synchronous calls, we need to set result to indicate error
                    // The calling code should check for null/undefined
                    result = null;
                }
            });
            return result;
        }

        // URL building helper
        function buildUrl(url) {
            if (strUrl.endsWith('/') && url.startsWith('/')) {
                return strUrl + url.substring(1);
            } else if (strUrl.endsWith('/') && !url.startsWith('/')) {
                return strUrl + url;
            } else if (!strUrl.endsWith('/') && url.startsWith('/')) {
                return strUrl + url;
            } else {
                return strUrl + '/' + url;
            }
            console.log(strUrl);
        }
        
        // HTML escaping helper
        function escapeHtml(text) {
            if (text === null || text === undefined) return '';
            // Convert to string if not already a string
            var str = String(text);
            var map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return str.replace(/[&<>"']/g, function(m) { return map[m]; });
        }
        

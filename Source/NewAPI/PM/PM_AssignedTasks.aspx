        function finishCopyTaskSave(parentTaskID, emailEmployeeIdOrList) {
            var failedNames = GNewTaskFailedResourceNames.slice();
            var hadErrors = GNewTaskResourceFailures.length > 0;
            var emailIds = emailEmployeeIdOrList;
            var hadSuccess = emailIds && (Array.isArray(emailIds) ? emailIds.length > 0 : !!emailIds);
            if (hadErrors) showValidationAlertifyError(GNewTaskResourceFailures);
            GNewTaskResourceFailures = [];
            GNewTaskFailedResourceNames = [];
            GNewTaskResources = [];
            GNewTaskValidatedList = [];
            GNewTaskSoftConfirmQueue = [];
            GNewTaskSoftConfirmIndex = 0;
            GMultiResourceSaveMode = null;
            GCopyTaskResources = [];

        // Map taskColor name to CSS hex value
        function getColorFromTaskColor(colorName) {
            if (!colorName) return '#6c757d';
            var colorMap = { 'green': '#28a745', 'red': '#dc3545', 'orange': '#ff9800', 'blue': '#007bff', 'yellow': '#ffc107', 'gray': '#6c757d', 'grey': '#6c757d' };
            return colorMap[colorName.toLowerCase()] || colorName;
        }

        // Map taskColor to CSS row status class
        function getRowStatusFromColor(colorName) {

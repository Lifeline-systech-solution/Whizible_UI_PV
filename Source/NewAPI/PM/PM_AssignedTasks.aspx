            if (taskIDList.length === 1) {
                pendingVoidTaskList = taskIDList[0]; // Single task ID, no comma
            } else {
                pendingVoidTaskList = taskIDList.join(','); // Multiple task IDs, comma-separated
            }
            pendingVoidProjectID = currentProjectID;
            
            // Added by Dipali V on 12th Jan 2026 - Set global flag for void operation
            GconfirmationActionType = 'VOID';
            
            if (parentTaskIDs.size > 0) {
                $('#confirmDeleteResourceMessage').text('<%= MyBase.GetResourceString("M_ConfirmVoidTasksParent") %>');
            } else {

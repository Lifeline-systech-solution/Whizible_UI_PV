        function formatEffortOnBlur(input) {
            let value = input.value.trim();

            if (value === '') {
                input.value = '';
                if (isMultiResourceAddFormMode()) updateNewTaskAddResourceLink();
                return;
            }

            let hours = 0;
            let minutes = 0;

            if (value.includes(':')) {
                let parts = value.split(':');
                hours = parseInt(parts[0], 10) || 0;
                minutes = parseInt(parts[1], 10) || 0;
            } else {
                // Only hours entered like "1"
                hours = parseInt(value, 10) || 0;
                minutes = 0;
            }

            // 🔥 Handle minute overflow (e.g., 60 → +1 hour)
            if (minutes >= 60) {
                hours += Math.floor(minutes / 60);
                minutes = minutes % 60;
            }

            // Format to HH:MM
            let formattedHours = hours.toString().padStart(2, '0');
            let formattedMinutes = minutes.toString().padStart(2, '0');

            input.value = formattedHours + ':' + formattedMinutes;
            if (isMultiResourceAddFormMode()) updateNewTaskAddResourceLink();
        }


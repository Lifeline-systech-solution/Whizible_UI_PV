            var tbody = $('#showvoidmodalTbl tbody');
            if (tbody.length > 0) {
                tbody.html('<tr><td colspan="8" class="text-center py-4"><i class="fas fa-spinner fa-spin"></i> Loading...</td></tr>');
            }

            try {
                var result = AJAXCallWithResult('api/PM_AssignedTasks/ShowVoidTask', JSON.stringify({ ProjectID: currentProjectID }), false);
                if (result && result.list) {
                    GvoidTaskList = result.list;
                    filterVoidTasks();
                } else {
                    GvoidTaskList = [];
                    populateVoidTasksTable([]);
                }
            } catch (error) {
                GvoidTaskList = [];
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_ErrorLoadingVoidTasksWithMessage") %>' + error.message);
                populateVoidTasksTable([]);

                $('#sv_detail_btn').show();
                
            } else {
                $('#sv_detail_btn').hide();
                
            }
            // Store copy flags for save logic
            window.GCopyWithChildTasks = copyWithChildTasks;
            window.GCopyFlag = flag;
            window.GCopyFromWhere = GCopyFromWhere;
           
           
        }


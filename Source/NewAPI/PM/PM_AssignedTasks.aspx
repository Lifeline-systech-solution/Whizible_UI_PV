        // Added by Dipali V on 13th Jan 2026 - Function to find task by ID in all available sources
        function findTaskByID(taskID) {
            var task = null;
            
            // Search in GtaskListFlattened
            if (GtaskListFlattened && Array.isArray(GtaskListFlattened) && GtaskListFlattened.length > 0) {
                task = GtaskListFlattened.find(function (item) {
                    var itemTaskID = item.TaskID || item.taskID;
                    return itemTaskID && parseInt(itemTaskID) === parseInt(taskID);
                });
            }
            
            // Search in GtaskList
            if (!task && GtaskList && Array.isArray(GtaskList)) {
                task = GtaskList.find(function (item) {
                    var itemTaskID = item.TaskID || item.taskID;
                    return itemTaskID && parseInt(itemTaskID) === parseInt(taskID);
                });
            }
            
            // Search in GchildTasksMap
            if (!task && GchildTasksMap && typeof GchildTasksMap === 'object') {
                for (var parentID in GchildTasksMap) {
                    if (GchildTasksMap.hasOwnProperty(parentID) && Array.isArray(GchildTasksMap[parentID])) {
                        task = GchildTasksMap[parentID].find(function (item) {
                            var itemTaskID = item.TaskID || item.taskID;
                            return itemTaskID && parseInt(itemTaskID) === parseInt(taskID);
                        });
                        if (task) break;
                    }
                }
            }
            
            return task;
        }
        
        // Added by Dipali V on 13th Jan 2026 - Function to copy task data to form (copy mode)
        function populateFormForCopy(taskData, copyWithResources, flag) {
            if (!taskData) return;
            // Clear form first
            ClearTaskDetails();
            
            // Added by Dipali V on 13th Jan 2026 - Enable sections for copy mode (editable)
            toggleSection('#taskAttributesContent', true);
            toggleSection('#agileContent', true);
            toggleSection('#customFieldsContent', true);
            // Remove readonly class to ensure sections are fully editable
            $('#taskAttributesContent').removeClass('section-readonly');
            $('#agileContent').removeClass('section-readonly');
            $('#customFieldsContent').removeClass('section-readonly');
            // Documents section will be hidden in performCopyTask, so no need to enable it here
            // Added by Auto - Ensure Release and Sprint are always readonly/disabled in all cases
            $('#input_sprint, #input_release').prop('disabled', true).prop('readonly', true);
            // Set task ID to 0 for new task
            $('#hidden_task_id_offcanvas').val(0);
            // Store parent task ID for child copy with Yes (will create parent task)
            if (GCopyFromWhere === "ChildListView" && copyWithResources && flag === 1) {
                // Child Copy - Yes: Store original parent task ID to create parent when saving
                var originalParentTaskID = taskData.ParentTaskID || taskData.parentTaskID;
                GParentTaskID = originalParentTaskID || 0;
            } else {
                GParentTaskID = 0;
            }
            GIsEditMode = false;
            // Copy basic fields
            $('#input_task_name').val((taskData.TaskName || taskData.taskName || '') + ' (Copy)');
            $('#text_tasknotes').val(taskData.TaskNotes || taskData.taskNotes || '');
            $('#input_work').val(taskData.Work || taskData.work || '');
            
            // Added by Dipali V - When copying child task with flag=1, use resource dates for task dates
            if (GCopyFromWhere === "ChildListView" && copyWithResources && flag === 1) {

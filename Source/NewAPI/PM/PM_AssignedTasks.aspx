        // Added by Vyankat B. on 05-06-2026 - Child section work hours validation on SaveTaskDetails
        function validateChildTaskWorkHoursOnSave() {
            var childTaskMessages = [];
            var alertNo = 1;
            var projectID = getCurrentProjectID();
            var parentTaskID = parseInt(GParentTaskID) || 0;
            var childTaskID = parseInt($('#hidden_task_id_offcanvas').val()) || 0;
            var isUpdateMode = GIsEditMode === true && childTaskID > 0;
            var taskID = isUpdateMode ? childTaskID : parentTaskID;
            var effort = $('#input_work').val();
            var workParts = effort.split(':');
            var workHoursDecimal = (parseInt(workParts[0], 10) || 0) + ((parseInt(workParts[1], 10) || 0) / 60);
            var employeeID = getChildTaskEmployeeID();
            var startDate = $('#CRTstdateStartDate').val();
            var endDate = $('#CRTendateEndDate').val();

            var validationData = getValidationData(projectID, taskID, parentTaskID, employeeID, startDate, endDate, workHoursDecimal);
            if (!validationData || !validationData.projectInfo) {
                return true;
            }

            var projectInfo = validationData.projectInfo;
            var projectLCETotal = parseFloat(projectInfo.ProjectLCETotal || projectInfo.projectLCETotal) || 0;
            var totalWorks = parseFloat(projectInfo.TotalWorks || projectInfo.totalWorks) || 0;
            var ParentTaskWorkHours = (projectInfo.parentTaskWorkHours || projectInfo.ParentTaskWorkHours) || 0;
            var ChildTaskWorkHours = (projectInfo.childTaskWorkHours || projectInfo.ChildTaskWorkHours) || 0;
            var ParentChildTaskWorkHours = (projectInfo.ParentChildTaskWorkHours || projectInfo.parentChildTaskWorkHours) || 0;

            if (isUpdateMode) {
                var totalHours = timeToMinutes(ParentChildTaskWorkHours) - timeToMinutes(ChildTaskWorkHours) + timeToMinutes(effort);

                if (timeToMinutes(effort) > timeToMinutes(ParentTaskWorkHours)) {
                    childTaskMessages.push(
                        alertNo + '. Child task work hours should not be greater than parent task work hours (' + ParentTaskWorkHours + ').'
                    );
                    alertNo++;
                }

                if (timeToMinutes(effort) > timeToMinutes(projectLCETotal)) {
                    childTaskMessages.push(
                        alertNo + '. Child task work hours should not be greater than project total work hours (' + projectLCETotal + ').'
                    );
                    alertNo++;
                }

                if (timeToMinutes(ParentTaskWorkHours) < totalHours) {
                    childTaskMessages.push(
                        alertNo + '. Total Child task work hours (' + minutesToTime(totalHours) + ') should not be greater than  parent task work hours (' + ParentTaskWorkHours + ').'
                    );
                    alertNo++;
                }
            } else {
                var totalAfterAddMinutes = timeToMinutes(decimalToHHMM(totalWorks)) + timeToMinutes(effort);
                var totalAfterAdd = minutesToTime(totalAfterAddMinutes);

                if (totalAfterAddMinutes > timeToMinutes(decimalToHHMM(projectLCETotal))) {
                    childTaskMessages.push(
                        alertNo + '. Total child task work hours (' + totalAfterAdd +
                        ') should not exceed project total work hours (' + projectLCETotal + ').'
                    );
                    alertNo++;
                }

                if (timeToMinutes(effort) > timeToMinutes(ParentTaskWorkHours)) {
                    childTaskMessages.push(
                        alertNo + '. Child task work hours should not be greater than parent task work hours (' + ParentTaskWorkHours + ').'
                    );
                    alertNo++;
                }

                if (timeToMinutes(effort) > timeToMinutes(projectLCETotal)) {
                    childTaskMessages.push(
                        alertNo + '. Child task work hours should not be greater than project total work hours (' + projectLCETotal + ').'
                    );
                    alertNo++;
                }
            }

            var taskWorkData = getTaskWorkHoursAndResourceEfforts(projectID, parentTaskID, taskID, isUpdateMode);
            var taskWorkHours = ParentTaskWorkHours || 0;
            var totalResourceEfforts = taskWorkData.totalResourceEfforts || 0;

            if (taskWorkHours) {
                var taskWorkMinutes = timeToMinutes(taskWorkHours);
                var resourceWorkMinutes = Number(workHoursDecimal) * 60;

                if (resourceWorkMinutes > taskWorkMinutes) {
                    childTaskMessages.push(
                        alertNo + '. Resource efforts (' + minutesToTime(resourceWorkMinutes) +
                        ') should not be greater than task efforts (' + minutesToTime(taskWorkMinutes) + ').'
                    );
                    alertNo++;
                }

                var totalResourceMinutes = Number(totalResourceEfforts) * 60;
                var workMinutes = Number(workHoursDecimal) * 60;
                var totalEffortsAfterAddMinutes = totalResourceMinutes + workMinutes;

                if (totalEffortsAfterAddMinutes > taskWorkMinutes) {
                    childTaskMessages.push(
                        alertNo + '. Sum of resource efforts (' + minutesToTime(totalEffortsAfterAddMinutes) +
                        ') should not be greater than task efforts (' + minutesToTime(taskWorkMinutes) + ').'
                    );
                    alertNo++;
                }
            }

            if (childTaskMessages.length > 0) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error(childTaskMessages.join('<br/>'));
                return false;
            }

            return true;
        }
        // End of Added by Vyankat B. on 05-06-2026 - Child section work hours validation on SaveTaskDetails

        // Added by Dipali V on 13th Jan 2026 - Perform all SP-level validations client-side
        function ValidateResource(isUpdateMode, childTaskID, parentTaskID, resourceID, effort, startDate, endDate, taskTypeID, subTaskTypeID, objTxt) {
            //;
            IsValid = 1;

             validationMessages = [];
             GConfirmedMessages = [];
            // Basic UI validations
            if (!resourceID || resourceID === '' || resourceID==='Select Resources') {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_PleaseSelectResource") %>');
                IsValid = 0;
                return IsValid;
            }
            if (!effort || effort === '') {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_PleaseEnterEffort") %>');
                IsValid = 0;
                return IsValid;
            }

            if (IsCopyTask === 1) {
                var objVal = objTxt.textContent;
                var objnewVal = objTxt.textContent;
                objTxt.value = objTxt.textContent.replace(":", ".");
            } else {
                var objVal = objTxt.value;
                var objnewVal = objTxt.value;
                objTxt.value = objTxt.value.replace(":", ".");
            }
            var isdigit = isNumeric(objTxt.value);
            objTxt.value = objVal;
            if (isdigit == false) {
                alertify.error('<%= MyBase.GetResourceString("M_PleaseEnterPositiveNumericWorkHours") %>');
                objTxt.focus();
                IsValid = 0;
                return IsValid;
            }

            if (objTxt.value.indexOf(':') == -1) {
                objTxt.value = objnewVal + ':00';
                objnewVal = objTxt.value;
            }

            if (objTxt.value.indexOf('.') >= 0) {
                alertify.error('<%= MyBase.GetResourceString("M_PleaseEnterWorkInHHMMFormat") %>');
                objTxt.value = objVal;
                objTxt.focus();
                IsValid = 0;
                return IsValid;
            }
            
            objTxt.value = objTxt.value.replace(/:/g, ".");
            var precision = objTxt.value.split(".")[1];

            if (precision && precision.length > 2) {
                alertify.error('<%= MyBase.GetResourceString("M_PleaseEnterMinutesTwoDecimalLessThan60") %>');
                objTxt.focus();
                IsValid = 0;
                return IsValid;
            }

            if (precision && (precision > 60 || precision < 0)) {
                alertify.error('<%= MyBase.GetResourceString("M_PleaseEnterMinutesBetween0And59") %>');
                objTxt.value = objTxt.value.split('.').join(':');
                objTxt.focus();
                IsValid = 0;
                return IsValid;
            }

            if (precision == 60) {
                objTxt.value = (objTxt.value.split(".")[0] - 0) + 1;
            }
            
            var pattern = /^\d+(\.\d{1,2})?$/;
            if (!pattern.test(objTxt.value)) {
                alertify.error('<%= MyBase.GetResourceString("M_PleaseEnterWorkHoursInHHMMFormat") %>');
                objTxt.value = objTxt.value.split('.').join(':');
                objTxt.focus();
                IsValid = 0;
                return IsValid;
            }

            if (!startDate || startDate === '') {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_PleaseSelectStartDate") %>');
                IsValid = 0;
                return IsValid;
            }
            if (!endDate || endDate === '') {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_PleaseSelectEndDate") %>');
                IsValid = 0;
                return IsValid;
            }

            objTxt.value = objTxt.value.replace('.', ":");
            // Handle datepicker based on mode
            var jsStartDate, jsEndDate;
            var $editRow = $('#parentTaskResourceTable tbody tr.resource-edit-mode');
            if (isUpdateMode) {
                // UPDATE mode: Get values from edit row inputs
                jsStartDate = $editRow.find('.edit-resource-start-date').datepicker('getDate');
                jsEndDate = $editRow.find('.edit-resource-end-date').datepicker('getDate');
                childTaskID = $editRow.data('taskid') || $editRow.data('editing-taskid');
                resourceID = $editRow.data('employeeid');
                resourceName = $editRow.find('.resource-name').text().trim();
                effort = $editRow.find('.edit-resource-work').val();
                objTxt = $editRow.find('.edit-resource-work')[0];
                startDate = $editRow.find('.edit-resource-start-date').val();
                endDate = $editRow.find('.edit-resource-end-date').val();
                parentTaskID = $('#hidden_task_id_offcanvas').val();
                projectID = getCurrentProjectID();
            } else {
                //jsStartDate = $('#add_resource_start_date').datepicker('getDate');
                //jsEndDate = $('#add_resource_end_date').datepicker('getDate');
                jsStartDate = $('#add_resource_start_date').val();
                jsEndDate = $('#add_resource_end_date').val();
            }
            var StartDate = new Date(jsStartDate);
            var EndDate = new Date(jsEndDate);
            if (IsCopyTask === 1) {
                StartDate = startDate;
                EndDate = endDate;
            }

            if (StartDate > EndDate) {
                if (isUpdateMode) {
                    $editRow.find('.edit-resource-start-date').focus();
                } else {
                    $('#add_resource_start_date').focus();
                }
                alertify.error('<%= MyBase.GetResourceString("C_StartDate_Greater") %>');
                IsValid = 0;
                return IsValid;
            }

            // Convert work hours to decimal
            var workParts = effort.split(':');
            var workHours = parseInt(workParts[0]) || 0;
            var workMinutes = parseInt(workParts[1]) || 0;
            var workHoursDecimal = workHours + (workMinutes / 60);
            
            if (workHoursDecimal <= 0) {
                alertify.error('Please enter Work Hours greater than zero.');
                IsValid = 0;
                return IsValid;
            }

            // Get validation data from SP (all validations moved to client-side)
            var projectID = getCurrentProjectID();
            var taskID = isUpdateMode ? parseInt(childTaskID) : parseInt(parentTaskID);
            var GValidationData = getValidationData(projectID, taskID, parentTaskID, resourceID, startDate, endDate, workHoursDecimal);
            
            // Process validation data and perform client-side validations
            // Handle new API response structure: { projectInfo, holidays, employeeLeaves }
            var projectInfo = null;
            var holidayList = [];
            var leaveData = [];
            
            if (GValidationData) {
                // New structure: { projectInfo: {...}, holidays: [...], employeeLeaves: [...] }
                if (GValidationData.projectInfo) {
                    projectInfo = GValidationData.projectInfo;
                    holidayList = GValidationData.holidays || [];
                    leaveData = GValidationData.employeeLeaves || [];
                }
                // Fallback: Old array structure [projectInfo[], holidays[], leaveData[]]
                else if (Array.isArray(GValidationData) && GValidationData.length > 0) {
                    projectInfo = GValidationData[0] && GValidationData[0].length > 0 ? GValidationData[0][0] : null;
                    holidayList = GValidationData[1] || [];
                    leaveData = GValidationData[2] && GValidationData[2].length > 0 ? GValidationData[2] : [];
                }
            }
            
            if (!projectInfo) {
                // No validation data available, proceed with basic validations only
                if (IsValid === 1) {
                   SaveResourceDBLevel(isUpdateMode, childTaskID, parentTaskID, resourceID, effort, startDate, endDate, taskTypeID, subTaskTypeID);
                }
                return IsValid;
            }
            
            // Handle both PascalCase and camelCase property names from API
            var projectLCETotal = parseFloat(projectInfo.ProjectLCETotal || projectInfo.projectLCETotal) || 0;
            var totalWorks = parseFloat(projectInfo.TotalWorks || projectInfo.totalWorks) || 0;
            var projectStartDate = new Date(projectInfo.ProjectStartDate || projectInfo.projectStartDate);
            var projectEndDate = new Date(projectInfo.ProjectEndDate || projectInfo.projectEndDate);
            var restrictByMinHours = projectInfo.RestrictByMinHours === true || projectInfo.RestrictByMinHours === 1 || 
                                     projectInfo.restrictByMinHours === true || projectInfo.restrictByMinHours === 1;
            var minHoursForDAEntry = parseFloat(projectInfo.MinHoursForDAEntry || projectInfo.minHoursForDAEntry) || 0;
            var workingHours = parseFloat(projectInfo.WorkingHours || projectInfo.workingHours) || 8;
            var workingDays = parseInt(projectInfo.WorkingDays || projectInfo.workingDays) || 5;
            var startingDayOfWeek = parseInt(projectInfo.StartingDayOfWeek || projectInfo.startingDayOfWeek) || 1;
            var taskStartDate = (projectInfo.TaskStartDate || projectInfo.taskStartDate) ? new Date(projectInfo.TaskStartDate || projectInfo.taskStartDate) : StartDate;
            var taskEndDate = (projectInfo.TaskEndDate || projectInfo.taskEndDate) ? new Date(projectInfo.TaskEndDate || projectInfo.taskEndDate) : EndDate;
            var resourceAllocStartDate = (projectInfo.resourceStartDate || projectInfo.resourceStartDate) ? new Date(projectInfo.resourceStartDate || projectInfo.resourceStartDate) : resourceStartDate;
            var resourceAllocEndDate = (projectInfo.resourceEndDate || projectInfo.resourceEndDate) ? new Date(projectInfo.resourceEndDate || projectInfo.resourceEndDate) : resourceEndDate;
            var ParentTaskWorkHours = (projectInfo.parentTaskWorkHours || projectInfo.ParentTaskWorkHours) || 0;
            var ChildTaskWorkHours = (projectInfo.childTaskWorkHours || projectInfo.childTaskWorkHours) || 0;
            var ParentChildTaskWorkHours = (projectInfo.ParentChildTaskWorkHours || projectInfo.parentChildTaskWorkHours) || 0;
            var alertNo = 1;
            
            // Validation 1: Check if work hours exceed project LCE total
            var IsExeedHours = 0;
            var balanceWork = projectLCETotal - totalWorks;
            if (workHoursDecimal > balanceWork) {
                validationMessages.push(alertNo + '. The total work (hours) of the assigned tasks should not exceed the project work hours.');
                alertNo++;
                IsValid = 0;
                IsExeedHours = 1;
            }
            
            if (workHoursDecimal + totalWorks > projectLCETotal && IsExeedHours==0) {
                validationMessages.push(alertNo + '. The total work (hours) of the assigned tasks should not exceed the project work hours.');
                alertNo++;
                IsValid = 0;
            }
            
            // Validation 2: Check if task dates are within project dates
            if (StartDate < projectStartDate || EndDate > projectEndDate) {
                var projectStartStr = formatDate(projectStartDate);
                var projectEndStr = formatDate(projectEndDate);
                validationMessages.push(alertNo + '. Start date and end date of the task should be between project start date ' + projectStartStr + ' and End date ' + projectEndStr);
                alertNo++;
                IsValid = 0;
            }
            
            
            if (StartDate && EndDate) {
                // Added by dipali v on 19th Jun 2026 for purpose — confirm when resource dates exceed parent task duration; expand parent dates on Yes
                if (taskStartDate && taskEndDate && validationMessages.length === 0) {
                    var sDate = normalizeDate(StartDate);
                    var eDate = normalizeDate(EndDate);
                    var tStart = normalizeDate(taskStartDate);
                    var tEnd = normalizeDate(taskEndDate);
                    if (sDate && eDate && tStart && tEnd && (sDate < tStart || eDate > tEnd)) {
                        var taskDurationMsg = 'Resource start and end date must be between task start date ' +
                            formatDate(taskStartDate) + ' and task end date ' + formatDate(taskEndDate) +
                            '.Do you want to continue?';
                        addValidationNotification('TASK_DURATION_OUT', taskDurationMsg, 'CONFIRM');
                        IsNotificationCome.push('TASK_DURATION_OUT');
                        GConfirmedMessages.push(taskDurationMsg);
                        IsValid = 0;
                    }
                }
                //;
                // 2. Validate against Resource Allocation duration
                if (resourceAllocStartDate && resourceAllocEndDate) {
                    //const sDate = normalizeDate(StartDate);
                    //const eDate = normalizeDate(EndDate);
                    //const allocStart = normalizeDate(resourceAllocStartDate);
                    //const allocEnd = normalizeDate(resourceAllocEndDate);

                    const sDate = normalizeDate(StartDate);
                    const eDate = normalizeDate(EndDate);
                    const allocStart = normalizeDate(resourceAllocStartDate);
                    const allocEnd = normalizeDate(resourceAllocEndDate);

                    if (sDate < allocStart || eDate > allocEnd) {
                        validationMessages.push(
                            alertNo + '. Resource start and end date must be between resource allocation period ' +
                            formatDate(resourceAllocStartDate) + ' and ' + formatDate(resourceAllocEndDate)
                        );
                        alertNo++;
                        IsValid = 0;
                    }
                }
            }
            //;
            if (isUpdateMode) {
               var TotalHours = timeToMinutes(ParentChildTaskWorkHours) - timeToMinutes(ChildTaskWorkHours) + timeToMinutes(effort)
                //var TotalHours = minutesToTime(TotalHours);

                if (timeToMinutes(effort) > timeToMinutes(ParentTaskWorkHours)) {
                    validationMessages.push(
                        alertNo + '. Child task work hours should not be greater than parent task work hours (' + ParentTaskWorkHours + ').'
                    );
                    alertNo++;
                    IsValid = 0;
                }

                if (timeToMinutes(effort) > timeToMinutes(projectLCETotal)) {
                    validationMessages.push(
                        alertNo + '. Child task work hours should not be greater than project total work hours (' + projectLCETotal + ').'
                    );
                    alertNo++;
                    IsValid = 0;
                }


                if (timeToMinutes(ParentTaskWorkHours) < TotalHours) {
                    validationMessages.push(
                        alertNo + '. Total Child task work hours (' + minutesToTime(TotalHours)  + ') should not be greater than  parent task work hours (' + ParentTaskWorkHours + ').'
                    );
                    alertNo++;
                    IsValid = 0;
                }
            } else {

                var totalAfterAdd = timeToMinutes(decimalToHHMM(totalWorks)) + timeToMinutes(effort);
                var totalAfterAdd = minutesToTime(totalAfterAdd);

                //if (effort > ParentTaskWorkHours) {
                //    validationMessages.push(
                //        alertNo + '. Total child task work hours (' + totalAfterAdd +
                //        ') should not exceed parent task work hours (' + ParentTaskWorkHours + ').'
                //    );
                //    alertNo++;
                //    IsValid = 0;
                //}

                if (totalAfterAdd > projectLCETotal) {
                    validationMessages.push(
                        alertNo + '. Total child task work hours (' + totalAfterAdd +
                        ') should not exceed project total work hours (' + projectLCETotal + ').'
                    );
                    alertNo++;
                    IsValid = 0;
                }

                if (minutesToTime(effort) > minutesToTime(ParentTaskWorkHours)) {
                    validationMessages.push(
                        alertNo + '. Child task work hours should not be greater than parent task work hours (' + ParentTaskWorkHours + ').'
                    );
                    alertNo++;
                    IsValid = 0;
                }

                if (minutesToTime(effort) > projectLCETotal) {
                    validationMessages.push(
                        alertNo + '. Child task work hours should not be greater than project total work hours (' + projectLCETotal + ').'
                    );
                    alertNo++;
                    IsValid = 0;
                }
            }


            // Get task work hours and total resource efforts for validations
            var taskWorkData = getTaskWorkHoursAndResourceEfforts(projectID, parentTaskID, taskID, isUpdateMode);
            //var taskWorkHours = taskWorkData.taskWorkHours || 0;
            var taskWorkHours = ParentTaskWorkHours || 0;
            var totalResourceEfforts = taskWorkData.totalResourceEfforts || 0;
            
            // Validation 2b: Check if resource efforts should not be greater than task efforts
            if (taskWorkHours) {

                var taskWorkMinutes = timeToMinutes(taskWorkHours);     // "10:00" → 600
                var resourceWorkMinutes = Number(workHoursDecimal) * 60; // 8 → 480

                if (resourceWorkMinutes > taskWorkMinutes) {

                    var taskWorkHoursDisplay = minutesToTime(taskWorkMinutes);
                    var resourceWorkHoursDisplay = minutesToTime(resourceWorkMinutes);

                    validationMessages.push(
                        alertNo + '. Resource efforts (' + resourceWorkHoursDisplay +
                        ') should not be greater than task efforts (' + taskWorkHoursDisplay + ').'
                    );
                    alertNo++;
                    IsValid = 0;
                }
            }
            
            // Validation 2c: Check if sum of added/modified resource efforts should not be greater than task efforts
            if (taskWorkHours) {

                // Convert task work hours "HH:MM" → minutes
                var taskWorkMinutes = timeToMinutes(taskWorkHours);

                // Convert resource efforts (decimal) → minutes
                var totalResourceMinutes = Number(totalResourceEfforts) * 60;
                var workMinutes = Number(workHoursDecimal) * 60;

                var totalEffortsAfterAddMinutes = totalResourceMinutes + workMinutes;

                if (totalEffortsAfterAddMinutes > taskWorkMinutes) {

                    var taskWorkHoursDisplay = minutesToTime(taskWorkMinutes);
                    var totalEffortsDisplay = minutesToTime(totalEffortsAfterAddMinutes);

                    validationMessages.push(
                        alertNo + '. Sum of resource efforts (' + totalEffortsDisplay +
                        ') should not be greater than task efforts (' + taskWorkHoursDisplay + ').'
                    );
                    alertNo++;
                    IsValid = 0;
                }
            }
            
            // Validation 3: Check if work hours is multiple of minimum hours (if restriction enabled)
            if (restrictByMinHours && minHoursForDAEntry !== 0.016) {
                var minDAEntryDisplay = '';
                if (minHoursForDAEntry === 0.25) {
                    minDAEntryDisplay = '00:15';
                } else if (minHoursForDAEntry === 0.50) {
                    minDAEntryDisplay = '00:30';
                } else if (minHoursForDAEntry === 0.75) {
                    minDAEntryDisplay = '00:45';
                }
                
                if (minDAEntryDisplay) {
                    var workHoursDecimalForCheck = workHoursDecimal;
                    if ((workHoursDecimalForCheck / minHoursForDAEntry) !== Math.floor(workHoursDecimalForCheck / minHoursForDAEntry)) {
                        validationMessages.push(alertNo + '. Please enter the work hours in multiple of (' + minDAEntryDisplay + ') min.');
                        alertNo++;
                        IsValid = 0;
                    }
                }
            }
            
            // Validation 4: Check average hours per day
            var totalDuration = Math.floor((EndDate - StartDate) / (1000 * 60 * 60 * 24)) + 1;
            var avgHoursPerDay = workHoursDecimal / totalDuration;
            
            if (avgHoursPerDay > 24 ) {
                validationMessages.push(alertNo + '. You cannot assign more than 24 hours work per day.');
                alertNo++;
                IsValid = 0;
            }
            
            // Validation 5: Check if average hours per day exceeds working hours per day (warning/confirmation)
            if (avgHoursPerDay > workingHours && validationMessages.length === 0 && !IsNotificationCome.includes('OUWORKING')) {
                var workHoursDisplay = convertDecimalToHourFormat(avgHoursPerDay);
                var workingHoursDisplay = convertDecimalToHourFormat(workingHours);
                var confirmMsg = 'You are assigning ' + workHoursDisplay + ' hours work per day.\n(OU working hours per day are ' + workingHoursDisplay + ' hours.)\nDo you want to continue?';
                addValidationNotification('WFH', confirmMsg, 'CONFIRM');
                IsNotificationCome.push('OUWORKING')
                GConfirmedMessages.push(confirmMsg);
                IsValid = 0;
            }
            
            //// Validation 6: Check for date changes in edit mode
            //if (isUpdateMode && taskID ) {
            //    if (taskStartDate && StartDate.getTime() !== taskStartDate.getTime() && validationMessages.length === 0 && !IsNotificationCome.includes('CHANGEASTARTDATE')) {
            //        var dateChangeMsg = 'Changing start date can cause incorrect scheduling of tasks already assigned to resources. Do you want to continue?';
            //        addValidationNotification('WFH', dateChangeMsg, 'CONFIRM');
            //        IsNotificationCome.push('CHANGEASTARTDATE')
            //        GConfirmedMessages.push(dateChangeMsg);
            //        IsValid = 0;
            //    }
                
            //    if (taskEndDate && EndDate.getTime() !== taskEndDate.getTime() && validationMessages.length === 0 
            //        && !IsNotificationCome.includes('CHANGEAENDDATE')) {
            //        var endDateChangeMsg = 'Changing end date can cause incorrect scheduling of tasks already assigned to resources. Do you want to continue?';
            //        addValidationNotification('WFH', endDateChangeMsg, 'CONFIRM');
            //        IsNotificationCome.push('CHANGEAENDDATE')
            //        GConfirmedMessages.push(endDateChangeMsg);
            //        IsValid = 0;
            //    }
            //}
            
            // Validation 7: Check for leave/WFH
            if (leaveData && leaveData.length > 0) {
                var leaveMsg = '';
                for (var i = 0; i < leaveData.length; i++) {
                    // Handle both PascalCase and camelCase property names
                    var empName = leaveData[i].EmployeeName || leaveData[i].employeeName || '';
                    var leaveDays = leaveData[i].LeaveDays || leaveData[i].leaveDays || '';
                    var wfhDays = leaveData[i].WFHDays || leaveData[i].wfHDays || leaveData[i].wfhDays || '';
                    
                    if (empName && !IsNotificationCome.includes('WFH')) {
                        if (leaveDays) {
                            leaveMsg = empName + ' has leave(s) on:\n\n' + leaveDays.trim();
                        }
                        if (wfhDays) {
                            if (leaveMsg) {
                                leaveMsg += '\n\nWork From Home on:\n\n' + wfhDays.trim();
                            } else {
                                leaveMsg = empName + ' has Work From Home on:\n\n' + wfhDays.trim();
                            }
                        }
                        if (leaveMsg && validationMessages.length === 0) {
                            leaveMsg += '\n\nDo you want to continue?';
                            addValidationNotification('WFH', leaveMsg, 'CONFIRM');
                            IsNotificationCome.push('WFH')
                            GConfirmedMessages.push(leaveMsg);
                            IsValid = 0;
                        }
                    }
                }
            }
            
            // Validation 8: Check for holidays
            if (holidayList && holidayList.length > 0) {
                var holidayDates = [];
                var checkDate = new Date(StartDate);
                var endCheckDate = new Date(EndDate);
                
                while (checkDate <= endCheckDate) {
                    var dayOfWeek = checkDate.getDay(); // 0 = Sunday, 1 = Monday, etc.
                    var adjustedDay = (dayOfWeek === 0) ? 7 : dayOfWeek; // Convert Sunday to 7
                    
                    // Check if it's a working day based on startingDayOfWeek
                    var isWorkingDay = false;
                    if (startingDayOfWeek === 1) {
                        isWorkingDay = adjustedDay <= workingDays;
                    } else {
                        // Adjust for different starting days
                        var adjustedDayForWeek = ((adjustedDay - startingDayOfWeek + 7) % 7) + 1;
                        isWorkingDay = adjustedDayForWeek <= workingDays;
                    }
                    
                    if (isWorkingDay) {
                        var dateStr = formatDateForHolidayCheck(checkDate);
                        for (var j = 0; j < holidayList.length; j++) {
                            // Handle both PascalCase and camelCase property names
                            var holidayDate = holidayList[j].HolidayDate || holidayList[j].holidayDate;
                            if (holidayDate && dateStr === formatDateForHolidayCheck(new Date(holidayDate))) {
                                holidayDates.push(holidayDate);
                                break;
                            }
                        }
                    }
                    checkDate.setDate(checkDate.getDate() + 1);
                }
                
                if (holidayDates.length > 0 && validationMessages.length === 0 && !IsNotificationCome.includes('ALL_DATES')) {
                    //var formattedDates = holidayDates.map(function (date) {
                    //    return formatDate(date);
                    //});
                    var holidayMsg =
                        'The dates ' + holidayDates.join(', ') +' falling between the start date and end date for this task are holidays.' +'Do you want to continue?';

                    addValidationNotification('ALL_DATES', holidayMsg, 'CONFIRM');
                    IsNotificationCome.push('ALL_DATES');
                    GConfirmedMessages.push(holidayMsg);
                    IsValid = 0;
                }
            }
            
            // Validation 9: Check if all days are holidays/weekends
            var weekendCount = 0;
            var checkDateForWeekend = new Date(StartDate);
            var endCheckDateForWeekend = new Date(EndDate);
            var cnt = 0;
            
            while (cnt < totalDuration) {
                var currentDate = new Date(StartDate);
                currentDate.setDate(currentDate.getDate() + cnt);
                var dayOfWeekForWeekend = currentDate.getDay();
                var adjustedDayForWeekend = (dayOfWeekForWeekend === 0) ? 7 : dayOfWeekForWeekend;
                
                var isWeekend = false;
                if (startingDayOfWeek === 1) {
                    isWeekend = adjustedDayForWeekend > workingDays;
                } else {
                    var adjustedDayForWeekendCalc = ((adjustedDayForWeekend - startingDayOfWeek + 7) % 7) + 1;
                    isWeekend = adjustedDayForWeekendCalc > workingDays;
                }
                
                if (isWeekend) {
                    weekendCount++;
                }
                cnt++;
            }
            
            if (totalDuration - weekendCount === 0 && validationMessages.length === 0 && !isValidationConfirmed('ALL_HOLIDAYS')) {
                var allHolidaysMsg = 'All the days in the specified date range are holidays/weekends. Do you wish to continue?';
                addValidationNotification('ALL_HOLIDAYS', allHolidaysMsg, 'CONFIRM');
                IsNotificationCome.push('ALL_HOLIDAYS')
                GConfirmedMessages.push(allHolidaysMsg);
                IsValid = 0;
            }
            
            // Show validation errors in one alertify — numbered rows 1. 2. 3. ...
            if (validationMessages.length > 0) {
                showValidationAlertifyError(validationMessages);
                return IsValid;
            }
            
            // Show confirmation notifications if any
            if (GValidationNotifications.length > 0 || validationMessages.length > 0 || GConfirmedMessages.length > 0)
            {
                //IsValid = 0;
                showNextValidationNotification(isUpdateMode, childTaskID, parentTaskID, resourceID, effort, startDate, endDate, taskTypeID, subTaskTypeID);
            }
            //else if (IsValid === 1) {
            //    // All validations passed
            //    SaveResourceDBLevel(isUpdateMode, childTaskID, parentTaskID, resourceID, effort, startDate, endDate, taskTypeID, subTaskTypeID);
            //}
            
            return IsValid;
        }
        
        // Added by Dipali V on 13th Jan 2026 - Helper function to convert decimal hours to HH:MM format
        function convertDecimalToHourFormat(decimalHours) {
            var hours = Math.floor(decimalHours);
            var minutes = Math.round((decimalHours - hours) * 60);
            if (minutes >= 60) {
                hours += Math.floor(minutes / 60);
                minutes = minutes % 60;
            }
            return (hours < 10 ? '0' : '') + hours + ':' + (minutes < 10 ? '0' : '') + minutes;
        }
        
        // Added by Dipali V on 13th Jan 2026 - Helper function to format date for holiday check (YYYY-MM-DD)
        function formatDateForHolidayCheck(date) {
            var year = date.getFullYear();
            var month = ('0' + (date.getMonth() + 1)).slice(-2);
            var day = ('0' + date.getDate()).slice(-2);
            return year + '-' + month + '-' + day;
        }
        var IsNotificationCome = [];
        function isValidationConfirmed(validationKey) {
            return GConfirmedValidationMessages.indexOf(validationKey) !== -1;

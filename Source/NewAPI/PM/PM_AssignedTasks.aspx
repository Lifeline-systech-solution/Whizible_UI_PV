        // Added by Dipali V on 13th Jan 2026 - Helper function to format date for API
        function formatDateForAPI(dateString) {
            if (!dateString) return '';
            // Convert from "DD MMM YYYY" to "YYYY-MM-DD" format
            var date = new Date(dateString);
            if (isNaN(date.getTime())) {
                return dateString;
            }
            var year = date.getFullYear();
            var month = String(date.getMonth() + 1).padStart(2, '0');
            var day = String(date.getDate()).padStart(2, '0');
            return year + '-' + month + '-' + day;
        }
        
        // Added by Dipali V on 13th Jan 2026 - Helper function to convert work from HH:MM to decimal hours
        function convertWorkToDecimal(workHHMM) {
            if (!workHHMM) return 0;
            var parts = workHHMM.split(':');
            if (parts.length !== 2) return 0;
            var hours = parseInt(parts[0], 10) || 0;
            var minutes = parseInt(parts[1], 10) || 0;
            return hours + (minutes / 60);
        }
        
       

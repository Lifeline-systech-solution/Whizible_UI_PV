        // Purpose: Perform the actual delete operation - Added by Dipali V on 06th Jan 2026
        function performDeleteResource(childTaskID, projectID, parentTaskID,FromWhere,Count) {
            // Prepare request for VoidTask endpoint - Fixed by Dipali V on 06th Jan 2026
            // TaskList must be a string (comma-separated task IDs)
            var deleteRequest = {
                TaskList: childTaskID.toString(), // Convert to string as required by VoidTaskRequest
                ProjectID: parseInt(projectID)
            };
            
            //return;
            try {
                // Call VoidTask endpoint - Fixed by Dipali V on 06th Jan 2026
                var result = AJAXCallWithResult(
                    'api/PM_AssignedTasks/VoidTask',
                    JSON.stringify(deleteRequest),
                    false
                );
               // ;
                if (result && result.status === 'SUCCESS') {
                    alertify.set('notifier', 'position', 'top-right');
                    if (FromWhere == "ResourceListView") {
                        alertify.success('<%= MyBase.GetResourceString("C_ResourceDeleted") %>');
                    }
                    else if (FromWhere == "ParentListView" && (Count > 1 || Count == 0)) {
                        alertify.success('<%= MyBase.GetResourceString("C_ParentTaskandChilddelete") %>');
                    }
                    //else if (FromWhere == "ParentListView" && Count > 1) {
                    //    alertify.success('Parent Task deleted successfully');
                    //}
                    else if (FromWhere == "ChildListView" && Count === 1) {
                        alertify.success('<%= MyBase.GetResourceString("C_ChildParent") %>');
                    }
                    else if (FromWhere == "ChildListView" && Count > 1) {
                        alertify.success('<%= MyBase.GetResourceString("C_ChildTaskDeleted") %>');
                    }
                    else if (FromWhere == "ChildListView" && Count ===0) {
                        alertify.success('<%= MyBase.GetResourceString("C_ChildTaskDeleted") %>');
                    }
                    else if (FromWhere == "ResourceListView" && Count > 1) {
                        alertify.success('<%= MyBase.GetResourceString("C_ResourceItsChildTask") %>');
                    }
                    else if (FromWhere == "ResourceListView" && Count === 0) {
                        alertify.success('<%= MyBase.GetResourceString("C_ResourceandParentTask") %>');
                    }
                    
                    // Refresh main list view - Added by Dipali V on 06th Jan 2026
                    loadAssignedTasks(true, false);
                    
                    // Refresh parent task child resources - Added by Dipali V on 06th Jan 2026
                    loadParentTaskChildResources(projectID, parentTaskID);
                } else {
                    var errorMsg = result && result.message 
                        ? result.message 
                        : 'Error deleting resource. Please try again.';
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error(errorMsg);
                }
            } catch (error) {
                console.error('Error in performDeleteResource:', error);
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('An error occurred while deleting resource. Please try again.');
            }
        }



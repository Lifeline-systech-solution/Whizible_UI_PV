        //Added By Dipali V On 2nd Jan 2026 For On Filter Click Dropdown Bind
        // Added By Dipali V On 3rd Feb 2026 For W26 - Prevent search section from opening if project not selected
        $("#searchSectionBtn").on("click", function (e)
        {
            var selectedProject = $('#cboAssignedTaskProject').val();
            // Added By Dipali V On 3rd Feb 2026 For W26 - Check if project is placeholder or not selected
            if (!selectedProject || selectedProject === '' || selectedProject === '0' || selectedProject === 'Select Project') {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_PleaseSelectProject") %>');
                e.preventDefault();
                e.stopPropagation();
                // Prevent Bootstrap collapse from opening
                var collapseElement = document.getElementById('filterAccordionCollapse');
                if (collapseElement) {
                    var collapseInstance = bootstrap.Collapse.getInstance(collapseElement);
                    if (collapseInstance && collapseInstance._isTransitioning) {
                        collapseInstance.hide();
                    }
                }
                return false;
            }
            // Added By Dipali V On 3rd Feb 2026 For W26 - Load filter data when project is selected
            //loadTaskStatus();
            //loadFilterDropdownValues(selectedProject);
            //loadProjectResources(selectedProject, null, null);
            // Added by DipalI v On 3rd sep 2026 - Purpose: reload filter dropdowns then restore applied Is Task Completed/Resource so reopen Search Section keeps selected values
            loadTaskStatus();
            loadFilterDropdownValues(selectedProject);
            loadProjectResources(selectedProject, null, null);
            restoreAppliedResourceFilter();
            if (initialFilterState.taskStatus !== null && initialFilterState.taskStatus !== undefined && initialFilterState.taskStatus !== '') {
                var $statusDropdown = $('#sel_task_status');
                if ($statusDropdown.find('option[value="' + initialFilterState.taskStatus + '"]').length > 0) {
                    $statusDropdown.val(initialFilterState.taskStatus);
                    if (typeof $.fn.selectpicker !== 'undefined' && $statusDropdown.hasClass('selectpicker')) {
                        $statusDropdown.selectpicker('refresh');
                    }
                }
            }
        });
        //End of Added By Dipali V On 2nd Jan 2026 For On Filter Click Dropdown Bind





    </script>

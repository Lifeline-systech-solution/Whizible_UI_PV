        // Modified by Dipali V on 4th Jan 2025 - Purpose: Bind baseline, current, and actual data to baseline table from API response
        function bindBaselineData(taskData) {
            //;
            if (taskData == "") {
                taskData = GtaskList;
            }
            if (!taskData) {
                console.warn('bindBaselineData: taskData is null or undefined');
                return;
            }

            // Extract Current/Plan data
            var startDate = getTaskProp(taskData, 'StartDate', '') || getTaskProp(taskData, 'startDate', '');
            if (startDate == "") {
                startDate = taskData[0].startDate;
            }
            var endDate = getTaskProp(taskData, 'EndDate', '') || getTaskProp(taskData, 'endDate', '');
            if (endDate == "") {
                endDate = taskData[0].endDate;
            }
            var duration = getTaskProp(taskData, 'Duration', '') || getTaskProp(taskData, 'duration', '');
            if (duration == "") {
                duration = taskData[0].duration;
            }
            var work = getTaskProp(taskData, 'Work', '') || getTaskProp(taskData, 'WorkHourMinute', '') || getTaskProp(taskData, 'work', '');
            if (work == "") {
                work = taskData[0].work;
            }
            // Extract Baseline data
            var baselineStart = getTaskProp(taskData, 'BaselineStart', '') || getTaskProp(taskData, 'baselineStart', '');
            if (baselineStart == "" && (Setbaselineflag == "SetBaseline" || Setbaselineflag == "ClearBaseline"))
            {
                baselineStart = taskData[0].baselineStart;
            }
            var baselineEnd = getTaskProp(taskData, 'BaselineEnd', '') || getTaskProp(taskData, 'baselineEnd', '');

            if (baselineEnd == "" && (Setbaselineflag == "SetBaseline" || Setbaselineflag == "ClearBaseline")) {
                baselineEnd = taskData[0].baselineEnd;
            }
            var baselineDuration = getTaskProp(taskData, 'BaselineDuration', '') || getTaskProp(taskData, 'baselineDuration', '');
            if (baselineDuration == "" && (Setbaselineflag == "SetBaseline" || Setbaselineflag == "ClearBaseline")) {
                baselineDuration = taskData[0].baselineDuration;
            }
            var baselineWork = getTaskProp(taskData, 'BaselineWork', '') || getTaskProp(taskData, 'baselineWork', '');
            if (baselineWork == "" && (Setbaselineflag == "SetBaseline" || Setbaselineflag == "ClearBaseline")) {
                baselineWork = taskData[0].baselineWork;
            }
            // Extract Actual data
            var actualStartDate = getTaskProp(taskData, 'ActualStartDate', '') || getTaskProp(taskData, 'actualStartDate', '');
            if (actualStartDate == "" && (Setbaselineflag == "SetBaseline" || Setbaselineflag == "ClearBaseline")) {
                actualStartDate = taskData[0].actualStartDate;
            }
            var actualEndDate = getTaskProp(taskData, 'ActualEndDate', '') || getTaskProp(taskData, 'actualEndDate', '');
            if (actualEndDate == "" && (Setbaselineflag == "SetBaseline" || Setbaselineflag == "ClearBaseline")) {
                actualEndDate = taskData[0].actualEndDate;
            }
            var actualDuration = getTaskProp(taskData, 'ActualDuration', '') || getTaskProp(taskData, 'actualDuration', '');
            if (actualDuration == "" && (Setbaselineflag == "SetBaseline" || Setbaselineflag == "ClearBaseline")) {
                actualDuration = taskData[0].actualDuration;
            }
            var actualWork = getTaskProp(taskData, 'ActualWork', '') || getTaskProp(taskData, 'ActualWorkHourMinute', '') || getTaskProp(taskData, 'actualWork', '');
            if (actualWork == "" && (Setbaselineflag == "SetBaseline" || Setbaselineflag == "ClearBaseline")) {
                actualWork = taskData[0].actualWork;
            }
            // Helper function to format duration (handle both number and string)
            var formatDuration = function(duration) {
                if (!duration && duration !== 0) return '-';
                var numDuration = parseFloat(duration);
                if (isNaN(numDuration)) return '-';
                return numDuration.toFixed(2);
            };

            // Bind Current row data
            $('#baseline_current_startdate').text(formatDateForDisplay(startDate) || '-');
            $('#baseline_current_enddate').text(formatDateForDisplay(endDate) || '-');
            if ($('#baseline_current_startdate').text() == "-") {
                $('#baseline_current_duration').text("-");
                $('#baseline_current_work').text("-");
            } else {
                $('#baseline_current_duration').text(formatDuration(duration));
                $('#baseline_current_work').text(formatWorkValue(work));
            }
            // Bind Baseline row data
            $('#baseline_baseline_startdate').text(formatDateForDisplay(baselineStart) || '-');
            $('#baseline_baseline_enddate').text(formatDateForDisplay(baselineEnd) || '-');
            //;
            if ($('#baseline_baseline_startdate').text() == "-") {
                $('#baseline_baseline_duration').text("-");
                $('#baseline_baseline_work').text("-");
            }
            else {
                $('#baseline_baseline_duration').text(formatDuration(baselineDuration));
                $('#baseline_baseline_work').text(formatWorkValue(baselineWork));

            }
            
            // Added By Dipali V On 23rd Jan 2026 For W26 - Updated to show both Set and Clear Baseline buttons always
            var hasBaselineDates = baselineStart && baselineStart !== '' && baselineStart !== '-' && baselineStart !== null && baselineStart !== undefined &&
                                   baselineEnd && baselineEnd !== '' && baselineEnd !== '-' && baselineEnd !== null && baselineEnd !== undefined;
            
            // Both buttons are always visible - enable/disable based on baseline status
            // Set Baseline button: enabled when no baseline exists
            // Clear Baseline button: enabled when baseline exists
            if (hasBaselineDates) {
                // Baseline exists - enable Clear, disable Set
                $('#btn_set_baseline_tab, #btn_set_baseline_offcanvas').prop('disabled', true).css('opacity', '0.5');
                $('#btn_clear_baseline_tab, #btn_clear_baseline_offcanvas').prop('disabled', false).css('opacity', '1');
            } else {
                // No baseline - enable Set, disable Clear
                $('#btn_set_baseline_tab, #btn_set_baseline_offcanvas').prop('disabled', false).css('opacity', '1');
                $('#btn_clear_baseline_tab, #btn_clear_baseline_offcanvas').prop('disabled', true).css('opacity', '0.5');
            }
           
            // Bind Actual row data
            $('#baseline_actual_startdate').text(formatDateForDisplay(actualStartDate) || '-');
            $('#baseline_actual_enddate').text(formatDateForDisplay(actualEndDate) || '-');

            if ($('#baseline_actual_enddate').text() == "-") {
                $('#baseline_actual_duration').text("-");
                $('#baseline_actual_work').text("-");
            }
            else {
                $('#baseline_actual_duration').text(formatDuration(actualDuration));
                $('#baseline_actual_work').text(formatWorkValue(actualWork));


            }
        }
        

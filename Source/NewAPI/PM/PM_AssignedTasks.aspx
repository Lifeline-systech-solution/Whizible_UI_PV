        // Added by Dipali V on 25th Jun 2026 - Purpose: parent resource UPDATE — page-level soft confirm chain (like NEW_TASK_RESOURCE_MULTI)
        function collectParentResourceSoftNotifications(saveParams) {
            var out = [];
            var effort = saveParams.effort || '0:00';
            var parts = effort.split(':');
            var workHoursDecimal = (parseInt(parts[0], 10) || 0) + ((parseInt(parts[1], 10) || 0) / 60);
            var data = getValidationData(
                getCurrentProjectID(),
                parseInt(saveParams.childTaskID, 10),
                saveParams.parentTaskID,
                saveParams.resourceID,
                saveParams.startDate,
                saveParams.endDate,
                workHoursDecimal
            );
            if (!data || !data.projectInfo) return out;
            var pi = data.projectInfo;
            var holidayList = data.holidays || [];
            var leaveData = data.employeeLeaves || [];
            var StartDate = parseDate(saveParams.startDate) || new Date(saveParams.startDate);
            var EndDate = parseDate(saveParams.endDate) || new Date(saveParams.endDate);
            var taskStartDate = (pi.TaskStartDate || pi.taskStartDate) ? new Date(pi.TaskStartDate || pi.taskStartDate) : StartDate;
            var taskEndDate = (pi.TaskEndDate || pi.taskEndDate) ? new Date(pi.TaskEndDate || pi.taskEndDate) : EndDate;
            var workingHours = parseFloat(pi.WorkingHours || pi.workingHours) || 8;
            var workingDays = parseInt(pi.WorkingDays || pi.workingDays) || 5;
            var startingDayOfWeek = parseInt(pi.StartingDayOfWeek || pi.startingDayOfWeek) || 1;
            var sDate = normalizeDate(StartDate), eDate = normalizeDate(EndDate);
            var tStart = normalizeDate(taskStartDate), tEnd = normalizeDate(taskEndDate);
            if (sDate && eDate && tStart && tEnd && (sDate < tStart || eDate > tEnd)) {
                out.push({
                    key: 'TASK_DURATION',
                    message: 'Resource start and end date must be between task start date ' +
                        formatDate(taskStartDate) + ' and task end date ' + formatDate(taskEndDate) +
                        '.Do you want to continue?'
                });
            }
            if (leaveData && leaveData.length) {
                var leaveMsg = '';
                for (var i = 0; i < leaveData.length; i++) {
                    var empName = leaveData[i].EmployeeName || leaveData[i].employeeName || '';
                    var leaveDays = leaveData[i].LeaveDays || leaveData[i].leaveDays || '';
                    var wfhDays = leaveData[i].WFHDays || leaveData[i].wfHDays || leaveData[i].wfhDays || '';
                    if (!empName) continue;
                    if (leaveDays) leaveMsg = empName + ' has leave(s) on:\n\n' + String(leaveDays).trim();
                    if (wfhDays) {
                        leaveMsg = leaveMsg
                            ? leaveMsg + '\n\nWork From Home on:\n\n' + String(wfhDays).trim()
                            : empName + ' has Work From Home on:\n\n' + String(wfhDays).trim();
                    }
                    if (leaveMsg) {
                        out.push({ key: 'LEAVE_WFH', message: leaveMsg + '\n\nDo you want to continue?' });
                        break;
                    }
                }
            }
            if (holidayList && holidayList.length) {
                var holidayDates = [], checkDate = new Date(StartDate), endCheckDate = new Date(EndDate);
                while (checkDate <= endCheckDate) {
                    var dayOfWeek = checkDate.getDay();
                    var adjustedDay = dayOfWeek === 0 ? 7 : dayOfWeek;
                    var isWorkingDay = startingDayOfWeek === 1
                        ? adjustedDay <= workingDays
                        : (((adjustedDay - startingDayOfWeek + 7) % 7) + 1) <= workingDays;
                    if (isWorkingDay) {
                        var dateStr = formatDateForHolidayCheck(checkDate);
                        for (var j = 0; j < holidayList.length; j++) {
                            var holidayDate = holidayList[j].HolidayDate || holidayList[j].holidayDate;
                            if (holidayDate && dateStr === formatDateForHolidayCheck(new Date(holidayDate))) {
                                holidayDates.push(holidayDate);
                                break;
                            }
                        }
                    }
                    checkDate.setDate(checkDate.getDate() + 1);
                }
                if (holidayDates.length) {
                    out.push({
                        key: 'HOLIDAY',
                        message: 'The dates ' + holidayDates.join(', ') +
                            ' falling between the start date and end date for this task are holidays.Do you want to continue?'
                    });
                }
            }
            var totalDuration = Math.floor((EndDate - StartDate) / (1000 * 60 * 60 * 24)) + 1;
            var avgHoursPerDay = workHoursDecimal / (totalDuration || 1);
            if (avgHoursPerDay > workingHours) {
                out.push({
                    key: 'OU_HOURS',
                    message: 'You are assigning ' + convertDecimalToHourFormat(avgHoursPerDay) +
                        ' hours work per day.\n(OU working hours per day are ' +
                        convertDecimalToHourFormat(workingHours) + ' hours.)\nDo you want to continue?'
                });
            }
            var weekendCount = 0, cnt = 0;
            while (cnt < totalDuration) {
                var currentDate = new Date(StartDate);
                currentDate.setDate(currentDate.getDate() + cnt);
                var dow = currentDate.getDay();
                var adj = dow === 0 ? 7 : dow;
                var isWeekend = startingDayOfWeek === 1 ? adj > workingDays
                    : (((adj - startingDayOfWeek + 7) % 7) + 1) > workingDays;
                if (isWeekend) weekendCount++;
                cnt++;
            }
            if (totalDuration - weekendCount === 0) {
                out.push({
                    key: 'ALL_WEEKEND',
                    message: 'All the days in the specified date range are holidays/weekends. Do you want to continue?'
                });
            }
            return out;
        }

        function buildParentResourceUpdateSoftQueue(saveParams, spSoftMsg) {
            var order = ['TASK_DURATION', 'LEAVE_WFH', 'HOLIDAY', 'OU_HOURS', 'ALL_WEEKEND'];
            var byKey = {};
            collectParentResourceSoftNotifications(saveParams).forEach(function (item) {
                byKey[item.key] = item.message;
            });
            if (spSoftMsg) byKey[getResourceSoftConfirmKey(spSoftMsg)] = spSoftMsg;
            var queue = [];
            order.forEach(function (k) {
                if (byKey[k]) queue.push({ key: k, message: byKey[k] });
            });
            return queue;
        }

        function showNextParentResourceUpdateSoftConfirmation() {
            if (GParentResourceUpdateSoftIndex >= GParentResourceUpdateSoftQueue.length) {
                var p = GPendingParentResourceUpdate;
                GPendingParentResourceUpdate = null;
                GParentResourceUpdateSoftQueue = [];
                GParentResourceUpdateSoftIndex = 0;
                if (p) {
                    SaveResourceDBLevel(true, p.childTaskID, p.parentTaskID, p.resourceID,
                        p.effort, p.startDate, p.endDate, p.taskTypeID, p.subTaskTypeID);
                }
                return;
            }
            var item = GParentResourceUpdateSoftQueue[GParentResourceUpdateSoftIndex];
            GconfirmationActionType = 'PARENT_RESOURCE_UPDATE';
            showConfirmDeleteResourceModal(formatValidationAlertHtml(item.message));
        }

        function startParentResourceUpdateSoftChain(saveParams, spSoftMsg) {
            GPendingParentResourceUpdate = saveParams;
            GParentResourceUpdateSoftQueue = buildParentResourceUpdateSoftQueue(saveParams, spSoftMsg);
            GParentResourceUpdateSoftIndex = 0;
            if (!GParentResourceUpdateSoftQueue.length) {
                SaveResourceDBLevel(true, saveParams.childTaskID, saveParams.parentTaskID, saveParams.resourceID,
                    saveParams.effort, saveParams.startDate, saveParams.endDate, saveParams.taskTypeID, saveParams.subTaskTypeID);
                GPendingParentResourceUpdate = null;
                return;
            }
            showNextParentResourceUpdateSoftConfirmation();
        }

        function handleTeamsParentResourceUpdateResponse(validationResult, saveParams) {
            var result = validationResult && validationResult.list && validationResult.list[0]
                ? validationResult.list[0] : null;
            if (!result) {
                alertify.error('<%= MyBase.GetResourceString("M_ValidationFailedPleaseCheckInput") %>');
                return;
            }
            var isValid = result.isValid === true || result.isValid === 1 || result.IsValid === true || result.IsValid === 1;
            var errorMsg = result.errorMessage || result.ErrorMessage || '';
            if (!isValid && errorMsg && !isSpSoftResourceConfirmationOnly(errorMsg)) {
                showValidationAlertifyError(formatValidationAlertHtml(errorMsg));
                return;
            }
            startParentResourceUpdateSoftChain(saveParams, (!isValid && isSpSoftResourceConfirmationOnly(errorMsg)) ? errorMsg : null);
        }


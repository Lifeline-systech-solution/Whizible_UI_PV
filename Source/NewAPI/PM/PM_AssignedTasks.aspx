        // Consolidated function to populate the baseline table
        function populateTaskBaselineTable(baselineList, tableSelector = '#showbaselinetbl', taskNameSelector = '#baselineTaskName') {
            var tbody = $(tableSelector + ' tbody');
            tbody.empty();

            try {
                if (baselineList && Array.isArray(baselineList) && baselineList.length > 0) {

                    // Check if DataTable is already initialized
                    var isDataTable = $.fn.dataTable.isDataTable(tableSelector);

                    if (isDataTable) {
                        // Destroy existing DataTable
                        $(tableSelector).DataTable().destroy();
                    }

                    // Clear tbody completely after DataTable destruction
                    tbody.empty();

                    // Extract task name from first record
                    var taskName = '';
                    if (baselineList.length > 0) {
                        taskName = baselineList[0].TaskName || baselineList[0].taskName || '-';
                    }
                    $(taskNameSelector).text(taskName);

                    // Date formatting helper
                    var formatDateTime = function (dateString) {
                        if (!dateString) return '-';
                        try {
                            var date = new Date(dateString);
                            if (isNaN(date.getTime())) return '-';

                            var options = {
                                year: 'numeric',
                                month: '2-digit',
                                day: '2-digit',
                                hour: '2-digit',
                                minute: '2-digit',
                                second: '2-digit',
                                hour12: false
                            };

                            return date.toLocaleString('en-US', options);
                        } catch (error) {
                            return dateString;
                        }
                    };


                    // Add rows to tbody
                    $.each(baselineList, function (index, record) {
                        if (record) {
                            // Handle both uppercase and lowercase property names
                            var baselineChangeDate = record.BaselineChangeDate || record.baselineChangeDate || '';
                            var startDate = record.StartDate || record.startDate || '';
                            var endDate = record.EndDate || record.endDate || '';
                            var baselineStartDate = record.BaselineStartDate || record.baselineStartDate || '';
                            var baselineEndDate = record.BaselineEndDate || record.baselineEndDate || '';
                            var work = record.Work || record.work || 0;
                            var duration = record.Duration || record.duration || 0;

                            var row = '<tr>' +
                                '<td>' + formatDateTime(baselineChangeDate) + '</td>' +
                                '<td>' + formatDateForDisplay(startDate) + '</td>' +
                                '<td>' + formatDateForDisplay(endDate) + '</td>' +
                                '<td>' + formatDateForDisplay(baselineStartDate) + '</td>' +
                                '<td>' + formatDateForDisplay(baselineEndDate) + '</td>' +
                                '<td>' + (work || '-') + '</td>' +
                                '<td>' + (duration || '-') + '</td>' +
                                '</tr>';
                            tbody.append(row);
                        }
                    });

                    // Initialize DataTable after a small delay to ensure DOM is updated
                    // Offcanvas baseline uses custom pagination (Total Records + « »); modal can use DataTable paging or same.
                    var isOffcanvasTable = (tableSelector === '#showbaselinetbl_offcanvas');
                    setTimeout(function () {
                        if (typeof $.fn.dataTable !== 'undefined') {
                            $(tableSelector).DataTable({
                                scrollY: true,
                                scrollX: true,
                                paging: !isOffcanvasTable,
                                pageLength: isOffcanvasTable ? baselinePageSize_offcanvas : 10,
                                bLengthChange: false,
                                bFilter: false,
                                ordering: false,
                                info: !isOffcanvasTable,
                                responsive: true,
                                destroy: true,
                                retrieve: false,
                                autoWidth: false,
                                columnDefs: [
                                    { targets: [0, 1, 2, 3, 4, 5, 6], className: 'text-center' }
                                ]
                            });
                        }
                    }, 100);

                } else {
                    tbody.html('<tr><td colspan="7" class="text-center py-2"><div class="empty-state"><p class="mb-0">No baseline history found</p></div></td></tr>');
                    $(taskNameSelector).text('-');
                }
            } catch (error) {
                tbody.html('<tr><td colspan="7" class="text-center py-2"><div class="empty-state"><p class="mb-0">Error loading baseline data</p></div></td></tr>');
                $(taskNameSelector).text('-');
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('Error populating baseline table: ' + error.message);
            }
        }

        // Added by Dipali V on 13th Jan 2026 - Collect all custom field values from UI
        function collectCustomFieldValues() {
            
            var customFields = {};

            // Text Fields (1-10)
            for (var i = 1; i <= 10; i++) {

                var fieldName = 'CustomFieldText' + i;
                var $field = $('#txt' + fieldName);

                if ($field.length > 0) {
                    customFields[fieldName] = $.trim($field.val() || '');
                }
            }

            // Numeric Fields (1-5)
            for (var i = 1; i <= 5; i++) {

                var fieldName = 'CustomFieldNumeric' + i;
                var $field = $('#txt' + fieldName);

                if ($field.length > 0) {
                    customFields[fieldName] = $.trim($field.val() || '');
                }
            }

            // Date Fields (1-5)
            for (var i = 1; i <= 5; i++) {

                var fieldName = 'CustomFieldDate' + i;
                var $field = $('#dt' + fieldName);

                if ($field.length > 0) {
                    customFields[fieldName] = $.trim($field.val() || '');
                }
            }

            // Combo Fields (1-10)
            for (var i = 1; i <= 10; i++) {

                var fieldName = 'CustomFieldCombo' + i;
                var $field = $('#cbo' + fieldName);

                if ($field.length > 0) {
                    customFields[fieldName] = $field.val() || '';
                }
            }

            // TextArea Fields (1-3)
            for (var i = 1; i <= 3; i++) {

                var fieldName = 'CustomFieldTextArea' + i;
                var $field = $('#txt' + fieldName);

                if ($field.length > 0) {
                    customFields[fieldName] = $.trim($field.val() || '');
                }
            }

            return customFields;
        }


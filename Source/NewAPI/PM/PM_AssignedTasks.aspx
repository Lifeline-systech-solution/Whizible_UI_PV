        function ensureResourceSelectPlaceholderOption($select) {
            var placeholderText = getResourceSelectPlaceholderText();
            $select.attr('data-none-selected-text', placeholderText);
            // Purpose: selectable placeholder so user can deselect resource after selection
            var $ph = $select.find('option[value=""]').first();
            if (!$ph.length) {
                $select.prepend($('<option></option>').attr('value', '').text(placeholderText));
            } else {
                $ph.prop({ disabled: false, hidden: false }).text(placeholderText);
            }
        }

        function initNewTaskResourceSelectpicker($select, rowIdx) {

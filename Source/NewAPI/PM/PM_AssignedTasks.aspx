                // TagID for Task is 1038 (as per existing code pattern)
                var intTagID = 1038;
                
                // UniqueID is the TaskID for task documents
                var intUniqueID = taskID ? parseInt(taskID) : null;

               
                // Updated by Dipali V on 4th Jan 2025 - Purpose: Fixed parameter names to match stored procedure parameter names
                // Note: API backend should map these to SP parameters: FileName -> @strFileName, UserID -> @intUserID
                var urlParameter = {
                    CategoryID: parseInt(docCategoryID),              // @intCategoryID - Required
                    ProjectID: projectID ? parseInt(projectID) : null, // @intProjectID - Required
                    FileName: url.trim(),                             // @strFileName - URL value (required by SP, must not be NULL)
                    Description: description || '',                    // @strDescription

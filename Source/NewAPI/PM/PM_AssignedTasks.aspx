                    initialFilterState.fromDate = $('#taskFromDate').val() || null;
                    initialFilterState.toDate = $('#taskToDate').val() || null;
                    var checkedTaskType = $('input[name="taskType"]:checked').val();
                    initialFilterState.taskType = checkedTaskType && checkedTaskType !== 'assigned' ? checkedTaskType : null;
                }, 500);
            } else {
                // No project selected on page load — nothing to load, no loader needed
            }


        // Added by Dipali V on 22nd Jun 2026 for Task+ Resource saving
        function handleTeamsResourceValidationResponse(validationResult, parentTaskID, resourceData) {
            var result = validationResult && validationResult.list && validationResult.list[0]
                ? validationResult.list[0] : null;
            if (!result) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('Resource validation failed. Task saved — please add resource manually.');
                IsNewTask = 0;
                return;
            }

            var isValid = result.isValid === true || result.isValid === 1 || result.IsValid === true || result.IsValid === 1;
            if (isValid) {
                proceedNewTaskResourceSave(parentTaskID, resourceData);
                return;
            }

            var errorMsg = result.errorMessage || result.ErrorMessage || '<%= MyBase.GetResourceString("M_ValidationFailedPleaseCheckInput") %>';
            if (resourceData) {
                errorMsg = prefixNewTaskResourceValidationMessage(errorMsg, resourceData);
            }
            if (isSpSoftResourceConfirmationOnly(result.errorMessage || result.ErrorMessage || '')) {
                GconfirmationActionType = 'NEW_TASK_RESOURCE';
                $('#confirmDeleteResourceMessage').html(errorMsg.replace(/\r\n/g, '<br/>'));
                new bootstrap.Modal(document.getElementById('confirmDeleteResourceModal')).show();
                return;
            }

            alertify.set('notifier', 'position', 'top-right');
            alertify.error(errorMsg.replace(/\r\n/g, '<br/>'));
            IsNewTask = 0;
        }


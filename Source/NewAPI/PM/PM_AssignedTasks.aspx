        // Added By Vyankat B. on 18-Jun-2026 for custom field validation.

        function ValidateCustomFields(ProjectID) {
            

            // Collect Custom Field Values
            var FieldVal = collectCustomFieldValues();

            // Convert object to SP format
            var fieldValuesString = Object.keys(FieldVal)
                .map(function (key) {
                    return key + "|" + FieldVal[key];
                })
                .join("~");

            // API Validation
            var result = AJAXCallWithResult(
                'api/PM_AssignedTasks/ValidateCustomFields',
                JSON.stringify({
                    ProjectID: ProjectID,
                    FieldValues: fieldValuesString
                }),
                false
            );

            var validationMessage = "";
            var errorCount = 0;

            // Added By Vyankat B. on 22th June 2026 for the Clearing the Custom highlighted Validation
            $("#divCustomFields input, #divCustomFields select").css({ "border": "", "background-color": "" });
            // End of Added By Vyankat B. on 22th June 2026 for the Clearing the Custom highlighted Validation


            // ── Step 2: SP Validation errors (mandatory, numeric, date etc.) ─────
            if (result &&
                result.list &&
                result.list.length > 0 &&
                result.list[0].isValid === false &&
                result.list[0].validationErrors) {
            
                // Added By Vyankat B. on 22th June 2026 for the handling the Custom Validations

                var rawErrors = result.list[0].validationErrors;

                // Split on comma to get individual errors
                // Each error format from SP: "1. Message !!! | DatabaseFieldName"
                var spErrorParts = rawErrors.split(',');
                errorCount = spErrorParts.length;

                var cleanParts = [];
                for (var e = 0; e < spErrorParts.length; e++) {
                    var singleError = spErrorParts[e].trim();
                    var pipeIndex = singleError.lastIndexOf('|');

                    if (pipeIndex > -1) {
                        // Extract DB field name and highlight the input
                        var fieldDbName = singleError.substring(pipeIndex + 1).trim();
                        var $field = $("#txt" + fieldDbName)
                            .add("#dt" + fieldDbName)
                            .add("#cbo" + fieldDbName);

                        // Black border highlight
                        $field.css({ "border": "2px solid black", "background-color": "#fff5f5" });

                        // Remove highlight when user starts correcting
                        $field.off('input change').on('input change', function () {
                            $(this).css({ "border": "", "background-color": "" });
                        });

                        // Strip "| FieldName" from display message
                        cleanParts.push(singleError.substring(0, pipeIndex).trim());
                    } else {
                        cleanParts.push(singleError);
                    }
                }

                validationMessage = cleanParts.join(', ');
            }
            // ─────────────────────────────────────────────────────────────────────

            // ── Step 3: Special Character Validation ──────────────────────────────
            var fields = fieldValuesString.split('~');
            for (var i = 0; i < fields.length; i++) {
                var parts = fields[i].split('|');
                if (parts.length > 1) {
                    var fieldName = parts[0];
                    var fieldValue = parts[1];

                    // Use user-friendly caption if available
                    var displayName = (window.CustomFieldCaptionMap && window.CustomFieldCaptionMap[fieldName])
                        ? window.CustomFieldCaptionMap[fieldName]
                        : fieldName;

                    if (fieldValue && checkSpecialCharacter(fieldValue, WebConfigSpecialCharacters)) {
                        errorCount++;

                        // Black border highlight for special char field
                        var $spField = $("#txt" + fieldName)
                            .add("#dt" + fieldName)
                            .add("#cbo" + fieldName);
                        $spField.css({ "border": "2px solid black", "background-color": "#fff5f5" });
                        $spField.off('input change').on('input change', function () {
                            $(this).css({ "border": "", "background-color": "" });
                        });

                        validationMessage +=
                            (validationMessage !== "" ? ", " : "") +
                            errorCount +
                            ". " +
                            displayName +
                            " should not contain the following special characters: " +
                            WebConfigSpecialCharacters;
                    }
                }
            }
            // ─────────────────────────────────────────────────────────────────────

            // End of Added By Vyankat B. on 22th June 2026 for the handling the Custom Validations

            if (validationMessage !== "") {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error(
                    validationMessage.replaceAll(',', '<br/><br/>')
                );
                return false;
            }
            // ─────────────────────────────────────────────────────────────────────

            return true;
        }


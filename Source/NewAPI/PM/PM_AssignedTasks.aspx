        // ========== Global Modal Cleanup Handler - Fix for modal backdrop blocking page clicks ==========
        // Function to clean up modal backdrop and reset body styles
        function cleanupModalBackdrop() {
            // Remove all modal backdrops
            $('.modal-backdrop').remove();

            // Remove modal-open class from body
            $('body').removeClass('modal-open');

            // Reset body styles
            var bodyStyle = $('body').attr('style') || '';
            if (bodyStyle) {
                // Remove overflow and padding-right from inline styles
                bodyStyle = bodyStyle.replace(/overflow[^;]*;?/gi, '');
                bodyStyle = bodyStyle.replace(/padding-right[^;]*;?/gi, '');
                bodyStyle = bodyStyle.replace(/pointer-events[^;]*;?/gi, '');
                if (bodyStyle.trim() === '' || bodyStyle.trim() === ';') {
                    $('body').removeAttr('style');
                } else {
                    $('body').attr('style', bodyStyle);
                }
            }

            // Force reset via CSS
            $('body').css({
                'overflow': '',
                'padding-right': '',
                'pointer-events': ''
            });
        }

        function cleanupOffcanvasBackdrop() {
            // Check if any offcanvas is still open (checking both 'show' and 'showing' classes)
            var hasOpenOffcanvas = $('.offcanvas.show, .offcanvas.showing').length > 0;

            // If no offcanvas is open, clean up all backdrops
            if (!hasOpenOffcanvas) {
                // Remove all offcanvas backdrops aggressively - multiple methods
                $('.offcanvas-backdrop').remove();
                $('body > .offcanvas-backdrop').remove();
                $('.modal-backdrop.offcanvas-backdrop').remove();
                $('[class*="offcanvas-backdrop"]').remove();

                // Also try removing by data attribute
                $('[data-bs-backdrop]').each(function () {
                    if ($(this).hasClass('offcanvas-backdrop')) {
                        $(this).remove();
                    }
                });

                // Remove offcanvas-related classes from body
                $('body').removeClass('offcanvas-open');
                $('body').removeClass('nested-offcanvas-open');

                // Reset body styles - more aggressive
                var bodyStyle = $('body').attr('style') || '';
                if (bodyStyle) {
                    // Remove overflow and padding-right from inline styles
                    bodyStyle = bodyStyle.replace(/overflow[^;]*;?/gi, '');
                    bodyStyle = bodyStyle.replace(/padding-right[^;]*;?/gi, '');
                    bodyStyle = bodyStyle.replace(/pointer-events[^;]*;?/gi, '');
                    if (bodyStyle.trim() === '' || bodyStyle.trim() === ';') {
                        $('body').removeAttr('style');
                    } else {
                        $('body').attr('style', bodyStyle);
                    }
                }

                // Force reset via CSS - ensure everything is reset
                $('body').css({
                    'overflow': '',
                    'padding-right': '',
                    'pointer-events': 'auto'
                });

                // Ensure body and all elements are clickable
                $('body').css('pointer-events', 'auto');
                $('body *').css('pointer-events', '');

                // Force remove any remaining backdrop elements from DOM
                setTimeout(function () {
                    $('.offcanvas-backdrop').remove();
                    $('body').removeClass('offcanvas-open nested-offcanvas-open');
                    $('body').css('pointer-events', 'auto');
                }, 50);
            } else {
                // If offcanvas is still open, only remove extra backdrops (keep the correct one)
                var $openOffcanvases = $('.offcanvas.show, .offcanvas.showing');
                var expectedBackdropCount = $openOffcanvases.length;
                var $backdrops = $('.offcanvas-backdrop');

                // Remove excess backdrops
                if ($backdrops.length > expectedBackdropCount) {
                    $backdrops.slice(expectedBackdropCount).remove();
                }
            }
        }

 


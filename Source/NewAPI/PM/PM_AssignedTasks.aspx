                    // Added by DipalI v On 2nd sep 2026 - Purpose: store "No" (value 0) correctly in filter state
            var taskStatusVal = $('#sel_task_status').val();
            initialFilterState.taskStatus = (taskStatusVal !== null && taskStatusVal !== undefined && taskStatusVal !== '') ? taskStatusVal : null;

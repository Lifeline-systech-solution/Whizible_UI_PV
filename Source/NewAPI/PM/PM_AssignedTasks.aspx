                                    // End of Commented by Vyankat B. on 2 jun 2026 for keep stale child in cache when already exists

                                    // Added By Vyankat B. on 2 jun 2026 for updating child cache with latest API values
                                    GchildTasksMap[parentTaskIDInt][existingIndex] = childTask;

                                    // Keep flattened cache in sync as well

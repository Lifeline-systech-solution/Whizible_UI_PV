        // When offcanvas is opened, reset to Details view with all accordions collapsed
        // Added by Aditya J. on 17-03-2026 for scroll top issue
        // Tracks which accordion section was active when a sub-offcanvas (SubProject, UserStory, etc.) opens.
        // Used to restore the correct section when the main offcanvas is re-shown after a sub-offcanvas closes.
        // 'details' = default (Task Details). Set to 'taskAttributes' or 'agile' etc. before opening sub-offcanvas.
        // Added by Nikhil - Section tracker variable; prevents shown.bs.offcanvas from resetting to Task Details
        window._activeTaskDetailSection = 'details';

        $('#offcanvas_new_assigntask').on('shown.bs.offcanvas', function () {
            // ── Guard 1: Sub-offcanvas is currently opening ───────────────────────────
            // Bootstrap fires shown.bs.offcanvas on the main offcanvas even when a
            // sub-offcanvas (Phase, Milestone, SubProject, etc.) opens on top of it.
            // While the flag is true, do NOT touch any sections — user stays in Task Attributes.
            // Modified by Nikhil
            if (window.isOpeningAttributeOffcanvas === true) {
                return; // sub-offcanvas is taking over — leave the main offcanvas as-is
            }
            // ── Guard 2: Sub-offcanvas restore path ───────────────────────────────────
            // When Bootstrap closes+reopens the main offcanvas after a sub-offcanvas,
            // _isSubOffcanvasRestore is set true right before the programmatic re-show,
            // so we can skip the "collapse everything" initialisation and just restore
            // the section the user was already in.
            // Modified by Nikhil
            if (window._isSubOffcanvasRestore === true) {
                window._isSubOffcanvasRestore = false; // consume the flag immediately
                var sectionToRestore = window._activeTaskDetailSection || 'taskAttributes';
                switchTaskDetailTab(sectionToRestore);
                return; // nothing else to do — user stays where they were
            }
            // ── Genuine first-open path ───────────────────────────────────────────────
            applyTaskOffcanvasSectionStateOnOpen();
        });

        // Fix: Document/Baseline/Resource detail accordions not closing reliably.
        // Some clicks can cause Bootstrap to toggle more than once (or miss toggling) due to nested togglers.
        // This handler intercepts only these three header clicks and performs a single explicit toggle.
        (function () {
            var headerToContent = {
                'DivDocument': '#documentsContent',
                'DivBaseline': '#baselineContent',
                'DivResource': '#resourceDetailsContent',
                'DivAgileSection': '#agileContent'
            };
            var headerSelector = Object.keys(headerToContent).map(function (id) { return '#' + id; }).join(',');
            document.addEventListener('click', function (e) {
                var header = e.target && e.target.closest ? e.target.closest(headerSelector) : null;
                if (!header || !header.id || !headerToContent[header.id]) return;
                var contentEl = document.querySelector(headerToContent[header.id]);
                if (!contentEl) return;
                e.preventDefault();
                e.stopImmediatePropagation();
                // Single explicit toggle (using existing jQuery Bootstrap collapse behavior)
                $(contentEl).collapse('toggle');
            }, true);

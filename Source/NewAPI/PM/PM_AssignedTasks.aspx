        // End of Added by Vyankat B. on 22-Jun-2026 - Centralised page-level access control
        
        // Added by Auto - Toggle Save button visibility based on table data
        // Shows Save button only when there's data in the table (excluding empty state rows)
        function toggleTaskAttributeSaveButton(attributeType, hasData) {
            var buttonMapping = {
                'Deliverable': '#deli_save_btn',
                'Deliveriable': '#deli_save_btn',
                'Milestone': '#milestone_save_btn',
                'Module': '#module_save_btn',

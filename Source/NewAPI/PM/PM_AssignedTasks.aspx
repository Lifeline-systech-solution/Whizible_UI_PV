            });
        }
        //End of Added By Dipali V On 1st Jan 2026 For Resource Details Tab In Offcanvas
        //Added By Dipali V On 2nd Jan 2026 For Task Attribute In Offcanvas
        function loadTaskAttributes(ProjectID) {
            var requestParam = {
                ProjectID: ProjectID
            };

            try {
                var result = AJAXCallWithResult(
                    'api/PM_AssignedTasks/GetTaskAttribute',
                    JSON.stringify(requestParam),
                    false
                );

                // Extract attribute list from API response - handle multiple response structures
                var attributeList = null;
                if (result && result.list[0]) {
                    // Try different response structures
                    if (result.list[0].data.data.data && result.list[0].data.data.data) {
                        attributeList = result.list[0].data.data.data;
                    } else if (result.data && Array.isArray(result.data)) {
                        attributeList = result.list[0];
                    }
                } else if (result && Array.isArray(result)) {
                    attributeList = result.list[0].data.data.data;
                }

                if (attributeList && Array.isArray(attributeList)) {
                    bindTaskAttributes(attributeList);
                } else {
                    console.warn('No valid attribute list found in API response:', result);
                    bindTaskAttributes([]);
                }
            } catch (ex) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('Error loading task attributes');
                console.error('Error in loadTaskAttributes:', ex);
                bindTaskAttributes([]);
            }
        }
        var TaskAttributeDetails = [];
        function bindTaskAttributes(attributeList) {
            // Purpose: replace attributes on each load — do not accumulate across projects/saves
            TaskAttributeDetails = [];
            // Hide all attributes initially
           // ;
            $(".task-attr").hide();

            //Added by Aditya J. on 18-06-2026 for Agile tab refresh issue
            IsAgileShow = 0;
            //End of Added by Aditya J. on 18-06-2026 for Agile tab refresh issue

            if (!attributeList || !Array.isArray(attributeList) || attributeList.length === 0) {
                console.log('No task attributes to bind');
                $("#DivAgileSection").css('display', 'none');
                $("#agileContent").css('display', 'none');
                $("#menu_agile").css('display', 'none');
                return;
            }

            // Sort by ord (handle both case variations: ord/Ord)
            attributeList.sort(function(a, b) {
                var ordA = a.ord || a.Ord || 0;
                var ordB = b.ord || b.Ord || 0;
                return ordA - ordB;
            });

            $.each(attributeList, function (i, attr) {
               //;
                TaskAttributeDetails.push(attr);
                // Get attribute name (handle case variations: attributes/Attributes)
                var attrName = attr.attributes || attr.Attributes || '';
                if (!attrName) {
                    console.warn('Attribute name not found for attribute:', attr);
                    return;
                }
                if (attrName != "IsAgile") {
                    // Generate attribute key by removing spaces (e.g., "Sub Project" → "SubProject")
                    var attrKey = attrName.replace(/\s+/g, "");

                    // Get show and mandatory values (handle both boolean and numeric, case variations)
                    var showValue = attr.show !== undefined ? attr.show : (attr.Show !== undefined ? attr.Show : false);
                    var mandatoryValue = attr.mandatory !== undefined ? attr.mandatory : (attr.Mandatory !== undefined ? attr.Mandatory : false);

                    // Convert to boolean if numeric (1 = true, 0 = false)
                    var shouldShow = showValue === true || showValue === 1 || showValue === '1' || showValue === 'true';
                    var isMandatory = mandatoryValue === true || mandatoryValue === 1 || mandatoryValue === '1' || mandatoryValue === 'true';

                    // Find container - try different selector patterns
                    var $container = $("#attr_" + attrKey);
                    if (!$container.length) {
                        // Try finding by label text
                        $container = $("label:contains('" + attrName + "')").closest('.col-sm-4');
                    }
                    if (!$container.length) {
                        // Try finding parent div of input with matching id pattern
                        $container = $("#input_" + attrKey.toLowerCase()).closest('.col-sm-4');
                    }

                    if (!$container.length) {
                        console.warn('Container not found for attribute:', attrName, 'key:', attrKey);
                        return;
                    }

                    // Get input and label elements
                    var $input = $container.find("input, select");
                    if (!$input.length) {
                        $input = $("#input_" + attrKey.toLowerCase());
                    }

                    var $label = $container.find("label");
                    if (!$label.length) {
                        $label = $("#lbl_" + attrKey);
                    }
                    if (!$label.length) {
                        $label = $container.find("label.control-label");
                    }

                    // Apply show/hide based on show property
                    if (shouldShow) {
                        $container.show();
                        $container.addClass('task-attr'); // Add class for easier management

                        // Apply mandatory class and validation
                        if (isMandatory)
                        {
                            if ($label.length) {
                                $label.addClass("required");
                            }
                            if ($input.length) {
                                $input.prop("required", true)
                                    .attr("data-val", "true")
                                    .attr("data-val-required", attrName + " is required");
                            }
                        } else {
                            if ($label.length) {
                                $label.removeClass("required");
                            }
                            if ($input.length) {
                                $input.prop("required", false)
                                    .removeAttr("data-val")
                                    .removeAttr("data-val-required");
                            }
                        }
                    } else {
                        $container.hide();
                        if ($label.length) {
                            $label.removeClass("required");
                        }
                        if ($input.length) {
                            $input.prop("required", false)
                                .removeAttr("data-val")
                                .removeAttr("data-val-required");
                        }
                    }
                } else {
                    GattrName = attr.attributes
                    IsAgileShow = attr.show
                }
            });

            //commented and Added by Aditya J. on 18-06-2026 for Agile tab refresh issue
            //if (IsAgileShow == "1" || IsAgileShow==1) {
            //    $("#DivAgileSection").css('display','flex');
            //    $("#agileContent").css('display','inline-block');
            //    $("#menu_agile").css('display','inline-block');
            //} 

            if (IsAgileShow == "1" || IsAgileShow == 1) {
                $("#DivAgileSection").css('display', 'flex');
                // Added By Vyankat B. on 22 th June 2026 for the Agile Accordian 
                // Modified by [Dev] on 22-Jun-2026
                // Do NOT force inline-block here — that overrides Bootstrap collapse and forces the
                // section open every time. Instead, remove any leftover inline style so Bootstrap
                // collapse controls visibility via its own classes (collapsed by default).
                $("#agileContent").css('display', '');
                // End of Added By Vyankat B. on 22 th June 2026 for the Agile Accordian 

                $("#menu_agile").css('display', 'inline-block');
            } else {
                // Explicitly hide Agile elements when the selected project is non-Agile
                $("#DivAgileSection").css('display', 'none');
                $("#agileContent").css('display', 'none');
                $("#menu_agile").css('display', 'none');
            }
            //End of Added by Aditya J. on 18-06-2026 for Agile tab refresh issue
            if (shouldCollapseExtraSectionsOnOpen()) {
                collapseExtraTaskDetailSectionsForNewTask();
                expandResourceSectionOnOpen();
                if (IsNewTask === 1) setResourceSectionSaveButtonsVisible(false);
            }
        }

        // Added by Dipali V on 13th Jan 2026 - Helper function to get task work hours and total resource efforts
        function getTaskWorkHoursAndResourceEfforts(projectID, parentTaskID, currentTaskID, isUpdateMode) {
            var taskWorkHours = 0;
            var totalResourceEfforts = 0;
            
            try {
                // Get child tasks for the parent task to calculate total resource efforts
                var childTaskParameter = {
                    ProjectID: projectID,
                    ParentTaskID: parentTaskID,
                    EmployeeID: null
                };
                
                var result = AJAXCallWithResult('api/PM_AssignedTasks/GetChildTasksByParentTaskID', JSON.stringify(childTaskParameter), false);
                
                // Handle different response structures
                var childTasks = null;
                if (result && result.list && Array.isArray(result.list)) {
                    childTasks = result.list;
                } else if (result && result.data && result.data.data && Array.isArray(result.data.data)) {
                    childTasks = result.data.data;
                } else if (result && result.data && Array.isArray(result.data)) {
                    childTasks = result.data;
                } else if (result && Array.isArray(result)) {
                    childTasks = result;
                }
                
                if (childTasks && childTasks.length > 0) {
                    // Calculate sum of resource efforts (excluding current task if in edit mode)
                    for (var i = 0; i < childTasks.length; i++) {
                        var childTask = childTasks[i];
                        var childTaskID = childTask.TaskID || childTask.taskID;
                        
                        // Skip current task if in edit mode
                        if (isUpdateMode && currentTaskID && parseInt(childTaskID) === parseInt(currentTaskID)) {
                            continue;
                        }
                        
                        // Get work hours from child task - handle different formats
                        var work = childTask.Work || childTask.work || childTask.WorkHourMinute || childTask.workHourMinute || '0:00';
                        
                        // Convert work hours to decimal
                        if (typeof work === 'string' && work.indexOf(':') !== -1) {
                            var workParts = work.toString().split(':');
                            var hours = parseInt(workParts[0]) || 0;
                            var minutes = parseInt(workParts[1]) || 0;
                            var workDecimal = hours + (minutes / 60);
                            totalResourceEfforts += workDecimal;
                        } else if (typeof work === 'number') {
                            totalResourceEfforts += work;
                        }
                    }
                }
                
                // Get parent task work hours - try to find parent task in the child tasks result first
                var parentTaskFound = false;
                if (childTasks) {
                    for (var j = 0; j < childTasks.length; j++) {
                        var task = childTasks[j];
                        var taskID = task.TaskID || task.taskID;
                        if (parseInt(taskID) === parseInt(parentTaskID)) {
                            var work = task.Work || task.work || task.WorkHourMinute || task.workHourMinute || '0:00';
                            if (typeof work === 'string' && work.indexOf(':') !== -1) {
                                var workParts = work.toString().split(':');
                                var hours = parseInt(workParts[0]) || 0;
                                var minutes = parseInt(workParts[1]) || 0;
                                taskWorkHours = hours + (minutes / 60);
                            } else if (typeof work === 'number') {
                                taskWorkHours = work;
                            }
                            parentTaskFound = true;
                            break;
                        }
                    }
                }
                
                // If parent task not found in child tasks, try to get it from API
                //if (!parentTaskFound) {
                //    try {
                //        var parentTaskResult = AJAXCallWithResult('api/PM_AssignedTasks/GetTaskDetails', JSON.stringify(parentTaskID), false);
                //        if (parentTaskResult && (parentTaskResult.Work || parentTaskResult.work || parentTaskResult.WorkHourMinute || parentTaskResult.workHourMinute)) {
                //            var parentWork = parentTaskResult.Work || parentTaskResult.work || parentTaskResult.WorkHourMinute || parentTaskResult.workHourMinute || '0:00';
                //            if (typeof parentWork === 'string' && parentWork.indexOf(':') !== -1) {
                //                var parentWorkParts = parentWork.toString().split(':');
                //                var parentHours = parseInt(parentWorkParts[0]) || 0;
                //                var parentMinutes = parseInt(parentWorkParts[1]) || 0;
                //                taskWorkHours = parentHours + (parentMinutes / 60);
                //            } else if (typeof parentWork === 'number') {
                //                taskWorkHours = parentWork;
                //            }
                //        }
                //    } catch (e) {
                //        // API might not exist, skip getting parent task work hours
                //        console.log('GetTaskDetails API not available, skipping task work hours validation');
                //    }
                //}
            } catch (e) {
                console.error('Error getting task work hours and resource efforts:', e);
            }
            
            return {
                taskWorkHours: taskWorkHours,
                totalResourceEfforts: totalResourceEfforts
            };
        }
        
        // Added by Dipali V on 13th Jan 2026 - Show validation notifications one by one
        function showNextValidationNotification(isUpdateMode, childTaskID, parentTaskID, resourceID, effort, startDate, endDate, taskTypeID, subTaskTypeID) {
            // Filter out already confirmed notifications using normalized comparison
            GValidationNotifications = GValidationNotifications.filter(function(notif) {
                var msg = notif.ValidationMessage || notif.validationMessage || '';
                if (typeof msg !== 'string') {
                    return true; // Keep non-string messages for now
                }
                return !isValidationConfirmed(msg);
            });
            
            if (GValidationNotifications.length === 0) {
                // All notifications handled, proceed with save
                if (IsValid === 1) {
                    SaveResourceDBLevel(isUpdateMode, childTaskID, parentTaskID, resourceID, effort, startDate, endDate, taskTypeID, subTaskTypeID);
                }
                // Don't reset GConfirmedValidationMessages here - keep it for next validation cycle
                // Only reset GValidationNotifications
                GValidationNotifications = [];
                return;
            }
            
            var notification = GValidationNotifications[0];
            var notificationMsg = notification.ValidationMessage || notification.validationMessage || '';
            
            // Ensure notificationMsg is a string
            if (typeof notificationMsg !== 'string') {
                //console.error('showNextValidationNotification: notificationMsg must be a string, got:', typeof notificationMsg, notificationMsg);
                // Remove invalid notification and continue
                GValidationNotifications.shift();
                showNextValidationNotification(isUpdateMode, childTaskID, parentTaskID, resourceID, effort, startDate, endDate, taskTypeID, subTaskTypeID);
                return;
            }
            
            // Double check - if already confirmed, skip it
            if (isValidationConfirmed(notificationMsg)) {
                // Remove from queue and show next
                GValidationNotifications.shift();
                if (GValidationNotifications.length === 0) {
                    SaveResourceDBLevel(isUpdateMode, childTaskID, parentTaskID, resourceID, effort, startDate, endDate, taskTypeID, subTaskTypeID);
                } else {
                    showNextValidationNotification(isUpdateMode, childTaskID, parentTaskID, resourceID, effort, startDate, endDate, taskTypeID, subTaskTypeID);
                }
                return;
            }
            
            GconfirmationActionType = 'RESOURCEVALIDATION';
            showConfirmDeleteResourceModal(formatValidationAlertHtml(notificationMsg));
            pendingSaveCallback = function() {
                var notifKey = notification.ValidationKey || notification.validationKey || '';
                if (notifKey === 'TASK_DURATION_OUT') {
                    applyParentTaskDatesFromChildResources(startDate, endDate, isUpdateMode, childTaskID);
                }
                if (!isValidationConfirmed('TASK_DURATION_OUT') && notifKey === 'TASK_DURATION_OUT') {
                    GConfirmedValidationMessages.push('TASK_DURATION_OUT');
                }
                var normalizedMsg = (typeof notificationMsg === 'string') ? notificationMsg : '';
                if (normalizedMsg && !isValidationConfirmed(normalizedMsg)) {
                    GConfirmedValidationMessages.push(normalizedMsg);
                }
                // Remove from queue
                GValidationNotifications.shift();
                if (GValidationNotifications.length === 0) {
                    SaveResourceDBLevel(isUpdateMode, childTaskID, parentTaskID, resourceID, effort, startDate, endDate, taskTypeID, subTaskTypeID);
                    GValidationNotifications = [];
                } else {
                    showNextValidationNotification(isUpdateMode, childTaskID, parentTaskID, resourceID, effort, startDate, endDate, taskTypeID, subTaskTypeID);
                }
            };
        }

        function toUTCISOString(dateStr) {

            if (!dateStr) return null;

            // Handle yyyy-mm-dd format
            if (typeof dateStr === 'string' && dateStr.includes('-')) {
                const parts = dateStr.split('-');
                if (parts.length === 3) {
                    const year = parseInt(parts[0], 10);
                    const month = parseInt(parts[1], 10) - 1; // zero-based
                    const day = parseInt(parts[2], 10);

                    return new Date(Date.UTC(year, month, day)).toISOString();
                }
            }

            // Existing logic (DD MMM YYYY)
            const parts = dateStr.split(' ');
            const day = parts[0];
            const month = new Date(Date.parse(parts[1] + " 1, 2020")).getMonth();
            const year = parts[2];

            return new Date(Date.UTC(year, month, day)).toISOString();
        }


        // Added by Dipali V on 13th Jan 2026 - Save resource to database (called after validation passes)
        function SaveResourceDBLevel(isUpdateMode, childTaskID, parentTaskID, resourceID, effort, StartDate, EndDate, taskTypeID, subTaskTypeID) {
            //;
            var projectID = getCurrentProjectID();
            var insertRequest = {
                TaskID: isUpdateMode ? parseInt(childTaskID) : parseInt(parentTaskID),
                ProjectID: parseInt(projectID),
                EmployeeID: parseInt(resourceID),
                WorkHours: effort,
                //StartDate: StartDate,
                //StartDate: StartDate ? new Date(StartDate).toISOString() : null,
                //EndDate: EndDate,
                //EndDate: EndDate ? new Date(EndDate).toISOString() : null, 
                StartDate: StartDate ? toUTCISOString(StartDate) : null,
                EndDate: EndDate ? toUTCISOString(EndDate) : null,
                Mode: ResourceMode,
                TaskTypeID: taskTypeID ? parseInt(taskTypeID) : null,
                SubTaskTypeID: subTaskTypeID ? parseInt(subTaskTypeID) : null,
                UserName: '<%= Session("strUserName") %>'
            };

            var insertResult = AJAXCallWithResult('api/PM_AssignedTasks/AssignTaskResource', JSON.stringify(insertRequest), false);

            if (insertResult && insertResult.status === 'SUCCESS') {
                // Added by Dipali V on 22nd Jun 2026 for Task+ Resource saving - keep email flow (do not close before populateTaskAssignmentEmail)
                if (IsCopyTask != 1) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.success(isUpdateMode ? '<%= MyBase.GetResourceString("M_ResourceUpdatedSuccessfully") %>' : '<%= MyBase.GetResourceString("M_ResourceAddedSuccessfully") %>');
                }
                loadAssignedTasks();
                loadParentTaskChildResources(projectID, parentTaskID);
                if (ResourceMode != "UPDATE") {
                    var emailTaskID = isUpdateMode ? parseInt(childTaskID) : parseInt(parentTaskID);
                    var emailDelay = GAfterNewTaskResourceSave ? 100 : 0;
                    setTimeout(function () {
                        populateTaskAssignmentEmail(emailTaskID, 20, parseInt(resourceID));
                    }, emailDelay);
                }
                if (isUpdateMode) {
                    ResourceMode = 'UPDATE';
                } else {
                    cancelAddResource();
                }
            } else {
                var insertErrorMsg = insertResult && insertResult.message
                    ? insertResult.message
                    : (isUpdateMode ? '<%= MyBase.GetResourceString("M_ErrorUpdatingResource") %>' : '<%= MyBase.GetResourceString("M_ErrorAddingResource") %>');
                GAfterNewTaskResourceSave = null;
                alertify.set('notifier', 'position', 'top-right');
                alertify.error(insertErrorMsg);
            }
            IsNotificationCome = [];
            validationMessages = [];
            GConfirmedMessages = [];
        }


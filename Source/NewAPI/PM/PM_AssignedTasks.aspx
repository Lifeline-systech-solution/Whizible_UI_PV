    /* Page loader — same as PM_BulkResourceReq.aspx */
    /* Added by Nikhil - Unified GIF overlay loader matching PM_BulkResourceReq.aspx for UI consistency */
    .loader-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100%; background-color: transparent; z-index: 2000; }
    .loader-overlay .loader { position: absolute; top: 50%; left: 50%; width: 100px; height: 100px; margin: -50px 0 0 -50px; background: url(../../../Whizible2.0-new/dist/img/loading.gif) no-repeat center center; }

     /* Added By Vyankat B. on 18-Jun-2026 for Document List pagination hover effect */

    .BS_page_position{
        position: unset !important;
    }


    #documentLinkPrevious:hover,
    #documentLinkNext:hover {
        color: #ffffff !important;
        background-color: #1359a6 !important;
        border-color: #1359a6 !important;
    }

    #documentLinkPrevious.disabled:hover,
    #documentLinkNext.disabled:hover {
        color: #6c757d !important;
        background-color: transparent !important;
        border-color: #dee2e6 !important;
        cursor: not-allowed;
    }

    /* End of Added By Vyankat B. on 18-Jun-2026 for Document List pagination hover effect */

    /*Added by Aditya J. on 18-06-2026 for making the resources dropdown disable for child tasks*/
    .bootstrap-select.disabled .filter-option-inner-inner,
.bootstrap-select > .dropdown-toggle.disabled .filter-option-inner-inner {
    color: #6c757d !important; /* Bootstrap's secondary text color */
}
    /*End of Added by Aditya J. on 18-06-2026 for making the resources dropdown disable for child tasks*/

    /* Modified by Dipali V on 25th Jun 2026 - Purpose: scroll Add Resource dropdown when many options */
    #addResourceFormContainer .bootstrap-select .dropdown-menu.inner {
        max-height: 220px;
        overflow-y: auto;
    }

</style>



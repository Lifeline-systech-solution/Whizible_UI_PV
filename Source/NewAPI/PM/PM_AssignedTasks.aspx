                    var filterCollapse = bootstrap.Collapse.getInstance(document.getElementById('filterAccordionCollapse'));
                    if (filterCollapse && filterCollapse._isShown()) {
                        filterCollapse.hide();
                    }

                    // Show loading using the same page-level loader as data loads
                    // Modified by Nikhil - Replaced loadingOverlayTabs spinner with unified showLoader()/hideLoader()
                    showLoader();

                    // Load page in iframe
                    const iframe = $('#otherPagesFrame');
                    iframe.attr('src', pageSrc);

                    // Handle iframe load — hide loader once iframe has loaded
                    iframe.off('load').on('load', function () {
                        hideLoader();
                    });

                    // Safety timeout — always hide loader after 10 s even if load event doesn't fire
                    setTimeout(function () {
                        hideLoader();

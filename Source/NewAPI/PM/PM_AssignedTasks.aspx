        function toggleChildTasks(parentTaskID, taskID, arrowElement) {
            var $arrow = $(arrowElement);
            var $parentRow = $('tr.parent-task-row[data-parent-task-id="' + parentTaskID + '"]');
            // Find child rows that belong to this parent (until next parent row or end of table)
            var $childRows = $parentRow.nextUntil('tr.parent-task-row', 'tr.child-task-row[data-parent-task-id="' + parentTaskID + '"]');    
            // Check if child tasks are already loaded and visible
            var hasChildRows = $childRows.length > 0 && $childRows.is(':visible');
            
            if (hasChildRows) {
                // Collapse: Hide child tasks
                $childRows.slideUp(300, function() {
                    // Keep rows in DOM but hidden for performance (can remove if needed)
                });
                $arrow.css('transform', 'rotate(0deg)');
                $arrow.attr('data-expanded', 'false');
            } else {
                // Check if already loaded but hidden
                if ($childRows.length > 0) {
                    // Just show them - ensure grouping classes are applied
                    // Added by Dipali V on 26th Jan 2026 - Ensure grouping classes are maintained
                    $childRows.each(function(index) {
                        var $row = $(this);
                        if (index === 0 && !$row.hasClass('child-task-group-start')) {
                            $row.addClass('child-task-group-start');
                        }
                        if (index === $childRows.length - 1 && !$row.hasClass('child-task-group-end')) {
                            $row.addClass('child-task-group-end');
                        }
                    });
                    $childRows.slideDown(300);

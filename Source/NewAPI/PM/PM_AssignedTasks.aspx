        // Added by Dipali V on 12th Jan 2026 - Function to continue save process after resource validation
        function handleResourceValidationWithNotifications(validationRequest, callback) {
            // Add confirmed messages to request
            if (GConfirmedResourceValidationMessages && GConfirmedResourceValidationMessages.length > 0) {
                validationRequest.ConfirmedValidationMessages = GConfirmedResourceValidationMessages.join('|||');
            }
            
            var resourceValidationResult = AJAXCallWithResult(
                'api/PM_AssignedTasks/ValidateAssignTaskResource',
                JSON.stringify(validationRequest),
                false
            );
            
            if (!resourceValidationResult || !resourceValidationResult.list || !resourceValidationResult.list[0]) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('Resource validation failed. Please try again.');
                return;
            }
            
            var result = resourceValidationResult.list[0];
            
            // Parse notifications JSON array
            var notifications = [];
            if (result.notificationsJSON && result.notificationsJSON !== '[]') {
                try {
                    notifications = JSON.parse(result.notificationsJSON);
                } catch (e) {
                    console.error('Error parsing notifications JSON:', e);
                }
            }
            
            // If no notifications and validation passed, execute callback
            if (notifications.length === 0 && result.isValid) {
                if (callback) callback();
                return;
            }
            
            // Store all notifications
            GResourceValidationNotifications = notifications;
            
            // Show first unconfirmed notification
            if (notifications.length > 0) {
                var firstNotification = notifications[0];
                GconfirmationActionType = 'RESOURCEVALIDATION';
                $('#confirmDeleteResourceMessage').text(firstNotification.replace(/\r\n/g, '<br/>'));
                //pendingSaveCallback = function () { SaveResource(); };
                new bootstrap.Modal(document.getElementById('confirmDeleteResourceModal')).show();
            } else if (!result.isValid && result.errorMessage) {
                // Non-continuable error
                alertify.set('notifier', 'position', 'top-right');
                alertify.error(result.errorMessage.replace(/\r\n/g, '<br/>'));
            }
        }

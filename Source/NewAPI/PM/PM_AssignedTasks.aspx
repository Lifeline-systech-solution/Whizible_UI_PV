                'ChangeRequest': '#changerequest_save_btn',
                'Feature': '#feature_save_btn',
                'EstimationType': '#estimationtype_save_btn',
                'UserStory': '#userstory_save_btn',
                'Phase': '#phase_save_btn'
            };
            
            var buttonId = buttonMapping[attributeType];

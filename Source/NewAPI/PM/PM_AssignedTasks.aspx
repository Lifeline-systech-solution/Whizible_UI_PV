        function loadTaskBaseline(taskID, tableSelector = '#showbaselinetbl', taskNameSelector = '#baselineTaskName', pageNumber) {
            if (!taskID) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_TaskIDRequired") %>');
                return;
            }
            var isOffcanvas = (tableSelector === '#showbaselinetbl_offcanvas');
            if (isOffcanvas) {
                if (pageNumber !== undefined) {
                    baselineCurrentPageNumber_offcanvas = pageNumber;
                } else {
                    baselineCurrentPageNumber_offcanvas = 1;
                }
            }

            var TaskName = $("#input_task_name").val();

            // Show loading state
            var tbody = $(tableSelector + ' tbody');
            tbody.html('<tr><td colspan="7" class="text-center py-4"><i class="fas fa-spinner fa-spin"></i> Loading...</td></tr>');

            // Prepare API call parameters (add pagination for offcanvas)
            var baselineParameter = {
                TaskID: parseInt(taskID)
            };
            if (isOffcanvas) {
                baselineParameter.PageNumber = baselineCurrentPageNumber_offcanvas;
                baselineParameter.PageSize = baselinePageSize_offcanvas;
            }

            try {
                var result = AJAXCallWithResult('api/PM_AssignedTasks/ShowTaskBaseLine', JSON.stringify(baselineParameter), false);

                if (result) {
                    // Parse baseline data from multiple response shapes
                    var baselineData = null;
                    if (result.raw && Array.isArray(result.raw.data)) {
                        baselineData = result.raw.data;
                    } else if (Array.isArray(result.list)) {
                        baselineData = result.list;
                    } else if (result.Data && Array.isArray(result.Data.data)) {
                        baselineData = result.Data.data;
                    } else if (Array.isArray(result.data)) {
                        baselineData = result.data;
                    }

                    // Parse pagination for offcanvas
                    var pagination = null;
                    if (result.raw && result.raw.pagiEntity && Array.isArray(result.raw.pagiEntity) && result.raw.pagiEntity.length > 0) {
                        pagination = result.raw.pagiEntity[0];
                    } else if (result.Data && result.Data.PaginationEntity) {
                        var pe = result.Data.PaginationEntity;
                        pagination = Array.isArray(pe) && pe.length > 0 ? pe[0] : pe;
                    } else if (result.PaginationEntity) {
                        var pe = result.PaginationEntity;
                        pagination = Array.isArray(pe) && pe.length > 0 ? pe[0] : pe;
                    }

                    if (isOffcanvas && pagination) {
                        baselineTotalRecords_offcanvas = pagination.TotalRecords || pagination.totalRecords || 0;
                        baselineTotalPages_offcanvas = Math.max(1, Math.ceil((pagination.TotalPages || pagination.totalPages) || 1));
                        baselinePageSize_offcanvas = pagination.PageSize || pagination.pageSize || 5;
                        baselineCurrentPageNumber_offcanvas = pagination.CurrentPage || pagination.currentPage || 1;
                    }

                    if (baselineData && baselineData.length > 0) {
                        $(taskNameSelector).text(TaskName);
                        populateTaskBaselineTable(baselineData, tableSelector, taskNameSelector);
                        if (isOffcanvas) {
                            $('#baselinePaginationContainer_offcanvas').css({ display: 'flex' }).show();
                            updateBaselineTotalRecordsOffcanvas();
                            updateBaselinePaginationButtonsOffcanvas();
                        }
                    } else {
                        tbody.html('<tr><td colspan="7" class="text-center py-2" style="width: 100%;"><div class="empty-state"><p class="mb-0"><%= MyBase.GetResourceString("M_NoBaselineHistoryFound") %></p></div></td></tr>');
                        $(taskNameSelector).text(TaskName);
                        if (isOffcanvas) {
                            baselineTotalRecords_offcanvas = 0;
                            baselineTotalPages_offcanvas = 1;
                            $('#baselinePaginationContainer_offcanvas').show();
                            updateBaselineTotalRecordsOffcanvas();
                            updateBaselinePaginationButtonsOffcanvas();
                        }
                    }
                } else {
                    tbody.html('<tr><td colspan="7" class="text-center py-2" style="width: 100%;"><div class="empty-state"><p class="mb-0"><%= MyBase.GetResourceString("M_ErrorLoadingBaselineData") %></p></div></td></tr>');
                    $(taskNameSelector).text(TaskName);
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('<%= MyBase.GetResourceString("M_ErrorLoadingBaselineData") %>');
                    if (isOffcanvas) {
                        $('#baselinePaginationContainer_offcanvas').hide();
                    }
                }
            } catch (error) {
                tbody.html('<tr><td colspan="7" class="text-center py-2" style="width: 100%;"><div class="empty-state"><p class="mb-0"><%= MyBase.GetResourceString("M_ErrorLoadingBaselineData") %></p></div></td></tr>');
                $(taskNameSelector).text('-');
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_ErrorLoadingBaselineDataWithMessage") %>' + error.message);
                if (isOffcanvas) {
                    $('#baselinePaginationContainer_offcanvas').hide();
                }
            }
        }


        // Purpose: Perform the actual void task operation - Added by Dipali V on 06th Jan 2026
        function performVoidTasks() {
            if (!pendingVoidTaskList || !pendingVoidProjectID) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_InvalidVoidTaskParameters") %>');
                return;
            }

            try {
                var voidTaskParameter = {
                    TaskList: pendingVoidTaskList,
                    ProjectID: parseInt(pendingVoidProjectID)
                };
                
                var result = AJAXCallWithResult('api/PM_AssignedTasks/VoidTask', JSON.stringify(voidTaskParameter), false);

                if (result && result.status === 'SUCCESS') {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.success('<%= MyBase.GetResourceString("M_TasksVoidedSuccessfully") %>');

                    // Reload assigned tasks to reflect changes
                    loadAssignedTasks(true, false);

                    // Clear all checkboxes
                    $('.row-checkbox').prop('checked', false);
                    $('#selectAllCheckbox').prop('checked', false);
                } else {
                    var errorMsg = result && result.message 
                        ? result.message 
                        : '<%= MyBase.GetResourceString("M_ErrorVoidingTasks") %>';
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error(errorMsg);
                }
            } catch (error) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_ErrorVoidingTasks") %>: ' + error.message);
            } finally {
                // Clear pending void data
                pendingVoidTaskList = null;
                pendingVoidProjectID = null;
            }
        }


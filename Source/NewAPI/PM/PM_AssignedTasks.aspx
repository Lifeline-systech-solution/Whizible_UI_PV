        function populateTaskStatusDropdown(statusList) {
            var $dropdown = $('#sel_task_status');

            if (!$dropdown.length) return;

            // Added by DipalI v On 3rd sep 2026 - Purpose: preserve applied Is Task Completed (incl. "No"=0) before rebuild when Search Section reopens
            //var previousStatusVal = $dropdown.val();
            var previousStatusVal = $dropdown.val();
            if (previousStatusVal === null || previousStatusVal === undefined || previousStatusVal === '') {
                previousStatusVal = initialFilterState.taskStatus;
            }

            // Clear existing options
            $dropdown.empty();

            // 🔹 Always add proper placeholder FIRST
            $dropdown.append(
                $('<option></option>')
                    .val('')
                    .text('Select Is Task Completed')
            );

            if (statusList && Array.isArray(statusList) && statusList.length > 0) {
                statusList.forEach(function (status) {

                    var statusID =
                        status.ID !== undefined ? status.ID :
                            status.id !== undefined ? status.id : null;

                    var statusName = status.Status || status.status || '';

                    // Skip invalid & API placeholder items
                    if (
                        statusID === null ||
                        statusName === '' ||
                        statusName === 'Select Option'
                    ) {
                        return;
                    }

                    // Append real options
                    $dropdown.append(
                        $('<option></option>')
                            .val(statusID)
                            .text(escapeHtml(statusName))
                    );
                });
            }

            // Added by DipalI v On 3rd sep 2026 - Purpose: restore selected Is Task Completed after dropdown rebuild (keep chip and dropdown in sync)
            if (previousStatusVal !== null && previousStatusVal !== undefined && previousStatusVal !== '') {
                if ($dropdown.find('option[value="' + previousStatusVal + '"]').length > 0) {
                    $dropdown.val(previousStatusVal);
                }
            }

            // Refresh bootstrap-select
            if ($dropdown.hasClass('selectpicker')) {
                $dropdown.selectpicker('refresh');
            }
        }


        // Function to clear task status dropdown
        function clearTaskStatusDropdown() {
            var $dropdown = $('#sel_task_status');
            if ($dropdown.length > 0) {
                // Clear all existing options (API will provide "Select Option" when reloaded)
                $dropdown.empty();
                
                // Refresh selectpicker if it exists
                if (typeof $.fn.selectpicker !== 'undefined' && $dropdown.hasClass('selectpicker')) {
                    $dropdown.selectpicker('refresh');
                }
            }
        }


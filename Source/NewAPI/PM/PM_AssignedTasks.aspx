        // Get task status for filtering (delayed/ontime/in-progress/yet-to-start)
        // Added by Dipali V on 1st Jan 2026 - Extracted status calculation for filtering
        function getTaskStatusForFilter(task) {
            var today = new Date(); today.setHours(0, 0, 0, 0);
            var startDateObj = parseDate(getTaskProp(task, 'StartDate', ''));
            var endDateObj = parseDate(getTaskProp(task, 'EndDate', ''));
            var baselineEndObj = parseDate(getTaskProp(task, 'BaselineEnd', ''));
            var actualStartObj = parseDate(getTaskProp(task, 'ActualStartDate', ''));
            var actualEndObj = parseDate(getTaskProp(task, 'ActualEndDate', ''));
            var isTaskComplete = getTaskProp(task, 'IsTaskComplete', false);

            if (isTaskComplete) return (baselineEndObj && endDateObj && endDateObj > baselineEndObj) ? 'delayed' : 'ontime';
            if (!startDateObj || startDateObj > today) return 'yet-to-start';
            if ((baselineEndObj && endDateObj && endDateObj > baselineEndObj) || (endDateObj && today > endDateObj && !actualEndObj)) return 'delayed';
            if (actualStartObj || (startDateObj && startDateObj <= today)) return 'in-progress';
            return 'ontime';
        }


            var statusMap = { 'green': 'task-row-status-ontime', 'red': 'task-row-status-delayed', 'orange': 'task-row-status-in-progress', 'blue': 'task-row-status-yet-to-start' };
            return statusMap[colorName.toLowerCase()] || '';
        }

        // Format work value to HH:MM format (handles numeric and string values)
        function formatWorkValue(workValue) {
            if (workValue === null || workValue === undefined || workValue === '-' || workValue === '') return '-';
            if (typeof workValue === 'string' && workValue.includes(':')) return workValue;
            var numValue = parseFloat(workValue);
            if (!isNaN(numValue)) {
                var hours = Math.floor(numValue);
                var minutes = Math.round((numValue - hours) * 60);
                if (minutes >= 60) { hours += 1; minutes = 0; }
                return hours.toString().padStart(2, '0') + ':' + minutes.toString().padStart(2, '0');
            }
            return workValue;
        }

        // Get task property with case-insensitive fallback (handles both camelCase and PascalCase)
        function getTaskProp(task, propName, defaultValue) {
            var lowerProp = propName.charAt(0).toLowerCase() + propName.slice(1);
            var upperProp = propName.charAt(0).toUpperCase() + propName.slice(1);
            return task[upperProp] !== undefined ? task[upperProp] : (task[lowerProp] !== undefined ? task[lowerProp] : defaultValue);
        }


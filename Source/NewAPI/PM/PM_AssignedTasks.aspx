        // Added By Dipali V On 2nd Feb 2026 For W26 - Fixed date format conversion to handle datepicker format 'dd M yy' (e.g., "01 Feb 2025")
        function toIsoDate(dateStr) {
            if (!dateStr || dateStr.trim() === '') return null;
            
            // Remove any leading "undefined-undefined-" if present (cleanup)
            dateStr = dateStr.replace(/^undefined-undefined-/, '').trim();
            
            // Check if date is already in ISO format (YYYY-MM-DD)
            if (/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) {
                return dateStr;
            }
            
            // Handle datepicker format: "dd M yy" or "dd M yyyy" (e.g., "01 Feb 2025")
            var dateMatch = dateStr.match(/^(\d{1,2})\s+([A-Za-z]{3})\s+(\d{2,4})$/);
            if (dateMatch) {
                var day = dateMatch[1].padStart(2, '0');
                var monthName = dateMatch[2];
                var year = dateMatch[3];
                
                // Convert 2-digit year to 4-digit (assume 2000-2099)
                if (year.length === 2) {
                    year = '20' + year;
                }
                
                // Convert month name to number
                var monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                var monthIndex = -1;
                for (var i = 0; i < monthNames.length; i++) {
                    if (monthNames[i].toLowerCase() === monthName.toLowerCase()) {
                        monthIndex = i;
                        break;
                    }
                }
                if (monthIndex === -1) return null;
                var month = String(monthIndex + 1).padStart(2, '0');
                
                return year + '-' + month + '-' + day;
            }
            
            // Handle DD/MM/YYYY format (fallback)
            var parts = dateStr.split('/');
            if (parts.length === 3) {
                return parts[2] + '-' + parts[1].padStart(2, '0') + '-' + parts[0].padStart(2, '0');
            }
            
            // Try to parse as Date object and format
            try {
                var date = new Date(dateStr);
                if (!isNaN(date.getTime())) {
                    var year = date.getFullYear();
                    var month = String(date.getMonth() + 1).padStart(2, '0');
                    var day = String(date.getDate()).padStart(2, '0');
                    return year + '-' + month + '-' + day;
                }
            } catch(e) {}
            
            return null;
        }


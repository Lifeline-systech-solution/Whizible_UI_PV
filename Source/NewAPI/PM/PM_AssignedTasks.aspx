        function getNewTaskSelectValue($select) {
            if (!$select || !$select.length) return '';
            var $el = $select.first();
            var placeholderText = getResourceSelectPlaceholderText();
            var val = '';

            if ($.fn.selectpicker && $el.data('selectpicker')) {
                try {
                    var spVal = $el.selectpicker('val');
                    if (Array.isArray(spVal)) spVal = spVal.length ? spVal[0] : '';
                    val = (spVal === null || spVal === undefined) ? '' : String(spVal).trim();
                } catch (e) { val = ''; }
            }
            if (!val) {
                var rawVal = $el.val();
                if (Array.isArray(rawVal)) rawVal = rawVal.length ? rawVal[0] : '';
                val = (rawVal === null || rawVal === undefined) ? '' : String(rawVal).trim();
            }
            if (!val) {
                $el.find('option:selected').each(function () {
                    var ov = String($(this).attr('value') || '').trim();
                    if (ov && ov !== '0') {
                        val = ov;
                        return false;
                    }
                });
            }
            // Purpose: bootstrap-select UI may show selection before native select value syncs
            if (!val && $el.data('selectpicker')) {
                var btnText = ($el.parent().find('.dropdown-toggle .filter-option-inner-inner').first().text() || '').trim();
                if (btnText && btnText !== placeholderText) {
                    $el.find('option').each(function () {
                        if ($(this).text().trim() === btnText) {
                            var ov = String($(this).attr('value') || '').trim();
                            if (ov && ov !== '0') {
                                val = ov;
                                return false;
                            }
                        }
                    });
                }
            }
            if (!val || val === '0') return '';
            // Purpose: ignore stale native value when UI still shows placeholder (fixes Add link visibility)
            if ($el.data('selectpicker')) {
                var displayText = ($el.parent().find('.dropdown-toggle .filter-option-inner-inner').first().text() || '').trim();
                if (!displayText || displayText === placeholderText || isResourcePlaceholderOption(val, displayText)) return '';
            }
            return val;
        }


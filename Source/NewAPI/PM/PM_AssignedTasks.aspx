                } else if (pageSrc) {
                    // Modified by Nikhil - Clear all filter inputs and chips when leaving Assigned Tasks tab
                    $('#sel_resource').val('').selectpicker('refresh');
                    $('#sel_task_status option:first').prop('selected', true);
                    $('#sel_task_status').selectpicker('refresh');
                    $('#showAllTasks').prop('checked', true);

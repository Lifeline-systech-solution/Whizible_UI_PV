        // Added by Dipali V on 4th Jan 2025 - Purpose: Comprehensive upload document function with all validations (ref: PM_Documents.aspx uploadDocument)
        function uploadDocument() {
            try {
                // Get file from file input
                var file = $("#fileInput").data("selected-file");
                
                if (!file) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error("<%= MyBase.GetResourceString("M_PleaseSelectFileToUpload") %>");
                    return;
                }

                // Get configuration values for file validation
                var FileExtensionDisallow = '<%= System.Configuration.ConfigurationManager.AppSettings("FileExtensionDisallow")%>';
                var MaxFileSize = '<%= System.Configuration.ConfigurationManager.AppSettings("MaxFileSize")%>';

                // Validate max file size
                if (file.size > parseInt(MaxFileSize)) {
                alertify.set('notifier', 'position', 'top-right');
                    alertify.error('<%= MyBase.GetResourceString("M_FileSizeExceedsMaximum") %>' + MaxFileSize + '<%= MyBase.GetResourceString("M_Bytes") %>');
                    return;
                }

                // Validate file extension using config
                var strFileExtension = FileExtensionDisallow || '';
                var validateExtensions = [];
                var allowSubmit = false;
                
                if (strFileExtension && strFileExtension.length > 0) {
                    validateExtensions = strFileExtension.split(",");
                    
                    var fileValue = file.name;
                    var extension = fileValue.slice(fileValue.lastIndexOf('.') + 1).toLowerCase();
                    
                    for (var cnt = 0; cnt < validateExtensions.length; cnt++) {
                        var strExtn = validateExtensions[cnt].trim().toLowerCase();
                        if (strExtn === extension) {
                            allowSubmit = true;
                            break;
                        }
                    }
                    
                    if (allowSubmit === false) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.error('<%= MyBase.GetResourceString("M_InvalidFileExtension") %>' + validateExtensions.join(", ").toUpperCase());
                        return;
                    }
                }
                
                // Validate multiple dots (same as PM_Documents.aspx)
                var countOfDot = 0;
                if (file.name != '') {
                    countOfDot = file.name.split(".").length - 1;
                }
                
                if (countOfDot > 1) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('<%= MyBase.GetResourceString("M_FileNameCannotContainMultipleDots") %>');
                    return;
                }
                
                // Validate filename length (same as PM_Documents.aspx)
                var FileNameCharCount = 0;
                if (file.name != '') {
                    FileNameCharCount = file.name.split(".")[0].length;
                }
                
                if (FileNameCharCount > 120) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('<%= MyBase.GetResourceString("M_FileNameTooLong") %>');
                    return;
                }

                // Get Document Category and Sub Category
                var categoryID = $("#docCategory").val();
                if (!categoryID || categoryID === '0' || categoryID === 0) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error("<%= MyBase.GetResourceString("M_PleaseSelectDocumentCategory") %>");
                    return;
                }

                var subcateID = $("#docSubCategory").val();
                if (!subcateID || subcateID === '0') {
                    subcateID = null;
                }

                var commentValue = $("#DescTextArea").val() || '';

                // Get ProjectID and TaskID
                var currentProjectID = getCurrentProjectID();
                var taskID = $('#hidden_task_id_offcanvas').val();
                if (!taskID || taskID === '' || taskID === 'null') {
                    taskID = currentTaskIDForBaselineOffcanvas;
                }

                // Validate parameters before API call
                if (!currentProjectID || currentProjectID === 0 || currentProjectID === '0') {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error("<%= MyBase.GetResourceString("M_ProjectIDMissing") %>");
                    return;
                }
                
                if (!categoryID || categoryID === 0 || categoryID === '0') {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error("<%= MyBase.GetResourceString("M_DocumentCategoryMissing") %>");
                    return;
                }
                
                // Check if directory structure exists - the API will create it if it doesn't exist
                var dirName = {
                    ProjectID: parseInt(currentProjectID),
                    CategoryID: parseInt(categoryID),
                    SubCategoryID: (subcateID && subcateID !== null && subcateID !== '0') ? parseInt(subcateID) : null
                };

                var param = JSON.stringify(dirName);
                var apiResult = null;

                // Updated by Dipali V on 4th Jan 2025 - Purpose: Use PM_AssignedTasks endpoint instead of DocumentUpload
                // Added By Dipali V On 23rd Jan 2026 For W26 - Match PM_Documents.aspx response handling (working implementation)
                var url = "/api/PM_AssignedTasks/CheckIfDirectoryStructureExists";
                var result = AJAXCallWithResult(url, param, false);
                apiResult = result; // Use result directly like PM_Documents.aspx
                var strDirectoryName = '';
                var documentCode = '';
                
                // Handle API response - check for errors first (match PM_Documents.aspx)
                if (!apiResult) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('<%= MyBase.GetResourceString("M_NoResponseFromServer") %>');
                    return;
                }
                
                if (apiResult) {
                    if (apiResult.error && !apiResult.success) {
                        var errorMsg = apiResult.message || apiResult.Message || apiResult.error || "Directory structure check failed.";
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.error('<%= MyBase.GetResourceString("M_Error") %>' + errorMsg);
                        return;
                    }
                    
                    // Check if API call failed at top level
                    if (apiResult.status === 'FAILURE' || apiResult.Status === 'FAILURE') {
                        var errorMsg = (apiResult.data && apiResult.data.Message) || (apiResult.data && apiResult.data.message) || apiResult.message || "Directory structure not found.";
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.error('<%= MyBase.GetResourceString("M_Error") %>' + errorMsg);
                        return;
                    }
                    
                    // Get the data from response - handle normalized response structure (Added By Dipali V On 23rd Jan 2026 For W26)
                    var responseData = null;
                    // Check normalized list first (normalizeApiResponse converts single objects to array)
                    if (apiResult.list && apiResult.list.length > 0) {
                        responseData = apiResult.list[0];
                    } else if (apiResult.raw && apiResult.raw.data) {
                        // Check normalized response raw data
                        if (apiResult.raw.data.data) {
                            responseData = apiResult.raw.data.data;
                        } else {
                            responseData = apiResult.raw.data;
                        }
                    } else if (apiResult.data) {
                        if (apiResult.data.data) {
                            responseData = apiResult.data.data;
                        } else {
                            responseData = apiResult.data;
                        }
                    } else {
                        responseData = apiResult;
                    }
                    
                    // Extract directory path and document code - match PM_Documents.aspx (working implementation)
                    if (responseData) {
                        strDirectoryName = responseData.DirectoryPath || responseData.directoryPath || responseData.DirectoryName || responseData.directoryName || '';
                        documentCode = responseData.DocumentCode || responseData.documentCode || '';
                    }
                    
                    // Also check at root level if not found in responseData
                    if ((!strDirectoryName || (strDirectoryName && strDirectoryName.trim() === '')) && apiResult) {
                        strDirectoryName = apiResult.DirectoryPath || apiResult.directoryPath || apiResult.DirectoryName || apiResult.directoryName || '';
                        documentCode = apiResult.DocumentCode || apiResult.documentCode || documentCode || '';
                    }
                }
                 
                if (!strDirectoryName || (strDirectoryName && strDirectoryName.trim() === '')) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('<%= MyBase.GetResourceString("M_DirectoryStructureCouldNotBeCreated") %>');
                    return;
                }

                var today = new Date();
                var createdDate = today.toISOString();
                var lastModifiedDate = createdDate; 

                var fileSizeKB = (file.size / 1024).toFixed(2);
                
                // Extract file extension and name safely
                var lastDotIndex = file.name.lastIndexOf('.');
                var extension = '';
                var originalFileName = file.name;
                
                if (lastDotIndex !== -1 && lastDotIndex < file.name.length - 1) {
                    extension = file.name.substring(lastDotIndex + 1).toLowerCase();
                    originalFileName = file.name.substring(0, lastDotIndex);
                } else {
                    extension = '';
                    originalFileName = file.name;
                }
                
                // Strip version suffix if present
                var versionSuffixMatch = originalFileName.match(/^(.+?)_v(\d+)$/);
                if (versionSuffixMatch && versionSuffixMatch.length > 1) {
                    originalFileName = versionSuffixMatch[1]; 
                }
                
                // Also strip any double versioning patterns
                while (originalFileName.match(/^(.+?)_v(\d+)$/)) {
                    var match = originalFileName.match(/^(.+?)_v(\d+)$/);
                    if (match && match.length > 1) {
                        var newName = match[1];
                        if (newName === originalFileName) break;
                        originalFileName = newName;
                    } else {
                        break;
                    }
                }

                var calculatedVersionNumber = 1;
                var calculatedVersionedFileName = originalFileName;
              
                //calculatedVersionedFileName = originalFileName + '_v' + '.' + extension;
                calculatedVersionedFileName = originalFileName + '_v' + calculatedVersionNumber + '.' + extension;
                // Prepare parameters for UploadDocument API
                var docUplParams = {
                    ProjectID: parseInt(currentProjectID),
                    CategoryID: parseInt(categoryID),
                    DirectoryName: (strDirectoryName && strDirectoryName.trim() !== '') ? strDirectoryName : null,
                    UploadedFileName: originalFileName,
                    CreatedDate: createdDate,
                    LastModifiedDate: lastModifiedDate,
                    Description: commentValue || '',
                    fileSize: parseFloat(fileSizeKB),
                    Extension: extension,
                    FileName: originalFileName,
                    LogInID: parseInt(EmployeeId) || null,
                    LoginType: LoginType || null,
                    ChangeRID: null,
                    SubCategoryID: (subcateID && subcateID !== null && subcateID !== '0') ? parseInt(subcateID) : null,
                    TagID: 1038, // TagID for Task
                    UniqueID: taskID ? parseInt(taskID) : parseInt(currentProjectID),
                    CodeTemplate: documentCode || null
                };

                var param = JSON.stringify(docUplParams);
                var uploadApiResult = null;
                // Updated by Dipali V on 4th Jan 2025 - Purpose: Use PM_AssignedTasks endpoint instead of DocumentUpload
                var url = "/api/PM_AssignedTasks/UploadDocument";
                var result = AJAXCallWithResult(url, param, false);
                uploadApiResult = result;
                var newDocumentID = null;
                
                if (!uploadApiResult) {
                    alertify.error('<%= MyBase.GetResourceString("M_UploadFailed") %>' + '<%= MyBase.GetResourceString("M_NoResponseFromServer") %>');
                        return;
                    }
                    
                if (uploadApiResult.Status === 'FAILURE' || uploadApiResult.status === 'FAILURE') {
                    var errMsg = uploadApiResult.data?.message || uploadApiResult.message || "Error uploading document.";
                    alertify.error('<%= MyBase.GetResourceString("M_UploadFailed") %>' + errMsg);
                    return;
                }

                // ✅ SUCCESS CASE
                var newDocumentID = null;

                if (uploadApiResult.list[0].data.AssignTaskUploadDocumentResponseModel[0].intID > 0) {

                    newDocumentID = uploadApiResult.list[0].data.AssignTaskUploadDocumentResponseModel[0].intID;
                }

                if (newDocumentID) {
                    alertify.success('<%= MyBase.GetResourceString("M_DocumentUploadedSuccessfully") %>');
                    console.log("New Document ID:", newDocumentID);
                } else {
                    alertify.error('<%= MyBase.GetResourceString("M_UploadSucceededButDocumentIDNotReturned") %>');
                }

                
                // Added By Dipali V On 23rd Jan 2026 For W26 - Use new saveFileToServerTask function (saves to Documents/Tasks folder)
                if (saveFileToServerTask(file, strDirectoryName, calculatedVersionedFileName)) {
                    loadPlotDocuments(currentProjectID, taskID);
                    $("#clearForm").click();
                }
            } catch (ex) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_ErrorOccurredWhileUploadingFile") %>' + ex.message);
            }
        }

        function downloadDocument(docID, ProjID, fileName, extension) {
            //;
            var params = {
                ProjectID: parseInt(ProjID),
                DocumentID: parseInt(docID),
                WhatToDelete: "I"
            };

            var result = AJAXCallWithResult(
                "/api/PM_AssignedTasks/DownloadDocument",
                JSON.stringify(params),
                false
            );

            // Handle both PascalCase (API response) and camelCase
            result = result.list[0]
            var filePath = result.filePathSegments || result.FilePathSegments;
            var fileName = result.fileName || result.FileName;

            if (result && filePath && fileName) {
                var fileUrl = buildUrl("/api/PM_AssignedTasks/DownloadFile/" + filePath);
                var tempLink = document.createElement("a");
                tempLink.href = fileUrl;
                tempLink.download = fileName;
                tempLink.style.display = "none";
                document.body.appendChild(tempLink);
                tempLink.click();
                document.body.removeChild(tempLink);
            }
            else {
                alertify.error(result?.message || result?.Message || "Download failed");
            }
        }

        // Added By Dipali V On 23rd Jan 2026 For W26 - New function to save file to server (ref: PM_Documents.aspx)
        // Saves files to D:\2025\W26_API_Publish\wwwroot\Documents\Tasks\[DirectoryName]
        function saveFileToServerTask(file, directoryName, fileName) {
            if (!file || !directoryName || !fileName) {
                alertify.error('<%= MyBase.GetResourceString("M_InvalidFileParameters") %>');
                return false;
            }
            
            // Prepend "Tasks" to directory path
            var fullDirectoryPath = "Tasks" + (directoryName ? "\\" + directoryName : "");
            
            var formData = new FormData();
            formData.append("File", file);
            formData.append("DirectoryName", fullDirectoryPath);
            formData.append("FileName", fileName);
            
            // Use $.ajax for FormData (AJAXCallWithResult doesn't support FormData properly)
            var result = null;
            var success = false;
            
            // Build full URL - use same pattern as UploadDocument and CheckIfDirectoryStructureExists (with leading slash)
            var endpointPath = "/api/PM_AssignedTasks/SaveFileToServer";
            var fullUrl = buildUrl(endpointPath);
           // console.log('[saveFileToServerTask] Endpoint Path:', endpointPath);
            //console.log('[saveFileToServerTask] Full URL:', fullUrl);
            //console.log('[saveFileToServerTask] Base URL (strUrl):', strUrl);
            
            $.ajax({
                url: fullUrl,
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                async: false, // Synchronous like AJAXCallWithResult
                beforeSend: function (xhr) {
                    var token = sessionStorage.getItem('access_token_W26API');
                    if (token) {
                        xhr.setRequestHeader('Authorization', 'Bearer ' + token);
                    }
                    // Note: Params header not needed for [FromForm] requests (ValidateHeadersAttribute skips validation)
                },
                success: function (response) {
                    result = response;
                    // Handle normalized API response
                    result = normalizeApiResponse(result);
                    
                    if (result && (result.status === 'SUCCESS' || result.Status === 'SUCCESS')) {
                        //var responseData = responseData.list[0]
                        var saveResponse = result.list[0]
                        if (saveResponse && (saveResponse.Success === true || saveResponse.success === true)) {
                            success = true;
                            alertify.success("File '" + file.name + "' uploaded successfully!");
                        }
                    } else if (result && (result.list[0].success === true || result.list[0].Success === true)) {
                        success = true;
                        alertify.success("File '" + file.name + "' uploaded successfully!");
                    } else {
                        // Check if response indicates success in other formats
                        var responseData = responseData.list[0]
                        if (responseData && (responseData.Success === true || responseData.success === true)) {
                            success = true;
                            alertify.success("File '" + file.name + "' uploaded successfully!");
                        }
                    }
                },
                error: function (xhr, status, error) {
                    console.error('[saveFileToServerTask] Error - Status:', xhr.status, 'StatusText:', xhr.statusText);
                    console.error('[saveFileToServerTask] Full URL was:', fullUrl);
                    console.error('[saveFileToServerTask] Response:', xhr.responseText);
                    
                    var errorMsg = '';
                    if (xhr.status === 404) {
                        errorMsg = "Endpoint not found (404). URL: " + fullUrl + " | Status: " + xhr.statusText;
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    } else if (xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message) {
                        errorMsg = xhr.responseJSON.data.message;
                    } else if (xhr.responseText) {
                        try {
                            var parsedError = JSON.parse(xhr.responseText);
                            errorMsg = parsedError.message || parsedError.data?.message || parsedError;
                        } catch (e) {
                            // Show first 300 chars to avoid truncation
                            errorMsg = xhr.responseText.length > 300 ? xhr.responseText.substring(0, 300) + "..." : xhr.responseText;
                        }
                    } else {
                        errorMsg = (error || "File save failed") + " (Status: " + xhr.status + ")";
                    }
                    alertify.error('<%= MyBase.GetResourceString("M_FailedToUploadFile") %>' + file.name + "': " + errorMsg);
                }
            });
            
            if (success) {
                return true;
            }
            
            if (result) {
                var errorMsg = (result?.data?.data?.Message || result?.data?.Message || result?.message || "File save failed");
                alertify.error('<%= MyBase.GetResourceString("M_FailedToUploadFile") %>' + file.name + "': " + errorMsg);
            }
            return false;
        }

        // Helper function to upload file with FormData (ref: PM_Documents.aspx uploadFileWithFormData)
        // Added by Dipali V on 4th Jan 2025 - Purpose: Handle file upload to server with progress tracking
        // Fixed by AI Assistant - Added authentication headers for [Authorize] and ValidateHeadersAttribute
        function uploadFileWithFormData(apiUrl, formData, fileIndex, totalFiles, originalFileName, documentID, versionedFileName) {
            // Added By Dipali V On 23rd Jan 2026 For W26 - Debug logging for client-side
            console.log('[uploadFileWithFormData] Starting upload');
            console.log('[uploadFileWithFormData] API URL:', apiUrl);
            console.log('[uploadFileWithFormData] File Name:', originalFileName);
            console.log('[uploadFileWithFormData] FormData keys:', Array.from(formData.keys()));
            
            $.ajax({
                url: apiUrl,
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                async: true,
                beforeSend: function (xhr) {
                    // Added By Dipali V On 23rd Jan 2026 For W26 - Debug logging
                    console.log('[uploadFileWithFormData] beforeSend - Setting headers');
                    
                    // Attach Bearer token for [Authorize] attribute
                    var token = sessionStorage.getItem('access_token_W26API');
                    if (token) {
                       xhr.setRequestHeader('Authorization', 'Bearer ' + token);
                       console.log('[uploadFileWithFormData] Authorization header set');
                    } else {
                       console.warn('[uploadFileWithFormData] No token found in sessionStorage');
                    }
                    // Attach Params header for ValidateHeadersAttribute
                    var params = '<%= Session("Params") %>';
                    if (params) {
                        xhr.setRequestHeader('Params', params);
                        console.log('[uploadFileWithFormData] Params header set');
                    } else {
                        console.warn('[uploadFileWithFormData] No Params found in session');
                    }
                },
                success: function (response) {
                    // Added By Dipali V On 23rd Jan 2026 For W26 - Debug logging
                    console.log('[uploadFileWithFormData] Success response:', response);
                    
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.success("File '" + originalFileName + "' uploaded successfully!");
                    
                    // Reload documents list
                    var projectID = getCurrentProjectID();
                    var taskID = $('#hidden_task_id_offcanvas').val();
                    if (!taskID || taskID === '' || taskID === 'null') {
                        taskID = currentTaskIDForBaselineOffcanvas;
                    }
                    if (projectID && taskID) {
                        loadPlotDocuments(projectID, taskID);
                    }
                    
                    // Clear form after successful upload
                    $("#clearForm").click();
                },
                error: function (xhr, status, error) {
                    // Added By Dipali V On 23rd Jan 2026 For W26 - Enhanced error logging
                    console.error('[uploadFileWithFormData] Error occurred');
                    console.error('[uploadFileWithFormData] Status:', status);
                    console.error('[uploadFileWithFormData] Error:', error);
                    console.error('[uploadFileWithFormData] Status Code:', xhr.status);
                    console.error('[uploadFileWithFormData] Response Text:', xhr.responseText);
                    console.error('[uploadFileWithFormData] Response JSON:', xhr.responseJSON);
                    
                    alertify.set('notifier', 'position', 'top-right');
                    var errorMessage = '';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    } else if (xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message) {
                        errorMessage = xhr.responseJSON.data.message;
                    } else if (xhr.responseText) {
                        try {
                            var parsedError = JSON.parse(xhr.responseText);
                            errorMessage = parsedError.message || parsedError.data?.message || parsedError;
                        } catch (e) {
                            errorMessage = xhr.responseText;
                        }
                    } else {
                        errorMessage = error || '<%= MyBase.GetResourceString("M_UnknownError") %>';
                    }
                    alertify.error('<%= MyBase.GetResourceString("M_FailedToUploadFile") %>' + originalFileName + "': " + errorMessage);
                }
            });
        }


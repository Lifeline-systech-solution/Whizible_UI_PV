        // End of Added By Vyankat B. on 18-Jun-2026 for Document List pagination.

        // Function to load plot documents - follows PM_BackupPlans.aspx pattern exactly
        function loadPlotDocuments(projectID, taskID) {

            // Added By Vyankat B. on 18-Jun-2026 for Document List pagination.
            if (projectID != null && projectID != undefined) {
                currentDocProjectID = projectID;
            }

            if (taskID != null && taskID != undefined) {
                currentDocTaskID = taskID;
            }
            // End of Added By Vyankat B. on 18-Jun-2026 for Document List pagination.

            // Get ProjectID if not provided
            var selectedProjectID = projectID || getCurrentProjectID();

            if (!selectedProjectID) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('Project ID is required to load documents.');
                populateDocumentTable([]);
                return;
            }

            // Prepare API request parameters following PlotDocumentListRequest model
            var documentParameter = {
                ProjectID: parseInt(selectedProjectID),

                // End of Added By Vyankat B. on 18-Jun-2026 for Document List pagination.
                /*   TaskID: taskID ? parseInt(taskID) : null,*/
                TaskID: currentDocTaskID ? parseInt(currentDocTaskID) : null,
                // End of Added By Vyankat B. on 18-Jun-2026 for Document List pagination.

                RoleId: RoleId ? parseInt(RoleId) : null,
                // Added By Vyankat B. on 18-Jun-2026 for Document List pagination.
                PageNumber: documentPageNumber,
                PageSize: documentPageSize
                // End of Added By Vyankat B. on 18-Jun-2026 for Document List pagination.
            };

            try {
                var result = AJAXCallWithResult('api/PM_AssignedTasks/PlotDocumentList', JSON.stringify(documentParameter), false);

                if (result) {
                    // Handle response structure - Refactored by Dipali V on 06th Jan 2026
                    // API response format: { message: "Document List", data: Array }
                    // Or: { data: { message: "Document List", data: Array } }
                    var documentList = null;
                    
                    // Try multiple response structures
                    if (result.data && Array.isArray(result.data)) {
                        // Direct array in data property
                        documentList = result.data;
                    } else if (result.data && result.data.data && Array.isArray(result.data.data)) {
                        // Nested data structure
                        documentList = result.data.data;
                    } else if (result.list && Array.isArray(result.list)) {
                        // Fallback to list property
                    documentList = result.list;
                    } else if (Array.isArray(result)) {
                        // Result is directly an array
                        documentList = result;
                    } else {
                        // Default to empty array if structure not recognized
                        console.warn('PlotDocumentList: Unexpected response structure', result);
                        documentList = [];
                    }
                    
                    // Populate table with returned data
                    populateDocumentTable(documentList);


                    // Added By Vyankat B. on 18-Jun-2026 for Document List pagination.

                    var totalRecords = 0;
                    var totalPages = 0;

                    if (result.raw &&
                        result.raw.paginationEntities &&
                        result.raw.paginationEntities.length > 0) {

                        totalRecords = result.raw.paginationEntities[0].totalRecords;
                        totalPages = result.raw.paginationEntities[0].totalPages;
                    }

                    $('#documentTotalRecords').text(totalRecords);

                    if (totalRecords > 0) {
                        $('#documentPaginationControls').show();
                    }
                    else {
                        $('#documentPaginationControls').hide();
                    }

                    // Previous Button
                    if (documentPageNumber <= 1) {
                        $('#documentLinkPrevious').addClass('disabled');
                    }
                    else {
                        $('#documentLinkPrevious').removeClass('disabled');
                        $('#documentLinkPrevious').css('color', '#1359a6'); // enabled color


                    }

                    // Next Button
                    if (documentPageNumber >= totalPages) {
                        $('#documentLinkNext').addClass('disabled');
                    }
                    else {
                        $('#documentLinkNext').removeClass('disabled');
                        $('#documentLinkNext').css('color', '#1359a6'); // enabled color

                    }

                    // End of Added By Vyankat B. on 18-Jun-2026 for Document List pagination.


                } else {
                    // Handle case where result is null or undefined (AJAX error)
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('Error loading document list');
                    populateDocumentTable([]);
                }
            } catch (error) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('Error loading document list: ' + error.message);
                console.error('PlotDocumentList error:', error);
                populateDocumentTable([]);
            }
        }

        // Function to populate the document table with data
        // Refactored by Dipali V on 06th Jan 2026 - Fixed data binding, isURL handling, and directoryName support
        var IsURL = 0;
        function populateDocumentTable(documentList) {
            console.log('populateDocumentTable called with:', documentList);
            console.log('Document list length:', documentList ? documentList.length : 0);
            console.log('GisParentTask' + GisParentTask);
            
            // Populate both tables (main modal and offcanvas) - Refactored by Dipali V on 06th Jan 2026
            var tables = ['#AddModalTbl', '#AddModalTbl_offcanvas'];
            
            tables.forEach(function(tableSelector) {
                var $tbody = $(tableSelector + ' tbody.addtbody');
                
                if ($tbody.length === 0) {
                    console.warn('Document table body not found:', tableSelector);
                    return; // Skip this table if tbody not found
                }
                
                console.log('Populating table:', tableSelector, 'tbody found:', $tbody.length);
                
                // Destroy any existing DataTable before populating
                if (typeof $.fn.dataTable !== 'undefined' && $.fn.dataTable.isDataTable(tableSelector)) {
                    try {
                        $(tableSelector).DataTable().destroy();
                    } catch (e) {
                        console.log('Error destroying DataTable:', e);
                    }
                }
                
                // Clear table
                $tbody.empty();
                
                // No data case
                if (!Array.isArray(documentList) || documentList.length === 0) {
                    $tbody.append(
                        '<tr>' +
                        '<td colspan="7" class="text-center">No documents available</td>' +
                        '</tr>'
                    );
                    return;
                }
                
                // File size formatting helper - Refactored by Dipali V on 06th Jan 2026
                function formatSize(bytes, isURL) {
                    // If isURL is true, return "NA" instead of file size
                    if (isURL === true || isURL === 'true' || isURL === 1) {
                        return 'NA';
                    }
                    if (!bytes) return '-';
                    bytes = parseFloat(bytes);
                    if (isNaN(bytes)) return '-';
                    if (bytes < 1024) return bytes + ' B';
                    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(2) + ' KB';
                    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
                }
                
                // Bind rows - Refactored by Dipali V on 06th Jan 2026
                $.each(documentList, function (index, doc) {
                    // Extract properties with fallback for different property name cases
                    var documentID = doc.DocumentID || doc.documentID || doc.DocumentId || doc.documentId || '';
                    var fileName = doc.FileName || doc.fileName || doc.File || doc.file || '-';
                    var directoryName = doc.DirectoryName || doc.directoryName || doc.Directory || doc.directory || '';
                    var isURL = doc.IsURL || doc.isURL || doc.IsUrl || doc.isUrl || false;
                    var category = doc.Category || doc.category || doc.DocumentCategory || doc.documentCategory || '-';
                    var subCategory = doc.SubCategory || doc.subCategory || doc.DocumentSubCategory || doc.documentSubCategory || '-';
                    var description = doc.Description || doc.description || doc.Desc || doc.desc || '-';
                    var fileSize = doc.FileSize || doc.fileSize || doc.Size || doc.size || '';
                    var uploadedDate = doc.UploadedDate || doc.uploadedDate || doc.UploadDate || doc.uploadDate || '';
                    
                    // Determine download link and display name - Refactored by Dipali V on 06th Jan 2026
                    // If isURL is false, use directoryName for download; otherwise use fileName
                    var downloadLink = '';
                    var displayName = fileName;
                    
                    if (isURL === true || isURL === 'true' || isURL === 1) {
                        // URL document - use fileName as link
                        downloadLink = fileName;
                        displayName = fileName;
                        IsURL = 1;
                    } else {
                        // File document - use directoryName for download if available
                        downloadLink = directoryName || fileName;
                        displayName = fileName;
                        IsURL = 0;
                    }
                    
                    // Create row HTML
                    var rowHtml =
                        '<tr>' +
                        '<td>' + escapeHtml(category) + '</td>' +
                        '<td>' + escapeHtml(subCategory) + '</td>' +
                        '<td>' +
                        (
                            downloadLink && downloadLink !== '-'
                                ? (
                                    (isURL === true || isURL === 'true' || isURL === 1)
                                        // URL → direct href
                                        ? '<a href="' + escapeHtml(downloadLink) + '" target="_blank" class="upload_style">' +
                                        escapeHtml(displayName) +
                                        '</a>'
                                        // File → downloadDocument()
                                        : '<a href="javascript:void(0);" class="upload_style" ' +
                                        'onclick="downloadDocument(' +
                                        '\'' + documentID + '\',' +
                                        '\'' + (doc.ProjectID || doc.projectID) + '\',' +
                                        '\'' + (fileName || '').replace(/'/g, "\\'") + '\',' +
                                        '\'' + (doc.Extension || doc.extension || '').replace(/'/g, "\\'") + '\'' +
                                        ')">' +
                                        escapeHtml(displayName) +
                                        '</a>'
                                )
                                : '<label class="upload_style">' + escapeHtml(displayName) + '</label>'
                        ) +
                        '</td>'+
                        // Added By Dipali V On 23rd Jan 2026 For W26 - Add tooltip for long description text
                        '<td>' + 
                        (description && description.length > 50 
                            ? '<span data-bs-toggle="tooltip" data-bs-placement="top" title="' + escapeHtml(description) + '" style="cursor: help;">' + escapeHtml(description.substring(0, 50)) + '...</span>'
                            : escapeHtml(description)
                        ) + 
                        '</td>' +
                        '<td>' + formatSize(fileSize, isURL) + '</td>' +
                        '<td>' + formatDateForDisplay(uploadedDate) + '</td>' +
                        '<td class="text-center">' +
                        // Added By Dipali V On 2nd Feb 2026 For W26 - Enable delete icon only for parent tasks (GisParentTask === true), disable for child tasks
                        // Modified by Vyankat B. on 22-Jun-2026 - Also check DeleteAccess: hide delete icon entirely when user has no delete permission
                        (GisParentTask === true && DeleteAccess
                            ? '<a href="javascript:;" class="btn-icon text-danger delete-document-btn" data-bs-toggle="tooltip" title="<%= MyBase.GetResourceString("C_Delete") %>" data-document-id="' + documentID + '">' +
                            '<i class="fas fa-trash-alt"></i><span style="display:none" id="Documemt_' + documentID + '">' + isURL  +'</span>' +
                            '</a>'
                            : (!DeleteAccess
                                ? '' /* No delete access - hide icon completely */
                                : '<a href="javascript:;" class="btn-icon text-danger delete-document-btn disabled" data-bs-toggle="tooltip" title="<%= MyBase.GetResourceString("C_Delete") %>" data-document-id="' + documentID + '" style="opacity: 0.5; cursor: not-allowed; pointer-events: none;">' +
                                '<i class="fas fa-trash-alt"></i><span style="display:none" id="Documemt_' + documentID + '">' + isURL  +'</span>' +
                                '</a>'
                            )
                        ) +
                        // End of Modified by Vyankat B. on 22-Jun-2026 - DeleteAccess check for document delete icon
                        '</td>' +
                        '</tr>';
                    
                    $tbody.append(rowHtml);
                });
                
                // Initialize tooltips for delete buttons
                $tbody.find('[data-bs-toggle="tooltip"]').tooltip();
                
                console.log('Table populated:', tableSelector, 'Rows added:', $tbody.find('tr').length);
            });
            
            console.log('populateDocumentTable completed');
        }

        // Delete document functionality - Refactored by Dipali V on 06th Jan 2026 to use confirmation modal
        function deleteDocument(documentID) {
            if (!documentID || documentID === '' || documentID === '0') {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_ErrorDeletingDocument") %>');
                return;
            }

            // Store the delete callback function - Added by Dipali V on 06th Jan 2026
            pendingDeleteDocumentCallback = function() {
                performDeleteDocument(documentID);
            };
            
            // Update modal message for document deletion - Added by Dipali V on 06th Jan 2026
            $('#confirmDeleteResourceMessage').text('<%= MyBase.GetResourceString("M_ConfirmDeleteDocument") %>');
            
            // Show confirmation modal - Added by Dipali V on 06th Jan 2026
            var confirmModalElement = document.getElementById('confirmDeleteResourceModal');
            var confirmModal = new bootstrap.Modal(confirmModalElement);
            confirmModal.show();
            
            // Force modal to be visible - Fix for modal not displaying issue (06th Jan 2026)
            setTimeout(function() {
                var $modal = $('#confirmDeleteResourceModal');
                // Ensure modal has show class
                if (!$modal.hasClass('show')) {
                    $modal.addClass('show');
                }
                // Remove aria-hidden attribute
                $modal.removeAttr('aria-hidden').attr('aria-modal', 'true');
                
                // Force visibility with inline styles - override any CSS that might hide it
                $modal.css({
                    'display': 'block',
                    'z-index': '1055',
                    'opacity': '1',
                    'visibility': 'visible',
                    'pointer-events': 'auto'
                });
                
                // Ensure modal-dialog is visible and positioned correctly
                var $dialog = $modal.find('.modal-dialog');
                $dialog.css({
                    'z-index': '1056',
                    'opacity': '1',
                    'visibility': 'visible',
                    'transform': 'translate(0, 0)',
                    'margin': '1.75rem auto'
                });
                
                // Ensure modal-content is visible
                $modal.find('.modal-content').css({
                    'opacity': '1',
                    'visibility': 'visible'
                });
            }, 200);
        }
        
        // Purpose: Perform the actual document delete operation - Added by Dipali V on 06th Jan 2026
        function performDeleteDocument(documentID) {
            //;
            try {
                // Call delete API endpoint
                var result = AJAXCallWithResult('api/PM_AssignedTasks/DelAssignDoc', JSON.stringify({
                    DocumentIDs: documentID.toString()
                }), false);

                if (result && result.status === "SUCCESS") {
                    // Show success message
                    alertify.set('notifier', 'position', 'top-right');
                    if (GIsURL == "true" || GIsURL == 1) {
                        alertify.success('URL Deleted Successfully');
                    }
                    else {
                        alertify.success('<%= MyBase.GetResourceString("M_DocumentDeletedSuccessfully") %>');
                    }
                    

                    // Destroy DataTable before reloading to ensure clean refresh (both tables)
                    if (typeof $.fn.dataTable !== 'undefined') {
                        // Destroy main modal table
                            if ($.fn.dataTable.isDataTable('#AddModalTbl')) {
                            try {
                                $('#AddModalTbl').DataTable().destroy();
                            } catch (e) {
                                console.log('DataTable already destroyed or not initialized');
                            }
                        }
                        // Destroy offcanvas table
                        if ($.fn.dataTable.isDataTable('#AddModalTbl_offcanvas')) {
                            try {
                                $('#AddModalTbl_offcanvas').DataTable().destroy();
                            } catch (e) {
                                console.log('Offcanvas DataTable already destroyed or not initialized');
                            }
                        }
                    }

                    // Reload documents for the current task
                    var taskID = $('#hidden_task_id_offcanvas').val();
                    var currentProjectID = getCurrentProjectID();
                    if (currentProjectID && taskID && taskID !== '' && taskID !== 'null' && taskID !== '0') {
                        // Use setTimeout to ensure DataTable is fully destroyed before reloading
                        setTimeout(function() {
                            loadPlotDocuments(currentProjectID, parseInt(taskID));
                        }, 150);
                    } else {
                        // If taskID is not available, just clear the table (both tables)
                        var isOffcanvasVisible = $('#offcanvas_documents').hasClass('show') || $('#offcanvas_documents').is(':visible');
                        var tableSelector = isOffcanvasVisible ? '#AddModalTbl_offcanvas' : '#AddModalTbl';
                        var tbody = $(tableSelector + ' tbody.addtbody');
                        
                        if (tbody.length === 0) {
                            tableSelector = '#AddModalTbl';
                            tbody = $('#AddModalTbl tbody.addtbody');
                        }
                        
                        tbody.empty();
                        if (typeof $.fn.dataTable !== 'undefined' && $.fn.dataTable.isDataTable(tableSelector)) {
                            try {
                                $(tableSelector).DataTable().destroy();
                            } catch (e) {
                                console.log('DataTable already destroyed');
                            }
                        }
                        tbody.html('<tr><td colspan="7" class="text-center py-2" style="width: 100%;"><div class="empty-state"><p class="mb-0">No documents available</p></div></td></tr>');
                        
                        // Reinitialize DataTable for empty state
                        if (typeof $.fn.dataTable !== 'undefined') {
                            setTimeout(function () {
                                if ($.fn.dataTable.isDataTable(tableSelector)) {
                                    $(tableSelector).DataTable().destroy();
                                }
                                $(tableSelector).DataTable({
                                scrollY: true,
                                scrollX: true,
                                scroller: true,
                                pageLength: 5,
                                paging: true,
                                lengthChange: false,
                                bFilter: false,
                                ordering: false,
                                responsive: true,
                                destroy: true,
                                retrieve: false,
                                scrollCollapse: true
                            });
                        }, 100);
                        }
                    }
                } else {
                    var errorMessage = result && result.message ? result.message : '<%= MyBase.GetResourceString("M_ErrorDeletingDocument") %>';
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error(errorMessage);
                }
            } catch (error) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_ErrorDeletingDocument") %>: ' + error.message);
                console.error('Error deleting document:', error);
            }
        }


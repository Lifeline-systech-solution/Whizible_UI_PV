        // Added by Dipali V on 12th Jan 2026 - Filter void tasks by Employee Name and Task Name
        function filterVoidTasks() {
            var employeeFilter = $('#filter_void_employee_name').val().toLowerCase().trim();
            var taskFilter = $('#filter_void_task_name').val().toLowerCase().trim();
            var filtered = GvoidTaskList.filter(function(task) {
                var userName = (task.UserName || task.userName || '').toLowerCase();
                var taskName = (task.TaskName || task.taskName || task.ParentTaskName || task.parentTaskName || '').toLowerCase();
                return (!employeeFilter || userName.indexOf(employeeFilter) !== -1) && 
                       (!taskFilter || taskName.indexOf(taskFilter) !== -1);
            });
            populateVoidTasksTable(filtered);
        }

        // Function to populate void tasks table
        function populateVoidTasksTable(voidTaskList) {
            var $table = $('#showvoidmodalTbl');
            var tbody = $table.find('tbody');

            // Destroy DataTable if exists
            if ($table.length > 0 && $.fn.DataTable.isDataTable('#showvoidmodalTbl')) {
                try {
                    $table.DataTable().destroy();
                } catch (e) {
                    // Ignore errors during destroy
                }

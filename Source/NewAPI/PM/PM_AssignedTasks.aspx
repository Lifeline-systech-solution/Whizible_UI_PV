        // Helper function to extract deliverable properties - removes redundancy
        function extractDeliverableProperties(deliverable) {
            var scheduleID = deliverable.ScheduleID || deliverable.scheduleID || '';
            var title = deliverable.Title || deliverable.title || '';
            var labelSchedule = deliverable.LabelSchedule || deliverable.labelSchedule || '';
            var displayName = title || labelSchedule || 'N/A';
            var WorkHHMM = deliverable.workHHMM || 'N/A';
            
            return {
                scheduleID: scheduleID,
                title: title,
                labelSchedule: labelSchedule,
                startDate: deliverable.StartDate || deliverable.startDate || '',
                endDate: deliverable.EndDate || deliverable.endDate || '',
                work: deliverable.Work || deliverable.work || '',
                displayName: displayName,
                WorkHHMM: WorkHHMM
            };
        }

        // Helper function to format date - shared by all modules
        function formatDate(dateString) {
            if (!dateString) return '';
            try {
                return new Date(dateString).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            } catch (e) {
                return dateString;
            }
        }

        // Function to populate deliverables dropdowns with DeliverableResponseModel data
        function populateDeliverablesDropdowns(deliverableList) {
            if (!deliverableList || !Array.isArray(deliverableList) || deliverableList.length === 0) {

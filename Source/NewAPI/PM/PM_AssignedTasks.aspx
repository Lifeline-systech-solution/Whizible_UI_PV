        function isMultiResourceAddFormMode() {
            return IsNewTask === 1 ||
                (GisParentTask === true && IsCopyTask !== 1 && ResourceMode === 'INSERT' && $('#addResourceFormContainer').is(':visible'));
        }

        function getNewTaskResourceRowKey(empID, effort, startDate, endDate) {
            var e = String(effort || '').trim();
            var parts = e.split(':');
            var h = parseInt(parts[0], 10) || 0;
            var m = parseInt(parts[1], 10) || 0;
            var effortKey = (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
            return [empID, String(startDate || '').trim(), String(endDate || '').trim(), effortKey].join('|');
        }

        function getExistingParentTaskResourceRowKeys() {
            var keys = {};
            $('#parentTaskResourceTable tbody tr[data-employeeid]').each(function () {
                var id = parseInt($(this).data('employeeid'), 10);
                if (!id) return;
                var sd = $(this).find('.resource-start-date').text().trim();
                var ed = $(this).find('.resource-end-date').text().trim();
                var wh = $(this).find('.resource-work').text().trim();
                keys[getNewTaskResourceRowKey(id, wh, sd, ed)] = true;
            });
            return keys;
        }

        function getMultiResourceCapacity() {
            var limit = getAssignTaskResourceCountLimit();
            var formRows = getNewTaskResourceRowCount();
            if (IsNewTask === 1) return { total: formRows, max: limit };
            var existing = $('#parentTaskResourceTable tbody tr[data-employeeid]').length;
            return { total: existing + formRows, max: limit };
        }

        function collectNewTaskResourcesFromRows() {
            if (!isMultiResourceAddFormMode()) return GNewTaskResources;
            GNewTaskResources = [];
            var seen = {};
            var existingKeys = (GMultiResourceSaveMode === 'PARENT_EDIT' || (GisParentTask && ResourceMode === 'INSERT'))
                ? getExistingParentTaskResourceRowKeys() : {};
            function pushResource(empID, effort, startDate, endDate, $select) {
                var rowKey = getNewTaskResourceRowKey(empID, effort, startDate, endDate);
                if (!empID || !effort || !startDate || !endDate || seen[rowKey] || existingKeys[rowKey]) return;
                if (effort === '00:00' || effort === '0:00') return;
                seen[rowKey] = true;
                GNewTaskResources.push({
                    employeeID: empID,
                    employeeName: getSelectOptionTextByValue($select, empID),

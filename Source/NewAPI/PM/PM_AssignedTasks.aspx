        function formatEffort(input) {
            let value = input.value.replace(/\D/g, ''); // allow only digits

            if (value.length === 0) {
                input.value = '';
                return;
            }

            if (value.length <= 2) {
                // Hours only → convert to HH:00
                let hours = value.padStart(2, '0');
                input.value = hours + ':00';
            }
            else if (value.length === 3) {
                // HMM → 1:23 → 01:23
                let hours = value.substring(0, 1).padStart(2, '0');
                let minutes = value.substring(1, 3);
                input.value = hours + ':' + minutes;
            }
            else {
                // HHMM → 12:34
                let hours = value.substring(0, 2);
                let minutes = value.substring(2, 4);
                input.value = hours + ':' + minutes;
            }
        }
        

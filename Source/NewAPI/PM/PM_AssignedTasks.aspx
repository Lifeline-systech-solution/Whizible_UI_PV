        // Update pagination controls based on pagination info from server or client
        // Refactored by Dipali V on 1st Jan 2026 - Simplified and removed debug logs
        function updatePaginationControls(paginationInfo) {
            if (!paginationInfo) return;

            // Extract pagination values (handle both camelCase and PascalCase)
            currentPage = parseInt(paginationInfo.CurrentPage || paginationInfo.currentPage || 1);
            pageSize = parseInt(paginationInfo.PageSize || paginationInfo.pageSize || 5);
            TotalRecords = parseInt(paginationInfo.TotalRecords || paginationInfo.totalRecords || 0);
            totalPages = Math.ceil(parseFloat(paginationInfo.TotalPages || paginationInfo.totalPages || 0));

            // Sync to window object for global access
            window.currentPage = currentPage;
            window.pageSize = pageSize;
            window.TotalRecords = TotalRecords;
            window.totalPages = totalPages;

            // Always show pagination controls if there are records
            if (TotalRecords > 0) {
                $('#paginationControls').show();

                // Update total records display
                $("#TotalRecords").html(TotalRecords);

                // Update pagination state
                Pagination();
            } else {
                $('#paginationControls').hide();
                // Reset pagination state when no records
                currentPage = 1;
                TotalRecords = 0;
                totalPages = 0;
                window.currentPage = 1;
                window.TotalRecords = 0;
                window.totalPages = 0;
            }
        }

        // Update pagination button states based on current page
        // Refactored by Dipali V on 1st Jan 2026 - Simplified and removed debug logs
        function Pagination() {
            // Reset button states
            $("#btnprevious, #btnnext").removeClass("fa-disabled");
            $("#LinkPrevious, #LinkNext").removeClass("disabled");
            $("#LinkPrevious").attr("onclick", "PrevList()");
            $("#LinkNext").attr("onclick", "NextList()");

            // Disable previous button on first page
            if (parseInt(currentPage) <= 1) {
                $("#btnprevious").addClass("fa-disabled");
                $("#LinkPrevious").addClass("disabled").prop("onclick", null).off("click");
            }

            // Disable next button on last page
            if (parseInt(currentPage) >= parseInt(totalPages)) {
                $("#btnnext").addClass("fa-disabled");
                $("#LinkNext").addClass("disabled").prop("onclick", null).off("click");
            }
        }

        function PrevList() {
            // Safety check - prevent navigation if disabled
            if ($("#btnprevious").hasClass("fa-disabled") || $("#LinkPrevious").hasClass("disabled")) {
                return false;
            }

            if (currentPage <= 1) {
                currentPage = 1;
            }
            else {
                currentPage -= 1;
            }
            window.currentPage = currentPage;
            loadAssignedTasks(false, true); // Don't apply filters, but do paginate
        }

        function NextList() {
            // Safety check - prevent navigation if disabled
            if ($("#btnnext").hasClass("fa-disabled") || $("#LinkNext").hasClass("disabled")) {
                return false;
            }

            // Only increment if not on last page
            if (currentPage < totalPages) {
                currentPage += 1;
                window.currentPage = currentPage;
                // Debug log - Added by Dipali V on 1st Jan 2026
                console.log('NextList - Moving to page:', currentPage, 'of', totalPages);
                loadAssignedTasks(false, true); // Don't apply filters, but do paginate
            }
        }

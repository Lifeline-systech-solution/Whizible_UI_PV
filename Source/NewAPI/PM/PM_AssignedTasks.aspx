        // Added by Dipali V on 13th Jan 2026 - Get validation data from SP (returns validation results, not raw data)
        var GValidationData = null;
        function getValidationData(projectID, taskID, parentTaskID, employeeID, startDate, endDate, plannedHours, callback) {
            var request = {
                ProjectID: projectID,
                TaskID: taskID || null,
                ParentTaskID: parentTaskID || null,
                EmployeeID: employeeID || null,
                StartDate: startDate ? new Date(startDate).toISOString() : null,
                EndDate: endDate ? new Date(endDate).toISOString() : null,
                PlannedHours: plannedHours || null
            };
            
            var result = AJAXCallWithResult('api/PM_AssignedTasks/GetAssignTaskValidationData', JSON.stringify(request), false);
            
            // Handle new API response structure: { status: "SUCCESS", list: [{ projectInfo, holidays, employeeLeaves }] }
            if (result && result.status === "SUCCESS" && result.list && result.list.length > 0) {
                // Extract data from list[0] structure
                var validationData = result.list[0];
                GValidationData = {
                    projectInfo: validationData.projectInfo || null,
                    holidays: validationData.holidays || [],
                    employeeLeaves: validationData.employeeLeaves || []
                };
            } else if (result && Array.isArray(result) && result.length > 0) {
                // Fallback: Handle old array format if API still returns it
                GValidationData = result;
            } else {
                GValidationData = {
                    projectInfo: null,
                    holidays: [],
                    employeeLeaves: []
                };
                if (callback) callback(GValidationData);
            }
            return GValidationData;
        }

        function timeToMinutes(time) {
            if (!time) return 0;

            // If ":" is not present, append ":00"
            // Convert to string to avoid errors
            time = time.toString();

            // If ":" is not present, append ":00"
            if (time.indexOf(':') === -1) {
                time = time + ':00';
            }
            var parts = time.split(':');
            return (parseInt(parts[0], 10) * 60) + parseInt(parts[1], 10);
        }

        function minutesToTime(minutes) {
            var hrs = Math.floor(minutes / 60);
            var mins = minutes % 60;
            return String(hrs).padStart(2, '0') + ':' + String(mins).padStart(2, '0');
        }

        function decimalToHHMM(decimalHours) {
            if (decimalHours == null || isNaN(decimalHours)) return '00:00';

            var totalMinutes = Math.round(decimalHours * 60);
            var hours = Math.floor(totalMinutes / 60);
            var minutes = totalMinutes % 60;

            return String(hours).padStart(2, '0') + ':' + String(minutes).padStart(2, '0');
        }


        //function normalizeDate(d) {
        //    return new Date(d.getFullYear(), d.getMonth(), d.getDate());
        //}

        function normalizeDate(d) {

            // Handle null / undefined safely
            if (!d) return null;

            // If string like "2025-12-02"
            if (typeof d === 'string') {
                // Convert to Date safely (local time)
                d = new Date(d + 'T00:00:00');
            }

            // If still not a valid Date, exit safely
            if (!(d instanceof Date) || isNaN(d.getTime())) {
                return null;
            }

            return new Date(d.getFullYear(), d.getMonth(), d.getDate());
        }

        // Added by dipali v on 19th Jun 2026 for purpose — expand parent task dates to child resource min/max on confirm
        function applyParentTaskDatesFromChildResources(currentStart, currentEnd, isUpdateMode, childTaskID) {
            var minD = null, maxD = null;
            function consider(val) {
                if (!val) return;
                var d = normalizeDate(parseDate(val) || val);
                if (!d) return;
                if (!minD || d < minD) minD = d;
                if (!maxD || d > maxD) maxD = d;
            }
            consider(currentStart);
            consider(currentEnd);
            $('#parentTaskResourceTable tbody tr').each(function () {
                var $row = $(this);
                if ($row.find('td').length < 4) return;
                var tid = $row.data('taskid');
                if (isUpdateMode && childTaskID && parseInt(tid, 10) === parseInt(childTaskID, 10)) return;
                consider($row.find('.resource-start-date').text().trim());
                consider($row.find('.resource-end-date').text().trim());
                consider($row.find('.edit-resource-start-date').val());
                consider($row.find('.edit-resource-end-date').val());
            });
            if (minD) $('#CRTstdateStartDate').val(formatDateForDisplay(minD));
            if (maxD) $('#CRTendateEndDate').val(formatDateForDisplay(maxD));
        }


        var IsValid = 1;

        function GetSprintRelease(UserStoryID) {
            //;
            if (UserStoryID != "") {
                UserStoryID = UserStoryID;
                var WBSParameters = {
                    UserStoryID: encodeURI(UserStoryID),
                    ProjectID: SessionProjectID,
                    TaskID: $("#hidden_task_id_offcanvas").val()
                }
                var IterationName, ReleaseName, InitialEstimate, StoryPoints;
                var param = JSON.stringify(WBSParameters);
                //var Result = AJAXCallWithAuthorizeResult("/api/PM_wbs_card/GetSprintRelease", param, false);
                var Result = AJAXCallWithResult('api/PM_AssignedTasks/GetSprintRelease',
                    param, false);
                if (Result != null) {
                    for (i = 0; i <= Result.list.length - 1; i++) {
                        //;
                        var sprintData = Result.list[i].data.data;
                        IterationName = sprintData.iterationName
                        ReleaseName = sprintData.releaseName
                        StoryPoints = sprintData.storyPoints
                        InitialEstimate = sprintData.initialEstimate
                        $("#input_sprint").val(IterationName);
                        $("#input_release").val(ReleaseName);
                        
                        // Added by Auto - Ensure Release and Sprint remain readonly after setting values
                        $("#input_sprint").prop("disabled", true).prop("readonly", true);
                        $("#input_release").prop("disabled", true).prop("readonly", true);
                        
                        if ($("#hidden_task_id_offcanvas").val() == 0) {
                            $("#input_storypoint").val(InitialEstimate);
                            $("#hdnstorypoints").val(InitialEstimate);
                        }
                        else {
                            $("#input_storypoint").val(StoryPoints);
                            $("#hdnstorypoints").val(InitialEstimate);
                        }

                    }

                } else {
                    $("#input_sprint").val("");
                    $("#input_release").val("");
                    $("#input_storypoint").val("");
                    
                    // Added by Auto - Ensure Release and Sprint remain readonly even when cleared
                    $("#input_sprint").prop("disabled", true).prop("readonly", true);
                    $("#input_release").prop("disabled", true).prop("readonly", true);

                }
            }
        }


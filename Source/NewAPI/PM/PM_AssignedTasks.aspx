                            } else {
                                // Added By Dipali V On 3rd Feb 2026 For W26 - Don't call handleTaskCreationSuccess for updates
                                // handleTaskCreationSuccess is meant for new tasks and opens edit offcanvas
                                // For updates, we just refresh the list view (already done above)
                            }


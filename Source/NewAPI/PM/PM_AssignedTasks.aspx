        function refreshNewTaskResourceSelectpicker($select, clearValue) {
            if (!$select || !$select.length) return;
            var placeholderText = getResourceSelectPlaceholderText();
            ensureResourceSelectPlaceholderOption($select);
            if (clearValue) $select.val('');
            if ($.fn.selectpicker && $select.data('selectpicker')) {
                var inst = $select.data('selectpicker');
                if (inst && inst.options) inst.options.noneSelectedText = placeholderText;
                $select.selectpicker('refresh');
            }
        }


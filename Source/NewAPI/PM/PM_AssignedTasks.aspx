                alertify.success(buildPartialBatchResourceSuccessMessage(
                    '<%= MyBase.GetResourceString("M_TaskSavedSuccessfully") %>', failedNames, true));
            } else if (!hadErrors) {
                alertify.success('<%= MyBase.GetResourceString("M_TaskSavedSuccessfully") %>');
            }
            finishNewTaskFlowAfterSave(parentTaskID, hadSuccess ? emailIds : null);
        }

        function finishMultiResourceSave(parentTaskID, emailEmployeeIdOrList) {
            if (GMultiResourceSaveMode === 'PARENT_EDIT') {
                finishParentEditResourceSave(parentTaskID, emailEmployeeIdOrList);
                return;
            }
            if (GMultiResourceSaveMode === 'COPY') {
                finishCopyTaskSave(parentTaskID, emailEmployeeIdOrList);
                return;
            }
            finishNewTaskResourceSave(parentTaskID, emailEmployeeIdOrList);
        }

        function finishNewTaskResourceSave(parentTaskID, emailEmployeeIdOrList) {
            var failedNames = GNewTaskFailedResourceNames.slice();
            var hadFailures = GNewTaskResourceFailures.length > 0;
            var assignedIds = [];
            if (Array.isArray(emailEmployeeIdOrList)) {
                assignedIds = emailEmployeeIdOrList.filter(function (id) { return parseInt(id, 10) > 0; });
            } else if (emailEmployeeIdOrList && parseInt(emailEmployeeIdOrList, 10) > 0) {
                assignedIds = [parseInt(emailEmployeeIdOrList, 10)];
            }
            var hadAssignedResources = assignedIds.length > 0;

            if (hadFailures) {
                showValidationAlertifyError(GNewTaskResourceFailures);
            }
            GNewTaskResourceFailures = [];
            GNewTaskFailedResourceNames = [];
            GNewTaskResources = [];
            GNewTaskValidatedList = [];
            GNewTaskResourceIndex = 0;
            GNewTaskSoftConfirmQueue = [];
            GNewTaskSoftConfirmIndex = 0;

            // Purpose: validation failed with no assign — task may exist; no success/email/close
            if (!hadAssignedResources) {
                GNewTaskDeferTaskSuccess = false;
                loadAssignedTasks(getCurrentProjectID(), false, false, true);
                return;
            }

            IsNewTask = 0;
            loadAssignedTasks(getCurrentProjectID(), false, false, true);
            if (GNewTaskDeferTaskSuccess) {
                alertify.set('notifier', 'position', 'top-right');
                // Purpose: "restricted resource" only when assign skipped — not when validation errors exist
                var successMsg = (!hadFailures && failedNames.length)
                    ? buildPartialBatchResourceSuccessMessage(
                        '<%= MyBase.GetResourceString("M_TaskSavedSuccessfully") %>', failedNames, true)
                    : '<%= MyBase.GetResourceString("M_TaskSavedSuccessfully") %>';
                alertify.success(successMsg);
                GNewTaskDeferTaskSuccess = false;
            }
            finishNewTaskFlowAfterSave(parentTaskID, assignedIds);
        }

        // Added by Dipali V on 22nd Jun 2026 - Purpose: assign all validated resources in one batch API call (SP handles JSON)
        function assignAllMultiResources(parentTaskID) {
            if (!GNewTaskValidatedList.length) {
                finishMultiResourceSave(parentTaskID, 0);
                return;
            }

            var batchRequest = buildNewTaskResourcesBatchRequest(parentTaskID, GNewTaskValidatedList);
            var saveResult = AJAXCallWithResult(
                'api/PM_AssignedTasks/AssignTaskResources',
                JSON.stringify(batchRequest),
                false
            );

            var payload = saveResult && saveResult.list && saveResult.list[0] ? saveResult.list[0] : saveResult;
            var status = payload && (payload.status || payload.Status);
            if (!saveResult || status !== 'SUCCESS') {
                var saveErr = (payload && (payload.message || payload.Message)) || '<%= MyBase.GetResourceString("M_ErrorAddingResource") %>';
                alertify.error(saveErr);
                finishMultiResourceSave(parentTaskID, 0);
                return;
            }

            var emailEmployeeIds = GNewTaskValidatedList.map(function (r) {
                return parseInt(r.employeeID, 10) || 0;
            }).filter(function (id) { return id > 0; });
            finishMultiResourceSave(parentTaskID, emailEmployeeIds);
        }


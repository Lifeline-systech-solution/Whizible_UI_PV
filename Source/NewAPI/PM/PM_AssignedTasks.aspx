        //Start of  bind Custom Field Data
        function bindCustomFields(selectedTask) {

            if (!selectedTask) return;

            Object.keys(selectedTask).forEach(function (fieldName) {

                // Only bind CustomFields - handle both camelCase (customFieldCombo9) and PascalCase (CustomFieldCombo9)
                var normalizedFieldName = fieldName;
                if (fieldName.startsWith('customField')) {
                    // Convert camelCase to PascalCase: customFieldCombo9 -> CustomFieldCombo9
                    normalizedFieldName = 'CustomField' + fieldName.substring(11); // 'customField' is 11 chars
                } else if (!fieldName.startsWith('CustomField')) {
                    return; // Not a custom field
                }

                var value = getTaskProp(selectedTask, fieldName, '');
                if (value === '' || value === null || value === undefined) return;

                var prefix = getControlPrefix(normalizedFieldName);
                var controlId = '#' + prefix + normalizedFieldName;

                var $control = $(controlId);
                if ($control.length === 0) {
                    // Debug: log if control not found
                    console.log('Custom field control not found:', controlId, 'for field:', fieldName);
                    return;
                }

                // Handle date fields
                if (prefix === 'dt') {
                    $control.val(formatDateForInput(value)); // optional formatter
                }
                // Handle combo / dropdown
                else if (prefix === 'cbo') {
                    // For combo fields, wait a bit for options to load, then set value
                    setTimeout(function() {
                        // Check if control still exists and has options
                        var $ctrl = $(controlId);
                        if ($ctrl.length > 0) {
                            // Try to set the value
                            $ctrl.val(value);
                            // If selectpicker is used, refresh it
                            if ($ctrl.hasClass('selectpicker')) {
                                $ctrl.selectpicker('refresh');
                            } else {
                                // For regular select, trigger change
                                $ctrl.trigger('change');
                            }
                            // If value wasn't set (option doesn't exist yet), try again after a longer delay
                            if ($ctrl.val() != value && $ctrl.find('option').length > 0) {
                                setTimeout(function() {
                                    $ctrl.val(value);
                                    if ($ctrl.hasClass('selectpicker')) {
                                        $ctrl.selectpicker('refresh');
                                    } else {
                                        $ctrl.trigger('change');
                                    }
                                }, 500);
                            }
                        }
                    }, 100);
                }
                // Text / Numeric / TextArea
                else {
                    $control.val(value);
                }
            });
        }
        function formatDateForInput(dateVal) {
            if (!dateVal) return '';
            var d = new Date(dateVal);
            if (isNaN(d.getTime())) return '';
            return d.toISOString().split('T')[0]; // yyyy-MM-dd
        }
        function getControlPrefix(fieldName) {
            if (fieldName.indexOf('CustomFieldCombo') === 0) return 'cbo';
            if (fieldName.indexOf('CustomFieldDate') === 0) return 'dt';
            // Text, Numeric, TextArea
            return 'txt';
        }

        function getTaskProp(obj, propName, defaultVal) {
            if (!obj) return defaultVal;
            return obj[propName] !== undefined && obj[propName] !== null
                ? obj[propName]
                : defaultVal;
        }

                });

                uploadArea.addEventListener("drop", (e) => {
                    if (GisParentTask === false) return;
                    e.preventDefault();
                    uploadArea.classList.remove("dragover");
                    if (e.dataTransfer.files.length > 0) {
                        handleFileSelect(e.dataTransfer.files[0]);
                    }
                });
            }
        });

        function handleFileSelect(fileInputOrFile) {
            let file;
            if (fileInputOrFile.files) {
                file = fileInputOrFile.files[0];
            } else {
                file = fileInputOrFile;
            }

            if (file) {
                // Added By Dipali V On 3rd Feb 2026 For W26 - Validate file size (max 10MB)
                const maxSize = 10 * 1024 * 1024; // 10MB in bytes
                if (file.size > maxSize) {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('File size exceeds 10MB limit. Please select a smaller file.');
                    $("#fileInput").val("");
                    $("#fileInput").removeData("selected-file");
                    return;
                }

                const fileName = file.name;
                const fileSize = (file.size / 1024).toFixed(2) + " KB";

                // Show file preview
                $("#uploadArea .upload-content").addClass("d-none");
                $("#uploadArea #filePreview").removeClass("d-none");
                $("#filePreview .file-name").text(fileName);
                $("#filePreview .file-size").text(fileSize);

                // Store file in data attribute for upload
                $("#fileInput").data("selected-file", file);
            }
        }

        // Remove file
        $(document).on("click", "#removeFile", function () {
            $("#uploadArea .upload-content").removeClass("d-none");

            tbody.empty();

            try {
                if (voidTaskList && Array.isArray(voidTaskList) && voidTaskList.length > 0) {
                    // Group tasks by parent task name
                    var groupedTasks = {};

                    voidTaskList.forEach(function (task) {
                        var parentTaskName = task.ParentTaskName || task.parentTaskName || task.TaskName || task.taskName || 'Unnamed Task';
                        if (!groupedTasks[parentTaskName]) {
                            groupedTasks[parentTaskName] = [];
                        }

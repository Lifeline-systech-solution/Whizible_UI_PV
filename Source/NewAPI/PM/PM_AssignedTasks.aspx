        // Modified by Vyankat B. on 22-Jun-2026 - Separated EditAccess (resource/upload buttons)
        //   from AddAccess (Add Resource form Save button) for correct granular control
        function applyPageAccessControl() {
            // --- EditAccess controls ---
            if (!EditAccess) {
                // Hide "Add Resource" button that opens the add-resource form
                $('#btnAddResource').hide();

                // Hide Edit (pencil) buttons already rendered in resource table rows
                $('.edit-resource-btn').hide();

                // Hide Task Attribute Select/Save buttons (all panels)
                $('#deli_save_btn, #milestone_save_btn, #phase_save_btn, #module_save_btn, ' +

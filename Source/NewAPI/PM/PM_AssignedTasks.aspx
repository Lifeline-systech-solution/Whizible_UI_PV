        function renderHistoryPage() {
            //
            var $tbody = $('#taskHistoryTableBody');
            $tbody.empty();

            var totalRecords = historyFilteredData.length;
            var totalPages = Math.ceil(totalRecords / historyPageSize);
            var start = (historyCurrentPage - 1) * historyPageSize;
            var pageData = historyFilteredData.slice(start, start + historyPageSize);
            pageData.forEach(function (item) {
                var row = '<tr>' +
                    '<td>' + escapeHtml(item.ColumnName || item.columnName || '-') + '</td>' +
                    '<td>' + escapeHtml(item.OldValue || item.oldValue || '-') + '</td>' +
                    '<td>' + escapeHtml(item.NewValue || item.newValue || '-') + '</td>' +
                    '<td>' + escapeHtml(item.ModifiedBy || item.modifiedBy || '-') + '</td>' +
                    '<td>' + formatDateForDisplay(item.ModifiedDate || item.modifiedDate || item.AuditTimestamp || item.auditTimestamp) + '</td>' +
                    '</tr>';
                $tbody.append(row);
            });
            // Update pagination controls
            $('#historyPaginationControls').show();
            $('#historyTotalRecords').text(totalRecords);

            // Previous button state
            if (historyCurrentPage <= 1) {
                $('#historyBtnPrevious').addClass('fa-disabled');
                $('#historyLinkPrevious').addClass('disabled');
            } else {
                $('#historyBtnPrevious').removeClass('fa-disabled');
                $('#historyLinkPrevious').removeClass('disabled');
            }

            // Next button state
            if (historyCurrentPage >= totalPages) {
                $('#historyBtnNext').addClass('fa-disabled');
                $('#historyLinkNext').addClass('disabled');
            } else {
                $('#historyBtnNext').removeClass('fa-disabled');
                $('#historyLinkNext').removeClass('disabled');
            }

            var $tbody = $('#taskHistoryTableBody');
            if (!pageData || pageData.length === 0) {
                $tbody.empty();
                $tbody.html('<tr><td colspan="5" class="text-center py-4 text-muted">No history found</td></tr>');

            }
        }
        function historyPrevPage() {
            if ($('#historyBtnPrevious').hasClass('fa-disabled')) return;
            if (historyCurrentPage > 1) {
                historyCurrentPage--;
                renderHistoryPage();
            }
        }

        function historyNextPage() {
            if ($('#historyBtnNext').hasClass('fa-disabled')) return;
            var totalPages = Math.ceil(historyFilteredData.length / historyPageSize);
            if (historyCurrentPage < totalPages) {
                historyCurrentPage++;
                renderHistoryPage();
            }
        }


        function parseDate(dateStr) {
            if (!dateStr || dateStr === '-' || dateStr === '' || dateStr === 'N/A') return null;
            
            try {
                // Try standard Date parsing first
                var date = new Date(dateStr);
                if (!isNaN(date.getTime())) {
                    date.setHours(0, 0, 0, 0);
                    return date;
                }
                
                // Handle DD/MM/YYYY format
                if (dateStr.includes('/')) {
                    var parts = dateStr.split('/');
                    if (parts.length === 3) {
                        var day = parseInt(parts[0]);
                        var month = parseInt(parts[1]) - 1;
                        var year = parseInt(parts[2]);
                        date = new Date(year, month, day);
                        if (!isNaN(date.getTime())) {
                            date.setHours(0, 0, 0, 0);
                            return date;
                        }
                    }
                }
                
                // Handle "31 Jan 2022" format
                var months = {
                    'Jan': 0, 'Feb': 1, 'Mar': 2, 'Apr': 3, 'May': 4, 'Jun': 5,
                    'Jul': 6, 'Aug': 7, 'Sep': 8, 'Oct': 9, 'Nov': 10, 'Dec': 11
                };
                var parts = dateStr.trim().split(/\s+/);
                if (parts.length === 3 && months[parts[1]] !== undefined) {
                    date = new Date(parseInt(parts[2], 10), months[parts[1]], parseInt(parts[0], 10));
                    if (!isNaN(date.getTime())) {
                        date.setHours(0, 0, 0, 0);
                        return date;
                    }
                }
            } catch (e) {
                return null;
            }
            return null;
        }

        // Helper function to format date
        function formatDate(date) {
            return date.toLocaleDateString('en-GB', {
                day: '2-digit',
                month: 'short',
                year: 'numeric'
            });
        }

        // Function to add status badge
        function addStatusBadge($cell, status) {
            // Remove existing status badges
            $cell.find('.status-badge').remove();
            $cell.find('.aging-count-display').remove();

            var badgeClass = 'status-badge-' + status;
            var badge = null;

            // Map status to badge display
            if (status === 'completed') {
                badge = $('<span class="status-badge ' + badgeClass + '">Completed</span>');
                $cell.append('<br>').append(badge);
            } else if (status === 'delayed') {
                // Badge with aging count displayed below (dark red)
                badge = $('<span class="status-badge ' + badgeClass + '">Delayed</span>');
                var agingDisplay = $('<span class="aging-count-display aging-count-delayed">15 days delayed</span>');
                $cell.append('<br>').append(badge).append(agingDisplay);
            } else if (status === 'in-progress') {
                // Badge with aging count displayed below (blue)
                badge = $('<span class="status-badge ' + badgeClass + '">In Progress</span>');
                var agingDisplay = $('<span class="aging-count-display aging-count-in-progress">10 days remain</span>');
                $cell.append('<br>').append(badge).append(agingDisplay);
            }
        }


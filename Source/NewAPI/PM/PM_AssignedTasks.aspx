        function getSelectOptionTextByValue($select, empID) {
            if (!$select || !$select.length || !empID) return '';
            var $opt = $select.find('option[value="' + empID + '"]');
            return $opt.length ? $opt.text().trim() : '';
        }

        function getNewTaskResourceDisplayName(r) {
            if (r && r.employeeName) return r.employeeName;
            if (r && r.employeeID) {
                var fromFirst = getSelectOptionTextByValue($('#select_add_resource'), r.employeeID);
                if (fromFirst) return fromFirst;
            }
            return r && r.employeeID ? ('ID ' + r.employeeID) : 'Resource';
        }

        // Purpose: prefix resource name + row when validating multiple resources on new task
        function prefixNewTaskResourceValidationMessage(errorMsg, r, rowIndexOpt, totalOpt) {
            if (!errorMsg) return errorMsg;
            var msg = String(errorMsg);
            if (/^\s*Resource\s*\(/i.test(msg)) return msg;
            var name = getNewTaskResourceDisplayName(r);
            var rowNum = (typeof rowIndexOpt === 'number' ? rowIndexOpt : (typeof GNewTaskResourceIndex === 'number' ? GNewTaskResourceIndex : 0)) + 1;
            var total = (typeof totalOpt === 'number' ? totalOpt : (GNewTaskResources && GNewTaskResources.length ? GNewTaskResources.length : 1));
            var header = total > 1
                ? 'Resource (' + name + ') - row ' + rowNum + ' of ' + total + ':'
                : 'Resource (' + name + '):';
            return header + '\r\n' + msg;
        }

        function formatNewTaskResourceValidationHtml(errorMsg, r) {
            return formatValidationAlertHtml(prefixNewTaskResourceValidationMessage(errorMsg, r));
        }

        // Purpose: SP hard errors use numbered alerts; soft warnings end with "Do you want to continue?"
        function isSpHardResourceValidationMessage(errorMsg) {
            if (!errorMsg) return false;
            var segments = String(errorMsg).split(/\r?\n\r?\n/).map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; });
            for (var i = 0; i < segments.length; i++) {
                if (/^\d+\.\s/.test(segments[i]) && !/do you want to continue/i.test(segments[i])) {
                    return true;
                }
            }
            return false;
        }

        function isSpSoftResourceConfirmationOnly(errorMsg) {
            if (!errorMsg || !/do you want to continue/i.test(errorMsg)) return false;
            return !isSpHardResourceValidationMessage(errorMsg);
        }

        function getResourceSoftConfirmKey(errorMsg) {
            var m = String(errorMsg || '').toLowerCase();
            if (m.indexOf('start and end date must be between task start date') >= 0) return 'TASK_DURATION';
            if (m.indexOf('has leave') >= 0 || m.indexOf('work from home') >= 0) return 'LEAVE_WFH';
            if (m.indexOf('are holidays') >= 0) return 'HOLIDAY';
            if (m.indexOf('hours work per day') >= 0) return 'OU_HOURS';
            if (m.indexOf('holidays/weekends') >= 0) return 'ALL_WEEKEND';
            return String(errorMsg || '').trim();
        }

        function buildNewTaskResourceValidateRequest(parentTaskID, r) {
            return {
                TaskID: parseInt(parentTaskID),
                ParentTaskID: parseInt(parentTaskID),
                ProjectID: parseInt(SessionProjectID),
                EmployeeID: r.employeeID,
                WorkHours: r.workHours,
                StartDate: r.startDate,
                EndDate: r.endDate,
                TaskTypeID: r.taskTypeID,
                SubTaskTypeID: r.subTaskTypeID,
                IsEditMode: false,
                ExistingResourceID: null,
                UserName: '<%= Session("strUserName") %>'
            };
        }

        // Added by Dipali V on 22nd Jun 2026 - Purpose: build one JSON payload for batch validate/assign SPs
        function buildNewTaskResourcesBatchRequest(parentTaskID, resourceList) {
            var list = resourceList || GNewTaskResources;
            return {
                TaskID: parseInt(parentTaskID, 10),
                ParentTaskID: parseInt(parentTaskID, 10),
                ProjectID: parseInt(SessionProjectID, 10),
                UserName: '<%= Session("strUserName") %>',
                Mode: 'INSERT',
                Resources: list.map(function (r, idx) {
                    return {
                        RowIndex: idx,
                        EmployeeID: parseInt(r.employeeID, 10),
                        EmployeeName: getNewTaskResourceDisplayName(r),
                        WorkHours: r.workHours,
                        // Purpose: keep plain form dates — ISO strings cause Params header vs body mismatch on AssignTaskResources
                        StartDate: r.startDate,
                        EndDate: r.endDate,
                        TaskTypeID: r.taskTypeID ? parseInt(r.taskTypeID, 10) : null,
                        SubTaskTypeID: r.subTaskTypeID ? parseInt(r.subTaskTypeID, 10) : null
                    };
                })
            };
        }

        function getBatchResourceRowIndex(item, fallbackIdx) {
            if (item && (item.rowIndex !== undefined && item.rowIndex !== null)) return parseInt(item.rowIndex, 10);
            if (item && (item.RowIndex !== undefined && item.RowIndex !== null)) return parseInt(item.RowIndex, 10);
            return fallbackIdx;
        }

        function getBatchResourceResultType(item) {
            return String((item && (item.resultType || item.ResultType)) || '').toUpperCase();
        }

        // Modified by Dipali V on 25th Jun 2026 - Purpose: API returns rows in list[] OR nested in list[0].results
        function parseBatchResourceValidationResult(validationResult) {
            var list = validationResult && validationResult.list ? validationResult.list : [];
            if (!list.length) return { results: [], combinedError: '' };
            var first = list[0];
            var nested = first && (first.results || first.Results);
            if (Array.isArray(nested) && nested.length) {
                return {
                    results: nested,
                    combinedError: first.combinedErrorMessage || first.CombinedErrorMessage || ''
                };
            }
            if (first && (first.resultType || first.ResultType || first.rowIndex !== undefined || first.RowIndex !== undefined)) {
                return { results: list, combinedError: first.combinedErrorMessage || first.CombinedErrorMessage || '' };
            }
            return { results: list, combinedError: '' };
        }

        function getBatchFailedResourceName(item, r) {
            var name = getNewTaskResourceDisplayName(r) || (item && (item.employeeName || item.EmployeeName)) || '';
            return String(name || '').trim();
        }

        function trackBatchFailedResourceName(item, r) {
            var name = getBatchFailedResourceName(item, r);
            if (name && GNewTaskFailedResourceNames.indexOf(name) < 0) GNewTaskFailedResourceNames.push(name);
        }

        // Added by Dipali V On 22nd Jun 2026 - Purpose: single success line when valid resources assigned but restricted ones skipped
        function buildPartialBatchResourceSuccessMessage(baseMsg, failedNames, isNewTask) {
            if (!failedNames || !failedNames.length) return baseMsg;
            var resLabel = failedNames.length === 1 ? 'resource' : 'resources';
            if (isNewTask !== false) {
                return 'Task saved successfully without assigning following restricted ' + resLabel + ': ' + failedNames.join(', ');
            }
            return 'Resource(s) added successfully without assigning following restricted ' + resLabel + ': ' + failedNames.join(', ');
        }

        // Added by Dipali V on 22nd Jun 2026 - Purpose: process batch validate response (per-resource restrict vs notification from SP)
        function handleBatchNewTaskResourceValidationResponse(validationResult, parentTaskID) {
            var parsed = parseBatchResourceValidationResult(validationResult);
            var results = parsed.results;
            var combinedError = parsed.combinedError;
            if (!results.length) {
                alertify.error('Resource validation failed.');
                return;
            }

            var total = GNewTaskResources.length;

            results.forEach(function (item, idx) {
                var rowIdx = getBatchResourceRowIndex(item, idx);
                var r = GNewTaskResources[rowIdx] || GNewTaskResources[idx];
                var resultType = getBatchResourceResultType(item);
                if (resultType === 'OK' || item.isValid === true || item.IsValid === true || item.isValid === 1 || item.IsValid === 1) {
                    GNewTaskValidatedList.push(r);
                } else if (resultType === 'NOTIFICATION' || isSpSoftResourceConfirmationOnly(item.message || item.Message || '')) {
                    GNewTaskSoftConfirmQueue.push({
                        resource: r,
                        message: prefixNewTaskResourceValidationMessage(item.message || item.Message || '', r, rowIdx, total)
                    });
                } else if (resultType === 'ERROR') {
                    trackBatchFailedResourceName(item, r);
                    if (!combinedError) {
                        var errMsg = prefixNewTaskResourceValidationMessage(
                            item.message || item.Message || '<%= MyBase.GetResourceString("M_ValidationFailedPleaseCheckInput") %>',
                            r, rowIdx, total
                        );
                        GNewTaskResourceFailures.push(formatValidationAlertHtml(errMsg));
                    }
                }
            });

            // Purpose: API returns one combined numbered message for all resource errors — single alertify
            if (combinedError) {
                GNewTaskResourceFailures = [formatValidationAlertHtml(combinedError)];
            }

            if (GNewTaskSoftConfirmQueue.length > 0) {
                GNewTaskSoftConfirmIndex = 0;
                showNextNewTaskSoftConfirmation();
            } else if (GNewTaskValidatedList.length > 0) {
                assignAllMultiResources(parentTaskID);
            } else {
                finishMultiResourceSave(parentTaskID, 0);
            }
        }

        function showNextNewTaskSoftConfirmation() {
            if (GNewTaskSoftConfirmIndex >= GNewTaskSoftConfirmQueue.length) {
                assignAllMultiResources(GNewTaskParentTaskID);
                return;
            }
            var item = GNewTaskSoftConfirmQueue[GNewTaskSoftConfirmIndex];
            GPendingNewTaskResource = item.resource;
            GconfirmationActionType = 'NEW_TASK_RESOURCE_MULTI';
            showConfirmDeleteResourceModal(formatValidationAlertHtml(item.message || ''));
        }


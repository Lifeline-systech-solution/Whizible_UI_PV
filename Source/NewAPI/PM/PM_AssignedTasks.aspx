        // ========== Added By Madhuri.K on 27-11-2025 - Date Picker and Task Filter Initialization - Start ==========
        $(document).ready(function() {
            // Added by Dipali V - Initialize task attribute save buttons visibility
            initializeTaskAttributeSaveButtons();

            // Added by Vyankat B. on 22-Jun-2026 - Apply page-level access control on load
            // Hides Edit-gated buttons (Add Resource, Task Attribute selects, Document Upload)
            // and Delete-gated icons (Document delete) based on current user permissions.
            applyPageAccessControl();
            // End of Added by Vyankat B. on 22-Jun-2026 - Apply page-level access control on load
            
            // Added by Auto - Ensure Release and Sprint are always readonly/disabled on page load
            $('#input_sprint, #input_release').prop('disabled', true).prop('readonly', true);
            
            // Initialize datepickers with same format as Bulk Creation page
            $('#taskFromDate, #taskToDate,#add_resource_start_date,#add_resource_end_date').datepicker({
                autoclose: true,
                changeMonth: true,
                changeYear: true,
                dateFormat: 'dd M yy',
                onSelect: function () {
                    if (this.id === 'add_resource_start_date' || this.id === 'add_resource_end_date') {
                        getResourceAllocationHoursForAddResource('date', $(this));
                    }
                }
            });

            // Open datepicker when calendar button is clicked
            $(document).on('click', '.btncalendar', function(){
                var $input = $(this).closest('.input-group').find('input[type="text"]');
                if ($input.length) {
                    try { $input.datepicker('show'); } catch(e) {}
                }
            });
            // Generic handler for all radio button filter changes
            // Modified by Nikhil - Chips should only update on Show button click, not on every filter change
            // Modified by Nikhil - Chips should only update on Show button click, not on every filter change
            // Modified by Nikhil - Added togglePeriodFields to grey out/clear Period+Date fields when "Show All Tasks" is selected
            function togglePeriodFields(isPeriodMode) {
                if (isPeriodMode) {
                    // "Show Tasks For Selected Period" selected — enable all period/date fields
                    $('#taskPeriod').prop('disabled', false);
                    if (typeof $.fn.selectpicker !== 'undefined' && $('#taskPeriod').hasClass('selectpicker')) {
                        $('#taskPeriod').selectpicker('refresh');
                    }
                    $('#taskFromDate').prop('disabled', false).closest('.input-group').find('button').prop('disabled', false);
                    $('#taskToDate').prop('disabled', false).closest('.input-group').find('button').prop('disabled', false);
                    // Also re-enable To Date row
                    $('#taskToDate').closest('.row.mb-2.align-items-center').css('opacity', '1');
                    $('#taskToDate').closest('.row.mb-2.align-items-center').find('input, button').prop('disabled', false);
                } else {
                    // "Show All Tasks" selected — clear and disable period/date fields
                    $('#taskPeriod').val('').prop('disabled', true);
                    if (typeof $.fn.selectpicker !== 'undefined' && $('#taskPeriod').hasClass('selectpicker')) {
                        $('#taskPeriod').selectpicker('refresh');
                    }
                    $('#taskFromDate').val('').prop('disabled', true).closest('.input-group').find('button').prop('disabled', true);
                    $('#taskToDate').val('').prop('disabled', true).closest('.input-group').find('button').prop('disabled', true);
                    // Also grey out To Date row
                    $('#taskToDate').closest('.row.mb-2.align-items-center').css('opacity', '0.45');
                    $('#taskToDate').closest('.row.mb-2.align-items-center').find('input, button').prop('disabled', true);
                }
            }

            // Initialise on page load — "Show All Tasks" is checked by default so disable period fields immediately
            // Modified by Nikhil
            togglePeriodFields($('#showTasksForPeriod').is(':checked'));

            $(document).on(
                'change',
                'input[name="taskDateFilter"], input[name="taskType"]',
                function () {
                    console.log('Radio filter changed:', this.name, this.value);
                    if (this.name === 'taskDateFilter') {
                        if (this.value === 'all') {
                            // Modified by Nikhil - Clear values and disable period fields when Show All Tasks selected
                            togglePeriodFields(false);
                        } else if (this.value === 'period') {
                            // Modified by Nikhil - Enable period fields when Show Tasks For Selected Period selected
                            togglePeriodFields(true);
                        }
                    }
                    // Removed updateChipsSection() - chips only update on Show click (Nikhil)
                }
            );
            // Modified by Nikhil - Chips should only update on Show button click, not on period change
            $('#taskPeriod').on('change', function () {
                var selectedPeriod = $(this).val();
                if (selectedPeriod) {
                    var dates = calculatePeriodDates(selectedPeriod);
                    if (dates) {
                        $('#taskFromDate').val(dates.fromDate);
                        $('#taskToDate').val(dates.toDate);
                        // Removed updateChipsSection() - chips only update on Show click (Nikhil)
                        //Added by dipali v on 1st jan 2026 to reload tasks on period change
                        //loadAssignedTasks(true, false);
                        //End of Added by dipali v on 1st jan 2026 to reload tasks on period change
                    }
                }
            });


            // Modified by Nikhil - Chips should only update on Show button click, not on dropdown/date change
            $(document).on(
                'changed.bs.select change',
                '#sel_resource, #sel_task_status, #cboAssignedTaskProject, #taskFromDate, #taskToDate',
                function () {
                    // Removed updateChipsSection() - chips only update on Show click (Nikhil)
                }
            );

          
            //End of Commented by dipali v on 1st jan 2026 to avoid multiple calls on filter change


            $('.task-management-tabs .nav-link').on('click', function (e) {
                e.preventDefault();

                const tab = $(this).data('tab');
                const pageSrc = $(this).data('page');

                // Remove active class from all tabs
                $('.task-management-tabs .nav-link').removeClass('active')
                    .css({
                        'color': '#666',
                        'background': 'transparent',
                        'border-bottom-color': 'transparent',
                        'font-weight': '500'
                    });

                // Add active class to clicked tab
                $(this).addClass('active')
                    .css({
                        'color': '#1359a6',
                        'background': '#f0f7ff',
                        'border-bottom-color': '#1359a6',
                        'font-weight': '600'
                    });
               // ;    
                // Show/hide content based on tab
                if (tab === 'PM_AssignedTasks.aspx') {
                    // Show assigned tasks content, hide iframe
                    $('#assignedTasksContent').show();
                    $('#otherPagesContainer').hide();
                    $('#otherPagesFrame').attr('src', '');
                    // Show entire control section (Select Project, Search Section, Create New Task) only for Assigned Tasks tab
                    $('#assignedTasksControlSection').show();

        // -----------------------------------------------------------------------
        // Cross-page single-selection handler wired at document level.
        // Covers Deliverable (mainchck), Milestone (mainchck inside milestone offcanvas),
        // Module (Phase_mainchck), SubProject (Sub_project_mainchck), UserStory (User_Story_mainchck).
        // -----------------------------------------------------------------------
        // Added by Vaibhav K on 16-03-2026 - Cross-page single selection for paginated offcanvases
        $(document).on('change.ocPagination',
            '#offcanvas_CRDTmodal input.mainchck, ' +
            '#offcanvas_Milestone_select input.mainchck, ' +
            '#offcanvas_Phase_select input.mainchck, ' +
            '#offcanvas_Phase_select input.Phase_mainchck, ' +
            '#offcanvas_Module_select input.Phase_mainchck, ' +
            '#offcanvas_Sub_project_select input.Sub_project_mainchck, ' +
            '#offcanvas_User_Story_select input.User_Story_mainchck',
        function() {
            var $chk = $(this);
            var key = null;

            if ($chk.closest('#offcanvas_CRDTmodal').length)          key = 'deliverable';
            else if ($chk.closest('#offcanvas_Milestone_select').length)   key = 'milestone';
            else if ($chk.closest('#offcanvas_Phase_select').length)       key = 'phase';
            else if ($chk.closest('#offcanvas_Module_select').length)      key = 'module';
            else if ($chk.closest('#offcanvas_Sub_project_select').length) key = 'subproject';
            else if ($chk.closest('#offcanvas_User_Story_select').length)  key = 'userstory';

            if (!key) return;

            var state = offcanvasPagination[key];

            if ($chk.is(':checked')) {
                // --- New selection: store value, uncheck everything else on current page ---
                var newVal = $chk.val();
                state.selectedValue = String(newVal);

                // Uncheck all other checkboxes visible on this page right now
                $chk.closest('tbody').find('input[type="checkbox"]').not($chk).prop('checked', false);

                // For raw-HTML modes (module / subproject / userstory) also strip checked
                // from every entry in data[] so navigating to another page won't show stale ticks
                if (state.data.length > 0 && typeof state.data[0] === 'string') {
                    state.data = state.data.map(function(html) {
                        // Remove checked attribute from all checkboxes in this HTML string
                        return html.replace(/(<input[^>]*type="checkbox"[^>]*)\schecked(?=\s|>|\/)/gi, '$1')
                                   .replace(/(<input[^>]*)\schecked(\s[^>]*type="checkbox")/gi, '$1$2');
                    });
                    // Now re-add checked on the selected item's raw HTML entry
                    state.data = state.data.map(function(html) {
                        // Match value="<newVal>" in this row's input and add checked
                        var valPattern = new RegExp('value="' + newVal.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '"');
                        if (valPattern.test(html)) {
                            return html.replace(/(<input[^>]*type="checkbox"[^>]*?)(\s*\/?>)/i, '$1 checked$2');
                        }
                        return html;
                    });
                }

                // Sync hidden input so saveTaskAttribute reads the right value
                if (_ocHiddenMap[key]) {
                    $(_ocHiddenMap[key]).val(newVal);
                }

            } else {
                // Unchecked: clear selection state
                state.selectedValue = null;
                if (_ocHiddenMap[key]) {
                    $(_ocHiddenMap[key]).val('');
                }
                // For raw-HTML modes strip all checked attrs from data[]
                if (state.data.length > 0 && typeof state.data[0] === 'string') {
                    state.data = state.data.map(function(html) {
                        return html.replace(/(<input[^>]*type="checkbox"[^>]*)\schecked(?=\s|>|\/)/gi, '$1')
                                   .replace(/(<input[^>]*)\schecked(\s[^>]*type="checkbox")/gi, '$1$2');
                    });
                }
            }
        });
        // End of cross-page single-selection handler

        // --- Generic render-page helper (used by Deliverable & Milestone) ---
        function renderOffcanvasPage(key, renderRowFn, tbodySelector, containerId, totalId, prevBtnId, nextBtnId) {
            var state = offcanvasPagination[key];
            var totalRecords = state.data.length;
            var totalPages = Math.ceil(totalRecords / state.pageSize) || 1;
            if (state.currentPage > totalPages) state.currentPage = totalPages;
            if (state.currentPage < 1) state.currentPage = 1;

            var start = (state.currentPage - 1) * state.pageSize;
            var end   = Math.min(start + state.pageSize, totalRecords);
            var pageData = state.data.slice(start, end);

            var $tbody = $(tbodySelector);
            $tbody.empty();

            if (totalRecords === 0) {
                $('#' + containerId).css('display', 'none');
                return;
            }

            pageData.forEach(function(item) { $tbody.append(renderRowFn(item)); });

            // Update total records label
            $('#' + totalId).text('Total Records: ' + totalRecords);

            // Show/hide prev-next buttons
            $('#' + prevBtnId).prop('disabled', state.currentPage <= 1).css('opacity', state.currentPage <= 1 ? '0.4' : '1');
            $('#' + nextBtnId).prop('disabled', state.currentPage >= totalPages).css('opacity', state.currentPage >= totalPages ? '0.4' : '1');

            // Show pagination strip (flex)
            $('#' + containerId).css('display', 'flex');
        }


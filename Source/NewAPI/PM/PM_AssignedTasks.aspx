        // Added by Dipali V on 12th Jan 2026 - Handle confirmation modal OK button click based on global flag
        // Handles DELETE, VOID, and VALIDATION cases
        function confirmDeleteResourceOk() {
            if (!GconfirmationActionType) {
                console.warn('No confirmation action type set');
                return;
            }

            // Added by Dipali V On 22nd Jun 2026 - Purpose: detect chained confirm opened during handler (e.g. mandatory attr → VALIDATION)
            var handledActionType = GconfirmationActionType;

            // Handle based on action type
            if (GconfirmationActionType === 'DELETE') {
                if (pendingDeleteCallback) {
                    pendingDeleteCallback();
                    pendingDeleteCallback = null;
                }
                if (pendingDeleteDocumentCallback) {
                    pendingDeleteDocumentCallback();
                    pendingDeleteDocumentCallback = null;
                }
            }
            else if (GconfirmationActionType === 'VOID') {
                if (pendingVoidTaskList && pendingVoidProjectID) {
                    performVoidTasks();
                }
            }
            else if (GconfirmationActionType === 'VALIDATION') {
                GconfirmationActionType = null;
                runAfterConfirmModalHidden(function () {
                    continueSaveTaskAfterValidation();
                    pendingSaveCallback = null;
                });
                return;
            } else if (GconfirmationActionType === 'PARENT_RESOURCE_UPDATE') {
                if (GPendingParentResourceUpdate && GParentResourceUpdateSoftQueue.length) {
                    var curItem = GParentResourceUpdateSoftQueue[GParentResourceUpdateSoftIndex];
                    if (curItem && curItem.key === 'TASK_DURATION') {
                        var p = GPendingParentResourceUpdate;
                        applyParentTaskDatesFromChildResources(p.startDate, p.endDate, true, p.childTaskID);
                    }
                    GParentResourceUpdateSoftIndex++;
                    GconfirmationActionType = null;
                    runAfterConfirmModalHidden(function () {
                        showNextParentResourceUpdateSoftConfirmation();
                    });
                }
                return;
            } else if (GconfirmationActionType === 'NEW_TASK_RESOURCE') {
                // Added by Dipali V on 22nd Jun 2026 for Task+ Resource saving
                if (GPendingNewTaskResource) {
                    var parentTaskID = parseInt($('#hidden_task_id_offcanvas').val());
                    proceedNewTaskResourceSave(parentTaskID, GPendingNewTaskResource);
                }
            } else if (GconfirmationActionType === 'NEW_TASK_RESOURCE_MULTI') {
                if (GPendingNewTaskResource) {
                    GNewTaskValidatedList.push(GPendingNewTaskResource);
                }
                GNewTaskSoftConfirmIndex++;
                GconfirmationActionType = null;
                runAfterConfirmModalHidden(function () {
                    showNextNewTaskSoftConfirmation();
                });
                return;
            } else if (GconfirmationActionType === 'NEW_TASK_NO_RESOURCE') {
                GSkipNoResourceConfirm = true;
                GconfirmationActionType = null;
                runAfterConfirmModalHidden(function () {
                    continueSaveTaskAfterValidation();
                });
                return;
            } else if (GconfirmationActionType === 'MANDATORY_TASK_ATTRIBUTE') {
                GSkipMandatoryAttributeConfirm = true;
                var flag = SelectedFlag;
                GconfirmationActionType = null;
                runAfterConfirmModalHidden(function () { SaveTaskDetails(flag); });
                return;
            } else if (GconfirmationActionType === 'RESOURCEVALIDATION') {
                var resourceCb = pendingSaveCallback;
                pendingSaveCallback = null;
                GconfirmationActionType = null;
                runAfterConfirmModalHidden(function () {
                    if (resourceCb) resourceCb();
                    else SaveResource();
                });
                return;
            }

            // Added by Dipali V On 22nd Jun 2026 - Purpose: keep modal/action for next confirm when SaveTaskDetails opened a chained notification
            if (GconfirmationActionType && GconfirmationActionType !== handledActionType) {
                return;
            }

            // Close modal and reset flag
            var confirmModal = bootstrap.Modal.getInstance(document.getElementById('confirmDeleteResourceModal'));
            if (confirmModal) {
                confirmModal.hide();
            }
            GconfirmationActionType =null;
        }


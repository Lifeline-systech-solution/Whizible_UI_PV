        // Modified by Dipali V on 25th Jun 2026 - Purpose: one alertify with numbered rows (1. 2. 3.) row by row
        function formatValidationAlertHtml(msg) {
            return String(msg || '')
                .replace(/\r\n/g, '\n')
                .replace(/<br\s*\/?>/gi, '\n')
                .replace(/(?:^|\n)(\d{1,2}\.\s)/g, '\n$1') // numbered rows only (not years like 2026.)
                .replace(/^\n+/, '')
                .replace(/\n{2,}/g, '\n')
                .replace(/\n/g, '<br/>');
        }

        function shouldExpandResourceSectionOnOpen() {
            return IsNewTask === 1 || IsCopyTask === 1 || GIsEditMode === true;
        }

        function expandResourceSectionOnOpen() {
            window._activeTaskDetailSection = 'resources';
            $('#menu_resources').parent().show();
            $('#DivResource').show();
            $('#resourceDetailsContent').collapse('show');
            $('.detailTabTitleDiv[data-bs-target="#resourceDetailsContent"]').attr('aria-expanded', 'true')
                .find('a[data-bs-toggle="collapse"]').attr('aria-expanded', 'true');
        }

        function collapseExtraTaskDetailSectionsForNewTask() {
            ['#taskAttributesContent', '#agileContent', '#customFieldsContent', '#documentsContent', '#baselineContent'].forEach(function (sel) {
                $(sel).collapse('hide');
                $('.detailTabTitleDiv[data-bs-target="' + sel + '"]').attr('aria-expanded', 'false')
                    .find('a[data-bs-toggle="collapse"]').attr('aria-expanded', 'false');
            });
            $('#taskNameNotesContent').collapse('show');
        }

        function shouldCollapseExtraSectionsOnOpen() {
            return IsNewTask === 1 || IsCopyTask === 1;
        }

        function applyTaskOffcanvasSectionStateOnOpen() {
            $('.task-detail-menu-item').removeClass('active');
            $('#menu_details').addClass('active');
            $('#prositedetailTab1').addClass('active show').css({ 'display': 'block', 'visibility': 'visible', 'opacity': '1' }).show();
            $('.task-detail-tab-content').not('#prositedetailTab1').removeClass('active show').hide();
            $('.nav-link').removeClass('active');
            $('#offcanvas_details_tab').addClass('active');
            if (GIsEditMode === true) {
                $('#taskAttributesContent,#agileContent,#customFieldsContent,#documentsContent,#baselineContent').collapse('hide');
                $('#agileContent').css('display', '');
                $('#documentsContent').css('display', '');
                $('#baselineContent').css('display', '');
                if (shouldExpandResourceSectionOnOpen()) {
                    expandResourceSectionOnOpen();
                    if (IsNewTask === 1) setResourceSectionSaveButtonsVisible(false);
                    else setResourceSectionSaveButtonsVisible($('#addResourceFormContainer').is(':visible'));
                } else {
                    $('#resourceDetailsContent').collapse('hide');
                    $('#resourceDetailsContent').css('display', '');
                    switchTaskDetailTab('details');
                }
                applyPageAccessControl();
                return;
            }
            if (shouldExpandResourceSectionOnOpen()) {
                if (shouldCollapseExtraSectionsOnOpen()) collapseExtraTaskDetailSectionsForNewTask();
                expandResourceSectionOnOpen();
                applyPageAccessControl();
                if (IsNewTask === 1) setResourceSectionSaveButtonsVisible(false);
                return;
            }
            var sectionToRestore = window._activeTaskDetailSection || 'details';
            switchTaskDetailTab(sectionToRestore);
            applyPageAccessControl();
            if (IsNewTask === 1) setResourceSectionSaveButtonsVisible(false);
        }

        function showValidationAlertifyError(messages) {
            var text = Array.isArray(messages)
                ? messages.map(function (m) { return String(m || '').replace(/<br\s*\/?>/gi, '\n'); }).join('\n')
                : String(messages || '');
            if (!text.trim()) return;
            alertify.set('notifier', 'position', 'top-right');
            alertify.error(formatValidationAlertHtml(text));
        }

        // Modified by Dipali V on 25th Jun 2026 - Purpose: defer only while modal visible; show next popup directly
        function runAfterConfirmModalHidden(callback) {
            var el = document.getElementById('confirmDeleteResourceModal');
            if (!el || !callback) return;
            var inst = bootstrap.Modal.getInstance(el);
            if (inst && el.classList.contains('show')) {
                $(el).one('hidden.bs.modal', callback);
                inst.hide();
            } else {
                callback();
            }
        }

        function showConfirmDeleteResourceModal(messageHtml) {
            var el = document.getElementById('confirmDeleteResourceModal');
            if (!el) return;
            $('#confirmDeleteResourceMessage').html(messageHtml || '');
            var inst = bootstrap.Modal.getInstance(el);
            (inst || new bootstrap.Modal(el)).show();
        }


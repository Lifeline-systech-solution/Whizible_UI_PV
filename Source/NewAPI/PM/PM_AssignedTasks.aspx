        // Added by Dipali V on 13th Jan 2026 - Validate and save each copied resource sequentially
        function validateNextCopiedResource() {
            // ✅ All resources processed
            if (GCopyResourceIndex >= GCopyResources.length) {
                alertify.success('Task Created successfully by adding ' + GCopyResources.length + ' resource(s) saved successfully');
                GCopyResources = [];
                GCopyResourceIndex = 0;
                setTimeout(function () {
                    loadParentTaskChildResources(getCurrentProjectID(), GCopyParentTaskID);
                }, 500);
                return;
            }

           

            // ✅ Pick CURRENT resource
            var resource = GCopyResources[GCopyResourceIndex];

            var EmployeeID = resource.EmployeeID;
            var WorkHours = resource.WorkHours;
            var objTxt = resource.objTxt;
            var StartDate = resource.StartDate;
            var EndDate = resource.EndDate;
            var TaskTypeID = resource.TaskTypeID;
            var SubTaskTypeID = resource.SubTaskTypeID;

            // ✅ VALIDATE
            var IsValid = ValidateResource(
                false,
                null,
                GCopyParentTaskID,   // newly created task
                EmployeeID,
                WorkHours,
                StartDate,
                EndDate,
                TaskTypeID,
                SubTaskTypeID,
                objTxt
            );

            // ❌ Stop if validation fails
            if (IsValid !== 1) {
                IsValid = 0;
                return;
            }

            // ✅ SAVE THE SAME RESOURCE (this was missing)
            SaveResourceDBLevel(
                false,                 // isUpdateMode
                null,     // childTaskID (new task)
                GCopyParentTaskID,                  // parentTaskID
                EmployeeID,            // resourceID
                WorkHours,             // effort
                StartDate,
                EndDate,
                TaskTypeID,
                SubTaskTypeID
            );

            // ✅ Move to next resource
            GCopyResourceIndex++;

            // ✅ Continue loop
            validateNextCopiedResource();
            
        }


        

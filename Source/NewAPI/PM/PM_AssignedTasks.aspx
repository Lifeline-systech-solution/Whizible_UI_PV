        // Function to load project task types - follows PM_BackupPlans.aspx pattern exactly
        // Added by Dipali V on 13th Jan 2026 - Modified to accept optional callback for setting task type value after dropdown is populated
        function loadProjectTaskTypes(projectID, callback) {
            if (!projectID) {
                clearTaskTypeDropdown();
                if (callback) callback();
                return;
            }

            var taskTypeParameter = {
                ProjectID: parseInt(projectID)
            };

            try {
                var result = AJAXCallWithResult('api/PM_AssignedTasks/GetProjectTaskType', JSON.stringify(taskTypeParameter), false);
                
                if (result) {
                    var taskTypeList = result.list;
                    populateTaskTypeDropdown(taskTypeList);

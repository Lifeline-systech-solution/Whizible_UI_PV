            }
            ensureResourceSelectPlaceholderOption($select);
            if ($.fn.selectpicker) {
                if ($select.data('selectpicker')) $select.selectpicker('destroy');
                $select.selectpicker({
                    liveSearch: true,
                    noneSelectedText: placeholderText,
                    size: 8 // Purpose: show scrollbar when many resources
                });
                $select.selectpicker('val', '');
            } else {
                $select.val('');
            }

        var SelectedFlag = 0;
        function SaveTaskDetails(flag) {
            
            if (flag == 0) {
                Setbaselineflag = "";
            }
            //;
            SelectedFlag = flag;
            var jsStartDate = $('#CRTstdateStartDate').datepicker('getDate');
            var jsEndDate = $('#CRTendateEndDate').datepicker('getDate');
            var StartDate = new Date(jsStartDate);
            var EndDate = new Date(jsEndDate);
            var hiddenTaskID = $('#hidden_task_id_offcanvas').val();
            //$('#hidden_task_id_offcanvas').val();
            var objCurrentWork = document.getElementById('input_work');
            var isworkFormatWrong = false;
            var isworkFormatnonnumeric = false;
            var isnottwodecimal = false;
            var isminutesnotbetween = false;
            if (objCurrentWork.value.indexOf(".") != -1) {
                setFocus(objCurrentWork);
                isworkFormatWrong = true;
            }
            var Work = objCurrentWork.value.replace(":", ".");
            var isdigit = isNumeric(Work);
            if (isdigit == false) {
                isworkFormatnonnumeric = true;
            }

            if ($("#input_work").val().indexOf('-') !== -1) {
                isworkFormatnonnumeric = true;
            }


            var precision = '';
            if (objCurrentWork.value.indexOf(":") != -1) {
                precision = objCurrentWork.value.split(":")[1];
            }

            if (precision.length > 2) {
                isnottwodecimal = true;
            }

            if (precision != "" && precision != undefined) {
                if (precision > 59 || precision < 0) {
                    isminutesnotbetween = true;
                }
            }

            var hrs, mins;
            var TaskName = $("#input_task_name").val();
            var Desc = $("#text_tasknotes").val();
            if ($('#input_work').val() != "") {
                var idxColon = $('#input_work').val().indexOf(':');

                hrs = $('#input_work').val().substring(0, idxColon);

                mins = $('#input_work').val().substring(idxColon + 1, $('#input_work').val().length);
            }

            if (checkSpecialCharacter(TaskName, WebConfigSpecialCharacters) == true) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("C_TaskNameContain") %>' + WebConfigSpecialCharacters + ' characters');
                $("#input_task_name").focus();
                return;
            }
            if (checkSpecialCharacter(Desc, WebConfigSpecialCharacters) == true) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("C_DescriptionContain") %>' + WebConfigSpecialCharacters + ' characters');
                $("#text_tasknotes").focus();
                return;
            }

            if (isBlank(Trim($("#input_task_name").val()))) {
                alertify.error('<%= MyBase.GetResourceString("C_Name_Mandatory_Text") %>');
                $("#input_task_name").focus();
                return;
            }

            else if (disallowSpecialCharacters(document.getElementById('input_task_name'))) {
                alertify.error('<%= MyBase.GetResourceString("C_Name_SpecialCharactorsNotAllowed") %>');
                $("#input_task_name").focus();
                return;
            }
            else if ($('#input_work').val().trim().length == 0) {
                alertify.error('<%= MyBase.GetResourceString("C_Work_Blank") %>');
                $('#input_work').focus();
                return;
            }
            else if (parseFloat($('#input_work').val()) == parseFloat(0) && mins == parseFloat(0)) {
                alertify.error('<%= MyBase.GetResourceString("C_Work_zero") %>');
                $('#input_work').focus();
                return;
            }

            else if (isworkFormatWrong) {
                alertify.error('Please enter Work in H:M format');
                $('#txtWorks').focus();
                return;
            }
            else if (isworkFormatnonnumeric) {
                alertify.error('<%= MyBase.GetResourceString("C_HHMMFormate") %>');
                $('#input_work').focus();
                return;
            }
            else if (isnottwodecimal) {
                alertify.error('<%= MyBase.GetResourceString("C_DECIMAL_60") %>');
                $('#input_work').focus();
                return;
            }
            else if (isminutesnotbetween) {
                alertify.error('<%= MyBase.GetResourceString("C_Minutes_0_59") %>');
                $('#input_work').focus();
                return;
            }


            else if ($('#CRTstdateStartDate').val().trim().length == 0) {
                alertify.error('<%= MyBase.GetResourceString("C_StartDate_Blank") %>');
                $('#CRTstdateStartDate').focus();
                return;
            }
            else if ($('#CRTendateEndDate').val().trim().length == 0) {
                alertify.error('<%= MyBase.GetResourceString("C_EndDate_Blank") %>');
                $('#CRTendateEndDate').focus();
                return;
            }

            else if (StartDate > EndDate) {
                $('#CRTendateEndDate').focus();
                alertify.error('<%= MyBase.GetResourceString("C_StartDate_Greater") %>');
                return;
            }


            // Added By Vyankat B. on 2 jun 2026 for child-only date and work hours validation on save
            if (GisParentTask === false) {
                var childStartDate = new Date(StartDate);
                var childEndDate = new Date(EndDate);
                var parentStartDate = new Date(GStartDate);
                var parentEndDate = new Date(GEndDate);

                childStartDate.setHours(0, 0, 0, 0);
                childEndDate.setHours(0, 0, 0, 0);
                parentStartDate.setHours(0, 0, 0, 0);
                parentEndDate.setHours(0, 0, 0, 0);

                if (childStartDate < parentStartDate) {
                    $('#CRTstdateStartDate').focus();
                    alertify.error('<%= MyBase.GetResourceString("A_AssignStartDate") %>');
                    return;
                }
                if (childEndDate > parentEndDate) {
                    $('#CRTendateEndDate').focus();
                    alertify.error('<%= MyBase.GetResourceString("A_AssignEndDate") %>');
                    return;
                }

                // Work hours alerts (child task vs parent / project LCE / sum of efforts)
                if (!validateChildTaskWorkHoursOnSave()) {
                    return;
                }
            }
            // End of Added By Vyankat B. on 2 jun 2026 for child-only date and work hours validation on save

            if (isBlank($("#select_task_type :selected").val()) || $("#select_task_type :selected").val() == 'Select Task Type' || $("#select_task_type :selected").val() == null || $("#select_task_type :selected").val() == "") {
                alertify.error('<%= MyBase.GetResourceString("C_TaskType_Blank") %>');
                $('#select_task_type').focus();
                return;
            }
            if (isBlank($("#select_priority :selected").val()) || $("#select_priority :selected").val() == 'Select Priority' || $("#select_priority :selected").val() == null) {
                alertify.error('<%= MyBase.GetResourceString("C_Priority_Blank") %>');
                $('#select_priority').focus();
                return;
            }

            // Added by Dipali V On 22nd Jun 2026 - Purpose: mandatory task attributes — soft Yes/No via confirmDeleteResourceModal (not hard alertify block)
            if (TaskAttributeDetails.length > 0 && !GSkipMandatoryAttributeConfirm) {
                var missingMandatoryAttrs = getMandatoryTaskAttributesMissing(TaskAttributeDetails);
                if (missingMandatoryAttrs.length > 0) {
                    GconfirmationActionType = 'MANDATORY_TASK_ATTRIBUTE';
                    showConfirmDeleteResourceModal(
                        'The following mandatory field(s) are not filled:' + missingMandatoryAttrs.join(', ') +
                        '<br/>Do you want to continue without updating details?'
                    );
                    return;
                }
            }
            GSkipMandatoryAttributeConfirm = false;

            if (IsAgileShow == 1 && ($("#input_user_story").val() == "" || $("#input_user_story").val() == "0" || $("#input_user_story").val() == null || $("#input_user_story").val() == undefined)) {
                alertify.error('<%= MyBase.GetResourceString("A_UserMandatory") %>');
                $('#input_user_story').focus();
                return;
            }

            if (IsAgileShow == 1) {
                if ($('#CRTstdateStartDate').val().trim() != '' && $('#CRTendateEndDate').val().trim() != '') {
                    //var result = AJAXCallWithAuthorizeResult('/api/PM_wbs_card/CheckIterationDates',
                    var result = AJAXCallWithResult('api/PM_AssignedTasks/CheckIterationDates',
                        JSON.stringify({
                            UserStoryID: $('#hidden_userstory_id').val(),
                            StartDate: $('#CRTstdateStartDate').val().trim(),
                            EndDate: $('#CRTendateEndDate').val().trim()
                        }), false);
                    //;
                    if (result.list[0] != undefined) {
                        if (result.list[0].data.data.msg != "") {
                            var strMsg = String(result.list[0].data.data.msg).split("_");
                            alertify.error(strMsg[1]);
                            return;
                        }
                    }
                }

                if ($('#input_work').val().trim() != '' && $('#input_work').val().trim() != '0') {
                    var result = AJAXCallWithResult('/api/PM_AssignedTasks/CheckIterationEfforts',
                        JSON.stringify({
                            UserStoryID: $('#hidden_userstory_id').val(),
                            WorkInHours: $('#input_work').val().trim(),
                            TaskID: hiddenTaskID
                        }), false);
                    //;
                    //alert(result);
                    if (result.list[0] != undefined) {
                        if (result.list[0].data.data.result != "") {
                            alertify.error(result.list[0].data.data.result);
                            return;
                        }
                    }
                }
                if ($("#input_user_story").val() != "") {
                    var n = $("#input_storypoint").val()
                    var result = (n - Math.floor(n)) !== 0;

                    if (result) {
                        alertify.error('<%= MyBase.GetResourceString("C_SPoints") %>');
                        $("#input_storypoint").focus();
                        return;
                    }

                    var Remaining = 0;
                    if ((parseInt($("#input_storypoint").val() - 0)) > (parseInt($("#hdnstorypoints").val() - 0))) {
                        Remaining = $("#hdnstorypoints").val();
                        alertify.error('<%= MyBase.GetResourceString("C_StoryPointExceed") %> ' + Remaining);
                        $('#input_storypoint').focus();
                        return;
                    }

                }
            }

            // Resource validation (for all projects) - Added by Dipali V on 26th Jan 2026
            var taskTypeID = $("#select_task_type").val();
            var subTaskTypeID = 0;
            var validationEmployeeID = GisParentTask === false
                ? (getChildTaskEmployeeID() || 0)
                : (parseInt($('#sel_resource').val()) || 0);
            var validationRequest = {
                TaskID: parseInt($('#hidden_task_id_offcanvas').val()) || 0,
                ParentTaskID: parseInt(GParentTaskID) || 0,
                ProjectID: parseInt(SessionProjectID),
                EmployeeID: validationEmployeeID,
                WorkHours: $('#input_work').val() || '0:00',
                TaskStartDate: $('#CRTstdateStartDate').val(),
                TaskEndDate: $('#CRTendateEndDate').val(),
                TaskTypeID: taskTypeID ? parseInt(taskTypeID) : null,
                SubTaskTypeID: subTaskTypeID ? parseInt(subTaskTypeID) : null,
                IsEditMode: GIsEditMode,
                ExistingResourceID: null,
                UserName: '<%= Session("strUserName") %>'
            };

            var validationResult = AJAXCallWithResult(
                'api/PM_AssignedTasks/ValidateAssignTask',
                JSON.stringify(validationRequest),
                false
            );
            if (!validationResult || !validationResult.list || !validationResult.list[0] || !validationResult.list[0].isValid) {
                var errorMsg = validationResult && validationResult.list && validationResult.list[0] && validationResult.list[0].errorMessage
                    ? validationResult.list[0].errorMessage
                    : '<%= MyBase.GetResourceString("M_ValidationFailedPleaseCheckInput") %>';
                //;
                // Added by Dipali V on 12th Jan 2026 - Show confirmation if message contains "Do you want to continue"
                if (errorMsg && isSpSoftResourceConfirmationOnly(validationResult.list[0].errorMessage || errorMsg)) {
                    GconfirmationActionType = 'VALIDATION';
                    pendingSaveCallback = function () {
                        continueSaveTaskAfterValidation();
                    };
                    showConfirmDeleteResourceModal(formatValidationAlertHtml(errorMsg));
                    return;
                }
                else {
                    alertify.set('notifier', 'position', 'top-right');
                    showValidationAlertifyError(errorMsg);
                    return;
                }
            }
            continueSaveTaskAfterValidation();
           
        }

        function populateTaskAssignmentEmail(taskID, messageID, TaskEmployeeId) {
          
            var SessionProjectID = '<%= Session("intProjectID") %>';
            if (!taskID || taskID <= 0) {
                alertify.error('Invalid Task ID');
                return;
            }

            // Default MessageID if not passed
            if (!messageID || messageID <= 0) {
                messageID = 0; // Task Assignment MessageID
            }

            var param = {
                MessageID: messageID,
                TaskID: taskID,
                ProjectID: SessionProjectID,
                LoggedUserID: EmployeeId,
                intEmployeeID: TaskEmployeeId
            };

            var response = AJAXCallWithResult(
                "/api/PM_AssignedTasks/GetEmailDetail",
                JSON.stringify(param),
                false
            );

            if (!response || response.list.length === 0) {
                alertify.error('Unable to load email template');
                // Purpose: skip failed template and continue bulk email queue
                if (GAfterNewTaskResourceSave && GNewTaskEmailEmployeeIds.length > 1 && GNewTaskEmailIndex < GNewTaskEmailEmployeeIds.length - 1) {
                    GNewTaskEmailIndex++;
                    setTimeout(function () { sendNextNewTaskAssignmentEmail(taskID); }, 100);
                    return;
                }
                if (GAfterNewTaskResourceSave) {
                    closeNewTaskAfterResourceSave(GAfterNewTaskResourceSave);
                }
                return;
            }
            var emailData = response.list[0];
            var emailSubject = emailData.subject || '';
            var emailBody = emailData.body || '';
            // Replace placeholders
            emailSubject = emailSubject.replace(/<PROJECT_NAME>/g, emailData.projectName || '');
            emailBody = emailBody.replace(/<NAME>/g, emailData.employeeName || '');
            emailBody = emailBody.replace(/<TASK_NAME>/g, emailData.taskName || '');
            emailBody = emailBody.replace(/<PROJECT_NAME>/g, emailData.projectName || '');
            emailBody = emailBody.replace(/<SENDER_NAME>/g, emailData.loggedEmployeeName || '');
            // Populate modal fields
            $('#sendTaskEmailFrom').val(emailData.fromLoggedEmailID || '');
            $('#sendTaskEmailTo').val(emailData.toEmailID || '');
            $('#sendTaskEmailCC').val(emailData.ccLoggedEmailID); // optional
            $('#sendTaskEmailSubject').val(emailSubject);
            $('#sendTaskEmailBody').val(emailBody);
            //;
            if (emailData.showPopup == 1) {
                new bootstrap.Modal(
                    document.getElementById('SendTaskEmailModal')
                ).show();
            }
            else {
                sendEmailConfirm();
            }
            
        }


        function sendEmailConfirm() {
            var toEmail = $('#sendTaskEmailTo').val().trim();
            var ccEmail = $('#sendTaskEmailCC').val().trim();
            var fromEmail = $('#sendTaskEmailFrom').val().trim();
            var subject = $('#sendTaskEmailSubject').val().trim();
            //;
            //var body = $('#sendLeaveEmailBody').val().trim();
            var rawText = $('#sendTaskEmailBody').val().trim();

            var body =
                "<html><body style='font-family: Arial, Helvetica, sans-serif; font-size:12px; color:#000;'>" +
                rawText
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/\n/g, "<br>") +
                "</body></html>";


            // Validation
            <%--if (!toEmail) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("A_ToMandatory") %>');
                $('#sendTaskEmailTo').focus();
                return;
            }

            if (!subject) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("A_SubjectMandatory") %>');
                $('#sendTaskEmailSubject').focus();
                return;
            }

            if (!body) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("A_BodyMandatory") %>');
                $('#sendTaskEmailBody').focus();
                return;
            }--%>

            // Prepare API request
            var emailRequestParam = {
                toEmailID: toEmail,
                ccEmailID: ccEmail || '',
                fromEmailID: fromEmail || '',
                subject: subject,
                body: body,
            };
     
            var emailParam = JSON.stringify(emailRequestParam);
            // Call SendMyLeavesEmail API
            var emailResponse = AJAXCallWithResult("/api/PM_AssignedTasks/SendTaskEmail", emailParam, false);
            // Check response
            if (emailResponse) {
                var isSuccess = false;
                var message = '';
               // ;
                // Check for status === true
                if (emailResponse.status === true || emailResponse.list[0].status === 'true') {
                    isSuccess = true;
                    message = emailResponse.list[0].message;
                } 

                if (isSuccess) {
                    var bulkEmailList = GNewTaskEmailEmployeeIds || [];
                    var hasMoreNewTaskEmails = GAfterNewTaskResourceSave && bulkEmailList.length > 1
                        && GNewTaskEmailIndex < bulkEmailList.length - 1;

                    // Purpose: one success alert after all resource emails are sent
                    if (!hasMoreNewTaskEmails) {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.success(message);
                    }

                    // Close modal
                    var sendEmailModal = bootstrap.Modal.getInstance(document.getElementById('SendTaskEmailModal'));
                    if (sendEmailModal) {
                        sendEmailModal.hide();
                    }

                    // Clear form
                    $('#sendTaskEmailTo').val('');
                    $('#sendTaskEmailCC').val('');
                    $('#sendTaskEmailSubject').val('');
                    $('#sendTaskEmailBody').val('');

                    // Added by Dipali V on 22nd Jun 2026 for Task+ Resource saving - complete new task flow after email sent
                    if (GAfterNewTaskResourceSave) {
                        if (hasMoreNewTaskEmails) {
                            GNewTaskEmailIndex++;
                            setTimeout(function () {
                                sendNextNewTaskAssignmentEmail(GAfterNewTaskResourceSave);
                            }, 100);
                            return;
                        }
                        var savedTaskID = GAfterNewTaskResourceSave;
                        GNewTaskEmailEmployeeIds = [];
                        GNewTaskEmailIndex = 0;
                        setTimeout(function () {
                            closeNewTaskAfterResourceSave(savedTaskID);
                        }, 100);
                        return;
                    }
                   
                    // Close offcanvas and reload data
                    var offcanvasElement = document.getElementById('offcanvas_new_assigntask');
                    var bsOffcanvas = bootstrap.Offcanvas.getInstance(offcanvasElement);
                    if (bsOffcanvas) {
                        bsOffcanvas.hide();
                    }

                    // Reload leaves list
                    //currentPageNumber = 1;
                    loadAssignedTasks(null, false, false, false);

                } else {
                    // Show error message

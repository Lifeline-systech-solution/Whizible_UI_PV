       function getInitials(name) {

    if (!name) return '';

    name = name.replace(/^\d+-/, '');       // remove employee code
    name = name.replace(/\(.*?\)/g, '').trim(); // remove brackets

    const parts = name.split(' ').filter(n => n);

    if (parts.length === 1)
        return parts[0][0].toUpperCase();

    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

        // Get consistent avatar color based on name hash
        function getAvatarColor(name) {
            if (!name) return '#ccc';
            var colors = ['#4bc5c6', '#f39c12', '#9b59b6', '#e74c3c', '#16a085', '#2980b9', '#8e44ad', '#c0392b'];
            var hash = 0;
            for (var i = 0; i < name.length; i++) { hash = name.charCodeAt(i) + ((hash << 5) - hash); }
            return colors[Math.abs(hash % colors.length)];
        }

        // Format date to "DD Mon YYYY" format (e.g., "01 Sep 2025" not "01 sept 2025")
        function formatDateForDisplay(dateStr) {
            if (!dateStr) return '-';
            try {
                // Added By Vyankat B. on 2 jun 2026 for timezone-safe ISO date display
                // Commented by Vyankat B. on 2 jun 2026 for direct Date parse causing one-day shift
                //var date = new Date(dateStr);
                var date;
                var isoMatch = String(dateStr).match(/^(\d{4})-(\d{2})-(\d{2})/);
                if (isoMatch) {
                    date = new Date(
                        parseInt(isoMatch[1], 10),
                        parseInt(isoMatch[2], 10) - 1,
                        parseInt(isoMatch[3], 10)
                    );
                } else {
                    date = new Date(dateStr);
                }
                // End of Commented by Vyankat B. on 2 jun 2026 for direct Date parse causing one-day shift
                // End of Added By Vyankat B. on 2 jun 2026 for timezone-safe ISO date display
                if (isNaN(date.getTime())) return dateStr;
                // Added By Dipali V On 23rd Jan 2026 For W26 - Ensure proper month abbreviation (Sep not sept)
                var monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                var day = String(date.getDate()).padStart(2, '0');
                var month = monthNames[date.getMonth()];
                var year = date.getFullYear();
                return day + ' ' + month + ' ' + year;
            } catch (e) { return dateStr; }
        }


            if (!EditAccess) {
                $('#btnAddResource').hide();
                $('#addResourceFormContainer .btn.btnyellow').hide();
                $('.edit-resource-btn').hide();
                // ... upload buttons, task attribute buttons ...
            } else {
                $('#btnAddResource').show();
                if (IsNewTask !== 1) {
                    $('#addResourceFormContainer .btn.btnyellow').show();
                } else {
                    $('#addResourceFormContainer .btn.btnyellow').hide();
                }
                $('.edit-resource-btn').show();
                // ...
            }

            // End of Commented and Added By Vyankat B. on 23 rd June 2026 for the Edit Access


            // --- DeleteAccess controls ---
            if (!DeleteAccess) {
                // Hide all document delete icons already in the DOM
                // Dynamically added rows handled in PlotDocumentList via DeleteAccess check
                $('.delete-document-btn').hide();

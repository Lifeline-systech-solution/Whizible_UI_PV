                            // Modified by Nikhil - Reload with current selected project after task update
                            // Always reloads with the selected project so updated data appears correctly
                            loadAssignedTasks(getCurrentProjectID(), false, false, true);
                            
                            if (SelectedFlag === 1) {

                                setTimeout(function () {
                                    if (Setbaselineflag == "") {
                                        // Added by Dipali V on 13th Jan 2026 - ClearTaskDetails already unchecks all checkboxes
                                        openAddNewTaskOffcanvas();
                                    }
                                    //else {
                                    //    handleTaskCreationSuccess(parseInt(taskIDResult));

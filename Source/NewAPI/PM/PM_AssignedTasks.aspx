        // Function to load data on-demand when user clicks link icon
        // Modified to load data only on click instead of page load
        // Added By Dipali V On 2nd Feb 2026 For W26 - Preserve filter value for current attribute type when Show button is clicked
        function GetOtherDetails(attributeType) {
            // Store current filter value before clearing
            var currentFilterValue = '';
            var currentFilterId = '';
            switch(attributeType) {
                case 'Deliveriable':
                case 'Deliverable':
                    currentFilterId = '#DeliverableType';
                    break;
                case 'Milestone':
                    currentFilterId = '#doc_milestone';
                    break;
                case 'Module':
                    currentFilterId = '#doc_Module';
                    break;
                case 'SubProject':
                    currentFilterId = '#doc_Sub-project';
                    break;
                case 'UserStory':
                    currentFilterId = '#doc_User_Story';
                    break;
                case 'Phase':
                    currentFilterId = '#doc_Phase';
                    break;
            }
            if (currentFilterId) {
                currentFilterValue = $(currentFilterId).val();
            }
            
            // Clear all filter textboxes
            $("#DeliverableType").val('');
            $("#doc_Module").val('');
            $("#doc_Feature").val('');
            $("#doc_Sub-project").val('');
            $("#doc_milestone").val('');
            $("#doc_User_Story").val('');
            $("#doc_Phase").val('');
            
            // Restore current filter value
            if (currentFilterId && currentFilterValue) {
                $(currentFilterId).val(currentFilterValue);
            }
            
            var currentProjectID = getCurrentProjectID();
            
            if (!currentProjectID) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_PleaseSelectProjectFirst") %>');
                return;
            }

            // Get task ID if available (for edit mode)
            var taskID = $('#hidden_task_id_offcanvas').val();
            var isAddMode = (!taskID || taskID === '' || taskID === 'null' || taskID === '0');
            taskID = isAddMode ? null : parseInt(taskID);

            // Added by Dipali V on 26th Jan 2026 - Update button text based on add/edit mode
            updateTaskAttributeButtonText(attributeType, isAddMode);

            // Load data based on attribute type
            switch(attributeType) {
                case 'Deliveriable':
                case 'Deliverable':
                    // Added By Dipali V On 2nd Feb 2026 For W26 - Load deliverables with filter value preserved
                    loadDeliverables(currentProjectID);
                    break;
                case 'Phase':
                    loadPhases(currentProjectID, taskID);
                    break;
                case 'Milestone':
                    loadMilestones(currentProjectID, taskID);
                    break;
                case 'Module':
                    loadModules(currentProjectID, taskID);
                    break;
                case 'SubProject':
                    loadSubProjects(currentProjectID, taskID);
                    break;
                //case 'Feature':
                //    loadFeatures(currentProjectID, taskID);
                //    break;
                //case 'ChangeRequest':
                    
                //    loadChangeRequests(currentProjectID, taskID);
                //    break;
                case 'EstimationType':
                    loadEstimationTypes(currentProjectID, taskID);
                    break;
                case 'UserStory':
                    loadUserStories(currentProjectID, taskID);
                    
                    break;
                    //loadUserStories(projectID, taskID);
                default:
                    console.warn('Unknown attribute type:', attributeType);
            }

            // Added by Dipali V on 26th Jan 2026 - Setup checkbox change handler to update textbox immediately
            setupTaskAttributeCheckboxHandler(attributeType);
            
            // Added by Auto - Manually open the attribute offcanvas without closing main edit offcanvas
            // Map attribute types to their offcanvas IDs
            var offcanvasMapping = {
                'Deliveriable': '#offcanvas_CRDTmodal',
                'Deliverable': '#offcanvas_CRDTmodal',
                'Phase': '#offcanvas_Phase_select',
                'Milestone': '#offcanvas_Milestone_select',
                'Module': '#offcanvas_Module_select',
                'SubProject': '#offcanvas_Sub_project_select',
                'ChangeRequest': '#offcanvas_Change_Request_select',
                'EstimationType': '#offcanvas_Estimation_Type_select',
                'UserStory': '#offcanvas_User_Story_select'
            };
            
            var offcanvasId = offcanvasMapping[attributeType];
            if (offcanvasId) {
                // Added By Dipali V - Prevent attribute offcanvas from opening for child tasks
                // Modified: Allow nested offcanvas for new tasks (when taskID is 0 or GIsEditMode is false)
                var taskID = parseInt($('#hidden_task_id_offcanvas').val() || 0);
                var isNewTask = taskID === 0 || GIsEditMode === false;
                if (GisParentTask === false && !isNewTask) {
                    return; // Block only for child tasks, not for new tasks
                }
                
                // Set flag to prevent main offcanvas from closing
                window.isOpeningAttributeOffcanvas = true;

                // Modified by Nikhil - Capture which accordion section is currently open so we can
                // restore it when shown.bs.offcanvas fires on the main offcanvas after re-opening.
                // Defaults to 'taskAttributes' since all attribute links live in that section.
                var sectionMap = {
                    '#taskNameNotesContent':   'details',
                    '#resourceDetailsContent': 'resources',
                    '#taskAttributesContent':  'taskAttributes',
                    '#agileContent':           'agile',
                    '#customFieldsContent':    'customFields',
                    '#documentsContent':       'documents',
                    '#baselineContent':        'baseline'
                };
                window._activeTaskDetailSection = 'taskAttributes'; // default for attribute offcanvases
                Object.keys(sectionMap).forEach(function(sel) {
                    if ($(sel).hasClass('show')) {
                        window._activeTaskDetailSection = sectionMap[sel];
                    }
                });
                
                // Use setTimeout to ensure data is loaded before opening offcanvas
                setTimeout(function() {
                    var offcanvasElement = document.querySelector(offcanvasId);
                    if (offcanvasElement) {
                        try {
                            // Ensure main edit offcanvas stays open if it's already open
                            var mainOffcanvas = document.getElementById('offcanvas_new_assigntask');
                            var isMainOffcanvasOpen = mainOffcanvas && (mainOffcanvas.classList.contains('show') || mainOffcanvas.classList.contains('showing'));
                            
                            // Open attribute offcanvas using Bootstrap API
                            if (typeof bootstrap !== 'undefined' && bootstrap.Offcanvas) {
                                var attributeOffcanvas = bootstrap.Offcanvas.getOrCreateInstance(offcanvasElement);
                                attributeOffcanvas.show();
                                
                                // Reset flag after opening — delay long enough for shown.bs.offcanvas
                                // to fire on the main offcanvas while the flag is still true.
                                // Modified by Nikhil
                                setTimeout(function() {
                                    window.isOpeningAttributeOffcanvas = false;
                                    
                                    // If main offcanvas was open but got closed, re-open it
                                    if (isMainOffcanvasOpen) {
                                        if (mainOffcanvas && !mainOffcanvas.classList.contains('show') && !mainOffcanvas.classList.contains('showing')) {
                                            // Signal to shown.bs.offcanvas that this is a restore,
                                            // NOT a fresh open — so it should NOT collapse all sections
                                            window._isSubOffcanvasRestore = true;
                                            var mainOffcanvasInstance = bootstrap.Offcanvas.getOrCreateInstance(mainOffcanvas);
                                            mainOffcanvasInstance.show();
                                        }
                                    }
                                }, 500);
                            }
                        } catch (error) {
                            console.error('Error opening attribute offcanvas:', error);
                            window.isOpeningAttributeOffcanvas = false;
                        }
                    } else {
                        window.isOpeningAttributeOffcanvas = false;
                    }
                }, 100);
            }
        }


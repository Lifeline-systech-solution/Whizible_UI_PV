        // ── Page loader — counter-based, same as PM_BulkResourceReq.aspx ─────────
        // Added by Nikhil - Counter-based loader so overlapping AJAX calls don't hide prematurely.
        //   showLoader() increments counter; hideLoader() decrements and hides only when counter = 0.
        //   500ms minimum display so fast responses still show the loader briefly.
        var loaderShown    = false;
        var loaderStartTime = 0;
        var _loaderCount   = 0; /* counter — supports overlapping AJAX calls */

        function showLoader() {
            _loaderCount++;
            if (_loaderCount === 1) {
                document.getElementById('pageLoader').style.display = 'block';
                loaderShown    = true;
                loaderStartTime = Date.now();
            }
        }

        function hideLoader() {
            _loaderCount = Math.max(0, _loaderCount - 1);
            if (_loaderCount > 0) return; /* other calls still in flight */
            if (!loaderShown) return;
            var elapsedTime    = Date.now() - loaderStartTime;
            var minDisplayTime = 500; /* 0.5 s minimum so loader is visible */
            if (elapsedTime < minDisplayTime) {
                setTimeout(function () {
                    document.getElementById('pageLoader').style.display = 'none';
                    loaderShown = false;
                }, minDisplayTime - elapsedTime);
            } else {
                document.getElementById('pageLoader').style.display = 'none';
                loaderShown = false;
            }
        }

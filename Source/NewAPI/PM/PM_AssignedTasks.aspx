        function calculatePeriodDates(period) {
            var today = new Date();
            var fromDate, toDate;
            var year = today.getFullYear();
            var month = today.getMonth(); // 0-11 (Jan = 0, Dec = 11)

            // Format date as DD/MM/YYYY
            //var formatDate = function (date) {
            //    var day = String(date.getDate()).padStart(2, '0');
            //    var month = String(date.getMonth() + 1).padStart(2, '0');
            //    var year = date.getFullYear();
            //    return day + '/' + month + '/' + year;
            //};
            // Added by DipalI v On 3rd sep 2026 - Purpose: format period dates as dd MMM YYYY to match From/To datepicker format
            var formatDate = function (date) {
                var monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                var day = String(date.getDate()).padStart(2, '0');
                var month = monthNames[date.getMonth()];
                var year = date.getFullYear();
                return day + ' ' + month + ' ' + year;
            };

            switch (period) {
                case 'current_fy':
                    // Current Financial Year (April to March)
                    if (month >= 3) { // April (3) to December (11)
                        fromDate = new Date(year, 3, 1); // April 1
                        toDate = new Date(year + 1, 2, 31); // March 31 next year
                    } else { // January (0) to March (2)
                        fromDate = new Date(year - 1, 3, 1); // April 1 previous year
                        toDate = new Date(year, 2, 31); // March 31 current year
                    }
                    break;

                case 'previous_fy':
                    // Previous Financial Year
                    if (month >= 3) {
                        fromDate = new Date(year - 1, 3, 1);
                        toDate = new Date(year, 2, 31);
                    } else {
                        fromDate = new Date(year - 2, 3, 1);
                        toDate = new Date(year - 1, 2, 31);
                    }
                    break;

                case 'next_fy':
                    // Next Financial Year
                    if (month >= 3) {
                        fromDate = new Date(year + 1, 3, 1);
                        toDate = new Date(year + 2, 2, 31);
                    } else {
                        fromDate = new Date(year, 3, 1);
                        toDate = new Date(year + 1, 2, 31);
                    }
                    break;

                case 'current_month':
                    fromDate = new Date(year, month, 1);
                    toDate = new Date(year, month + 1, 0); // Last day of current month
                    break;

                case 'next_month':
                    fromDate = new Date(year, month + 1, 1);
                    toDate = new Date(year, month + 2, 0); // Last day of next month
                    break;

                case 'previous_month':
                    fromDate = new Date(year, month - 1, 1);
                    toDate = new Date(year, month, 0); // Last day of previous month
                    break;

                case 'current_quarter':
                    var quarter = Math.floor(month / 3);
                    fromDate = new Date(year, quarter * 3, 1);
                    toDate = new Date(year, (quarter + 1) * 3, 0);
                    break;

                case 'previous_quarter':
                    var quarter = Math.floor(month / 3);
                    if (quarter === 0) {
                        fromDate = new Date(year - 1, 9, 1); // Oct 1 previous year
                        toDate = new Date(year - 1, 11, 31); // Dec 31 previous year
                    } else {
                        fromDate = new Date(year, (quarter - 1) * 3, 1);
                        toDate = new Date(year, quarter * 3, 0);
                    }
                    break;

                case 'next_quarter':
                    var quarter = Math.floor(month / 3);
                    if (quarter === 3) {
                        fromDate = new Date(year + 1, 0, 1); // Jan 1 next year
                        toDate = new Date(year + 1, 2, 31); // Mar 31 next year
                    } else {
                        fromDate = new Date(year, (quarter + 1) * 3, 1);
                        toDate = new Date(year, (quarter + 2) * 3, 0);
                    }
                    break;

                case 'current_year':
                    fromDate = new Date(year, 0, 1); // Jan 1
                    toDate = new Date(year, 11, 31); // Dec 31
                    break;

                case 'previous_year':
                    fromDate = new Date(year - 1, 0, 1);
                    toDate = new Date(year - 1, 11, 31);
                    break;

                case 'next_year':
                    fromDate = new Date(year + 1, 0, 1);
                    toDate = new Date(year + 1, 11, 31);
                    break;

                default:
                    return null;
            }

            return {
                fromDate: formatDate(fromDate),
                toDate: formatDate(toDate)
            };
        }


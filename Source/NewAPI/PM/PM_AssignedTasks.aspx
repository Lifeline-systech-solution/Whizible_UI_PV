        function performSearch(query) {
            if (query === '') {
                // Show all rows
                $('#AsignTskTbl tbody tr').show();
                $('#searchResultsInfo').removeClass('show').text('');
                updatePagination();
                return;
            }

            var matchCount = 0;
            var totalCount = 0;

            // Search in table view
            $('#AsignTskTbl tbody tr').each(function () {
                totalCount++;
                var $row = $(this);
                var rowText = $row.text().toLowerCase();

                if (rowText.indexOf(query) !== -1) {
                    $row.show();
                    matchCount++;
                } else {
                    $row.hide();
                }
            });

            // Update results info
            if (query !== '') {
                $('#searchResultsInfo').addClass('show').text('Showing ' + matchCount + ' of ' + totalCount + ' tasks');
            } else {
                $('#searchResultsInfo').removeClass('show');
            }
        }


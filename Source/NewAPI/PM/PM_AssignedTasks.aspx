        // Initialize tooltips function
        // Modified by Dipali V on 31st Dec 2025 - Added delay and improved tooltip configuration for better display
        function initializeTooltips() {
            // Small delay to ensure DOM is fully rendered
            setTimeout(function() {
                $('[data-bs-toggle="tooltip"]').each(function () {
                    // Destroy existing tooltip if any
                    var existingTooltip = bootstrap.Tooltip.getInstance(this);
                    if (existingTooltip) {
                        existingTooltip.dispose();
                    }
                    // Check if this is a clickable sortable element
                    var isSortable = $(this).hasClass('status-filter-icon') ||
                        $(this).hasClass('priority-filter-icon') ||
                        $(this).hasClass('assignee-filter-icon');

                    // Check if HTML content is enabled
                    var allowHtml = $(this).attr('data-html') === 'true' || $(this).attr('data-html') === true;

                    // Get the title from different possible attributes
                    var tooltipTitle = $(this).attr('title') || $(this).attr('data-bs-original-title') || $(this).attr('aria-label') || '';

                    // Initialize new tooltip with hover only (not click)
                    var tooltipOptions = {
                        trigger: 'hover focus',
                        container: 'body',
                        placement: $(this).attr('data-bs-placement') || 'top',
                        fallbackPlacements: ['top', 'bottom', 'right', 'left'],
                        boundary: 'window',
                        title: tooltipTitle
                    };

                    // Enable HTML content if data-html="true" is set
                    if (allowHtml) {
                        tooltipOptions.html = true;
                    }

                    try {
                        new bootstrap.Tooltip(this, tooltipOptions);
                    } catch (e) {
                        console.log('Tooltip init error:', e);
                    }

                    // For sortable elements, explicitly prevent click from showing tooltip
                    if (isSortable) {
                        $(this).on('click', function (e) {
                            var tooltip = bootstrap.Tooltip.getInstance(this);
                            if (tooltip) {
                                tooltip.hide();
                            }
                            $('.tooltip').remove();
                        });
                    }
                });
            }, 100);
        }

        // Added by Dipali V on 26th Jan 2026 - Initialize popovers for resource links
        function initializePopovers() {
            setTimeout(function() {
                $('[data-bs-toggle="popover"]').each(function() {

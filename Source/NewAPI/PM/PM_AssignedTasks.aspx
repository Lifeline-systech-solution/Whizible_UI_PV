                EmployeeID: parseInt(EmployeeID)
            };

            try {
                //;
                var result = AJAXCallWithResult(
                    'api/PM_AssignedTasks/GetAssignedTaskResources',
                    JSON.stringify(requestParam),
                    false
                );

                //var resourceList = extractAssignedTaskResourceList(result);
                bindAssignedTaskResources(result.list[0].data.data.data);
 

            } catch (ex) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('Error loading assigned task resources');
                console.error(ex);
                //clearAssignedTaskResourcesTable();
            }

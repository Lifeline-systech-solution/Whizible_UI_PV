        // Added by Dipali V on 13th Jan 2026 - Main copy task function
        function CopyTask(taskID, fromWhere) {
            IsCopyTask = 1;
            IsNewTask = 0;
            restoreNewTaskResourceEditUI();
            if (!taskID || taskID === 'null' || taskID === '' || isNaN(taskID)) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_InvalidTaskID") %>');
                return;
            }
            
            // Find task to copy
            var taskToCopy = findTaskByID(parseInt(taskID));
            if (!taskToCopy) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('Task not found. Please refresh the page and try again.');
                return;
            }
            
            GCopyTaskData = taskToCopy;
            GCopyFromWhere = fromWhere || '';
           
            //;
            // If copying parent task, check for child tasks
            if (fromWhere === 'ParentListView') {
                var childTaskResources = getTaskProp(taskToCopy, 'ChildTaskResources', '') || getTaskProp(taskToCopy, 'childTaskResources', '') || '';
                var hasChildTasks = childTaskResources && childTaskResources.trim() !== '';
                
                if (hasChildTasks) {
                    // Show confirmation modal
                    copyWithChildTasks = true;
                    GconfirmationActionType = 'COPYCHILDFROMPARENT';
                    $('#confirmCopy').text('<%= MyBase.GetResourceString("C_ParentCopyYES") %>');
                    new bootstrap.Modal(document.getElementById('confirmCopyModal')).show();
                    return;
                }
                else {
                    copyWithChildTasks = false;
                    // Show confirmation modal
                    GconfirmationActionType = 'COPYPARENT';
                    $('#confirmCopy').text('<%= MyBase.GetResourceString("C_ParentwithNo") %>');
                    new bootstrap.Modal(document.getElementById('confirmCopyModal')).show();
                    return;
                }
            } else if (fromWhere === 'ChildListView') {
                        // Show confirmation modal
                        copyWithChildTasks = true;
                        GconfirmationActionType = 'COPYCHILD';
                        $('#confirmCopy').text('<%= MyBase.GetResourceString("C_ChildCopyWithYes") %>');
                        new bootstrap.Modal(document.getElementById('confirmCopyModal')).show();
                        return;
                    //}
                    
                }
            
            // No child tasks or copying child task - proceed with copy
            performCopyTask(copyWithChildTasks,0);
        }
        
        // Added by Dipali V on 13th Jan 2026 - Perform the actual copy operation
        function performCopyTask(copyWithChildTasks, flag) {
            if (!GCopyTaskData) return;
            
            GCopyWithChildTasks = copyWithChildTasks;
            
            // Store copy flags for save logic
            window.GCopyWithChildTasks = copyWithChildTasks;
            window.GCopyFlag = flag;
            window.GCopyFromWhere = GCopyFromWhere;
            
            // Added by Dipali V on 13th Jan 2026 - Set copy mode flag for save logic
            IsCopyTask = 1;
            IsNewTask = 0;
            restoreNewTaskResourceEditUI();
            // Clear temporary resource storage
            GCopyTaskResources = [];
            
            // Open offcanvas in add mode
            $('#offcanvas_title').text('Copy Task');
            $('#hidden_task_id_offcanvas').val(0);
            GParentTaskID = 0;
            GIsEditMode = false;
            GisParentTask = (GCopyFromWhere === 'ParentListView');
            
            // Populate form with copied data
            populateFormForCopy(GCopyTaskData, copyWithChildTasks, flag);
            
            // Open offcanvas
            var offcanvasElement = document.getElementById('offcanvas_new_assigntask');
            if (offcanvasElement) {
                var offcanvas = bootstrap.Offcanvas.getOrCreateInstance(offcanvasElement);
                offcanvas.show();
                $('body').addClass('offcanvas-open');

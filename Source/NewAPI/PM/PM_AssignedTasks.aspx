                    if (callback) {
                        setTimeout(callback, 150);
                    }
                } else {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('<%= MyBase.GetResourceString("M_ErrorLoadingProjectTaskTypes") %>');
                    clearTaskTypeDropdown();
                    if (callback) callback();
                }
            } catch (error) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_ErrorLoadingProjectTaskTypesMessage") %>' + error.message);
                clearTaskTypeDropdown();
                if (callback) callback();
            }
        }

        // Function to populate task type dropdown with TaskTypeModel data
        function populateTaskTypeDropdown(taskTypeList) {
            if (!taskTypeList || !Array.isArray(taskTypeList) || taskTypeList.length === 0) {
                clearTaskTypeDropdown();
                return;
            }

            // Get all task type dropdown selectors
            var taskTypeDropdowns = ['#select_task_type'];
            
            // Populate each task type dropdown
            taskTypeDropdowns.forEach(function(selector) {
                var $dropdown = $(selector);
                if ($dropdown.length > 0) {
                    // Clear existing options except the first one
                    $dropdown.find('option:not(:first)').remove();
                    
                    // Add task type options
                    taskTypeList.forEach(function(taskType) {
                        // Handle both uppercase and lowercase property names
                        var taskTypeID = taskType.TaskTypeID || taskType.taskTypeID || '';
                        var taskTypeName = taskType.TaskType || taskType.taskType || '';
                        var taskTypeDescription = taskType.TaskTypeDescription || taskType.taskTypeDescription || '';
                        
                        // Use TaskType as display name, append description if available
                        var displayName = taskTypeName || 'Unknown';
                        if (taskTypeDescription) {
                            displayName += ' - ' + taskTypeDescription;
                        }
                        
                        // Create option with task type ID as value and display name as text
                        var option = $('<option></option>')
                            .attr('value', taskTypeID)
                            .text(escapeHtml(displayName));
                        
                        $dropdown.append(option);
                    });
                    
                    // Refresh selectpicker if it exists
                    if (typeof $.fn.selectpicker !== 'undefined' && $dropdown.hasClass('selectpicker')) {
                        $dropdown.selectpicker('refresh');
                    }
                }
            });
        }

        // Function to clear task type dropdowns
        function clearTaskTypeDropdown() {
            var taskTypeDropdowns = ['#select_task_type'];
            
            taskTypeDropdowns.forEach(function(selector) {
                var $dropdown = $(selector);
                if ($dropdown.length > 0) {
                    // Clear existing options except the first one
                    $dropdown.find('option:not(:first)').remove();
                    
                    // Reset to first option
                    $dropdown.val($dropdown.find('option:first').val());
                    
                    // Refresh selectpicker if it exists
                    if (typeof $.fn.selectpicker !== 'undefined' && $dropdown.hasClass('selectpicker')) {
                        $dropdown.selectpicker('refresh');
                    }
                }
            });
        }


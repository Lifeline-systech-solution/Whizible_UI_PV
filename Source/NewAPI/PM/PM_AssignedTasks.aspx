            offcanvasPagination.module.currentPage = 1;
            offcanvasPagination.module.selectedValue = null;
            $('#modulePaginationContainer').css('display', 'none');
        });
        $('#offcanvas_Sub_project_select').on('hidden.bs.offcanvas', function() {
            offcanvasPagination.subproject.currentPage = 1;
            offcanvasPagination.subproject.selectedValue = null;
            $('#subprojectPaginationContainer').css('display', 'none');
        });
        $('#offcanvas_User_Story_select').on('hidden.bs.offcanvas', function() {
            offcanvasPagination.userstory.currentPage = 1;

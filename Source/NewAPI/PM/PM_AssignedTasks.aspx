        // Added by Dipali V on 13th Jan 2026 - Save copied task resources after task is created
        function collectCopyTaskResourcesFromTable() {
            GNewTaskResources = [];
            var seen = {};
            var taskTypeID = getIntValueOrNull('#select_task_type');
            var subTaskTypeID = getTaskProp(SelectedTaskDetails, 'SubTaskTypes', '') || getTaskProp(SelectedTaskDetails, 'subTaskTypes', '');
            function pushCopyResource(empID, effort, startDate, endDate, empName) {
                var rowKey = getNewTaskResourceRowKey(empID, effort, startDate, endDate);
                if (!empID || !effort || !startDate || !endDate || seen[rowKey]) return;
                if (effort === '00:00' || effort === '0:00') return;
                seen[rowKey] = true;
                GNewTaskResources.push({
                    employeeID: empID,
                    employeeName: empName || '',
                    workHours: effort,
                    startDate: startDate,
                    endDate: endDate,
                    taskTypeID: taskTypeID,
                    subTaskTypeID: subTaskTypeID ? parseInt(subTaskTypeID, 10) : null
                });
            }
            if (GCopyFromWhere === 'ChildListView' && GCopyTaskResources && GCopyTaskResources.length) {
                GCopyTaskResources.forEach(function (resource) {
                    if (!resource.EmployeeID || !resource.StartDate || !resource.EndDate || !resource.WorkHours) return;
                    pushCopyResource(
                        parseInt(resource.EmployeeID, 10),
                        resource.WorkHours,
                        formatDateForAPI(resource.StartDate) || resource.StartDate,
                        formatDateForAPI(resource.EndDate) || resource.EndDate,
                        ''
                    );
                });
                return GNewTaskResources;
            }
            $('#parentTaskResourceTable tbody tr[data-employeeid]').each(function () {
                var $row = $(this);
                if ($row.hasClass('resource-edit-mode') || $row.find('td').length < 5) return;
                var employeeID = parseInt($row.data('employeeid'), 10);
                var startDate = $row.find('.resource-start-date').text().trim();
                var endDate = $row.find('.resource-end-date').text().trim();
                var work = $row.find('.resource-work').text().trim();
                if (!employeeID || !startDate || !endDate || !work) return;
                pushCopyResource(
                    employeeID, work,
                    formatDateForAPI(startDate) || startDate,
                    formatDateForAPI(endDate) || endDate,
                    $row.find('.resource-name').text().trim()
                );
            });
            return GNewTaskResources;
        }


                            ValidationMessage = [];
                            ValidationValidateID = [];
                            ValidationValidateExtID = [];
                        }
                    }
                } else {
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('<%= MyBase.GetResourceString("M_TaskSavedButTaskIDNotReturned") %>');
                }
            }
            else {
                var errorMsg =
                    saveResult &&
                        saveResult.data &&
                        saveResult.data.message
                        ? saveResult.data.message
                        : saveResult && saveResult.message
                        ? saveResult.message
                        : 'Failed to save task. Please try again.';

                alertify.set('notifier', 'position', 'top-right');
                alertify.error(errorMsg);
            }

        }
        

        const ATTRIBUTE_FIELD_MAP = {
            Phase: '#input_phase',
            Module: '#input_module',
            Milestone: '#input_milestone',
            Deliverable: '#input_deliverable',
            "Sub Project": '#input_subproject',

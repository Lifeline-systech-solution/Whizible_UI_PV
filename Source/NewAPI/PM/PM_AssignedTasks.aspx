        // Raw-HTML pager: data array contains outerHTML strings of <tr> elements.
        // Uses state.selectedValue as single source of truth for checked state.
        function renderOffcanvasPageRaw(key, $tbody, containerId, totalId, prevBtnId, nextBtnId) {
            var state = offcanvasPagination[key];
            var totalRecords = state.data.length;
            if (totalRecords === 0) { $('#' + containerId).css('display', 'none'); return; }

            var totalPages = Math.ceil(totalRecords / state.pageSize) || 1;
            if (state.currentPage > totalPages) state.currentPage = totalPages;
            if (state.currentPage < 1) state.currentPage = 1;

            var start = (state.currentPage - 1) * state.pageSize;
            var end   = Math.min(start + state.pageSize, totalRecords);

            $tbody.empty();
            var selVal = state.selectedValue ? String(state.selectedValue) : null;
            for (var i = start; i < end; i++) {
                var html = state.data[i];
                // Strip all checked attrs first, then re-apply only for the selected value
                html = html.replace(/(<input[^>]*type="checkbox"[^>]*)\schecked(?=[\s>\/])/gi, '$1')
                           .replace(/(<input[^>]*)\schecked([\s>\/][^>]*type="checkbox")/gi, '$1$2');
                if (selVal) {
                    var valPat = new RegExp('(value="' + selVal.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '"[^>]*?>|value="' + selVal.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '"\\s)', 'i');
                    if (valPat.test(html)) {
                        // Add checked just before the closing > of the input tag that has this value
                        html = html.replace(
                            new RegExp('(value="' + selVal.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '")', 'i'),
                            '$1 checked'
                        );
                    }
                }
                $tbody.append(html);
            }

            $('#' + totalId).text('Total Records: ' + totalRecords + '  |  Page ' + state.currentPage + ' of ' + totalPages);
            $('#' + prevBtnId).prop('disabled', state.currentPage <= 1).css('opacity', state.currentPage <= 1 ? '0.4' : '1');
            $('#' + nextBtnId).prop('disabled', state.currentPage >= totalPages).css('opacity', state.currentPage >= totalPages ? '0.4' : '1');
            $('#' + containerId).css('display', 'flex');
        }


        // Function to load project resources - follows PM_BackupPlans.aspx pattern exactly
        // Added by Dipali V on 13th Jan 2026 - Added optional callback parameter for setting values after resources are loaded
        function loadProjectResources(projectID, parentTaskID, allowDeferredTaskCreation, callback, dropdownTargetsOverride) {
            if (!projectID) {
                // Clear resource dropdowns if no project selected
                clearResourceDropdowns();
                if (callback && typeof callback === 'function') {
                    callback();
                }
                return;
            }

            // Added by DipalI v On 2nd sep 2026 - Purpose: task-scoped resource load (edit/add resource) must not overwrite search filter dropdown #sel_resource
            //var targetResourceDropdowns = ['#sel_resource', '#select_resource'];
            var targetResourceDropdowns = dropdownTargetsOverride || (parentTaskID
                ? ['#select_resource']
                : ['#sel_resource', '#select_resource']);

            // Prepare API request parameters following GetProjectResourceRequest model
            var resourceParameter = {
                ProjectID: parseInt(projectID),
                ParrentTaskID: parentTaskID ? parseInt(parentTaskID) : null,
                AllowDefferedTaskCreation: allowDeferredTaskCreation ? parseInt(allowDeferredTaskCreation) : null
            };

            try {
                var result = AJAXCallWithResult('api/PM_AssignedTasks/GetProjectResource', JSON.stringify(resourceParameter), false);
                
                if (result) {
                    // Handle response structure following PM_BackupPlans.aspx pattern
                    // Response format: { data: { message: "Project Resources", data: resourceList } }
                    var resourceList = null;
                    //;
                    resourceList = result.list; // Modified to directly assign result to resourceList
                   
                    
                    // Populate resource dropdowns with returned data, pass callback
                    //populateResourceDropdowns(resourceList, callback);
                    populateResourceDropdowns(resourceList, callback, targetResourceDropdowns);
                } else {
                    // Handle case where result is null or undefined (AJAX error)
                    alertify.set('notifier', 'position', 'top-right');
                    alertify.error('<%= MyBase.GetResourceString("M_ErrorLoadingProjectResources") %>');
                    //clearResourceDropdowns();
                    clearResourceDropdowns(targetResourceDropdowns);
                    if (callback && typeof callback === 'function') {
                        callback();
                    }
                }
            } catch (error) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_ErrorLoadingProjectResources") %>: ' + error.message);
                //clearResourceDropdowns();
                clearResourceDropdowns(targetResourceDropdowns);
                if (callback && typeof callback === 'function') {
                    callback();
                }
            }
        }

        // Function to populate resource dropdowns with TeamMemberModel data
        // Added by Dipali V on 13th Jan 2026 - Added optional callback parameter for setting values after population
        function populateResourceDropdowns(resourceList, callback, targetDropdowns) {
            //var resourceDropdowns = ['#sel_resource', '#select_resource'];
            var resourceDropdowns = targetDropdowns || ['#sel_resource', '#select_resource'];

            if (!resourceList || !Array.isArray(resourceList) || resourceList.length === 0) {
                //clearResourceDropdowns();
                clearResourceDropdowns(resourceDropdowns);
                if (callback && typeof callback === 'function') {
                    callback();
                }
                return;
            }

            // Added by DipalI v On 2nd sep 2026 - Purpose: preserve applied resource filter before dropdown repopulate (edit task reloads resources and was clearing filter)
            var savedFilterResourceID = null;
            if (resourceDropdowns.indexOf('#sel_resource') !== -1) {
                savedFilterResourceID = $('#sel_resource').val() || initialFilterState.resource;
            }
            
            // Populate each resource dropdown
            resourceDropdowns.forEach(function(selector) {
                var $dropdown = $(selector);
                if ($dropdown.length > 0) {
                    // Clear existing options except the first one
                    $dropdown.find('option:not(:first)').remove();
                    
                    // Add resource options
                    resourceList.forEach(function(resource) {
                        // Handle both uppercase and lowercase property names
                        var employeeID = resource.EmployeeID || resource.employeeID || '';
                        var employeeName = resource.EmployeeName || resource.employeeName || '';
                        var userName = resource.UserName || resource.userName || '';
                        var roleName = resource.RoleName || resource.roleName || '';
                        
                        // Use EmployeeName if available, otherwise use UserName
                        var displayName = employeeName || userName || 'Unknown';
                        
                        // Add role name if available
                        if (roleName) {
                            displayName += ' (' + roleName + ')';
                        }
                        
                        // Create option with employee ID as value and display name as text
                        var option = $('<option></option>')
                            .attr('value', employeeID)
                            .text(escapeHtml(displayName));
                        
                        $dropdown.append(option);
                    });
                    
                    // Refresh selectpicker if it exists
                    if (typeof $.fn.selectpicker !== 'undefined' && $dropdown.hasClass('selectpicker')) {
                        $dropdown.selectpicker('refresh');
                    }

                    // Added by DipalI v On 2nd sep 2026 - Purpose: restore resource filter in search dropdown after repopulate so chip and dropdown stay in sync
                    if (selector === '#sel_resource' && savedFilterResourceID && savedFilterResourceID !== '' && savedFilterResourceID !== '0') {
                        if ($dropdown.find('option[value="' + savedFilterResourceID + '"]').length > 0) {
                            $dropdown.val(savedFilterResourceID);
                            if (typeof $.fn.selectpicker !== 'undefined' && $dropdown.hasClass('selectpicker')) {
                                $dropdown.selectpicker('refresh');
                            }
                        }
                    }
                }
            });
            
            // Execute callback after dropdowns are populated (if provided)
            if (callback && typeof callback === 'function') {
                // Small delay to ensure selectpicker refresh is complete
                setTimeout(function() {
                    callback();
                }, 100);
            }
        }

        // Function to clear resource dropdowns
        function clearResourceDropdowns(targetDropdowns) {
            //var resourceDropdowns = ['#sel_resource', '#select_resource'];
            var resourceDropdowns = targetDropdowns || ['#sel_resource', '#select_resource'];
            
            resourceDropdowns.forEach(function(selector) {
                var $dropdown = $(selector);
                if ($dropdown.length > 0) {
                    // Clear existing options except the first one
                    $dropdown.find('option:not(:first)').remove();
                    
                    // Reset to first option
                    $dropdown.val($dropdown.find('option:first').val());
                    
                    // Refresh selectpicker if it exists
                    if (typeof $.fn.selectpicker !== 'undefined' && $dropdown.hasClass('selectpicker')) {
                        $dropdown.selectpicker('refresh');
                    }
                }
            });
        }


        // Added By Dipali V On 2nd Feb 2026 For W26 - Fixed parameter mismatch: Convert array to string for CustomValidation
        function SetValidationToCustomFields() {
            //;
            for (var i = 0; i < ValidationFieldsName.length; i++) {
                // Added By Dipali V On 2nd Feb 2026 For W26 - Convert array to comma-separated string for API compatibility
                var customValidationValue = ValidationRules[i];
                if (Array.isArray(customValidationValue)) {
                    // Convert array like ["1", ""] to string "1," (preserve empty values for API processing)
                    customValidationValue = customValidationValue.map(function(val) { 
                        return (val === null || val === undefined) ? '' : String(val); 
                    }).join(',');
                } else if (customValidationValue === null || customValidationValue === undefined) {
                    customValidationValue = '';
                } else {
                    // Ensure it's a string
                    customValidationValue = String(customValidationValue);
                }
                
                var customField = {
                    FieldID: ValidationFieldID[i],
                    CustomFieldName: ValidationFieldsName[i],
                    CustomValidation: customValidationValue
                };
                var param = JSON.stringify(customField);
                // Modified by Dipali V on 26th Jan 2026 - Updated to use .NET Core API endpoint
                var result = AJAXCallWithResult("/api/PM_AssignedTasks/GetValidationForCustomFields",
                    param, false);

                if (result != undefined) {

                    for (var j = 0; j < result.list.length; j++) {
                        var ValidationObj = result.list[j];
                        if (ValidationMessage != "") {
                        }
                        ValidationMessage.push(ValidationObj.validationMessage);
                        ValidationValidateID.push(ValidationObj.validationID);
                        ValidationMessageFiled.push(ValidationFieldID[i]);
                        ValidationMessageFieldName.push(ValidationFieldsName[i]);
                    }
                }

            }
        }

        //To check the validation for the custom fields       
        function CustomFieldValidation() {
            var checkval = 0;
            for (var j = 0; j < CustomFieldsNames.length; j++) {
                if (CustomFieldsNames[j].indexOf("CustomFieldNumeric") > -1) {
                    var CustomFieldId = "#txt" + CustomFieldsNames[j];
                    var CustomFieldValue = $(CustomFieldId).val();
                    if (CustomFieldValue != undefined && CustomFieldValue != null && CustomFieldValue != '') {
                        if (!jQuery.isNumeric(CustomFieldValue)) {

                            checkval = 1;
                            alertify.error("<%= MyBase.GetResourceString("C_CustomfiledNumeric") %>");
                            $(CustomFieldId).focus()
                            return checkval;
                            break;
                        }
                    }
                }

            }

            for (var i = 0; i < ValidationMessageFieldName.length; i++) {

                var validateId = String(ValidationValidateID[i]);   // FIXED
                var $field = $(ValidationMessageFiled[i]);
                var fieldVal = $field.val();

                switch (validateId) {

                    case "1": // Blank
                        if (ValidationMessage[i].indexOf("blank") !== -1) {
                            if ((fieldVal === "0" || fieldVal === "") && fieldVal !== undefined) {
                                checkval = 1;
                                alertify.error(ValidationMessageFieldName[i] + ValidationMessage[i]);
                                $field.focus();
                                return checkval;
                            }
                        }
                        break;

                    case "2": // Date
                        if (ValidationMessage[i].indexOf("Date") !== -1) {
                            if (fieldVal !== "" && fieldVal !== undefined) {
                                if (!isDate($field)) {
                                    checkval = 1;
                                    alertify.error("<%= MyBase.GetResourceString("C_Datevalid") %>" + ValidationMessageFieldName[i]);
                                    $field.focus();
                                    return checkval;
                                }
                            }
                        }
                        break;

                    case "3": // Numeric
                        if (ValidationMessage[i].indexOf("numeric") !== -1) {
                            if (fieldVal !== "" && fieldVal !== undefined) {
                                if (!jQuery.isNumeric(fieldVal)) {
                                    checkval = 1;
                                    alertify.error(ValidationMessageFieldName[i] + " <%= MyBase.GetResourceString("C_CustomfiledNumeric") %>.");
                                    $field.focus();
                                    return checkval;
                                }
                            }
                        }
                        break;

                    case "9": // Alphabets
                        if (ValidationMessage[i].indexOf("Alphabets") !== -1) {
                            var condition = ValidationMessageFiled[i].indexOf("Area") !== -1
                                ? $field.text()
                                : fieldVal;

                            if (condition !== "") {
                                var pattern = /^[a-zA-Z]+$/;
                                if (!pattern.test(condition)) {
                                    checkval = 1;
                                    alertify.error(ValidationMessageFieldName[i] + " <%= MyBase.GetResourceString("C_Alphabets") %>.");
                                    $field.focus();
                                    return checkval;
                                }
                            }
                        }
                        break;

                    case "12": // Max Length
                        if (ValidationMessage[i].indexOf("Max") !== -1 && fieldVal !== "") {
                            var maxLen = $field.attr("maxlength");
                            if (maxLen && fieldVal.length > parseInt(maxLen)) {
                                checkval = 1;
                                alertify.error(ValidationMessage[i] + " " + ValidationMessageFieldName[i]);
                                $field.focus();
                                return checkval;
                            }
                        }
                        break;

                    case "13": // Positive Number
                        if (ValidationMessage[i].indexOf("positive numeric") !== -1 && fieldVal !== "") {
                            if (parseFloat(fieldVal) < 0) {
                                checkval = 1;
                                alertify.error(ValidationMessage[i] + " " + ValidationMessageFieldName[i]);
                                $field.focus();
                                return checkval;
                            }
                        }
                        break;

                    case "15": // Special Characters
                        if (ValidationMessage[i].indexOf("contain") !== -1 && fieldVal !== "") {
                            if (checkSpecialCharacter(fieldVal)) {
                                checkval = 1;
                                alertify.error(ValidationMessageFieldName[i] + " " + ValidationMessage[i]);
                                $field.focus();
                                return checkval;
                            }
                        }
                        break;

                    case "16": // Min Value
                        var minVal = $field.attr("MinValue");
                        if (minVal && fieldVal !== "" && parseFloat(fieldVal) < parseFloat(minVal)) {
                            checkval = 1;
                            alertify.error(ValidationMessageFieldName[i] + " " + ValidationMessage[i] + " " + minVal);
                            $field.focus();
                            return checkval;
                        }
                        break;

                    case "17": // Max Value
                        var maxVal = $field.attr("MaxValue");
                        if (maxVal && fieldVal !== "" && parseFloat(fieldVal) > parseFloat(maxVal)) {
                            checkval = 1;
                            alertify.error(ValidationMessageFieldName[i] + " " + ValidationMessage[i] + " " + maxVal);
                            $field.focus();
                            return checkval;
                        }
                        break;

                    case "18": // Range
                        var min = parseFloat($field.attr("MinValue"));
                        var max = parseFloat($field.attr("MaxValue"));
                        var value = parseFloat(fieldVal);

                        if (!isNaN(value) && (value < min || value > max)) {
                            checkval = 1;
                            alertify.error(
                                ValidationMessageFieldName[i] + " " +
                                ValidationMessage[i] + " " +
                                min + " - " + max
                            );
                            $field.focus();
                            return checkval;
                        }
                        break;
                }
            }
            return checkval;
        }


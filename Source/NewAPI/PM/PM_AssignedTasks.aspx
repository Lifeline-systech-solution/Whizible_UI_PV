            var activeTab = $('.task-management-tabs .nav-link.active').data('tab');
            if (activeTab === 'PM_AssignedTasks.aspx') {
                $('#assignedTasksControlSection').show();
            } else {
                $('#assignedTasksControlSection').hide();
            }



        //Added By Dipali V On 2nd Jan 2026 For Ajax Code To Normalize Api Response
        function normalizeApiResponse(result) {

            var normalized = {
                status: 'SUCCESS',
                message: '',
                list: [],
                raw: result
            };

            if (!result) {
                normalized.status = 'FAILED';
                normalized.message = 'No response from server';
                return normalized;
            }

            // Handle standard API wrapper
            if (result.status) {
                normalized.status = result.status;
            }

            // Most common format: result.data.data
            if (result.data) {

                if (result.data.message) {
                    normalized.message = result.data.message;
                }

                if (Array.isArray(result.data.data)) {
                    normalized.list = result.data.data;
                    return normalized;
                }

                if (Array.isArray(result.data)) {
                    normalized.list = result.data;
                    return normalized;
                }
            }

            // Alternate formats
            if (Array.isArray(result.Data)) {
                normalized.list = result.Data;
                return normalized;
            }

            if (Array.isArray(result)) {
                normalized.list = result;
                return normalized;
            }

            // Single object → convert to array
            if (typeof result === 'object') {
                normalized.list = [result];
                return normalized;
            }

            return normalized;
        }

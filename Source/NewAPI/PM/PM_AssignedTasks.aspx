        // calcMode: 'resource' = use allocation period | 'date' = use selected UI dates
        function getResourceAllocationHoursForAddResource(calcMode, $trigger) {
            calcMode = calcMode || 'date';
            var $editRow = $('#parentTaskResourceTable tbody tr.resource-edit-mode');
            var isEditMode = $editRow.length > 0;
            var ctx = resolveAddResourceRowFields($trigger);
            var userID = isEditMode ? $editRow.data('employeeid') : ctx.getUserID();
            if (!userID) {
                if (!isEditMode) ctx.$effort.val('');
                return;
            }
            var projectID = SessionProjectID || $('#cboAssignedTaskProject').val();
            var startDate = isEditMode
                ? $editRow.find('.edit-resource-start-date').val()
                : (ctx.$start.val() || GProjectStartDate || '');
            var endDate = isEditMode
                ? $editRow.find('.edit-resource-end-date').val()
                : (ctx.$end.val() || GProjectEndDate || '');
            if (!projectID || !startDate || !endDate) return;

            try {
                var result = AJAXCallWithResult('api/PM_AssignedTasks/GetResourceEfforts', JSON.stringify({
                    ProjectID: parseInt(projectID, 10),
                    ExpectedStartDate: formatDateForAPI(startDate),
                    ExpectedEndDate: formatDateForAPI(endDate),
                    UserID: parseInt(userID, 10),
                    UseResourceAllocationDates: (calcMode === 'resource')
                }), false);
                if (!result || result.status !== 'SUCCESS' || !result.list || !result.list.length) return;
                var row = result.list[0];
                if (calcMode === 'resource' && !isEditMode) {
                    var resStart = row.resourceExpectedStartDate || row.ResourceExpectedStartDate;
                    var resEnd = row.resourceExpectedEndDate || row.ResourceExpectedEndDate;
                    _skipResourceDateChangeRecalc = true;
                    if (resStart) ctx.$start.val(formatDateForDisplay(resStart));
                    if (resEnd) ctx.$end.val(formatDateForDisplay(resEnd));
                    _skipResourceDateChangeRecalc = false;
                }
                var hours = parseFloat(row.autoHours || row.AutoHours || 0);
                if (!isNaN(hours) && hours > 0) {
                    var hhmm = decimalToHHMM(hours);
                    if (isEditMode) $editRow.find('.edit-resource-work').val(hhmm);
                    else ctx.$effort.val(hhmm);
                    if (isMultiResourceAddFormMode()) updateNewTaskAddResourceLink();
                }
            } catch (e) {
                console.error('Error getting resource allocation hours:', e);
            }
        }


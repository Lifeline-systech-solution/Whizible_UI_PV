        function GetHistory(taskID) {
            if (!taskID || taskID === 'null' || taskID === '' || isNaN(taskID)) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_InvalidTaskID") %>');
                return;
            }

            currentHistoryTaskID = parseInt(taskID);
            
            // Get task name from the list
            // Modified by Dipali V on 26th Jan 2026 - Also search in dynamically loaded child tasks
            var taskName = '';
            var task = null;
            
            // First search in GtaskListFlattened
            if (GtaskListFlattened && GtaskListFlattened.length > 0) {
                task = GtaskListFlattened.find(function(t) {
                    return (t.TaskID || t.taskID) == taskID;
                });
            }
            
            // If not found, search in GchildTasksMap (dynamically loaded child tasks)
            if (!task && GchildTasksMap && typeof GchildTasksMap === 'object') {
                for (var parentID in GchildTasksMap) {
                    if (GchildTasksMap.hasOwnProperty(parentID) && Array.isArray(GchildTasksMap[parentID])) {
                        task = GchildTasksMap[parentID].find(function(t) {
                    return (t.TaskID || t.taskID) == taskID;
                });
                if (task) {
                            break; // Found it, exit loop
                        }
                    }
                }
            }
            
            if (task) {
                taskName = task.TaskName || task.taskName || '-';
            }
            
            currentHistoryTaskName = taskName;
            $('#taskHistoryTaskName').text(taskName || '-');

            // Show offcanvas and load data - Converted from modal by Dipali V on 06th Jan 2026
            var offcanvasElement = document.getElementById('taskHistoryOffcanvas');
            var offcanvas = new bootstrap.Offcanvas(offcanvasElement);
            offcanvas.show();
            $('body').addClass('offcanvas-open');

            // Load history data
            loadTaskHistory(taskID, '', '');
        }


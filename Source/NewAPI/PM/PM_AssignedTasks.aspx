        // Added by Dipali V On 22nd Jun 2026 - Purpose: list mandatory visible task attributes that are empty
        function getMandatoryTaskAttributesMissing(taskAttributes) {
            var missingFields = [];
            taskAttributes.forEach(function (item) {
                if (item.mandatory === true && item.show === true) {
                    var selector = ATTRIBUTE_FIELD_MAP[item.attributes];
                    if (!selector) return;
                    var value = ($(selector).val() || '').trim();
                    if (!value) missingFields.push(item.attributes);
                }
            });
            return missingFields.filter(function (v, i, a) { return a.indexOf(v) === i; });
        }

        // Added by Dipali V On 22nd Jun 2026 - Purpose: returns true when all mandatory visible task attributes are filled
        function validateMandatoryTaskAttributes(taskAttributes) {
            return getMandatoryTaskAttributesMissing(taskAttributes).length === 0;
        }



        function checkSpecialCharacter(value, WebConfigSpecialCharacters) {
            if (WebConfigSpecialCharacters != '') {
                var regularExpression = WebConfigSpecialCharacters;
               // regularExpression += '"';
                var isSpecialCharacter = 0;
                for (var i = 0; i < regularExpression.length; i++) {
                    if (value.indexOf(regularExpression[i]) != -1) {
                        isSpecialCharacter = 1
                    }
                }
                if (isSpecialCharacter == 1) {
                    return true;
                }
                else {
                    return false;
                }
            }
            else {
                return false;
            }
        }


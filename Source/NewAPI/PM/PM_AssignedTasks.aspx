        // Function to update chips section based on active filters
        // Added By Madhuri.K on 09-12-2025 - Function to update chips section (show only when filters are applied)
        function updateChipsSection() {
            var chips = [];
            var $container = $('#chipsContainer');
            var $chipsSection = $('#chipsSection');
            var selectedResource = $('#sel_resource').val();
            if (selectedResource && selectedResource !== '' && selectedResource !== '0') {
                var resourceText = $('#sel_resource option:selected').text();
                if (resourceText && resourceText !== 'Select Resource' && resourceText.trim() !== '') {
                    chips.push({
                        label: 'Resource',
                        value: resourceText,
                        type: 'info',
                        id: 'chip-resource',
                        filterType: 'resource'
                    });
                }
            }

            // Get selected task status
            var selectedStatus = $('#sel_task_status').val();
            var statusText = $('#sel_task_status option:selected').text();
            //if (selectedStatus && selectedStatus !== '' && selectedStatus !== '0') {
            //    var statusText = $('#sel_task_status option:selected').text();
            //    if (statusText && statusText !== 'Select Is Task Completed' && statusText.trim() !== '') {
            // Added by DipalI v On 2nd sep 2026 - Purpose: treat "No" (value 0) as valid applied filter, not placeholder
            if (statusText && statusText !== 'Select Is Task Completed' && statusText.trim() !== '') {
                var statusTextUpper = statusText.toUpperCase().trim();
                chips.push({
                    label: 'Is Task Completed',
                    value: statusText,
                    type: (statusTextUpper === 'YES' || statusTextUpper === 'COMPLETED' || statusTextUpper === 'TRUE') ? 'success' : 'warning',
                    id: 'chip-status',
                    filterType: 'status'
                });
            }

            // Get selected date filter
            var dateFilter = $('input[name="taskDateFilter"]:checked').val();
            if (dateFilter && dateFilter === 'period') {
                var fromDate = $('#taskFromDate').val();
                var toDate = $('#taskToDate').val();
                if (fromDate || toDate) {
                    var dateRange = '';
                    if (fromDate && toDate) {
                        dateRange = fromDate + ' to ' + toDate;
                    } else if (fromDate) {
                        dateRange = 'From ' + fromDate;
                    } else if (toDate) {
                        dateRange = 'Until ' + toDate;
                    }
                    if (dateRange) {
                        chips.push({
                            label: 'Date Range',
                            value: dateRange,
                            type: 'primary',
                            id: 'chip-daterange',
                            filterType: 'daterange'
                        });
                    }
                }
            }

            // Get selected task type
            // Modified by Nikhil - Exclude default value 'O' (Assigned Tasks) so it never shows as a chip
            var taskType = $('input[name="taskType"]:checked').val();
            if (taskType && taskType !== 'O' && taskType !== 'assigned') {
                var taskTypeText = $('input[name="taskType"]:checked').next('label').text();
                //var taskTypevalue = $('input[name="taskType"]:checked').attr('data');
                var taskTypevalue = $('input[name="taskType"]:checked').val();
                chips.push({
                    label: 'Task Type',
                    value: taskTypeText,
                    data: taskTypevalue,
                    type: 'info',
                    id: 'chip-tasktype',
                    filterType: 'tasktype'
                });
            }

            // Clear container
            $container.empty();

            // Show/hide chips section based on whether filters are applied
            if (chips.length > 0) {
                // Display chips
                chips.forEach(function (chip) {
                    var chipHtml = '<div class="chip-item chip-' + chip.type + '" id="' + chip.id + '">' +
                        '<span class="chip-label">' + chip.label + ':</span>' +
                        '<span class="chip-value">' + chip.value + '</span>' +
                        '<span class="chip-data" style="display:none">' + (chip.data || '') + '</span>' +
                        '<button type="button" class="chip-close" data-filter-type="' + chip.filterType + '" title="Remove filter" aria-label="Remove filter">' +
                        '<i class="fas fa-times"></i>' +
                        '</button>' +
                        '</div>';
                    $container.append(chipHtml);
                });
                // Added by DipalI v On 3rd sep 2026 - Purpose: force flex so top period chip displays again after remove + re-apply
                $chipsSection.addClass('show').css('display', 'flex');
            } else {
                // Added by DipalI v On 3rd sep 2026 - Purpose: fully hide chips bar when no filter chips remain
                $chipsSection.removeClass('show').css('display', 'none');
            }
        }


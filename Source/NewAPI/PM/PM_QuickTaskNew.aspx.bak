                                <!-- Notes will be added here with numbering -->
                            </ol>
                            <textarea id="taskNoteTextarea" class="form-control mt-2" rows="5" placeholder="<%= MyBase.GetResourceString("C_EnterTaskNote") %>"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="btnrow text-center" style="width: 100%;">
                            <button type="button" class="btn canclesaveasbtn borderbtn" id="okTaskNoteBtn"><%= MyBase.GetResourceString("C_Ok") %></button>
                            <button data-bs-dismiss="modal" class="btn canclesaveasbtn borderbtn"><%= MyBase.GetResourceString("C_Cancel") %></button>
                        </div>
                        <div class="clearfix"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Validation Modal start here-->
        <div class="modal custmodal fade" id="validationModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog custmodal  modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id=""><%= MyBase.GetResourceString("C_QuickTaskValidations") %></h5>
                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="table-responsive">
                            <table class="table table-stripped table-bordered tskValTbl">
                                <thead class="stickyTblHeader">
                                    <tr>
                                        <th><%= MyBase.GetResourceString("C_TaskNameHeader") %></th>
                                        <th><%= MyBase.GetResourceString("C_Remarks") %></th>
                                        <th><%= MyBase.GetResourceString("C_ResourceHeader") %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>

                        <div class="clearfix"></div>
                        <hr />

                        <div class="btnrow text-center">
                            <button type="button" data-bs-dismiss="modal" class="btn canclesaveasbtn borderbtn"><%= MyBase.GetResourceString("C_Cancel") %></button>
                        </div>
                        <div class="clearfix"></div>

                    </div>
                </div>
            </div>
        </div>
        <!-- Validation Modal End here-->
        
     

    </form>
     </div>
   
    <script>
        // Added By Dipali V On 23rd Jan 2026 For W26 - Maximum rows constant
        const MAX_TASK_ROWS = 10;

        // Resource values for JavaScript
        var Resources = {
            A_SelectProjectFirst: '<%= MyBase.GetResourceString("A_SelectProjectFirst") %>',
            A_UserIDRequired: '<%= MyBase.GetResourceString("A_UserIDRequired") %>',
            A_AddAtLeastOneTask: '<%= MyBase.GetResourceString("A_AddAtLeastOneTask") %>',
            A_ValidationError: '<%= MyBase.GetResourceString("A_ValidationError") %>',
            A_TasksCreatedSuccessfully: '<%= MyBase.GetResourceString("A_TasksCreatedSuccessfully") %>',
            A_NoEstimationTypesFound: '<%= MyBase.GetResourceString("A_NoEstimationTypesFound") %>',
            A_NoChangeRequestsFound: '<%= MyBase.GetResourceString("A_NoChangeRequestsFound") %>',
            A_InvalidDeliverableID: '<%= MyBase.GetResourceString("A_InvalidDeliverableID") %>',
            A_InvalidProjectID: '<%= MyBase.GetResourceString("A_InvalidProjectID") %>',
            C_SelectResource: '<%= MyBase.GetResourceString("C_SelectResource") %>',
            C_SelectTaskType: '<%= MyBase.GetResourceString("C_SelectTaskType") %>',
            C_SelectPriority: '<%= MyBase.GetResourceString("C_SelectPriority") %>',
            C_SelectPlaceholder: '<%= MyBase.GetResourceString("C_SelectPlaceholder") %>',
            C_CheckValidation: '<%= MyBase.GetResourceString("C_CheckValidation") %>',
            C_CopyTask: '<%= MyBase.GetResourceString("C_CopyTask") %>',
            C_Delete: '<%= MyBase.GetResourceString("C_Delete") %>',
            C_Validated: '<%= MyBase.GetResourceString("C_Validated") %>'
        };
    </script>

    <script>
         alertify.set('notifier', 'position', 'top-right'); 
         var ViewAccess = "<%= m_blnViewAccess %>";
         var AddAccess = "<%= m_blnAddAccess %>";
        // Added By Dipali V On 23rd Jan 2026 For W26 - API Base URL
        var strUrl = '<%=System.Configuration.ConfigurationManager.AppSettings("WebAPIUrl-W26API").ToString()%>';
         var WebConfigSpecialCharacters = '<%=System.Configuration.ConfigurationManager.AppSettings("SpecialCharactersList").ToString%>'
        
        var projectID = '<%= Session("intProjectID") %>';
        var userID = '<%= Session("intUserID") %>';
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Cache for lookup data
        var qtLookups = {
            resources: [],
            taskTypes: [],
            priorities: []
        };
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Project type flags for mandatory fields
        var projectTypeFlags = null;
        var currentProjectTypeID = null;

        // Added By Dipali V On 23rd Jan 2026 For W26 - Generic AJAX call function (reusable for all endpoints)
        function AJAXCallWithResult(url, param, async) {
            var result = null;
            var fullUrl = buildUrl(url);
            var type = "POST";
            
            $.ajax({
                url: encodeURI(fullUrl),
                type: type,
                data: param,
                async: async !== false,
                dataType: "json",
                contentType: (type === "GET") ? "application/x-www-form-urlencoded" : "application/json;charset=utf-8",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'bearer ' + sessionStorage.getItem("access_token_W26API"));
                    if (param) {
                        xhr.setRequestHeader("Params", encryptString(isJson(param) ? param : JSON.stringify(param)));
                    }
                },
                success: function (data) {
                    result = normalizeApiResponse(data);
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.error('AJAX Error for ' + url + ':', {
                        status: jqXHR.status,
                        statusText: jqXHR.statusText,
                        textStatus: textStatus,
                        errorThrown: errorThrown
                    });
                    result = null;
                }
            });
            return result;
        }

        // Added By Dipali V On 23rd Jan 2026 For W26 - Build URL helper
        function buildUrl(url) {
            if (strUrl.endsWith('/') && url.startsWith('/')) {
                return strUrl + url.substring(1);
            } else if (strUrl.endsWith('/') && !url.startsWith('/')) {
                return strUrl + url;
            } else if (!strUrl.endsWith('/') && url.startsWith('/')) {
                return strUrl + url;
            } else {
                return strUrl + '/' + url;
            }
        }

        // Added By Dipali V On 23rd Jan 2026 For W26 - Normalize API response
        function normalizeApiResponse(data) {
            if (!data) return null;
            if (data.data !== undefined) return data.data;
            if (data.Data !== undefined) return data.Data;
            if (data.items !== undefined) return data.items;
            if (data.Items !== undefined) return data.Items;
            if (Array.isArray(data)) return data;
            return data;
        }

        // Added By Dipali V On 23rd Jan 2026 For W26 - Helper functions
        function isJson(str) {
            if (typeof str !== 'string') return false;
            try { JSON.parse(str); return true; } catch(e) { return false; }
        }

        function encryptString(str) { return str; }

        // Added By Dipali V On 23rd Jan 2026 For W26 - Fill select dropdown with items
        function fillSelect($sel, items) {
            if (!$sel || !$sel.length || !$sel.is('select')) return;
            if (!items || !Array.isArray(items) || items.length === 0) {
                // Even if no items, ensure placeholder is set
                var placeholderText = $sel.attr('aria-label') || Resources.C_SelectPlaceholder || 'Select';
                if ($sel.find('option').length === 0) {
                    $sel.append('<option value="">' + placeholderText + '</option>');
                }
                return;
            }
            
            var val = $sel.val();
            var placeholderText = $sel.attr('aria-label') || Resources.C_SelectPlaceholder || 'Select';
            var isSelectpicker = $sel.data('selectpicker');
            
            // Destroy selectpicker before modifying options
            if (isSelectpicker) {
                try { $sel.selectpicker('destroy'); } catch(e) {}
            }
            
            $sel.empty();
            $sel.append('<option value="">' + placeholderText + '</option>');
            
            items.forEach(function(it) {
                var itemId = it.id !== undefined ? it.id : (it.Id !== undefined ? it.Id : null);
                var itemName = it.name !== undefined ? it.name : (it.Name !== undefined ? it.Name : '');
                if (itemId != null && itemName) {
                    $sel.append('<option value="' + itemId + '">' + itemName + '</option>');
                }
            });
            
            if (val) $sel.val(val);
            
            // Reinitialize selectpicker if it was initialized before
            if (isSelectpicker || $sel.hasClass('selectpicker')) {
                setTimeout(function() { 
                    try { 
                        if (!$sel.data('selectpicker')) {
                            $sel.selectpicker({ dropupAuto: false });
                        } else {
                            $sel.selectpicker('refresh');
                        }
                    } catch(e) {}
                }, 50);
            }
        }

        // Added By Dipali V On 23rd Jan 2026 For W26 - Generic function to load lookup data (consolidated)
        function loadLookupData(type, projectId, getDefault) {
            var url, payload, lookupKey;
            
            if (type === 'resources') {
                if (!projectId || projectId <= 0) { qtLookups.resources = []; return; }
                url = 'api/BulkTaskCreation/GetResources';
                payload = { ProjectID: projectId };
                lookupKey = 'resources';
            } else if (type === 'taskTypes') {
                if (!projectId || projectId <= 0) { qtLookups.taskTypes = []; return; }
                url = 'api/BulkTaskCreation/GetTaskTypes';
                payload = { ProjectID: projectId, GetDefault: getDefault || false };
                lookupKey = 'taskTypes';
            } else if (type === 'priorities') {
                url = 'api/BulkTaskCreation/GetPriorities';
                payload = null;
                lookupKey = 'priorities';
            } else return;
            
            try {
                var result = AJAXCallWithResult(url, payload ? JSON.stringify(payload) : null, false);
                var items = [];
                
                if (result) {
                    if (Array.isArray(result)) items = result;
                    else if (result.items || result.Items) items = result.items || result.Items;
                    else if (result.data) {
                        if (Array.isArray(result.data)) items = result.data;
                        else items = result.data.items || result.data.Items || [];
                    }
                }
                
                qtLookups[lookupKey] = $.map(items, function(it) {
                    return { id: it.Id !== undefined ? it.Id : (it.id !== undefined ? it.id : null), 
                             name: it.Name !== undefined ? it.Name : (it.name !== undefined ? it.name : '') };
                });
            } catch(e) {
                console.error('Error loading ' + type + ':', e);
                qtLookups[lookupKey] = [];
            }
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Apply lookup options to all rows and initialize selectpickers
        function applyLookupOptionsToAllRows() {
            if ($('#bulkTaskTbl tbody tr').length === 0) return;
            
            $('#bulkTaskTbl tbody tr').each(function() {
                applyLookupOptionsToRow($(this));
            });
            
            // Initialize/refresh selectpickers after populating options
            setTimeout(function() {
                $('#bulkTaskTbl tbody tr').each(function() {
                    var $row = $(this);
                    $row.find('select.selectpicker').each(function() {
                        var $sel = $(this);
                        if (!$sel.is('select') || typeof $.fn.selectpicker === 'undefined') return;
                        
                        try {
                            if (!$sel.data('selectpicker')) {
                                var hasLiveSearch = $sel.attr('data-live-search') === 'true';
                                $sel.selectpicker({ dropupAuto: false, liveSearch: hasLiveSearch });
                            } else {
                                $sel.selectpicker('refresh');
                            }
                        } catch(e) {
                            console.error('Error initializing selectpicker:', e);
                        }
                    });
                });
            }, 300);
        }

        // Added By Dipali V On 23rd Jan 2026 For W26 - Load all lookup data for a project
        function loadQuickTaskLookups(projectId) {
            if (!projectId || projectId <= 0) {
                qtLookups.resources = []; qtLookups.taskTypes = [];
                applyLookupOptionsToAllRows();
                return;
            }
            loadLookupData('resources', projectId);
            loadLookupData('taskTypes', projectId, false);
            loadLookupData('priorities');
            // Apply options after all data is loaded
            applyLookupOptionsToAllRows();
        }

        // Added By Dipali V On 23rd Jan 2026 For W26 - Generic function to load modal data
        var currentModalType = null;
        var currentRow = null;
        
        function loadModalData(modalType, projectId, additionalParams) {
           // debugger;
            if (!projectId || projectId <= 0) {
                console.error('Invalid project ID for ' + modalType);
                return;
            }
            
            var url, payload, tableSelector, inputId;
            
            switch(modalType) {
                case 'Phase':
                    url = 'api/BulkTaskCreation/GetPhases';
                    payload = { ProjectID: projectId };
                    tableSelector = 'table.tbl_select_Phase tbody';
                    inputId = 'txtPhase';
                    break;
                case 'Milestone':
                    url = 'api/BulkTaskCreation/GetMilestones';
                    payload = { ProjectID: projectId, Mode: additionalParams?.Mode || 'T', TaskID: additionalParams?.TaskID || null };
                    tableSelector = 'table.tbl_select_milestone tbody';
                    inputId = 'txtMilestone';
                    break;
                case 'Module':
                    url = 'api/BulkTaskCreation/GetModules';
                    payload = { ProjectID: projectId, Mode: additionalParams?.Mode || 'T', TaskID: additionalParams?.TaskID || null, ModuleID: additionalParams?.ModuleID || null };
                    tableSelector = 'table.tbl_select_Module tbody';
                    inputId = 'txtModule';
                    break;
                case 'SubProject':
                    url = 'api/BulkTaskCreation/GetSubprojects';
                    payload = { ProjectID: projectId, Mode: additionalParams?.Mode || 'T', TaskID: additionalParams?.TaskID || null, SubProjectID: additionalParams?.SubProjectID || null };
                    tableSelector = 'table.tbl_select_SubProject tbody';
                    inputId = 'txtSubProject';
                    break;
                // Commented By Dipali V On 3rd Feb 2026 For W26 - Removed Feature control from Quick Task New page
                //case 'Feature':
                //    url = 'api/BulkTaskCreation/GetFeatures';
                //    //payload = { ProjectID: projectId, ProjectFeatureID: additionalParams?.ProjectFeatureID || null };
                //    payload = { ProjectID: projectId, Mode: additionalParams?.Mode || 'T', TaskID: additionalParams?.TaskID || null, ProjectFeatureID: additionalParams?.ProjectFeatureID || null };
                // 
                //    tableSelector = 'table#tbl_select_Feature tbody, table.tbl_select_Module[id="#tbl_select_Feature"] tbody';
                //    inputId = 'txtFeature';
                //    break;
                case 'Deliverable':
                    // Note: GetDeliverableById might need a different endpoint or approach
                    // For now, we'll use a placeholder - you may need to adjust based on actual API
                    //url = 'api/BulkTaskCreation/GetDeliverableById';

                    url = 'api/BulkTaskCreation/GetDefaultTaskType';
                    //payload = { DeliverableID: additionalParams?.DeliverableID || null };
                    
                     payload = { ProjectID: projectId, Mode: additionalParams?.Mode || 'T', TaskID: additionalParams?.TaskID || null, DeliverableID: additionalParams?.DeliverableID || null ,DeliverableType :  null };
                     tableSelector = 'table#DeliverableTable tbody, table.delTbl tbody';
                    inputId = 'txtDeliverable';
                    // Deliverable might need ProjectID instead
                    if (!payload.DeliverableID && projectId) {
                        // If no DeliverableID, we might need to get all deliverables for project
                        // This would require a different endpoint like GetDeliverables
                        console.warn('DeliverableID not provided, may need different endpoint');
                    }
                    break;
                case 'UserStory':
                    url = 'api/BulkTaskCreation/GetScrumUserStories';
                    payload = { 
                        ProjectID: projectId, 
                        UserStoryID: additionalParams?.UserStoryID || null,
                        UserStory: additionalParams?.UserStory || null
                    };
                    tableSelector = 'table#tbl_select_User_Story tbody, table.tbl_select_Module[id="#tbl_select_User_Story"] tbody';
                    inputId = 'txtUserStory';
                    break;
                default:
                    console.error('Unknown modal type: ' + modalType);
                    return;
            }
            
            try {
                var result = AJAXCallWithResult(url, JSON.stringify(payload), false);
                var items = [];
                
                if (result) {
                    if (Array.isArray(result)) items = result;
                    else if (result.list) items = result.list;
                    else if (result.items || result.Items) items = result.items || result.Items;
                    else if (result.data) {
                        if (Array.isArray(result.data)) items = result.data;
                        else items = result.data.items || result.data.Items || [];
                    }
                    // Handle single object response (e.g., GetDeliverableById)
                    else if (modalType === 'Deliverable' && result.Id) {
                        items = [result];
                    }
                     else if (modalType === 'UserStory' ) {
                         items = result.userStories;
                     }
                    
                }
                
                populateModalTable(modalType, items, tableSelector, inputId);
            } catch(e) {
                console.error('Error loading ' + modalType + ':', e);
                var $table = $(tableSelector);
                if ($table.length) {
                    $table.html('<tr><td colspan="10" class="text-center py-2">Error loading data</td></tr>');
                }
            }
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Helper function to extract numeric ID from string (e.g., "44|sa" -> 44)
        function extractNumericID(idValue) {
            if (!idValue || idValue === null || idValue === undefined || idValue === '') return null;
            var str = String(idValue).trim();
            if (str.indexOf('|') !== -1) {
                str = str.split('|')[0];
            }
            var num = parseInt(str, 10);
            return isNaN(num) ? null : num;
        }

        // Added by DipalI v On 3rd sep 2026 - Purpose: clear WBS mapping field value + HTML attr + jQuery data cache (stale .data('selected-id') was remapping Deliverable/Phase/Milestone/Module/SubProject on next create)
        function clearMappingFieldInput($input) {
            if (!$input || !$input.length) return;
            $input.val('');
            $input.removeAttr('data-selected-id');
            $input.removeData('selected-id');
        }

        // Added by DipalI v On 3rd sep 2026 - Purpose: read mapped ID only from current UI state; ignore empty display / stale jQuery data cache
        function getSelectedMappingIdFromInput($input) {
            if (!$input || !$input.length) return null;
            var displayVal = ($input.val() || '').toString().trim();
            if (!displayVal) return null;
            var idRaw = $input.attr('data-selected-id');
            if (idRaw === undefined || idRaw === null || idRaw === '') return null;
            return extractNumericID(idRaw);
        }

        // Added by DipalI v On 3rd sep 2026 - Purpose: clear Deliverable/Phase/Milestone/Module/SubProject/UserStory mappings for row(s)
        function clearRowWbsMappings($scope) {
            var $root = $scope && $scope.length ? $scope : $('#bulkTaskTbl tbody');
            $root.find('input.popup-field, input[id^="txtDeliverable"], input[id^="txtPhase"], input[id^="txtMilestone"], input[id^="txtModule"], input[id^="txtSubProject"], input[id^="txtUserStory"], input[id^="txtSprint"], input[id^="txtRelease"]').each(function () {
                clearMappingFieldInput($(this));
            });
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Generic function to populate modal table
        function populateModalTable(modalType, items, tableSelector, inputId) {
            var $table = $(tableSelector);
            //debugger;
            if (!$table.length) return;
            
            $table.empty();
            
            if (!items || !Array.isArray(items) || items.length === 0) {
                var colspan = $table.closest('table').find('thead th').length || 5;
                $table.html('<tr><td colspan="' + colspan + '" class="text-center py-2">No Data Found</td></tr>');
                return;
            }
            
            var savedId = null;
            if (currentRow) {
                var $input = currentRow.find('input[id^="' + inputId + '"]');
                if ($input.length) {
                    //var savedIdRaw = $input.attr('data-selected-id') || $input.data('selected-id');
                    //savedId = extractNumericID(savedIdRaw);
                    // Added by DipalI v On 3rd sep 2026 - Purpose: use current display+attr only (avoid stale jQuery data remapping previous selection)
                    savedId = getSelectedMappingIdFromInput($input);
                }
            }
            
            items.forEach(function(item, index) {
               // debugger;
            var itemIdRaw = item.Id || item.id || item.PhaseId || item.phaseId || item.MilestoneId || item.milestoneId || 
                            item.ModuleId || item.moduleId || item.SubProjectId || item.subProjectId || 
                            item.ProjectFeatureID || item.projectFeatureID || item.DeliverableID || item.deliverableID ||
                            item.UserStoryID || item.userStoryID || item.UserStoryId || item.userStoryId || item.scheduleID || '';
                            //item.UserStoryID || item.userStoryID || item.UserStoryId || item.scheduleID || '';
            var itemId = extractNumericID(itemIdRaw);
            var itemIdForCheckbox = itemId !== null ? itemId : itemIdRaw; // Use raw value for checkbox if numeric extraction fails
            var itemName = item.Name || item.name || item.PhaseName || item.phaseName || item.MilestoneName || item.milestoneName ||
                              item.ModuleName || item.moduleName || item.SubProjectName || item.subProjectName ||
                              item.FeatureName || item.featureName || item.DeliverableName || item.deliverableName ||
                              item.UserStoryName || item.userStoryName || item.UserStory || item.userStory || item.title || '';
                var startDate = item.StartDate || item.startDate || item.EstimatedStartDate || item.estimatedStartDate || item.scrumUserStoryStartDate || '';
                var endDate = item.EndDate || item.endDate || item.EstimatedEndDate || item.estimatedEndDate || item.latestCompletionDate || item.scrumUserStoryEndDate || '';
                var status = item.Status || item.status || '';
                
                var isSelected = (savedId && (itemId == savedId || itemId.toString() === savedId.toString()));
                var rowClass = isSelected ? 'currently_selected' : '';
                var checkboxId = modalType + '_id' + index;
                
                var row = '<tr class="' + rowClass + '" data-id="' + itemId + '" data-name="' + itemName + '">';
                
                // Add columns based on modal type
                if (modalType === 'Phase' || modalType === 'Module') {
                    row += '<td>' + itemName + '</td>';
                    row += '<td>' + (formatDateForDisplay(startDate) || '') + '</td>';
                    row += '<td>' + (formatDateForDisplay(endDate) || '') + '</td>';
                } else if (modalType === 'Milestone') {
                    row += '<td>' + itemName + '</td>';
                    row += '<td>' + (status || '') + '</td>';
                    row += '<td>' + (formatDateForDisplay(startDate) || '') + '</td>';
                    row += '<td>' + (formatDateForDisplay(endDate) || '') + '</td>';
                } else if (modalType === 'SubProject') {
                    row += '<td>' + itemName + '</td>';
                    row += '<td>' + (formatDateForDisplay(startDate) || '') + '</td>';
                    row += '<td>' + (formatDateForDisplay(endDate) || '') + '</td>';
                // Commented By Dipali V On 3rd Feb 2026 For W26 - Removed Feature control from Quick Task New page
                //} else if (modalType === 'Feature') {
                //    row += '<td>' + itemName + '</td>';
                //    // Feature modal only has 2 columns: Feature and Select
                } else if (modalType === 'Deliverable') {
                   // debugger;
                    row += '<td>' + itemName + '</td>';
                    row += '<td>' + (item.labelSchedule || item.LabelSchedule || '') + '</td>';
                    row += '<td>' + (formatDateForDisplay(startDate) || '') + '</td>';
                    row += '<td>' + (formatDateForDisplay(endDate) || '') + '</td>';
                } else if (modalType === 'UserStory') {
                    row += '<td>' + itemName + '</td>';
                   // debugger;
                    row += '<td>' + (formatDateForDisplay(startDate) || '') + '</td>';
                    row += '<td>' + (formatDateForDisplay(endDate) || '') + '</td>';
                    row += '<td>' + (item.StoryPoint || item.storyPoint || item.StoryPoints || item.storyPoints || '') + '</td>';
                }
                
                row += '<td class="sm-wid">';
                row += '<div class="custom_chckbox">';
                row += '<input id="' + checkboxId + '" class="chckHead ' + modalType + '_mainchck" value="' + (itemId !== null ? itemId : itemIdRaw) + '" type="checkbox" ' + (isSelected ? 'checked' : '') + '>';
                row += '<label for="' + checkboxId + '"></label>';
                row += '</div>';
                row += '</td>';
                row += '</tr>';
                
                $table.append(row);
            });
            
            // Setup checkbox change handler
            setupModalCheckboxHandler(modalType, inputId);
        }

         function formatDateForDisplay(dateStr) {
             if (!dateStr) return '-';
             try {
                 var date = new Date(dateStr);
                 if (isNaN(date.getTime())) return dateStr;
                 return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
             } catch (e) { return dateStr; }
         }


        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Generic filter function for modal tables
        function filterModalTable(modalType) {
            var filterValue = '', filterValue2 = '';
            if (modalType === 'Deliverable') filterValue = $('#doc_Deliverable').val().toLowerCase();
            else if (modalType === 'UserStory') filterValue = $('#doc_User_Story').val().toLowerCase();
            else if (modalType === 'Milestone') {
                filterValue = $('#doc_milestone').val().toLowerCase();
                filterValue2 = $('#status_milestone').val().toLowerCase();
            }
            // Added By Dipali V On 3rd Feb 2026 For W26 - Fix SubProject search by using correct input ID (doc_Sub-project with hyphen)
            else if (modalType === 'SubProject') filterValue = $('#doc_Sub-project').val().toLowerCase();
            else filterValue = $('#doc_' + modalType).val().toLowerCase();
            
            var tableSelector = '';
            if (modalType === 'Phase') tableSelector = 'table.tbl_select_Phase tbody';
            else if (modalType === 'Milestone') tableSelector = 'table.tbl_select_milestone tbody';
            else if (modalType === 'Module') tableSelector = 'table.tbl_select_Module tbody';
            else if (modalType === 'SubProject') tableSelector = 'table.tbl_select_SubProject tbody';
            // Commented By Dipali V On 3rd Feb 2026 For W26 - Removed Feature control from Quick Task New page
            //else if (modalType === 'Feature') tableSelector = 'table#tbl_select_Feature tbody, table.tbl_select_Module[id="#tbl_select_Feature"] tbody';
            else if (modalType === 'Deliverable') tableSelector = 'table#DeliverableTable tbody, table.delTbl tbody';
            else if (modalType === 'UserStory') tableSelector = 'table#tbl_select_User_Story tbody, table.tbl_select_Module[id="#tbl_select_User_Story"] tbody';
            
            var $table = $(tableSelector);
            if (!$table.length) return;
            
            var visibleCount = 0;
            $table.find('tr').not('.no-data-found').each(function() {
                var $row = $(this);
                var $cells = $row.find('td');
                var matches = false;
                
                if (modalType === 'Milestone' && $cells.length >= 2) {
                    // Filter by both name (first column) and status (second column)
                    var nameText = $cells.eq(0).text().toLowerCase();
                    var statusText = $cells.eq(1).text().toLowerCase();
                    var nameMatch = !filterValue || nameText.indexOf(filterValue) > -1;
                    var statusMatch = !filterValue2 || statusText.indexOf(filterValue2) > -1;
                    matches = nameMatch && statusMatch;
                } else {
                    // Filter by first column only
                    var firstCellText = $cells.first().text().toLowerCase();
                    matches = !filterValue || firstCellText.indexOf(filterValue) > -1;
                }
                
                $row.toggle(matches);
                if (matches) visibleCount++;
            });
            
            // Show "No Data Found" message if no rows visible after filtering
            var $noDataRow = $table.find('tr.no-data-found');
            var totalRows = $table.find('tr').not('.no-data-found').length;
            if (visibleCount === 0 && totalRows > 0) {
                if ($noDataRow.length === 0) {
                    var colspan = $table.find('tr').not('.no-data-found').first().find('td').length || 5;
                    $table.append('<tr class="no-data-found"><td colspan="' + colspan + '" class="text-center py-2">No Data Found</td></tr>');
                } else {
                    $noDataRow.show();
                }
            } else {
                $noDataRow.remove();
            }
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Setup filter handlers for all modal textboxes
        // Commented By Dipali V On 3rd Feb 2026 For W26 - Removed Feature control from Quick Task New page (#doc_Feature removed)
        $(document).on('keyup input', '#doc_Deliverable, #doc_Phase, #doc_milestone, #status_milestone, #doc_Module, #doc_Sub-project, #doc_User_Story', function() {
            var $input = $(this);
            var modalType = '';
            if ($input.attr('id') === 'doc_Deliverable') modalType = 'Deliverable';
            else if ($input.attr('id') === 'doc_Phase') modalType = 'Phase';
            else if ($input.attr('id') === 'doc_milestone' || $input.attr('id') === 'status_milestone') modalType = 'Milestone';
            else if ($input.attr('id') === 'doc_Module') modalType = 'Module';
            else if ($input.attr('id') === 'doc_Sub-project') modalType = 'SubProject';
            //else if ($input.attr('id') === 'doc_Feature') modalType = 'Feature';
            else if ($input.attr('id') === 'doc_User_Story') modalType = 'UserStory';
            
            if (modalType) filterModalTable(modalType);
        });
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Load Sprint/Release for selected UserStory (concise)
        function loadSprintRelease(userStoryId, $row) {
            if (!userStoryId || !$row || !$row.length) return;
            // Added By Dipali V On 3rd Feb 2026 For W26 - Get selected project ID from dropdown (prioritize selected value)
            var selectedProjectId = $('#cboAssignedTaskProject').val();
            if (!selectedProjectId || selectedProjectId === '' || selectedProjectId === '0' || selectedProjectId === 'Select Project') {
                var $selectpicker = $('#cboAssignedTaskProject');
                if ($selectpicker.length && typeof $selectpicker.selectpicker === 'function') {
                    selectedProjectId = $selectpicker.selectpicker('val');
                }
            }
            var projectId = parseInt(selectedProjectId || projectID || '0');
            if (!projectId) return;
            
            var payload = { ProjectID: projectId, UserStoryID: userStoryId, TaskID: null };
            var result = AJAXCallWithResult('api/BulkTaskCreation/GetSprintRelease', JSON.stringify(payload), false);
            
            if (result) {
                // Response: { message: "...", data: { iterationName: "...", releaseName: "...", initialEstimate: 5 } }
                // After normalizeApiResponse extracts data.data: result = { iterationName: "...", releaseName: "...", initialEstimate: 5 }
                // Also handle result.list structure from AssignTask page
                var data = null;
                if (result.list && result.list.length > 0) {
                    data = result.list[0].data?.data || result.list[0].data || result.list[0];
                } else if (result.iterationName !== undefined || result.IterationName !== undefined) {
                    // Direct access after normalizeApiResponse
                    data = result;
                } else if (result.data && (result.data.iterationName !== undefined || result.data.IterationName !== undefined)) {
                    data = result.data;
                } else {
                    data = result.data || result;
                }
                
                if (data) {
                    var sprint = data.iterationName || data.IterationName || '';
                    var release = data.releaseName || data.ReleaseName || '';
                    var storyPoints = data.storyPoints || data.StoryPoints || data.initialEstimate || data.InitialEstimate || '';
                    
                    // Find Sprint and Release inputs by ID pattern (handles dynamic row numbers)
                    var $sprintInput = $row.find('input[id^="txtSprint"]');
                    var $releaseInput = $row.find('input[id^="txtRelease"]');
                    
                    // Fallback: if not found by ID, try finding by column position after UserStory
                    if (!$sprintInput.length || !$releaseInput.length) {
                        var fieldCols = $row.find('td[data-group="field"]');
                        var $userStoryInput = $row.find('input[id^="txtUserStory"]');
                        if ($userStoryInput.length) {
                            var $userStoryCell = $userStoryInput.closest('td[data-group="field"]');
                            var userStoryIndex = fieldCols.index($userStoryCell);
                            if (userStoryIndex >= 0 && userStoryIndex < fieldCols.length - 2) {
                                if (!$sprintInput.length) $sprintInput = fieldCols.eq(userStoryIndex + 1).find('input');
                                if (!$releaseInput.length) $releaseInput = fieldCols.eq(userStoryIndex + 2).find('input');
                            }
                        }
                    }
                    
                    if ($sprintInput && $sprintInput.length) {
                        $sprintInput.val(sprint);
                    }
                    
                    if ($releaseInput && $releaseInput.length) {
                        $releaseInput.val(release);
                    }
                    
                    // Update Story Points in UserStory modal if visible
                    var $storyPointCell = $('table#tbl_select_User_Story tbody tr[data-id="' + userStoryId + '"]').find('td').eq(3);
                    if ($storyPointCell.length && storyPoints) {
                        $storyPointCell.text(storyPoints);
                    }
                }
            }
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Load custom fields for a row (concise)
        function loadCustomFieldsForRow($row, rowNumber) {
            if ($row.find('input[id*="CustomField"], textarea[id*="CustomField"], select[id*="CustomField"]').length > 0) return;
            
            var projectId = parseInt(projectID || $('#cboAssignedTaskProject').val() || '0');
            var userId = parseInt('<%= Session("intUserID") %>' || '0');
            if (!projectId) return;
            
            var payload = { RowID: rowNumber, ProjectID: projectId, UserID: userId };
            var result = AJAXCallWithResult('api/BulkTaskCreation/DrawCustomField', JSON.stringify(payload), false);
            if (result && result.customFields && result.customFields.length > 0) {
                var $customFieldCells = $();
                var headerData = [];
                
                result.customFields.forEach(function(field) {
                    var controlName = field.databaseFieldName + rowNumber;
                    var maxLength = field.maxLength || (field.databaseFieldName && field.databaseFieldName.indexOf('CustomFieldTextArea') > -1 ? 3800 : 100);
                    // Check if field is mandatory: validationRules contains ',1,' or equals '1'
                    var isMandatory = field.validationRules && (field.validationRules.indexOf(',1,') > -1 || field.validationRules.indexOf(',1') > -1 ||  field.validationRules.indexOf('1,') > -1 ||  field.validationRules === '1' || field.validationRules.toString() === '1');
                    var $fieldCell = null;
                    var $fieldControl = null;
                    
                    if (field.fieldType === 'Combo') {
                        var fieldLabel = field.userGivenCaption || field.databaseFieldName || 'field';
                        var selectClass = 'form-control selectpicker' + (isMandatory ? ' required' : '');
                        var $select = $('<select>', {
                            id: controlName,
                            name: controlName,
                            class: selectClass,
                            style: 'width:' + (field.controlWidth || 130) + 'px;',
                            disabled: true,
                            required: isMandatory,
                            'data-validation-rules': field.validationRules || '',
                            'data-field-label': fieldLabel
                        });
                        if (isMandatory) $select.addClass('required');
                        $select.append($('<option>', { value: '', text: 'Select ' + fieldLabel }));
                        if (field.comboOptions) {
                            try {
                                JSON.parse(field.comboOptions).forEach(function(opt) {
                                    $select.append($('<option>', { value: opt.value || '', text: opt.text || opt.value || '' }));
                                });
                            } catch(e) {}
                        }
                        $fieldControl = $select;
                        $fieldCell = $('<td data-group="field">').append($select);
                        setTimeout(function() { 
                            $select.selectpicker({ dropupAuto: false });
                            // Ensure required class is preserved after selectpicker initialization
                            if (isMandatory) {
                                $select.addClass('required');
                                $select.closest('.bootstrap-select').find('.filter-option').addClass('required');
                            }
                        }, 100);
                    } else if (field.fieldType === 'TextArea') {
                        var textareaClass = 'form-control' + (isMandatory ? ' required' : '');
                        var $textarea = $('<textarea>', {
                            id: controlName,
                            name: controlName,
                            class: textareaClass,
                            style: 'width:' + (field.controlWidth || 130) + 'px;height:' + (field.controlHeight || 60) + 'px;',
                            maxlength: maxLength,
                            disabled: true,
                            required: isMandatory,
                            'data-validation-rules': field.validationRules || '',
                            'data-field-label': field.userGivenCaption || field.databaseFieldName || 'field'
                        }).text(field.defaultValue || '');
                        $fieldControl = $textarea;
                        $fieldCell = $('<td data-group="field">').append($textarea);
                    } else if (field.fieldType === 'Date') {
                        var dateClass = 'form-control datepicker' + (isMandatory ? ' required' : '');
                        var $dateInput = $('<input>', {
                            type: 'text',
                            id: controlName,
                            name: controlName,
                            class: dateClass,
                            style: 'width:' + (field.controlWidth || 130) + 'px;',
                            value: field.defaultValue || '',
                            disabled: true,
                            required: isMandatory,
                            'data-validation-rules': field.validationRules || '',
                            'data-field-label': field.userGivenCaption || field.databaseFieldName || 'field'
                        });
                        $fieldControl = $dateInput;
                        $fieldCell = $('<td data-group="field">').append($dateInput);
                        setTimeout(function() { $dateInput.datepicker({ dateFormat: 'dd M yy', changeMonth: true, changeYear: true }); }, 100);
                    } else {
                        var textClass = 'form-control' + (isMandatory ? ' required' : '');
                        var $textInput = $('<input>', {
                            type: 'text',
                            id: controlName,
                            name: controlName,
                            class: textClass,
                            style: 'width:' + (field.controlWidth || 130) + 'px;',
                            maxlength: maxLength,
                            value: field.defaultValue || '',
                            disabled: true,
                            required: isMandatory,
                            'data-validation-rules': field.validationRules || '',
                            'data-field-label': field.userGivenCaption || field.databaseFieldName || 'field'
                        });
                        $fieldControl = $textInput;
                        $fieldCell = $('<td data-group="field">').append($textInput);
                    }
                    
                    // Add asterisk indicator for mandatory fields
                    if (isMandatory && $fieldControl && $fieldCell) {
                        $fieldControl.after('<span class="required" style="display: inline-block; margin-left: 3px;">*</span>');
                    }
                    
                    if ($fieldCell) {
                        $customFieldCells = $customFieldCells.add($fieldCell);
                        var headerLabel = field.userGivenCaption || field.databaseFieldName;
                        // Added By Dipali V On 23rd Jan 2026 For W26 - Removed asterisk from custom field headers
                        // Asterisk is shown next to the field control, not in header
                        headerData.push({ databaseFieldName: field.databaseFieldName, label: headerLabel, isMandatory: isMandatory });
                    }
                });
                
                // Add headers
                var $thead = $('#bulkTaskTbl thead tr');
                headerData.forEach(function(header) {
                    var exists = false;
                    $thead.find('th[data-group="field"]').each(function() {
                        if ($(this).text().trim().toLowerCase() === header.label.toLowerCase()) { exists = true; return false; }
                    });
                    if (!exists) {
                        var $lastHeaders = $thead.find('th[data-group="field"]').slice(-2);
                        if ($lastHeaders.length === 2) $lastHeaders.last().after($('<th data-group="field">' + header.label + '</th>'));
                        else $thead.find('th[data-group="field"]').last().after($('<th data-group="field">' + header.label + '</th>'));
                    }
                });
                
                // Append cells after Release column
                var $lastCells = $row.find('td[data-group="field"]').slice(-2);
                if ($lastCells.length === 2 && $customFieldCells.length > 0) {
                    $lastCells.last().after($customFieldCells);
                }
                
                // Add hidden inputs
                var customFieldList = result.customFieldList || result.customFields.map(function(f) { return f.databaseFieldName; }).join(',');
                if (customFieldList) $row.append($('<input>', { type: 'hidden', id: 'CustomFieldList' + rowNumber, name: 'CustomFieldList' + rowNumber, value: customFieldList }));
                if (result.typeInaccessibleCustomFieldList) $row.append($('<input>', { type: 'hidden', id: 'TypeInaccessibleCustomFieldList' + rowNumber, name: 'TypeInaccessibleCustomFieldList' + rowNumber, value: result.typeInaccessibleCustomFieldList }));
            }
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Handle TaskType change for custom fields (concise)
        function handleTaskTypeChange($taskTypeSelect, taskTypeID, rowNumber) {
            var $row = $taskTypeSelect.closest('tr');
            // Added By Dipali V On 3rd Feb 2026 For W26 - Get selected project ID from dropdown (prioritize selected value)
            var selectedProjectId = $('#cboAssignedTaskProject').val();
            if (!selectedProjectId || selectedProjectId === '' || selectedProjectId === '0' || selectedProjectId === 'Select Project') {
                var $selectpicker = $('#cboAssignedTaskProject');
                if ($selectpicker.length && typeof $selectpicker.selectpicker === 'function') {
                    selectedProjectId = $selectpicker.selectpicker('val');
                }
            }
            var projectId = parseInt(selectedProjectId || projectID || '0');
            var userId = parseInt('<%= Session("intUserID") %>' || '0');
            var roleId = parseInt('<%= Session("intPostID") %>' || '0');
            if (!projectId) return;
            
            var payload = { TaskTypeID: parseInt(taskTypeID) || null, TaskType: isNaN(parseInt(taskTypeID)) ? taskTypeID : null, ProjectID: projectId, UserID: userId, RoleID: roleId };
            var result = AJAXCallWithResult('api/BulkTaskCreation/GetAccessToCustomField', JSON.stringify(payload), false);
            
            if (result && result.customFieldAccess) {
                result.customFieldAccess.split(',').forEach(function(fieldData) {
                    if (!fieldData) return;
                    var parts = fieldData.split('#');
                    if (parts.length >= 3) {
                        var fieldName = parts[0] + rowNumber;
                        var isAssigned = parts[1] == '1';
                        var hasAccess = parts[2] == '1';
                        
                        // Find field by ID (works for input, textarea, select)
                        var $field = $row.find('input[id="' + fieldName + '"], textarea[id="' + fieldName + '"], select[id="' + fieldName + '"]');
                        
                        if ($field.length) {
                            var isSelectPicker = $field.hasClass('selectpicker') || $field.is('select');
                            
                            if (hasAccess) {
                                // Has access: enable if assigned, disable if not assigned
                                if (isAssigned) {
                                    $field.prop('disabled', false);
                                    // For selectpicker, use selectpicker methods
                                    if (isSelectPicker && $field.is('select')) {
                                        setTimeout(function() {
                                            try {
                                                if ($field.data('selectpicker')) {
                                                    $field.selectpicker('enable');
                                                    $field.selectpicker('refresh');
                                                } else {
                                                    $field.prop('disabled', false);
                                                }
                                            } catch(e) {
                                                $field.prop('disabled', false);
                                            }
                                        }, 100);
                                    }
                                } else {
                                    $field.prop('disabled', true).val('');
                                    // For selectpicker, use selectpicker methods
                                    if (isSelectPicker && $field.is('select')) {
                                        setTimeout(function() {
                                            try {
                                                if ($field.data('selectpicker')) {
                                                    $field.selectpicker('disable');
                                                    $field.selectpicker('refresh');
                                                } else {
                                                    $field.prop('disabled', true);
                                                }
                                            } catch(e) {
                                                $field.prop('disabled', true);
                                            }
                                        }, 100);
                                    }
                                }
                            } else {
                                // No access: disable and clear
                                $field.prop('disabled', true).val('');
                                // For selectpicker, use selectpicker methods
                                if (isSelectPicker && $field.is('select')) {
                                    setTimeout(function() {
                                        try {
                                            if ($field.data('selectpicker')) {
                                                $field.selectpicker('disable');
                                                $field.selectpicker('refresh');
                                            } else {
                                                $field.prop('disabled', true);
                                            }
                                        } catch(e) {
                                            $field.prop('disabled', true);
                                        }
                                    }, 100);
                                }
                            }
                        }
                    }
                });
            }
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Setup checkbox handler for modal selection
        function setupModalCheckboxHandler(modalType, inputId) {
            $('.' + modalType + '_mainchck').off('change').on('change', function() {
                var $checkbox = $(this);
                var $row = $checkbox.closest('tr');
                var itemIdRaw = $checkbox.val();
                var itemId = extractNumericID(itemIdRaw);
                var itemName = $row.attr('data-name') || $row.find('td').first().text();
                
                // Uncheck all other checkboxes
                $('.' + modalType + '_mainchck').not($checkbox).prop('checked', false).closest('tr').removeClass('currently_selected');
                
                // Update current row
                if ($checkbox.is(':checked')) {
                    $row.addClass('currently_selected');
                    if (currentRow) {
                        // Try multiple selectors to find the input field
                        var $input = currentRow.find('input[id^="' + inputId + '"]');
                        if (!$input.length && inputId === 'txtDeliverable') {
                            $input = currentRow.find('input.popup-field[id*="Deliverable"]');
                        }
                        //if (!$input.length) {
                        //    $input = currentRow.find('input.popup-field');
                        //}
                        // Added by DipalI v On 3rd sep 2026 - Purpose: do not fall back to all popup-fields (was writing same ID to Deliverable/Phase/Milestone/Module/SubProject)
                        
                        if ($input.length) {
                            //debugger;
                            // Use numeric ID if available, otherwise use raw value
                            var idToSet = itemId !== null ? itemId : (itemIdRaw || null);
                            $input.val(itemName);
                            if (idToSet !== null && idToSet !== undefined && idToSet !== '') {
                                $input.attr('data-selected-id', idToSet);
                                $input.data('selected-id', idToSet);
                            } else {
                                // If no valid ID, still set the value but log a warning
                                console.warn('No valid ID found for ' + modalType + ' selection');
                            }
                            
                            // Added By Dipali V On 23rd Jan 2026 For W26 - Load Sprint/Release when UserStory selected
                            if (modalType === 'UserStory' && itemId) {
                                loadSprintRelease(itemId, currentRow);
                            }
                        } else {
                            console.error('Input field not found for ' + inputId + ' in current row');
                        }
                    } else {
                        console.error('currentRow is not set for ' + modalType + ' modal');
                    }
                    // Close modal after selection
                    setTimeout(function() {
                        var modalId = '#' + currentModalType + 'Modal';
                        $(modalId).modal('hide');
                    }, 500);
                } else {
                    $row.removeClass('currently_selected');
                    if (currentRow) {
                        var $input = currentRow.find('input[id^="' + inputId + '"]');
                        if (!$input.length && inputId === 'txtDeliverable') {
                            $input = currentRow.find('input.popup-field[id*="Deliverable"]');
                        }
                        if ($input.length) {
                            //$input.val('');
                            //$input.removeAttr('data-selected-id');
                            //$input.removeData('selected-id');
                            // Added by DipalI v On 3rd sep 2026 - Purpose: clear mapping field completely on uncheck
                            clearMappingFieldInput($input);
                        }
                    }
                }
            });
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Prevent page refresh on modal close buttons
        $(document).on('click', '.modal .close, .modal button[data-bs-dismiss="modal"]', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var $modal = $(this).closest('.modal');
            if ($modal.length) {
                $modal.modal('hide');
            }
            return false;
        });

        // Added By Dipali V On 3rd Feb 2026 For W26 - Load modal data when project is selected
        $('#cboAssignedTaskProject').on('click', function () {
            var selectedProjectId = $(this).val();
            if (selectedProjectId && selectedProjectId !== '' && selectedProjectId !== '0') {
                // Preload modal data for the selected project (Phase, Milestone, Module, SubProject, Deliverable, UserStory)
                var projectId = parseInt(selectedProjectId);
                var modalTypes = ['Phase', 'Milestone', 'Module', 'SubProject', 'Deliverable', 'UserStory'];
                modalTypes.forEach(function(modalType) {
                    loadModalData(modalType, projectId, {});
                });
            }
        });
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Generic onClick handler for modal fields
        $(document).on('click', 'a[data-bs-toggle="modal"][data-bs-target]', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            var $link = $(this);
            var modalTarget = $link.attr('data-bs-target');
            var $row = $link.closest('tr');
            currentRow = $row;
            
            // Determine modal type from target
            var modalType = null;
            if (modalTarget === '#PhaseModal') modalType = 'Phase';
            else if (modalTarget === '#MilestoneModal') modalType = 'Milestone';
            else if (modalTarget === '#ModuleModal') modalType = 'Module';
            else if (modalTarget === '#SubProjectModal') modalType = 'SubProject';
            // Commented By Dipali V On 3rd Feb 2026 For W26 - Removed Feature control from Quick Task New page
            //else if (modalTarget === '#FeatureModal') modalType = 'Feature';
            else if (modalTarget === '#DeliverableModal') modalType = 'Deliverable';
            else if (modalTarget === '#UserStoryModal') modalType = 'UserStory';
            
            if (!modalType) return false;
            
            currentModalType = modalType;
            
            // Added By Dipali V On 3rd Feb 2026 For W26 - Get project ID from dropdown (prioritize selected value over session variable)
            var selectedProjectId = $('#cboAssignedTaskProject').val();
            // Try selectpicker value if .val() doesn't return a valid value (for Bootstrap-select compatibility)
            if (!selectedProjectId || selectedProjectId === '' || selectedProjectId === '0' || selectedProjectId === 'Select Project') {
                var $selectpicker = $('#cboAssignedTaskProject');
                if ($selectpicker.length && typeof $selectpicker.selectpicker === 'function') {
                    var selectpickerVal = $selectpicker.selectpicker('val');
                    if (selectpickerVal && selectpickerVal !== '' && selectpickerVal !== '0') {
                        selectedProjectId = selectpickerVal;
                    }
                }
            }
            // Fallback to session projectID only if dropdown not selected
            var projectId = parseInt(selectedProjectId || projectID || '0');
            if (!projectId || projectId <= 0) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("C_SelectProjectFirst") %>');
                return false;
            }
            
            // Get additional params from current row if needed
            var additionalParams = {};
            if (modalType === 'Deliverable') {
                var deliverableIdRaw = $row.find('input[id^="txtDeliverable"]').attr('data-selected-id');
                var deliverableId = extractNumericID(deliverableIdRaw);
                if (deliverableId) additionalParams.DeliverableID = deliverableId;
            }
            
            // Remove previous event listener to avoid duplicates
            $(modalTarget).off('shown.bs.modal');
            
            // Load data when modal is shown
            $(modalTarget).on('shown.bs.modal', function() {
                loadModalData(modalType, projectId, additionalParams);
            });
            
            // Show modal
            $(modalTarget).modal('show');
            
            return false;
        });
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Handle Select button clicks in modals
        // Commented By Dipali V On 3rd Feb 2026 For W26 - Removed Feature control from Quick Task New page (#btnShowFeature removed)
        $(document).on('click', '#btnShowPhase, #btnShowMilestone, #btnShowModule, #btnShowSubProject, #btnShowDeliverable, #btnShowUserStory', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var $btn = $(this);
            var modalType = null;
            if ($btn.attr('id') === 'btnShowPhase') modalType = 'Phase';
            else if ($btn.attr('id') === 'btnShowMilestone') modalType = 'Milestone';
            else if ($btn.attr('id') === 'btnShowModule') modalType = 'Module';
            else if ($btn.attr('id') === 'btnShowSubProject') modalType = 'SubProject';
            //else if ($btn.attr('id') === 'btnShowFeature') modalType = 'Feature';
            else if ($btn.attr('id') === 'btnShowDeliverable') modalType = 'Deliverable';
            else if ($btn.attr('id') === 'btnShowUserStory') modalType = 'UserStory';
            
            if (!modalType) return;
            
            var projectId = parseInt(projectID || $('#cboAssignedTaskProject').val() || '0');
            if (!projectId || projectId <= 0) {
                alertify.error('<%= MyBase.GetResourceString("C_SelectProjectFirst") %>');
                return;
            }
            
            var searchValue = $('#doc_' + modalType).val() || $('#doc_Deliverable').val() || $('#doc_User_Story').val() || '';
            var additionalParams = {};
            if (searchValue) {
                if (modalType === 'Phase') additionalParams.Phase = searchValue;
                else if (modalType === 'Milestone') additionalParams.Milestone = searchValue;
                else if (modalType === 'Module') additionalParams.Module = searchValue;
                else if (modalType === 'SubProject') additionalParams.SubProject = searchValue;
                else if (modalType === 'Feature') additionalParams.Feature = searchValue;
                else if (modalType === 'Deliverable') additionalParams.Deliverable = searchValue;
                else if (modalType === 'UserStory') additionalParams.UserStory = searchValue;
            }
            
            loadModalData(modalType, projectId, additionalParams);
        });
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Handle Unselect button clicks in modals
        // Commented By Dipali V On 3rd Feb 2026 For W26 - Removed Feature control from Quick Task New page (#btnUnselectFeature removed)
        $(document).on('click', '#btnUnselectPhase, #btnUnselectMilestone, #btnUnselectModule, #btnUnselectSubProject, #btnUnselectDeliverable, #btnUnselectUserStory', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var $btn = $(this);
            var modalType = null;
            var inputId = null;
            
            if ($btn.attr('id') === 'btnUnselectPhase') { modalType = 'Phase'; inputId = 'txtPhase'; }
            else if ($btn.attr('id') === 'btnUnselectMilestone') { modalType = 'Milestone'; inputId = 'txtMilestone'; }
            else if ($btn.attr('id') === 'btnUnselectModule') { modalType = 'Module'; inputId = 'txtModule'; }
            else if ($btn.attr('id') === 'btnUnselectSubProject') { modalType = 'SubProject'; inputId = 'txtSubProject'; }
            //else if ($btn.attr('id') === 'btnUnselectFeature') { modalType = 'Feature'; inputId = 'txtFeature'; }
            else if ($btn.attr('id') === 'btnUnselectDeliverable') { modalType = 'Deliverable'; inputId = 'txtDeliverable'; }
            else if ($btn.attr('id') === 'btnUnselectUserStory') { modalType = 'UserStory'; inputId = 'txtUserStory'; }
            
            if (!modalType || !currentRow) return;
            
            // Uncheck all checkboxes
            $('.' + modalType + '_mainchck').prop('checked', false).closest('tr').removeClass('currently_selected');
            
            // Clear input field
            var $input = currentRow.find('input[id^="' + inputId + '"]');
            //if ($input.length) {
            //    $input.val('');
            //    $input.removeAttr('data-selected-id');
            //    $input.removeData('selected-id');
            //}
            // Added by DipalI v On 3rd sep 2026 - Purpose: clear mapping field completely on Unselect
            clearMappingFieldInput($input);
        });
       
        $(document).ready(function () {
            //debugger;
            // Added By Dipali V On 23rd Jan 2026 For W26 - Show/hide buttons based on access
            if (AddAccess == "True") {
                $('#divAddTaskBtn, #divCreateTaskBtn').show();
            } else {
                $('#divAddTaskBtn, #divCreateTaskBtn').hide();
            }
            
            // Initialize tooltips
             if (ViewAccess == "False") {
                 var bodyHTML = '';
                 bodyHTML = '<div style="text-align:center;background-color:white;margin-top:15%;"><b style="margin-top:6%;"><center><%= MyBase.GetResourceString("C_NotAuthorized") %></center></b></div>';
                 $("#divMain").html(bodyHTML);
                 return;
             }
            //$("[data-bs-toggle='tooltip'], [data-bs-toggle='collapse'], [data-bs-toggle='dropdown']").tooltip();
            $("[data-bs-toggle='tooltip']").tooltip();
            // Handle note accordion toggle
            // When expanding (showing) - show up arrow, hide down arrow
            $('#collapseOne').on('show.bs.collapse', function () {
                $('#headingOne .collapseup').show();
                $('#headingOne .collapsedown').hide();
                $('#headingOne').attr('aria-expanded', 'true');
            })
            // When collapsing (hiding) - show down arrow, hide up arrow
            .on('hide.bs.collapse', function () {
                $('#headingOne .collapseup').hide();
                $('#headingOne .collapsedown').show();
                $('#headingOne').attr('aria-expanded', 'false');
            });
            
            // Manually handle the click to ensure collapse works both ways
            $('#headingOne').off('click').on('click', function(e) {
                e.preventDefault();
                var target = $('#collapseOne');
                var isExpanded = $(this).attr('aria-expanded') === 'true';
                
                if (isExpanded) {
                    target.collapse('hide');
                } else {
                    target.collapse('show');
                }
            });

            // Initialize selectpickers - destroy any existing first
            $('.selectpicker').selectpicker('destroy');
            
            // Initialize project dropdown with custom search behavior
            if (typeof $.fn.selectpicker !== 'undefined') {
                $('#cboAssignedTaskProject').selectpicker({
                    liveSearch: true,
                    liveSearchStyle: 'startsWith',
                    dropupAuto: false
                });

                // Initialize other selectpickers with dropupAuto: false to open downward
                $('.selectpicker:not(#cboAssignedTaskProject)').selectpicker({
                    dropupAuto: false
                });
                
                // Add event handler to sync selectpicker value to underlying select element
                $(document).on('changed.bs.select', '.selectpicker', function(e) {
                    var $select = $(this);
                    var selectedValue = $select.selectpicker('val');
                    // Ensure the underlying select element has the selected value
                    if (selectedValue !== null && selectedValue !== undefined) {
                        if (Array.isArray(selectedValue)) {
                            $select.val(selectedValue);
                        } else {
                            $select.val(selectedValue);
                        }
                    }
                    // Handle TaskType change for custom fields
                    if ($select.attr('aria-label') === 'Select Task Type') {
                        var $row = $select.closest('tr');
                        var rowNumber = $row.index() + 1;
                        var taskTypeID = selectedValue;
                        if (taskTypeID && taskTypeID !== '' && taskTypeID !== '0') {
                            handleTaskTypeChange($select, taskTypeID, rowNumber);
                        }
                    }
                });
                
                // Pre-select project from session if available
                var SessionProjectID = '<%= Session("intProjectID") %>';
                if (SessionProjectID != null && SessionProjectID != undefined && SessionProjectID != "" && SessionProjectID != "0") {
                    jQuery("select#cboAssignedTaskProject option[value=" + SessionProjectID + "]").attr("selected", "selected");
                    $('#cboAssignedTaskProject').selectpicker('refresh');
                    
                    // Added By Dipali V On 23rd Jan 2026 For W26 - Load dropdown data for default row after a short delay to ensure DOM is ready
                    setTimeout(function() {
                        // Load project type flags first, then lookups
                        if (typeof loadProjectTypeFlags === 'function') {
                            loadProjectTypeFlags(parseInt(SessionProjectID));
                        }
                        loadQuickTaskLookups(parseInt(SessionProjectID));
                        // Load custom fields and apply mandatory asterisks for initial/default row
                        setTimeout(function() {
                            var $initialRow = $('#bulkTaskTbl tbody tr:first');
                            if ($initialRow.length > 0) {
                                // Added By Dipali V On 3rd Feb 2026 For W26 - Set billable checkbox for default row based on project billable flag
                                if (window.currentProjectBillableStatus !== undefined) {
                                    $initialRow.find('[id^="IsBillablecheckbox"]').prop('checked', window.currentProjectBillableStatus);
                                }
                                if (typeof applyMandatoryAsterisksToRow === 'function') {
                                    applyMandatoryAsterisksToRow($initialRow);
                                }
                                if (typeof loadCustomFieldsForRow === 'function') {
                                    loadCustomFieldsForRow($initialRow, 1);
                                }
                            }
                        }, 500);
                    }, 300);
                    
                    // Trigger project change to load data
                   // if (typeof ProjectonChange === 'function') {
                        //ProjectonChange();
                   // }
                }
            }
        }); // End of document.ready
        
        // Added By Dipali V On 3rd Feb 2026 For W26 - ProjectonChange function called from HTML onchange attribute (defined outside document.ready for global access)
        function ProjectonChange() {
            var selectedProjectId = $('#cboAssignedTaskProject').val();
            if (selectedProjectId && selectedProjectId !== '' && selectedProjectId !== '0') {
                var projectId = parseInt(selectedProjectId);
                // Added by DipalI v On 3rd sep 2026 - Purpose: clear previous project's Deliverable/Phase/Milestone/Module/SubProject mappings so they are not inserted for new project tasks
                clearAllModalCheckboxes();
                clearRowWbsMappings($('#bulkTaskTbl tbody'));
                // Load project type flags first, then lookups
                if (typeof loadProjectTypeFlags === 'function') {
                    loadProjectTypeFlags(projectId);
                }
                loadQuickTaskLookups(projectId);
                
                // Load modal data for selected project (Phase, Milestone, Module, SubProject, Deliverable, UserStory)
                var modalTypes = ['Phase', 'Milestone', 'Module', 'SubProject', 'Deliverable', 'UserStory'];
                modalTypes.forEach(function(modalType) {
                    loadModalData(modalType, projectId, {});
                });
                
                // Apply mandatory asterisks and load custom fields for default row when project changes
                setTimeout(function() {
                    var $defaultRow = $('#bulkTaskTbl tbody tr:first');
                    if ($defaultRow.length > 0) {
                        // Added By Dipali V On 3rd Feb 2026 For W26 - Set billable checkbox for default row based on project billable flag
                        if (window.currentProjectBillableStatus !== undefined) {
                            $defaultRow.find('[id^="IsBillablecheckbox"]').prop('checked', window.currentProjectBillableStatus);
                        }
                        if (typeof applyMandatoryAsterisksToRow === 'function') {
                            applyMandatoryAsterisksToRow($defaultRow);
                        }
                        if (typeof loadCustomFieldsForRow === 'function') {
                            loadCustomFieldsForRow($defaultRow, 1);
                        }
                    }
                }, 500);
            } else {
                projectTypeFlags = null;
                qtLookups.resources = [];
                qtLookups.taskTypes = [];
                applyLookupOptionsToAllRows();
                // Added by DipalI v On 3rd sep 2026 - Purpose: clear WBS mappings when project is cleared
                clearAllModalCheckboxes();
                clearRowWbsMappings($('#bulkTaskTbl tbody'));
            }
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Handle project change to reload dropdown data (jQuery event handler)
        $(document).on('change', '#cboAssignedTaskProject', function() {
            ProjectonChange();
        });

        // Added By Dipali V On 23rd Jan 2026 For W26 - Apply hidden columns to a newly added row
        // Added By Dipali V On 23rd Jan 2026 For W26 - Helper function to check if a value indicates "Show"
        function isShowEnabled(value) {
            if (value === false || value === 0 || value === 'false' || value === '0' || value === 'False' || value === 'FALSE' || value === null || value === undefined) {
                return false;
            }
            if (value === true || value === 1 || value === 'true' || value === '1' || value === 'True' || value === 'TRUE') {
                return true;
            }
            return false;
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Helper function to hide a column
        function hideColumn(columnName) {
            var found = false;
            function normalizeColumnText(text) {
                return text.replace(/\*/g, '').replace(/\s+/g, ' ').trim();
            }
            
            $('#bulkTaskTbl thead th').each(function() {
                var $th = $(this);
                var text = $th.text().trim();
                var normalizedText = normalizeColumnText(text);
                var normalizedColumnName = normalizeColumnText(columnName);
                
                if (text === columnName || normalizedText === normalizedColumnName || 
                    normalizedText.indexOf(normalizedColumnName) !== -1 || 
                    normalizedColumnName.indexOf(normalizedText) !== -1) {
                    found = true;
                    var colIndex = $th.index();
                    $th.addClass('column-hidden').hide().attr('style', 'display: none !important;');
                    $('#bulkTaskTbl tbody tr').each(function() {
                        var $td = $(this).find('td').eq(colIndex);
                        if ($td.length) {
                            $td.addClass('column-hidden').hide().attr('style', 'display: none !important;');
                        }
                    });
                    $('#bulkTaskTbl thead th:nth-child(' + (colIndex + 1) + ')').addClass('column-hidden').hide().attr('style', 'display: none !important;');
                    $('#bulkTaskTbl tbody tr td:nth-child(' + (colIndex + 1) + ')').addClass('column-hidden').hide().attr('style', 'display: none !important;');
                }
            });
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Helper function to show a column
        function showColumn(columnName) {
            var found = false;
            function normalizeColumnText(text) {
                return text.replace(/\*/g, '').replace(/\s+/g, ' ').trim();
            }
            
            $('#bulkTaskTbl thead th').each(function() {
                var $th = $(this);
                var text = $th.text().trim();
                var normalizedText = normalizeColumnText(text);
                var normalizedColumnName = normalizeColumnText(columnName);
                
                if (text === columnName || normalizedText === normalizedColumnName || 
                    normalizedText.indexOf(normalizedColumnName) !== -1 || 
                    normalizedColumnName.indexOf(normalizedText) !== -1) {
                    found = true;
                    var colIndex = $th.index();
                    $th.removeClass('column-hidden').removeAttr('style').show();
                    $('#bulkTaskTbl tbody tr').each(function() {
                        var $td = $(this).find('td:nth-child(' + (colIndex + 1) + ')');
                        $td.removeClass('column-hidden').removeAttr('style').show();
                    });
                }
            });
        }
        
        function applyHiddenColumnsToRow($row) {
            if (!$row || !$row.length) return;
            $('#bulkTaskTbl thead th.column-hidden').each(function() {
                var colIndex = $(this).index();
                var $td = $row.find('td').eq(colIndex);
                if ($td.length) {
                    $td.addClass('column-hidden').hide().attr('style', 'display: none !important;');
                }
            });
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Apply lookup options to row (Resources, TaskTypes, Priorities)
        function applyLookupOptionsToRow($row) {
            if (!$row || !$row.length) return;
            var fieldCols = $row.find('td[data-group="field"]');
            var lookups = [
                { label: Resources.C_SelectResource, index: 2, key: 'resources' },
                { label: Resources.C_SelectTaskType, index: 7, key: 'taskTypes' },
                { label: Resources.C_SelectPriority, index: 8, key: 'priorities' }
            ];
            lookups.forEach(function(lookup) {
                var $sel = $row.find('select[aria-label="' + lookup.label + '"]');
                if (!$sel.length) $sel = fieldCols.eq(lookup.index).find('select');
                if ($sel.length && $sel.is('select')) {
                    if (!$sel.hasClass('selectpicker')) $sel.addClass('selectpicker');
                    fillSelect($sel, qtLookups[lookup.key] || []);
                }
            });
        }


        // Added By Dipali V On 23rd Jan 2026 For W26 - Load Project Type Flags (concise)
        function loadProjectTypeFlags(projectID) {
            //debugger;
            if (!projectID || projectID <= 0) {
                projectTypeFlags = null;
                currentProjectTypeID = null;
                GisAgileMethodFollowed = false;
                // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Reset EstimatedEfforts when project is cleared
                window.projectEstimatedEfforts = null;
                window.EstimatedEffortsDisplay = null;
                // Hide Agile columns when no project selected
                if (typeof hideColumn === 'function') {
                    hideColumn('User Story');
                    hideColumn('Sprint');
                    hideColumn('Release');
                }
                return;
            }
            
            var payload = { projectTypeID: null, projectID: projectID };
            var result = AJAXCallWithResult('api/BulkTaskCreation/GetProjectTypesFlags', JSON.stringify(payload), false);
            
            if (result) {
                var projectTypes = null;
                // Handle various response structures
               // if (result.data && result.data.ProjectTypes) projectTypes = result.data.ProjectTypes;
               // else if (result.data && result.data.data && result.data.data.ProjectTypes) projectTypes = result.data.data.ProjectTypes;
               // else if (result.ProjectTypes) projectTypes = result.ProjectTypes;
               // else if (Array.isArray(result)) projectTypes = result;
                projectTypes = result.projectTypes;
                if (projectTypes && projectTypes.length > 0) {
                    projectTypeFlags = result.projectTypes;
                    currentProjectTypeID = projectTypes[0].ProjectTypeID || projectTypes[0].projectTypeID || projectTypes[0].TypeID || projectTypes[0].typeID;
                    
                    // Extract GisAgileMethodFollowed flag (check multiple property name variations)
                    var projectType = projectTypes[0];
                    GisAgileMethodFollowed = projectType.GisAgileMethodFollowed !== undefined ? projectType.GisAgileMethodFollowed :
                                           (projectType.gisAgileMethodFollowed !== undefined ? projectType.gisAgileMethodFollowed :
                                           (projectType.IsAgileMethodFollowed !== undefined ? projectType.IsAgileMethodFollowed :
                                           (projectType.isAgileMethodFollowed !== undefined ? projectType.isAgileMethodFollowed : false)));
                    
                    // Added By Dipali V On 3rd Feb 2026 For W26 - Extract GisProjectBillable flag and set billable checkbox state
                    var GisProjectBillable = projectType.GisProjectBillable !== undefined ? projectType.GisProjectBillable :
                                           (projectType.gisProjectBillable !== undefined ? projectType.gisProjectBillable :
                                           (projectType.Billable !== undefined ? projectType.Billable :
                                           (projectType.billable !== undefined ? projectType.billable : false)));
                    window.currentProjectBillableStatus = GisProjectBillable === true || GisProjectBillable === 1 || GisProjectBillable === 'true' || GisProjectBillable === '1';
                    
                    // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Store EstimatedEfforts from API response for work hours validation
                    window.projectEstimatedEfforts = projectType.EstimatedEfforts || projectType.estimatedEfforts || projectType.EstimatedEffort || projectType.estimatedEffort || null;
                    window.EstimatedEffortsDisplay = projectType.EstimatedEffortsDisplay || projectType.estimatedEffortsDisplay || projectType.estimatedEffortsDisplay || projectType.estimatedEffortsDisplay || null;

                    // Set billable checkbox for default row
                    $('#IsBillablecheckbox').prop('checked', window.currentProjectBillableStatus);
                    
                    //debugger;
                    // Show/hide Agile columns based on flag
                    if (typeof isShowEnabled === 'function' && typeof showColumn === 'function' && typeof hideColumn === 'function') {
                        if (isShowEnabled(GisAgileMethodFollowed)) {
                            showColumn('User Story');
                            showColumn('Sprint');
                            showColumn('Release');
                        } else {
                            hideColumn('User Story');
                            hideColumn('Sprint');
                            hideColumn('Release');
                        }
                    }
                }
            }
        }
        var GisAgileMethodFollowed = false;
        // Added By Dipali V On 23rd Jan 2026 For W26 - Get mandatory flags from project type (concise)
        function getMandatoryFlags() {
            var flags = {
                isPhaseMandatory: 0,
                isModuleMandatory: 0,
                isMilestoneMandatory: 0,
                isSubProjectMandatory: 0,
                isCRMandatory: 0,
                isFeatureMandatory: 0,
                isDeliverableMandatory: 0,
                isEstimationTypeMandatory: 0
            };
            
            if (!projectTypeFlags) return flags;
            
            var projectType = null;
            if (projectTypeFlags.data && projectTypeFlags.data.ProjectTypes && projectTypeFlags.data.ProjectTypes.length > 0) {
                projectType = projectTypeFlags.data.ProjectTypes[0];
            } else if (projectTypeFlags.ProjectTypes && projectTypeFlags.ProjectTypes.length > 0) {
                projectType = projectTypeFlags.ProjectTypes[0];
            } else if (projectTypeFlags.projectTypes && projectTypeFlags.projectTypes.length > 0) {
                projectType = projectTypeFlags.projectTypes[0];
            } else if (Array.isArray(projectTypeFlags) && projectTypeFlags.length > 0) {
                projectType = projectTypeFlags[0];
            }
            
            if (projectType) {
                flags.isPhaseMandatory = (projectType.PhaseMandatoryInAT === true || projectType.phaseMandatoryInAT === true || projectType.PhaseMandatoryInAT === 1 || projectType.phaseMandatoryInAT === 1) ? 1 : 0;
                flags.isModuleMandatory = (projectType.ModuleMandatoryInAT === true || projectType.moduleMandatoryInAT === true || projectType.ModuleMandatoryInAT === 1 || projectType.moduleMandatoryInAT === 1) ? 1 : 0;
                flags.isMilestoneMandatory = (projectType.MilestoneMandatoryInAT === true || projectType.milestoneMandatoryInAT === true || projectType.MilestoneMandatoryInAT === 1 || projectType.milestoneMandatoryInAT === 1) ? 1 : 0;
                flags.isSubProjectMandatory = (projectType.SubProjectMandatoryInAT === true || projectType.subProjectMandatoryInAT === true || projectType.SubProjectMandatoryInAT === 1 || projectType.subProjectMandatoryInAT === 1) ? 1 : 0;
                flags.isCRMandatory = (projectType.ChangeRequestMandatoryInAT === true || projectType.changeRequestMandatoryInAT === true || projectType.ChangeRequestMandatoryInAT === 1 || projectType.changeRequestMandatoryInAT === 1) ? 1 : 0;
                flags.isFeatureMandatory = (projectType.FeatureMandatoryInAT === true || projectType.featureMandatoryInAT === true || projectType.FeatureMandatoryInAT === 1 || projectType.featureMandatoryInAT === 1) ? 1 : 0;
                flags.isDeliverableMandatory = (projectType.DeliverableMandatoryInAT === true || projectType.deliverableMandatoryInAT === true || projectType.DeliverableMandatoryInAT === 1 || projectType.deliverableMandatoryInAT === 1) ? 1 : 0;
                flags.isEstimationTypeMandatory = (projectType.EstimationTypeMandatoryInAT === true || projectType.estimationTypeMandatoryInAT === true || projectType.EstimationTypeMandatoryInAT === 1 || projectType.estimationTypeMandatoryInAT === 1) ? 1 : 0;
                GisAgileMethodFollowed = (projectType.isAgileMethodFollowed === true || projectType.isAgileMethodFollowed === true || projectType.isAgileMethodFollowed === 1 || projectType.isAgileMethodFollowed === 1) ? 1 : 0;
            }
            
            return flags;
        }
        var Gflags
        // Added By Dipali V On 23rd Jan 2026 For W26 - Apply mandatory asterisks to row
        function applyMandatoryAsterisksToRow($row) {
            if (!$row || !$row.length) return;
            if (typeof getMandatoryFlags !== 'function') return;
            
            var flags = getMandatoryFlags();
            Gflags=flags;
            if (!flags) return;
            
            // Apply asterisks and required class based on mandatory flags
            if (flags.isPhaseMandatory === 1) applyMandatoryAsteriskToField($row, 'txtPhase', 1);
            if (flags.isMilestoneMandatory === 1) applyMandatoryAsteriskToField($row, 'txtMilestone', 1);
            if (flags.isModuleMandatory === 1) applyMandatoryAsteriskToField($row, 'txtModule', 1);
            if (flags.isSubProjectMandatory === 1) applyMandatoryAsteriskToField($row, 'txtSubProject', 1);
            //if (flags.isCRMandatory === 1) applyMandatoryAsteriskToField($row, 'txtChangeRequest', 1);
            // Commented By Dipali V On 3rd Feb 2026 For W26 - Removed Feature control from Quick Task New page
            //if (flags.isFeatureMandatory === 1) applyMandatoryAsteriskToField($row, 'txtFeature', 1);
            if (flags.isDeliverableMandatory === 1) applyMandatoryAsteriskToField($row, 'txtDeliverable', 1);
            if (GisAgileMethodFollowed === 1) applyMandatoryAsteriskToField($row, 'txtUserStory', 1);
            //if (flags.isEstimationTypeMandatory === 1) applyMandatoryAsteriskToField($row, 'txtEstimationType', 1);
        }

        // Added By Dipali V On 23rd Jan 2026 For W26 - Helper to apply mandatory asterisk and required class to a field
        // Added By Dipali V On 23rd Jan 2026 For W26 - Helper to apply mandatory asterisk and required class to a field
        function applyMandatoryAsteriskToField($row, inputIdPrefix, isMandatory) {
            if (isMandatory !== 1 && isMandatory !== true) return;
            var $input = $row.find('input[id^="' + inputIdPrefix + '"]');
            if ($input.length) {
                // Add required class to the input field
                $input.addClass('required');
                $input.attr('required', true);
                
                var $cell = $input.closest('td[data-group="field"]');
                // Check if asterisk span already exists (not the input's required class)
                if ($cell.length && $cell.find('span.required').length === 0 && $cell.is(':visible') && !$cell.hasClass('column-hidden')) {
                    // Add asterisk indicator after the input
                    $input.after('<span class="required" style="display: inline-block; margin-left: 3px;">*</span>');
                }
            }
        }


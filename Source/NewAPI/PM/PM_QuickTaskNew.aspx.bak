
<%@ Page Language="vb" AutoEventWireup="false" CodeBehind="PM_QuickTaskNew.aspx.vb" Inherits="Whizible.PM_QuickTaskNew" %>
<!DOCTYPE html>
<html>
    <!-- Commented by Gauri on 13/08/24 for JQuery and Bootstrap version upgrade -->
   <%CommonFunctions.General.PlotPageHeadTag(MyBase.GetResourceString("C_PageName"))%>

    <!-- End of Commented by Gauri on 13/08/24 for JQuery and Bootstrap version upgrade -->
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title><%= MyBase.GetResourceString("C_PageTitle") %></title>
    <!-- Tell the browser to be responsive to screen width -->
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <link rel="stylesheet" href="../../../Whizible2.0-new/dist/css/jquery-ui-1.13.2.min.css">
    <link rel="stylesheet" href="../../../Whizible2.0-new/bootstrap/css/bootstrap-5.3.2.min.css">
    <link rel="stylesheet" href="../../../Whizible2.0-new/bootstrap/css/bootstrap-select.min.css">
    <link rel="stylesheet" href="../../../Whizible2.0-new/fontawesome/css/all.css">
    <link rel="stylesheet" href="../../../Whizible2.0-new/dist/css/whiz20_theme.css?v=0.1">
    <link rel="stylesheet" href="../../../Whizible2.0-new/dist/css/BS5_migration.css?v=0.1">
    <link rel="stylesheet" href="../../../Whizible2.0-new/dist/css/style_custom.css">
    <link rel="stylesheet" href="../../../Whizible2.0-new/dist/css/custom.css">
    <link rel="stylesheet" href="../../../Whizible2.0-new/dist/css/style_custom_project.css">
    <link rel="stylesheet" href="../../../Whizible2.0-new/dist/css/media_queries.css?v=2">
    <link rel="stylesheet" href="../../../Whizible2.0-new/plugins/alertify/css/alertify.min.css" />
    <link href="../../../Whizible2.0-new/dist/css/PM_BulkTask.css" rel="stylesheet" />
   
    
   
</head>
<body class="hold-transition skin-blue-light sidebar-mini fixed">
      <div id="divMain">
    <form id="form1">
       
        
        <div class="bgwhite">
           <%-- Commented By Dipali V on 21st jan 2026 for W26 changes--%>
            <!-- Header Section with Icon and Subtitle -->
           <%-- <div style="background: white; padding: 1rem 0;">
                <div style="padding-left: 1rem; margin-left: 0;">
                    <h2 style="color: #1e40af; font-weight: normal; font-size: 18px; margin: 0 0 0.25rem 0; display: flex; align-items: center;">
                        <i class="fas fa-tasks" style="color: #1e40af; font-size: 1.5rem; margin-right: 0.75rem;"></i>
                        <%= MyBase.GetResourceString("C_HeaderTitle") %>
                    </h2>
                    <p style="color: #6b7280; font-size: 0.7rem; margin: 0;"><%= MyBase.GetResourceString("C_HeaderSubtitle") %></p>
                </div>
            </div>--%>
             <%--End of Commented By Dipali V on 21st jan 2026 for W26 changes--%>
            <!-- Action Section -->
            <div style="background: rgb(231, 237, 240); padding: 0.5rem 1rem; margin-left: 2px;">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;">
                    <!-- Left Side - Project Dropdown -->
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <label style="color: #374151; font-size: 12px; font-weight: 500; margin: 0;"><%= MyBase.GetResourceString("C_SelectProject") %></label>
                        <div style="min-width: 200px;">
                            <%--<%CommonFunctions.HTMLControls.DrawComboBox("cboAssignedTaskProject", "usp_Whizible2_Sel_AccessibleProjects_LoginResource " & Session("intUserID") & ", '" & Session("LoginType") & "', 1, 0,'[Over] = ''0''','ProjectName ASC'",,, "onchange='ProjectonChange();' class='selectpicker' data-live-search='true'",,,) %>--%>
                            <%=CommonFunctions.HTMLControls.DrawComboBox("cboAssignedTaskProject", "usp_Whizible2_Sel_AccessibleProjects_WithSelected " & Session("intUserID") & ",'" & Session("LoginType") & "',1,0,'[Over] = ''0''','ProjectName ASC'," & IIf(String.IsNullOrEmpty(Convert.ToString(Session("intProjectID"))) OrElse Convert.ToString(Session("intProjectID")) = "0", "NULL", Session("intProjectID")),,, "onchange='ProjectonChange();' class='selectpicker' data-live-search='true' data-width='260px'",,,) %>
                        </div>
                    </div>
                    <div id="divCreateTaskBtn" style="display: none;">
                        <a href="javascript:;" class="btn borderbtn text-end mr-5" id="btnCreateTask" onclick="createtask()" style="cursor: auto;"><%= MyBase.GetResourceString("C_CreateTask") %></a>
                    </div>
                </div>
            </div>
           
            <div class="content">

                <div class="panel-group profitabilityinfopanel mb-3" id="accordion" role="tablist" aria-multiselectable="true">
                    <div class="panel panel-default panel-horizontal graybg p-0">
                        <div class="panel-heading" role="tab" id="headingOne" aria-expanded="true" aria-controls="collapseOne">
                            <h4 class="panel-title" style="font-weight: normal;">
                                <a role="button" style="cursor: pointer; font-weight: normal;">
                                    <span class="infoToggler togglerdown float-end">
                                        <i class="fas fa-chevron-up collapseup" style="display: inline;" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= MyBase.GetResourceString("C_HideDetails") %>"></i>
                                        <i class="fas fa-chevron-down collapsedown" style="display: none;" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= MyBase.GetResourceString("C_ViewDetails") %>"></i>
                                    </span>
                                    <i class="far fa-lightbulb noteIcon me-1"></i>
                                    <%= MyBase.GetResourceString("C_Note") %>
                                </a>
                            </h4>
                        </div>
                        <div id="collapseOne" class="panel-collapse collapse show bgwhite" role="tabpanel" aria-labelledby="headingOne">
                            <div class="panel-body" style="text-align: left !important; padding: 15px !important;">
                                <!-- Added By Dipali V On 23rd Jan 2026 For W26 - Display notes in horizontal row -->
                               <div class="notebox mb-0 p-0" style="text-align: left !important; padding: 10px !important;">
                                <strong>1.</strong> <%= MyBase.GetResourceString("C_NoteItem1") %>&nbsp;&nbsp;
                                <strong>2.</strong> <%= MyBase.GetResourceString("C_NoteItem2") %>&nbsp;&nbsp;
                                <strong>3.</strong> <%= MyBase.GetResourceString("C_NoteItem3") %>&nbsp;&nbsp;
                                <strong>4.</strong> The Copy option will be enabled once the row data is validated.
                            </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- Add New Task Button -->
                <div id="divAddTaskBtn" style="padding: 0.5rem 0; margin-bottom: 0.5rem; display: none;">
                    <a href="javascript:;" id="addActionTypeRow" class="btn borderbtn addrowbtn" onclick="FUNaddtaskaction()">
                        <i class="fas fa-plus"></i> <%= MyBase.GetResourceString("C_AddNewTask") %>
                    </a>
                </div>
                <input type="hidden" id="ProcessGroupID"  value="0"/>
                <div class="table-responsive">
                    <div class="scrollTable freezeColumns" id="">
                        <table id="bulkTaskTbl" class="table table-stripped table-bordered bulkTaskTable">
                            <thead class="">
                                <tr>
                                    <th data-group="action"><%= MyBase.GetResourceString("C_Action") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_TaskName") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_TaskNote") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_Resource") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_WorkHM") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_IsBillable") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_StartDate") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_EndDate") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_TaskType") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_Priority") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_Deliverable") %></th>
                                    <%-- Added By Dipali V On 3rd Feb 2026 For W26 - Hide Phase field without impacting functionality --%>
                                    <th data-group="field" ><%= MyBase.GetResourceString("C_Phase") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_Milestone") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_Module") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_SubProject") %></th>
                                    <%--<th data-group="field"><%= MyBase.GetResourceString("C_ChangeRequest") %></th>--%>
                                    <%-- Commented By Dipali V On 3rd Feb 2026 For W26 - Removed Feature control from Quick Task New page --%>
                                    <%--<th data-group="field"><%= MyBase.GetResourceString("C_Feature") %></th>--%>
                                    <%--<th data-group="field"><%= MyBase.GetResourceString("C_EstimationType") %></th>--%>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_UserStory") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_Sprint") %></th>
                                    <th data-group="field"><%= MyBase.GetResourceString("C_Release") %></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td data-group="action">
                                       <%-- <div class="actionlinks mb-1">
                                            <a href="javascript:;" class="Icnvalidation" style="display: none;"><i class="fas fa-times validationIcon" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-container="body" title="<%= MyBase.GetResourceString("C_CheckValidation") %>"></i></a>
                                        </div>--%>
                                        <div class="actionlinks">
                                            <%-- Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Add warning icon for ValidationType=Warning --%>
                                            <a href="javascript:;" class="Icnvalidation" style="display: none;"><i class="fas fa-times validationIcon" style="color: #dc3545;" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-container="body" title="<%= MyBase.GetResourceString("C_CheckValidation") %>"></i></a>
                                            <a href="javascript:;" class="Icnwarning" style="display: none;"><i class="fas fa-exclamation-triangle validationIcon" style="color: #ff9800;" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-container="body" title="<%= MyBase.GetResourceString("C_CheckValidation") %>"></i></a>
                                            <a href="javascript:;" class="Icnvalidated" style="display: none;"><i class="fas fa-check-circle" style="color: #28a745;" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-container="body" title="<%= MyBase.GetResourceString("C_Validated") %>"></i></a>
                                            <a href="javascript:;" class="Icncopytask"><i class="far fa-copy" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-container="body" title="<%= MyBase.GetResourceString("C_CopyTask") %>"></i></a>
                                            <a href="javascript:;" class="delete delskillset nostylebtn"><i class="far fa-trash-alt" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-container="body" title="<%= MyBase.GetResourceString("C_Delete") %>"></i></a>
                                        </div>
                                    </td>
                                    <td data-group="field">
                                        <input type="text" class="form-control" style="display: inline-block; width: calc(100% - 15px);" maxlength="255" />
                                        <span class="required" style="display: inline-block; margin-left: 3px;">*</span>
                                    </td>
                                    <td data-group="field">
                                        <div class="row">
                                            <div class="col-sm-10"><textarea class="form-control task-note-textarea" maxlength="2000"></textarea></div>
                                            <div class="col-sm-1 pl-0"><a href="javascript:;" class="task-note-icon"><i class="fa fa-search-plus" aria-hidden="true" style="margin:5px 0 0;"></i></a></div>
                                        </div>
                                    </td>
                                    <td data-group="field">
                                        <div style="display: inline-block; width: calc(100% - 15px);">
                                            <select class="selectpicker form-control" aria-label="<%= MyBase.GetResourceString("C_SelectResource") %>" data-live-search="true" title="<%= MyBase.GetResourceString("C_SelectResource") %>">
                                                <option value=""><%= MyBase.GetResourceString("C_SelectResource") %></option>
                                            </select>
                                        </div>
                                        <span class="required" style="display: inline-block; margin-left: 3px; vertical-align: middle;">*</span>
                                    </td>
                                    <td data-group="field">
                                        <div style="display: flex; align-items: center;">
                                            <%-- Added By Dipali V On 3rd Feb 2026 For W26 - Add maxlength=5 (HH:MM format) and class for Work Hours field validation --%>
                                            <input type="text" class="form-control work-hours-input" style="flex: 1;" maxlength="6" placeholder="00:00" />
                                            <span class="required" style="margin-left: 5px;">*</span>
                                        </div>
                                    </td>
                                    <td data-group="field">
                                        <div class="custom_chckbox">
                                            <input type="checkbox" id="IsBillablecheckbox" class="chcktbl">
                                            <label for="IsBillablecheckbox"></label>
                                        </div>
                                    </td>
                                    <td data-group="field">
                                        <div style="display: flex; align-items: center;">
                                            <div class="input-group" style="flex: 1;">
                                                <input id="BTStartdate" type="text" readonly="readonly" class="form-control" autocomplete="off">
                                                <span class="input-group-btn">
                                                <button class="btn btncalendar" type="button"><i class="fas fa-calendar-alt"></i></button>
                                                </span>
                                            </div>
                                            <span class="required" style="margin-left: 5px;">*</span>
                                        </div>
                                    </td>
                                    <td data-group="field">
                                        <div style="display: flex; align-items: center;">
                                            <div class="input-group" style="flex: 1;">
                                                <input id="BTEnddate" type="text" class="form-control" readonly="readonly"  autocomplete="off">
                                                <span class="input-group-btn">
                                                <button class="btn btncalendar" type="button"><i class="fas fa-calendar-alt"></i></button>
                                                </span>
                                            </div>
                                            <span class="required" style="margin-left: 5px;">*</span>
                                        </div>
                                    </td>
                                    <td data-group="field">
                                        <div style="display: inline-block; width: calc(100% - 15px);">
                                            <select class="selectpicker form-control" aria-label="<%= MyBase.GetResourceString("C_SelectTaskType") %>" data-live-search="true" title="<%= MyBase.GetResourceString("C_SelectTaskType") %>">
                                                <option value=""><%= MyBase.GetResourceString("C_SelectTaskType") %></option>
                                            </select>
                                            <span class="required">*</span>
                                        </div>
                                    </td>
                                    <td data-group="field">
                                        <div style="display: inline-block; width: calc(100% - 15px);">
                                            <select class="selectpicker form-control" aria-label="<%= MyBase.GetResourceString("C_SelectPriority") %>" data-live-search="true" title="<%= MyBase.GetResourceString("C_SelectPriority") %>">
                                                <option value=""><%= MyBase.GetResourceString("C_SelectPriority") %></option>
                                            </select>
                                            <span class="required">*</span>
                                        </div>
                                    </td>
                                    <td data-group="field">
                                        <div class="row">
                                            <div class="col-sm-10"><input type="text" class="form-control popup-field" id="txtDeliverable" readonly /></div>
                                            <div class="col-sm-1 pl-0"><a href="javascript:;" data-bs-toggle="modal" data-bs-target="#DeliverableModal"><i class="fa fa-link" aria-hidden="true" style="margin:5px 0 0;"></i></a></div>
                                        </div>
                                    </td>
                                    <%-- Added By Dipali V On 3rd Feb 2026 For W26 - Hide Phase field without impacting functionality --%>
                                    <td data-group="field">
                                        <div class="row">
                                            <div class="col-sm-10"><input type="text" class="form-control popup-field" id="txtPhase" readonly /></div>
                                            <div class="col-sm-1 pl-0"><a href="javascript:;" data-bs-toggle="modal" data-bs-target="#PhaseModal"><i class="fa fa-link" aria-hidden="true" style="margin:5px 0 0;"></i></a></div>
                                        </div>
                                    </td>
                                    <td data-group="field">
                                        <div class="row">
                                            <div class="col-sm-10"><input type="text" class="form-control popup-field" id="txtMilestone" readonly /></div>
                                            <div class="col-sm-1 pl-0"><a href="javascript:;" data-bs-toggle="modal" data-bs-target="#MilestoneModal"><i class="fa fa-link" aria-hidden="true" style="margin:5px 0 0;"></i></a></div>
                                        </div>
                                    </td>
                                    <td data-group="field">
                                        <div class="row">
                                            <div class="col-sm-10"><input type="text" class="form-control popup-field" id="txtModule" readonly /></div>
                                            <div class="col-sm-1 pl-0"><a href="javascript:;" data-bs-toggle="modal" data-bs-target="#ModuleModal"><i class="fa fa-link" aria-hidden="true" style="margin:5px 0 0;"></i></a></div>
                                        </div>
                                    </td>
                                    <td data-group="field">
                                        <div class="row">
                                            <div class="col-sm-10"><input type="text" class="form-control popup-field" id="txtSubProject" readonly /></div>
                                            <div class="col-sm-1 pl-0"><a href="javascript:;" data-bs-toggle="modal" data-bs-target="#SubProjectModal"><i class="fa fa-link" aria-hidden="true" style="margin:5px 0 0;"></i></a></div>
                                        </div>
                                    </td>
                                  <%--  <td data-group="field">
                                        <div class="row">
                                            <div class="col-sm-10"><input type="text" class="form-control popup-field" id="txtChangeRequest" readonly /></div>
                                            <div class="col-sm-1 pl-0"><a href="javascript:;" data-bs-toggle="modal" data-bs-target="#ChangeRequestModal"><i class="fa fa-link" aria-hidden="true" style="margin:5px 0 0;"></i></a></div>
                                        </div>
                                    </td>--%>
                                    <%-- Commented By Dipali V On 3rd Feb 2026 For W26 - Removed Feature control from Quick Task New page --%>
                                    <%--<td data-group="field">
                                        <div class="row">
                                            <div class="col-sm-10"><input type="text" class="form-control popup-field" id="txtFeature" readonly /></div>
                                            <div class="col-sm-1 pl-0"><a href="javascript:;" data-bs-toggle="modal" data-bs-target="#FeatureModal"><i class="fa fa-link" aria-hidden="true" style="margin:5px 0 0;"></i></a></div>
                                        </div>
                                    </td>--%>
                                   <%-- <td data-group="field">
                                        <div class="row">
                                            <div class="col-sm-10"><input type="text" class="form-control popup-field" id="txtEstimationType" readonly /></div>
                                            <div class="col-sm-1 pl-0"><a href="javascript:;" data-bs-toggle="modal" data-bs-target="#EstimationTypeModal"><i class="fa fa-link" aria-hidden="true" style="margin:5px 0 0;"></i></a></div>
                                        </div>
                                    </td>--%>
                                    <td data-group="field">
                                        <div class="row">
                                            <div class="col-sm-10"><input type="text" class="form-control popup-field" id="txtUserStory" readonly /></div>
                                            <div class="col-sm-1 pl-0"><a href="javascript:;" data-bs-toggle="modal" data-bs-target="#UserStoryModal"><i class="fa fa-link" aria-hidden="true" style="margin:5px 0 0;"></i></a></div>
                                        </div>
                                    </td>
                                    <td data-group="field"><input type="text" class="form-control" id="txtSprint" readonly /></td>
                                    <td data-group="field"><input type="text" class="form-control" id="txtRelease" readonly /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>

        <!-- Deliverable Type Modal start here-->
        <div class="modal custmodal fade" id="DeliverableModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id=""><%= MyBase.GetResourceString("C_Deliverables") %></h5>
                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="fscroll">
                            <div class="row">
                                <div class="col-sm-6 form-group">
                                    <div class="row mx-auto">
                                        <label class="col-sm-5 pt-1 text-end"><%= MyBase.GetResourceString("C_DeliverableType") %></label>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control" id="doc_Deliverable" autocomplete="off">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 form-group">
                                    <div class="row mx-auto pb-1">
                                        <div class="rowhiglight pb-3 text-end">
                                            <%--<a href="javascript:;" class="btn btnyellow mr-5" id="btnShowDeliverable"><%= MyBase.GetResourceString("C_Select") %></a>--%>
                                            <a href="javascript:;" class="btn borderbtn mr-5" id="btnUnselectDeliverable"><%= MyBase.GetResourceString("C_UnselectDeliverable") %></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6 form-group">
                                </div>
                                <%--<label class="col-sm-12 text-end font-weight-600">
                                    <small>(Blue color indicates currently selected Phase.)</small>
                                </label>--%>
                            </div>
                        </div>
                        <hr />

                        <div class="table-responsive">
                            <table class="table table-bordered delTbl" id="DeliverableTable">
                                <thead>
                                    <tr>
                                        <th><%= MyBase.GetResourceString("C_Deliverable") %></th>
                                        <th><%= MyBase.GetResourceString("C_DeliverableTypeHeader") %></th>
                                        <th><%= MyBase.GetResourceString("C_StartDateHeader") %></th>
                                        <th><%= MyBase.GetResourceString("C_EndDateHeader") %></th>
                                        <th><%= MyBase.GetResourceString("C_Select") %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>

                        <div class="btnrow text-center">
                            <button data-bs-dismiss="modal" class="btn canclesaveasbtn borderbtn"><%= MyBase.GetResourceString("C_Cancel") %></button>
                        </div>
                        <div class="clearfix"></div>

                    </div>
                </div>
            </div>
        </div>
        <!-- Deliverable Type Modal End here-->

        <!-- Phase Modal start here-->
        <div class="modal custmodal fade" id="PhaseModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header d-block">
                        <h5 class="modal-title text-center" id=""><%= MyBase.GetResourceString("C_SelectPhase") %></h5>
                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="fscroll">
                            <div class="row">
                                <div class="col-sm-6 form-group">
                                    <div class="row mx-auto">
                                        <label class="col-sm-5 pt-1 text-end"><%= MyBase.GetResourceString("C_PhaseLabel") %></label>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control" id="doc_Phase" autocomplete="off">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 form-group">
                                    <div class="row mx-auto pb-1">
                                        <div class="rowhiglight pb-3 text-end">
                                            <%--<a href="javascript:;" class="btn btnyellow mr-5" id="btnShowPhase"><%= MyBase.GetResourceString("C_Select") %></a>--%>
                                            <a href="javascript:;" class="btn borderbtn mr-5" id="btnUnselectPhase"><%= MyBase.GetResourceString("C_UnselectPhase") %></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6 form-group">
                                </div>
                                <label class="col-sm-12 text-end font-weight-600">
                                    <small>(Blue color indicates currently selected Phase.)</small>
                                </label>
                            </div>
                        </div>
                        <hr />

                        <div class="table-responsive">
                            <table class="table table-bordered tbl_select_Phase" id="#tbl_select_Phase" style="width:100%">
                                <thead>
                                    <tr>

        // Added By Dipali V On 23rd Jan 2026 For W26 - Check if maximum rows limit reached
        function checkMaxRowsLimit() {
            var rowCount = $("#bulkTaskTbl tbody tr").length;
            if (rowCount >= MAX_TASK_ROWS) {
                var alertMsg = Resources.A_MaxTasksLimit || 'Maximum ' + MAX_TASK_ROWS + ' tasks allowed';
                if (typeof alertify !== 'undefined') {
                    alertify.error(alertMsg);
                } else {
                    alert(alertMsg);
                }
                return true;
            }
            return false;
        }

        // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Convert decimal hours to HH:MM format (e.g., 52.0 -> 52:00, 1.5 -> 1:30)
        function convertDecimalToHHMM(decimalHours) {
            if (!decimalHours && decimalHours !== 0) return '00:00';
            var hours = Math.floor(decimalHours);
            var minutes = Math.round((decimalHours - hours) * 60);
            if (minutes >= 60) {
                hours += Math.floor(minutes / 60);
                minutes = minutes % 60;
            }
            return hours + ':' + (minutes < 10 ? '0' : '') + minutes;
        }
        
        // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Calculate sum of all work hours in the table
        function calculateTotalWorkHours() {
            var total = 0;
            $('#bulkTaskTbl tbody tr').each(function() {
                var $workInput = $(this).find('.work-hours-input');
                if ($workInput.length) {
                    var workValue = $workInput.val();
                    if (workValue && workValue.trim()) {
                        var decimalValue = convertWorkToDecimal(workValue);
                        if (decimalValue) total += parseFloat(decimalValue);
                    }
                }
            });
            return total;
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Add new task row (clean and concise)
        function FUNaddtaskaction() {
            // Added By Dipali V On 23rd Jan 2026 For W26 - Hide note section when adding new task
            var $collapseOne = $('#collapseOne');
            if ($collapseOne.hasClass('show')) {
                $collapseOne.collapse('hide');
            }
            
            if (checkMaxRowsLimit()) return;
            
            var tblcnt = $("#bulkTaskTbl tbody tr").length;
            var firstRow = $("#bulkTaskTbl tbody tr:first");
            var newRow;
            
            if (firstRow.length === 0) {
                // Create first row from template (if needed, you can add HTML template here)
                alertify.error('Please ensure at least one row exists in the table.');
                return;
                } else {
                // Clone existing row - preserve selectpicker structure properly
                // Don't destroy selectpicker on original row, just clone and clean up the cloned row
                newRow = firstRow.clone(true); // Clone with data and events to preserve structure
                
                // Clean up selectpicker wrappers from cloned row only
                newRow.find('.bootstrap-select').each(function() {
                    var $select = $(this).find('select');
                    if ($select.length) {
                        // Move select back to its original position
                        $select.insertBefore($(this));
                    }
                    $(this).remove();
                });
                
                // Remove selectpicker data and classes from cloned row
                newRow.find('select.selectpicker').each(function() {
                    $(this).removeData('selectpicker');
                    $(this).removeClass('selectpicker-hidden-accessible');
                    // Remove any selectpicker-related attributes
                    $(this).removeAttr('data-selectpicker');
                });
            }
            
            // Clear values and set unique IDs
            newRow.find('input[type="text"], textarea').val('');
            newRow.find('input[type="checkbox"]').prop('checked', window.currentProjectBillableStatus === true);
                newRow.find('select').val('');
            //newRow.find('input.popup-field, input[id^="txt"]').prop('readonly', true).removeAttr('data-selected-id');
            // Added by DipalI v On 3rd sep 2026 - Purpose: clear cloned row WBS mapping IDs including jQuery data cache
            newRow.find('input.popup-field, input[id^="txt"]').prop('readonly', true);
            clearRowWbsMappings(newRow);
            
            // Added By Dipali V On 23rd Jan 2026 For W26 - Hide validation icons and copy icon in new row
            // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Hide all validation icons when adding new row
            newRow.find('.Icnvalidation, .Icnwarning, .Icnvalidated').hide();
            newRow.find('.Icncopytask').removeClass('show').hide();
            
            newRow.find('input[id^="BTStartdate"]').attr('id', 'BTStartdate' + tblcnt).removeClass('hasDatepicker');
            newRow.find('input[id^="BTStartdate"]').attr('id', 'BTStartdate' + tblcnt).attr('readonly','readonly');
            newRow.find('input[id^="BTEnddate"]').attr('id', 'BTEnddate' + tblcnt).removeClass('hasDatepicker');
            newRow.find('input[id^="BTEnddate"]').attr('id', 'BTEnddate' + tblcnt).attr('readonly','readonly');
            var billableId = 'IsBillablecheckbox' + tblcnt;
            newRow.find('input[id^="IsBillablecheckbox"]').attr('id', billableId);
            newRow.find('label[for^="IsBillablecheckbox"]').attr('for', billableId);
            
            // Append row to table
                $("#bulkTaskTbl tbody").append(newRow);
                
            // Added By Dipali V On 23rd Jan 2026 For W26 - Apply hidden columns first
            if (typeof applyHiddenColumnsToRow === 'function') {
                applyHiddenColumnsToRow(newRow);
            }
                
            // Added By Dipali V On 23rd Jan 2026 For W26 - Populate lookup options (Resources, TaskTypes, Priorities)
            if (typeof applyLookupOptionsToRow === 'function') {
                applyLookupOptionsToRow(newRow);
            }
            
            // Initialize selectpickers after options are populated
            newRow.find('select.selectpicker').each(function() {
                var $sel = $(this);
                if ($sel.is('select') && !$sel.data('selectpicker')) {
                    $sel.selectpicker({ dropupAuto: false });
                    $sel.on('changed.bs.select', function() {
                        var val = $sel.selectpicker('val');
                        if (val !== null && val !== undefined) $sel.val(val);
                        if ($sel.attr('aria-label') === Resources.C_SelectTaskType && val && val !== '' && val !== '0') {
                            if (typeof handleTaskTypeChange === 'function') {
                                handleTaskTypeChange($sel, val, newRow.index() + 1);
                            }
                        }
                    });
                    // Refresh selectpicker after initialization to show populated options
                    setTimeout(function() {
                        try { $sel.selectpicker('refresh'); } catch(e) {}
                    }, 150);
                }
            });
            
            // Initialize datepickers
            var datepickerOptions = { autoclose: true, changeMonth: true, changeYear: true, dateFormat: 'dd M yy', orientation: 'bottom' };
            $('#BTStartdate' + tblcnt).datepicker(datepickerOptions);
            $('#BTEnddate' + tblcnt).datepicker(datepickerOptions);
            
            // Added By Dipali V On 23rd Jan 2026 For W26 - Apply mandatory asterisks after row is fully initialized
            if (typeof applyMandatoryAsterisksToRow === 'function') {
                setTimeout(function() {
                    applyMandatoryAsterisksToRow(newRow);
                }, 500);
            }
            
            // Added By Dipali V On 23rd Jan 2026 For W26 - Load custom fields for new row
            if (typeof loadCustomFieldsForRow === 'function') {
                setTimeout(function() {
                    loadCustomFieldsForRow(newRow, tblcnt);
                }, 500);
            }
            
            // Added By Dipali V On 23rd Jan 2026 For W26 - Validate first row when new row is added
            setTimeout(function() {
                var $firstRow = $("#bulkTaskTbl tbody tr:first");
                if ($firstRow.length && $firstRow[0] !== newRow[0] && !isRowEmpty($firstRow)) {
                    validateRowAutomatically($firstRow);
                }
            }, 1000);
            
            // Scroll to bottom to show new row
            if (typeof scrollToBottom === 'function') scrollToBottom();
        }

        // Added By Dipali V On 23rd Jan 2026 For W26 - Delete row on delete button click
        $(document).on("click", ".delete", function (e) {
            e.preventDefault();
            e.stopPropagation();
            
            var $row = $(this).closest("tr");
            if ($row.length) {
                // Added By Dipali V On 23rd Jan 2026 For W26 - Validate at least one row exists
                var totalRows = $("#bulkTaskTbl tbody tr").length;
                if (totalRows <= 1) {
                    var alertMsg = '<%= MyBase.GetResourceString("C_EnsureOneRowExists") %>';
                    if (typeof alertify !== 'undefined') {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.error(alertMsg);
                    } else {
                        alert(alertMsg);
                    }
                    return;
                }
                
                // Destroy selectpickers before removing to avoid memory leaks
                $row.find('.selectpicker').each(function() {
                    try {
                        if ($(this).data('selectpicker')) {
                            $(this).selectpicker('destroy');
                    }
                } catch(e) {}
                });
                
                // Destroy datepickers before removing
                $row.find('input[id^="BTStartdate"], input[id^="BTEnddate"]').each(function() {
                    try {
                        if ($(this).hasClass('hasDatepicker')) {
                            $(this).datepicker('destroy');
                        }
                    } catch(e) {}
                });
                
                // Remove the row
                $row.remove();
                
                // Optional: Update task note numbers if function exists
                if (typeof updateTaskNoteNumbers === 'function') {
                    updateTaskNoteNumbers();
                }
            }
        });

        // Added By Dipali V On 23rd Jan 2026 For W26 - Store validation errors globally
        // Added By Dipali V On 23rd Jan 2026 For W26 - Store validation errors per row
        var validationErrors = [];
        var rowValidationErrors = {}; // Store errors by row index: { rowIndex: [errors] }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Collect custom field values for a row
        function collectCustomFieldDataForRow($row, rowIndex) {
            var customFieldList = $('#CustomFieldList' + rowIndex).val() || '';
            var typeInaccessibleList = $('#TypeInaccessibleCustomFieldList' + rowIndex).val() || '';
            var values = {};
            
            if (customFieldList) {
                customFieldList.split(',').forEach(function(name) {
                    name = (name || '').trim();
                    if (!name) return;
                    var controlId = name + rowIndex;
                    var $field = $row.find('#' + controlId);
                    if ($field.length && !$field.prop('disabled')) {
                        var val = null;
                        // Added By Dipali V On 23rd Jan 2026 For W26 - Properly extract values from selectpicker dropdowns
                        if ($field.is('select') && ($field.hasClass('selectpicker') || $field.data('selectpicker'))) {
                            try {
                                val = $field.selectpicker('val');
                                // If selectpicker returns array, get first value or join
                                if (Array.isArray(val)) {
                                    val = val.length > 0 ? val[0] : null;
                                }
                            } catch(e) {
                                val = $field.val();
                            }
                        } else {
                            val = $field.val();
                        }
                        // Ensure we have a primitive value (string, number, or null)
                        if (val !== null && val !== undefined && val !== '') {
                            // Convert to string for text/combo fields, or number for numeric fields
                            if (name.indexOf('CustomFieldNumeric') > -1) {
                                var numVal = parseFloat(val);
                                values[name] = isNaN(numVal) ? null : numVal;
                            } else if (name.indexOf('CustomFieldDate') > -1) {
                                // Date fields - keep as string, SP will convert
                                values[name] = val.toString();
                            } else {
                                // Text, Combo, TextArea - convert to string
                                values[name] = val.toString();
                            }
                        }
                    }
                });
            } else {
                // Fallback: scan all custom field controls
                $row.find('input[id*="CustomField"], textarea[id*="CustomField"], select[id*="CustomField"]').each(function() {
                    var $f = $(this);
                    if ($f.prop('disabled')) return;
                    var id = $f.attr('id') || '';
                    var baseName = id.replace(rowIndex.toString(), '');
                    if (!baseName) return;
                    
                    var v = null;
                    // Added By Dipali V On 23rd Jan 2026 For W26 - Properly extract values from selectpicker dropdowns
                    if ($f.is('select') && ($f.hasClass('selectpicker') || $f.data('selectpicker'))) {
                        try {
                            v = $f.selectpicker('val');
                            if (Array.isArray(v)) {
                                v = v.length > 0 ? v[0] : null;
                            }
                        } catch(e) {
                            v = $f.val();
                        }
                    } else {
                        v = $f.val();
                    }
                    
                    // Ensure primitive value
                    if (v !== null && v !== undefined && v !== '') {
                        if (baseName.indexOf('CustomFieldNumeric') > -1) {
                            var numVal = parseFloat(v);
                            values[baseName] = isNaN(numVal) ? null : numVal;
                        } else if (baseName.indexOf('CustomFieldDate') > -1) {
                            values[baseName] = v.toString();
                        } else {
                            values[baseName] = v.toString();
                        }
                    }
                });
            }
            
            return {
                customFieldList: customFieldList,
                typeInaccessibleCustomFieldList: typeInaccessibleList,
                values: values
            };
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Validate custom fields for a row
        function validateCustomFieldsForRow($row, rowIndex, taskName) {
            var errors = [];
            var rowTaskName = taskName || ('Task ' + rowIndex);
            
            $row.find('input[id*="CustomField"], textarea[id*="CustomField"], select[id*="CustomField"]').each(function() {
                var $field = $(this);
                if ($field.prop('disabled')) return;
                
                var rules = ($field.attr('data-validation-rules') || '').toString();
                if (!rules) return;
                
                var label = $field.attr('data-field-label') || $field.attr('id') || ('Field ' + rowIndex);
                var val = $.trim(($field.val() || '').toString());
                
                // Rule 1 - Required / blank
                if (rules.indexOf('1') > -1 && val === '') {
                    errors.push({
                        rowIndex: rowIndex,
                        message: label + ' is blank.',
                        taskName: rowTaskName,
                        validationType: 'Error'
                    });
                    return false; // stop on first error for this field
                }
                
                if (val !== '') {
                    // Rule 3 - Numeric
                    if (rules.indexOf('3') > -1 && !$.isNumeric(val)) {
                        errors.push({
                            rowIndex: rowIndex,
                            message: label + ' must be numeric.',
                            taskName: rowTaskName,
                            validationType: 'Error'
                        });
                        return false;
                    }
                    
                    // Rule 2 - Date
                    if (rules.indexOf('2') > -1) {
                        var d = Date.parse(val);
                        if (isNaN(d)) {
                            errors.push({
                                rowIndex: rowIndex,
                                message: label + ' date is invalid.',
                                taskName: rowTaskName,
                                validationType: 'Error'
                            });
                            return false;
                        }
                    }
                    
                    // Rule 9 - Alphabets
                    if (rules.indexOf('9') > -1) {
                        var alphaRegex = /^[A-Za-z\s]+$/;
                        if (!alphaRegex.test(val)) {
                            errors.push({
                                rowIndex: rowIndex,
                                message: label + ' must contain alphabets only.',
                                taskName: rowTaskName,
                                validationType: 'Error'
                            });
                            return false;
                        }
                    }
                }
            });
            
            return errors;
        }
        
        // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Update validation icons based on ValidationType (Error=red cross, Warning=orange warning, Validated=green tick)
        function updateValidationIconForRow($row, validationState) {
            var $errorIcon = $row.find('.Icnvalidation');
            var $warningIcon = $row.find('.Icnwarning');
            var $successIcon = $row.find('.Icnvalidated');
            var $copyIcon = $row.find('.Icncopytask');
            
            // Hide all icons first
            $errorIcon.hide();
            $warningIcon.hide();
            $successIcon.hide();
            
            // Show appropriate icon based on validation state
            if (validationState === 'error' || validationState === true) {
                // Error: red cross icon, hide copy icon
                $errorIcon.show();
                $copyIcon.removeClass('show').hide();
            } else if (validationState === 'warning') {
                // Warning: orange warning icon, show copy icon
                $warningIcon.show();
                if (!isRowEmpty($row)) {
                    $copyIcon.addClass('show').show();
                }
            } else if (validationState === 'validated' || validationState === false) {
                // Validated: green tick icon, show copy icon
                if (!isRowEmpty($row)) {
                    $successIcon.show();
                    $copyIcon.addClass('show').show();
                } else {
                    $copyIcon.removeClass('show').hide();
                }
            } else {
                // No validation state, hide copy icon
                $copyIcon.removeClass('show').hide();
            }
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Check if row is empty
        function isRowEmpty($row) {
            if (!$row || !$row.length) return true;
            var fieldCols = $row.find('td[data-group="field"]');
            var taskName = fieldCols.eq(0).find('input').val() || '';
            return taskName.trim() === '';
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Show validation modal
        // Added By Dipali V On 23rd Jan 2026 For W26 - Show validation modal
        function showValidationModal(rowIndex, errors) {
            if (!errors || errors.length === 0) {
                console.warn('No validation errors to display');
                return;
            }
            
            // Use existing modal structure instead of creating new one
            var $modal = $('#validationModal');
            if ($modal.length === 0) {
                console.error('Validation modal not found in DOM');
                return;
            }
            
            // Clear existing content
            var $tbody = $modal.find('.tskValTbl tbody');
            $tbody.empty();
            
            // Populate modal with errors
            errors.forEach(function (err) {
                var taskNameDisplay = err.taskName || 'Task ' + rowIndex;
                var validationReason = err.message || err.validationReason || '<%= MyBase.GetResourceString("C_ValidationError") %>';
                // Added By Dipali V On 23rd Jan 2026 For W26 - Check Resource property first (capital R) as per TaskValidationResultEntity
                var resourceName = err.Resource || err.resource || err.resourceName || err.ResourceName || err.employeeName || err.EmployeeName || err.employee || err.Employee || err.userName || err.UserName || err.user || err.User || '-';
                
                // Escape HTML to prevent XSS
                var escapeHtml = function(text) {
                    if (!text) return '';
                    var map = {
                        '&': '&amp;',
                        '<': '&lt;',
                        '>': '&gt;',
                        '"': '&quot;',
                        "'": '&#039;'
                    };
                    return text.toString().replace(/[&<>"']/g, function(m) { return map[m]; });
                };
                
                var rowClass = (err.validationType === 'Error' || err.validationType === 'error' || err.isErrorWarning === 1) ? 
                    'danger' : 'warning';
                
                var rowHtml = '<tr class="' + rowClass + '">' +
                    '<td>' + escapeHtml(taskNameDisplay) + '</td>' +
                    '<td>' + escapeHtml(validationReason) + '</td>' +
                    '<td>' + escapeHtml(resourceName) + '</td>' +
                    '</tr>';
                
                $tbody.append(rowHtml);
            });
            
            // Initialize and show Bootstrap modal
            try {
                var modalElement = document.getElementById('validationModal');
                if (!modalElement) {
                    console.error('Validation modal element not found in DOM');
                    return;
                }
                
                console.log('Modal element found, initializing Bootstrap modal...');
                
                // Dispose existing modal instance if any
                var existingModal = bootstrap.Modal.getInstance(modalElement);
                if (existingModal) {
                    console.log('Disposing existing modal instance');
                    existingModal.dispose();
                }
                
                // Check if Bootstrap is available
                if (typeof bootstrap === 'undefined' || typeof bootstrap.Modal === 'undefined') {
                    console.error('Bootstrap Modal not available, using jQuery fallback');
                    $modal.modal('show');
                    return;
                }
                
                // Create new modal instance and show
                console.log('Creating new Bootstrap modal instance');
                var validationModalInstance = new bootstrap.Modal(modalElement, {
                    backdrop: true,
                    keyboard: true
                });
                
                // Show modal
                validationModalInstance.show();
                console.log('Modal show() called');
                
                // Verify modal is shown after a short delay
                setTimeout(function() {
                    if (!modalElement.classList.contains('show')) {
                        console.warn('Modal did not show, trying jQuery fallback');
                        $modal.modal('show');
                    }
                }, 100);
                
            } catch (e) {
                console.error('Error showing validation modal:', e);
                console.error('Stack trace:', e.stack);
                // Fallback to jQuery modal if Bootstrap fails
                try {
                    $modal.modal('show');
                } catch (jqError) {
                    console.error('jQuery modal also failed:', jqError);
                    alertify.error('Failed to open validation modal. Please check console for details.');
                }
            }
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Copy task row functionality
        $(document).on('click', '.Icncopytask', function(e) {
            e.preventDefault();
            e.stopPropagation();
            if (checkMaxRowsLimit()) return;
            
            var $currentRow = $(this).closest('tr');
            var tblcnt = $("#bulkTaskTbl tbody tr").length;
            
            // Added By Dipali V On 23rd Jan 2026 For W26 - Store all dropdown values including custom fields
            var currentRowSelectValues = {};
            $currentRow.find('td[data-group="field"]').each(function(index) {
                var $sel = $(this).find('select.selectpicker, select[id*="CustomField"]');
                if ($sel.length) {
                    // Get value using selectpicker method if available, otherwise use val()
                    var val = null;
                    try {
                        if ($sel.data('selectpicker') || $sel.hasClass('selectpicker')) {
                            val = $sel.selectpicker('val');
                            // Handle array values
                            if (Array.isArray(val)) {
                                val = val.length > 0 ? val[0] : null;
                            }
                        } else {
                            val = $sel.val();
                        }
                    } catch(e) {
                        val = $sel.val();
                    }
                    // Store value even if it's '0' or empty string (but not null/undefined)
                    // For Resource (index 2), we'll skip copying it later, but store it anyway
                    if (val !== null && val !== undefined && val !== '') {
                        currentRowSelectValues[index] = val;
                    }
                }
            });
            
            // Also store custom field dropdown values by ID (for custom fields that might not be in field columns)
            var currentRowCustomFieldValues = {};
            $currentRow.find('select[id*="CustomField"]').each(function() {
                var $sel = $(this);
                var id = $sel.attr('id');
                if (id) {
                    var val = null;
                    try {
                        if ($sel.data('selectpicker') || $sel.hasClass('selectpicker')) {
                            val = $sel.selectpicker('val');
                            if (Array.isArray(val)) {
                                val = val.length > 0 ? val[0] : null;
                            }
                        } else {
                            val = $sel.val();
                        }
                    } catch(e) {
                        val = $sel.val();
                    }
                    if (val !== null && val !== undefined && val !== '') {
                        currentRowCustomFieldValues[id] = val;
                    }
                }
            });
            
            var currentRowTextValues = {};
            $currentRow.find('td[data-group="field"]').each(function(index) {
                var $input = $(this).find('input[type="text"]');
                var $textarea = $(this).find('textarea');
                if ($input.length) currentRowTextValues[index] = $input.val();
                else if ($textarea.length) currentRowTextValues[index] = $textarea.val();
            });
            
            var currentRowCheckboxValues = {};
            $currentRow.find('input[type="checkbox"]').each(function() {
                var index = $(this).closest('td[data-group="field"]').index();
                currentRowCheckboxValues[index] = $(this).is(':checked');
            });
            
            var currentRowDateValues = {};
            $currentRow.find('input[id^="BTStartdate"], input[id^="BTEnddate"]').each(function() {
                currentRowDateValues[$(this).attr('id')] = $(this).val();
            });
            
            var currentRowPopupValues = {};
            $currentRow.find('input.popup-field').each(function() {
                var id = $(this).attr('id');
                if (id) {
                    currentRowPopupValues[id] = {
                        val: $(this).val(),
                        dataId: $(this).attr('data-selected-id')
                    };
                }
            });
            
            // Clone row - preserve selectpicker structure properly
            // Don't destroy selectpicker on original row, just clone and clean up the cloned row
            var $newRow = $currentRow.clone(true); // Clone with data and events to preserve structure
            
            // Clean up selectpicker wrappers from cloned row only
            $newRow.find('.bootstrap-select').each(function() {
                var $select = $(this).find('select');
                if ($select.length) {
                    // Move select back to its original position
                    $select.insertBefore($(this));
                }
                $(this).remove();
            });
            
            // Remove selectpicker data and classes from cloned row
            $newRow.find('select.selectpicker').each(function() {
                $(this).removeData('selectpicker');
                $(this).removeClass('selectpicker-hidden-accessible');
                // Remove any selectpicker-related attributes
                $(this).removeAttr('data-selectpicker');
            });
            
            // Clear and set unique IDs for new row
            $newRow.find('input[type="text"], textarea').val('');
            $newRow.find('input[type="checkbox"]').prop('checked', window.currentProjectBillableStatus === true);
            $newRow.find('select').val('');
            //$newRow.find('input.popup-field, input[id^="txt"]').prop('readonly', true).removeAttr('data-selected-id');
            // Added by DipalI v On 3rd sep 2026 - Purpose: clear cloned/copied row WBS mapping IDs including jQuery data cache
            $newRow.find('input.popup-field, input[id^="txt"]').prop('readonly', true);
            clearRowWbsMappings($newRow);
            
            var newStartDateId = 'BTStartdate' + tblcnt;
            var newEndDateId = 'BTEnddate' + tblcnt;
            var newBillableId = 'IsBillablecheckbox' + tblcnt;
            
            $newRow.find('input[id^="BTStartdate"]').attr('id', newStartDateId).removeClass('hasDatepicker');
            $newRow.find('input[id^="BTEnddate"]').attr('id', newEndDateId).removeClass('hasDatepicker');
            $newRow.find('input[id^="IsBillablecheckbox"]').attr('id', newBillableId);
            $newRow.find('label[for^="IsBillablecheckbox"]').attr('for', newBillableId);
            
            // Hide validation icons in new row
            // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Hide all validation icons when copying row
            $newRow.find('.Icnvalidation, .Icnwarning, .Icnvalidated').hide();
            $newRow.find('.Icncopytask').removeClass('show').hide();
            
            $currentRow.after($newRow);
            
            // Apply functions to new row
            if (typeof applyHiddenColumnsToRow === 'function') applyHiddenColumnsToRow($newRow);
            if (typeof applyLookupOptionsToRow === 'function') applyLookupOptionsToRow($newRow);
            
            // Added By Dipali V On 23rd Jan 2026 For W26 - Initialize selectpickers and restore values (including custom fields)
            // Wait for options to be populated before initializing selectpicker and restoring values
            setTimeout(function() {
                $newRow.find('select.selectpicker, select[id*="CustomField"]').each(function() {
                    var $sel = $(this);
                    if (!$sel.is('select')) return; // Skip if not a select element
                    
                    var index = $sel.closest('td[data-group="field"]').index() - 1;
                    var storedValue = currentRowSelectValues[index];
                    var id = $sel.attr('id');
                    
                    // Also check custom field values by ID
                    if (!storedValue && id && currentRowCustomFieldValues[id]) {
                        storedValue = currentRowCustomFieldValues[id];
                    }
                    
                    // Initialize selectpicker if not already initialized
                    var isSelectpickerInitialized = $sel.data('selectpicker') !== undefined && $sel.data('selectpicker') !== null;
                    if (!isSelectpickerInitialized) {
                        $sel.selectpicker({ dropupAuto: false });
                    }
                    
                    // Restore value after selectpicker is initialized (skip Resource at index 2 for copy)
                    if (index !== 2 && storedValue !== undefined && storedValue !== null && storedValue !== '') {
                        // Wait a bit more to ensure selectpicker is fully initialized and options are available
                        setTimeout(function() {
                            try {
                                // Check if the option exists before setting value
                                var optionExists = $sel.find('option[value="' + storedValue + '"]').length > 0;
                                if (optionExists) {
                                    // Set value using native val() first, then refresh selectpicker
                                    $sel.val(storedValue);
                                    if (isSelectpickerInitialized || $sel.data('selectpicker')) {
                                        $sel.selectpicker('refresh');
                                        
                                        // Verify value was set correctly
                                        var currentVal = $sel.selectpicker('val');
                                        if (Array.isArray(currentVal)) {
                                            currentVal = currentVal.length > 0 ? currentVal[0] : null;
                                        }
                                        // If value doesn't match, try setting again
                                        if (currentVal != storedValue) {
                                            $sel.val(storedValue);
                                            $sel.selectpicker('refresh');
                                        }
                                    }
                                } else {
                                    console.warn('Option with value "' + storedValue + '" not found in dropdown at index ' + index);
                                }
                            } catch(e) {
                                console.warn('Error setting selectpicker value for index ' + index + ':', e);
                            }
                        }, 200);
                    } else if (index === 2) {
                        // For Resource (index 2), clear the value
                        setTimeout(function() {
                            try {
                                $sel.val('');
                                if (isSelectpickerInitialized || $sel.data('selectpicker')) {
                                    $sel.selectpicker('refresh');
                                }
                            } catch(e) {}
                        }, 200);
                    }
                });
            }, 100); // Wait for applyLookupOptionsToRow to populate options
            
            // Restore text values
            $newRow.find('td[data-group="field"]').each(function(index) {
                if (currentRowTextValues[index] !== undefined) {
                    var $input = $(this).find('input[type="text"]');
                    var $textarea = $(this).find('textarea');
                    if ($input.length) $input.val(currentRowTextValues[index]);
                    else if ($textarea.length) $textarea.val(currentRowTextValues[index]);
                }
            });
            
            // Restore checkbox
            $newRow.find('input[type="checkbox"]').each(function() {
                var index = $(this).closest('td[data-group="field"]').index();
                if (currentRowCheckboxValues[index] !== undefined) {
                    $(this).prop('checked', currentRowCheckboxValues[index]);
                }
            });
            
            // Restore dates
            $newRow.find('input[id^="BTStartdate"], input[id^="BTEnddate"]').each(function() {
                var oldId = $(this).attr('id');
                var matchingOldId = Object.keys(currentRowDateValues).find(function(k) {
                    return k.indexOf(oldId.replace(/\d+$/, '')) === 0;
                });
                if (matchingOldId && currentRowDateValues[matchingOldId]) {
                    $(this).val(currentRowDateValues[matchingOldId]);
                }
            });
            
            // Restore popup field values
            $newRow.find('input.popup-field').each(function() {
                var id = $(this).attr('id');
                if (id && currentRowPopupValues[id]) {
                    $(this).val(currentRowPopupValues[id].val);
                    if (currentRowPopupValues[id].dataId) {
                        $(this).attr('data-selected-id', currentRowPopupValues[id].dataId);
                    }
                }
            });
            
            // Added By Dipali V On 23rd Jan 2026 For W26 - Restore custom field dropdown values by ID
            if (currentRowCustomFieldValues && Object.keys(currentRowCustomFieldValues).length > 0) {
                Object.keys(currentRowCustomFieldValues).forEach(function(oldId) {
                    // Extract row number from old ID and create new ID
                    var baseName = oldId.replace(/\d+$/, '');
                    var oldRowNum = oldId.replace(baseName, '');
                    var newId = baseName + tblcnt;
                    var $customFieldSelect = $newRow.find('select#' + newId);
                    if ($customFieldSelect.length) {
                        var storedValue = currentRowCustomFieldValues[oldId];
                        setTimeout(function() {
                            try {
                                if (!$customFieldSelect.data('selectpicker')) {
                                    $customFieldSelect.selectpicker({ dropupAuto: false });
                                }
                                $customFieldSelect.val(storedValue);
                                $customFieldSelect.selectpicker('refresh');
                            } catch(e) {
                                console.warn('Error setting custom field selectpicker value for ' + newId + ':', e);
                            }
                        }, 350);
                    }
                });
            }
            
            // Initialize datepickers
            $('#' + newStartDateId + ', #' + newEndDateId).datepicker({
                autoclose: true, changeMonth: true, changeYear: true,
                dateFormat: 'dd M yy', orientation: 'bottom'
            });
            
            // Apply mandatory asterisks and custom fields
            setTimeout(function() {
                if (typeof applyMandatoryAsterisksToRow === 'function') applyMandatoryAsterisksToRow($newRow);
                if (typeof loadCustomFieldsForRow === 'function') loadCustomFieldsForRow($newRow, tblcnt);
            }, 500);
        });
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Automatically validate row and store errors
        function validateRowAutomatically($row) {
            if (!$row || !$row.length || isRowEmpty($row)) {
                updateValidationIconForRow($row, 'validated');
                var rowIndex = $('#bulkTaskTbl tbody tr').index($row) + 1;
                rowValidationErrors[rowIndex] = [];
                return;
            }
            
            // Added By Dipali V On 3rd Feb 2026 For W26 - Get selected project ID from dropdown (prioritize selected value)
            var selectedProjectId = $('#cboAssignedTaskProject').val();
            if (!selectedProjectId || selectedProjectId === '' || selectedProjectId === '0' || selectedProjectId === 'Select Project') {
                var $selectpicker = $('#cboAssignedTaskProject');
                if ($selectpicker.length && typeof $selectpicker.selectpicker === 'function') {
                    selectedProjectId = $selectpicker.selectpicker('val');
                }
            }
            var projectId = parseInt(selectedProjectId || projectID || '0');
            var userId = parseInt(userID || '<%= Session("intUserID") %>' || '0');
            if (!projectId || !userId) return;
            
            var rowIndex = $('#bulkTaskTbl tbody tr').index($row) + 1;
            var fieldCols = $row.find('td[data-group="field"]');
            var taskData = {
                projectID: projectId, userID: userId,
                taskName: fieldCols.eq(0).find('input').val() || '',
                taskNotes: fieldCols.eq(1).find('textarea').val() || '',
                employeeID: fieldCols.eq(2).find('select').val() || null,
                work: fieldCols.eq(3).find('input').val() || '',
                billable: $row.find('[id^="IsBillablecheckbox"]').is(':checked'),
                startDate: $row.find('[id^="BTStartdate"]').val() || '',
                endDate: $row.find('[id^="BTEnddate"]').val() || '',
                taskTypes: fieldCols.eq(7).find('select').val() || null,
                priority: fieldCols.eq(8).find('select').val() || null,
                //deliverableID: extractNumericID(fieldCols.eq(9).find('input').attr('data-selected-id')),
                //phaseID: extractNumericID(fieldCols.eq(10).find('input').attr('data-selected-id')),
                //milestoneID: extractNumericID(fieldCols.eq(11).find('input').attr('data-selected-id')),
                //moduleID: extractNumericID(fieldCols.eq(12).find('input').attr('data-selected-id')),
                //subProjectID: extractNumericID(fieldCols.eq(13).find('input').attr('data-selected-id')),
                // Added by DipalI v On 3rd sep 2026 - Purpose: prevent stale mapping IDs on validate
                deliverableID: getSelectedMappingIdFromInput(fieldCols.eq(9).find('input').first()),
                phaseID: getSelectedMappingIdFromInput(fieldCols.eq(10).find('input').first()),
                milestoneID: getSelectedMappingIdFromInput(fieldCols.eq(11).find('input').first()),
                moduleID: getSelectedMappingIdFromInput(fieldCols.eq(12).find('input').first()),
                subProjectID: getSelectedMappingIdFromInput(fieldCols.eq(13).find('input').first()),
                featureID: (function() {
                    var featureIdRaw = fieldCols.eq(14).find('input').attr('data-selected-id');
                    var featureId = extractNumericID(featureIdRaw);
                    return featureId !== null ? featureId.toString() : null;
                })(),
                userStoryID: (function() {
                    var $userStoryCell = fieldCols.eq(14); // Column index shifted from 15 to 14 after Feature removal
                    var $userStoryInput = $userStoryCell.find('input[id^="txtUserStory"]');
                    if (!$userStoryInput.length) $userStoryInput = $userStoryCell.find('input.popup-field');
                    if (!$userStoryInput.length) $userStoryInput = $userStoryCell.find('input[type="text"]');
                    //var userStoryIdRaw = $userStoryInput.length ? ($userStoryInput.attr('data-selected-id') || $userStoryInput.data('selected-id')) : null;
                    //return extractNumericID(userStoryIdRaw);
                    // Added by DipalI v On 3rd sep 2026 - Purpose: ignore stale user story jQuery data cache
                    return getSelectedMappingIdFromInput($userStoryInput);
                })(),
                ProcessGroupID: $("#ProcessGroupID").val() || null,
                isPhaseMandatory: Gflags.isPhaseMandatory || 0,
                isModuleMandatory: Gflags.isModuleMandatory || 0,
                isMilestoneMandatory: Gflags.isMilestoneMandatory || 0,
                isSubProjectMandatory: Gflags.isSubProjectMandatory || 0,
                isCRMandatory: Gflags.isCRMandatory || 0,
                isFeatureMandatory: Gflags.isFeatureMandatory || 0,
                isEstimationTypeMandatory: Gflags.isEstimationTypeMandatory || 0
            };
            
            var payload = {
                projectID: taskData.projectID, userID: taskData.userID,
                taskName: taskData.taskName, taskNotes: taskData.taskNotes,
                employeeID: taskData.employeeID, work: taskData.work,
                billable: taskData.billable, startDate: taskData.startDate,
                endDate: taskData.endDate, taskTypes: taskData.taskTypes,
                priority: taskData.priority, deliverableID: taskData.deliverableID,
                phaseID: taskData.phaseID, milestoneID: taskData.milestoneID,
                moduleID: taskData.moduleID, subProjectID: taskData.subProjectID,
                featureID: taskData.featureID, userStoryID: taskData.userStoryID,
                ProcessGroupID: taskData.ProcessGroupID,
                isPhaseMandatory: taskData.isPhaseMandatory,
                isModuleMandatory: taskData.isModuleMandatory,
                isMilestoneMandatory: taskData.isMilestoneMandatory,
                isSubProjectMandatory: taskData.isSubProjectMandatory,
                isCRMandatory: taskData.isCRMandatory,
                isFeatureMandatory: taskData.isFeatureMandatory,
                isEstimationTypeMandatory: taskData.isEstimationTypeMandatory
            };
            
            try {
                var result = AJAXCallWithResult('api/BulkTaskCreation/ValidateTaskCreation', JSON.stringify(payload), false);
                var rowErrors = [];
                var hasErrors = false;
                
                // Handle different response structures - validationResults can be at various locations
                var validationResults = null;
                if (result) {
                    // Check if result itself is an array of validation results
                    if (Array.isArray(result)) {
                        validationResults = result;
                    }
                    // Check nested locations
                    else if (result.data && result.data.validationResults) {
                        validationResults = result.data.validationResults;
                    } else if (result.data && result.data.data && result.data.data.validationResults) {
                        validationResults = result.data.data.validationResults;
                    } else if (result.validationResults) {
                        validationResults = result.validationResults;
                    } else if (result.data && Array.isArray(result.data)) {
                        validationResults = result.data;
                    } else if (result.Data && result.Data.validationResults) {
                        validationResults = result.Data.validationResults;
                    }
                }
                
                if (validationResults && Array.isArray(validationResults) && validationResults.length > 0) {
                    validationResults.forEach(function(vr) {
                        // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Process errors (1) and warnings (2, 3) - check isErrorWarning and validationType
                        var isError = (vr.isErrorWarning == 1 || vr.IsErrorWarning == 1);
                        var isWarning = (vr.isErrorWarning == 2 || vr.isErrorWarning == 3 || vr.IsErrorWarning == 2 || vr.IsErrorWarning == 3) || 
                                       (vr.validationType === 'Warning' || vr.ValidationType === 'Warning' || vr.validationType === 'warning' || vr.ValidationType === 'warning');
                        
                        if (isError || isWarning) {
                            var taskName = vr.task_Name || vr.Task_Name || taskData.taskName || 'Task ' + rowIndex;
                            var validationReason = vr.validationReason || vr.ValidationReason || '<%= MyBase.GetResourceString("C_ValidationError") %>';
                            // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Determine validationType from API response (prioritize validationType field)
                            var validationType = vr.validationType || vr.ValidationType || (isError ? 'Error' : 'Warning');
                            // Added By Dipali V On 23rd Jan 2026 For W26 - Check multiple property names for resource
                            // TaskValidationResultEntity has Resource property (capital R)
                            console.log('Validation result object:', vr);
                            var resource = vr.Resource || vr.resource || vr.resourceName || vr.ResourceName || vr.employeeName || vr.EmployeeName || vr.employee || vr.Employee || vr.userName || vr.UserName || null;
                            console.log('Extracted resource:', resource);
                            
                            rowErrors.push({
                                rowIndex: rowIndex,
                                message: validationReason,
                                taskName: taskName,
                                validationType: validationType,
                                resource: resource
                            });
                            
                            // Show validation icon for both errors and warnings (user wants to see all validation issues)
                            hasErrors = true;
                        }
                    });
                }
                
                // If no validation results but isValid is false, add generic error
                if (rowErrors.length === 0 && result && (result.isValid === false || result.IsValid === false || (result.data && (result.data.isValid === false || result.data.IsValid === false)))) {
                    hasErrors = true;
                    //debugger;
                    var errorMessage = result.message || result.Message;
                    if (result.data) {
                        errorMessage = errorMessage || result.data.message || result.data.Message;
                    }
                    rowErrors.push({
                        rowIndex: rowIndex,
                        message: errorMessage || 'Validation failed',
                        taskName: taskData.taskName || 'Task ' + rowIndex,
                        validationType: 'Error'
                    });
                }
                
                // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Determine validation state (error/warning/validated) based on ValidationType
                var validationState = 'validated';
                if (rowErrors.length > 0) {
                    var hasErrors = rowErrors.some(function(err) { return (err.validationType === 'Error' || err.validationType === 'error'); });
                    var hasWarnings = rowErrors.some(function(err) { return (err.validationType === 'Warning' || err.validationType === 'warning'); });
                    validationState = hasErrors ? 'error' : (hasWarnings ? 'warning' : 'validated');
                    console.log('Validation state determined:', validationState, 'hasErrors:', hasErrors, 'hasWarnings:', hasWarnings, 'rowErrors:', rowErrors);
                }
                
                // Store errors for this row
                rowValidationErrors[rowIndex] = rowErrors;
                updateValidationIconForRow($row, validationState);
            } catch(e) {
                rowValidationErrors[rowIndex] = [];
                updateValidationIconForRow($row, 'validated');
            }
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Validate row and show modal (for cross icon click)
        function validateRowAndShowModal($row, rowIndex) {
            if (!$row || !$row.length || isRowEmpty($row)) {
                return;
            }
            
            // Added By Dipali V On 3rd Feb 2026 For W26 - Get selected project ID from dropdown (prioritize selected value)
            var selectedProjectId = $('#cboAssignedTaskProject').val();
            if (!selectedProjectId || selectedProjectId === '' || selectedProjectId === '0' || selectedProjectId === 'Select Project') {
                var $selectpicker = $('#cboAssignedTaskProject');
                if ($selectpicker.length && typeof $selectpicker.selectpicker === 'function') {
                    selectedProjectId = $selectpicker.selectpicker('val');

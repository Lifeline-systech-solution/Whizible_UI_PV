                    } else if (result.validationResults) {
                        validationResults = result.validationResults;
                    } else if (result.data && Array.isArray(result.data)) {
                        validationResults = result.data;
                    } else if (result.Data && result.Data.validationResults) {
                        validationResults = result.Data.validationResults;
                    }
                }
                
                if (validationResults && Array.isArray(validationResults) && validationResults.length > 0) {
                    validationResults.forEach(function(vr) {
                        // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Process errors (1) and warnings (2, 3) - check isErrorWarning and validationType
                        var isError = (vr.isErrorWarning == 1 || vr.IsErrorWarning == 1);
                        var isWarning = (vr.isErrorWarning == 2 || vr.isErrorWarning == 3 || vr.IsErrorWarning == 2 || vr.IsErrorWarning == 3) || 
                                       (vr.validationType === 'Warning' || vr.ValidationType === 'Warning' || vr.validationType === 'warning' || vr.ValidationType === 'warning');
                        
                        if (isError || isWarning) {
                            var taskName = vr.task_Name || vr.Task_Name || taskData.taskName || 'Task ' + rowIndex;
                            var validationReason = vr.validationReason || vr.ValidationReason || '<%= MyBase.GetResourceString("C_ValidationError") %>';
                            // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Determine validationType from API response (prioritize validationType field)
                            var validationType = vr.validationType || vr.ValidationType || (isError ? 'Error' : 'Warning');
                            // Added By Dipali V On 23rd Jan 2026 For W26 - Check multiple property names for resource
                            // TaskValidationResultEntity has Resource property (capital R)
                            console.log('Validation result object:', vr);
                            var resource = vr.Resource || vr.resource || vr.resourceName || vr.ResourceName || vr.employeeName || vr.EmployeeName || vr.employee || vr.Employee || vr.userName || vr.UserName || null;
                            console.log('Extracted resource:', resource);
                            rowErrors.push({
                                rowIndex: rowIndex,
                                message: validationReason,
                                taskName: taskName,
                                validationType: validationType,
                                resource: resource
                            });
                        }
                    });
                }
                // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Determine validation state (error/warning/validated) based on ValidationType
                var validationState = 'validated';
                if (rowErrors.length > 0) {
                    var hasErrors = rowErrors.some(function(err) { return (err.validationType === 'Error' || err.validationType === 'error'); });
                    var hasWarnings = rowErrors.some(function(err) { return (err.validationType === 'Warning' || err.validationType === 'warning'); });
                    validationState = hasErrors ? 'error' : (hasWarnings ? 'warning' : 'validated');
                    console.log('validateRowAndShowModal: Validation state determined:', validationState, 'hasErrors:', hasErrors, 'hasWarnings:', hasWarnings, 'rowErrors:', rowErrors);
                }
                
                // Store errors and show modal
                rowValidationErrors[rowIndex] = rowErrors;
                console.log('validateRowAndShowModal: Stored errors for row', rowIndex, ':', rowErrors);
                if (rowErrors.length > 0) {
                    console.log('validateRowAndShowModal: Calling showValidationModal with', rowErrors.length, 'errors');
                    showValidationModal(rowIndex, rowErrors);
                }
                updateValidationIconForRow($row, validationState);
            } catch(e) {
                updateValidationIconForRow($row, 'validated');
            }
        }

        function checkSpecialCharacter(value, WebConfigSpecialCharacters) {
                if (WebConfigSpecialCharacters != '') {
                    var regularExpression = WebConfigSpecialCharacters;
                   // regularExpression += '"';
                    var isSpecialCharacter = 0;
                    for (var i = 0; i < regularExpression.length; i++) {
                        if (value.indexOf(regularExpression[i]) != -1) {
                            isSpecialCharacter = 1
                        }
                    }
                    if (isSpecialCharacter == 1) {
                        return true;
                    }
                    else {
                        return false;
                    }
                }
                else {
                    return false;
                }
}
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Click handler for validation icon (show modal, no alerts)
        // Added By Dipali V On 23rd Jan 2026 For W26 - Handle task note icon click to display text in modal
        $(document).on('click', '.task-note-icon', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            var $icon = $(this);
            var $row = $icon.closest('tr');
            var $textarea = $row.find('textarea.task-note-textarea');
            var taskNoteText = $textarea.val() || '';
            
            // Store reference to the textarea for later use
            $('#taskNoteTextarea').data('source-textarea', $textarea);
            
            // Set the text in the modal textarea
            $('#taskNoteTextarea').val(taskNoteText);
            
            // Clear the numbered list (if any)
            $('#taskNoteList').empty();
            
            // Open the modal
            var modal = new bootstrap.Modal(document.getElementById('TaskNoteModal'));
            modal.show();
        });
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Handle OK button click to save text back to textarea
        $(document).on('click', '#okTaskNoteBtn', function(e) {
            e.preventDefault();
            var $modalTextarea = $('#taskNoteTextarea');
            var $sourceTextarea = $modalTextarea.data('source-textarea');
            var updatedText = $modalTextarea.val() || '';
            
            if ($sourceTextarea && $sourceTextarea.length > 0) {
                $sourceTextarea.val(updatedText);
            }
            
            // Close the modal
            var modal = bootstrap.Modal.getInstance(document.getElementById('TaskNoteModal'));
            if (modal) {
                modal.hide();
            }
        });
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Click handler for validation icon (show modal, no alerts)
        // Handle clicks on both the anchor and the icon inside it
        // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Handle click on validation icons (error and warning) to show modal popup
        $(document).on('click', '.Icnvalidation, .Icnvalidation i, .Icnwarning, .Icnwarning i', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            console.log('Validation icon clicked');
            
            // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Get clicked element (supports both error and warning icons)
            var $clickedElement = $(this);
            var $anchor = $clickedElement.closest('.Icnvalidation, .Icnwarning').length > 0 ? 
                $clickedElement.closest('.Icnvalidation, .Icnwarning') : $clickedElement;
            var $row = $anchor.closest('tr');
            
            if ($row.length === 0) {
                console.error('Row not found for validation icon');
                return;
            }
            
            var rowIndex = $('#bulkTaskTbl tbody tr').index($row);
            
            if (rowIndex === -1) {
                console.error('Row index not found');
                return;
            }
            
            // Get errors from stored rowValidationErrors or from global validationErrors
            // Use rowIndex + 1 for display, but use rowIndex for array access
            var displayRowIndex = rowIndex + 1;
            var rowErrors = rowValidationErrors[displayRowIndex] || validationErrors.filter(function(err) { return err.rowIndex === displayRowIndex; });
            
            console.log('Validation icon clicked for row:', displayRowIndex, 'Stored errors:', rowValidationErrors[displayRowIndex], 'Filtered errors:', rowErrors);
            //debugger;
            if (rowErrors && rowErrors.length > 0) {
                console.log('Showing modal with stored errors:', rowErrors);
                showValidationModal(displayRowIndex, rowErrors);
            } else {
                console.log('No stored errors, validating row now...');
                // If no stored errors, validate the row now and show modal
                validateRowAndShowModal($row, displayRowIndex);
            }
        });
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - CreateTask function (concise)
        function createtask() {
            // Added By Dipali V On 3rd Feb 2026 For W26 - Validate project selection and get selected project ID
            var selectedProject = $('#cboAssignedTaskProject').val();
            if (!selectedProject || selectedProject === '' || selectedProject === '0' || selectedProject === 'Select Project') {
                var $selectpicker = $('#cboAssignedTaskProject');
                if ($selectpicker.length && typeof $selectpicker.selectpicker === 'function') {
                    selectedProject = $selectpicker.selectpicker('val');
                }
            }
            if (!selectedProject || selectedProject === '' || selectedProject === '0' || selectedProject === 'Select Project') {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("M_PleaseSelectProject") %>');
                return;
            }
            
            var projectId = parseInt(selectedProject || projectID || '0');
            var userId = parseInt(userID || '<%= Session("intUserID") %>' || '0');
            if (!projectId || !userId) {
                alertify.error('<%= MyBase.GetResourceString("C_ProjectUserIDRequired") %>');
                return;
            }

            //debugger;
            // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Validate total work hours against project EstimatedEfforts before creating tasks
            if (window.projectEstimatedEfforts && window.projectEstimatedEfforts > 0) {
                var currentTotal = calculateTotalWorkHours();
                // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Add already saved tasks' work hours to current total for validation
                if (window.EstimatedEffortsDisplay && window.EstimatedEffortsDisplay > 0) {
                    currentTotal = currentTotal + parseFloat(window.EstimatedEffortsDisplay);
                }
                if (currentTotal > window.projectEstimatedEfforts) {
                    alertify.set('notifier', 'position', 'top-right');
                    // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Display work hours in HH:MM format in alert message
                    var currentTotalHHMM = convertDecimalToHHMM(currentTotal);
                    var projectEffortsHHMM = convertDecimalToHHMM(window.projectEstimatedEfforts);
                    alertify.error('Total work hours (' + currentTotalHHMM + ') exceeds project estimated efforts (' + projectEffortsHHMM + '). Please adjust work hours.');
                    return;
                }
            }

            //return;
            // Added By Dipali V On 23rd Jan 2026 For W26 - Validate special characters in Task Name and Notes
            // Check Task Name first for all rows
            var taskNameErrorRow = null;
            $('#bulkTaskTbl tbody tr').each(function(index) {
                var $row = $(this);
                var fieldCols = $row.find('td[data-group="field"]');
                var taskName = fieldCols.eq(0).find('input').val() || '';
                
                if (taskName && checkSpecialCharacter(taskName, WebConfigSpecialCharacters) === true) {
                    taskNameErrorRow = { row: $row, index: index + 1, input: fieldCols.eq(0).find('input') };
                    return false; // Break loop
                }
            });
            
            if (taskNameErrorRow) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("C_TaskNameContain") %>' + WebConfigSpecialCharacters + ' characters');
                taskNameErrorRow.input.focus();
                return;
            }
            
            // Check Task Notes for all rows (only if Task Name validation passed)
            var taskNoteErrorRow = null;
            $('#bulkTaskTbl tbody tr').each(function(index) {
                var $row = $(this);
                var fieldCols = $row.find('td[data-group="field"]');
                var taskNotes = fieldCols.eq(1).find('textarea').val() || '';
                
                if (taskNotes && checkSpecialCharacter(taskNotes, WebConfigSpecialCharacters) === true) {
                    taskNoteErrorRow = { row: $row, index: index + 1, textarea: fieldCols.eq(1).find('textarea') };
                    return false; // Break loop
                }
            });
            
            if (taskNoteErrorRow) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error('<%= MyBase.GetResourceString("C_DescriptionContain") %>' + WebConfigSpecialCharacters + ' characters');
                taskNoteErrorRow.textarea.focus();
                return;
            }
            
            // Added By Dipali V On 23rd Jan 2026 For W26 - Validate custom fields for all rows
            var customFieldErrorRow = null;
            $('#bulkTaskTbl tbody tr').each(function(index) {
                var $row = $(this);
                var fieldCols = $row.find('td[data-group="field"]');
                var taskName = fieldCols.eq(0).find('input').val() || '';
                var rowTaskName = taskName || ('Task ' + (index + 1));
                
                var cfErrors = validateCustomFieldsForRow($row, index + 1, rowTaskName);
                if (cfErrors && cfErrors.length > 0) {
                    // Get the first error and find the field that caused it
                    var firstError = cfErrors[0];
                    var $errorField = null;
                    
                    // Find the field that matches the error message
                    $row.find('input[id*="CustomField"], textarea[id*="CustomField"], select[id*="CustomField"]').each(function() {
                        var $f = $(this);
                        if ($f.prop('disabled')) return true;
                        var label = $f.attr('data-field-label') || $f.attr('id') || '';
                        if (firstError.message.indexOf(label) > -1) {
                            $errorField = $f;
                            return false; // Break
                        }
                        return true;
                    });
                    
                    customFieldErrorRow = { row: $row, index: index + 1, field: $errorField, errorMessage: firstError.message };
                    return false; // Break loop
                }
            });
            
            if (customFieldErrorRow) {
                alertify.set('notifier', 'position', 'top-right');
                alertify.error(customFieldErrorRow.errorMessage);
                if (customFieldErrorRow.field && customFieldErrorRow.field.length) {
                    customFieldErrorRow.field.focus();
                }
                return;
            }
            
            validationErrors = [];
            rowValidationErrors = {}; // Clear stored row validation errors
            var tasks = [];

            // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Hide all validation icons before validation
            $('#bulkTaskTbl tbody tr').each(function() {
                updateValidationIconForRow($(this), 'validated');
            });
            
            $('#bulkTaskTbl tbody tr').each(function(index) {
                var $row = $(this);
                var fieldCols = $row.find('td[data-group="field"]');
                
                var taskData = {
                    projectID: projectId,
                    userID: userId,
                    taskName: fieldCols.eq(0).find('input').val() || '',
                    taskNotes: fieldCols.eq(1).find('textarea').val() || '',
                    employeeID: fieldCols.eq(2).find('select').val() || null,
                    work: fieldCols.eq(3).find('input').val() || '',
                    billable: $row.find('[id^="IsBillablecheckbox"]').is(':checked'),
                    startDate: $row.find('[id^="BTStartdate"]').val() || '',
                    endDate: $row.find('[id^="BTEnddate"]').val() || '',
                    taskTypes: fieldCols.eq(7).find('select').val() || null,
                    priority: fieldCols.eq(8).find('select').val() || null,
                    //deliverableID: (function() {
                    //    var $deliverableCell = fieldCols.eq(9);
                    //    var $deliverableInput = $deliverableCell.find('input[id^="txtDeliverable"]');
                    //    if (!$deliverableInput.length) $deliverableInput = $deliverableCell.find('input.popup-field');
                    //    if (!$deliverableInput.length) $deliverableInput = $deliverableCell.find('input[type="text"]');
                    //    var deliverableIdRaw = $deliverableInput.length ? ($deliverableInput.attr('data-selected-id') || $deliverableInput.data('selected-id')) : null;
                    //    return extractNumericID(deliverableIdRaw);
                    //})(),
                    //phaseID: extractNumericID(fieldCols.eq(10).find('input').attr('data-selected-id')),
                    //phase: fieldCols.eq(10).find('input').val() || '',
                    //milestoneID: extractNumericID(fieldCols.eq(11).find('input').attr('data-selected-id')),
                    //milestone: fieldCols.eq(11).find('input').val() || '',
                    //moduleID: extractNumericID(fieldCols.eq(12).find('input').attr('data-selected-id')),
                    //module: fieldCols.eq(12).find('input').val() || '',
                    //subProjectID: extractNumericID(fieldCols.eq(13).find('input').attr('data-selected-id')),
                    //subProject: fieldCols.eq(13).find('input').val() || '',
                    // Added by DipalI v On 3rd sep 2026 - Purpose: read WBS mapping IDs only when field has display value (prevent remapping previous Deliverable/Phase/Milestone/Module/SubProject)
                    deliverableID: getSelectedMappingIdFromInput(fieldCols.eq(9).find('input[id^="txtDeliverable"], input.popup-field, input[type="text"]').first()),
                    phaseID: getSelectedMappingIdFromInput(fieldCols.eq(10).find('input').first()),
                    phase: fieldCols.eq(10).find('input').val() || '',
                    milestoneID: getSelectedMappingIdFromInput(fieldCols.eq(11).find('input').first()),
                    milestone: fieldCols.eq(11).find('input').val() || '',
                    moduleID: getSelectedMappingIdFromInput(fieldCols.eq(12).find('input').first()),
                    module: fieldCols.eq(12).find('input').val() || '',
                    subProjectID: getSelectedMappingIdFromInput(fieldCols.eq(13).find('input').first()),
                    subProject: fieldCols.eq(13).find('input').val() || '',
                    // Commented By Dipali V On 3rd Feb 2026 For W26 - Removed Feature control from Quick Task New page
                    //featureID: (function() {
                    //    var featureIdRaw = fieldCols.eq(14).find('input').attr('data-selected-id');
                    //    var featureId = extractNumericID(featureIdRaw);
                    //    return featureId !== null ? featureId.toString() : null;
                    //})(),
                    featureID: null, // Feature removed, always null
                    //userStoryID: (function() {
                    //    var $userStoryCell = fieldCols.eq(14); // Column index shifted from 15 to 14 after Feature removal
                    //    var $userStoryInput = $userStoryCell.find('input[id^="txtUserStory"]');
                    //    if (!$userStoryInput.length) $userStoryInput = $userStoryCell.find('input.popup-field');
                    //    if (!$userStoryInput.length) $userStoryInput = $userStoryCell.find('input[type="text"]');
                    //    var userStoryIdRaw = $userStoryInput.length ? ($userStoryInput.attr('data-selected-id') || $userStoryInput.data('selected-id')) : null;
                    //    return extractNumericID(userStoryIdRaw);
                    //})(),
                    userStoryID: getSelectedMappingIdFromInput(fieldCols.eq(14).find('input[id^="txtUserStory"], input.popup-field, input[type="text"]').first()),
                    ProcessGroupID: $("#ProcessGroupID").val() || null,
                     isPhaseMandatory: Gflags.isPhaseMandatory || 0,
                     isModuleMandatory: Gflags.isModuleMandatory || 0,
                     isMilestoneMandatory: Gflags.isMilestoneMandatory || 0,
                     isSubProjectMandatory: Gflags.isSubProjectMandatory || 0,
                     isCRMandatory: Gflags.isCRMandatory || 0,
                     isFeatureMandatory: Gflags.isFeatureMandatory || 0,
                     isEstimationTypeMandatory: Gflags.isEstimationTypeMandatory || 0

                };
                
                // Collect custom field data (list + values) for this row
                var cfData = collectCustomFieldDataForRow($row, index + 1);
                taskData.customFieldList = cfData.customFieldList;
                taskData.typeInaccessibleCustomFieldList = cfData.typeInaccessibleCustomFieldList;
                taskData.customFieldValues = cfData.values;
                
                tasks.push({ rowIndex: index + 1, $row: $row, taskData: taskData });
            });
            
            if (tasks.length === 0) {
                alertify.error('<%= MyBase.GetResourceString("C_AddAtLeastOneTask") %>');
                return;
            }
            
            // Validate all tasks
            var completed = 0;
            tasks.forEach(function(task) {
                var payload = {
                    projectID: task.taskData.projectID,
                    userID: task.taskData.userID,
                    taskName: task.taskData.taskName,
                    taskNotes: task.taskData.taskNotes,
                    employeeID: task.taskData.employeeID,
                    work: task.taskData.work,
                    billable: task.taskData.billable,
                    startDate: task.taskData.startDate,
                    endDate: task.taskData.endDate,
                    taskTypes: task.taskData.taskTypes,
                    priority: task.taskData.priority,
                    deliverableID: task.taskData.deliverableID !== null && task.taskData.deliverableID !== undefined ? task.taskData.deliverableID : null,
                    phaseID: task.taskData.phaseID,
                    milestoneID: task.taskData.milestoneID,
                    moduleID: task.taskData.moduleID,
                    subProjectID: task.taskData.subProjectID,
                    featureID: task.taskData.featureID !== null && task.taskData.featureID !== undefined ? task.taskData.featureID.toString() : null,
                    userStoryID: task.taskData.userStoryID,
                    ProcessGroupID: task.taskData.ProcessGroupID,
                     isHoliday: 0,
                     isLeave: 0,
                     //userStoryID: userStoryId,
                     //featureID: featureId ? featureId.toString() : null,
                     //estimationTypeID: estimationTypeId ? estimationTypeId.toString() : null,
                     isPhaseMandatory: task.taskData.isPhaseMandatory,
                     isModuleMandatory: task.taskData.isModuleMandatory,
                     isMilestoneMandatory: task.taskData.isMilestoneMandatory,
                     isSubProjectMandatory: task.taskData.isSubProjectMandatory,
                     isCRMandatory: task.taskData.isCRMandatory,
                     isFeatureMandatory: task.taskData.isFeatureMandatory,
                     isEstimationTypeMandatory: task.taskData.isEstimationTypeMandatory,
                     tmsTaskID: null
                };
                
                try {
                    var result = AJAXCallWithResult('api/BulkTaskCreation/ValidateTaskCreation', JSON.stringify(payload), false);
                    
                    // Handle different response formats
                    var validationResults = null;
                    if (result) {
                        if (result.validationResults) validationResults = result.validationResults;
                        else if (result.data && result.data.validationResults) validationResults = result.data.validationResults;
                        else if (result.Data && result.Data.validationResults) validationResults = result.Data.validationResults;
                        else if (Array.isArray(result)) validationResults = result;
                    }
                    
                    var rowHasErrors = false;
                    var rowErrors = [];
                    if (validationResults && Array.isArray(validationResults) && validationResults.length > 0) {
                        validationResults.forEach(function(vr) {
                            // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Process errors (1) and warnings (2, 3) - check isErrorWarning and validationType
                            var isError = (vr.isErrorWarning == 1 || vr.IsErrorWarning == 1);
                            var isWarning = (vr.isErrorWarning == 2 || vr.isErrorWarning == 3 || vr.IsErrorWarning == 2 || vr.IsErrorWarning == 3) || 
                                           (vr.validationType === 'Warning' || vr.ValidationType === 'Warning' || vr.validationType === 'warning' || vr.ValidationType === 'warning');
                            
                            if (isError || isWarning) {
                                rowHasErrors = true;
                                var taskName = vr.task_Name || vr.Task_Name || task.taskData.taskName || 'Task ' + task.rowIndex;
                                var resource = vr.resource ;
                                var validationReason = vr.validationReason || vr.ValidationReason || '<%= MyBase.GetResourceString("C_ValidationError") %>';
                                // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Determine validationType from API response (prioritize validationType field)
                                var validationType = vr.validationType || vr.ValidationType || (isError ? 'Error' : 'Warning');
                                
                                var errorObj = {
                                    rowIndex: task.rowIndex,
                                    message: validationReason,
                                    taskName: taskName,
                                    validationType: validationType,
                                    resource: resource
                                };
                                validationErrors.push(errorObj);
                                rowErrors.push(errorObj);
                            }
                        });
                    } else if (result && (result.isValid === false || result.IsValid === false)) {
                        // If isValid is false but no validationResults, still show error
                        rowHasErrors = true;
                        var errorObj = {
                            rowIndex: task.rowIndex,
                            message: result.message || result.Message || 'Validation failed',
                            taskName: task.taskData.taskName || 'Task ' + task.rowIndex,
                            validationType: 'Error'
                        };
                        validationErrors.push(errorObj);
                        rowErrors.push(errorObj);
                    }
                    
                    // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Determine validation state (error/warning/validated) based on ValidationType
                    var validationState = 'validated';
                    if (rowErrors.length > 0) {
                        var hasErrors = rowErrors.some(function(err) { return (err.validationType === 'Error' || err.validationType === 'error'); });
                        var hasWarnings = rowErrors.some(function(err) { return (err.validationType === 'Warning' || err.validationType === 'warning'); });
                        validationState = hasErrors ? 'error' : (hasWarnings ? 'warning' : 'validated');
                    }
                    
                    // Store errors for this row
                    rowValidationErrors[task.rowIndex] = rowErrors;
                    updateValidationIconForRow(task.$row, validationState);
                } catch(e) {
                    console.error('Error validating task:', e);
                    var errorObj = {
                        rowIndex: task.rowIndex,
                        message: '<%= MyBase.GetResourceString("C_ErrorValidatingTask") %>' + (e.message ? ': ' + e.message : ''),
                        taskName: task.taskData.taskName || 'Task ' + task.rowIndex,
                        validationType: 'Error'
                    };
                    validationErrors.push(errorObj);
                    rowValidationErrors[task.rowIndex] = [errorObj];
                    updateValidationIconForRow(task.$row, 'error');
                }
                
                completed++;
                if (completed === tasks.length) {
                    // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Allow task creation with warnings, only block on errors
                    var hasAnyErrors = validationErrors.some(function(err) { 
                        return (err.validationType === 'Error' || err.validationType === 'error'); 
                    });
                    if (hasAnyErrors) {
                        alertify.error('<%= MyBase.GetResourceString("C_FixValidationErrors") %>');
                    } else {
                        // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Proceed with task creation (no errors, warnings allowed)
                        createTasksAfterValidation(tasks, projectId, userId);
                    }
                }
            });
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Helper functions (optimized)
        function convertWorkToDecimal(workValue) {
            if (!workValue || !workValue.toString().trim()) return null;
            var workStr = workValue.toString().trim();
            if (workStr.indexOf(':') !== -1) {
                var parts = workStr.split(':');
                if (parts.length === 2) return ((parseInt(parts[0], 10) || 0) + ((parseInt(parts[1], 10) || 0) / 60.0)).toFixed(2);
            }
            var workNum = parseFloat(workStr);
            return !isNaN(workNum) ? workNum.toFixed(2) : null;
        }
        
        function parseDateFromUI(dateValue) {
            if (!dateValue || !dateValue.toString().trim()) return null;
            var dateStr = dateValue.toString().trim();
            var months = { 'Jan': 0, 'Feb': 1, 'Mar': 2, 'Apr': 3, 'May': 4, 'Jun': 5, 'Jul': 6, 'Aug': 7, 'Sep': 8, 'Oct': 9, 'Nov': 10, 'Dec': 11 };
            var match = dateStr.match(/(\d{1,2})\s+(\w{3})\s+(\d{2,4})/);
            if (match) {
                var day = parseInt(match[1], 10);
                var month = months[match[2]];
                var year = parseInt(match[3], 10);
                if (year < 100) year = year < 50 ? 2000 + year : 1900 + year;
                if (month !== undefined) return new Date(year, month, day);
            }
            var date = new Date(dateStr);
            return !isNaN(date.getTime()) ? date : null;
        }
        
        function convertDateToSQLFormat(dateValue) {
            var date = parseDateFromUI(dateValue);
            if (!date) return null;
            var monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            return monthNames[date.getMonth()] + ' ' + date.getDate() + ' ' + date.getFullYear();
        }
        
        function convertDateToISOFormat(dateValue) {
            var date = parseDateFromUI(dateValue);
            if (!date) return null;
            var y = date.getFullYear(), m = (date.getMonth() + 1).toString().padStart(2, '0'), d = date.getDate().toString().padStart(2, '0');
            return y + '-' + m + '-' + d + 'T00:00:00';
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Post tasks to API (optimized)
        function PostProjectAssignedTask(projectID, tasks, successCallback, errorCallback) {
            if (!projectID || projectID <= 0 || !tasks || !Array.isArray(tasks) || tasks.length === 0) {
                if (typeof errorCallback === 'function') errorCallback(null, null, !projectID ? '<%= MyBase.GetResourceString("C_ProjectIDRequired") %>' : '<%= MyBase.GetResourceString("C_TasksArrayRequired") %>');
                return;
            }
            var isUserStoryTask=false;
            if(GisAgileMethodFollowed==true)
            {
                isUserStoryTask=true;
            }else{
                isUserStoryTask=false;
            }
            
            var payload = { projectID: projectID, tasks: tasks.map(function(task) {
                // Added By Dipali V On 23rd Jan 2026 For W26 - Use customFields if already built, otherwise build from customFieldValues
                var customFields = null;
                if (task.customFields && typeof task.customFields === 'object' && Object.keys(task.customFields).length > 0) {
                    // customFields already built in createTasksAfterValidation
                    customFields = task.customFields;
                } else if (task.customFieldValues && typeof task.customFieldValues === 'object') {
                    // Build CustomFields object from customFieldValues (fallback)
                    customFields = {};
                    Object.keys(task.customFieldValues).forEach(function(fieldName) {
                        var value = task.customFieldValues[fieldName];
                        // Ensure we only include primitive values
                        if (value !== null && value !== undefined && value !== '') {
                            // Skip if value is an object or array
                            if (typeof value === 'object' && !Array.isArray(value)) {
                                console.warn('Skipping non-primitive custom field value for', fieldName, value);
                                return;
                            }
                            // Ensure primitive value
                            if (typeof value === 'string' || typeof value === 'number') {
                                customFields[fieldName] = value;
                            } else if (Array.isArray(value) && value.length > 0) {
                                customFields[fieldName] = value[0].toString();
                            } else {
                                customFields[fieldName] = value.toString();
                            }
                        }
                    });
                    if (Object.keys(customFields).length === 0) customFields = null;
                }
                
                return {
                    projectID: task.projectID || projectID || 0, projectTypeID: task.projectTypeID || null, userID: task.userID || 0,
                    processGroupID: task.processGroupID || null, taskName: task.taskName || null, taskNotes: task.taskNotes || null,
                    deliverableID: task.deliverableID !== null && task.deliverableID !== undefined ? task.deliverableID : null, employeeID: task.employeeID || null,
                    work: convertWorkToDecimal(task.work), startDate: convertDateToSQLFormat(task.startDate), endDate: convertDateToSQLFormat(task.endDate),
                    changeRequestID: task.changeRequestID || null, billable: task.billable !== undefined ? task.billable : null,
                    moduleID: task.moduleID || null, subProjectID: task.subProjectID || null, milestoneID: task.milestoneID || null,
                    priority: task.priority || null, taskTypes: task.taskTypes || null, phaseID: task.phaseID || null,
                    isHoliday: task.isHoliday || 0, isLeave: task.isLeave || 0, userStoryID: task.userStoryID || null,
                    featureID: task.featureID !== null && task.featureID !== undefined ? task.featureID.toString() : null, estimationTypeID: task.estimationTypeID || null,
                    isPhaseMandatory: task.isPhaseMandatory || 0, isModuleMandatory: task.isModuleMandatory || 0,
                    isMilestoneMandatory: task.isMilestoneMandatory || 0, isSubProjectMandatory: task.isSubProjectMandatory || 0,
                    isCRMandatory: task.isCRMandatory || 0, isFeatureMandatory: task.isFeatureMandatory || 0,
                    isEstimationTypeMandatory: task.isEstimationTypeMandatory || 0, tmsTaskID: task.tmsTaskID || null,
                    taskID: task.taskID || null, whichTask: 'O' || null,
                    baselineStart: convertDateToISOFormat(task.startDate), baselineEnd: convertDateToISOFormat(task.endDate),
                    baselineWork: convertWorkToDecimal(task.work), phase: task.phase || '', module: task.module || '',
                    subProject: task.subProject || '', milestone: task.milestone || '',
                    otherTaskID: null, projectFeatureID: task.featureID !== null && task.featureID !== undefined ? task.featureID : null, projectEstimationTypeID: task.estimationTypeID || null,
                    mitigationPlanID: null, trainingResourceID: null, trainingID: null, void: true, onHold: null,
                    createdBy: '<%= Session("strUserName") %>', isUserStoryTask: isUserStoryTask, storyPoints: null, deliverableStageID: null,
                    customFields: customFields
                };
            })};
            
            var result = AJAXCallWithResult('api/BulkTaskCreation/PostProjectAssignedTask', JSON.stringify(payload), false);
            if (result) {
                try {
                    var res = result.data || result;
                    var taskResults = res.tasks || res.Tasks || (Array.isArray(result) ? result : null);
                    var totalProcessed = res.totalProcessed || res.TotalProcessed || (Array.isArray(result) ? result.length : tasks.length);
                    var message = res.message || res.Message || (Array.isArray(result) ? '<%= MyBase.GetResourceString("C_TasksProcessedSuccessfully") %>' : '');
                    if (typeof successCallback === 'function') successCallback(result, taskResults, totalProcessed, message);
                } catch(e) { if (typeof errorCallback === 'function') errorCallback(null, null, e); }
            } else { if (typeof errorCallback === 'function') errorCallback(null, null, '<%= MyBase.GetResourceString("C_NoResponseFromServer") %>'); }
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Create tasks after validation (optimized)
        function createTasksAfterValidation(tasks, projectId, userId) {
            var taskArray = tasks.map(function(task) {
                var td = task.taskData;
                
                // Added By Dipali V On 23rd Jan 2026 For W26 - Build CustomFields object from customFieldValues
                var customFields = {};
                if (td.customFieldValues && typeof td.customFieldValues === 'object') {
                    Object.keys(td.customFieldValues).forEach(function(fieldName) {
                        var value = td.customFieldValues[fieldName];
                        // Ensure we only include primitive values (string, number, null)
                        if (value !== null && value !== undefined && value !== '') {
                            // Skip if value is an object or array (shouldn't happen after collectCustomFieldDataForRow fix)
                            if (typeof value === 'object' && !Array.isArray(value)) {
                                console.warn('Skipping non-primitive custom field value for', fieldName, value);
                                return;
                            }
                            // Ensure primitive value
                            if (typeof value === 'string' || typeof value === 'number') {
                                customFields[fieldName] = value;
                            } else if (Array.isArray(value) && value.length > 0) {
                                // Handle array (shouldn't happen, but just in case)
                                customFields[fieldName] = value[0].toString();
                            } else {
                                customFields[fieldName] = value.toString();
                            }
                        }
                    });
                }
                
                return {
                    projectID: projectId, projectTypeID: currentProjectTypeID || null, userID: userId,
                    processGroupID: td.ProcessGroupID || null, taskName: td.taskName || null, taskNotes: td.taskNotes || null,
                    deliverableID: td.deliverableID !== null && td.deliverableID !== undefined ? td.deliverableID : null, employeeID: td.employeeID || null, work: td.work || '',
                    startDate: td.startDate || '', endDate: td.endDate || '', changeRequestID: null, billable: td.billable || false,
                    moduleID: td.moduleID || null, module: td.module || '',
                    subProjectID: td.subProjectID || null, subProject: td.subProject || '',
                    milestoneID: td.milestoneID || null, milestone: td.milestone || '',
                    priority: td.priority || null, taskTypes: td.taskTypes || null,
                    phaseID: td.phaseID || null, phase: td.phase || '',
                    isHoliday: 0, isLeave: 0, userStoryID: td.userStoryID || null, featureID: td.featureID !== null && td.featureID !== undefined ? td.featureID.toString() : null,
                    estimationTypeID: null, isPhaseMandatory: td.isPhaseMandatory || 0, isModuleMandatory: td.isModuleMandatory || 0,
                    isMilestoneMandatory: td.isMilestoneMandatory || 0, isSubProjectMandatory: td.isSubProjectMandatory || 0,
                    isCRMandatory: td.isCRMandatory || 0, isFeatureMandatory: td.isFeatureMandatory || 0,
                    isEstimationTypeMandatory: td.isEstimationTypeMandatory || 0, tmsTaskID: null,
                    customFields: Object.keys(customFields).length > 0 ? customFields : null
                };
            });
            
            PostProjectAssignedTask(projectId, taskArray,
                function() {
                    if (typeof alertify !== 'undefined') {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.success('<%= MyBase.GetResourceString("C_TasksCreatedSuccessfully") %>');
                    } else alert('<%= MyBase.GetResourceString("C_TasksCreatedSuccessfully") %>');
                    // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Reset validation icons after successful task creation
                    $('#bulkTaskTbl tbody tr').each(function() { updateValidationIconForRow($(this), 'validated'); });
                    // Added By Dipali V On 23rd Jan 2026 For W26 - Clear modal checkboxes after successful task creation
                    loadProjectTypeFlags(projectId);
                    clearAllModalCheckboxes();
                    clearAllTaskRows();
                },
                function() {
                    var msg = '<%= MyBase.GetResourceString("C_ErrorCreatingTasks") %>';
                    if (typeof alertify !== 'undefined') {
                        alertify.set('notifier', 'position', 'top-right');
                        alertify.error(msg);
                    } else alert(msg);
                }
            );
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Clear all modal checkboxes (concise implementation)
        function clearAllModalCheckboxes() {
            // Commented By Dipali V On 3rd Feb 2026 For W26 - Removed Feature control from Quick Task New page
            ['Phase', 'Milestone', 'Module', 'SubProject', /*'Feature',*/ 'Deliverable', 'UserStory', 'Estimation_Type'].forEach(function(type) {
                $('.' + type + '_mainchck').prop('checked', false).closest('tr').removeClass('currently_selected');
            });
        }
        
        // Added By Dipali V On 23rd Jan 2026 For W26 - Clear all fields and remove extra rows, keep only first row
        function clearAllTaskRows() {
            var $allRows = $('#bulkTaskTbl tbody tr');
            var $firstRow = $allRows.first();
            
            // Remove all rows except the first one
            $allRows.not($firstRow).each(function() {
                var $row = $(this);
                // Destroy selectpickers before removing
                $row.find('.selectpicker').each(function() {
                    try { if ($(this).data('selectpicker')) $(this).selectpicker('destroy'); } catch(e) {}
                });
                // Destroy datepickers before removing
                $row.find('input[id^="BTStartdate"], input[id^="BTEnddate"]').each(function() {
                    try { $(this).datepicker('destroy'); } catch(e) {}
                });
                $row.remove();
            });
            
            // Clear all fields in the remaining first row
            if ($firstRow.length) {
                $firstRow.find('input[type="text"], textarea, input[id^="BTStartdate"], input[id^="BTEnddate"]').val('');
                $firstRow.find('input[type="checkbox"]').prop('checked', window.currentProjectBillableStatus === true || false);
                $firstRow.find('select').each(function() {
                    var $s = $(this);
                    if ($s.data('selectpicker')) { $s.selectpicker('val', ''); $s.selectpicker('refresh'); } else $s.val('');
                });
                // Commented By Dipali V On 3rd Feb 2026 For W26 - Removed Feature control from Quick Task New page (txtFeature removed)
                //$firstRow.find('input.popup-field, input[id^="txtDeliverable"], input[id^="txtPhase"], input[id^="txtMilestone"], input[id^="txtModule"], input[id^="txtSubProject"], input[id^="txtUserStory"], input[id^="txtSprint"], input[id^="txtRelease"]').val('').removeAttr('data-selected-id');
                // Added by DipalI v On 3rd sep 2026 - Purpose: clear WBS mapping attr + jQuery data so next create does not remmap previous Deliverable/Phase/Milestone/Module/SubProject
                clearRowWbsMappings($firstRow);
                
                // Added By Dipali V On 3rd Feb 2026 For W26 - Purpose: Reset validation icon when clearing task rows
                updateValidationIconForRow($firstRow, 'validated');
            }
        }
        
        $('#BTStartdate, #BTEnddate').datepicker({
            autoclose: true,
            changeMonth: true,
            changeYear: true,
            dateFormat: 'dd M yy',
            orientation: 'bottom',

            beforeShow: function (input, inst) {
                setTimeout(function () {
                    var $input = $(input);
                    var offset = $input.offset();

                    inst.dpDiv.css({
                        top: offset.top + $input.outerHeight() + 2,
                        left: offset.left,
                        position: 'absolute',
                        zIndex: 9999,
                        bottom: 'auto'
                    });

                    $('.tooltip').remove(); // clean any leftover tooltips
                }, 1);
            },

            onClose: function () {
                $('.tooltip').remove();
            }
        });

        $(document).on('click', '.ui-datepicker-prev, .ui-datepicker-next', function () {
            $('.tooltip').remove();
        });
       
    </script>


</body>
</html>





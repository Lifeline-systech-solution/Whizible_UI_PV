    'Modified BY NitinVS on 2 Jul 2007 for WhizibleSEM 7 
    ' Color pallet is plotted as readonly hence getting saved as null. 

    Protected Overrides Sub Before_PlotControl(ByRef Cancel As Boolean, ByRef Args As CommonEngines.EventHandlers.WAF_Controls, ByVal WhizGlobal As WebPages.Template.IGlobal, Optional ByVal drControls As System.Data.IDataReader = Nothing, Optional ByRef InsertBeforeControl As String = "")
        Dim strColorName As String

        If Args.ControlName.ToUpper = "NONDATABASE1" Then
            Cancel = True
            Args.IgnoreActualValue = True
            Args.ControlToolTip = "Color Palette Control"
            If Args.IsEditMode = True Then
                strColorName = CStr(drControls.Item("COLORCODE"))

            Else
                strColorName = ""
            End If

            Args.Mandatory = True
            Args.ValidationRules = "1"
            Args.InsertAfterControl = CommonFunction.HTMLControls.DrawColorPalette("NonDatabase1", "NonDatabase1", "clsColorPaletteTextBox", , strColorName, , , , , , , , , True, True)
            Args.Mandatory = True
        End If


    End Sub
    ' End Modification BY NitinVS on 2 Jul 2007 for WhizibleSEM 7  


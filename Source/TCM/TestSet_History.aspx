	<body class='clsBody' onload='window_onload()' onresize='window_onresize()'>
		<form id="frmTestSetHistory" method="post">
			<%PageInit%>
		</form>
		<script language="javascript">
   var objfrm = GetFormReference('frmTestSetHistory');
   objfrm.action="TestSet_History.aspx"
   var objdivlist = GetObjectReference('frmTestSetHistory', 'divListTag');
   var Flag = true;
   
    <%' Added By SonalD on 13th Jan 2009 %>
    <%If CommonFunctions.General.GetApplicationKeySetting("Environment") = "P" Then %>
        disableRightClick();
    <%End If%>
    <%' Added By SonalD on 13th Jan 2009 %>
            
function window_onresize()
{
	var intDivHeight ;
	var intDivHeightRisk;
	if (navigator.appName == 'Microsoft Internet Explorer'){
	intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 108;
	}
	else{
	intDivHeight = window.innerHeight - 108;
	}
	if (intDivHeight < 100)
		intDivHeight = 100;
			
	objdivlist.style.height = intDivHeight;

		if (Flag == true)
		objdivlist.HEIGHT = intDivHeight;
		else 
		objdivlist.HEIGHT = intDivHeight-32;
	
}

function window_onload()
{


		var intDivHeight ;
		var intDivHeightRisk;
		var lc;
		if (navigator.appName == 'Microsoft Internet Explorer'){
		intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 108;
		}
		else{
		intDivHeight = window.innerHeight - objdivlist.offsetTop - 108;
		}
		if (intDivHeight < 100)
			intDivHeight = 100;
    //Comment added on 11 Dec 2015 by Viraj P
    //objdivlist.style.height = intDivHeight;	
		objdivlist.style.height = intDivHeight + 'px';

		objdivlist.HEIGHT = intDivHeight;
}
function cboProject_onChange()
{
	objfrm.submit();
}
function cboTestSet_onChange()
{
	objfrm.submit();
}
function cboCorpoTestSet_onChange()
{
	objfrm.action="TestSet_History.aspx?FromWhere=DB&From=CORPOTESTSET"
	objfrm.submit();
}
function cboTestSection_onChange()
{
	objfrm.submit();
}

function showHide_divFilter()
{		
	var objDIV = GetObjectReference('frmTestSetHistory', 'pageFilterDiv');
	var objimg = GetObjectReference('frmTestSetHistory', 'pageFilterImg');
	
	if (Flag==true)
	{
		objDIV.style.display='none';
		objimg.src='../../Images/plus.gif';
		Flag=false;
		objdivlist.style.height = objdivlist.HEIGHT+32; 
		
	}
	else{
		objDIV.style.display='';
		objimg.src='../../Images/minus.gif';
		Flag=true;
		objdivlist.style.height = objdivlist.HEIGHT; 
		
	}
}
		</script>

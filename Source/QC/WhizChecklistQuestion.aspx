    <script type="text/javascript"  language="javascript">
        function ShowHideSection(strImg, strSectionId)
        {
               var objSection = document.getElementById(strSectionId);
               var objImg = document.getElementById(strImg);
               if(objSection.style.display=='none')
               {
                    objSection.style.display = 'inline';
                    objImg.src = '../../Images/minus.gif';
               }
               else
               {
                    objSection.style.display = 'none';
                    objImg.src = '../../Images/plus.gif';
               }
        }
        
        function cancel_OnClick(QuestionnaireId)
        {
        window.location.href ="WhizCheckList.aspx?ACTION=MODIFY&PKID=0|CS&QuestionnaireID_PK=" +  QuestionnaireId ;                
        }
        
        function addItem_OnClick(QuestionnaireId)
        {
            var objfrm = GetFormReference('frmWhizChecklistQuestion');
            var i=0;
            var objChkSelect = GetObjectReference("frmWhizChecklistQuestion","chkSelect",true);
            var objQuestions= GetObjectReference("frmWhizChecklistQuestion","txtQuestions");
            var objMandatory= GetObjectReference("frmWhizChecklistQuestion","txtMandatory");
            var blnIsRecordSelected=false;blnIsRecordSelected=IsCheckboxSelected('frmWhizChecklistQuestion','chkSelect')
            if (blnIsRecordSelected == false) {return;}
            
            objQuestions.value="";
            for(i=0;i<objChkSelect.length;i++)
            {
                if(objChkSelect[i].checked==true)
                {
                    var objchkMandatory = GetObjectReference("frmWhizChecklistQuestion","chkMandatory"+ objChkSelect[i].value);
                    if(objQuestions.value=="")
                    {
                        objQuestions.value = objChkSelect[i].value;
                        if(objchkMandatory.checked==true)
                        objMandatory.value ="1" ;
                        else
                        objMandatory.value ="0" ;
                    }
                    else
                    {
                        objQuestions.value = objQuestions.value + "," + objChkSelect[i].value;
                        if(objchkMandatory.checked==true)
                            objMandatory.value = objMandatory.value + ",1"  ;                        
                        else
                            objMandatory.value = objMandatory.value + ",0"  ;
                    }    
                } 
                
                
            }
            objfrm.action="WhizChecklistQuestion.aspx?MODE=SAVE&QuestionnaireID_PK="+ QuestionnaireId; 
            objfrm.submit();
        }
        function chkSelect_OnClick(objSelect,QuestionID)
        {
            var objChkMandatory = GetObjectReference("frmWhizChecklistQuestion","ChkMandatory" + objSelect.value ); 
            if(objSelect.checked==true)            
            {
                objChkMandatory.disabled=false;
            }
            else
            {
                objChkMandatory.disabled=true;
            }
        }
         function window_onload()
	    {
	      
	     
	        var objdivlistPage = GetObjectReference('frmProcessDetails','divMain');
		    var intDivHeight ;
		    var intDivListPageHeight ;
		    var lc;
		    if (objdivlistPage != null) {
		    
		    if (navigator.appName == 'Microsoft Internet Explorer'){
		    intDivHeight = document.body.offsetHeight - objdivlistPage.offsetTop - 400;
		    }
		    else{

<!DOCTYPE HTML>
<!--Ended by Nilesh gundecha on 18/9/2015 for Responsive Common list Page-->

<html xmlns="http://www.w3.org/1999/xhtml" >
<head runat="server">
    <link href="../General/StyleSheetChanakya_WhizP2007.css" rel="stylesheet" type="text/css" />
    <script type='text/javascript' src="../General/CommonFunctions.js"></script>
    <script type='text/javascript' src="../General/CommonValidations.js"></script>

    <title>Quality Center</title>
    <script type="text/javascript" language="javascript" >
    var cntresize=0;

    function resize_tree()
    {
        var objinfragisticsTree= document.getElementById("frmQualityCenter");
        var objcols = new Array()

        objcols  = objinfragisticsTree.cols.split(",");
        
        if(cntresize==0) 
        {
            //objinfragisticsTree.cols= ( parseInt(objcols[0])  )  + ",*";// "235,*";
            cntresize+=1;
        }
        else if(cntresize==1) 
        {
            objinfragisticsTree.cols= ( parseInt(objcols[0]) - 2 )  + ",*";// "235,*";
            cntresize+=1;
        }
        else if(cntresize==2) 
        {
            objinfragisticsTree.cols= ( parseInt(objcols[0]) + 1 )  + ",*";// "235,*";
            cntresize=0;
        }        
        
    }
    </script>
</head>

<frameset id="frmQualityCenter" cols="235,*" border="0" framespacing="0" frameborder="0" onresize="resize_tree()"/>
    <frame class="clsBody" scrolling="no" id ="infragisticsTree" src="WhizVisualProcessTree.aspx" />
    <frame scrolling="yes" id="WhizVisualProcessGrid" src="WhizQualityCenterHelp.aspx" />
</frameset>

</html>

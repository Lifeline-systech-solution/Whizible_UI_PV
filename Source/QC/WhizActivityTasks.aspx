<script language="javascript" type="text/javascript">
// <!CDATA[
function Save_OnClick()
{
    // <!--Validate for Task Name and Duration!-->
    if(validateform()==true)
    {

    
    document.form1.action= "WhizActivityTasks.aspx?Mode=<%=m_strMode%>&ActivityID=<%=m_strActivityID%>&Action=SAVE&ActivityTaskID_PK=<%=m_strActivityTaskID%>&FromCL=1";
    document.form1.submit();
    //if("ADD_NEW"=="<%=m_strMode%>")
    // window.opener.parent.frames[0].location.reload();
    // window.opener.parent.frames[1].location.reload();
    // window.close();
    }
}
function Window_Close()
{
    window.close();
}

function validateform()
{
    objtxtTaskName = document.getElementById("txtTaskName");
    objtxtDuration = document.getElementById("txtDuration");
    objtxtMinHrs = document.getElementById("txtMinHrs");
     if(disallowMaxlengthViolation(objtxtTaskName,255)==true)
     {
     alert('Task name cannot exeeds 250 characters');
     return false;
     }
    if(disallowBlank(objtxtTaskName,"'Task Name' should not be left blank.")==true)return false;
    if(disallowBlank(objtxtDuration ,"'Duration' should not be left blank.")==true)return false;
    if(disallowNonNumeric(objtxtDuration ,"'Duration' should be positive numeric only.")==true)return false;
    if(disallowNegativeNumeric(objtxtDuration ,"'Duration' should be positive numeric only.")==true)return false;
    if((objtxtDuration.value/ objtxtMinHrs.value ) != parseInt(objtxtDuration.value / objtxtMinHrs.value ))
    {
        alert("'Duration' should be in multiple of '" + objtxtMinHrs.value +"'");
        return false;    
    }
    
    return true;
}
</script>

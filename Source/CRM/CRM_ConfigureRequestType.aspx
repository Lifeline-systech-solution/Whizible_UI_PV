	<body MS_POSITIONING="GridLayout" class="clsBody" onresize="window_onresize()" onload="window_onload()">
		
					<form id="frmConfigureRequestType" method="post" runat="server">
						
									<%PageInit()%>
								
					</form>
				
					<script language="javascript">
			var strValidationRules = "Close";
			var objForm = GetFormReference('frmConfigureRequestType');
			var objdivlist = GetObjectReference('frmConfigureRequestType','divList');
			
			<%' Added By SonalD on 12th Jan 2009 %>
		    <%If CommonFunctions.General.GetApplicationKeySetting("Environment") = "P" Then %>
            disableRightClick();
		    <%End If%>
		    <%' Added By SonalD on 12th Jan 2009 %>
		
			function window_onload()
			{
				var intDivHeight ;
				intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 40;
				
				if (intDivHeight < 100)
					intDivHeight = 100;
						// Let the minimum height of the div tag be 100
				objdivlist.style.height = intDivHeight;		
			}
			
			function window_onresize()		
			{
				var intDivHeight;
				intDivHeight = document.body.offsetHeight - objdivlist.offsetTop - 40;
				if (intDivHeight < 100 )
					intDivHeight = 100;	// Let the minimum height of the div tag be 100
				
				objdivlist.style.height = intDivHeight;		
			}
			function Save_OnClick()
			{
				EnableCheckboxes();
				var objFunctionID = GetObjectReference('frmConfigureRequestType', 'hdFunctionID');
				objForm.action = "../CRM/CRM_ConfigureRequestType.aspx?Mode=<%=m_strMode%>&Action=Save&FunctionID=" + objFunctionID.value;
				objForm.submit();							
			}
			function EnableCheckboxes()
			{
				var objCheckbox = GetObjectReference('frmConfigureRequestType', 'chkSelect', true);
				var intItems;
				var intCtr;
				if (objCheckbox != null)
				{
					intItems = objCheckbox.length;
					for (intCtr = 0;intCtr <= intItems - 1; intCtr++)
					{
						if (objCheckbox[intCtr].disabled == true)
							objCheckbox[intCtr].disabled = false;							
					}
				}
			}
			function RequestType_OnClick(RID)
			{
				var strFID;
				var objTxt = GetObjectReference('frmConfigureRequestType', 'hdFunctionID');
				strFID = objTxt.value;
				
				if(RID!='')
				{
					objForm.action = "../CRM/CRM_ConfigureRequestType.aspx?Mode=SUBREQUEST&FunctionID=" + strFID + "&RequestTypeID=" + RID;
					objForm.submit();
				}
			}
			function Back_OnClick(strFID)
			{
				objForm.action = "../CRM/CRM_ConfigureRequestType.aspx?FunctionID=" + strFID;
				objForm.submit();
			}
					</script>
				
	</body>
</HTML>

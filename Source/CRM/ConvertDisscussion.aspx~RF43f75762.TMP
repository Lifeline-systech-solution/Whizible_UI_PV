	<body MS_POSITIONING="GridLayout" class="clsBody" onload="window_onload()" onresize="window_onresize()">
					<form id="frmConvert" method="post" runat="server">
						<%Init_Load()%>
					
					</form>
					<Script language="javascript">
					
					 var objfrm=GetFormReference('frmConvert');
					 var objfaq =GetObjectReference('frmConvert','FaqCode');
					
					// var e=GetFormReference('frmConvert');
					// var objdesc = GetObjectReference('frmConvert','Description');
	//	var objdivlist=GetObjectReference('frmConvert','DivList');
		
function Convert_OnClick() 
		{
				//debugger;
						var chkflag;
						var e = objfrm.elements;		
						for (i = e.length - 1; i > -1; --i)
						{
							if (e[i].type == 'text' && e[i].name == 'FaqCode' && (e[i].value == ''))
							{
							    alert('FAQ Code should not be blank!');
							    e[i].focus();
							    chkflag = 0;					
							    break;
							}
							if (e[i].type == 'text' && e[i].name == 'Subject' && (e[i].value == ''))
							{
							    alert('Subject should not be blank!');							
							    e[i].focus();
							    chkflag = 0;					
							    break;
							}
							//Added by NitinC on 18 April 2012 For WhizibleSEM 11.0 [Issue Fix : ]
							if (e[i].type == 'textarea' && e[i].name == 'Description' && (e[i].value == ''))
							{
							    alert('Description should not be blank!');							
							    e[i].focus();
							    chkflag = 0;					
							    break;
							}
							//End of Added by NitinC on 18 April 2012 WhizibleSEM 11.0 [Issue Fix : ]							
						}	
						if (chkflag != 0)
						{
						    if(confirm("Are you sure, you want to Convert these Discussion Thread(s) to FAQs?"))
		                        {	
						            objfrm.action ="ConvertDisscussion.aspx?Flag=convert";
						            objfrm.submit();
						        }						
						}
						
}
                        //Added By Vaijat K ON 05/12/2015 IssueID-2634
document.body.onload = function () {
    
        //intDivHeight = document.body.offsetHeight - objDivMain.offsetTop - 10;
        if (WhichBrowser() == 'IE') {
            //intDivHeight = (document.body.offsetHeight - objdivMain.offsetTop - 100) + 895;
            intDivHeight = (window.innerHeight - 4); //Added By Vaijat K ON 03/11/2015 Issue ID-2597
        }
        else if (WhichBrowser() == 'CR') {
            //intDivHeight = (document.body.offsetHeight - objdivMain.offsetTop - 100) + 895;
            intDivHeight = (window.innerHeight - 4); //Added By Vaijat K ON 03/11/2015 Issue ID-2597
        }
        else if (WhichBrowser() == 'FF') {
            //intDivHeight = (document.body.offsetHeight - objdivMain.offsetTop - 100) + 890;
            intDivHeight = (window.innerHeight - 4); //Added By Vaijat K ON 03/11/2015 Issue ID-2597

        }
        else {
            intDivHeight = (window.innerHeight - 4);
        }
        if (intDivHeight < 100)
            intDivHeight = 100;
        document.body.style.height = intDivHeight + 'px';

}
function WhichBrowser() {

    var brwser = '';
    var ua = navigator.userAgent, tem,
    M = ua.match(/(opera|chrome|safari|firefox|msie|trident(?=\/))\/?\s*(\d+)/i) || [];
    if (/trident/i.test(M[1])) {
        tem = /\brv[ :]+(\d+)/g.exec(ua) || [];
        //return 'IE '+(tem[1] || '');
        return 'IE';
    }
    if (M[1] === 'Chrome') {
        tem = ua.match(/\b(OPR|Edge)\/(\d+)/);
        if (tem != null) return tem.slice(1).join(' ').replace('OPR', 'Opera');
        brwser = 'CR';
    }
    else if (M[1] === 'Firefox') {
        tem = ua.match(/\b(OPR|Edge)\/(\d+)/);
        if (tem != null) return tem.slice(1).join(' ').replace('OPR', 'Opera');
        brwser = 'FF';
    }
    M = M[2] ? [M[1], M[2]] : [navigator.appName, navigator.appVersion, '-?'];
    if ((tem = ua.match(/version\/(\d+)/i)) != null) M.splice(1, 1, tem[1]);
    //return M.join(' ');
    return brwser;
}
document.body.onresize = document.body.onload();
</Script>  
</body>
</HTML>